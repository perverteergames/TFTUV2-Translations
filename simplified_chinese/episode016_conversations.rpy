# game/episode016_conversations.rpy:64
translate simplified_chinese ep016_eva_talk_c8e65724:

    # "I walked into my quarters looking at my datapad, not even noticing why my door was left open."
    "我走进自己的舱室，低头看着数据板，甚至没注意到房门为什么敞开着。"

# game/episode016_conversations.rpy:66
translate simplified_chinese ep016_eva_talk_a64c9c90:

    # "At the same time, Eva was in a rush to exit my quarters and we bumped into each other."
    "与此同时，伊娃正匆忙要离开我的舱室，我们撞了个满怀。"

# game/episode016_conversations.rpy:68
translate simplified_chinese ep016_eva_talk_390e294b:

    # "The datapad clattered on the floor and the collision made Eva lose her balance and I had to grab her, or she would have been knocked on the floor."
    "数据板啪嗒一声掉在地上，这次碰撞让伊娃失去平衡，我不得不抓住她，否则她就会摔倒在地。"

# game/episode016_conversations.rpy:71
translate simplified_chinese ep016_eva_talk_849ed011:

    # "The sudden nearness of my sister’s body, pressed against mine, and her smell were almost overwhelming."
    "妹妹的身体突然贴近，紧压在我身上，她的气息几乎令人窒息。"

# game/episode016_conversations.rpy:73
translate simplified_chinese ep016_eva_talk_b120635e:

    # "The sudden nearness of Eva’s body, pressed against mine, and her smell were almost overwhelming."
    "伊娃的身体突然贴近，紧压在我身上，她的气息几乎令人窒息。"

# game/episode016_conversations.rpy:75
translate simplified_chinese ep016_eva_talk_755b8f95:

    # "Eva must have had the same sensation, as she attempted to draw even nearer, her lips parted."
    "伊娃一定也有同样的感觉，因为她试图靠得更近，双唇微微张开。"

# game/episode016_conversations.rpy:77
translate simplified_chinese ep016_eva_talk_f7fcd884:

    # "I responded and suddenly we were kissing."
    "我做出了回应，突然间我们开始接吻。"

# game/episode016_conversations.rpy:79
translate simplified_chinese ep016_eva_talk_85854860:

    # "The ferocity of our reaction surprised us both and this time we both nearly tripped and fell."
    "我们反应的激烈程度让我们俩都感到惊讶，这次我们俩都差点绊倒。"

# game/episode016_conversations.rpy:80
translate simplified_chinese ep016_eva_talk_62d8f8d4:

    # "It broke the spell."
    "这打破了魔咒。"

# game/episode016_conversations.rpy:82
translate simplified_chinese ep016_eva_talk_601f7fb5:

    # e "I...{w} Uh...{w} I was here."
    e "我…{w}呃…{w}我当时在这里。"

# game/episode016_conversations.rpy:83
translate simplified_chinese ep016_eva_talk_0e08f5d3:

    # c "I noticed that."
    c "我注意到了。"

# game/episode016_conversations.rpy:85
translate simplified_chinese ep016_eva_talk_81a61700:

    # e "I mean, I wanted to speak to you, but you weren’t there."
    e "我是说，我想跟你说话，但你不在那里。"

# game/episode016_conversations.rpy:86
translate simplified_chinese ep016_eva_talk_ded44b0b:

    # c "I am now."
    c "我现在在了。"

# game/episode016_conversations.rpy:87
translate simplified_chinese ep016_eva_talk_3cead5e5:

    # e "I noticed that."
    e "我注意到了。"

# game/episode016_conversations.rpy:89
translate simplified_chinese ep016_eva_talk_f7230018:

    # "The similarity of her reply made us both smile."
    "她回答的相似性让我们都露出了微笑。"

# game/episode016_conversations.rpy:90
translate simplified_chinese ep016_eva_talk_ad871e71:

    # "Eva’s mirth soon evaporated, as a realization struck her."
    "伊娃的欢愉很快消散了，因为她突然意识到一件事。"

# game/episode016_conversations.rpy:92
translate simplified_chinese ep016_eva_talk_1dbca999:

    # e "What are we doing, [p_name_short]?"
    e "我们在做什么，[p_name_short]？"

# game/episode016_conversations.rpy:93
translate simplified_chinese ep016_eva_talk_652f6c7e:

    # c "I’m not sure."
    c "我不确定。"

# game/episode016_conversations.rpy:94
translate simplified_chinese ep016_eva_talk_9459b02e:

    # c "It didn’t feel bad though."
    c "不过感觉并不坏。"

# game/episode016_conversations.rpy:96
translate simplified_chinese ep016_eva_talk_d447af93:

    # e "No, maybe it didn’t."
    e "不，也许确实不坏。"

# game/episode016_conversations.rpy:97
translate simplified_chinese ep016_eva_talk_e01e730f:

    # e "I think, maybe, we should talk."
    e "我想，也许我们应该谈谈。"

# game/episode016_conversations.rpy:98
translate simplified_chinese ep016_eva_talk_034cc09e:

    # e "That's the reason why I came to your room in the first place."
    e "这就是我一开始来你房间的原因。"

# game/episode016_conversations.rpy:100
translate simplified_chinese ep016_eva_talk_843cc00b:

    # "I picked up my datapad that I had dropped as Eva and I bumped into each other, it didn't seem to badly damaged."
    "我捡起了之前和伊娃相撞时掉落的平板电脑，看起来损坏得不算太严重。"

# game/episode016_conversations.rpy:101
translate simplified_chinese ep016_eva_talk_19cfbf44:

    # "Eva sat on my bed as I closed the door."
    "当我关上门时，伊娃坐在了我的床上。"

# game/episode016_conversations.rpy:104
translate simplified_chinese ep016_eva_talk_abb81d2f:

    # "When I took a seat opposite of her, my sister let out a big sigh."
    "当我在她对面坐下时，我的妹妹长叹了一声。"

# game/episode016_conversations.rpy:106
translate simplified_chinese ep016_eva_talk_0139bff8:

    # "When I took a seat opposite of her, my friend let out a big sigh."
    "当我在她对面坐下时，我的朋友长叹了一声。"

# game/episode016_conversations.rpy:107
translate simplified_chinese ep016_eva_talk_63a42747:

    # e "My emotions, what happened between us, what you told me after rescuing me from the simulation, it's all such a mess."
    e "我的情绪，我们之间发生的事，你把我从模拟中救出来后告诉我的那些话，这一切都太混乱了。"

# game/episode016_conversations.rpy:108
translate simplified_chinese ep016_eva_talk_402ae1e1:

    # c "Yes, I think we can both agree on that."
    c "是的，我想我们都同意这一点。"

# game/episode016_conversations.rpy:110
translate simplified_chinese ep016_eva_talk_e1861368:

    # e "I didn't really respond after your confession in the medbay."
    e "你在医疗舱表白后，我并没有真正回应。"

# game/episode016_conversations.rpy:111
translate simplified_chinese ep016_eva_talk_6bba80fb:

    # e "And while it's true I was tired after the whole ordeal, it was more the shock that overwhelmed me."
    e "虽然经历那场磨难后我确实很累，但更多的是震惊压倒了我。"

# game/episode016_conversations.rpy:112
translate simplified_chinese ep016_eva_talk_b4e1e77a:

    # c "I can imagine it must be a little too much to bear."
    c "我能想象这肯定有点难以承受。"

# game/episode016_conversations.rpy:113
translate simplified_chinese ep016_eva_talk_0376ebd8:

    # e "Well, just in a sense that it was so unexpected, not out of disgust or anything."
    e "嗯，只是说这实在太出乎意料，并不是出于厌恶之类的。"

# game/episode016_conversations.rpy:114
translate simplified_chinese ep016_eva_talk_381cec6e:

    # e "And the signs were there, of course."
    e "当然，那些迹象一直都在。"

# game/episode016_conversations.rpy:116
translate simplified_chinese ep016_eva_talk_63dfb8ac:

    # e "The simulation of our home, the kiss we shared in the fantasy sim."
    e "模拟我们的家，我们在幻想模拟中分享的那个吻。"

# game/episode016_conversations.rpy:118
translate simplified_chinese ep016_eva_talk_3c037b79:

    # e "But I could somehow dismiss those moments, like they were a heat of the moment thing, if you know what I mean."
    e "但我总能把那些时刻当作一时冲动，如果你明白我的意思。"

# game/episode016_conversations.rpy:119
translate simplified_chinese ep016_eva_talk_e9b281e4:

    # c "I do, yes."
    c "是的，我明白。"

# game/episode016_conversations.rpy:121
translate simplified_chinese ep016_eva_talk_a136d5ed:

    # e "You've been honest about your feelings towards me, so I think it's only fair I will about mine."
    e "你已经诚实地表达了对我的感情，所以我认为我也该坦诚相待才公平。"

# game/episode016_conversations.rpy:123
translate simplified_chinese ep016_eva_talk_070f6b63:

    # e "We've always been so close, ever since we were kids."
    e "我们从小就一直如此亲密。"

# game/episode016_conversations.rpy:124
translate simplified_chinese ep016_eva_talk_e04d228e:

    # e "The thought of possibly seeing you again is part of what kept me going during my time as queen on Erigone."
    e "可能再次见到你的想法，是支撑我在厄里戈涅星当女王时坚持下去的部分动力。"

# game/episode016_conversations.rpy:125
translate simplified_chinese ep016_eva_talk_f48e43f3:

    # e "So you can imagine my emotions when you finally arrived to get me off that planet."
    e "所以你可以想象当你终于来接我离开那个星球时，我的心情有多激动。"

# game/episode016_conversations.rpy:126
translate simplified_chinese ep016_eva_talk_53d9590d:

    # e "Everything has been such a rollercoaster ever since."
    e "从那以后，一切都像坐过山车一样跌宕起伏。"

# game/episode016_conversations.rpy:128
translate simplified_chinese ep016_eva_talk_730bdc9a:

    # e "I mean, I thought I’d lost you just a short while back!"
    e "我是说，就在不久前我还以为已经失去了你！"

# game/episode016_conversations.rpy:130
translate simplified_chinese ep016_eva_talk_ed5801e6:

    # e "And then...{w} We kissed and it triggered all these confusing feelings I’ve felt for you for so long."
    e "然后…{w}我们接吻了，这激发了我对你长久以来所有的困惑情感。"

# game/episode016_conversations.rpy:131
translate simplified_chinese ep016_eva_talk_c5255654:

    # e "It’s just..."
    e "只是…"

# game/episode016_conversations.rpy:133
translate simplified_chinese ep016_eva_talk_cc197c6b:

    # e "I love you, [p_name]."
    e "我爱你，[p_name]。"

# game/episode016_conversations.rpy:134
translate simplified_chinese ep016_eva_talk_192b3cae:

    # e "I always have."
    e "我一直都爱着你。"

# game/episode016_conversations.rpy:136
translate simplified_chinese ep016_eva_talk_dc0db94c:

    # e "And I can't help myself any longer."
    e "我再也无法控制自己了。"

# game/episode016_conversations.rpy:137
translate simplified_chinese ep016_eva_talk_65f57608:

    # e "Even just now, when you're near me, the urge to give into all those conflicting feelings is too big."
    e "即使是现在，当你靠近我时，想要屈服于所有这些矛盾情感的冲动太过强烈。"

# game/episode016_conversations.rpy:138
translate simplified_chinese ep016_eva_talk_a4985493:

    # e "I want you and I know I shouldn't, but I just don't care anymore."
    e "我想要你，我知道我不应该这样，但我就是不在乎了。"

# game/episode016_conversations.rpy:139
translate simplified_chinese ep016_eva_talk_c1424d6d:

    # c "You don't know half how happy that makes me to hear you say that."
    c "你不知道听到你这么说让我有多开心。"

# game/episode016_conversations.rpy:142
translate simplified_chinese ep016_eva_talk_91504219:

    # e "But I don't want to say 'a sin', but we will be judged by everyone who knows us if we act on it."
    e "但我不想用'罪过'这个词，可如果我们付诸行动，所有认识我们的人都会对我们指指点点。"

# game/episode016_conversations.rpy:143
translate simplified_chinese ep016_eva_talk_a8087432:

    # c "Well, considering our mother, I'm not so sure about that."
    c "呃，考虑到我们母亲的情况，我对这点可不太确定。"

# game/episode016_conversations.rpy:148
translate simplified_chinese ep016_eva_talk_e2f766ad:

    # "Eva suddenly looked pained and I was afraid I'd ruined the moment completely."
    "伊娃突然面露痛苦，我担心自己彻底毁掉了这个美好时刻。"

# game/episode016_conversations.rpy:150
translate simplified_chinese ep016_eva_talk_1be2e035:

    # e "Yes, about that."
    e "是啊，关于那件事。"

# game/episode016_conversations.rpy:153
translate simplified_chinese ep016_eva_talk_b0b14c69:

    # e "You mentioned you were already involved with Aven and Lilly?"
    e "你提到你已经和艾文还有莉莉在一起了？"

# game/episode016_conversations.rpy:155
translate simplified_chinese ep016_eva_talk_7f84375f:

    # e "You mentioned you were already involved with Lilly?"
    e "你提到你已经和莉莉在一起了？"

# game/episode016_conversations.rpy:157
translate simplified_chinese ep016_eva_talk_92b0b260:

    # e "You mentioned you were already involved with Aven?"
    e "你提到你已经和艾文在一起了？"

# game/episode016_conversations.rpy:158
translate simplified_chinese ep016_eva_talk_b63d6bf3:

    # c "I am."
    c "是的。"

# game/episode016_conversations.rpy:164
translate simplified_chinese ep016_eva_talk_2f4f3321:

    # e "She kept all that a secret for a great many years, so I'm not sure if that's a good example."
    e "她把那件事保密了这么多年，所以我不确定这是否是个好例子。"

# game/episode016_conversations.rpy:166
translate simplified_chinese ep016_eva_talk_65dea4fc:

    # e "Besides, I heard a rumor you are already involved with someone?"
    e "再说了，我听说你已经在和某人交往了？"

# game/episode016_conversations.rpy:169
translate simplified_chinese ep016_eva_talk_678e2645:

    # e "Be that as it may, but I heard a rumor you are already involved with someone?"
    e "即便如此，但我听说你已经和别人在一起了？"

# game/episode016_conversations.rpy:172
translate simplified_chinese ep016_eva_talk_25023803:

    # c "Yes, Céline and I are in a relationship."
    c "是的，瑟琳和我在交往中。"

# game/episode016_conversations.rpy:174
translate simplified_chinese ep016_eva_talk_5232cfea:

    # c "But she isn't the only the only girl I'm currently involved with."
    c "但她并不是我现在唯一交往的女孩。"

# game/episode016_conversations.rpy:177
translate simplified_chinese ep016_eva_talk_eff9b5bc:

    # c "Putting our unconventional parentage aside, I'm at a point where I just don't care about what people think of me anymore."
    c "抛开我们非传统的出身不谈，我现在已经不在乎别人怎么看我。"

# game/episode016_conversations.rpy:179
translate simplified_chinese ep016_eva_talk_82983b4e:

    # c "Putting our childhood friendship aside, I'm at a point where I just want us to be together."
    c "抛开我们儿时的友谊不谈，我现在只想让我们在一起。"

# game/episode016_conversations.rpy:180
translate simplified_chinese ep016_eva_talk_1232dc0a:

    # c "I love you and that should be enough."
    c "我爱你，这就应该足够了。"

# game/episode016_conversations.rpy:182
translate simplified_chinese ep016_eva_talk_98cc1147:

    # c "Out of respect for you, I do have another confession to make though and I feel I should do it right now."
    c "出于对你的尊重，我确实还有件事要坦白，我觉得现在就应该说出来。"

# game/episode016_conversations.rpy:183
translate simplified_chinese ep016_eva_talk_46d00547:

    # c "I’d hate to ruin this moment, but you deserve the honest truth."
    c "我不想破坏这一刻，但你值得知道真相。"

# game/episode016_conversations.rpy:184
translate simplified_chinese ep016_eva_talk_9337e0e1:

    # c "You’re not the only girl I’m currently involved with."
    c "你并不是我现在唯一交往的女孩。"

# game/episode016_conversations.rpy:186
translate simplified_chinese ep016_eva_talk_3388a208:

    # e "Oh..."
    e "哦…"

# game/episode016_conversations.rpy:188
translate simplified_chinese ep016_eva_talk_8bc134d7:

    # "The disappointment on her face was almost too much to go on, but I couldn’t stop talking now."
    "她脸上失望的表情几乎让我无法继续，但我现在不能停止说话。"

# game/episode016_conversations.rpy:189
translate simplified_chinese ep016_eva_talk_6fc40dcf:

    # c "Over time, the crew grew so close, I mean, we went through so much together."
    c "随着时间的推移，船员们变得如此亲密，我是说，我们一起经历了太多。"

# game/episode016_conversations.rpy:202
translate simplified_chinese ep016_eva_talk_74a257f9:

    # e "Who else are you involved with, [p_name]?"
    e "你还和谁有关系，[p_name]？"

# game/episode016_conversations.rpy:203
translate simplified_chinese ep016_eva_talk_cfa6ca55:

    # c "[romances]."
    c "[romances]."

# game/episode016_conversations.rpy:206
translate simplified_chinese ep016_eva_talk_46b9dee5:

    # e "But all those names, that’s almost the entire crew?!"
    e "但所有这些名字，这几乎是整个船员队伍？！"

# game/episode016_conversations.rpy:207
translate simplified_chinese ep016_eva_talk_e2ea8b1b:

    # c "Yes, I know."
    c "是的，我知道。"

# game/episode016_conversations.rpy:210
translate simplified_chinese ep016_eva_talk_91b682ec:

    # e "So are you...{w} In a relationship with them?"
    e "那么你…{w}和她们在谈恋爱吗？"

# game/episode016_conversations.rpy:212
translate simplified_chinese ep016_eva_talk_bb949ab9:

    # e "So are you...{w} In a relationship with her?"
    e "那么你…{w}和她是在谈恋爱吗？"

# game/episode016_conversations.rpy:213
translate simplified_chinese ep016_eva_talk_36391c9b:

    # c "Yes, I am."
    c "是的，我是。"

# game/episode016_conversations.rpy:215
translate simplified_chinese ep016_eva_talk_d2376172:

    # "Eva was silent for a long while, visibly torn by her emotions."
    "伊娃沉默了很长时间，显然被她的情绪所困扰。"

# game/episode016_conversations.rpy:217
translate simplified_chinese ep016_eva_talk_6bfa9893:

    # e "So, am I too late?"
    e "所以，我是不是太迟了？"

# game/episode016_conversations.rpy:218
translate simplified_chinese ep016_eva_talk_9c056f42:

    # c "No, you're not."
    c "不，你来得正好。"

# game/episode016_conversations.rpy:220
translate simplified_chinese ep016_eva_talk_c050bcb6:

    # e "But you just said you were in love with all those women."
    e "但你刚刚说你爱上了所有这些女人。"

# game/episode016_conversations.rpy:222
translate simplified_chinese ep016_eva_talk_66afa45d:

    # e "But you just said you were in love with her."
    e "但你刚刚说你爱上了她。"

# game/episode016_conversations.rpy:223
translate simplified_chinese ep016_eva_talk_b63d6bf3_1:

    # c "I am."
    c "是的。"

# game/episode016_conversations.rpy:224
translate simplified_chinese ep016_eva_talk_8ac3cee6:

    # c "But there's room for you in my heart as well."
    c "但我的心里也有你的位置。"

# game/episode016_conversations.rpy:227
translate simplified_chinese ep016_eva_talk_471a21d7:

    # e "You're asking me to accept the fact that you have all these women on the side?"
    e "你是要我接受你在外面有这么多女人的事实？"

# game/episode016_conversations.rpy:228
translate simplified_chinese ep016_eva_talk_7e6e97ae:

    # c "It's a little hard to explain, but I love all of you equally."
    c "这有点难以解释，但我对你们所有人都一视同仁地爱着。"

# game/episode016_conversations.rpy:230
translate simplified_chinese ep016_eva_talk_6fab5162:

    # e "You're asking me to accept the fact that you have a woman on the side?"
    e "你是要我接受你在外面有女人的事实？"

# game/episode016_conversations.rpy:231
translate simplified_chinese ep016_eva_talk_328df0a1:

    # c "It's a little hard to explain, but I love you both equally."
    c "这有点难以解释，但我对你们两个都一视同仁地爱着。"

# game/episode016_conversations.rpy:232
translate simplified_chinese ep016_eva_talk_d1cdede4:

    # c "I know monogamy is still the norm for some reason, but I find it a narrowing way of living your life."
    c "我知道一夫一妻制不知为何仍是主流，但我认为这是一种狭隘的生活方式。"

# game/episode016_conversations.rpy:234
translate simplified_chinese ep016_eva_talk_14270fa5:

    # e "That's easy for you to say."
    e "你说得倒轻松。"

# game/episode016_conversations.rpy:235
translate simplified_chinese ep016_eva_talk_8d291360:

    # e "I'm ready to share my love for you and instead you're telling me I'll be one of many, that I have to get in line for your heart."
    e "我准备好与你分享我的爱，而你却告诉我我只是众多情人之一，需要排队等候你的真心。"

# game/episode016_conversations.rpy:236
translate simplified_chinese ep016_eva_talk_d71c939c:

    # c "It doesn't work like that for me."
    c "这对我来说行不通。"

# game/episode016_conversations.rpy:238
translate simplified_chinese ep016_eva_talk_bf612b49:

    # c "The feelings I have for you all are equally strong."
    c "我对你们每个人的感情都同样强烈。"

# game/episode016_conversations.rpy:239
translate simplified_chinese ep016_eva_talk_a8fd0b0a:

    # c "I don't want to choose between you all."
    c "我不想在你们所有人之间做出选择。"

# game/episode016_conversations.rpy:241
translate simplified_chinese ep016_eva_talk_1ed8c55e:

    # c "The feelings I have for you both are equally strong."
    c "我对你们俩的感情都同样强烈。"

# game/episode016_conversations.rpy:242
translate simplified_chinese ep016_eva_talk_abdaf9c8:

    # c "I don't want to choose between you two."
    c "我不想在你们两人之间做出选择。"

# game/episode016_conversations.rpy:246
translate simplified_chinese ep016_eva_talk_084e52b6:

    # e "How does Lilly accept that situation?"
    e "莉莉怎么能接受这种情况？"

# game/episode016_conversations.rpy:247
translate simplified_chinese ep016_eva_talk_5fecaf4d:

    # e "Or doesn't she know about the others?"
    e "还是她根本不知道其他人的存在？"

# game/episode016_conversations.rpy:249
translate simplified_chinese ep016_eva_talk_5b25eaac:

    # e "How will Lilly accept the situation?"
    e "莉莉会怎么接受这个局面？"

# game/episode016_conversations.rpy:250
translate simplified_chinese ep016_eva_talk_754853d5:

    # e "Or aren't you going to tell her?"
    e "还是你不打算告诉她？"

# game/episode016_conversations.rpy:252
translate simplified_chinese ep016_eva_talk_7cee655a:

    # c "Lilly knows I love other women."
    c "莉莉知道我还有其他心爱的女人。"

# game/episode016_conversations.rpy:254
translate simplified_chinese ep016_eva_talk_7a0b1dee:

    # c "I'll tell her."
    c "我会告诉她的。"

# game/episode016_conversations.rpy:256
translate simplified_chinese ep016_eva_talk_191fa270:

    # e "You've managed to make me even more confused."
    e "你反倒让我更加困惑了。"

# game/episode016_conversations.rpy:259
translate simplified_chinese ep016_eva_talk_355cda68:

    # e "Here I was thinking I was some kind of freak, but instead you've gone ahead and acted on your impulses which I tried to repress for so long."
    e "刚才我还以为自己是个怪胎，结果你却把我压抑了这么久的冲动付诸行动了。"

# game/episode016_conversations.rpy:260
translate simplified_chinese ep016_eva_talk_81bbc5bc:

    # c "Do you need some time to think?"
    c "你需要些时间思考吗？"

# game/episode016_conversations.rpy:262
translate simplified_chinese ep016_eva_talk_bcb00d23:

    # e "I...{w} I don't know."
    e "我…{w}我不知道。"

# game/episode016_conversations.rpy:263
translate simplified_chinese ep016_eva_talk_d497a453:

    # e "I need you."
    e "我需要你。"

# game/episode016_conversations.rpy:265
translate simplified_chinese ep016_eva_talk_d0c4b606:

    # e "Ugh, I'm sounding desperate aren't I?"
    e "呃，我听起来很绝望对吧？"

# game/episode016_conversations.rpy:266
translate simplified_chinese ep016_eva_talk_28f78377:

    # e "I should have said something way, way earlier."
    e "我本该早得多、早得多地表明心意的。"

# game/episode016_conversations.rpy:267
translate simplified_chinese ep016_eva_talk_5fdffee0:

    # e "Confessed my feelings when you were leaving for the Academy."
    e "在你前往学院时，我就坦白了心意。"

# game/episode016_conversations.rpy:268
translate simplified_chinese ep016_eva_talk_703fb785:

    # c "I'm not sure I'd have understood you back then."
    c "我不确定当时的我能否理解你。"

# game/episode016_conversations.rpy:270
translate simplified_chinese ep016_eva_talk_bed5dbc1:

    # c "The events on the research station were a revelation in that regard."
    c "研究站发生的事在那方面给了我启示。"

# game/episode016_conversations.rpy:272
translate simplified_chinese ep016_eva_talk_51eb6594:

    # c "It’s been a slow realization over the past months."
    c "过去几个月里我慢慢领悟了这一点。"

# game/episode016_conversations.rpy:273
translate simplified_chinese ep016_eva_talk_26f514f4:

    # c "Very much like the fact that I love multiple women at the same time."
    c "就像我同时爱着多个女人这个事实一样。"

# game/episode016_conversations.rpy:275
translate simplified_chinese ep016_eva_talk_e392fe53:

    # e "I'm happy with your first epiphany, much less so with the second."
    e "我为你的第一个顿悟感到高兴，但对第二个就不那么开心了。"

# game/episode016_conversations.rpy:277
translate simplified_chinese ep016_eva_talk_36837bff:

    # e "My head is spinning, I really need to lie down for a while and process all this."
    e "我的头好晕，真的需要躺一会儿来消化这一切。"

# game/episode016_conversations.rpy:278
translate simplified_chinese ep016_eva_talk_24366554:

    # c "I understand."
    c "我明白。"

# game/episode016_conversations.rpy:280
translate simplified_chinese ep016_eva_talk_baff113e:

    # "Eva took my hand as she was about to turn and leave my quarters."
    "伊娃正要转身离开我的舱室时，握住了我的手。"

# game/episode016_conversations.rpy:282
translate simplified_chinese ep016_eva_talk_f7499c09:

    # e "Whatever I decide in the end, I'd very much like you to kiss me again."
    e "无论我最终作何决定，我都非常希望你能再吻我一次。"

# game/episode016_conversations.rpy:284
translate simplified_chinese ep016_eva_talk_bf74a186:

    # "I didn't need much more encouragement and took her in my arms."
    "我不需要更多鼓励，便将她拥入怀中。"

# game/episode016_conversations.rpy:286
translate simplified_chinese ep016_eva_talk_db4dfb6d:

    # "The kiss we exchanged was as passionate as it was longing."
    "我们交换的这个吻既充满激情又饱含渴望。"

# game/episode016_conversations.rpy:288
translate simplified_chinese ep016_eva_talk_c3adc82b:

    # "When the moment had passed, I watched Eva go, the inner conflict visible in her expression."
    "当那一刻过去，我目送伊娃离去，她表情中明显可见内心的挣扎。"

# game/episode016_conversations.rpy:289
translate simplified_chinese ep016_eva_talk_c5c24eb0:

    # "The way she'd held me as we kissed made me feel hopeful however, despite my shocking confession, it might all just work out."
    "然而，她拥吻我的方式让我感到希望—尽管我做出了令人震惊的坦白，但一切或许仍有转机。"

# game/episode016_conversations.rpy:299
translate simplified_chinese ep016_celine_talk_5fff791f:

    # "Late at night, I was looking over some data on one of the bridge consoles."
    "深夜时分，我正在舰桥控制台前查阅某些数据。"

# game/episode016_conversations.rpy:300
translate simplified_chinese ep016_celine_talk_5693e536:

    # "Behind my back, I heard the door open."
    "身后传来舱门开启的声音。"

# game/episode016_conversations.rpy:302
translate simplified_chinese ep016_celine_talk_96f79375:

    # ce "Oh...{w} I didn't think anyone would be here."
    ce "哦…{w}我没想到会有人在这里。"

# game/episode016_conversations.rpy:303
translate simplified_chinese ep016_celine_talk_ad73e646:

    # c "Just going over some details."
    c "只是在查看一些细节。"

# game/episode016_conversations.rpy:304
translate simplified_chinese ep016_celine_talk_477ec93c:

    # ce "I'll leave you alone then."
    ce "那我就不打扰你了。"

# game/episode016_conversations.rpy:305
translate simplified_chinese ep016_celine_talk_57187f9f:

    # c "No, please stay."
    c "不，请留下来。"

# game/episode016_conversations.rpy:307
translate simplified_chinese ep016_celine_talk_f549f5b1:

    # "Céline hesitated, almost turned away, but stepped inside and slumped into a chair opposite of me."
    "瑟琳犹豫了一下，几乎要转身离开，但还是走了进来，瘫坐在我对面的椅子上。"

# game/episode016_conversations.rpy:308
translate simplified_chinese ep016_celine_talk_800be268:

    # c "Can't sleep?"
    c "睡不着吗？"

# game/episode016_conversations.rpy:310
translate simplified_chinese ep016_celine_talk_aa4293ac:

    # ce "Not really no. "
    ce "确实睡不着。 "

# game/episode016_conversations.rpy:311
translate simplified_chinese ep016_celine_talk_97520da4:

    # c "Shall I get us something hot to drink from the mess?"
    c "要不要我去餐厅给我们弄点热饮？"

# game/episode016_conversations.rpy:313
translate simplified_chinese ep016_celine_talk_41c4f593:

    # ce "No, I'd rather we just talk."
    ce "不用了，我更想我们谈谈。"

# game/episode016_conversations.rpy:314
translate simplified_chinese ep016_celine_talk_897d2c63:

    # ce "I've been putting it off, but since I'm thinking of that big reveal involving Lilly and me every free moment of my time, I think we should just talk."
    ce "我一直拖延着，但既然我每时每刻都在想着莉莉和我之间那件需要摊牌的大事，我觉得我们应该谈谈。"

# game/episode016_conversations.rpy:315
translate simplified_chinese ep016_celine_talk_f5f7c27d:

    # c "Right."
    c "好吧。"

# game/episode016_conversations.rpy:317
translate simplified_chinese ep016_celine_talk_bc6e7387:

    # ce "I won't lie that I felt betrayed, really betrayed."
    ce "说实话，我感觉被背叛了，真的被背叛了。"

# game/episode016_conversations.rpy:318
translate simplified_chinese ep016_celine_talk_95d88cd4:

    # ce "I mean, the thing between us has been going on for quite a long time, at the Academy even."
    ce "我是说，我们之间的事情已经持续了很长时间，甚至在学院时就开始了。"

# game/episode016_conversations.rpy:320
translate simplified_chinese ep016_celine_talk_fe916261:

    # ce "So hearing about you being involved with another woman, other women even, was a gut punch."
    ce "所以听到你和其他女人，甚至是多个女人有染，就像被捅了一刀。"

# game/episode016_conversations.rpy:322
translate simplified_chinese ep016_celine_talk_65ef74e7:

    # ce "So hearing about you being involved with another woman, was a gut punch."
    ce "所以听说你和别的女人有染，对我简直是当头一棒。"

# game/episode016_conversations.rpy:326
translate simplified_chinese ep016_celine_talk_5585bd8a:

    # ce "The fact that one of them is my closest friend and your own sister is just icing on the cake..."
    ce "而其中一个竟然是我最好的朋友，还是你自己的亲妹妹，这更是雪上加霜…"

# game/episode016_conversations.rpy:328
translate simplified_chinese ep016_celine_talk_8a4afa75:

    # ce "The fact that one of them is my closest friend is just icing on the cake..."
    ce "而其中一个竟然是我最好的朋友，这更是雪上加霜…"

# game/episode016_conversations.rpy:332
translate simplified_chinese ep016_celine_talk_df1b7e66:

    # ce "The fact that she is my closest friend and your own sister is just icing on the cake..."
    ce "而她竟然是我最好的朋友，还是你自己的亲妹妹，这更是雪上加霜…"

# game/episode016_conversations.rpy:334
translate simplified_chinese ep016_celine_talk_49df59ff:

    # ce "The fact that she is my closest friend is just icing on the cake..."
    ce "而她竟然是我最好的朋友，这更是雪上加霜…"

# game/episode016_conversations.rpy:336
translate simplified_chinese ep016_celine_talk_62542ae4:

    # ce "So I thought of giving up on us, on our relationship."
    ce "所以我曾想过放弃我们，放弃我们的关系。"

# game/episode016_conversations.rpy:338
translate simplified_chinese ep016_celine_talk_56e23501:

    # ce "I mean, it would be the most logical thing to do, wouldn't it?"
    ce "我是说，这应该是最理智的做法，不是吗？"

# game/episode016_conversations.rpy:339
translate simplified_chinese ep016_celine_talk_6feb2dda:

    # c "Perhaps."
    c "或许吧。"

# game/episode016_conversations.rpy:341
translate simplified_chinese ep016_celine_talk_07e33995:

    # ce "But the thought of not being together is turning out too hard to bear."
    ce "但想到不能在一起，我实在难以承受。"

# game/episode016_conversations.rpy:343
translate simplified_chinese ep016_celine_talk_fc666638:

    # ce "I don't like that you want to be with other women, but I also want us to stay together."
    ce "我不喜欢你和其他女人在一起，但我也想我们继续在一起。"

# game/episode016_conversations.rpy:345
translate simplified_chinese ep016_celine_talk_af78612a:

    # ce "And I’ve been going back and forth in my head so many times now, it’s making me go crazy."
    ce "我在脑海中反复纠结了这么多次，简直快把我逼疯了。"

# game/episode016_conversations.rpy:346
translate simplified_chinese ep016_celine_talk_e4290a9e:

    # ce "So I think I’m going to have to choose."
    ce "所以我觉得我必须做出选择。"

# game/episode016_conversations.rpy:348
translate simplified_chinese ep016_celine_talk_b9d8324d:

    # "Céline gave me a pained look, her emotions still torn."
    "瑟琳痛苦地看着我，她的情绪依然纠结。"

# game/episode016_conversations.rpy:350
translate simplified_chinese ep016_celine_talk_7f92f967:

    # ce "I want to give us a chance."
    ce "我想给我们一个机会。"

# game/episode016_conversations.rpy:352
translate simplified_chinese ep016_celine_talk_108364e4:

    # ce "I love you and couldn’t bear to be the one outside looking in."
    ce "我爱你，无法忍受成为被排除在外的那个人。"

# game/episode016_conversations.rpy:353
translate simplified_chinese ep016_celine_talk_cde76d2b:

    # c "You don’t know how happy that makes me."
    c "你不知道这让我有多开心。"

# game/episode016_conversations.rpy:356
translate simplified_chinese ep016_celine_talk_67a93635:

    # ce "Now, you asked us both to consider some other form of love."
    ce "现在，你要求我们俩都考虑另一种形式的爱。"

# game/episode016_conversations.rpy:357
translate simplified_chinese ep016_celine_talk_fe556dd9:

    # ce "Polyamory, for a lack of a more specific word."
    ce "用一个不太准确的词来说，就是多角恋。"

# game/episode016_conversations.rpy:359
translate simplified_chinese ep016_celine_talk_fd832b6c:

    # ce "I’m not sure if I’m ready to commit to that."
    ce "我不确定自己是否准备好接受这种关系。"

# game/episode016_conversations.rpy:360
translate simplified_chinese ep016_celine_talk_da40fa4b:

    # c "It’s okay if you won’t."
    c "如果你不愿意也没关系。"

# game/episode016_conversations.rpy:362
translate simplified_chinese ep016_celine_talk_21de6a6b:

    # ce "I’m not saying I won’t, I’m just not ready yet to deal with something like that."
    ce "我不是说我不会接受，只是还没准备好面对这样的事情。"

# game/episode016_conversations.rpy:363
translate simplified_chinese ep016_celine_talk_0f086256:

    # ce "But who knows, maybe when our relationship feels a little more stable."
    ce "但谁知道呢，也许等我们的关系更稳定一些的时候。"

# game/episode016_conversations.rpy:367
translate simplified_chinese ep016_celine_talk_30343447:

    # ce "Now, I’m aware you have a relationship with [romances]."
    ce "我知道你和[romances]有感情关系。"

# game/episode016_conversations.rpy:369
translate simplified_chinese ep016_celine_talk_77b69cd3:

    # ce "I don’t want to hear about them."
    ce "我不想听到关于她们的事。"

# game/episode016_conversations.rpy:371
translate simplified_chinese ep016_celine_talk_63789502:

    # ce "I don’t want to hear about her."
    ce "我不想听到关于她的事。"

# game/episode016_conversations.rpy:372
translate simplified_chinese ep016_celine_talk_db6984fb:

    # ce "So, I’m asking you to be discreet and devote yourself completely to me when we’re together."
    ce "所以，我要求你保持谨慎，当我们在一起时要完全忠于我。"

# game/episode016_conversations.rpy:373
translate simplified_chinese ep016_celine_talk_58a954ef:

    # c "I promise and I will."
    c "我保证，我会做到的。"

# game/episode016_conversations.rpy:374
translate simplified_chinese ep016_celine_talk_ce7645f2:

    # ce "I suppose that’s good enough for me."
    ce "我想这对我来说已经足够了。"

# game/episode016_conversations.rpy:375
translate simplified_chinese ep016_celine_talk_73b5a556:

    # c "You’re awesome, Céline."
    c "你真是太棒了，瑟琳。"

# game/episode016_conversations.rpy:377
translate simplified_chinese ep016_celine_talk_9676a87c:

    # ce "I’m glad I got this off my chest."
    ce "很高兴我能把这些话说出来。"

# game/episode016_conversations.rpy:378
translate simplified_chinese ep016_celine_talk_cfb537a7:

    # ce "I feel ready to look forward now."
    ce "我觉得现在可以展望未来了。"

# game/episode016_conversations.rpy:379
translate simplified_chinese ep016_celine_talk_bfa656fe:

    # "Céline stood up and walked towards me."
    "瑟琳站起身向我走来。"

# game/episode016_conversations.rpy:381
translate simplified_chinese ep016_celine_talk_7b9bd3a0:

    # "I wrapped my arms around her and we kissed."
    "我伸手环抱住她，我们接吻了。"

# game/episode016_conversations.rpy:383
translate simplified_chinese ep016_celine_talk_4467e7ea:

    # "The kiss quickly turned into something more hungry and I had Céline’s top off in seconds."
    "这个吻很快变得饥渴起来，几秒钟内我就脱掉了瑟琳的上衣。"

# game/episode016_conversations.rpy:385
translate simplified_chinese ep016_celine_talk_ae7bae9b:

    # "Her hands were on my crotch and she was about to undo my zipper when we heard a door open in the hallway."
    "她的手放在我的胯部，正要拉开我的拉链时，我们听到走廊里有开门声。"

# game/episode016_conversations.rpy:387
translate simplified_chinese ep016_celine_talk_5ba83e8d:

    # ce "Shit!"
    ce "该死！"

# game/episode016_conversations.rpy:388
translate simplified_chinese ep016_celine_talk_a75f5abb:

    # "Getting caught fucking on the bridge during night time would be a little hard to explain, so Céline rushed to get her top on again."
    "要是半夜在舰桥上做爱被抓个正着可不好解释，所以瑟琳赶紧重新穿好上衣。"

# game/episode016_conversations.rpy:390
translate simplified_chinese ep016_celine_talk_39b70b18:

    # "Aven walked by the opened door and peeked inside."
    "艾文经过敞开的门边，朝里面瞥了一眼。"

# game/episode016_conversations.rpy:392
translate simplified_chinese ep016_celine_talk_b54ae4ad:

    # av "Oh, it’s you, I thought I heard strange voices."
    av "哦，是你啊，我还以为听到了奇怪的声音。"

# game/episode016_conversations.rpy:393
translate simplified_chinese ep016_celine_talk_72f6fd40:

    # c "Can’t sleep either?"
    c "你也睡不着吗？"

# game/episode016_conversations.rpy:394
translate simplified_chinese ep016_celine_talk_cc4fbcaf:

    # av "No, not really."
    av "不，不太睡得着。"

# game/episode016_conversations.rpy:395
translate simplified_chinese ep016_celine_talk_1fe826b4:

    # av "I was on my way to the mess to get something to drink."
    av "我正要去食堂弄点喝的。"

# game/episode016_conversations.rpy:397
translate simplified_chinese ep016_celine_talk_91046a2f:

    # ce "I think I’m going to get some sleep."
    ce "我想我该去睡会儿了。"

# game/episode016_conversations.rpy:399
translate simplified_chinese ep016_celine_talk_b6ee53d0:

    # ce "Thanks for the talk, [p_name_short], we should really continue some time tomorrow."
    ce "谢谢你的谈话，[p_name_short]，我们明天真该继续聊聊。"

# game/episode016_conversations.rpy:400
translate simplified_chinese ep016_celine_talk_84f0f4fe:

    # "Céline’s meaningful expression suggested we wouldn’t do much talking tomorrow and I looked forward to it with glee."
    "瑟琳意味深长的表情暗示明天我们不会说太多话，我满心欢喜地期待着。"

# game/episode016_conversations.rpy:402
translate simplified_chinese ep016_celine_talk_95440418:

    # "Aven didn’t seem to notice what happened between us and shuffled behind Céline towards the mess, leaving me alone on the bridge."
    "艾文似乎没注意到我们之间发生了什么，拖着脚步跟在瑟琳后面走向食堂，把我独自留在舰桥上。"

# game/episode016_conversations.rpy:411
translate simplified_chinese ep016_thyia_talk_6463c945:

    # "For the duration of our stay, Thyia mostly stayed on the Bastard."
    "在我们停留期间，塞娅大部分时间都待在\"私生子\"号上。"

# game/episode016_conversations.rpy:413
translate simplified_chinese ep016_thyia_talk_c0d66333:

    # "For the duration of our stay, Thyia mostly remained holed up in the engine room."
    "在我们停留期间，塞娅大部分时间都窝在引擎室里。"

# game/episode016_conversations.rpy:414
translate simplified_chinese ep016_thyia_talk_fe0db63e:

    # "She was working on something and that seemed to take up most of her time."
    "她在忙些什么，那似乎占用了她大部分时间。"

# game/episode016_conversations.rpy:416
translate simplified_chinese ep016_thyia_talk_da20415c:

    # "I went to check up on her."
    "我去看了看她。"

# game/episode016_conversations.rpy:418
translate simplified_chinese ep016_thyia_talk_b1e772e6:

    # th "MOTHERFUCK!"
    th "操他妈的！"

# game/episode016_conversations.rpy:419
translate simplified_chinese ep016_thyia_talk_3c7d07d4:

    # "Thyia’s exclamation was followed by the crash of something metal against the bulkhead."
    "塞娅的叫骂声之后，是金属物体撞在舱壁上的巨响。"

# game/episode016_conversations.rpy:421
translate simplified_chinese ep016_thyia_talk_88ee53ce:

    # "I had to evade a screwdriver that sailed through the air as I entered the engine room."
    "我走进引擎室时不得不躲开一把飞过空中的螺丝刀。"

# game/episode016_conversations.rpy:422
translate simplified_chinese ep016_thyia_talk_14df272a:

    # c "Thyia, are you okay?"
    c "塞娅，你还好吗？"

# game/episode016_conversations.rpy:424
translate simplified_chinese ep016_thyia_talk_71db2fc4:

    # th "What?!"
    th "什么？！"

# game/episode016_conversations.rpy:426
translate simplified_chinese ep016_thyia_talk_17937de3:

    # th "Oh...{w} Shit...{w} Sorry."
    th "哦…{w} 靠…{w} 抱歉。"

# game/episode016_conversations.rpy:427
translate simplified_chinese ep016_thyia_talk_e5f6ea96:

    # c "Is there something wrong?"
    c "出什么问题了吗？"

# game/episode016_conversations.rpy:429
translate simplified_chinese ep016_thyia_talk_eee8bd6d:

    # th "Just frustrated."
    th "就是有点沮丧。"

# game/episode016_conversations.rpy:430
translate simplified_chinese ep016_thyia_talk_61792d20:

    # c "Well, you just tried to either murder me or the ship’s engine, so I’d say it’s more than just frustration."
    c "呃，你刚才不是想杀了我就是想毁了飞船引擎，所以我觉得不只是\"有点沮丧\"这么简单。"

# game/episode016_conversations.rpy:432
translate simplified_chinese ep016_thyia_talk_1caa8f10:

    # th "I’ve been trying to get this stupid robot to work."
    th "我一直想把这台破机器人修好。"

# game/episode016_conversations.rpy:433
translate simplified_chinese ep016_thyia_talk_8295fdbc:

    # c "Still working on that?"
    c "还在忙这个？"

# game/episode016_conversations.rpy:434
translate simplified_chinese ep016_thyia_talk_69ef852e:

    # th "Yes, and I was progressing well, but I’m fiddling with the main processing unit."
    th "是啊，本来进展挺顺利的，但我在捣鼓主处理器单元。"

# game/episode016_conversations.rpy:435
translate simplified_chinese ep016_thyia_talk_153bf0ac:

    # th "It just won’t work."
    th "就是搞不定。"

# game/episode016_conversations.rpy:436
translate simplified_chinese ep016_thyia_talk_5e4a819f:

    # c "Have you taken a break yet?"
    c "你休息过了吗？"

# game/episode016_conversations.rpy:438
translate simplified_chinese ep016_thyia_talk_86d3c0bd:

    # th "Sure I have."
    th "当然休息了。"

# game/episode016_conversations.rpy:439
translate simplified_chinese ep016_thyia_talk_63f6ac5d:

    # c "When was the last time you actually stepped away from this, Thyia?"
    c "你上次真正离开这里是什么时候，塞娅？"

# game/episode016_conversations.rpy:441
translate simplified_chinese ep016_thyia_talk_eda4374d:

    # th "Okay fine, I didn’t take any breaks."
    th "好吧好吧，我没休息过。"

# game/episode016_conversations.rpy:442
translate simplified_chinese ep016_thyia_talk_e207147e:

    # th "I just want this piece of trash to work!"
    th "我就是想让这堆垃圾运转起来！"

# game/episode016_conversations.rpy:443
translate simplified_chinese ep016_thyia_talk_acf226d7:

    # c "I’m sure it will in due time."
    c "我相信到时候它肯定会好的。"

# game/episode016_conversations.rpy:444
translate simplified_chinese ep016_thyia_talk_c222da1a:

    # c "But for now I’m going to whisk you away and we’re going to have have some fun in the city."
    c "但现在我要带你离开，我们得去城里找点乐子。"

# game/episode016_conversations.rpy:445
translate simplified_chinese ep016_thyia_talk_d66b087a:

    # c "You’ve been cooped up for far too long in this metal cage."
    c "你在这个金属笼子里待得太久了。"

# game/episode016_conversations.rpy:447
translate simplified_chinese ep016_thyia_talk_0c2e40ac:

    # th "What are we going to do?"
    th "我们要做什么？"

# game/episode016_conversations.rpy:448
translate simplified_chinese ep016_thyia_talk_dcbff6ec:

    # c "We’re going out to dinner, wear something nice."
    c "我们要出去吃晚餐，穿得体面些。"

# game/episode016_conversations.rpy:449
translate simplified_chinese ep016_thyia_talk_f8949d43:

    # th "But..."
    th "但是…"

# game/episode016_conversations.rpy:450
translate simplified_chinese ep016_thyia_talk_410b01c8:

    # c "See you in an hour."
    c "一小时后见。"

# game/episode016_conversations.rpy:452
translate simplified_chinese ep016_thyia_talk_db13642d:

    # "I didn’t wait for Thyia to come up with any excuses and walked out of the engine room."
    "我没等塞娅想出任何借口，就走出了引擎室。"

# game/episode016_conversations.rpy:454
translate simplified_chinese ep016_thyia_talk_112a07df:

    # "When I returned an hour later, I was half-dreading to find Thyia still covered in grease and working on that robot of hers."
    "一小时后我回来时，我有点担心会发现塞娅仍然满身油污，还在捣鼓她的那个机器人。"

# game/episode016_conversations.rpy:456
translate simplified_chinese ep016_thyia_talk_4ac1799c:

    # "Instead she was waiting for me, all dolled-up and decidedly not greasy."
    "相反，她正在等我，打扮得漂漂亮亮的，而且一点油污都没有。"

# game/episode016_conversations.rpy:458
translate simplified_chinese ep016_thyia_talk_aaf38d39:

    # c "Damn, you look ready."
    c "哇，你看起来准备好了。"

# game/episode016_conversations.rpy:460
translate simplified_chinese ep016_thyia_talk_085a906d:

    # th "I think I am."
    th "我想是的。"

# game/episode016_conversations.rpy:462
translate simplified_chinese ep016_thyia_talk_ecaae6e4:

    # "We left the Bastard and headed out in to the Rhenkoy capital where I’d made reservations at an upscale restaurant."
    "我们离开了“私生子”号，前往伦科伊首府，我在那里的一家高档餐厅预订了位置。"

# game/episode016_conversations.rpy:464
translate simplified_chinese ep016_thyia_talk_d6024f96:

    # "After we were seated I noticed Thyia looking a little tense."
    "入座后，我注意到塞娅看起来有些紧张。"

# game/episode016_conversations.rpy:465
translate simplified_chinese ep016_thyia_talk_4b9e0353:

    # c "Are you alright?"
    c "你还好吗？"

# game/episode016_conversations.rpy:466
translate simplified_chinese ep016_thyia_talk_1051a283:

    # th "Yes, it’s just..."
    th "是的，只是…"

# game/episode016_conversations.rpy:467
translate simplified_chinese ep016_thyia_talk_27735d9a:

    # c "Not your kinda place?"
    c "不是你喜欢的地方？"

# game/episode016_conversations.rpy:468
translate simplified_chinese ep016_thyia_talk_e4df7c6d:

    # th "No, not that."
    th "不，不是那样。"

# game/episode016_conversations.rpy:469
translate simplified_chinese ep016_thyia_talk_684e94f5:

    # th "It’s just that, I mean, this is a date, right?"
    th "只是，我是说，这算是一次约会，对吧？"

# game/episode016_conversations.rpy:470
translate simplified_chinese ep016_thyia_talk_73d973b1:

    # c "Well, we have to eat, so might as well do it somewhere nice."
    c "嗯，我们总得吃饭，不如找个好地方。"

# game/episode016_conversations.rpy:471
translate simplified_chinese ep016_thyia_talk_0efa351e:

    # c "Also, considering what we’ve been through, I’d say we’re way past simple fuckbuddies."
    c "再说了，考虑到我们共同经历的那些事，我觉得我们早就超越单纯炮友的关系了。"

# game/episode016_conversations.rpy:472
translate simplified_chinese ep016_thyia_talk_6470e046:

    # c "Don’t you agree?"
    c "你不同意吗？"

# game/episode016_conversations.rpy:474
translate simplified_chinese ep016_thyia_talk_eb69507e:

    # th "Maybe...{w} You know I’m not really good at relationships."
    th "也许…{w}你知道我不太擅长处理感情关系。"

# game/episode016_conversations.rpy:475
translate simplified_chinese ep016_thyia_talk_543432d3:

    # c "So you’ve told me."
    c "你之前跟我说过。"

# game/episode016_conversations.rpy:477
translate simplified_chinese ep016_thyia_talk_ee3a001e:

    # th "We’re going to sit here for maybe two or three hours and I get nervous."
    th "我们要在这里坐两三个小时，这让我很紧张。"

# game/episode016_conversations.rpy:478
translate simplified_chinese ep016_thyia_talk_4e5a4202:

    # c "Why?"
    c "为什么？"

# game/episode016_conversations.rpy:480
translate simplified_chinese ep016_thyia_talk_8d360fba:

    # th "Well, how are we going to fill all that time?"
    th "呃，我们该怎么打发这么长时间？"

# game/episode016_conversations.rpy:481
translate simplified_chinese ep016_thyia_talk_09f53fd8:

    # th "Maybe we run out of things to say and we’ll just sit there in silence."
    th "也许我们会没话可说，只能尴尬地沉默。"

# game/episode016_conversations.rpy:482
translate simplified_chinese ep016_thyia_talk_33fa342b:

    # th "Or maybe I say something offensive...{w} I don’t know."
    th "或者我说了什么冒犯的话…{w}我不知道。"

# game/episode016_conversations.rpy:483
translate simplified_chinese ep016_thyia_talk_b93898da:

    # c "The conversation hasn’t stopped yet and I haven’t felt offended, so maybe we should just go with the flow."
    c "我们的对话还没中断过，我也没觉得被冒犯，也许我们应该顺其自然。"

# game/episode016_conversations.rpy:484
translate simplified_chinese ep016_thyia_talk_72325f0a:

    # c "Stop fretting so much."
    c "别这么焦虑。"

# game/episode016_conversations.rpy:486
translate simplified_chinese ep016_thyia_talk_9d678f06:

    # th "Maybe you’re right."
    th "也许你是对的。"

# game/episode016_conversations.rpy:487
translate simplified_chinese ep016_thyia_talk_d52232e6:

    # th "I’ve always been on the defensive."
    th "我一直都在防备着。"

# game/episode016_conversations.rpy:489
translate simplified_chinese ep016_thyia_talk_26a13f9a:

    # th "Always afraid I’d get hurt, or did something to hurt someone else."
    th "总是害怕自己会受伤，或者做了什么伤害别人的事。"

# game/episode016_conversations.rpy:490
translate simplified_chinese ep016_thyia_talk_c837c57e:

    # th "So it’s really hard to get rid of that mindset."
    th "所以真的很难摆脱这种心态。"

# game/episode016_conversations.rpy:491
translate simplified_chinese ep016_thyia_talk_3cf92ba9:

    # c "I get that."
    c "我理解。"

# game/episode016_conversations.rpy:492
translate simplified_chinese ep016_thyia_talk_a05b155d:

    # c "Try and let go of that."
    c "试着放下这些吧。"

# game/episode016_conversations.rpy:493
translate simplified_chinese ep016_thyia_talk_9b757558:

    # c "Just enjoy the moment."
    c "好好享受此刻。"

# game/episode016_conversations.rpy:495
translate simplified_chinese ep016_thyia_talk_e1a2e642:

    # th "I’ll try."
    th "我会试试的。"

# game/episode016_conversations.rpy:496
translate simplified_chinese ep016_thyia_talk_3348d68f:

    # c "Good, ready to order?"
    c "很好，准备好点餐了吗？"

# game/episode016_conversations.rpy:497
translate simplified_chinese ep016_thyia_talk_e07b8a7f:

    # th "Ready as I’ll ever be."
    th "随时都行。"

# game/episode016_conversations.rpy:499
translate simplified_chinese ep016_thyia_talk_0dc95215:

    # "After someone came to take our order, conversation shifted away from Thyia’s existential crisis and we talked about everything and nothing."
    "在有人来为我们点餐后，谈话从塞娅的存在危机转移开来，我们聊了些有的没的。"

# game/episode016_conversations.rpy:500
translate simplified_chinese ep016_thyia_talk_432c8ab4:

    # "The wine made Thyia a little more loose-lipped than usual and conversation flowed easily."
    "葡萄酒让塞娅比平时更口无遮拦，交谈变得轻松自如。"

# game/episode016_conversations.rpy:501
translate simplified_chinese ep016_thyia_talk_b5e30d6b:

    # "When the first real silence eventually fell, Thyia smiled at me."
    "当第一次真正的沉默最终降临时，塞娅对我笑了笑。"

# game/episode016_conversations.rpy:503
translate simplified_chinese ep016_thyia_talk_89729f04:

    # th "I guess sitting in silence for a while isn’t as bad as I’d thought."
    th "我想静静地坐一会儿并没有我原先想的那么糟糕。"

# game/episode016_conversations.rpy:504
translate simplified_chinese ep016_thyia_talk_84aea57c:

    # c "Certainly."
    c "当然。"

# game/episode016_conversations.rpy:505
translate simplified_chinese ep016_thyia_talk_50ed449d:

    # c "Though you’d be in your rights to hit me if I’d took the opportunity to check my messages during that moment of silence."
    c "不过如果我趁着沉默时刻查看消息，你完全有权利揍我一顿。"

# game/episode016_conversations.rpy:507
translate simplified_chinese ep016_thyia_talk_9e6ed6b9:

    # th "Noted."
    th "记住了。"

# game/episode016_conversations.rpy:509
translate simplified_chinese ep016_thyia_talk_f7b8072f:

    # th "And thank you for bearing with me."
    th "还有谢谢你一直包容我。"

# game/episode016_conversations.rpy:510
translate simplified_chinese ep016_thyia_talk_79d48745:

    # th "I’m sure my antics aren’t always easy to deal with."
    th "我确信我的古怪行为并不总是容易应付。"

# game/episode016_conversations.rpy:511
translate simplified_chinese ep016_thyia_talk_66d86daa:

    # c "I would have left you raging at that half-finished robot in that case."
    c "否则我可能还在对着那个半成品机器人发火呢。"

# game/episode016_conversations.rpy:513
translate simplified_chinese ep016_thyia_talk_db79743c:

    # th "I might have destroyed it in the process, so thanks for taking me out."
    th "说不定在发泄过程中还会把它砸了，所以谢谢你带我出来。"

# game/episode016_conversations.rpy:514
translate simplified_chinese ep016_thyia_talk_3422c136:

    # th "The fear of me getting too comfortable is maddening sometimes, though."
    th "不过，有时候害怕自己太过安逸的想法确实令人抓狂。"

# game/episode016_conversations.rpy:516
translate simplified_chinese ep016_thyia_talk_0b618437:

    # th "I catch myself thinking about the future and a little voice starts telling me I shouldn’t, because it could all end up a disappointment."
    th "我发现自己开始考虑未来时，总有个小声音告诉我别这么做，因为最终可能会失望。"

# game/episode016_conversations.rpy:517
translate simplified_chinese ep016_thyia_talk_7331ba48:

    # c "I get why that would be tiresome."
    c "我明白这确实会让人厌烦。"

# game/episode016_conversations.rpy:518
translate simplified_chinese ep016_thyia_talk_2d0be977:

    # c "Sometimes it’s good to just dream of what the future might hold."
    c "有时候单纯地梦想未来可能发生的事情也不错。"

# game/episode016_conversations.rpy:519
translate simplified_chinese ep016_thyia_talk_def0fdfb:

    # th "I know."
    th "我知道。"

# game/episode016_conversations.rpy:520
translate simplified_chinese ep016_thyia_talk_744d21cb:

    # c "What do you dream about?"
    c "你都梦想些什么？"

# game/episode016_conversations.rpy:522
translate simplified_chinese ep016_thyia_talk_b4bcc529:

    # th "You know...{w} Things..."
    th "你知道的…{w} 一些事情…"

# game/episode016_conversations.rpy:523
translate simplified_chinese ep016_thyia_talk_b05ec5fd:

    # c "That’s very vague."
    c "这说得太含糊了。"

# game/episode016_conversations.rpy:525
translate simplified_chinese ep016_thyia_talk_05650964:

    # th "All kinds of stuff."
    th "各种各样的东西。"

# game/episode016_conversations.rpy:526
translate simplified_chinese ep016_thyia_talk_dbbd3e5c:

    # c "You know you’re quite cute when you’re flustered."
    c "你知道吗，你慌张的样子还挺可爱的。"

# game/episode016_conversations.rpy:528
translate simplified_chinese ep016_thyia_talk_72b961e9:

    # th "Sadist."
    th "施虐狂。"

# game/episode016_conversations.rpy:530
translate simplified_chinese ep016_thyia_talk_474be8f4:

    # th "Alright, I’ll tell you, but you have to promise not to laugh."
    th "好吧，我告诉你，但你要保证不笑。"

# game/episode016_conversations.rpy:531
translate simplified_chinese ep016_thyia_talk_e5d49c39:

    # th "Sometimes, I think about you and me, walking down the aisle."
    th "有时候，我会想象你和我，一起走过婚礼红毯。"

# game/episode016_conversations.rpy:532
translate simplified_chinese ep016_thyia_talk_da35fef3:

    # th "Like in the olden days, you know."
    th "就像古时候那样，你懂的。"

# game/episode016_conversations.rpy:533
translate simplified_chinese ep016_thyia_talk_767112d4:

    # c "Getting married, you mean?"
    c "你是说，结婚？"

# game/episode016_conversations.rpy:534
translate simplified_chinese ep016_thyia_talk_b2c76295:

    # th "Yes, it might be more common in the Sovereignty?"
    th "是的，这在\"至高权域\"可能更常见吧？"

# game/episode016_conversations.rpy:535
translate simplified_chinese ep016_thyia_talk_f38fd4b8:

    # c "It certainly is among the nobility."
    c "在贵族阶层确实如此。"

# game/episode016_conversations.rpy:536
translate simplified_chinese ep016_thyia_talk_ad0b4624:

    # c "Sometimes the marriages are even arranged."
    c "有时候婚姻甚至是包办的。"

# game/episode016_conversations.rpy:537
translate simplified_chinese ep016_thyia_talk_08b2b216:

    # c "But you’re trying to steer me away from the real subject."
    c "但你在试图转移真正的话题。"

# game/episode016_conversations.rpy:539
translate simplified_chinese ep016_thyia_talk_887e1f43:

    # th "Which is?"
    th "什么话题？"

# game/episode016_conversations.rpy:540
translate simplified_chinese ep016_thyia_talk_8e7c2f09:

    # c "You in a white dress."
    c "你穿着白色婚纱。"

# game/episode016_conversations.rpy:542
translate simplified_chinese ep016_thyia_talk_2268d1f3:

    # th "Oh fuck off."
    th "哦，滚开啦。"

# game/episode016_conversations.rpy:543
translate simplified_chinese ep016_thyia_talk_f3025a13:

    # c "You’d look lovely in it."
    c "你穿起来一定很美。"

# game/episode016_conversations.rpy:545
translate simplified_chinese ep016_thyia_talk_af71460d:

    # th "Maybe...{w} It’s something I’ve dreamed of as a little girl."
    th "也许…{w} 这是我小时候就梦想过的事情。"

# game/episode016_conversations.rpy:546
translate simplified_chinese ep016_thyia_talk_34930525:

    # th "Me in a big wedding dress, looking like a princess and mothering over an army of kids."
    th "我穿着巨大的婚纱，看起来像个公主，还要照顾一大群孩子。"

# game/episode016_conversations.rpy:548
translate simplified_chinese ep016_thyia_talk_a9ea40ae:

    # th "So it feels a little childish to bring it up now."
    th "所以现在提起来感觉有点幼稚。"

# game/episode016_conversations.rpy:549
translate simplified_chinese ep016_thyia_talk_feed0188:

    # c "It’s absolutely nothing like that."
    c "完全不是那么回事。"

# game/episode016_conversations.rpy:551
translate simplified_chinese ep016_thyia_talk_62bc6e90:

    # th "Maybe not."
    th "也许不是。"

# game/episode016_conversations.rpy:552
translate simplified_chinese ep016_thyia_talk_fdb5c5f8:

    # c "But kids?"
    c "但是孩子？"

# game/episode016_conversations.rpy:554
translate simplified_chinese ep016_thyia_talk_d15356af:

    # th "Oh shit, I meant nothing by that."
    th "哦该死，我不是那个意思。"

# game/episode016_conversations.rpy:555
translate simplified_chinese ep016_thyia_talk_2ad1e104:

    # th "As I said, something I dreamed up as a little girl."
    th "就像我说的，这是我小时候幻想过的事情。"

# game/episode016_conversations.rpy:559
translate simplified_chinese ep016_thyia_talk_ccc698d1:

    # c "But it’s something you’re still thinking about?"
    c "但你到现在还在想这件事吗？"

# game/episode016_conversations.rpy:561
translate simplified_chinese ep016_thyia_talk_c9d75c2f:

    # th "Just sometimes, and then reality sets in."
    th "只是偶尔想想，然后现实就摆在眼前了。"

# game/episode016_conversations.rpy:562
translate simplified_chinese ep016_thyia_talk_ee9c0810:

    # c "Yeah, the life we lead isn’t ideal, but I still want to start a family in the near future."
    c "是啊，我们过的生活并不理想，但我还是想在不久的将来组建家庭。"

# game/episode016_conversations.rpy:564
translate simplified_chinese ep016_thyia_talk_4ce31c99:

    # th "You would?"
    th "你会吗？"

# game/episode016_conversations.rpy:565
translate simplified_chinese ep016_thyia_talk_0de2deac:

    # c "Yes, I would."
    c "是的，我会。"

# game/episode016_conversations.rpy:566
translate simplified_chinese ep016_thyia_talk_22d33b7d:

    # c "With you, if you’re willing."
    c "和你一起，如果你愿意的话。"

# game/episode016_conversations.rpy:567
translate simplified_chinese ep016_thyia_talk_1bc2f807:

    # th "I..."
    th "我…"

# game/episode016_conversations.rpy:568
translate simplified_chinese ep016_thyia_talk_128bce52:

    # th "I’d need to think about it."
    th "我需要考虑一下。"

# game/episode016_conversations.rpy:569
translate simplified_chinese ep016_thyia_talk_e1e8978a:

    # c "Of course, take your time."
    c "当然，慢慢考虑。"

# game/episode016_conversations.rpy:570
translate simplified_chinese ep016_thyia_talk_f5e55463:

    # c "Wedding first maybe?"
    c "也许先办婚礼？"

# game/episode016_conversations.rpy:571
translate simplified_chinese ep016_thyia_talk_7daf669d:

    # c "You in that white princess dress?"
    c "你穿那种白色公主裙？"

# game/episode016_conversations.rpy:573
translate simplified_chinese ep016_thyia_talk_520cf5c6:

    # th "Haha, be careful what you wish for."
    th "哈哈，小心一语成谶。"

# game/episode016_conversations.rpy:574
translate simplified_chinese ep016_thyia_talk_60acc0c1:

    # c "So if I were to go on one knee in the near future, would you say yes?"
    c "所以如果我近期单膝下跪求婚，你会答应吗？"

# game/episode016_conversations.rpy:576
translate simplified_chinese ep016_thyia_talk_4aa8942b:

    # th "I’d certainly consider it seriously."
    th "我肯定会认真考虑的。"

# game/episode016_conversations.rpy:577
translate simplified_chinese ep016_thyia_talk_4cccaae7:

    # c "Not the response I hoped for."
    c "这不是我想要的回答。"

# game/episode016_conversations.rpy:579
translate simplified_chinese ep016_thyia_talk_4807fc76:

    # th "Hey, if you asked me all these questions some months ago, I’d have panicked and run out of this place, leaving you to eat alone."
    th "嘿，要是几个月前你问我这些问题，我肯定会惊慌失措地逃出这里，留你一个人吃饭。"

# game/episode016_conversations.rpy:580
translate simplified_chinese ep016_thyia_talk_61212d91:

    # c "I’ll count my blessings, in that case."
    c "既然如此，我会知足的。"

# game/episode016_conversations.rpy:582
translate simplified_chinese ep016_thyia_talk_c6e9c5e8:

    # c "Yeah, considering the life we lead, I don’t think starting a family is an option."
    c "是啊，考虑到我们现在的生活，我觉得组建家庭不太现实。"

# game/episode016_conversations.rpy:583
translate simplified_chinese ep016_thyia_talk_a8d2c302:

    # c "A wedding though..."
    c "不过婚礼嘛…"

# game/episode016_conversations.rpy:585
translate simplified_chinese ep016_thyia_talk_ec7856ff:

    # th "Oh stop it."
    th "哦，别说了。"

# game/episode016_conversations.rpy:586
translate simplified_chinese ep016_thyia_talk_b65bf52a:

    # c "No, I’m serious."
    c "不，我是认真的。"

# game/episode016_conversations.rpy:587
translate simplified_chinese ep016_thyia_talk_622b9ce7:

    # c "If I were to go on one knee in the near future, would you say yes?"
    c "如果我近期单膝下跪求婚，你会答应吗？"

# game/episode016_conversations.rpy:589
translate simplified_chinese ep016_thyia_talk_635a0ef5:

    # th "I’d have to think about it."
    th "我得考虑考虑。"

# game/episode016_conversations.rpy:590
translate simplified_chinese ep016_thyia_talk_d491c046:

    # c "Think about that princess in a white dress."
    c "想想那个穿白色公主裙的身影。"

# game/episode016_conversations.rpy:592
translate simplified_chinese ep016_thyia_talk_104c98cb:

    # th "Haha, I will."
    th "哈哈，我会的。"

# game/episode016_conversations.rpy:594
translate simplified_chinese ep016_thyia_talk_16fa8e95:

    # "The server interrupted us with the dessert menu."
    "服务员拿着甜点菜单打断了我们。"

# game/episode016_conversations.rpy:596
translate simplified_chinese ep016_thyia_talk_406b498e:

    # "Thyia was visibly relaxed for the remainder of the evening."
    "塞娅在接下来的夜晚明显放松了许多。"

# game/episode016_conversations.rpy:597
translate simplified_chinese ep016_thyia_talk_5bc7f5c9:

    # "When we finally got the check, a mischievous smile played on her lips."
    "当我们终于拿到账单时，她嘴角浮现出一抹狡黠的微笑。"

# game/episode016_conversations.rpy:599
translate simplified_chinese ep016_thyia_talk_c780e7b7:

    # th "I really want you to follow me to the restrooms."
    th "我真的很想让你跟我去洗手间。"

# game/episode016_conversations.rpy:600
translate simplified_chinese ep016_thyia_talk_6ad256b6:

    # c "The restrooms?"
    c "休息室？"

# game/episode016_conversations.rpy:601
translate simplified_chinese ep016_thyia_talk_d24eaa0c:

    # th "Yes, that dessert wasn’t enough for me."
    th "是的，那份甜点对我来说还不够。"

# game/episode016_conversations.rpy:603
translate simplified_chinese ep016_thyia_talk_64072020:

    # "We both stood up and Thyia led me through the restaurant towards the restrooms."
    "我们俩都站了起来，塞娅领着我穿过餐厅走向休息室。"

# game/episode016_conversations.rpy:613
translate simplified_chinese ep016_vess_talk_836e7d0b:

    # "I'd given Vess a list of chores to complete which were normally spread among the rest of the crew."
    "我给了薇丝一份杂务清单，这些通常是由其他船员分担的。"

# game/episode016_conversations.rpy:614
translate simplified_chinese ep016_vess_talk_1e2cca4e:

    # "Things like cleaning out the showers and sweeping the hallways."
    "比如清理淋浴间和打扫走廊。"

# game/episode016_conversations.rpy:615
translate simplified_chinese ep016_vess_talk_82d819f1:

    # "Larger ships had bots to do that sort of janitorial work, we didn't have that luxury."
    "大型飞船有机器人来做这类保洁工作，我们可没那个条件。"

# game/episode016_conversations.rpy:617
translate simplified_chinese ep016_vess_talk_f5d2f3a9:

    # "Vess was to conclude her work in my quarters and that's where I found her."
    "薇丝要在我的舱室完成工作，我就是在那里找到她的。"

# game/episode016_conversations.rpy:618
translate simplified_chinese ep016_vess_talk_33fb8378:

    # c "Looks like you have quite some things to do."
    c "看来你有很多事要做啊。"

# game/episode016_conversations.rpy:620
translate simplified_chinese ep016_vess_talk_5e2b29b5:

    # ve "Yes, master."
    ve "是的，主人。"

# game/episode016_conversations.rpy:621
translate simplified_chinese ep016_vess_talk_37ea0667:

    # c "Come here."
    c "过来。"

# game/episode016_conversations.rpy:623
translate simplified_chinese ep016_vess_talk_990e919e:

    # "Vess stopped what she was doing and approached me."
    "薇丝停下手中的活，向我走来。"

# game/episode016_conversations.rpy:624
translate simplified_chinese ep016_vess_talk_33d73948:

    # "She smelled vaguely of sweat and her clothing was all crumpled."
    "她身上隐约散发着汗味，衣服也皱巴巴的。"

# game/episode016_conversations.rpy:625
translate simplified_chinese ep016_vess_talk_231c04e2:

    # c "You're a dirty mess."
    c "你真是脏兮兮的。"

# game/episode016_conversations.rpy:626
translate simplified_chinese ep016_vess_talk_48978158:

    # c "I don't want you here in my quarters looking like this."
    c "我不想看到你在我房间里这副模样。"

# game/episode016_conversations.rpy:627
translate simplified_chinese ep016_vess_talk_3a32ff1b:

    # c "You're going to take a shower right now and return here."
    c "你现在就去冲个澡，然后回到这里。"

# game/episode016_conversations.rpy:629
translate simplified_chinese ep016_vess_talk_5e2b29b5_1:

    # ve "Yes, master."
    ve "是，主人。"

# game/episode016_conversations.rpy:630
translate simplified_chinese ep016_vess_talk_3d9efa8c:

    # c "Oh and Vess, don't bother wearing anything when you come back."
    c "噢，薇丝，回来时不用穿任何衣服。"

# game/episode016_conversations.rpy:631
translate simplified_chinese ep016_vess_talk_e2dba52c:

    # c "You won't need clothing for what I have in mind for you next."
    c "接下来我要对你做的事，你不需要穿衣服。"

# game/episode016_conversations.rpy:632
translate simplified_chinese ep016_vess_talk_d07a3b57:

    # c "And don't dawdle."
    c "别磨蹭。"

# game/episode016_conversations.rpy:634
translate simplified_chinese ep016_vess_talk_da79a3ce:

    # "Vess nodded meekly and headed towards the showers."
    "薇丝顺从地点点头，朝着淋浴间走去。"

# game/episode016_conversations.rpy:636
translate simplified_chinese ep016_vess_talk_7a1cd164:

    # "I poured myself a drink in her absence."
    "她不在时我给自己倒了杯酒。"

# game/episode016_conversations.rpy:637
translate simplified_chinese ep016_vess_talk_de67d178:

    # "The girl was back in ten minutes."
    "女孩十分钟后就回来了。"

# game/episode016_conversations.rpy:639
translate simplified_chinese ep016_vess_talk_cea64338:

    # "Her hair was still damp and she looked decidedly cleaner."
    "她的头发还湿漉漉的，看起来明显干净多了。"

# game/episode016_conversations.rpy:640
translate simplified_chinese ep016_vess_talk_d909a8a9:

    # "She was also wearing a towel around her upper body."
    "她上身还裹着一条毛巾。"

# game/episode016_conversations.rpy:641
translate simplified_chinese ep016_vess_talk_d708e387:

    # c "Vess, are you incapable of following a simple command?"
    c "薇丝，你是连这么简单的命令都执行不了吗？"

# game/episode016_conversations.rpy:643
translate simplified_chinese ep016_vess_talk_b1318d5d:

    # ve "No, master, I...{w} I thought..."
    ve "不是的，主人，我…{w}我以为…"

# game/episode016_conversations.rpy:644
translate simplified_chinese ep016_vess_talk_a930a195:

    # c "I told you to leave your clothes behind."
    c "我告诉过你把衣服留在那里。"

# game/episode016_conversations.rpy:646
translate simplified_chinese ep016_vess_talk_c5c133b4:

    # ve "I'm sorry, master, I didn't want to risk running naked into one of the crew."
    ve "对不起，主人，我不想冒险光着身子撞见船员。"

# game/episode016_conversations.rpy:648
translate simplified_chinese ep016_vess_talk_6de78f0b:

    # ve "My body belongs solely to you."
    ve "我的身体只属于您一个人。"

# game/episode016_conversations.rpy:649
translate simplified_chinese ep016_vess_talk_79765511:

    # c "Are you trying to be clever, Vess?"
    c "你是想耍小聪明吗，薇丝？"

# game/episode016_conversations.rpy:651
translate simplified_chinese ep016_vess_talk_56f2fde7:

    # ve "No, master."
    ve "不，主人。"

# game/episode016_conversations.rpy:652
translate simplified_chinese ep016_vess_talk_37ea0667_1:

    # c "Come here."
    c "过来。"

# game/episode016_conversations.rpy:653
translate simplified_chinese ep016_vess_talk_3994d381:

    # c "Drop the towel."
    c "把毛巾放下。"

# game/episode016_conversations.rpy:660
translate simplified_chinese ep016_kit_talk_cb1ca5e6:

    # ki "Hey, do you have a minute?"
    ki "嘿，你有空吗？"

# game/episode016_conversations.rpy:661
translate simplified_chinese ep016_kit_talk_c48dc32f:

    # c "Sure."
    c "当然。"

# game/episode016_conversations.rpy:662
translate simplified_chinese ep016_kit_talk_85bc6ca2:

    # "We walked to the mess hall where Kit sat down on one of the chairs."
    "我们走到食堂，基特在其中一把椅子上坐下。"

# game/episode016_conversations.rpy:664
translate simplified_chinese ep016_kit_talk_22c9049f:

    # ki "So, I didn’t want to say anything back in that throne room, but something the Queen said to Nadya just stuck in my head for some reason."
    ki "所以，刚才在觐见厅我没想说什么，但不知为何女王对娜迪亚说的那句话一直萦绕在我脑海里。"

# game/episode016_conversations.rpy:665
translate simplified_chinese ep016_kit_talk_a6f102c7:

    # c "It did?"
    c "是吗？"

# game/episode016_conversations.rpy:666
translate simplified_chinese ep016_kit_talk_965f8ef1:

    # ki "Yes, she referred to you as “Nadya’s son”."
    ki "是的，她称你为\"娜迪亚的儿子\"。"

# game/episode016_conversations.rpy:668
translate simplified_chinese ep016_kit_talk_b4bbde5e:

    # ki "So I was wondering, what’s up with that?"
    ki "所以我想知道，这是怎么回事？"

# game/episode016_conversations.rpy:669
translate simplified_chinese ep016_kit_talk_f5f7c27d:

    # c "Right."
    c "没错。"

# game/episode016_conversations.rpy:670
translate simplified_chinese ep016_kit_talk_83ce0df3:

    # c "It’s quite simple, Nadya is my mother."
    c "很简单，娜迪亚就是我的母亲。"

# game/episode016_conversations.rpy:672
translate simplified_chinese ep016_kit_talk_de0d9e7b:

    # ki "What, no shit?!"
    ki "什么，真的假的？！"

# game/episode016_conversations.rpy:673
translate simplified_chinese ep016_kit_talk_f4089204:

    # c "No shit."
    c "千真万确。"

# game/episode016_conversations.rpy:675
translate simplified_chinese ep016_kit_talk_ebefcb98:

    # ki "When did that happen?"
    ki "这是什么时候的事？"

# game/episode016_conversations.rpy:676
translate simplified_chinese ep016_kit_talk_06557524:

    # c "Roughly around the time I was born, I reckon."
    c "大概就在我出生那会儿吧，我估计。"

# game/episode016_conversations.rpy:678
translate simplified_chinese ep016_kit_talk_125ca565:

    # ki "Very funny."
    ki "真会开玩笑。"

# game/episode016_conversations.rpy:679
translate simplified_chinese ep016_kit_talk_d87b7646:

    # ki "I mean, when did she tell you?"
    ki "我是说，她什么时候告诉你的？"

# game/episode016_conversations.rpy:680
translate simplified_chinese ep016_kit_talk_9c6330cc:

    # c "Just before we went up to the Theater of Senses."
    c "就在我们去\"迷魂会所\"之前。"

# game/episode016_conversations.rpy:682
translate simplified_chinese ep016_kit_talk_6707d893:

    # ki "So Yve..."
    ki "所以伊芙…"

# game/episode016_conversations.rpy:683
translate simplified_chinese ep016_kit_talk_68151dcd:

    # c "She isn’t my real mother."
    c "她不是我亲生母亲。"

# game/episode016_conversations.rpy:684
translate simplified_chinese ep016_kit_talk_deb48ab3:

    # ki "And Lilly and Eva, half-sisters?"
    ki "那莉莉和伊娃呢，是异父姐妹吗？"

# game/episode016_conversations.rpy:685
translate simplified_chinese ep016_kit_talk_6bc30d7c:

    # c "No, we all share the same mother."
    c "不，我们都是同一个母亲所生。"

# game/episode016_conversations.rpy:687
translate simplified_chinese ep016_kit_talk_7d857939:

    # ki "Damn..."
    ki "该死…"

# game/episode016_conversations.rpy:689
translate simplified_chinese ep016_kit_talk_607554d2:

    # ki "So Aven is your sister as well?"
    ki "所以艾文也是你妹妹？"

# game/episode016_conversations.rpy:690
translate simplified_chinese ep016_kit_talk_5eae321d:

    # c "Yup."
    c "没错。"

# game/episode016_conversations.rpy:691
translate simplified_chinese ep016_kit_talk_81d2a4e1:

    # ki "How did that all happen?"
    ki "这到底是怎么发生的？"

# game/episode016_conversations.rpy:692
translate simplified_chinese ep016_kit_talk_3c55ab93:

    # c "It’s a long story and quite painful for her."
    c "说来话长，而且对她来说相当痛苦。"

# game/episode016_conversations.rpy:693
translate simplified_chinese ep016_kit_talk_158ae252:

    # c "That’s one of the reasons she kept quiet for so long."
    c "这也是她保持沉默这么久的原因之一。"

# game/episode016_conversations.rpy:694
translate simplified_chinese ep016_kit_talk_5b12aae8:

    # c "She and Agust were madly in love when they were younger."
    c "她和阿古斯特年轻时曾疯狂相爱。"

# game/episode016_conversations.rpy:695
translate simplified_chinese ep016_kit_talk_d1fb1885:

    # c "So much so that they wanted children together, even behind Yve’s back, or so Nadya thought."
    c "以至于他们想要共同养育孩子，甚至背着伊芙，至少娜迪亚是这么认为的。"

# game/episode016_conversations.rpy:696
translate simplified_chinese ep016_kit_talk_22eb7000:

    # c "After she had my sisters and me, Agust all but kicked her out of the house eventually, so that he and his trophy-wife could raise us as their own instead."
    c "在她生下我和姐妹们后，阿古斯特几乎把她赶出了家门，这样他和他那花瓶妻子就能把我们当作自己的孩子抚养。"

# game/episode016_conversations.rpy:697
translate simplified_chinese ep016_kit_talk_197191a0:

    # ki "But Aven?"
    ki "但是艾文呢？"

# game/episode016_conversations.rpy:698
translate simplified_chinese ep016_kit_talk_7b4255e3:

    # c "He allowed her to keep one of us, as a consolation prize."
    c "他允许她留下我们中的一个，作为安慰奖。"

# game/episode016_conversations.rpy:700
translate simplified_chinese ep016_kit_talk_1bbbeb2d:

    # ki "A male heir and female twins."
    ki "一个男性继承人和一对女性双胞胎。"

# game/episode016_conversations.rpy:701
translate simplified_chinese ep016_kit_talk_3c7197c1:

    # c "Yes, presumably he wanted to keep me to continue the dynasty."
    c "是的，大概他是想留下我来延续家族血脉。"

# game/episode016_conversations.rpy:702
translate simplified_chinese ep016_kit_talk_152ef5e0:

    # c "Either Lilly or Eva tie into his obsession with the prophecy."
    c "莉莉或伊娃都与他沉迷的那个预言有关。"

# game/episode016_conversations.rpy:703
translate simplified_chinese ep016_kit_talk_6aeb09d2:

    # ki "He’s been involved in that Prophecy stuff for that long?"
    ki "他参与那个预言相关的事已经有那么久了？"

# game/episode016_conversations.rpy:704
translate simplified_chinese ep016_kit_talk_df9ba1dc:

    # c "Maybe not right from the start, but from our early childhood seems likely yes."
    c "可能不是从一开始，但从我们童年早期就开始了，应该是的。"

# game/episode016_conversations.rpy:706
translate simplified_chinese ep016_kit_talk_fc4ff694:

    # ki "Damn, I thought my mother was a cold-hearted bitch, but Agust and Yve really take the cake, don’t they?"
    ki "该死，我以为我母亲是个冷血婊子，但阿古斯特和伊芙才是真的登峰造极，对吧？"

# game/episode016_conversations.rpy:707
translate simplified_chinese ep016_kit_talk_d2922a21:

    # c "They’re in a league of their own, that’s for sure."
    c "他们确实独树一帜，这点毋庸置疑。"

# game/episode016_conversations.rpy:709
translate simplified_chinese ep016_kit_talk_9f7a46f5:

    # "Kit was silent for a while, clearly mulling over something."
    "基特沉默了片刻，显然在思索着什么。"

# game/episode016_conversations.rpy:710
translate simplified_chinese ep016_kit_talk_22fa64b6:

    # c "You’ve employed that lobotomized stare again, as Aven so eloquently put it earlier."
