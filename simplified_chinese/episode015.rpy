    # c "Of course, you should rest."
    c "当然，你该休息了。"

# game/episode015.rpy:1809
translate simplified_chinese ep015_sim_post_9f608900:

    # c "Sleep tight, Eva."
    c "睡个好觉，伊娃。"

# game/episode015.rpy:1811
translate simplified_chinese ep015_sim_post_26aed4c6:

    # e "Thank you, [p_name_short], I will."
    e "谢谢你，[p_name_short]，我会的。"

# game/episode015.rpy:1813
