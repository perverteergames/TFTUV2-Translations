    # "She was already asleep when I closed the door."
    "我关上门时她已经睡着了。"

# game/episode015.rpy:1816
translate simplified_chinese ep015_sim_post_5beaee5b:

    # c "I had these nightmares...{w} I was certain I’d lost you forever and I just couldn’t bear it."
    c "我做了这些噩梦…{w} 我确信自己永远失去了你，这让我无法承受。"

# game/episode015.rpy:1817
translate simplified_chinese ep015_sim_post_4ca2f64e:

    # c "Considering what happened to you in the simulation, I think you understand the feelings I have for you."
    c "考虑到你在模拟器中经历的事，我想你明白我对你的感情。"

# game/episode015.rpy:1819
translate simplified_chinese ep015_sim_post_24253787:

    # e "I...{w} Uh...{w} I don’t understand?"
    e "我…{w} 呃…{w} 我不明白？"

# game/episode015.rpy:1820
translate simplified_chinese ep015_sim_post_3893765b:

    # c "We kissed, back in the fantasy simulation."
    c "我们在幻想模拟中接吻了。"

# game/episode015.rpy:1821
translate simplified_chinese ep015_sim_post_11a2d058:

    # c "I could tell you were just as shocked as I was."
    c "我看得出来你和我一样震惊。"

# game/episode015.rpy:1822
translate simplified_chinese ep015_sim_post_bc5fb231:

    # c "But if I’m not mistaken, I also saw something else."
    c "但如果我没弄错的话，我还看到了别的。"

# game/episode015.rpy:1823
translate simplified_chinese ep015_sim_post_e93aa975:

    # c "A longing."
    c "一种渴望。"

# game/episode015.rpy:1824
translate simplified_chinese ep015_sim_post_57987cb3:

    # c "A longing for something I feel very clearly as well."
    c "一种我也能清晰感受到的渴望。"

# game/episode015.rpy:1825
translate simplified_chinese ep015_sim_post_c92aaef4:

    # e "[p_name_short]...{w} Please...{w} Don’t say it..."
    e "[p_name_short]…{w} 求你了…{w} 别说出来…"

# game/episode015.rpy:1828
