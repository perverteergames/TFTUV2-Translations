# game/episode015.rpy:259
translate simplified_chinese ep015_tand_abf31928:

    # c "To her personally, she presented herself as a liaison of the Council."
    c "是亲自交给她，她自称是议会的联络人。"

# game/episode015.rpy:261
translate simplified_chinese ep015_tand_d6db5954:

    # rh "I thought as much."
    rh "我猜也是这样。"

# game/episode015.rpy:262
translate simplified_chinese ep015_tand_dcb63949_1:

    # rh "She told you we were dangerous, didn’t she?"
    rh "她告诉你们我们很危险，对吧？"

# game/episode015.rpy:263
translate simplified_chinese ep015_tand_5caeef24:

    # c "Yes, she accused you of bombing a team of negotiators."
    c "是的，她指控你们炸毁了一支谈判代表团。"

# game/episode015.rpy:265
translate simplified_chinese ep015_tand_32bbaf1a:

    # rh "That team wasn’t there to negotiate with us."
    rh "那支队伍根本不是来和我们谈判的。"

# game/episode015.rpy:276
translate simplified_chinese ep015_tand_f7a1c7db:

    # "There were no disturbances during the night."
    "整晚都没有发生任何骚乱。"

# game/episode015.rpy:279
translate simplified_chinese ep015_tand_3261ef3b:

    # "The residents of the camp kept their distance, but some of them came to say goodbye to their leader."
    "营地的居民们保持着距离，但有些人来向他们的领袖道别。"

# game/episode015.rpy:283
translate simplified_chinese ep015_tand_ec174cd8:

    # "The residents of the camp still kept their distance, even when we marched their leader out into the forest."
    "即便我们将他们的领袖押入森林，营地的居民们仍然保持着距离。"

# game/episode015.rpy:285
translate simplified_chinese ep015_tand_3a9765fc:

    # "The hike through the forest was uneventful, and we reached the Bastard in good time."
    "穿越森林的徒步过程很平静，我们及时抵达了\"私生子\"号。"

# game/episode015.rpy:293
translate simplified_chinese ep015_rhedia_explanation_0d74b275:

    # rh "Yes, the Council sent a group of operatives with the intent of eliminating me and my followers."
    rh "是的，议会派了一组特工，意图消灭我和我的追随者。"

# game/episode015.rpy:298
translate simplified_chinese ep015_rhedia_explanation_a0827727:

    # zi "The Council?{w} I find that a little hard to believe."
    zi "议会？{w} 这让我有点难以相信。"

# game/episode015.rpy:303
translate simplified_chinese ep015_rhedia_explanation_0aff54da:

    # rh "Yes, I should be more precise."
    rh "是的，我该说得更准确些。"

# game/episode015.rpy:304
translate simplified_chinese ep015_rhedia_explanation_d00de57b:

    # rh "Nkoy Arlya was responsible for sending them, under the guise of a white flag, the Council wasn’t aware."
    rh "伦科伊·阿尔雅负责派遣他们，打着白旗的幌子，议会并不知情。"

# game/episode015.rpy:305
translate simplified_chinese ep015_rhedia_explanation_a7638e91:

    # c "And why would she do that?"
    c "她为什么要这么做？"

# game/episode015.rpy:310
translate simplified_chinese ep015_rhedia_explanation_13605484:

    # rh "Because Arlya is intent on seizing power for herself, she is thoroughly corrupt."
    rh "因为阿尔雅一心想要为自己夺权，她已经彻底腐化了。"

# game/episode015.rpy:311
translate simplified_chinese ep015_rhedia_explanation_2776ad2e:

    # rh "About a year ago, someone came to me with incriminating information on a member of the Council."
    rh "大约一年前，有人带着关于某位议员的犯罪证据来找我。"

# game/episode015.rpy:312
translate simplified_chinese ep015_rhedia_explanation_8ec20bf5:

    # rh "The evidence was overwhelming. Revealing wrongdoing on the part of a member of the Council would shock this world to the core."
    rh "证据确凿。揭露议员的不当行为将会让这个世界震惊到骨子里。"

# game/episode015.rpy:317
translate simplified_chinese ep015_rhedia_explanation_6121dd00:

    # rh "So I promised to investigate the matter in secret at first."
    rh "所以我承诺会先秘密调查这件事。"

# game/episode015.rpy:318
translate simplified_chinese ep015_rhedia_explanation_f184909f:

    # rh "What I found confirmed the information in full."
    rh "我的调查结果完全证实了这些信息。"

# game/episode015.rpy:323
translate simplified_chinese ep015_rhedia_explanation_9cd69084:

    # rh "Nkoy Arlya has been receiving considerable funds from unknown off-world parties for years."
    rh "伦科伊·阿尔雅多年来一直从不明身份的异星势力那里获取巨额资金。"

# game/episode015.rpy:324
translate simplified_chinese ep015_rhedia_explanation_3d1edf44:

    # rh "She’s become very rich, but has also used her newfound wealth to destabilize our government from within."
    rh "她变得非常富有，同时还利用新获得的财富从内部动摇我们的政府。"

# game/episode015.rpy:325
translate simplified_chinese ep015_rhedia_explanation_47911c39:

    # rh "Her goal is to remove the ruling of the Council of Nkoy completely and establish a single leader, probably herself."
    rh "她的目标是彻底废除伦科伊议会的统治，建立单一领导制，很可能由她自己掌权。"

# game/episode015.rpy:326
translate simplified_chinese ep015_rhedia_explanation_fc36b362:

    # c "And she’s doing all that right under the nose of the other Council members?"
    c "而她就在其他议员的眼皮底下做这一切？"

# game/episode015.rpy:331
translate simplified_chinese ep015_rhedia_explanation_291ac666:

    # rh "Yes, she is."
    rh "是的，正是如此。"

# game/episode015.rpy:332
translate simplified_chinese ep015_rhedia_explanation_3e0aea2b:

    # rh "Arlya has long been a benefactor for all sorts of social enterprises."
    rh "阿尔雅长期以来一直是各种社会事业的资助者。"

# game/episode015.rpy:337
translate simplified_chinese ep015_rhedia_explanation_65882be5:

    # zi "That’s true, she is well-loved among the Cohorts."
    zi "确实如此，她在\"群体\"中深受爱戴。"

# game/episode015.rpy:342
translate simplified_chinese ep015_rhedia_explanation_863ecd5f:

    # rh "She has the support of many Premiers, who will undoubtedly support her rule once she is ready to declare it to the public."
    rh "她得到了许多\"执政官\"的支持，一旦她准备向公众宣布统治，这些人无疑会支持她。"

# game/episode015.rpy:343
translate simplified_chinese ep015_rhedia_explanation_9c996621:

    # c "So she's what the Sovereignty would call a smart and well-connected politician?"
    c "所以她是\"至高权域\"所说的那种精明且人脉广泛的政治家？"

# game/episode015.rpy:348
translate simplified_chinese ep015_rhedia_explanation_cb5b5795:

    # zi "Maybe, but abolishing the Council and rule as a single leader is a thing unheard of in all of Rhenkoy history."
    zi "也许吧，但废除议会并由单一领袖统治在整个伦科伊历史上闻所未闻。"

# game/episode015.rpy:349
translate simplified_chinese ep015_rhedia_explanation_ca48fa7c:

    # c "Aren't the Premiers the sole leaders of their Cohorts?"
    c "难道各\"群体\"的执政官不就是他们唯一的领导者吗？"

# game/episode015.rpy:354
translate simplified_chinese ep015_rhedia_explanation_d9ccd538:

    # zi "Yes, they are, but the members of the Council of Nkoy are representatives chosen by all Rhenkoy."
    zi "没错，但伦科伊议会的成员是由全体伦科伊人选举产生的代表。"

# game/episode015.rpy:355
translate simplified_chinese ep015_rhedia_explanation_06bb2b9d:

    # zi "Arlya doing away with all that and attempting to establish her own rule is a break with tradition like no other."
    zi "阿莉亚废除这一切并试图建立自己的统治，这是前所未有的传统断裂。"

# game/episode015.rpy:360
translate simplified_chinese ep015_rhedia_explanation_f4e10344:

    # rh "Exactly."
    rh "正是如此。"

# game/episode015.rpy:361
translate simplified_chinese ep015_rhedia_explanation_b11e09e9:

    # rh "When I was ready to present my findings to the Council, Arlya was ready to discredit me."
    rh "当我准备向议会提交调查结果时，阿莉亚已经准备好要诋毁我。"

# game/episode015.rpy:362
translate simplified_chinese ep015_rhedia_explanation_8b9f5abe:

    # rh "She did so with gusto through an elaborate smear campaign, and I found myself slowly isolated from my peers."
    rh "她通过精心策划的诽谤活动热情洋溢地这么做了，我发现自己逐渐被同僚们孤立。"

# game/episode015.rpy:363
translate simplified_chinese ep015_rhedia_explanation_2f682cf4:

    # c "The rest of the Council just lapped up all those bad stories about you without question?"
    c "议会其他成员就这样毫无疑问地全盘接受了那些关于你的负面传闻？"

# game/episode015.rpy:368
translate simplified_chinese ep015_rhedia_explanation_f59fc79d:

    # rh "They did question, but Arlya's propaganda proved too insidious."
    rh "他们确实质疑过，但阿莉亚的宣传手段太过阴险。"

# game/episode015.rpy:373
translate simplified_chinese ep015_rhedia_explanation_b494d1d1:

    # zi "Rhenkoy politics, like almost everything else in our society, is bound by strict rules."
    zi "伦科伊政治，就像我们社会中的几乎所有事物一样，都受到严格规则的约束。"

# game/episode015.rpy:374
translate simplified_chinese ep015_rhedia_explanation_383708d8:

    # zi "Not adhering to those rules is almost unheard of."
    zi "不遵守这些规则几乎是闻所未闻的。"

# game/episode015.rpy:380
translate simplified_chinese ep015_rhedia_explanation_e42aad80:

    # "Ziv looked at me intently and it made me appreciate our relationship even more."
    "基芙专注地看着我，这让我更加珍惜我们之间的关系。"

# game/episode015.rpy:381
translate simplified_chinese ep015_rhedia_explanation_184eb349:

    # "The way Ziv had brazenly thrown herself into defying the Rhenkoy's relationship tenets must have been truly something special."
    "基芙如此公然蔑视伦科伊人际关系准则的方式，想必确实非同寻常。"

# game/episode015.rpy:386
translate simplified_chinese ep015_rhedia_explanation_3ffe0bae:

    # rh "Arlya is actively exploiting the honor and trust underpinning our society."
    rh "阿尔雅正在积极利用支撑我们社会的荣誉与信任体系。"

# game/episode015.rpy:387
translate simplified_chinese ep015_rhedia_explanation_15b5b451:

    # rh "When my accusations fell on deaf ears, I retreated from the Council."
    rh "当我的指控无人理睬时，我便退出了议会。"

# game/episode015.rpy:392
translate simplified_chinese ep015_rhedia_explanation_77e4c073:

    # rh "Together with my followers, I was about to mount a series of public rallies where we would let the world know what Arlya was up to."
    rh "我和我的追随者们正准备举行一系列公开集会，让全世界都知道阿尔雅的所作所为。"

# game/episode015.rpy:393
translate simplified_chinese ep015_rhedia_explanation_c25babe3:

    # rh "Just before the first rally, the Council announced they were sending a team of negotiators to supposedly talk sense to me and quell any riots."
    rh "就在第一次集会前夕，议会宣布他们将派遣一支谈判小组，声称要与我讲道理并平息任何骚乱。"

# game/episode015.rpy:394
translate simplified_chinese ep015_rhedia_explanation_0cfc910c:

    # rh "We were warned by several people involved in the day-to-day operations of the Council that the team they'd sent were armed and ready for violence."
    rh "几位参与议会日常运作的人士警告我们，他们派来的小组全副武装，随时准备使用暴力。"

# game/episode015.rpy:395
translate simplified_chinese ep015_rhedia_explanation_008fbd37:

    # rh "We didn't believe it at first, but prepared to defend ourselves nonetheless."
    rh "起初我们并不相信，但还是做好了自卫的准备。"

# game/episode015.rpy:400
translate simplified_chinese ep015_rhedia_explanation_6d720ee9:

    # rh "And that's what we did when the team arrived, intent on murdering us."
    rh "当那个小组抵达并意图杀害我们时，我们正是这样做的。"

# game/episode015.rpy:401
translate simplified_chinese ep015_rhedia_explanation_74a7a217:

    # rh "My followers managed to take them by surprise and create enough of a distraction to allow us to leave and retreat here into the forest of Tand."
    rh "我的追随者们成功打了他们个措手不及，制造了足够的混乱让我们得以撤离，退入这片坦德森林。"

# game/episode015.rpy:406
translate simplified_chinese ep015_rhedia_explanation_bd8478a3:

    # c "It seems we got played."
    c "看来我们被耍了。"

# game/episode015.rpy:407
translate simplified_chinese ep015_rhedia_explanation_5a9687b6:

    # c "I don't very much care being used to do dirty work."
    c "我并不太在乎被利用去做脏活。"

# game/episode015.rpy:408
translate simplified_chinese ep015_rhedia_explanation_a329f0ea:

    # c "What do you think Arlya plans to do once we bring you in?"
    c "你觉得等我们把你带回去后，阿尔雅打算做什么？"

# game/episode015.rpy:413
translate simplified_chinese ep015_rhedia_explanation_a15072b6:

    # rh "There's a reason why she went behind the backs of her fellow Council members, so I doubt it will be anything positive."
    rh "她背着自己的议会同僚行事必然有其原因，所以我怀疑不会是什么好事。"

# game/episode015.rpy:414
translate simplified_chinese ep015_rhedia_explanation_87886854:

    # c "Say I want to become involved in the wonderful world of Rhenkoy politics, what would you have me do?"
    c "假设我想涉足伦科伊政坛这个精彩世界，你会让我怎么做？"

# game/episode015.rpy:415
translate simplified_chinese ep015_rhedia_explanation_c1ff83ba:

    # rh "Bring me to the capital like you were ordered, but allow me to speak to the Council instead of handing me into the custody of Nkoy Arlya."
    rh "按命令带我去首都，但允许我向议会陈情，而不是把我交给伦科伊·阿尔雅监管。"

# game/episode015.rpy:416
translate simplified_chinese ep015_rhedia_explanation_e1490063:

    # rh "I will make a speech to denounce Arlya and present the evidence I had gathered."
    rh "我将发表演说揭露阿尔雅，并出示我收集到的证据。"

# game/episode015.rpy:417
translate simplified_chinese ep015_rhedia_explanation_9e6fd299:

    # rh "The revelation that she has recruited clandestine off-world help will only strengthen my narrative."
    rh "她秘密招募外星援助的真相只会让我的陈述更具说服力。"

# game/episode015.rpy:420
translate simplified_chinese ep015_rhedia_explanation_80d648a6:

    # c "That all sounds dreadful enough, but I can't afford to become involved."
    c "这一切听起来确实够糟糕，但我不能卷入其中。"

# game/episode015.rpy:425
translate simplified_chinese ep015_rhedia_explanation_e0df65b3:

    # rh "The integrity of Rhenkoy leadership is at grave risk, I beg you to reconsider your involvement."
    rh "伦科伊领导层的廉正岌岌可危，我恳求你重新考虑是否参与此事。"

# game/episode015.rpy:426
translate simplified_chinese ep015_rhedia_explanation_8d918456:

    # c "Sorry, but I can't risk losing Arlya's promised reward."
    c "抱歉，但我不能冒险失去阿莉亚承诺的报酬。"

# game/episode015.rpy:431
translate simplified_chinese ep015_rhedia_explanation_8116ead9:

    # rh "And what reward is that, money?"
    rh "那报酬是什么，钱吗？"

# game/episode015.rpy:432
translate simplified_chinese ep015_rhedia_explanation_7cde8f47:

    # c "Nothing so banal."
    c "没那么俗气。"

# game/episode015.rpy:433
translate simplified_chinese ep015_rhedia_explanation_de4b820d:

    # c "Arlya has promised us access to some Scolguin prisoners."
    c "阿莉亚承诺让我们接触一些斯科尔金囚犯。"

# game/episode015.rpy:434
translate simplified_chinese ep015_rhedia_explanation_b002c2cc:

    # rh "What if I promise you the same thing?"
    rh "如果我承诺给你同样的条件呢？"

# game/episode015.rpy:435
translate simplified_chinese ep015_rhedia_explanation_a0759d58:

    # c "You'd allow us to interrogate the Scolguin soldiers in return for helping to overthrow Arlya?"
    c "你会允许我们审问斯科尔金士兵，作为帮助我们推翻阿莉亚的回报？"

# game/episode015.rpy:436
translate simplified_chinese ep015_rhedia_explanation_974fcaf7:

    # rh "Yes, I would."
    rh "是的，我会。"

# game/episode015.rpy:440
translate simplified_chinese ep015_rhedia_explanation_4dc10237:

    # c "It's a gamble, but one I'm willing to take."
    c "这是一场赌博，但我愿意赌一把。"

# game/episode015.rpy:445
translate simplified_chinese ep015_rhedia_explanation_dc62ca42:

    # rh "Excellent!"
    rh "太好了！"

# game/episode015.rpy:446
translate simplified_chinese ep015_rhedia_explanation_4bcb2997:

    # c "What would you have us do?"
    c "您希望我们做什么？"

# game/episode015.rpy:451
translate simplified_chinese ep015_rhedia_explanation_c1ff83ba_1:

    # rh "Bring me to the capital like you were ordered, but allow me to speak to the Council instead of handing me into the custody of Nkoy Arlya."
    rh "按命令带我去首都，但允许我向议会发言，而不是将我交给伦科伊·阿尔雅监管。"

# game/episode015.rpy:452
translate simplified_chinese ep015_rhedia_explanation_e1490063_1:

    # rh "I will make a speech to denounce Arlya and present the evidence I had gathered."
    rh "我将发表演说揭发阿尔雅，并展示我收集到的证据。"

# game/episode015.rpy:453
translate simplified_chinese ep015_rhedia_explanation_9e6fd299_1:

    # rh "The revelation that she has recruited clandestine off-world help will only strengthen my narrative."
    rh "她暗中招募外星援助的真相只会让我的陈述更具说服力。"

# game/episode015.rpy:457
translate simplified_chinese ep015_rhedia_explanation_652165aa:

    # c "I'm afraid I still can't take that risk."
    c "恐怕我还是不能冒这个险。"

# game/episode015.rpy:458
translate simplified_chinese ep015_rhedia_explanation_94484f87:

    # c "Arlya currently has the power to grant us access, whereas you are still viewed as a rebel and a threat."
    c "阿尔雅目前有权批准我们接触，而您仍被视为叛乱分子和威胁。"

# game/episode015.rpy:463
translate simplified_chinese ep015_rhedia_explanation_edc0d8bf:

    # rh "How disappointing, but I shouldn't have expected any less from mercenaries like you."
    rh "真令人失望，但我不该对你们这样的雇佣兵抱更多期待。"

# game/episode015.rpy:464
translate simplified_chinese ep015_rhedia_explanation_62fd832a:

    # rh "I hope you can live with the choices of your commander..."
    rh "希望你们能承受指挥官所作选择的后果…"

# game/episode015.rpy:465
translate simplified_chinese ep015_rhedia_explanation_bb8ec118:

    # zi "I..."
    zi "我…"

# game/episode015.rpy:470
translate simplified_chinese ep015_rhedia_help_8438473d:

    # c "We’re placing a lot of faith in you, Nkoy Rhedia, I sure hope this gamble will pay off."
    c "我们正在您身上押注很多信任，伦科伊·瑞迪亚，我真心希望这场赌博能有回报。"

# game/episode015.rpy:475
translate simplified_chinese ep015_rhedia_help_6af8b983:

    # rh "I will do my very best to help you and I have confidence in the Council to see reason."
    rh "我会竭尽全力帮助你，并且我相信议会会明辨是非。"

# game/episode015.rpy:476
translate simplified_chinese ep015_rhedia_help_8e5c1374:

    # c "Night will be falling soon."
    c "夜幕很快就要降临了。"

# game/episode015.rpy:477
translate simplified_chinese ep015_rhedia_help_a433c4a2:

    # c "We’ll head out in the morning."
    c "我们明早出发。"

# game/episode015.rpy:478
translate simplified_chinese ep015_rhedia_help_d11fbe7f:

    # c "Despite your promises we’ll have to keep you under guard, I hope you understand."
    c "尽管你做了承诺，我们仍不得不派人看守你，希望你能理解。"

# game/episode015.rpy:479
translate simplified_chinese ep015_rhedia_help_fe96cc7f:

    # rh "I do."
    rh "我理解。"

# game/episode015.rpy:482
translate simplified_chinese ep015_rhedia_help_5692f008:

    # rh "Will you allow my followers to retrieve our fallen comrades from the forest?"
    rh "你能否允许我的追随者去森林里收回我们阵亡的战友？"

# game/episode015.rpy:483
translate simplified_chinese ep015_rhedia_help_4e8c7062:

    # c "Of course."
    c "当然可以。"

# game/episode015.rpy:488
translate simplified_chinese ep015_rhedia_help_21dfb2dd:

    # rh "I will ask my people to assign your lodgings for the night."
    rh "我会让我的人安排你们今晚的住处。"

# game/episode015.rpy:493
translate simplified_chinese ep015_rhedia_help_3c503cf7:

    # zi "That’s very kind of you, Nkoy Rhedia."
    zi "你真是太仁慈了，伦科伊·瑞迪亚。"

# game/episode015.rpy:495
translate simplified_chinese ep015_rhedia_help_048323e5:

    # "The followers of Rhedia were a little apprehensive of us at first and stayed out of our way mostly."
    "瑞迪亚的追随者起初对我们有些戒备，大多都刻意避开我们。"

# game/episode015.rpy:497
translate simplified_chinese ep015_rhedia_help_5e1784c5:

    # "We agreed on taking turns on guard duty and retired for the night."
    "我们商定轮流站岗，随后便各自休息过夜。"

# game/episode015.rpy:503
translate simplified_chinese ep015_rhedia_decline_f5d844e8:

    # c "Kit, take her inside."
    c "基特，带她进去。"

# game/episode015.rpy:504
translate simplified_chinese ep015_rhedia_decline_94f8537d:

    # "Resigned, Nkoy Rhedia followed Kit inside her yurt."
    "伦科伊·瑞迪亚顺从地跟着基特走进了她的蒙古包。"

# game/episode015.rpy:506
translate simplified_chinese ep015_rhedia_decline_a31ba740:

    # c "Kit?"
    c "基特？"

# game/episode015.rpy:508
translate simplified_chinese ep015_rhedia_decline_e20a2642:

    # ki "Yeah?"
    ki "嗯？"

# game/episode015.rpy:509
translate simplified_chinese ep015_rhedia_decline_d65a1ebe:

    # c "Take her away."
    c "带她离开。"

# game/episode015.rpy:510
translate simplified_chinese ep015_rhedia_decline_1449ccfe:

    # ki "Of course."
    ki "当然。"

# game/episode015.rpy:512
translate simplified_chinese ep015_rhedia_decline_94f8537d_1:

    # "Resigned, Nkoy Rhedia followed Kit inside her yurt."
    "伦科伊·瑞迪亚顺从地跟着基特走进了她的蒙古包。"

# game/episode015.rpy:513
translate simplified_chinese ep015_rhedia_decline_8e5c1374:

    # c "Night will be falling soon."
    c "夜幕很快就要降临了。"

# game/episode015.rpy:514
translate simplified_chinese ep015_rhedia_decline_2fd1be8d:

    # c "I suggest we confiscate a few of these tents and spend the night."
    c "我建议我们没收几顶帐篷在此过夜。"

# game/episode015.rpy:516
translate simplified_chinese ep015_rhedia_decline_776d8573:

    # av "Is that safe?"
    av "这样安全吗？"

# game/episode015.rpy:517
translate simplified_chinese ep015_rhedia_decline_4244aee9:

    # c "Yes, we’ll take turns on guard duty."
    c "是的，我们会轮流站岗。"

# game/episode015.rpy:518
translate simplified_chinese ep015_rhedia_decline_756f7683:

    # c "Considering the resistance we’ve encountered so far, I don’t think we’ll be in any considerable danger."
    c "考虑到我们目前遇到的抵抗，我认为我们不会面临什么重大危险。"

# game/episode015.rpy:519
translate simplified_chinese ep015_rhedia_decline_c8e41591:

    # c "Come morning, we’ll head back out to the Bastard."
    c "等天亮后，我们就返回\"私生子\"号。"

# game/episode015.rpy:521
translate simplified_chinese ep015_rhedia_decline_ef119574:

    # "The remaining people in the encampment stayed out of our way and we retired for the night in peace."
    "营地里的其他人没有来打扰我们，我们平静地度过了这个夜晚。"

# game/episode015.rpy:530
translate simplified_chinese ep015_camp_ziv_61dcfb08:

    # zi "I just wanted to see you before I go to bed."
    zi "我只是想在睡觉前看看你。"

# game/episode015.rpy:532
translate simplified_chinese ep015_camp_ziv_a6341296:

    # zi "I wanted to speak to you for a moment."
    zi "我想和你说几句话。"

# game/episode015.rpy:533
translate simplified_chinese ep015_camp_ziv_4e8c7062:

    # c "Of course."
    c "当然。"

# game/episode015.rpy:535
translate simplified_chinese ep015_camp_ziv_e42a12a1:

    # zi "I don't like what we did today, [p_name]."
    zi "我不喜欢我们今天做的事，[p_name]。"

# game/episode015.rpy:536
translate simplified_chinese ep015_camp_ziv_1ece7c5f:

    # c "Yes, you've made that clear enough."
    c "是的，你已经表达得很清楚了。"

# game/episode015.rpy:538
translate simplified_chinese ep015_camp_ziv_388b97a0:

    # zi "What was I to do?!"
    zi "那我该怎么做？！"

# game/episode015.rpy:539
translate simplified_chinese ep015_camp_ziv_1cc2798b:

    # zi "Kill that defenseless woman?!"
    zi "杀了那个毫无防备的女人吗？！"

# game/episode015.rpy:540
translate simplified_chinese ep015_camp_ziv_26eefe0a:

    # c "Yes."
    c "是的。"

# game/episode015.rpy:541
translate simplified_chinese ep015_camp_ziv_06ee06e4:

    # zi "How can you say that?"
    zi "你怎么能这么说？"

# game/episode015.rpy:542
translate simplified_chinese ep015_camp_ziv_d09e60e2:

    # c "Because you've endangered all of us by not following orders."
    c "因为你不服从命令，让我们所有人都陷入了危险。"

# game/episode015.rpy:543
translate simplified_chinese ep015_camp_ziv_d7e8b135:

    # c "Our strategy was clear from the start."
    c "我们的策略从一开始就很明确。"

# game/episode015.rpy:544
translate simplified_chinese ep015_camp_ziv_b21b42dc:

    # c "If you had problems, I'd very much like to have learned about them before we went in."
    c "如果你有问题，我很希望在我们行动之前就能了解到。"

# game/episode015.rpy:546
translate simplified_chinese ep015_camp_ziv_dce41ef2:

    # zi "But that's besides the point, I-"
    zi "但这并不是重点，我—"

# game/episode015.rpy:547
translate simplified_chinese ep015_camp_ziv_4ea199ba:

    # c "No, it's very much the point."
    c "不，这恰恰就是重点。"

# game/episode015.rpy:548
translate simplified_chinese ep015_camp_ziv_cb256629:

    # c "Because of your refusal to follow orders, the woman was able to warn the others in the camp."
    c "因为你的抗命，那个女人得以警告了营地里的其他人。"

# game/episode015.rpy:549
translate simplified_chinese ep015_camp_ziv_d5c76f80:

    # c "Some of us could have been killed while we stormed the camp."
    c "我们中有些人可能在突袭营地时被杀。"

# game/episode015.rpy:551
translate simplified_chinese ep015_camp_ziv_0c6c703b:

    # zi "Nkoy Rhedia's followers barely know how to hold a weapon."
    zi "伦科伊·瑞迪亚的追随者连握武器都不怎么会。"

# game/episode015.rpy:552
translate simplified_chinese ep015_camp_ziv_aabf46fd:

    # c "But we didn't know that then, and it only takes one lucky shot."
    c "但我们当时并不知道，而只需要一次幸运的射击。"

# game/episode015.rpy:554
translate simplified_chinese ep015_camp_ziv_5df80400:

    # zi "We shouldn't have killed all those sentries in the first place!"
    zi "我们一开始就不该杀掉所有哨兵！"

# game/episode015.rpy:555
translate simplified_chinese ep015_camp_ziv_3a54d161:

    # c "Again, we acted on the information that was available to us at the time."
    c "再说一遍，我们是根据当时掌握的信息行动的。"

# game/episode015.rpy:556
translate simplified_chinese ep015_camp_ziv_f3fffbd5:

    # c "Rhedia and her followers were accused of bombing a negotiating team."
    c "瑞迪亚和她的追随者被指控炸毁了一个谈判小组。"

# game/episode015.rpy:557
translate simplified_chinese ep015_camp_ziv_711496c7:

    # c "Did you know what to expect?"
    c "你当时知道会发生什么吗？"

# game/episode015.rpy:559
translate simplified_chinese ep015_camp_ziv_85324695:

    # zi "No, I didn't."
    zi "不，我不知道。"

# game/episode015.rpy:560
translate simplified_chinese ep015_camp_ziv_040de793:

    # zi "Still...{w} I think we should have been more cautious."
    zi "但是…{w} 我认为我们应该更谨慎些。"

# game/episode015.rpy:561
translate simplified_chinese ep015_camp_ziv_194b06c0:

    # c "Our safety is what matters most to me."
    c "我们的安全对我来说才是最重要的。"

# game/episode015.rpy:562
translate simplified_chinese ep015_camp_ziv_8e4b05ab:

    # c "I will not compromise on that and I will gladly live with the consequences of my decisions."
    c "我不会在这方面妥协，并且甘愿承受我决定的后果。"

# game/episode015.rpy:564
translate simplified_chinese ep015_camp_ziv_1bf87e20:

    # zi "I see."
    zi "我明白了。"

# game/episode015.rpy:567
translate simplified_chinese ep015_camp_ziv_3690e120:

    # zi "It just all seems so wasteful, in retrospect."
    zi "回想起来，这一切似乎都如此浪费。"

# game/episode015.rpy:568
translate simplified_chinese ep015_camp_ziv_d5b7dd7e:

    # c "Undoubtedly."
    c "毫无疑问。"

# game/episode015.rpy:569
translate simplified_chinese ep015_camp_ziv_419c010c:

    # zi "At least we're going to help Nkoy Rhedia state her case and try to convince the Council."
    zi "至少我们正在帮助伦科伊·瑞迪亚陈述她的案情，并试图说服议会。"

# game/episode015.rpy:570
translate simplified_chinese ep015_camp_ziv_fc345fb9:

    # c "Exactly, all we can hope now is that Arlya will be held accountable."
    c "没错，我们现在只能希望阿尔雅会被追究责任。"

# game/episode015.rpy:572
translate simplified_chinese ep015_camp_ziv_85f3f408:

    # zi "It all seems so wasteful, in retrospect."
    zi "回想起来，这一切似乎都如此浪费。"

# game/episode015.rpy:573
translate simplified_chinese ep015_camp_ziv_d5b7dd7e_1:

    # c "Undoubtedly."
    c "毫无疑问。"

# game/episode015.rpy:576
translate simplified_chinese ep015_camp_ziv_23b4b9eb:

    # zi "Something has changed in you, [p_name], ever since you came back from the Jaculus."
    zi "自从你从\"翼蛇\"号回来后，[p_name]，你身上发生了一些变化。"

# game/episode015.rpy:577
translate simplified_chinese ep015_camp_ziv_6e6ce20e:

    # c "Oh?"
    c "哦？"

# game/episode015.rpy:578
translate simplified_chinese ep015_camp_ziv_d56f5fd1:

    # zi "There's a hardness that wasn't there before."
    zi "你身上多了一种以前没有的坚韧。"

# game/episode015.rpy:579
translate simplified_chinese ep015_camp_ziv_7f0f185f:

    # c "I'm determined to get to the bottom of this prophecy and carve out a normal life for us, free of persecution."
    c "我决心要彻底查明这个预言的真相，为我们争取不受迫害的正常生活。"

# game/episode015.rpy:580
translate simplified_chinese ep015_camp_ziv_dd8e6098:

    # c "I will not shy away from tough decisions."
    c "我不会回避艰难的决定。"

# game/episode015.rpy:581
translate simplified_chinese ep015_camp_ziv_1ccdd055:

    # c "So yeah, maybe that makes me a little harder."
    c "所以没错，也许这确实让我变得更强硬了些。"

# game/episode015.rpy:583
translate simplified_chinese ep015_camp_ziv_8fde6122:

    # zi "Maybe..."
    zi "也许吧…"

# game/episode015.rpy:585
translate simplified_chinese ep015_camp_ziv_0e71592d:

    # zi "Well, I'll leave you be."
    zi "好吧，我不打扰你了。"

# game/episode015.rpy:586
translate simplified_chinese ep015_camp_ziv_65e196c2:

    # zi "Good night, [p_name]."
    zi "晚安，[p_name]。"

# game/episode015.rpy:587
translate simplified_chinese ep015_camp_ziv_7a7c9908:

    # c "Good night, Ziv."
    c "晚安，基芙。"

# game/episode015.rpy:589
translate simplified_chinese ep015_camp_ziv_0b907e5e:

    # zi "I'm sorry if I put the crew in danger because of my actions."
    zi "如果我的行为让船员们陷入危险，我很抱歉。"

# game/episode015.rpy:590
translate simplified_chinese ep015_camp_ziv_a50399c2:

    # zi "I will state my objections more clearly beforehand."
    zi "以后我会更明确地提前表明我的反对意见。"

# game/episode015.rpy:591
translate simplified_chinese ep015_camp_ziv_e897fbb0:

    # c "Thank you."
    c "谢谢你。"

# game/episode015.rpy:593
translate simplified_chinese ep015_camp_ziv_65e196c2_1:

    # zi "Good night, [p_name]."
    zi "晚安，[p_name]。"

# game/episode015.rpy:594
translate simplified_chinese ep015_camp_ziv_7a7c9908_1:

    # c "Good night, Ziv."
    c "晚安，基芙。"

# game/episode015.rpy:597
translate simplified_chinese ep015_camp_ziv_dc77a5c2:

    # zi "I just wanted to check in on you before going to bed."
    zi "我只是想在睡觉前看看你怎么样了。"

# game/episode015.rpy:598
translate simplified_chinese ep015_camp_ziv_5c2c6942:

    # zi "I don't think Rhedia's followers will give us any trouble."
    zi "我觉得瑞迪亚的追随者不会给我们带来什么麻烦。"

# game/episode015.rpy:599
translate simplified_chinese ep015_camp_ziv_41de6490:

    # c "What makes you say that?"
    c "为什么这么说？"

# game/episode015.rpy:601
translate simplified_chinese ep015_camp_ziv_4777b3cd:

    # zi "I've spoken to some of them, and they don't strike me as hardened soldiers."
    zi "我和他们中的一些人谈过，他们给我的印象不是经验丰富的士兵。"

# game/episode015.rpy:602
translate simplified_chinese ep015_camp_ziv_980a7dec:

    # zi "Most of them were students or scholars."
    zi "他们大多是学生或学者。"

# game/episode015.rpy:603
translate simplified_chinese ep015_camp_ziv_d105c30f:

    # c "Yeah, the lack of any military training is very noticeable."
    c "是啊，缺乏军事训练这一点非常明显。"

# game/episode015.rpy:604
translate simplified_chinese ep015_camp_ziv_36faf991:

    # c "Most of them seem to be in over their heads."
    c "他们中的大多数人似乎都有些力不从心。"

# game/episode015.rpy:606
translate simplified_chinese ep015_camp_ziv_9e1a2e2e:

    # zi "Many of them are."
    zi "他们中很多人确实是。"

# game/episode015.rpy:608
translate simplified_chinese ep015_camp_ziv_21f38131:

    # zi "I'm glad you agreed to work with Nkoy Rhedia, though."
    zi "不过我很高兴你同意与伦科伊·瑞迪亚合作。"

# game/episode015.rpy:609
translate simplified_chinese ep015_camp_ziv_4cf875d5:

    # zi "If what she's telling us about Arlya is true, the Rhenkoy are in grave danger."
    zi "如果她告诉我们的关于阿尔雅的事情属实，伦科伊人正面临严重危险。"

# game/episode015.rpy:610
translate simplified_chinese ep015_camp_ziv_4628c8c6:

    # c "Despite that we need a solid lead on the Scolguin, it seemed a little harsh to sacrifice an entire planet to a would-be dictator."
    c "尽管我们需要关于斯科尔金的确切线索，但牺牲整个星球给一个潜在的独裁者似乎有点残酷。"

# game/episode015.rpy:612
translate simplified_chinese ep015_camp_ziv_2e955949:

    # zi "I hope we can make a difference."
    zi "我希望我们能改变现状。"

# game/episode015.rpy:613
translate simplified_chinese ep015_camp_ziv_833be815:

    # c "Rhedia sure seems to think so."
    c "瑞迪亚确实这么认为。"

# game/episode015.rpy:615
translate simplified_chinese ep015_camp_ziv_43a9201e:

    # zi "I know."
    zi "我知道。"

# game/episode015.rpy:616
translate simplified_chinese ep015_camp_ziv_26bf2053:

    # zi "She really trusts the power of reason and tradition."
    zi "她真的很信任理性和传统的力量。"

# game/episode015.rpy:617
translate simplified_chinese ep015_camp_ziv_53b4d85f:

    # c "You sound unconvinced?"
    c "你听起来不太信服？"

# game/episode015.rpy:619
translate simplified_chinese ep015_camp_ziv_9065d372:

    # zi "Not quite, I'm just apprehensive."
    zi "不完全是这样，我只是有些忧虑。"

# game/episode015.rpy:620
translate simplified_chinese ep015_camp_ziv_240da77f:

    # zi "I just hope reason is enough to deal with someone like Arlya, who seems really driven to upend the status quo and cheat where necessary."
    zi "我只是希望理性足以应付像阿尔雅这样的人，她似乎真的决心颠覆现状，并在必要时不择手段。"

# game/episode015.rpy:621
translate simplified_chinese ep015_camp_ziv_1cef5ea2:

    # c "I understand, for a society so hung up on rules and proper decorum, a loose cannon like Arlya could be very dangerous."
    c "我理解，对于如此拘泥于规则和适当礼仪的社会来说，像阿尔雅这样不守规矩的人可能非常危险。"

# game/episode015.rpy:623
translate simplified_chinese ep015_camp_ziv_f79996b0:

    # zi "Exactly."
    zi "正是如此。"

# game/episode015.rpy:624
translate simplified_chinese ep015_camp_ziv_13824637:

    # c "Let's get Rhedia to the capital first and let her present her evidence."
    c "我们先把瑞迪亚送到首都，让她呈上证据。"

# game/episode015.rpy:626
translate simplified_chinese ep015_camp_ziv_8d27522f:

    # zi "Nothing more we can do for now."
    zi "目前我们能做的也就这些了。"

# game/episode015.rpy:627
translate simplified_chinese ep015_camp_ziv_65e196c2_2:

    # zi "Good night, [p_name]."
    zi "晚安，[p_name]。"

# game/episode015.rpy:629
translate simplified_chinese ep015_camp_ziv_6ba39fba:

    # zi "It seems such a waste to just hand her over to Nkoy Arlya, especially if Nkoy Rhedia's accusations turn out to be true."
    zi "就这样把她交给诺科伊·阿尔雅似乎太浪费了，特别是如果诺科伊·瑞迪亚的指控属实的话。"

# game/episode015.rpy:630
translate simplified_chinese ep015_camp_ziv_f96387bb:

    # c "I know, but we desperately need a solid lead on the Scolguin."
    c "我知道，但我们迫切需要关于斯科尔金的可靠线索。"

# game/episode015.rpy:631
translate simplified_chinese ep015_camp_ziv_80006894:

    # c "With Arlya, we know where we stand."
    c "与阿尔雅合作，我们知道自己的立场。"

# game/episode015.rpy:632
translate simplified_chinese ep015_camp_ziv_5c493f42:

    # c "Rhedia's proposition, on the other hand, hinges on a whole lot of conjecture."
    c "而瑞迪亚的提议，却建立在一大堆推测之上。"

# game/episode015.rpy:634
translate simplified_chinese ep015_camp_ziv_d6abc085:

    # zi "I know..."
    zi "我知道…"

# game/episode015.rpy:635
translate simplified_chinese ep015_camp_ziv_cfa1a070:

    # zi "But if Nkoy Arlya really is trying to overthrow the legitimate government, we might just be about to hand her the means to do so."
    zi "但如果伦科伊·阿尔雅真的试图推翻合法政府，我们可能正要亲手把工具交给她。"

# game/episode015.rpy:636
translate simplified_chinese ep015_camp_ziv_2ff4f791:

    # c "I'm not sure it will come to that."
    c "我不确定事情会发展到那一步。"

# game/episode015.rpy:637
translate simplified_chinese ep015_camp_ziv_f1ec8a19:

    # c "The other members of the Council seemed like very reasonable and perceptive people, I'm sure they'll see through an attempt to overthrow the government."
    c "议会其他成员看起来都是非常理智且洞察力敏锐的人，我相信他们能识破推翻政府的企图。"

# game/episode015.rpy:639
translate simplified_chinese ep015_camp_ziv_687771ef:

    # zi "I think you underestimate just how shrewd Nkoy Arlya really is."
    zi "我觉得你低估了伦科伊·阿尔雅的精明程度。"

# game/episode015.rpy:640
translate simplified_chinese ep015_camp_ziv_f2a533da:

    # c "All the more reason not to get caught up in all this."
    c "这更让我们不该卷入这一切。"

# game/episode015.rpy:641
translate simplified_chinese ep015_camp_ziv_e41822bf:

    # c "We need a lead on the Scolguin, and I don't see how being thrown into prison because we helped a political rebel incite chaos helps us achieve that goal in any way."
    c "我们需要关于斯科尔金人的线索，而我不明白因为帮助政治叛乱分子煽动混乱而被扔进监狱，这怎么能帮助我们达成目标。"

# game/episode015.rpy:643
translate simplified_chinese ep015_camp_ziv_e91ab394:

    # zi "So we're going to hand her over to Nkoy Arlya?"
    zi "所以我们要把她交给伦科伊·阿尔雅？"

# game/episode015.rpy:644
translate simplified_chinese ep015_camp_ziv_9c218092:

    # c "I'm afraid we must."
    c "恐怕我们必须这样做。"

# game/episode015.rpy:646
translate simplified_chinese ep015_camp_ziv_69273a3e:

    # zi "I think that's a mistake."
    zi "我认为这是个错误。"

# game/episode015.rpy:647
translate simplified_chinese ep015_camp_ziv_6ea0996f:

    # c "That could very well be the case, but it's a mistake I'm willing to make."
    c "情况很可能就是这样，但这是我愿意犯的错误。"

# game/episode015.rpy:648
translate simplified_chinese ep015_camp_ziv_684248bf:

    # c "I won't stop you if you want to make a case before the Council."
    c "如果你想在议会面前陈述理由，我不会阻止你。"

# game/episode015.rpy:650
translate simplified_chinese ep015_camp_ziv_5d0e946b:

    # c "Though I'm not sure it would be wise to do so as part of the Bastard's crew."
    c "不过我不确定以\"私生子\"号船员的身份这样做是否明智。"

# game/episode015.rpy:652
translate simplified_chinese ep015_camp_ziv_b7eff388:

    # c "But in that case it would be better if we were to part ways."
    c "但那样的话，我们最好还是分道扬镳。"

# game/episode015.rpy:654
translate simplified_chinese ep015_camp_ziv_7fdb3ee4:

    # zi "You want me to leave the ship?"
    zi "你要我离开这艘飞船？"

# game/episode015.rpy:655
translate simplified_chinese ep015_camp_ziv_0e54eacd:

    # c "Only if you want to get embroiled in Rhenkoy politics."
    c "除非你想卷入伦科伊的政治纷争。"

# game/episode015.rpy:656
translate simplified_chinese ep015_camp_ziv_1bf87e20_1:

    # zi "I see."
    zi "我明白了。"

# game/episode015.rpy:658
translate simplified_chinese ep015_camp_ziv_1a9f5502:

    # zi "I'm not much of a rebel, [p_name]."
    zi "我不是什么反叛者，[p_name]。"

# game/episode015.rpy:660
translate simplified_chinese ep015_camp_ziv_81631a2e:

    # zi "Call me selfish, but I don't want to leave you."
    zi "说我自私也好，但我不想离开你。"

# game/episode015.rpy:662
translate simplified_chinese ep015_camp_ziv_f57c5e8c:

    # zi "As much as it pains me to see the chosen representatives of the Rhenkoy slip into corruption, I don't think my voice will make a difference."
    zi "尽管看到伦科伊的民选代表堕落腐败让我心痛，但我不认为我的声音能改变什么。"

# game/episode015.rpy:663
translate simplified_chinese ep015_camp_ziv_24366554:

    # c "I understand."
    c "我明白了。"

# game/episode015.rpy:665
translate simplified_chinese ep015_camp_ziv_0e71592d_1:

    # zi "Well, I'll leave you be."
    zi "好吧，我不打扰你了。"

# game/episode015.rpy:666
translate simplified_chinese ep015_camp_ziv_65e196c2_3:

    # zi "Good night, [p_name]."
    zi "晚安，[p_name]。"

# game/episode015.rpy:667
translate simplified_chinese ep015_camp_ziv_7a7c9908_2:

    # c "Good night, Ziv."
    c "晚安，基芙。"

# game/episode015.rpy:680
translate simplified_chinese ep015_bastard_5fecaa45:

    # "We climbed aboard, and I was just directing Aven and Kit to escort Rhedia to the guest quarters when Thyia stormed in."
    "我们登上飞船，我刚指示艾文和基特护送瑞迪亚去客房时，塞娅突然冲了进来。"

# game/episode015.rpy:682
translate simplified_chinese ep015_bastard_94b2cc38:

    # "We climbed aboard, and I was just directing Aven and Kit to escort Rhedia to the brig when Thyia stormed in."
    "我们登上飞船，我刚指示艾文和基特护送瑞迪亚去禁闭室时，塞娅突然冲了进来。"

# game/episode015.rpy:684
translate simplified_chinese ep015_bastard_24aa5084:

    # th "[p_name_short], come quickly!"
    th "[p_name_short]，快来！"

# game/episode015.rpy:685
translate simplified_chinese ep015_bastard_074db462:

    # c "Thyia, what's the matter?"
    c "塞娅，怎么了？"

# game/episode015.rpy:687
translate simplified_chinese ep015_bastard_6f8c5c12:

    # th "It's Eva.{w} [p_name_short], she went into a simulation and now she can't get out."
    th "是伊娃。{w} [p_name_short]，她进入模拟程序后现在出不来了。"

# game/episode015.rpy:688
translate simplified_chinese ep015_bastard_3dd5ee39:

    # c "What?!"
    c "什么？！"

# game/episode015.rpy:689
translate simplified_chinese ep015_bastard_eb563b57:

    # c "Did the tech malfunction?"
    c "是技术故障了吗？"

# game/episode015.rpy:691
translate simplified_chinese ep015_bastard_845a5c90:

    # th "I've ran several diagnostics, but I can't find anything."
    th "我已经运行了几次诊断，但什么也没发现。"

# game/episode015.rpy:692
translate simplified_chinese ep015_bastard_ea7bb236:

    # th "The simulation tech is refusing to disengage from her brain, though."
    th "不过模拟技术拒绝与她的脑部断开连接。"

# game/episode015.rpy:693
translate simplified_chinese ep015_bastard_5d008f14:

    # c "Have you tried forcing to break the connection?"
    c "你试过强制断开连接吗？"

# game/episode015.rpy:695
translate simplified_chinese ep015_bastard_32cf4f2a:

    # th "Doing so would cause massive brain damage, it's not an option."
    th "这样做会造成严重脑损伤，不可行。"

# game/episode015.rpy:696
translate simplified_chinese ep015_bastard_a2cf3906:

    # c "We can't leave her like that."
    c "我们不能就这样放任不管。"

# game/episode015.rpy:697
translate simplified_chinese ep015_bastard_5d8cfa44:

    # c "Is there anything else we could do?"
    c "我们还能做些什么？"

# game/episode015.rpy:699
translate simplified_chinese ep015_bastard_d751db20:

    # th "I'm not sure, maybe Jade knows a way?"
    th "我不确定，也许杰德知道办法？"

# game/episode015.rpy:701
translate simplified_chinese ep015_bastard_db3bbcce:

    # j "Trying to hack into the sim is going to be tricky, but it might be worth a try."
    j "试图侵入模拟程序会很棘手，但值得一试。"

# game/episode015.rpy:702
translate simplified_chinese ep015_bastard_0345e931:

    # j "Do you know what she was playing?"
    j "你知道她在玩什么吗？"

# game/episode015.rpy:704
translate simplified_chinese ep015_bastard_88512c6d:

    # th "She wanted to try a sim [p_name_short] had been using."
    th "她想试试[p_name_short]一直在用的那个模拟器。"

# game/episode015.rpy:705
translate simplified_chinese ep015_bastard_bf792c89:

    # c "Shit!{w} I should have kept that one behind a password."
    c "该死！{w}我本该给那个设个密码的。"

# game/episode015.rpy:706
translate simplified_chinese ep015_bastard_7f87c81f:

    # c "Let's head to the simulation room and see what we can do."
    c "我们去模拟室看看能做些什么。"

# game/episode015.rpy:709
translate simplified_chinese ep015_bastard_6b53e0ed:

    # "We hurried to the simulation room where Lilly was already tending to our sister."
    "我们匆忙赶到模拟室，莉莉已经在那里照顾我们的妹妹了。"

# game/episode015.rpy:711
translate simplified_chinese ep015_bastard_dc3a96db:

    # "We hurried to the simulation room where Lilly was already tending to her friend."
    "我们匆忙赶到模拟室，莉莉已经在那里照顾她的朋友了。"

# game/episode015.rpy:713
translate simplified_chinese ep015_bastard_efa1373f:

    # "Eva showed no outward signs of distress, as her head lay in Lilly's lap."
    "伊娃看起来没有任何痛苦的外在迹象，她的头靠在莉莉的腿上。"

# game/episode015.rpy:715
translate simplified_chinese ep015_bastard_e355a417:

    # l "We have to do something, she's been like this for hours."
    l "我们必须做点什么，她已经这样好几个小时了。"

# game/episode015.rpy:717
translate simplified_chinese ep015_bastard_e7a17990:

    # "Jade got to work on the simulation's console."
    "杰德开始在模拟器控制台上操作起来。"

# game/episode015.rpy:718
translate simplified_chinese ep015_bastard_7bfd7098:

    # c "She hasn't been conscious after she entered the simulation?"
    c "她进入模拟后就一直没有恢复意识吗？"

# game/episode015.rpy:720
translate simplified_chinese ep015_bastard_4fc20161:

    # l "No, we heard her scream and found her lying on the floor here."
    l "没有，我们听到她的尖叫声，发现她倒在这里的地板上。"

# game/episode015.rpy:721
translate simplified_chinese ep015_bastard_57cd37f0:

    # l "Do you know what's the matter [p_name_short]?"
    l "你知道是怎么回事吗[p_name_short]？"

# game/episode015.rpy:722
translate simplified_chinese ep015_bastard_1c9a96c3:

    # c "It can't be good, whatever it is."
    c "不管是什么，肯定不会是什么好事。"

# game/episode015.rpy:723
translate simplified_chinese ep015_bastard_a4a18ce4:

    # c "Any luck, Jade?"
    c "有进展吗，杰德？"

# game/episode015.rpy:725
translate simplified_chinese ep015_bastard_3a56e9e4:

    # j "No, there's no way to separate her from the simulation without causing massive damage, like Thyia already said."
    j "不，就像塞娅说过的，我们没办法在不造成巨大伤害的情况下把她从模拟中分离出来。"

# game/episode015.rpy:726
translate simplified_chinese ep015_bastard_0a830946:

    # c "Fuck!"
    c "操！"

# game/episode015.rpy:727
translate simplified_chinese ep015_bastard_744321c3:

    # j "Someone could go in though and try to free her from within the simulation."
    j "不过有人可以进去，试着从模拟内部把她解救出来。"

# game/episode015.rpy:728
translate simplified_chinese ep015_bastard_2f81e0b2:

    # c "That sounds like a plan, I'll do it."
    c "听起来是个计划，我来做。"

# game/episode015.rpy:729
translate simplified_chinese ep015_bastard_243b4778:

    # j "I have to warn you though, it could be very dangerous."
    j "但我必须警告你，这可能非常危险。"

# game/episode015.rpy:730
translate simplified_chinese ep015_bastard_33251b34:

    # j "Whatever is keeping Eva stuck inside could do the same to you."
    j "任何让伊娃困在里面的东西同样也可能困住你。"

# game/episode015.rpy:731
translate simplified_chinese ep015_bastard_ffd0c398:

    # c "I'll take that risk."
    c "我愿意冒这个风险。"

# game/episode015.rpy:733
translate simplified_chinese ep015_bastard_acecbbb3:

    # l "I'm coming with."
    l "我也要一起去。"

# game/episode015.rpy:734
translate simplified_chinese ep015_bastard_0b0f14f5:

    # c "No Lilly, I can't let you do that."
    c "不行莉莉，我不能让你这么做。"

# game/episode015.rpy:737
translate simplified_chinese ep015_bastard_18a843ae:

    # l "But she's my sister too!"
    l "但她也是我姐姐啊！"

# game/episode015.rpy:739
translate simplified_chinese ep015_bastard_d0c11312:

    # l "But she's my friend too!"
    l "但她也是我的朋友啊！"

# game/episode015.rpy:740
translate simplified_chinese ep015_bastard_57644027:

    # c "I know, but we can't risk two people getting stuck with Eva in there."
    c "我知道，但我们不能冒着两个人跟伊娃一起被困在里面的风险。"

# game/episode015.rpy:741
translate simplified_chinese ep015_bastard_3f531d11:

    # c "I'm partially responsible for this mess, so I'll fix it."
    c "这次的麻烦我也有部分责任，所以该由我来解决。"

# game/episode015.rpy:743
translate simplified_chinese ep015_bastard_c311fdc0:

    # l "Okay...{w} but hurry!"
    l "好吧…{w} 但要快点！"

# game/episode015.rpy:744
translate simplified_chinese ep015_bastard_255ecca1:

    # c "I will."
    c "我会的。"

# game/episode015.rpy:745
translate simplified_chinese ep015_bastard_099d45ce:

    # c "Tell Céline not to take off before Eva and me are back."
    c "告诉瑟琳，在我和伊娃回来之前别起飞。"

# game/episode015.rpy:747
translate simplified_chinese ep015_bastard_e8462428:

    # j "Got it."
    j "明白。"

# game/episode015.rpy:749
translate simplified_chinese ep015_bastard_55b8aa80:

    # c "Going in now."
    c "现在进去。"

# game/episode015.rpy:753
translate simplified_chinese ep015_bastard_23f06094:

    # "We climbed aboard, and I directed Aven and Kit to escort Rhedia to the guest quarters."
    "我们爬上飞船，我指示艾文和基特护送瑞迪亚去客房。"

# game/episode015.rpy:755
translate simplified_chinese ep015_bastard_3354aa5b:

    # "We climbed aboard, and I directed Aven and Kit to escort Rhedia to the brig."
    "我们爬上飞船，我指示艾文和基特护送瑞迪亚去禁闭室。"

# game/episode015.rpy:762
translate simplified_chinese ep015_sim_375db71f:

    # "As soon as the familiar surroundings of Tuolovi materialized around me, I felt something was off."
    "当图洛维熟悉的景象在我周围显现时，我感觉有些不对劲。"

# game/episode015.rpy:763
translate simplified_chinese ep015_sim_e7d9065f:

    # "A wrongness permeated the entire estate."
    "一种异常感弥漫在整个庄园。"

# game/episode015.rpy:765
translate simplified_chinese ep015_sim_a706fb1f:

    # "The grounds, once lush and green, were now dry and barren."
    "曾经郁郁葱葱的庭院，现在变得干燥而贫瘠。"

# game/episode015.rpy:767
translate simplified_chinese ep015_sim_3536c6a6:

    # "The house itself radiated an eerie light."
    "房子本身散发着诡异的光芒。"

# game/episode015.rpy:768
translate simplified_chinese ep015_sim_5e472544:

    # "During my earlier visits, the house hadn't felt truly lived in, now it seemed desolate."
    "在我之前的造访中，这房子从未让人感觉真正有人居住，现在它显得更加荒凉。"

# game/episode015.rpy:769
translate simplified_chinese ep015_sim_3a038e4b:

    # "I proceeded with caution."
    "我小心翼翼地前进。"

# game/episode015.rpy:770
translate simplified_chinese ep015_sim_cc19c357:

    # "Whatever had trapped an unsuspecting Eva inside would probably be waiting for me."
    "无论是什么困住了毫无防备的伊娃，它很可能也在等着我。"

# game/episode015.rpy:771
translate simplified_chinese ep015_sim_e76dc923:

    # "I crossed the grounds towards the entrance of the house and tried the door."
    "我穿过庭院走向房屋入口，试着推了推门。"

# game/episode015.rpy:773
translate simplified_chinese ep015_sim_0f44f46b:

    # "It was unlocked."
    "门没有上锁。"

# game/episode015.rpy:774
translate simplified_chinese ep015_sim_14339fad:

    # "Softly, I opened the door and made my way inside."
    "我轻轻推开门，走了进去。"

# game/episode015.rpy:776
translate simplified_chinese ep015_sim_7d28c550:

    # "The interior of the house wasn't exactly in disrepair, but everything was cast in an unnatural light, coming from everywhere and nowhere in particular."
    "房屋内部并非完全破败，但所有东西都笼罩在一种不自然的光线中，这光线无处不在却又没有特定来源。"

# game/episode015.rpy:777
translate simplified_chinese ep015_sim_407544d5:

    # "The entire mansion was utterly silent."
    "整座宅邸寂静无声。"

# game/episode015.rpy:778
translate simplified_chinese ep015_sim_3a213479:

    # "I didn't find any traces of someone living inside the house."
    "我没有发现任何有人居住的痕迹。"

# game/episode015.rpy:779
translate simplified_chinese ep015_sim_550706ba:

    # "Hesitantly, I made my way to the stairs, back to the bedroom where I'd left Lilly and Eva last time."
    "我犹豫着走向楼梯，回到上次留下莉莉和伊娃的卧室。"

# game/episode015.rpy:781
translate simplified_chinese ep015_sim_09cd2f27:

    # "All of the upstairs doors were closed and the hallway seemed as empty as the downstairs rooms."
    "楼上所有房门都关着，走廊和楼下房间一样空荡。"

# game/episode015.rpy:783
translate simplified_chinese ep015_sim_382900dd:

    # "When I was about to try the door to Eva's bedroom, a voice spoke behind me."
    "当我正要试着打开伊娃卧室的门时，身后传来一个声音。"

# game/episode015.rpy:785
translate simplified_chinese ep015_sim_d985ddaf:

    # l "You've returned."
    l "你回来了。"

# game/episode015.rpy:792
translate simplified_chinese ep015_sim_0c7c9728:

    # "I turned around and faced my sister."
    "我转过身，面对我的妹妹。"

# game/episode015.rpy:794
translate simplified_chinese ep015_sim_e406ec8e:

    # "I turned around and faced Lilly."
    "我转过身，面对莉莉。"

# game/episode015.rpy:802
translate simplified_chinese ep015_sim_d6932ab9:

    # l "Eva, [p_name_short], are you all right?"
    l "伊娃，[p_name_short]，你还好吗？"

# game/episode015.rpy:803
translate simplified_chinese ep015_sim_058dd7b5:

    # c "Yes, I think so."
    c "是的，我想还好。"

# game/episode015.rpy:806
translate simplified_chinese ep015_sim_6d0e7063:

    # j "It might be better if Thim had a look at Eva."
    j "也许应该让蒂姆给伊娃看看。"

# game/episode015.rpy:808
translate simplified_chinese ep015_sim_67135a15:

    # j "It might be better if the autodoc had a look at Eva."
    j "也许应该让自动医疗机给伊娃看看。"

# game/episode015.rpy:810
translate simplified_chinese ep015_sim_b18a6c0a:

    # l "I'll take her to the medbay."
    l "我带她去医疗舱。"

# game/episode015.rpy:811
translate simplified_chinese ep015_sim_415723d9:

    # l "Can you walk, Eva?"
    l "你能走路吗，伊娃？"

# game/episode015.rpy:813
translate simplified_chinese ep015_sim_eafbc7bb:

    # e "Y-Yes, I think so."
    e "能…能，我想可以。"

# game/episode015.rpy:814
translate simplified_chinese ep015_sim_9e168798:

    # e "What happened?"
    e "发生什么事了？"

# game/episode015.rpy:815
translate simplified_chinese ep015_sim_9947415f:

    # c "I'll explain later, once you've had your checkup."
    c "等你做完检查后我再解释。"

# game/episode015.rpy:816
translate simplified_chinese ep015_sim_d2a74119:

    # e "Okay, that sounds good, I guess."
    e "好吧，听起来不错，我想。"

# game/episode015.rpy:819
translate simplified_chinese ep015_sim_2df6e0bd:

    # j "What do you want me to do with the simulation?"
    j "你想让我怎么处理这个模拟程序？"

# game/episode015.rpy:820
translate simplified_chinese ep015_sim_61916c5a:

    # c "Keep it running indefinitely, but make sure that nobody can access it by accident."
    c "让它无限期运行，但要确保没人能意外访问到。"

# game/episode015.rpy:821
translate simplified_chinese ep015_sim_5e4ace8e:

    # j "Of course."
    j "当然。"

# game/episode015.rpy:822
translate simplified_chinese ep015_sim_dc39f861:

    # j "I've never seen anyone respond so badly in a simulation, what was in there anyway?"
    j "我从未见过有人在模拟程序中反应如此糟糕，里面到底有什么？"

# game/episode015.rpy:823
translate simplified_chinese ep015_sim_48179aab:

    # c "Things better left undisturbed."
    c "一些最好不去打扰的东西。"

# game/episode015.rpy:825
translate simplified_chinese ep015_sim_2df6e0bd_1:

    # j "What do you want me to do with the simulation?"
    j "你想让我怎么处理这个模拟程序？"

# game/episode015.rpy:826
translate simplified_chinese ep015_sim_f6866f70:

    # c "Delete all trace of it."
    c "删除所有相关痕迹。"

# game/episode015.rpy:827
translate simplified_chinese ep015_sim_bb6021aa:

    # j "Understood."
    j "明白。"

# game/episode015.rpy:828
translate simplified_chinese ep015_sim_dc39f861_1:

    # j "I've never seen anyone respond so badly in a simulation, what was in there anyway?"
    j "我从未见过谁在模拟中反应如此糟糕，里面到底有什么东西？"

# game/episode015.rpy:829
translate simplified_chinese ep015_sim_af40740f:

    # c "Very bad stuff."
    c "非常糟糕的东西。"

# game/episode015.rpy:830
translate simplified_chinese ep015_sim_868640c3:

    # c "The rest of the system should be unaffected, though."
    c "不过，系统的其他部分应该不会受到影响。"

# game/episode015.rpy:831
translate simplified_chinese ep015_sim_d9865933:

    # c "Now, if you don't mind, I'd like to be alone in my quarters for a while."
    c "如果你不介意的话，我现在想一个人待在舱室里静一静。"

# game/episode015.rpy:832
translate simplified_chinese ep015_sim_a52dc35f:

    # c "Tell Céline we're ready to go."
    c "告诉瑟琳我们准备出发了。"

# game/episode015.rpy:834
translate simplified_chinese ep015_sim_c7763b6f:

    # th "Understood."
    th "明白。"

# game/episode015.rpy:841
translate simplified_chinese ep015_sim_0306d026:

    # l "I had such bad dreams last night."
    l "昨晚我做了很可怕的梦。"

# game/episode015.rpy:843
translate simplified_chinese ep015_sim_987e3d37:

    # e "Really?"
    e "真的吗？"

# game/episode015.rpy:844
translate simplified_chinese ep015_sim_224b33c7:

    # e "I can't remember a thing from last night."
    e "昨晚的事我一点都记不起来了。"

# game/episode015.rpy:846
translate simplified_chinese ep015_sim_087166f0:

    # l "You had passed away and in the middle of mourning, [p_name] had gotten back here."
    l "你当时已经去世了，正在哀悼期间，[p_name]却回到了这里。"

# game/episode015.rpy:847
translate simplified_chinese ep015_sim_8ca093d7:

    # l "From the Academy, I guess?"
    l "我猜是从学院开始的吧？"

# game/episode015.rpy:848
translate simplified_chinese ep015_sim_1ff9df48:

    # l "We had a terrible fight."
    l "我们大吵了一架。"

# game/episode015.rpy:849
translate simplified_chinese ep015_sim_dacaf6d8:

    # e "Well, I'm still here."
    e "嗯，我还在这里。"

# game/episode015.rpy:850
translate simplified_chinese ep015_sim_720bdbf6:

    # l "Yeah, I know."
    l "是的，我知道。"

# game/episode015.rpy:851
translate simplified_chinese ep015_sim_c6b3f639:

    # l "It was just a dream, but it felt so real."
    l "那只是个梦，但感觉太真实了。"

# game/episode015.rpy:853
translate simplified_chinese ep015_sim_9560dbd2:

    # e "I hate dreams like that."
    e "我讨厌那样的梦。"

# game/episode015.rpy:854
translate simplified_chinese ep015_sim_28f19e23:

    # l "Yeah, me too."
    l "是啊，我也是。"

# game/episode015.rpy:855
translate simplified_chinese ep015_sim_63e5d9b3:

    # l "But enough about that."
    l "不过这个话题就到此为止吧。"

# game/episode015.rpy:857
translate simplified_chinese ep015_sim_286d86b3:

    # l "It's a beautiful day and we're going to enjoy it, you and I."
    l "今天天气这么好，我们得好好享受，就你和我。"

# game/episode015.rpy:858
translate simplified_chinese ep015_sim_a37b796c:

    # e "Sounds like a great plan."
    e "听起来是个很棒的计划。"

# game/episode015.rpy:860
translate simplified_chinese ep015_sim_0fb12215:

    # e "Poor [p_name_short], holed up at the Academy."
    e "可怜的[p_name_short]，被困在舰队学院里。"

# game/episode015.rpy:861
translate simplified_chinese ep015_sim_5f7b6e29:

    # e "I'm so glad we don't have to go and just enjoy our lives here."
    e "我真高兴我们不用去那里，只需在这里享受生活。"

# game/episode015.rpy:862
translate simplified_chinese ep015_sim_a76bfadf:

    # l "I'm sure he'll be back some time."
    l "我相信他总有一天会回来的。"

# game/episode015.rpy:864
translate simplified_chinese ep015_sim_6ce2c128:

    # e "Yeah, some time."
    e "是啊，总有一天。"

# game/episode015.rpy:865
translate simplified_chinese ep015_sim_3e98efdd:

    # e "The garden is looking extra pretty right now, let's enjoy the sun there."
    e "花园现在看起来特别漂亮，我们去那里晒晒太阳吧。"

# game/episode015.rpy:870
translate simplified_chinese ep015_sim_0306d026_1:

    # l "I had such bad dreams last night."
    l "我昨晚做了很糟糕的梦。"

# game/episode015.rpy:872
translate simplified_chinese ep015_sim_987e3d37_1:

    # e "Really?"
    e "真的吗？"

# game/episode015.rpy:873
translate simplified_chinese ep015_sim_9e280f00:

    # e "Me too."
    e "我也是。"

# game/episode015.rpy:874
translate simplified_chinese ep015_sim_f86a62b9:

    # l "We were in a bitter fight."
    l "我们激烈地争吵起来。"

# game/episode015.rpy:875
translate simplified_chinese ep015_sim_e184000a:

    # e "Yes, a bitter fight...{w} over him."
    e "是的，激烈的争吵…{w} 因为他。"

# game/episode015.rpy:876
translate simplified_chinese ep015_sim_99ae4b2f:

    # l "You dreamt the same thing?"
    l "你们做了同样的梦？"

# game/episode015.rpy:877
translate simplified_chinese ep015_sim_b841d111:

    # e "I think so."
    e "我想是的。"

# game/episode015.rpy:879
translate simplified_chinese ep015_sim_c79e1b06:

    # e "It must be because we loved him both so dearly."
    e "一定是因为我们都深爱着他。"

# game/episode015.rpy:880
translate simplified_chinese ep015_sim_83530090:

    # e "And now he's gone..."
    e "而现在他走了…"

# game/episode015.rpy:881
translate simplified_chinese ep015_sim_0e55bc49:

    # l "I still can't believe it."
    l "我还是无法相信。"

# game/episode015.rpy:882
translate simplified_chinese ep015_sim_5bb80a41:

    # e "Me neither."
    e "我也是。"

# game/episode015.rpy:884
translate simplified_chinese ep015_sim_72e75ef3:

    # e "At least we still have each other."
    e "至少我们还有彼此。"

# game/episode015.rpy:885
translate simplified_chinese ep015_sim_e2a940ee:

    # l "Fortunately."
    l "幸好如此。"

# game/episode015.rpy:888
translate simplified_chinese ep015_sim_1138628b:

    # "The sisters exchanged a kiss that lingered definitively into the realm of impropriety."
    "姐妹俩交换了一个吻，这吻缠绵得显然已越出了礼节范畴。"

# game/episode015.rpy:890
translate simplified_chinese ep015_sim_504bbf05:

    # "The girls exchanged a kiss that lingered definitively into the realm of impropriety."
    "女孩们交换了一个吻，这吻缠绵得显然已越出了礼节范畴。"

# game/episode015.rpy:892
translate simplified_chinese ep015_sim_e1b17a7c:

    # l "Do you want me to come to your room tonight again?"
    l "今晚还要我去你房间吗？"

# game/episode015.rpy:893
translate simplified_chinese ep015_sim_29f9af9a:

    # e "Yes, I'd like that very much."
    e "好啊，我很乐意。"

# game/episode015.rpy:894
translate simplified_chinese ep015_sim_76d2c532:

    # l "I love you, Eva."
    l "我爱你，伊娃。"

# game/episode015.rpy:895
translate simplified_chinese ep015_sim_967e729a:

    # e "I love you too, Lilly."
    e "我也爱你，莉莉。"

# game/episode015.rpy:900
translate simplified_chinese ep015_sim_f09489f5:

    # l "I know it's been a while since I visited."
    l "我知道我好久没来看你了。"

# game/episode015.rpy:902
translate simplified_chinese ep015_sim_2427dabf:

    # l "I miss you, dearest brother."
    l "我好想你，最亲爱的哥哥。"

# game/episode015.rpy:904
translate simplified_chinese ep015_sim_bd0182c9:

    # l "I miss you, dearest."
    l "我好想你，最亲爱的。"

# game/episode015.rpy:906
translate simplified_chinese ep015_sim_d2e513e9:

    # l "You might be interested to know that I visited Eva's grave."
    l "你可能有兴趣知道我去看了伊娃的坟墓。"

# game/episode015.rpy:907
translate simplified_chinese ep015_sim_878fe452:

    # l "You know what I did?"
    l "知道我做了什么吗？"

# game/episode015.rpy:909
translate simplified_chinese ep015_sim_665d88e5:

    # l "I pissed all over it."
    l "我在上面撒了泡尿。"

# game/episode015.rpy:910
translate simplified_chinese ep015_sim_97034daf:

    # l "Haha, yes I did!"
    l "哈哈，我确实这么干了！"

# game/episode015.rpy:912
translate simplified_chinese ep015_sim_b83219a5:

    # l "I know, I know, I'm talking to myself too much."
    l "我知道，我知道，我自言自语得太多了。"

# game/episode015.rpy:913
translate simplified_chinese ep015_sim_2fc771aa:

    # l "I wish you were here, taking me in your strong arms."
    l "真希望你能在这里，用你强壮的双臂抱住我。"

# game/episode015.rpy:915
translate simplified_chinese ep015_sim_fa5a36d1:

    # l "Just thinking of you gets me all going."
    l "光是想到你就让我浑身发热。"

# game/episode015.rpy:917
translate simplified_chinese ep015_sim_1aa32914:

    # l "I'm sure that you won't mind if I enjoy myself a little here."
    l "我相信你不会介意我在这里稍微自娱自乐一下。"

# game/episode015.rpy:919
translate simplified_chinese ep015_sim_1cc22827:

    # l "That's right."
    l "没错。"

# game/episode015.rpy:920
translate simplified_chinese ep015_sim_b9796a3c:

    # l "Oh [p_name_short]!"
    l "哦，[p_name_short]！"

# game/episode015.rpy:921
translate simplified_chinese ep015_sim_c22d672a:

    # l "Yes, right there!"
    l "对，就是那里！"

# game/episode015.rpy:926
translate simplified_chinese ep015_sim_d5beeceb:

    # l "Hey you two."
    l "嘿，你们两个。"

# game/episode015.rpy:927
translate simplified_chinese ep015_sim_392d704a:

    # l "I had such a bad dream last night."
    l "昨晚我做了个可怕的噩梦。"

# game/episode015.rpy:929
translate simplified_chinese ep015_sim_30f8225c:

    # l "Eva and I, we were both fighting over you, [p_name]."
    l "伊娃和我，我们俩都在争抢你，[p_name]。"

# game/episode015.rpy:930
translate simplified_chinese ep015_sim_5f075462:

    # l "Yes, fighting over him, can you imagine, Eva?"
    l "没错，在争抢他，你能想象吗，伊娃？"

# game/episode015.rpy:931
translate simplified_chinese ep015_sim_36c9be86:

    # l "When I woke up, I had a realization."
    l "当我醒来时，我突然明白了一件事。"

# game/episode015.rpy:933
translate simplified_chinese ep015_sim_f92028b2:

    # l "Was [p_name] leaving the reason why you chose to end things, Eva?"
    l "[p_name]的离开是你选择结束关系的原因吗，伊娃？"

# game/episode015.rpy:935
translate simplified_chinese ep015_sim_ab0c0c39:

    # l "I guess I'll never know."
    l "我想我永远不会知道了。"

# game/episode015.rpy:936
translate simplified_chinese ep015_sim_ce1a3491:

    # l "Sorry for talking to myself so much, but it gets pretty lonely here without you two being there."
    l "抱歉我一直在自言自语，但没有你们俩在身边，这里真的很寂寞。"

# game/episode015.rpy:937
translate simplified_chinese ep015_sim_f6bd9e24:

    # l "I'll keep visiting your graves, if you don't mind."
    l "如果你们不介意的话，我会继续来你们的墓前探望。"

# game/episode015.rpy:939
translate simplified_chinese ep015_sim_2e3e4187:

    # l "I guess you don't..."
    l "我想你们不会介意的…"

# game/episode015.rpy:946
translate simplified_chinese ep015_sim_altered_c38ea382:

    # mod "There are 4 possible endings to a simulation (2 good, 2 bad), try out different options if you're interested."
    mod "模拟有4种可能的结局(2种好结局，2种坏结局)，如果你感兴趣的话可以尝试不同的选择。"

# game/episode015.rpy:948
translate simplified_chinese ep015_sim_altered_445a3556:

    # "She wasn't wearing much and seemed very much aware of the effect it had on me."
    "她没穿多少衣服，而且似乎很清楚这对我产生的影响。"

# game/episode015.rpy:950
translate simplified_chinese ep015_sim_altered_268e6ec2:

    # "Lilly came closer, her movements carefully choreographed to enhance the effect of the clinging dress as much as possible."
    "莉莉走近了些，她的动作经过精心编排，尽可能凸显紧身裙的效果。"

# game/episode015.rpy:953
translate simplified_chinese ep015_sim_altered_428442c0:

    # l "Did you come back for me, brother-dear?"
    l "你是为我回来的吗，亲爱的哥哥？"

# game/episode015.rpy:955
translate simplified_chinese ep015_sim_altered_e6ea5e7e:

    # l "Did you come back for me, dearest?"
    l "你是为我回来的吗，最亲爱的？"

# game/episode015.rpy:959
translate simplified_chinese ep015_sim_altered_a636e731:

    # c "No, I didn't."
    c "不，我不是。"

# game/episode015.rpy:961
translate simplified_chinese ep015_sim_altered_802efcab:

    # l "You came for her, didn't you?"
    l "你是为她来的，对吗？"

# game/episode015.rpy:962
translate simplified_chinese ep015_sim_altered_e7ad40ce:

    # c "Yes, I did."
    c "是的，我是。"

# game/episode015.rpy:964
translate simplified_chinese ep015_sim_altered_80f1ec00:

    # l "Why?!"
    l "为什么？！"

# game/episode015.rpy:965
translate simplified_chinese ep015_sim_altered_a63c415a:

    # l "What do you want with that slut?"
    l "你想对那个荡妇做什么？"

# game/episode015.rpy:967
translate simplified_chinese ep015_sim_altered_d4769ab0:

    # c "She's your sister, Lilly."
    c "她是你的妹妹，莉莉。"

# game/episode015.rpy:969
translate simplified_chinese ep015_sim_altered_c9a7dd4c:

    # c "She's your friend, Lilly."
    c "她是你的朋友，莉莉。"

# game/episode015.rpy:970
translate simplified_chinese ep015_sim_altered_78fd3f93:

    # l "I don't care."
    l "我不在乎。"

# game/episode015.rpy:972
translate simplified_chinese ep015_sim_altered_8625da14:

    # l "All I care about is you."
    l "我在乎的只有你。"

# game/episode015.rpy:974
translate simplified_chinese ep015_sim_altered_9564a513:

    # "Lilly advanced on me, her body pressing against mine."
    "莉莉向我逼近，她的身体紧贴着我。"

# game/episode015.rpy:976
translate simplified_chinese ep015_sim_altered_d318b76b:

    # l "Why don't we go to my room, so I can show you just how much I care about you."
    l "不如我们去我的房间，让我好好向你展示我有多在乎你。"

# game/episode015.rpy:983
translate simplified_chinese ep015_sim_altered_29e33a76:

    # "Lilly's smell was intoxicating, and her closeness stirred something inside me."
    "莉莉身上的气息令人迷醉，她的贴近在我心中激起了某种悸动。"

# game/episode015.rpy:984
translate simplified_chinese ep015_sim_altered_ab068a80:

    # c "Lead the way."
    c "带路吧。"

# game/episode015.rpy:987
translate simplified_chinese ep015_sim_altered_f879bced:

    # c "I can't."
    c "我做不到。"

# game/episode015.rpy:989
translate simplified_chinese ep015_sim_altered_ed0eec76:

    # l "Sure you can."
    l "你当然可以。"

# game/episode015.rpy:991
translate simplified_chinese ep015_sim_altered_548f80e6:

    # "I pushed open the door to Eva's room."
    "我推开了伊娃房间的门。"

# game/episode015.rpy:993
translate simplified_chinese ep015_sim_altered_da5ade18:

    # l "No!"
    l "不！"

# game/episode015.rpy:994
translate simplified_chinese ep015_sim_altered_755ddbaa:

    # "The interior of Eva's bedroom was completely ravaged."
    "伊娃卧室的内部被彻底蹂躏了。"

# game/episode015.rpy:995
translate simplified_chinese ep015_sim_altered_a2cdf865:

    # "Furniture had been smashed, the curtains and tapestries ripped from the wall."
    "家具被砸碎，窗帘和挂毯从墙上撕下。"

# game/episode015.rpy:996
translate simplified_chinese ep015_sim_altered_91653e96:

    # "The ruin of what was once Eva's bed still stood in the center of the room."
    "曾经是伊娃床铺的残骸依然立在房间中央。"

# game/episode015.rpy:998
translate simplified_chinese ep015_sim_altered_15d1167b:

    # "Eva's lifeless body lay on the bed."
    "伊娃毫无生气的身体躺在床上。"

# game/episode015.rpy:999
translate simplified_chinese ep015_sim_altered_29d9898c:

    # c "What have you done?"
    c "你做了什么？"

# game/episode015.rpy:1001
translate simplified_chinese ep015_sim_altered_e6a42d45:

    # l "Nothing much...{w} yet..."
    l "没什么…{w} 目前…"

# game/episode015.rpy:1002
translate simplified_chinese ep015_sim_altered_b53e5930:

    # l "Don't even think of freeing her."
    l "想都别想解救她。"

# game/episode015.rpy:1004
translate simplified_chinese ep015_sim_altered_5e233537:

    # c "Why wouldn't I?"
    c "我为什么不呢？"

# game/episode015.rpy:1005
translate simplified_chinese ep015_sim_altered_59427dc8:

    # l "Because I'll kill her."
    l "因为我会杀了她。"

# game/episode015.rpy:1006
translate simplified_chinese ep015_sim_altered_03fc6e71:

    # c "How?!"
    c "怎么杀？！"

# game/episode015.rpy:1007
translate simplified_chinese ep015_sim_altered_7214cfe2:

    # c "Oh..."
    c "哦…"

# game/episode015.rpy:1009
translate simplified_chinese ep015_sim_altered_572bee63:

    # "Seemingly out of nowhere, Lilly had retrieved a shotgun."
    "莉莉似乎凭空拿出了一把霰弹枪。"

# game/episode015.rpy:1010
translate simplified_chinese ep015_sim_altered_ed929b28:

    # "I was pretty certain there were no weapons in the house, but Lilly must have been able to manipulate the simulation."
    "我很确定房子里没有武器，但莉莉肯定能操控这个模拟环境。"

# game/episode015.rpy:1012
translate simplified_chinese ep015_sim_altered_c3065977:

    # l "Now, step away from the bed."
    l "现在，从床边退开。"

# game/episode015.rpy:1013
translate simplified_chinese ep015_sim_altered_d3d6f820:

    # c "Lilly, what are you going to do?"
    c "莉莉，你要做什么？"

# game/episode015.rpy:1014
translate simplified_chinese ep015_sim_altered_d9a59ffe:

    # l "Turn around. "
    l "转过身去。 "

# game/episode015.rpy:1015
translate simplified_chinese ep015_sim_altered_c32999c2:

    # l "On your knees, or I'll blow her brains out."
    l "跪下，不然我就打爆她的头。"

# game/episode015.rpy:1017
translate simplified_chinese ep015_sim_altered_6b730652:

    # c "She's your sister!"
    c "她是你妹妹啊！"

# game/episode015.rpy:1019
translate simplified_chinese ep015_sim_altered_9a9a083e:

    # c "She's your friend!"
    c "她是你的朋友！"

# game/episode015.rpy:1020
translate simplified_chinese ep015_sim_altered_0cc6031e:

    # l "On your knees."
    l "跪下。"

# game/episode015.rpy:1022
translate simplified_chinese ep015_sim_altered_d363b059:

    # "I complied."
    "我照做了。"

# game/episode015.rpy:1024
translate simplified_chinese ep015_sim_altered_d0c9480c:

    # "Before I could utter another word, the butt of the rifle connected with my head, and everything went black."
    "还没等我说出另一个字，枪托就砸在了我的头上，眼前顿时一片漆黑。"

# game/episode015.rpy:1028
translate simplified_chinese ep015_sim_altered_e7ad40ce_1:

    # c "Yes, I did."
    c "没错，是我。"

# game/episode015.rpy:1030
translate simplified_chinese ep015_sim_altered_da768f87:

    # l "I knew you'd come back!"
    l "我就知道你会回来！"

# game/episode015.rpy:1031
translate simplified_chinese ep015_sim_altered_80adc58b:

    # l "I've been waiting on you for so long."
    l "我已经等了你这么久。"

# game/episode015.rpy:1032
translate simplified_chinese ep015_sim_altered_35627562:

    # l "All I want is you."
    l "我想要的只有你。"

# game/episode015.rpy:1034
translate simplified_chinese ep015_sim_altered_9564a513_1:

    # "Lilly advanced on me, her body pressing against mine."
    "莉莉向我逼近，她的身体紧贴着我。"

# game/episode015.rpy:1036
translate simplified_chinese ep015_sim_altered_d318b76b_1:

    # l "Why don't we go to my room, so I can show you just how much I care about you."
    l "不如我们去我的房间，让我好好向你展示我有多在乎你。"

# game/episode015.rpy:1040
translate simplified_chinese ep015_sim_altered_8c101356:

    # "Lead the way."
    "带路吧。"

# game/episode015.rpy:1044
translate simplified_chinese ep015_sim_altered_18248cc3:

    # "As soon as Lilly let down her guard, I twisted her arm and pacified her."
    "莉莉稍一松懈，我就立刻扭住她的手臂将她制服。"

# game/episode015.rpy:1045
translate simplified_chinese ep015_sim_altered_12fe58ca:

    # c "What have you done to Eva?"
    c "你对伊娃做了什么？"

# game/episode015.rpy:1047
translate simplified_chinese ep015_sim_altered_a262d07b:

    # l "Ow, [p_name_short], you're hurting me!"
    l "嗷，[p_name_short]，你弄疼我了！"

# game/episode015.rpy:1049
translate simplified_chinese ep015_sim_altered_27ea1122:

    # c "What have you done with our sister?"
    c "你把我们的姐妹怎么了？"

# game/episode015.rpy:1051
translate simplified_chinese ep015_sim_altered_fb1bc0b8:

    # c "What have you done with her?"
    c "你把她怎么样了？"

# game/episode015.rpy:1052
translate simplified_chinese ep015_sim_altered_e5c32328:

    # l "Nothing...{w} She's inside."
    l "没什么…{w} 她在里面。"

# game/episode015.rpy:1053
translate simplified_chinese ep015_sim_altered_91c0c7d8:

    # c "Open the door."
    c "把门打开。"

# game/episode015.rpy:1055
translate simplified_chinese ep015_sim_altered_3f2a0437:

    # "Trembling like a leaf, Lilly complied and pushed the door open."
    "莉莉像树叶一样颤抖着，顺从地推开了门。"

# game/episode015.rpy:1057
translate simplified_chinese ep015_sim_altered_755ddbaa_1:

    # "The interior of Eva's bedroom was completely ravaged."
    "伊娃卧室的内部完全被毁坏了。"

# game/episode015.rpy:1058
translate simplified_chinese ep015_sim_altered_a2cdf865_1:

    # "Furniture had been smashed, the curtains and tapestries ripped from the wall."
    "家具被砸碎，窗帘和挂毯从墙上撕了下来。"

# game/episode015.rpy:1059
translate simplified_chinese ep015_sim_altered_91653e96_1:

    # "The ruin of what was once Eva's bed still stood in the center of the room."
    "曾经是伊娃床铺的残骸依然立在房间中央。"

# game/episode015.rpy:1061
translate simplified_chinese ep015_sim_altered_15d1167b_1:

    # "Eva's lifeless body lay on the bed."
    "伊娃毫无生气的身体躺在床上。"

# game/episode015.rpy:1063
translate simplified_chinese ep015_sim_altered_99dbf0bf:

    # l "See, she's fine."
    l "看，她没事。"

# game/episode015.rpy:1064
translate simplified_chinese ep015_sim_altered_b61f89fe:

    # c "I wouldn't call that fine."
    c "我可不会说那叫没事。"

# game/episode015.rpy:1065
translate simplified_chinese ep015_sim_altered_328068a4:

    # l "She's still breathing, isn't she?"
    l "她还在呼吸，不是吗？"

# game/episode015.rpy:1068
translate simplified_chinese ep015_sim_altered_0dcdbe1c:

    # "I pushed my sister into a corner and searched for something to bind her hands."
    "我把妹妹推到角落，寻找能绑住她双手的东西。"

# game/episode015.rpy:1070
translate simplified_chinese ep015_sim_altered_36cd4ad7:

    # "I pushed Lilly into a corner and searched for something to bind her hands."
    "我把莉莉推到角落，寻找能绑住她双手的东西。"

# game/episode015.rpy:1072
translate simplified_chinese ep015_sim_altered_2ad42a24:

    # "Picking up a length of ripped fabric, I bound her and made her sit down."
    "我捡起一段撕碎的布料，把她绑起来让她坐下。"

# game/episode015.rpy:1073
translate simplified_chinese ep015_sim_altered_bbea13a3:

    # c "Stay there."
    c "待在那儿。"

# game/episode015.rpy:1074
translate simplified_chinese ep015_sim_altered_22739886:

    # "Lilly stared at me with murder in her eyes while I hasted towards the bed where Eva was lying."
    "当我匆忙走向伊娃躺着的床时，莉莉用充满杀意的眼神瞪着我。"

# game/episode015.rpy:1076
translate simplified_chinese ep015_sim_altered_243b6e41:

    # "I made sure she was still breathing first."
    "我先确认她是否还在呼吸。"

# game/episode015.rpy:1078
translate simplified_chinese ep015_sim_altered_f0283bd8:

    # "As I saw her chest rise and fall, I tried to turn her around."
    "当我看到她的胸口起伏时，我试图将她翻过来。"

# game/episode015.rpy:1080
translate simplified_chinese ep015_sim_altered_83818121:

    # l "Fool!"
    l "蠢货！"

# game/episode015.rpy:1082
translate simplified_chinese ep015_sim_altered_73adf2f4:

    # "Something hard connected with the base of my skull and everything went black."
    "某个坚硬的东西击中了我的后脑勺，眼前顿时一片漆黑。"

# game/episode015.rpy:1086
translate simplified_chinese ep015_sim_altered_0afeb908:

    # e "Get away from him."
    e "离他远点。"

# game/episode015.rpy:1087
translate simplified_chinese ep015_sim_altered_8229edae:

    # "Gritting her teeth, Lilly complied."
    "莉莉咬着牙照做了。"

# game/episode015.rpy:1089
translate simplified_chinese ep015_sim_altered_2ef59959:

    # e "Release him."
    e "放开他。"

# game/episode015.rpy:1090
translate simplified_chinese ep015_sim_altered_a494da55:

    # "Without anybody touching me, the bonds suddenly slipped from my wrists."
    "在无人触碰的情况下，我手腕上的束缚突然松脱了。"

# game/episode015.rpy:1091
translate simplified_chinese ep015_sim_altered_2aef743c:

    # e "Get over here, please, [p_name]."
    e "请过来这边，[p_name]。"

# game/episode015.rpy:1094
translate simplified_chinese ep015_sim_altered_d0b44cc2:

    # "I got behind my sister."
    "我走到了我妹妹身后。"

# game/episode015.rpy:1096
translate simplified_chinese ep015_sim_altered_b2af4242:

    # "I got behind Eva."
    "我走到了伊娃身后。"

# game/episode015.rpy:1098
translate simplified_chinese ep015_sim_altered_2347d660:

    # "Lilly was still glaring, ready to make a move."
    "莉莉仍在怒目而视，随时准备动手。"

# game/episode015.rpy:1099
translate simplified_chinese ep015_sim_altered_4dce4ea5:

    # "Eva started to back away slowly out of the room."
    "伊娃开始慢慢后退着离开房间。"

# game/episode015.rpy:1104
translate simplified_chinese ep015_sim_altered_5b927716:

    # "When we were both out in the hallway, Eva slammed the door shut and pushed a heavy dresser in front of it."
    "当我们都退到走廊上时，伊娃猛地关上房门，并推来一个沉重的梳妆台挡在门前。"

# game/episode015.rpy:1105
translate simplified_chinese ep015_sim_altered_1593a219:

    # "I didn't have time to question Eva's sudden strength nor the appearance of such a large piece of furniture that wasn't there before."
    "我无暇思考伊娃突然展现的力量，也无暇探究这件先前并不存在的大型家具从何而来。"

# game/episode015.rpy:1107
translate simplified_chinese ep015_sim_altered_7c555364:

    # e "We have to hurry."
    e "我们得赶紧走。"

# game/episode015.rpy:1109
translate simplified_chinese ep015_sim_altered_efb7687b:

    # c "But...{w} uh...{w} Eva is still around here somewhere."
    c "但是…{w}呃…{w}伊娃还在附近某处。"

# game/episode015.rpy:1111
translate simplified_chinese ep015_sim_altered_e07df9c3:

    # c "But...{w} uh...{w} Eva is still in there."
    c "但是…{w}呃…{w}伊娃还在里面。"

# game/episode015.rpy:1112
translate simplified_chinese ep015_sim_altered_4a6d2ef3:

    # e "She won't harm her."
    e "她不会伤害她的。"

# game/episode015.rpy:1113
translate simplified_chinese ep015_sim_altered_67898a3d:

    # e "Lilly hasn't slipped that far...{w} yet."
    e "莉莉还没堕落到那种地步…{w}至少现在还没有。"

# game/episode015.rpy:1115
translate simplified_chinese ep015_sim_altered_e21e0681:

    # "Together, we ran down the stairs outside onto the mansion's grounds."
    "我们一起跑下楼梯，来到宅邸外的庭院里。"

# game/episode015.rpy:1117
translate simplified_chinese ep015_sim_altered_c0ad0f22:

    # "Eva ran toward the formal gardens that had wilted and died in my absence."
    "伊娃朝着我离开期间已枯萎凋零的正式花园跑去。"

# game/episode015.rpy:1119
translate simplified_chinese ep015_sim_altered_17750543:

    # "We took refuge in the stone gazebo in the center of the gardens."
    "我们在花园中央的石亭里躲藏起来。"

# game/episode015.rpy:1121
translate simplified_chinese ep015_sim_altered_b35ab4bf:

    # e "It will take her a while to get here."
    e "她需要一段时间才能到达这里。"

# game/episode015.rpy:1122
translate simplified_chinese ep015_sim_altered_077bf075:

    # e "She's less strong outside than inside the house."
    e "她在室外没有在室内那么强大。"

# game/episode015.rpy:1123
translate simplified_chinese ep015_sim_altered_8f587dd6:

    # c "What happened, Eva?"
    c "发生什么事了，伊娃？"

# game/episode015.rpy:1125
translate simplified_chinese ep015_sim_altered_819e3008:

    # e "After Lilly lost her mind and you suddenly left, things got...{w} weird."
    e "自从莉莉失去理智而你突然离开后，事情就变得…{w}诡异起来。"

# game/episode015.rpy:1126
translate simplified_chinese ep015_sim_altered_3778dcaa:

    # e "I don't know how, but I got out of my room, chased by Lilly."
    e "不知怎的，我逃出了房间，被莉莉追赶着。"

# game/episode015.rpy:1127
translate simplified_chinese ep015_sim_altered_1f048a22:

    # e "First, I tried to hide, but she found me every time."
    e "起初我试图躲藏，但每次她都能找到我。"

# game/episode015.rpy:1129
translate simplified_chinese ep015_sim_altered_22b00353:

    # e "That's when I realized she was able to do all those crazy things."
    e "那时我才意识到她能够施展所有那些疯狂的能力。"

# game/episode015.rpy:1130
translate simplified_chinese ep015_sim_altered_b8b4afa7:

    # e "She could summon objects, physically manipulate things, seemingly at will."
    e "她可以凭空召唤物体，随心所欲地操控现实。"

# game/episode015.rpy:1131
translate simplified_chinese ep015_sim_altered_5e771358:

    # e "At first I couldn’t believe my eyes, but Lilly proved time and time again that she had gotten these strange powers."
    e "起初我简直不敢相信自己的眼睛，但莉莉一次次证明她确实获得了这些诡异的能力。"

# game/episode015.rpy:1132
translate simplified_chinese ep015_sim_altered_446364ee:

    # e "So, feeling like a fool, I tried to do the same, without much luck at first."
    e "于是，我像个傻瓜般尝试模仿她的动作，起初毫无成效。"

# game/episode015.rpy:1134
translate simplified_chinese ep015_sim_altered_7f25d62f:

    # e "But then, I made something appear."
    e "但后来，我真的让某样东西显现出来了。"

# game/episode015.rpy:1136
translate simplified_chinese ep015_sim_altered_c05cca13:

    # e "It took almost all my willpower and I nearly passed out."
    e "这几乎耗尽了我全部意志力，差点当场昏厥。"

# game/episode015.rpy:1137
translate simplified_chinese ep015_sim_altered_3d9550d2:

    # e "By then, I'd concluded the house wasn't safe for me and fled outside."
    e "那时我已断定宅邸对我不再安全，便逃到了室外。"

# game/episode015.rpy:1138
translate simplified_chinese ep015_sim_altered_438bdf2b:

    # e "Lilly hounded me, and it came to a stand-off near the edge of the grounds."
    e "莉莉紧追不舍，我们在庭院边缘形成了对峙。"

# game/episode015.rpy:1139
translate simplified_chinese ep015_sim_altered_5a792f39:

    # e "She summoned knives to hurl at me, while I conjured a ball of force to overwhelm her."
    e "她召唤出飞刀向我投掷，而我则凝聚出一团能量波想要压制她。"

# game/episode015.rpy:1140
translate simplified_chinese ep015_sim_altered_6a15f787:

    # e "We both struck true."
    e "我们同时击中了对方。"

# game/episode015.rpy:1141
translate simplified_chinese ep015_sim_altered_78dbf736:

    # e "The knife grazed my face as the wave of energy drove Lilly into the ground."
    e "飞刀擦过我的面颊，能量冲击波则将莉莉狠狠砸向地面。"

# game/episode015.rpy:1142
translate simplified_chinese ep015_sim_altered_53b1e0b9:

    # e "I fled further into the gardens and Lilly retreated towards the house."
    e "我继续向花园深处逃去，而莉莉则退回了宅邸方向。"

# game/episode015.rpy:1143
translate simplified_chinese ep015_sim_altered_87e08486:

    # c "Did she come back?"
    c "她回来了吗？"

# game/episode015.rpy:1145
translate simplified_chinese ep015_sim_altered_e26be94f:

    # e "She did."
    e "她回来了。"

# game/episode015.rpy:1146
translate simplified_chinese ep015_sim_altered_695cacaa:

    # e "Sometimes we met here in the gardens, or she caught me snooping around the house."
    e "有时我们会在花园里相遇，或者她抓住我在房子附近窥探。"

# game/episode015.rpy:1147
translate simplified_chinese ep015_sim_altered_0f46e45b:

    # e "We fought on both occasions."
    e "这两次我们都打了起来。"

# game/episode015.rpy:1149
translate simplified_chinese ep015_sim_altered_23b1b70b:

    # e "My power to manipulate the world isn't as strong near the house."
    e "在房子附近，我操控世界的力量没有那么强。"

# game/episode015.rpy:1150
translate simplified_chinese ep015_sim_altered_0fd2ab1b:

    # e "I guess it's the same for Lilly as she ventures further away from the mansion."
    e "我想当莉莉远离宅邸时，情况对她来说也是一样的。"

# game/episode015.rpy:1151
translate simplified_chinese ep015_sim_altered_89ca43e0:

    # c "What were you hoping to accomplish by returning to the house?"
    c "你回到房子里是希望达到什么目的？"

# game/episode015.rpy:1153
translate simplified_chinese ep015_sim_altered_4221f3ab:

    # e "I don't know..."
    e "我不知道…"

# game/episode015.rpy:1155
translate simplified_chinese ep015_sim_altered_e5e7106c:

    # e "A way to subdue my sister, perhaps?"
    e "也许是想找到制服我妹妹的方法？"

# game/episode015.rpy:1157
translate simplified_chinese ep015_sim_altered_b23a46e1:

    # e "A way to subdue her, perhaps?"
    e "也许是想找到制服她的方法？"

# game/episode015.rpy:1158
translate simplified_chinese ep015_sim_altered_675178aa:

    # e "Talk some sense into her?"
    e "跟她讲道理？"

# game/episode015.rpy:1159
translate simplified_chinese ep015_sim_altered_fbbb0f70:

    # e "I know it sounds ridiculous, but I had to try."
    e "我知道这听起来很荒谬，但我必须试试。"

# game/episode015.rpy:1160
translate simplified_chinese ep015_sim_altered_f01b8ae3:

    # c "Lilly doesn't have the same intentions, does she?"
    c "莉莉并没有同样的意图，对吧？"

# game/episode015.rpy:1162
translate simplified_chinese ep015_sim_altered_c2046d94:

    # e "No, I think she wants to hurt me."
    e "不，我觉得她是想伤害我。"

# game/episode015.rpy:1163
translate simplified_chinese ep015_sim_altered_552e0622:

    # c "We really have to get back for Eva."
    c "我们真的得回去救伊娃了。"

# game/episode015.rpy:1165
translate simplified_chinese ep015_sim_altered_0313d1b1:

    # e "You keep calling her that, Lilly's prisoner I mean."
    e "你一直这么称呼她，我是说莉莉的囚犯。"

# game/episode015.rpy:1166
translate simplified_chinese ep015_sim_altered_cb2adb61:

    # e "Is she really a copy of me?"
    e "她真的是我的复制品吗？"

# game/episode015.rpy:1167
translate simplified_chinese ep015_sim_altered_70157aae:

    # c "She is, yes."
    c "是的，她确实是。"

# game/episode015.rpy:1168
translate simplified_chinese ep015_sim_altered_19c354d6:

    # c "Her life is in danger."
    c "她的生命危在旦夕。"

# game/episode015.rpy:1170
translate simplified_chinese ep015_sim_altered_5729efc3:

    # e "I saw her appear in the gardens at some point, clearly disoriented."
    e "我看到她曾在某个时刻出现在花园里，明显很迷茫。"

# game/episode015.rpy:1171
translate simplified_chinese ep015_sim_altered_16a17460:

    # e "She walked straight into Lilly, who captured her."
    e "她径直走向了莉莉，结果被莉莉抓住了。"

# game/episode015.rpy:1172
translate simplified_chinese ep015_sim_altered_f79a69b6:

    # c "What will she do with her?"
    c "莉莉会怎么处置她？"

# game/episode015.rpy:1174
translate simplified_chinese ep015_sim_altered_09abd9b8:

    # e "Hurt her, I think, if she really looks like me."
    e "我觉得会伤害她，如果她真的长得像我。"

# game/episode015.rpy:1175
translate simplified_chinese ep015_sim_altered_9dfcbd9f:

    # c "We need to stop her."
    c "我们必须阻止她。"

# game/episode015.rpy:1176
translate simplified_chinese ep015_sim_altered_789e4523:

    # e "I agree."
    e "我同意。"

# game/episode015.rpy:1178
translate simplified_chinese ep015_sim_altered_148e97cc:

    # e "But [p_name], why did she come here?"
    e "但是[p_name]，她为什么会来这里？"

# game/episode015.rpy:1179
translate simplified_chinese ep015_sim_altered_208c77d9:

    # c "She was just curious, I think."
    c "我想她只是出于好奇。"

# game/episode015.rpy:1180
translate simplified_chinese ep015_sim_altered_21906219:

    # e "Is she really me?"
    e "她真的就是我吗？"

# game/episode015.rpy:1181
translate simplified_chinese ep015_sim_altered_0a09d539:

    # c "She is."
    c "是的。"

# game/episode015.rpy:1183
translate simplified_chinese ep015_sim_altered_06bfa7ba:

    # e "Is that where you go when you're not here?"
    e "你不在这里的时候就是去她那里吗？"

# game/episode015.rpy:1184
translate simplified_chinese ep015_sim_altered_857bee80:

    # e "To her, I mean?"
    e "对她而言，我是说？"

# game/episode015.rpy:1185
translate simplified_chinese ep015_sim_altered_f51b887e:

    # c "Yes, something like that."
    c "是的，差不多是这样。"

# game/episode015.rpy:1186
translate simplified_chinese ep015_sim_altered_2a67ce5e:

    # c "I'd lost her for a long time and I thought I'd lost her forever."
    c "我已经失去她很久了，我以为永远失去了她。"

# game/episode015.rpy:1187
translate simplified_chinese ep015_sim_altered_6af7a18f:

    # e "Is that why you came here to me?"
    e "这就是你来我这里的原因吗？"

# game/episode015.rpy:1188
translate simplified_chinese ep015_sim_altered_26eefe0a:

    # c "Yes."
    c "是的。"

# game/episode015.rpy:1190
translate simplified_chinese ep015_sim_altered_d44be8e1:

    # e "Do you love her?"
    e "你爱她吗？"

# game/episode015.rpy:1191
translate simplified_chinese ep015_sim_altered_9d9fb6df:

    # c "I do."
    c "我爱她。"

# game/episode015.rpy:1194
translate simplified_chinese ep015_sim_altered_9066342e:

    # e "Not as a brother, I mean."
    e "不是像兄长那样，我是说。"

# game/episode015.rpy:1196
translate simplified_chinese ep015_sim_altered_c84331c6:

    # e "Not as a friend, I mean."
    e "不是像朋友那样，我是说。"

# game/episode015.rpy:1197
translate simplified_chinese ep015_sim_altered_8ee98481:

    # e "Do you really love her?"
    e "你真的爱她吗？"

# game/episode015.rpy:1201
translate simplified_chinese ep015_sim_altered_9d9fb6df_1:

    # c "I do."
    c "我爱她。"

# game/episode015.rpy:1203
translate simplified_chinese ep015_sim_altered_19fae5c5:

    # e "I see."
    e "我明白了。"

# game/episode015.rpy:1204
translate simplified_chinese ep015_sim_altered_8ad67c4b:

    # e "Have you told her?"
    e "你告诉她了吗？"

# game/episode015.rpy:1205
translate simplified_chinese ep015_sim_altered_d8f7df2e:

    # c "I'm unsure how."
    c "我不知道该怎么说。"

# game/episode015.rpy:1207
translate simplified_chinese ep015_sim_altered_44122f20:

    # e "She's a version of me, right?"
    e "她是另一个版本的我，对吗？"

# game/episode015.rpy:1208
translate simplified_chinese ep015_sim_altered_770a0b33:

    # c "She's a little older than you, almost graduated from the Academy."
    c "她比你稍大些，几乎要从学院毕业了。"

# game/episode015.rpy:1209
translate simplified_chinese ep015_sim_altered_5b6d0d69:

    # e "Yeah, but she's still me."
    e "是的，但她依然是我。"

# game/episode015.rpy:1211
translate simplified_chinese ep015_sim_altered_59a79966:

    # e "All I can say is that she might surprise you."
    e "我只能说她可能会让你惊讶。"

# game/episode015.rpy:1212
translate simplified_chinese ep015_sim_altered_80dd13eb:

    # "We were silent for a moment, while I let that sink in."
    "我们沉默了片刻，我慢慢消化着这句话。"

# game/episode015.rpy:1215
translate simplified_chinese ep015_sim_altered_f34d6a56:

    # c "She's my sister, nothing more, nothing less."
    c "她是我妹妹，仅此而已，不多不少。"

# game/episode015.rpy:1217
translate simplified_chinese ep015_sim_altered_1d8effe5:

    # c "She's my friend, nothing more, nothing less."
    c "她是我的朋友，仅此而已。"

# game/episode015.rpy:1219
translate simplified_chinese ep015_sim_altered_04f0ff4d:

    # e "Understood."
    e "明白。"

# game/episode015.rpy:1222
translate simplified_chinese ep015_sim_altered_dd04c37a:

    # e "She's lucky to have you as a brother."
    e "有你这个哥哥是她的幸运。"

# game/episode015.rpy:1224
translate simplified_chinese ep015_sim_altered_cec9256d:

    # e "She's lucky to have you as a friend."
    e "有你这个朋友是她的幸运。"

# game/episode015.rpy:1226
translate simplified_chinese ep015_sim_altered_31f1249c:

    # e "[p_name]?"
    e "[p_name]?"

# game/episode015.rpy:1227
translate simplified_chinese ep015_sim_altered_24c7ada5:

    # c "Yes?"
    c "什么事？"

# game/episode015.rpy:1229
translate simplified_chinese ep015_sim_altered_0c1042c2:

    # e "We never had a chance, you and I, here I mean?"
    e "我们之间从未有过机会，你和我，在这里我指的是？"

# game/episode015.rpy:1230
translate simplified_chinese ep015_sim_altered_fa26340e:

    # c "At first I thought we had."
    c "起初我以为我们有过。"

# game/episode015.rpy:1231
translate simplified_chinese ep015_sim_altered_83f54fdd:

    # c "But the havoc my disappearances caused have proven otherwise."
    c "但我的失踪造成的混乱证明并非如此。"

# game/episode015.rpy:1233
translate simplified_chinese ep015_sim_altered_a5686c57:

    # e "I...{w} I understand."
    e "我…{w} 我理解。"

# game/episode015.rpy:1236
translate simplified_chinese ep015_sim_altered_4a1f3973:

    # e "Will you do one thing for me?"
    e "你能为我做件事吗？"

# game/episode015.rpy:1237
translate simplified_chinese ep015_sim_altered_4e8c7062:

    # c "Of course."
    c "当然可以。"

# game/episode015.rpy:1239
translate simplified_chinese ep015_sim_altered_36f76d3a:

    # e "Kiss me again, [p_name_short]."
    e "再吻我一次，[p_name_short]。"

# game/episode015.rpy:1241
translate simplified_chinese ep015_sim_altered_9bda8541:

    # e "Kiss me, [p_name_short]."
    e "吻我，[p_name_short]。"

# game/episode015.rpy:1242
translate simplified_chinese ep015_sim_altered_51830bf8:

    # e "Kiss me like you would a lover."
    e "像对待恋人那样吻我。"

# game/episode015.rpy:1245
translate simplified_chinese ep015_sim_altered_fa0d96bd:

    # c "I’m sorry, Eva, but I can’t."
    c "对不起，伊娃，但我不能。"

# game/episode015.rpy:1247
translate simplified_chinese ep015_sim_altered_a5686c57_1:

    # e "I...{w} I understand."
    e "我…{w} 我理解。"

# game/episode015.rpy:1248
translate simplified_chinese ep015_sim_altered_9ef30d64:

    # e "Sorry, I shouldn’t have asked."
    e "抱歉，我不该问的。"

# game/episode015.rpy:1252
translate simplified_chinese ep015_sim_altered_213e12dc:

    # "I cupped her face in my hands and brushed her lips with mine."
    "我用双手捧起她的脸，用我的嘴唇轻触她的唇。"

# game/episode015.rpy:1254
translate simplified_chinese ep015_sim_altered_6c6f56f2:

    # "In the meager sunlight covering a dying garden, we shared a passionate kiss."
    "在笼罩着垂死花园的微弱阳光下，我们分享了一个激情的吻。"

# game/episode015.rpy:1255
translate simplified_chinese ep015_sim_altered_7c5d2315:

    # "Our tongues were involved in an intricate tangle, and we both gasped as we pulled away."
    "我们的舌头在复杂地交缠，分开时我们都喘息着。"

# game/episode015.rpy:1257
translate simplified_chinese ep015_sim_altered_fe179427:

    # c "I love you, Eva."
    c "我爱你，伊娃。"

# game/episode015.rpy:1258
translate simplified_chinese ep015_sim_altered_cc197c6b:

    # e "I love you, [p_name]."
    e "我爱你，[p_name]。"

# game/episode015.rpy:1263
translate simplified_chinese ep015_sim_altered_4138e89b:

    # "A thundering roar shocked us back into the present."
    "一声雷鸣般的咆哮将我们拉回现实。"

# game/episode015.rpy:1264
translate simplified_chinese ep015_sim_altered_7df34f95:

    # c "Lilly?"
    c "莉莉？"

# game/episode015.rpy:1266
translate simplified_chinese ep015_sim_altered_bac083a9:

    # e "Most likely."
    e "很可能。"

# game/episode015.rpy:1267
translate simplified_chinese ep015_sim_altered_594df231:

    # e "We don't have much time."
    e "我们时间不多了。"

# game/episode015.rpy:1268
translate simplified_chinese ep015_sim_altered_1a7df0af:

    # e "I'll head back into the mansion and keep Lilly occupied on the lower floors."
    e "我回宅邸去，在楼下拖住莉莉。"

# game/episode015.rpy:1269
translate simplified_chinese ep015_sim_altered_fcee9eaa:

    # e "You rescue Eva and bring her back here."
    e "你去救伊娃，把她带回这里。"

# game/episode015.rpy:1270
translate simplified_chinese ep015_sim_altered_78021d41:

    # e "Once I return we'll figure out a way to get you out of here."
    e "等我回来后，我们再想办法让你离开这里。"

# game/episode015.rpy:1272
translate simplified_chinese ep015_sim_altered_9ed1f926:

    # "Together with Eva, I crossed the gardens back to the mansion."
    "我和伊娃一起穿过花园，返回宅邸。"

# game/episode015.rpy:1274
translate simplified_chinese ep015_sim_altered_2084cbd8:

    # "While I slipped around the side of the building, Eva stood proudly in front of the main entrance."
    "当我悄悄溜到建筑侧面时，伊娃正骄傲地站在正门前。"

# game/episode015.rpy:1275
translate simplified_chinese ep015_sim_altered_39ac0bad:

    # e "Come out, Lilly."
    e "出来吧，莉莉。"

# game/episode015.rpy:1276
translate simplified_chinese ep015_sim_altered_85d77b0d:

    # e "Let's end this once and for all."
    e "让我们做个彻底了断。"

# game/episode015.rpy:1278
translate simplified_chinese ep015_sim_altered_752bc6f7:

    # "There was no immediate response, but when I opened the side door, a blood-chilling keening could be heard coming from the top floor."
    "没有立即得到回应，但当我打开侧门时，能听到顶层传来令人毛骨悚然的哀嚎。"

# game/episode015.rpy:1280
translate simplified_chinese ep015_sim_altered_a7f89a3c:

    # "I hid myself in one of the rooms near the grand staircase and waited."
    "我躲在大楼梯旁的一个房间里等待着。"

# game/episode015.rpy:1282
translate simplified_chinese ep015_sim_altered_eaf60358:

    # "Something came rushing from the stairs and barreled straight through the doors accessing the outside."
    "有什么东西从楼梯上冲下来，直直撞穿了通往外面的门。"

# game/episode015.rpy:1283
translate simplified_chinese ep015_sim_altered_af04b1e0:

    # "Not waiting for the dust to settle, I ran to the second floor."
    "不等尘埃落定，我跑向二楼。"

# game/episode015.rpy:1285
translate simplified_chinese ep015_sim_altered_ba33db76:

    # "The door to Eva's bedroom was wide open."
    "伊娃卧室的门大开着。"

# game/episode015.rpy:1287
translate simplified_chinese ep015_sim_altered_edcac973:

    # "For an instant, I was afraid Lilly had already hurt my sister or done much worse."
    "那一瞬间，我害怕莉莉已经伤害了我妹妹，或者做出了更恶劣的事。"

# game/episode015.rpy:1289
translate simplified_chinese ep015_sim_altered_b02f3782:

    # "For an instant, I was afraid Lilly had already hurt my friend or done much worse."
    "那一瞬间，我害怕莉莉已经伤害了我朋友，或者做出了更恶劣的事。"

# game/episode015.rpy:1291
translate simplified_chinese ep015_sim_altered_a0cc9903:

    # "She was still lying unconscious on the bed, though an array of torture implements was lined up near it."
    "她仍昏迷不醒地躺在床上，不过床边摆放着一排刑具。"

# game/episode015.rpy:1293
translate simplified_chinese ep015_sim_altered_c06d2cea:

    # "I lifted her from the bed and carried her out of the room."
    "我把她从床上抱起来，带出了房间。"

# game/episode015.rpy:1294
translate simplified_chinese ep015_sim_altered_8e6718b5:

    # "When I reached the hallway, a familiar voice sounded in my head."
    "当我走到走廊时，一个熟悉的声音在我脑海中响起。"

# game/episode015.rpy:1296
translate simplified_chinese ep015_sim_altered_592db994:

    # j "[p_name_short], are you alright?"
    j "[p_name_short]，你还好吗？"

# game/episode015.rpy:1297
translate simplified_chinese ep015_sim_altered_0f877e17:

    # c "I think so, but I don't know how much longer."
    c "我想还好，但不知道还能撑多久。"

# game/episode015.rpy:1298
translate simplified_chinese ep015_sim_altered_40b831ff:

    # j "I'm trying to get you both out of here."
    j "我正在想办法把你们两个都救出去。"

# game/episode015.rpy:1299
translate simplified_chinese ep015_sim_altered_9f69f9a4:

    # j "Something seems to have changed just now."
    j "刚才好像发生了什么变化。"

# game/episode015.rpy:1300
translate simplified_chinese ep015_sim_altered_0b3f46c5:

    # c "Yeah, I rescued Eva."
    c "是的，我救出了伊娃。"

# game/episode015.rpy:1301
translate simplified_chinese ep015_sim_altered_bd02ebf2:

    # c "Getting back to safety now."
    c "现在正返回安全地带。"

# game/episode015.rpy:1303
translate simplified_chinese ep015_sim_altered_5c43dfe0:

    # "Carrying Eva on my back, I'd reached the bottom of the stairs."
    "背着伊娃，我已到达楼梯底部。"

# game/episode015.rpy:1304
translate simplified_chinese ep015_sim_altered_362d4dfd:

    # "Sounds of gunfire suddenly resounded outside."
    "外面突然响起枪声。"

# game/episode015.rpy:1307
translate simplified_chinese ep015_sim_altered_a066f343:

    # "Through the ruins of the back door I could see Lilly aiming a shotgun at her sister."
    "透过后门的废墟，我看见莉莉正用猎枪瞄准她的妹妹。"

# game/episode015.rpy:1309
translate simplified_chinese ep015_sim_altered_b7d7cd33:

    # "Through the ruins of the back door I could see Lilly aiming a shotgun at her friend."
    "透过后门的废墟，我看见莉莉正用猎枪瞄准她的朋友。"

# game/episode015.rpy:1311
translate simplified_chinese ep015_sim_altered_07b08a76:

    # "Before I could warn Eva outside, the shotgun fired."
    "没等我警告外面的伊娃，猎枪就开火了。"

# game/episode015.rpy:1313
translate simplified_chinese ep015_sim_altered_cd4ec01c:

    # "Either Lilly had missed, or her sister had successfully evaded the spray of buckshot."
    "要么是莉莉没打中，要么是她妹妹成功躲过了霰弹的扫射。"

# game/episode015.rpy:1315
translate simplified_chinese ep015_sim_altered_c524d890:

    # "Either Lilly had missed, or Eva had successfully evaded the spray of buckshot."
    "要么是莉莉没打中，要么是伊娃成功躲过了霰弹的扫射。"

# game/episode015.rpy:1316
translate simplified_chinese ep015_sim_altered_0c58693f:

    # j "[p_name_short]...{w} It's...{w} getting harder...{w} to...{w} get through."
    j "[p_name_short]…{w} 感觉…{w} 越来越…{w} 难以…{w} 沟通了。"

# game/episode015.rpy:1318
translate simplified_chinese ep015_sim_altered_b1b695c6:

    # "Ignoring Jade for a moment, I reached the side door and slipped outside."
    "暂时不顾杰德，我来到侧门溜了出去。"

# game/episode015.rpy:1319
translate simplified_chinese ep015_sim_altered_2a9938d6:

    # "Running straight for the gardens would mean a death sentence, as Lilly was likely to spot us."
    "直接跑向花园无异于自寻死路，因为莉莉很可能会发现我们。"

# game/episode015.rpy:1321
translate simplified_chinese ep015_sim_altered_465d5bf7:

    # "Instead, I ran for the outer walls of the estate and used the various bushes for cover."
    "于是我跑向庄园的外墙，利用各种灌木丛作掩护。"

# game/episode015.rpy:1322
translate simplified_chinese ep015_sim_altered_cc3dd1ea:

    # "Lilly and Eva were still shooting at each other."
    "莉莉和伊娃仍在互相射击。"

# game/episode015.rpy:1323
translate simplified_chinese ep015_sim_altered_d6e32b09:

    # "As the sounds of the gunfight grew fainter, Jade got through to me again."
    "随着枪战声逐渐减弱，杰德再次与我取得了联系。"

# game/episode015.rpy:1325
translate simplified_chinese ep015_sim_altered_e1d381d7:

    # j "What's happening there, [p_name]?"
    j "那边发生什么事了，[p_name]？"

# game/episode015.rpy:1326
translate simplified_chinese ep015_sim_altered_80db40ac:

    # j "Your signal got a lot weaker all of a sudden after we first spoke."
    j "我们第一次通话后，你的信号突然变得非常微弱。"

# game/episode015.rpy:1327
translate simplified_chinese ep015_sim_altered_1b459489:

    # j "Now it's stronger than ever, Eva's becoming stronger too."
    j "现在信号比以往任何时候都强，伊娃也在变得更强。"

# game/episode015.rpy:1328
translate simplified_chinese ep015_sim_altered_139c6bba:

    # c "Good."
    c "很好。"

# game/episode015.rpy:1329
translate simplified_chinese ep015_sim_altered_5fbf6e3c:

    # c "Can you pull us out safely?"
    c "你能安全地把我们带出去吗？"

# game/episode015.rpy:1330
translate simplified_chinese ep015_sim_altered_fe1e477c:

    # j "Almost."
    j "差不多了。"

# game/episode015.rpy:1332
translate simplified_chinese ep015_sim_altered_788db4b3:

    # "I'd reached the spot where Eva and I had a picnic, back when the simulation hadn't gone to shit yet."
    "我已经到达了模拟系统还没崩溃时，我和伊娃野餐的那个地方。"

# game/episode015.rpy:1333
translate simplified_chinese ep015_sim_altered_ce0ebb0a:

    # "The gazebo was nearby and Eva stirred slightly."
    "凉亭就在附近，伊娃微微动了动。"

# game/episode015.rpy:1335
translate simplified_chinese ep015_sim_altered_31f1249c_1:

    # e "[p_name]?"
    e "[p_name]?"

# game/episode015.rpy:1336
translate simplified_chinese ep015_sim_altered_3c8dd7f5:

    # e "What's happening?{w} Lilly...{w} she..."
    e "发生什么事了？{w}莉莉…{w}她…"

# game/episode015.rpy:1337
translate simplified_chinese ep015_sim_altered_41934fef:

    # c "Don't exert yourself, everything will be alright soon."
    c "别勉强自己，一切很快就会好起来的。"

# game/episode015.rpy:1340
translate simplified_chinese ep015_sim_altered_89e70c52:

    # "We had reached the gazebo, and I set down my sister against the lower wall making up the foundation of the little building."
    "我们到了凉亭，我把妹妹靠在小建筑地基的矮墙上放下。"

# game/episode015.rpy:1342
translate simplified_chinese ep015_sim_altered_ea0e98f7:

    # "We had reached the gazebo, and I set down my friend against the lower wall making up the foundation of the little building."
    "我们到了凉亭，我把朋友靠在小建筑地基的矮墙上放下。"

# game/episode015.rpy:1343
translate simplified_chinese ep015_sim_altered_549312b4:

    # j "I now have a fix on Eva as well."
    j "我现在也锁定了伊娃的位置。"

# game/episode015.rpy:1344
translate simplified_chinese ep015_sim_altered_85ca269d:

    # j "I can pull you out in a few seconds."
    j "我几秒钟后就能把你们拉出来。"

# game/episode015.rpy:1349
translate simplified_chinese ep015_sim_unaltered_304afa11:

    # "She was pointing a shotgun at me."
    "她正用霰弹枪指着我。"

# game/episode015.rpy:1350
translate simplified_chinese ep015_sim_unaltered_ed929b28:

    # "I was pretty certain there were no weapons in the house, but Lilly must have been able to manipulate the simulation."
    "我很确定房子里没有武器，但莉莉一定能够操纵这个模拟场景。"

# game/episode015.rpy:1352
translate simplified_chinese ep015_sim_unaltered_96bd63c1:

    # l "I told you not to come back, you miserable piece of shit."
    l "我告诉过你别回来，你这可悲的混蛋。"

# game/episode015.rpy:1353
translate simplified_chinese ep015_sim_unaltered_98769258:

    # l "Did you come back for that impostor?"
    l "你是为了那个冒牌货回来的吗？"

# game/episode015.rpy:1354
translate simplified_chinese ep015_sim_unaltered_c0efbe01:

    # c "Impostor, what do you mean?"
    c "冒牌货，你是什么意思？"

# game/episode015.rpy:1355
translate simplified_chinese ep015_sim_unaltered_94a1e2cf:

    # l "I think you know very well what I mean."
    l "我想你很清楚我的意思。"

# game/episode015.rpy:1356
translate simplified_chinese ep015_sim_unaltered_a1703c51:

    # l "That thing lying in that room over there."
    l "躺在那边房间里的那个东西。"

# game/episode015.rpy:1357
translate simplified_chinese ep015_sim_unaltered_9e4694a6:

    # l "You were trying to get in, weren’t you?"
    l "你想进去，对吧？"

# game/episode015.rpy:1358
translate simplified_chinese ep015_sim_unaltered_746cc9d0:

    # c "I was looking for Eva."
    c "我在找伊娃。"

# game/episode015.rpy:1360
translate simplified_chinese ep015_sim_unaltered_66a2c1f5:

    # l "Eva isn’t alive anymore."
    l "伊娃已经不在人世了。"

# game/episode015.rpy:1361
translate simplified_chinese ep015_sim_unaltered_a24aa632:

    # l "And it’s all because of you!"
    l "而这都是因为你！"

# game/episode015.rpy:1362
translate simplified_chinese ep015_sim_unaltered_3dd5ee39:

    # c "What?!"
    c "什么？！"

# game/episode015.rpy:1364
translate simplified_chinese ep015_sim_unaltered_d294304f:

    # l "She killed herself, [p_name]."
    l "她自杀了，[p_name]。"

# game/episode015.rpy:1365
translate simplified_chinese ep015_sim_unaltered_a708b90e:

    # l "Because you left her all alone."
    l "因为你把她一个人扔下了。"

# game/episode015.rpy:1366
translate simplified_chinese ep015_sim_unaltered_41019c77:

    # c "But you told me before not to come back."
    c "但你之前告诉过我不要回来。"

# game/episode015.rpy:1368
translate simplified_chinese ep015_sim_unaltered_17b84aef:

    # l "She wanted to be left alone, and then she killed herself because she couldn’t bear living anymore."
    l "她想一个人待着，然后因为无法再忍受生活而自杀了。"

# game/episode015.rpy:1370
translate simplified_chinese ep015_sim_unaltered_aeda4f8a:

    # l "All thanks to your callous behavior."
    l "这全都归功于你那冷酷无情的行为。"

# game/episode015.rpy:1371
translate simplified_chinese ep015_sim_unaltered_b0323e8d:

    # l "And then you had the audacity to send that thing."
    l "然后你居然还有胆量送来那个东西。"

# game/episode015.rpy:1372
translate simplified_chinese ep015_sim_unaltered_5005993f:

    # c "Who, Eva?"
    c "谁，伊娃？"

# game/episode015.rpy:1373
translate simplified_chinese ep015_sim_unaltered_84854d93:

    # l "So you do you know about her."
    l "所以你确实知道她的事。"

# game/episode015.rpy:1374
translate simplified_chinese ep015_sim_unaltered_ebcad928:

    # l "What is she, an android or a clone?"
    l "她是什么，机器人还是克隆体？"

# game/episode015.rpy:1375
translate simplified_chinese ep015_sim_unaltered_aa92174f:

    # c "You know very well that something like that is impossible."
    c "你很清楚那种事情是不可能的。"

# game/episode015.rpy:1376
translate simplified_chinese ep015_sim_unaltered_01c3b683:

    # l "Well, I don’t."
    l "好吧，我不清楚。"

# game/episode015.rpy:1378
translate simplified_chinese ep015_sim_unaltered_6bb24d3b:

    # l "She looks and talks very much like my departed sister."
    l "她的样貌和说话方式都非常像我已故的妹妹。"

# game/episode015.rpy:1379
translate simplified_chinese ep015_sim_unaltered_22b2d28f:

    # l "So what am I to think, that some random doppelgänger just wandered inside our house?!"
    l "那我该怎么想，难道随便一个冒牌货就这么闯进我们家了？！"

# game/episode015.rpy:1381
translate simplified_chinese ep015_sim_unaltered_4b2789fa:

    # l "She looks and talks very much like my departed friend."
    l "她的长相和说话方式都和我死去的朋友非常像。"

# game/episode015.rpy:1382
translate simplified_chinese ep015_sim_unaltered_00e32e6b:

    # l "So what am I to think, that some random doppelgänger just wandered inside this house?!"
    l "那我该怎么想，难道随便一个冒牌货就这么闯进这间屋子了？！"

# game/episode015.rpy:1383
translate simplified_chinese ep015_sim_unaltered_49d17fc4:

    # c "Lilly, this is absurd."
    c "莉莉，这太荒谬了。"

# game/episode015.rpy:1385
translate simplified_chinese ep015_sim_unaltered_40746659:

    # l "Oh, shut the fuck up [p_name], get inside."
    l "哦，给我他妈闭嘴[p_name]，进来。"

# game/episode015.rpy:1387
translate simplified_chinese ep015_sim_unaltered_1eead267:

    # "I opened the door and saw Eva's lifeless body lying on the bed."
    "我打开门，看见伊娃毫无生气的身体躺在床上。"

# game/episode015.rpy:1388
translate simplified_chinese ep015_sim_unaltered_29d9898c:

    # c "What have you done?"
    c "你做了什么？"

# game/episode015.rpy:1390
translate simplified_chinese ep015_sim_unaltered_e6a42d45:

    # l "Nothing much...{w} yet..."
    l "没什么…{w}暂时…"

# game/episode015.rpy:1391
translate simplified_chinese ep015_sim_unaltered_0975aaf9:

    # l "Don't even think of rousing her, because I'll kill her."
    l "别想着把她弄醒，否则我会杀了她。"

# game/episode015.rpy:1392
translate simplified_chinese ep015_sim_unaltered_d3d6f820:

    # c "Lilly, what are you going to do?"
    c "莉莉，你打算做什么？"

# game/episode015.rpy:1393
translate simplified_chinese ep015_sim_unaltered_2a79a520:

    # l "Turn around."
    l "转过身去。"

# game/episode015.rpy:1394
translate simplified_chinese ep015_sim_unaltered_c32999c2:

    # l "On your knees, or I'll blow her brains out."
    l "跪下，不然我打爆她的头。"

# game/episode015.rpy:1396
translate simplified_chinese ep015_sim_unaltered_6b730652:

    # c "She's your sister!"
    c "她是你妹妹！"

# game/episode015.rpy:1397
translate simplified_chinese ep015_sim_unaltered_b14116e5:

    # l "No, she's not, my sister is dead."
    l "不，她不是，我妹妹已经死了。"

# game/episode015.rpy:1399
translate simplified_chinese ep015_sim_unaltered_e8a2ff0e:

    # c "She's your best friend!"
    c "她是你最好的朋友！"

# game/episode015.rpy:1400
translate simplified_chinese ep015_sim_unaltered_3a8415df:

    # l "No, she's not, my best friend is dead."
    l "不，她不是，我最好的朋友已经死了。"

# game/episode015.rpy:1401
translate simplified_chinese ep015_sim_unaltered_0cc6031e:

    # l "On your knees."
    l "跪下。"

# game/episode015.rpy:1403
translate simplified_chinese ep015_sim_unaltered_d363b059:

    # "I complied."
    "我照做了。"

# game/episode015.rpy:1405
translate simplified_chinese ep015_sim_unaltered_7f67a346:

    # "Before I could utter another word, the butt of the rifle connected with my head and everything went black."
    "还没等我说出另一个字，步枪枪托就砸在了我头上，眼前一片漆黑。"

# game/episode015.rpy:1410
translate simplified_chinese ep015_sim_unaltered_fcab1aa8:

    # "When I opened my eyes again, a massive throbbing headache overtook my senses."
    "当我再次睁开眼睛时，剧烈的抽痛感淹没了我的感官。"

# game/episode015.rpy:1411
translate simplified_chinese ep015_sim_unaltered_f48ce53e:

    # "I tried to move, but felt ropes dig into my flesh."
    "我试图移动，但感觉到绳索深深嵌进我的皮肉。"

# game/episode015.rpy:1413
translate simplified_chinese ep015_sim_unaltered_ef258a85:

    # "Eva still lay motionless on the bed, while Lilly was humming in a corner, busy with something."
    "伊娃仍一动不动地躺在床上，而莉莉正在角落里哼着歌，忙着什么事。"

# game/episode015.rpy:1414
translate simplified_chinese ep015_sim_unaltered_ba0c563f:

    # "The shotgun was standing against the wall where Lilly was."
    "那把霰弹枪就靠在莉莉所在的墙边。"

# game/episode015.rpy:1417
translate simplified_chinese ep015_sim_unaltered_37657455:

    # "My sister whirled on me as I tried to move in vain."
    "当我徒劳地试图移动时，我妹妹猛地转向我。"

# game/episode015.rpy:1419
translate simplified_chinese ep015_sim_unaltered_9cc39e1e:

    # "Lilly whirled on me as I tried to move in vain."
    "当我徒劳地试图移动时，莉莉猛地转向我。"

# game/episode015.rpy:1421
translate simplified_chinese ep015_sim_unaltered_1ce2d09f:

    # l "Good, you're awake."
    l "很好，你醒了。"

# game/episode015.rpy:1423
translate simplified_chinese ep015_sim_unaltered_9824e440:

    # "Lilly held a scalpel as she advanced on me."
    "莉莉握着一把手术刀向我逼近。"

# game/episode015.rpy:1424
translate simplified_chinese ep015_sim_unaltered_a2d01dd1:

    # c "What are you doing with that knife?"
    c "你拿着那把刀想干什么？"

# game/episode015.rpy:1426
translate simplified_chinese ep015_sim_unaltered_6cd0a5a7:

    # l "Since the only thing you're telling me are lies, I'm going to ask this thing here."
    l "既然你告诉我的全是谎言，那我就来问问这个东西。"

# game/episode015.rpy:1427
translate simplified_chinese ep015_sim_unaltered_0c23bda0:

    # l "I'm not sure if it can feel pain, but I'm sure I'll make it talk."
    l "我不确定它是否能感受到疼痛，但我肯定能撬开它的嘴。"

# game/episode015.rpy:1428
translate simplified_chinese ep015_sim_unaltered_72573467:

    # c "Lilly, that's Eva you're talking about!"
    c "莉莉，你是在说伊娃啊！"

# game/episode015.rpy:1429
translate simplified_chinese ep015_sim_unaltered_b71256b4:

    # c "It's another version of her."
    c "那是她的另一个版本。"

# game/episode015.rpy:1430
translate simplified_chinese ep015_sim_unaltered_ad333e22:

    # l "Sure she is."
    l "她当然是。"

# game/episode015.rpy:1431
translate simplified_chinese ep015_sim_unaltered_a70ce456:

    # "Talking to Lilly didn't seem to work, so I had to try something else."
    "跟莉莉说话似乎不管用，我得试试别的办法。"

# game/episode015.rpy:1432
translate simplified_chinese ep015_sim_unaltered_505b982c:

    # "I had to stop her from harming Eva, because any pain or trauma inflicted in the simulation could have a serious and lasting effect on her."
    "我必须阻止她伤害伊娃，因为在模拟中遭受的任何痛苦或创伤都可能对她产生严重而持久的影响。"

# game/episode015.rpy:1433
translate simplified_chinese ep015_sim_unaltered_a0f20d62:

    # "I decided to keep Lilly talking."
    "我决定继续和莉莉交谈。"

# game/episode015.rpy:1435
translate simplified_chinese ep015_sim_unaltered_9ff0b2f8:

    # c "Wait, Lilly."
    c "等等，莉莉。"

# game/episode015.rpy:1436
translate simplified_chinese ep015_sim_unaltered_57b63e85:

    # c "I'll tell you everything."
    c "我会告诉你一切。"

# game/episode015.rpy:1437
translate simplified_chinese ep015_sim_unaltered_907581c1:

    # l "So you were lying?"
    l "所以你刚才是在撒谎？"

# game/episode015.rpy:1438
translate simplified_chinese ep015_sim_unaltered_568aee5d:

    # "Lilly seemed to be able to manipulate the simulation at will, as she'd produced that shotgun out of nowhere."
    "莉莉似乎能随意操控这个模拟场景，因为她凭空变出了那把霰弹枪。"

# game/episode015.rpy:1439
translate simplified_chinese ep015_sim_unaltered_4889ea05:

    # "The array of torture implements lying on a table beside the bed didn't belong to the regular inventory of the mansion either."
    "床上旁边桌子上摆放的一系列刑具也不属于庄园的常规物品。"

# game/episode015.rpy:1440
translate simplified_chinese ep015_sim_unaltered_149464db:

    # c "I can explain."
    c "我可以解释。"

# game/episode015.rpy:1442
translate simplified_chinese ep015_sim_unaltered_8143f8d3:

    # l "Well, explain..."
    l "那好，解释吧…"

# game/episode015.rpy:1443
translate simplified_chinese ep015_sim_unaltered_dd66222e:

    # c "You have to believe me when I say that the girl lying there on the bed is a real person."
    c "你得相信我，躺在床上的那个女孩是个真实存在的人。"

# game/episode015.rpy:1444
translate simplified_chinese ep015_sim_unaltered_903d2ee1:

    # l "So, who is she?"
    l "那么，她是谁？"

# game/episode015.rpy:1445
translate simplified_chinese ep015_sim_unaltered_b1decf3c:

    # "While I attempted to stall Lilly, I tried to focus on manipulating the simulation."
    "在我试图拖延莉莉的同时，我努力集中精力操控这个模拟场景。"

# game/episode015.rpy:1446
translate simplified_chinese ep015_sim_unaltered_a3f0dfed:

    # "If I could disappear my bonds and rush Lilly somehow, maybe that would give me a chance to rescue Eva."
    "如果我能让束缚消失并设法冲向莉莉，或许就有机会救出伊娃。"

# game/episode015.rpy:1448
translate simplified_chinese ep015_sim_unaltered_bf9d9335:

    # l "Why are you looking at me like that?"
    l "你为什么那样看着我？"

# game/episode015.rpy:1449
translate simplified_chinese ep015_sim_unaltered_75c4f55f:

    # l "Answer the question."
    l "回答这个问题。"

# game/episode015.rpy:1450
translate simplified_chinese ep015_sim_unaltered_81fa09c1:

    # l "Who is she?"
    l "她是谁？"

# game/episode015.rpy:1451
translate simplified_chinese ep015_sim_unaltered_172abdb1:

    # c "She's someone I love."
    c "她是我爱的人。"

# game/episode015.rpy:1453
translate simplified_chinese ep015_sim_unaltered_01562e61:

    # l "Oh fuck off, you're stalling me, aren't you?"
    l "哦，滚开，你在拖延时间，对吧？"

# game/episode015.rpy:1458
translate simplified_chinese ep015_sim_unaltered_1e802164:

    # "Lilly was about to turn her attention back to Eva when I managed to break down a barrier I didn't know previously existed."
    "就在莉莉即将把注意力转回伊娃时，我成功打破了一道先前不曾察觉的屏障。"

# game/episode015.rpy:1460
translate simplified_chinese ep015_sim_unaltered_14a90442:

    # "The ropes that bound me dropped to the floor and while jumping to my feet I managed to blast Lilly with a ball of energy."
    "束缚我的绳索掉落在地，我纵身跃起的同时向莉莉射出一团能量弹。"

# game/episode015.rpy:1463
translate simplified_chinese ep015_sim_unaltered_379fa23e:

    # "My surprised sister slammed against the wall and crumpled to the floor."
    "我那位惊讶的妹妹猛撞在墙上，瘫倒在地。"

# game/episode015.rpy:1465
translate simplified_chinese ep015_sim_unaltered_4243348f:

    # "A surprised Lilly slammed against the wall and crumpled to the floor."
    "惊讶的莉莉猛撞在墙上，瘫倒在地。"

# game/episode015.rpy:1467
translate simplified_chinese ep015_sim_unaltered_2daa9e49:

    # "Within seconds, I was at Eva's side and managed to take her on my arms."
    "几秒之内，我就来到伊娃身边，成功将她抱入怀中。"

# game/episode015.rpy:1469
translate simplified_chinese ep015_sim_unaltered_3092f5b8:

    # "Carrying her, I ran out into the hallway and descended the stairs."
    "我抱着她跑进走廊，冲下楼梯。"

# game/episode015.rpy:1470
translate simplified_chinese ep015_sim_unaltered_2e81f356:

    # "A familiar voice sounded in my head."
    "一个熟悉的声音在我脑海中响起。"

# game/episode015.rpy:1472
translate simplified_chinese ep015_sim_unaltered_592db994:

    # j "[p_name_short], are you alright?"
    j "[p_name_short]，你还好吗？"

# game/episode015.rpy:1473
translate simplified_chinese ep015_sim_unaltered_0f877e17:

    # c "I think so, but I don't know how much longer."
    c "我想是吧，但不知道还能撑多久。"

# game/episode015.rpy:1474
translate simplified_chinese ep015_sim_unaltered_40b831ff:

    # j "I'm trying to get you both out of here."
    j "我正在想办法把你们两个都救出去。"

# game/episode015.rpy:1475
translate simplified_chinese ep015_sim_unaltered_9f69f9a4:

    # j "Something seems to have changed just now."
    j "刚才好像有什么东西发生了变化。"

# game/episode015.rpy:1476
translate simplified_chinese ep015_sim_unaltered_0b3f46c5:

    # c "Yeah, I rescued Eva."
    c "嗯，我把伊娃救出来了。"

# game/episode015.rpy:1477
translate simplified_chinese ep015_sim_unaltered_0266f3e7:

    # c "Trying to get to safety now, somehow."
    c "现在正想办法逃到安全的地方。"

# game/episode015.rpy:1479
translate simplified_chinese ep015_sim_unaltered_bfaa3edb:

    # "As I reached the doors to the grounds of the estate, a terrifying scream pierced everything."
    "当我跑到庄园大门时，一声恐怖的尖叫穿透了一切。"

# game/episode015.rpy:1480
translate simplified_chinese ep015_sim_unaltered_df93da6c:

    # "Lilly was conscious again."
    "莉莉又清醒过来了。"

# game/episode015.rpy:1481
translate simplified_chinese ep015_sim_unaltered_0c58693f:

    # j "[p_name_short]...{w} It's...{w} getting harder...{w} to...{w} get through."
    j "[p_name_short]…{w} 越来越…{w} 难以…{w} 联系上了。"

# game/episode015.rpy:1483
translate simplified_chinese ep015_sim_unaltered_8b8e73f9:

    # "I hurried toward the formal gardens that had wilted and died in my absence."
    "我匆忙跑向那些在我离开期间已经枯萎凋零的规整花园。"

# game/episode015.rpy:1485
translate simplified_chinese ep015_sim_unaltered_b7f54d97:

    # "Taking refuge in the stone gazebo in the center of the gardens, I set Eva down against a low wall making up the foundation of the little building."
    "躲进花园中央的石亭里，我把伊娃放在构成这个小建筑地基的矮墙边。"

# game/episode015.rpy:1486
translate simplified_chinese ep015_sim_unaltered_d27ead90:

    # "Back near the house, I could hear Lilly yelling and screaming, but for some reason, she didn't approach the garden."
    "回到房子附近，我能听见莉莉在大喊大叫，但不知为何她没有靠近花园。"

# game/episode015.rpy:1487
translate simplified_chinese ep015_sim_unaltered_60a0d3d3:

    # "Jade's voice was coming through again, somewhat weaker than before."
    "杰德的声音再次传来，比之前微弱了些。"

# game/episode015.rpy:1488
translate simplified_chinese ep015_sim_unaltered_e1d381d7:

    # j "What's happening there, [p_name]?"
    j "那边发生什么了，[p_name]？"

# game/episode015.rpy:1489
translate simplified_chinese ep015_sim_unaltered_80db40ac:

    # j "Your signal got a lot weaker all of a sudden after we first spoke."
    j "我们第一次通话后你的信号突然弱了很多。"

# game/episode015.rpy:1490
translate simplified_chinese ep015_sim_unaltered_fc15ffaa:

    # c "I know, I managed to disable the threat for a short time."
    c "我知道，我暂时设法解除了威胁。"

# game/episode015.rpy:1491
translate simplified_chinese ep015_sim_unaltered_5fbf6e3c:

    # c "Can you pull us out safely?"
    c "你能安全把我们救出去吗？"

# game/episode015.rpy:1492
translate simplified_chinese ep015_sim_unaltered_fe1e477c:

    # j "Almost."
    j "快了。"

# game/episode015.rpy:1494
translate simplified_chinese ep015_sim_unaltered_08a46f07:

    # "Eva stirred slightly."
    "伊娃微微动了动。"

# game/episode015.rpy:1495
translate simplified_chinese ep015_sim_unaltered_31f1249c:

    # e "[p_name]?"
    e "[p_name]?"

# game/episode015.rpy:1496
translate simplified_chinese ep015_sim_unaltered_3c8dd7f5:

    # e "What's happening?{w} Lilly...{w} she..."
    e "发生什么事了？{w}莉莉…{w}她…"

# game/episode015.rpy:1497
translate simplified_chinese ep015_sim_unaltered_41934fef:

    # c "Don't exert yourself, everything will be alright soon."
    c "别勉强自己，很快一切都会好起来的。"

# game/episode015.rpy:1498
translate simplified_chinese ep015_sim_unaltered_549312b4:

    # j "I now have a fix on Eva as well."
    j "我现在也锁定伊娃的位置了。"

# game/episode015.rpy:1499
translate simplified_chinese ep015_sim_unaltered_85ca269d:

    # j "I can pull you out in a few seconds."
    j "几秒钟后就能把你们传送出来。"

# game/episode015.rpy:1507
translate simplified_chinese ep015_sim_exit_choices_3bb6b466:

    # c "Wait, Jade."
    c "等等，杰德。"

# game/episode015.rpy:1508
translate simplified_chinese ep015_sim_exit_choices_e9f1bee3:

    # c "Can you access the avatars currently active in the simulation?"
    c "你能访问当前模拟中活跃的虚拟化身吗？"

# game/episode015.rpy:1511
translate simplified_chinese ep015_sim_exit_choices_1ddb2b2f:

    # j "Eva and Lilly you mean?"
    j "你是指伊娃和莉莉？"

# game/episode015.rpy:1512
translate simplified_chinese ep015_sim_exit_choices_ee6b18b5:

    # j "Yes, I can."
    j "是的，可以。"

# game/episode015.rpy:1513
translate simplified_chinese ep015_sim_exit_choices_139c6bba:

    # c "Good."
    c "很好。"

# game/episode015.rpy:1514
translate simplified_chinese ep015_sim_exit_choices_b6ee9149:

    # c "Can you give me editorial access to their personality traits?"
    c "能否给我对她们人格特质的编辑权限？"

# game/episode015.rpy:1515
translate simplified_chinese ep015_sim_exit_choices_6ca3e9e6:

    # j "I...{w} Is that wise, [p_name]?"
    j "我…{w} 这明智吗，[p_name]？"

# game/episode015.rpy:1517
translate simplified_chinese ep015_sim_exit_choices_caab55b7:

    # c "Give me access."
    c "给我权限。"

# game/episode015.rpy:1519
translate simplified_chinese ep015_sim_exit_choices_8e00c8eb:

    # c "Please, Jade, I need to fix this."
    c "拜托了杰德，我必须修正这个。"

# game/episode015.rpy:1520
translate simplified_chinese ep015_sim_exit_choices_c6c719f4:

    # j "Very well, you should have access."
    j "好吧，你现在应该拥有权限了。"

# game/episode015.rpy:1522
translate simplified_chinese ep015_sim_exit_choices_4f535597:

    # "A tablet appeared in my hand, showing the various parameters of Eva and Lilly."
    "一块平板出现在我手中，显示着伊娃和莉莉的各项参数。"

# game/episode015.rpy:1524
translate simplified_chinese ep015_sim_exit_choices_2ef7fefe:

    # "Dust rained down from the ceiling of the gazebo as a terrible explosion shook the estate."
    "凉亭的天花板落下灰尘，可怕的爆炸震动了庄园。"

# game/episode015.rpy:1525
translate simplified_chinese ep015_sim_exit_choices_9a484da1:

    # j "What's happening over there, [p_name]?"
    j "那边发生什么事了，[p_name]？"

# game/episode015.rpy:1527
translate simplified_chinese ep015_sim_exit_choices_c7693830:

    # "Too engrossed in changing the personality parameters, I didn't answer Jade."
    "我太过专注于修改人格参数，没有回答杰德。"

# game/episode015.rpy:1529
translate simplified_chinese ep015_sim_exit_choices_9196a277:

