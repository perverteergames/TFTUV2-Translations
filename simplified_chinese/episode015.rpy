translate simplified_chinese ep015_sim_post_741c3376:

    # c "I hope you can forgive me."
    c "我希望你能原谅我。"

# game/episode015.rpy:1799
translate simplified_chinese ep015_sim_post_78833d86:

    # e "I can and I have."
    e "我能原谅，而且我已经原谅了。"

# game/episode015.rpy:1801
translate simplified_chinese ep015_sim_post_29756d3b:

    # e "But I hope you’ll never do something like that again."
    e "但我希望你永远不要再做那样的事了。"

# game/episode015.rpy:1802
translate simplified_chinese ep015_sim_post_b409030b:

    # c "I promise I won’t."
    c "我保证不会了。"

# game/episode015.rpy:1803
translate simplified_chinese ep015_sim_post_23dde8eb:

    # e "I’m happy to hear that."
    e "很高兴听你这么说。"

# game/episode015.rpy:1805
translate simplified_chinese ep015_sim_post_4f2ad2dc:

    # e "[p_name_short]?"
    e "[p_name_short]?"

# game/episode015.rpy:1806
translate simplified_chinese ep015_sim_post_24c7ada5:

    # c "Yes?"
    c "嗯？"

# game/episode015.rpy:1807
