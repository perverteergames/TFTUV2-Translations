# game/episode016.rpy:25
translate simplified_chinese episode016_876d0c3c:

    # centered "{=chapter_heading}EPISODE 16{/=chapter_heading}"
    centered "{=chapter_heading}第16集{/=chapter_heading}"

# game/episode016.rpy:34
translate simplified_chinese episode016_29f39fe6:

    # "It turned out that several Council members were waiting for us at the docks."
    "原来有几位议员正在码头等着我们。"

# game/episode016.rpy:35
translate simplified_chinese episode016_fc404b17:

    # "Arlya was among them and she didn’t look too happy about the audience."
    "阿尔雅也在其中，而且她似乎对这次会面不太高兴。"

# game/episode016.rpy:37
translate simplified_chinese episode016_215cd794:

    # woman "We would like to welcome you back, [p_name] of the Iron Bastard."
    woman "我们想欢迎您归来，\"钢铁私生子\"号的[p_name]。"

# game/episode016.rpy:38
translate simplified_chinese episode016_26798331:

    # woman "Once we learned of your mission, we decided to meet you in person."
    woman "得知您的任务后，我们决定亲自来见您。"

# game/episode016.rpy:39
translate simplified_chinese episode016_8273605f:

    # woman "I see you have brought Nkoy Rhedia with you?"
    woman "我看到您把伦科伊·瑞迪亚带来了？"

# game/episode016.rpy:40
translate simplified_chinese episode016_e3865eb0:

    # c "I did, she wishes to address the Council."
    c "是的，她希望向议会发表讲话。"

# game/episode016.rpy:42
translate simplified_chinese episode016_258f3b3a:

    # arl "Nkoy Rhedia is a terrorist and a traitor, she should be tried in a court of law, not given the opportunity to hold speeches."
    arl "伦科伊·瑞迪亚是恐怖分子和叛徒，她应该在法庭上受审，而不是获得发表演讲的机会。"

# game/episode016.rpy:43
translate simplified_chinese episode016_cb69dd09:

    # woman "We have discussed this matter thoroughly and a majority of the Council is of the opinion that the voice Nkoy Rhedia should be heard."
    woman "我们已经彻底讨论过此事，议会多数意见认为应该听取伦科伊·瑞迪亚的声音。"

# game/episode016.rpy:44
translate simplified_chinese episode016_476d7751:

    # woman "So far your assertion that Nkoy Rhedia would force her way to the Council chambers by lethal force hasn’t come to pass."
    woman "到目前为止，您关于伦科伊·瑞迪亚会通过致命武力强行闯入议会议事厅的断言并未成真。"

# game/episode016.rpy:46
translate simplified_chinese episode016_1817efbd:

    # woman2 "And to think we were to greet her with a company of armed operatives."
    woman2 "想想我们原本还准备带一队武装人员去迎接她。"

# game/episode016.rpy:47
translate simplified_chinese episode016_862a650f:

    # woman2 "This is disappointing to say the least."
    woman2 "至少可以说这很令人失望。"

# game/episode016.rpy:48
translate simplified_chinese episode016_4ece2ca4:

    # c "Do you think it’s safe to hand you over, Rhedia?"
    c "你觉得把你交出去安全吗，瑞迪亚？"

# game/episode016.rpy:50
translate simplified_chinese episode016_31560102:

    # rh "Yes, I think I’ll be quite safe."
    rh "是的，我想我会很安全的。"

# game/episode016.rpy:52
translate simplified_chinese episode016_43ab66b6:

    # zi "Would I be allowed to come with you?"
    zi "我能跟你一起去吗？"

# game/episode016.rpy:54
translate simplified_chinese episode016_444750f0:

    # woman "Yes, we’ll permit you to be a witness to this Council session."
    woman "可以，我们允许你作为本次议会会议的见证人。"

# game/episode016.rpy:57
translate simplified_chinese episode016_3053a585:

    # "Ziv looked at me expectantly."
    "基芙期待地看着我。"

# game/episode016.rpy:58
translate simplified_chinese episode016_39a1149f:

    # c "Yes, do go, please."
    c "是的，请去吧。"

# game/episode016.rpy:60
translate simplified_chinese episode016_318fcd88:

    # zi "I’ll let you know how it went."
    zi "我会告诉你会议进展的。"

# game/episode016.rpy:63
translate simplified_chinese episode016_77d04f08:

    # zi "Do I have permission to join this Council session?"
    zi "我能否获准参加本次议会会议？"

# game/episode016.rpy:64
translate simplified_chinese episode016_41384cdc:

    # c "Of course, permission granted."
    c "当然，允许加入。"

# game/episode016.rpy:65
translate simplified_chinese episode016_50256e2d:

    # c "I do expect a full report once the session is over."
    c "会议结束后，我确实期待一份完整的报告。"

# game/episode016.rpy:67
translate simplified_chinese episode016_b37c7739:

    # woman "The quarters that were assigned to you are at your disposal for the duration of your stay."
    woman "分配给你们的住所将在逗留期间随时可供使用。"

# game/episode016.rpy:68
translate simplified_chinese episode016_933dcc29:

    # woman "We will take our leave now."
    woman "我们现在就告辞了。"

# game/episode016.rpy:71
translate simplified_chinese episode016_6c3da213:

    # "Nkoy Arlya was indeed waiting for us to hand over Rhedia, along with a contingent of soldiers."
    "伦科伊·阿尔雅确实在等我们将瑞迪亚移交，还带着一队士兵。"

# game/episode016.rpy:73
translate simplified_chinese episode016_837b42f6:

    # arl "I’m happy to see you return."
    arl "很高兴看到你回来。"

# game/episode016.rpy:74
translate simplified_chinese episode016_589955c0:

    # arl "I trust your mission went as planned."
    arl "我相信你们的任务按计划完成了。"

# game/episode016.rpy:75
translate simplified_chinese episode016_183bbe39:

    # c "It did."
    c "是的。"

# game/episode016.rpy:77
translate simplified_chinese episode016_b069e9d8:

    # arl "Good."
    arl "很好。"

# game/episode016.rpy:78
translate simplified_chinese episode016_2fb3edc3:

    # arl "If you’d be so kind as to release her into my custody."
    arl "如果你们愿意把她交给我监管。"

# game/episode016.rpy:79
translate simplified_chinese episode016_661cdb02:

    # c "I will, but be sure to remember our deal."
    c "我会的，但务必记住我们的约定。"

# game/episode016.rpy:81
translate simplified_chinese episode016_8c6ce838:

    # arl "I do remember, access to the Scolguin prisoners has been arranged."
    arl "我记得，探访斯科尔金囚犯的许可已经安排好了。"

# game/episode016.rpy:82
translate simplified_chinese episode016_e9e27cda:

    # c "Much obliged."
    c "不胜感激。"

# game/episode016.rpy:84
translate simplified_chinese episode016_49ce6b47:

    # "Rhedia walked out of the ship and was immediately escorted by the soldiers brought by Arlya."
    "瑞迪亚走出飞船，立即被阿尔雅带来的士兵护送离开。"

# game/episode016.rpy:85
translate simplified_chinese episode016_69bd71c3:

    # "The two women didn’t as much acknowledge each other in passing."
    "两位女性在擦肩而过时甚至没有互相致意。"

# game/episode016.rpy:86
translate simplified_chinese episode016_89cc8238:

    # c "What will happen to her?"
    c "她会怎么样？"

# game/episode016.rpy:88
translate simplified_chinese episode016_54d996b1:

    # arl "I’m sure that’s none of your business."
    arl "我相信这不关你的事。"

# game/episode016.rpy:89
translate simplified_chinese episode016_31c0e6b0:

    # arl "Rest assured, she’ll be kept safely away from harm."
    arl "请放心，她会远离伤害，得到妥善保护。"

# game/episode016.rpy:90
translate simplified_chinese episode016_3aaad121:

    # "I couldn’t say I was very assured about anything, but I wasn’t in a position to do anything about it."
    "我不能说我对任何事情都很放心，但我对此无能为力。"

# game/episode016.rpy:91
translate simplified_chinese episode016_623c7c41:

    # arl "The paperwork for your visit to the penitentiary facility will be processed in a few days, you’re free to use the quarters provided for you here."
    arl "探视监狱设施的相关文件将在几天内处理完毕，在此期间你可以自由使用这里为你提供的住所。"

# game/episode016.rpy:92
translate simplified_chinese episode016_c070b8af:

    # arl "The Council of Nkoy thanks you for your services."
    arl "伦科伊议会感谢您的服务。"

# game/episode016.rpy:94
translate simplified_chinese episode016_a310baa4:

    # "With that, Arlya joined the group of soldiers escorting Rhedia out of the docks."
    "说完，阿尔雅加入了护送瑞迪亚离开码头的士兵队伍。"

# game/episode016.rpy:105
translate simplified_chinese episode016_eff9d5f1:

    # "It looked like we had some time to kill before we were allowed access to the Scolguin prisoners."
    "看来在我们获准接触斯科尔金囚犯之前，还有些时间要打发。"

# game/episode016.rpy:115
translate simplified_chinese episode016_df75fe75:

    # "Ziv returned after several hours."
    "几小时后，基芙回来了。"

# game/episode016.rpy:116
translate simplified_chinese episode016_7e72a4aa:

    # c "How did it go?"
    c "情况如何？"

# game/episode016.rpy:118
translate simplified_chinese episode016_de0ac9fb:

    # zi "As well as can be expected."
    zi "如预期般顺利。"

# game/episode016.rpy:119
translate simplified_chinese episode016_64da7a27:

    # zi "Nkoy Rhedia was allowed to speak freely and did so for a long time."
    zi "伦科伊·瑞迪亚被允许自由发言，并且说了很长时间。"

# game/episode016.rpy:120
translate simplified_chinese episode016_050a2b5b:

    # zi "Arlya kept interrupting her and attempted to paint her in the most negative light imaginable."
    zi "阿尔雅不停地打断她，试图把她描绘成最不堪的形象。"

# game/episode016.rpy:122
translate simplified_chinese episode016_c55f5e27:

    # zi "Most of her allegations fell apart though, after two Council members revealed they had enacted a secret investigation into the shooting at Rhedia’s compound."
    zi "不过她的大部分指控都站不住脚，因为有两位议员透露他们已对瑞迪亚庄园的枪击事件展开了秘密调查。"

# game/episode016.rpy:123
translate simplified_chinese episode016_dab5476b:

    # zi "It’s safe to say that the results of the investigation appalled many of the Council, as they made Arlya look really bad."
    zi "可以肯定的是，调查结果令许多议员感到震惊，因为这些结果让阿尔雅显得非常不堪。"

# game/episode016.rpy:124
translate simplified_chinese episode016_ea48c8ec:

    # zi "In the end, Rhedia’s fate was put to a vote."
    zi "最终，瑞迪亚的命运被付诸表决。"

# game/episode016.rpy:126
translate simplified_chinese episode016_80ca75d7:

    # zi "It was close, but she won’t be persecuted for any of the events that happened."
    zi "票数很接近，但她不会因发生的任何事件而受到迫害。"

# game/episode016.rpy:127
translate simplified_chinese episode016_d3903b18:

    # zi "She’s allowed to return to the capital and represent her faction on the Council."
    zi "她被允许返回首都，并在议会中代表她的派系。"

# game/episode016.rpy:128
translate simplified_chinese episode016_ab7d0f8f:

    # c "That sounds like a solid win."
    c "听起来是个稳固的胜利。"

# game/episode016.rpy:130
translate simplified_chinese episode016_c77cffa0:

    # zi "It is."
    zi "确实如此。"

# game/episode016.rpy:131
translate simplified_chinese episode016_83c71501:

    # zi "But I wouldn’t count out Arlya, she’s sure to have some other irons in the fire."
    zi "但我不会小看阿尔雅，她肯定还有其他计划在酝酿中。"

# game/episode016.rpy:132
translate simplified_chinese episode016_a1cc64ca:

    # zi "Nkoy Rhedia is going to push for a thorough investigation into the finances of the various Council members and their ties to any political groups, off-world or otherwise."
    zi "伦科伊·瑞迪亚将推动对各位议会成员的财务状况及其与任何政治团体(无论是否来自外星)的联系进行全面调查。"

# game/episode016.rpy:133
translate simplified_chinese episode016_1f8e0fce:

    # zi "If that investigation is allowed to continue, things won’t look as rosy for Arlya as they once did."
    zi "如果这项调查被允许继续下去，阿尔雅的前景就不会像从前那样美好了。"

# game/episode016.rpy:134
translate simplified_chinese episode016_6e581426:

    # c "So it’s going to be a long process before that conniving bitch is out for good?"
    c "所以那个诡计多端的婊子要彻底出局还需要很长时间？"

# game/episode016.rpy:136
translate simplified_chinese episode016_3b46c3e4:

    # zi "Yes, but that’s the way it goes in politics."
    zi "是的，但政治就是这样运作的。"

# game/episode016.rpy:137
translate simplified_chinese episode016_053832f0:

    # c "It seems so."
    c "看来是这样。"

# game/episode016.rpy:138
translate simplified_chinese episode016_c992508d:

    # c "A full-on rebellion was a little too much to hope for."
    c "指望爆发全面叛乱有点太奢望了。"

# game/episode016.rpy:140
translate simplified_chinese episode016_8e2a3d3b:

    # zi "That is not our way and this shouldn’t be resolved by any more bloodshed."
    zi "那不是我们的作风，这件事不该再用更多流血来解决了。"

# game/episode016.rpy:150
translate simplified_chinese episode016_2946b99d:

    # c "Any news on our meet and greet with the Scolguin?"
    c "关于我们与斯科尔金人的会面有什么新消息吗？"

# game/episode016.rpy:151
translate simplified_chinese episode016_efb0fd98:

    # zi "Nkoy Rhedia has promised to file a request."
    zi "伦科伊·瑞迪亚已经承诺会提交申请。"

# game/episode016.rpy:152
translate simplified_chinese episode016_e6500ab6:

    # zi "As soon as she hears more, she’ll contact us."
    zi "她一有消息就会联系我们。"

# game/episode016.rpy:153
translate simplified_chinese episode016_1f9bd1b1:

    # c "That means we’ll have to spend a few days here?"
    c "这意味着我们得在这里待上几天？"

# game/episode016.rpy:154
translate simplified_chinese episode016_eca89b99:

    # zi "Looks like it."
    zi "看起来是的。"

# game/episode016.rpy:157
translate simplified_chinese episode016_9de54002:

    # zi "But that doesn’t have to be a bad thing, you know..."
    zi "但这未必是坏事，你知道的…"

# game/episode016.rpy:158
translate simplified_chinese episode016_bd1840d4:

    # c "I like where this is going already."
    c "我已经猜到接下来要说什么了。"

# game/episode016.rpy:160
translate simplified_chinese episode016_21d9b223:

    # "We continued our stay on Uailea much the same way as before, waiting for word of Nkoy Rhedia to arrive."
    "我们继续像之前一样在瓦莱亚停留，等待伦科伊·瑞迪亚的消息。"

# game/episode016.rpy:163
translate simplified_chinese episode016_93cbb265:

    # "We returned to the Iron Bastard and waited for word of Nkoy Rhedia to arrive."
    "我们返回了\"钢铁私生子\"号，等待伦科伊·瑞迪亚的消息。"

# game/episode016.rpy:178
translate simplified_chinese episode016_4621778a:

    # "Rhedia sent us a message after nearly a week."
    "将近一周后，瑞迪亚给我们发来了信息。"

# game/episode016.rpy:179
translate simplified_chinese episode016_c935d1a1:

    # "A transport was waiting for us to take us to the facility where the Scolguin were held."
    "有艘运输船正等着带我们去关押斯科尔金人的设施。"

# game/episode016.rpy:180
translate simplified_chinese episode016_53e05ee6:

    # "She also requested us to leave Uailea immediately after our business was concluded."
    "她还要求我们在事务结束后立即离开瓦莱亚。"

# game/episode016.rpy:181
translate simplified_chinese episode016_ab41e666:

    # "There was no concrete threat in the message, but reading between the lines it was clear that she would make our life as difficult as possible for us if we decided to stay any longer."
    "信息中没有明确的威胁，但从字里行间可以清楚地看出，如果我们决定继续逗留，她会尽可能给我们制造麻烦。"

# game/episode016.rpy:182
translate simplified_chinese episode016_d0164464:

    # "I guess the events surrounding her capture had earned us a personal grudge..."
    "我想围绕她被捕的事件让我们结下了私人恩怨…"

# game/episode016.rpy:186
translate simplified_chinese episode016_35c1839e:

    # "Rhedia visited us after nearly a week with good news."
    "将近一周后，瑞迪亚带着好消息来拜访我们。"

# game/episode016.rpy:188
translate simplified_chinese episode016_13821489:

    # "Rhedia visited us at the apartment after nearly a week with good news."
    "将近一周后，瑞迪亚带着好消息来到公寓拜访我们。"

# game/episode016.rpy:190
translate simplified_chinese episode016_511f31ad:

    # rh "My request to allow you access to the Scolguin prisoners has been granted."
    rh "我请求允许你们接触斯科尔金囚犯的申请已经获得批准。"

# game/episode016.rpy:191
translate simplified_chinese episode016_f296b45d:

    # rh "A transport is waiting for you to take you to the facility where they’re held."
    rh "一艘运输船正等着带你们去关押他们的设施。"

# game/episode016.rpy:193
translate simplified_chinese episode016_897f772c:

    # rh "I must thank you for the service you’ve provided to the Rhenkoy people."
    rh "我必须感谢你为伦科伊人民提供的服务。"

# game/episode016.rpy:194
translate simplified_chinese episode016_a88e0b46:

    # rh "I’m confident we can overcome the hardships that are currently threatening our society."
    rh "我相信我们能克服当前威胁我们社会的困境。"

# game/episode016.rpy:195
translate simplified_chinese episode016_692cea81:

    # c "I sincerely hope so too, but Arlya seems like a formidable opponent."
    c "我也真诚希望如此，但阿尔雅似乎是个可怕的对手。"

# game/episode016.rpy:197
translate simplified_chinese episode016_7b33e56d:

    # rh "She is, but the recent events have certainly damaged her, she’s not as politically strong as she once was."
    rh "她确实是，但最近的事件肯定削弱了她，她的政治实力已不如从前。"

# game/episode016.rpy:198
translate simplified_chinese episode016_67c7b2f0:

    # rh "I do hope you’ll visit us again, once you’ve concluded your business."
    rh "我真心希望你们办完事后能再来拜访我们。"

# game/episode016.rpy:199
translate simplified_chinese episode016_62a8c936:

    # c "Thank you for your help."
    c "感谢你的帮助。"

# game/episode016.rpy:201
translate simplified_chinese episode016_ff061404:

    # rh "You’re welcome."
    rh "不客气。"

# game/episode016.rpy:203
translate simplified_chinese episode016_64fd8f5e:

    # "After Rhedia left, we headed back to the Iron Bastard to gather the necessary crew."
    "瑞迪亚离开后，我们回到\"钢铁私生子\"号召集必要的人员。"

# game/episode016.rpy:217
translate simplified_chinese episode016_4ced2b5e:

    # "Soldiers arrived after nearly a week, telling us that a transport was ready to take us to the facility the Scolguin were held."
    "将近一周后士兵们才来，告诉我们有艘运输船准备带我们去关押斯科尔金人的设施。"

# game/episode016.rpy:219
translate simplified_chinese episode016_5cfb9b61:

    # "We headed back to the Iron Bastard to gather the necessary crew."
    "我们返回\"钢铁私生子\"号集合必要的船员。"

# game/episode016.rpy:239
translate simplified_chinese ep016_prison_52256f35:

    # "The holding facility was far removed from Uailea’s capital."
    "拘留设施距离瓦莱亚的首都相当遥远。"

# game/episode016.rpy:240
translate simplified_chinese ep016_prison_5083a257:

    # "The personnel on the transport weren’t very talkative, so we killed time watching the landscape outside."
    "运输船上的人员都不太爱说话，所以我们只能看着窗外的景色打发时间。"

# game/episode016.rpy:242
translate simplified_chinese ep016_prison_37eefca3:

    # "After two hours, the aircraft landed on a pad inside a walled compound."
    "两小时后，飞行器降落在围墙环绕的场地内一处停机坪上。"

# game/episode016.rpy:243
translate simplified_chinese ep016_prison_6e5e7976:

    # "Like the other buildings on Uailea, the holding facility didn’t resemble an archetypical prison."
    "和瓦莱亚的其他建筑一样，这座拘留设施看起来并不像典型监狱。"

# game/episode016.rpy:245
translate simplified_chinese ep016_prison_d1469775:

    # "Two guards from the facility approached the landing pad."
    "两名来自设施的守卫走近停机坪。"

# game/episode016.rpy:247
translate simplified_chinese ep016_prison_cf0f7b73:

    # woman "You’re the visitors?"
    woman "你们就是访客？"

# game/episode016.rpy:248
translate simplified_chinese ep016_prison_4825741a:

    # c "We are."
    c "是的。"

# game/episode016.rpy:249
translate simplified_chinese ep016_prison_6d185014:

    # woman "The Scolguin aren’t normally allowed visitors, so the order must have come from up high."
    woman "斯科尔金通常不允许访客探视，所以这命令一定来自高层。"

# game/episode016.rpy:250
translate simplified_chinese ep016_prison_871d0075:

    # c "The Council authorized it."
    c "议会批准的。"

# game/episode016.rpy:251
translate simplified_chinese ep016_prison_4fab90dd:

    # woman "I see."
    woman "我明白了。"

# game/episode016.rpy:252
translate simplified_chinese ep016_prison_be0f9327:

    # woman "Well, if you’ll accompany me."
    woman "好的，请随我来。"

# game/episode016.rpy:254
translate simplified_chinese ep016_prison_97f9eff8:

    # "The guards took us inside where we got a clear view of the facilities."
    "守卫带我们进去，我们得以清楚地看到设施内部。"

# game/episode016.rpy:256
translate simplified_chinese ep016_prison_30ff1830:

    # "We were led past what must have been several separate cells."
    "我们被领着经过了可能是几个独立牢房的地方。"

# game/episode016.rpy:257
translate simplified_chinese ep016_prison_4053c806:

    # "A reinforced metal door formed the only entrance to the cubicles."
    "加固金属门是这些隔间唯一的入口。"

# game/episode016.rpy:259
translate simplified_chinese ep016_prison_7f950321:

    # "No windows, whatsoever."
    "没有任何窗户。"

# game/episode016.rpy:260
translate simplified_chinese ep016_prison_786bad2b:

    # "The open Rhenkoy architecture which allowed for lots of natural light to come through the windows seemed to be a privilege forbidden to the prisoners."
    "能让大量自然光透过窗户的开放式伦科伊建筑风格，似乎是囚犯们被禁止享有的特权。"

# game/episode016.rpy:262
translate simplified_chinese ep016_prison_f9a078e9:

    # woman "The inmates are all in separate cells."
    woman "所有囚犯都关在单独的牢房里。"

# game/episode016.rpy:263
translate simplified_chinese ep016_prison_f76a126e:

    # woman "Are you to interrogate all of the Scolguin prisoners we have here currently?"
    woman "您要审问我们这里目前关押的所有斯科尔金囚犯吗？"

# game/episode016.rpy:264
translate simplified_chinese ep016_prison_615e0185:

    # c "Let’s start with one first."
    c "我们从一个开始吧。"

# game/episode016.rpy:265
translate simplified_chinese ep016_prison_f5e6c580:

    # c "Preferably the highest ranking."
    c "最好是级别最高的那个。"

# game/episode016.rpy:266
translate simplified_chinese ep016_prison_b4be29a9:

    # woman "Understood."
    woman "明白。"

# game/episode016.rpy:267
translate simplified_chinese ep016_prison_089bacd5:

    # "The woman stopped before one of the identical cells."
    "那个女人在其中一间相同的牢房前停下。"

# game/episode016.rpy:269
translate simplified_chinese ep016_prison_5a6e10eb:

    # woman "This unit houses the leader of the infiltration unit."
    woman "这个单元关押着渗透小队的首领。"

# game/episode016.rpy:270
translate simplified_chinese ep016_prison_16e69548:

    # woman "Only one other person is allowed inside the cell at all times."
    woman "任何时候只允许一人进入牢房。"

# game/episode016.rpy:271
translate simplified_chinese ep016_prison_83c045ba:

    # c "So I’ll be alone with the prisoner?"
    c "所以我要单独与囚犯相处？"

# game/episode016.rpy:272
translate simplified_chinese ep016_prison_4d42fa27:

    # woman "Yes, you will."
    woman "是的。"

# game/episode016.rpy:273
translate simplified_chinese ep016_prison_642aae34:

    # c "There’s video surveillance in the cell at least?"
    c "至少牢房里有视频监控吧？"

# game/episode016.rpy:274
translate simplified_chinese ep016_prison_3c7134db:

    # woman "No, that’s not necessary."
    woman "不，没这个必要。"

# game/episode016.rpy:275
translate simplified_chinese ep016_prison_8406d765:

    # woman "We allow our prisoners a certain privacy."
    woman "我们允许囚犯保留一定的隐私。"

# game/episode016.rpy:276
translate simplified_chinese ep016_prison_4581f139:

    # ki "How do you ensure they don’t harm themselves?"
    ki "你们如何确保他们不自残？"

# game/episode016.rpy:278
translate simplified_chinese ep016_prison_a1663295:

    # woman "Each prisoner has a chip embedded inside them."
    woman "每个囚犯体内都植入了芯片。"

# game/episode016.rpy:279
translate simplified_chinese ep016_prison_0e76cf01:

    # woman "We closely monitor vitals and emotional disturbances."
    woman "我们会密切监控生命体征和情绪波动。"

# game/episode016.rpy:280
translate simplified_chinese ep016_prison_685f6c4d:

    # na "And that’s enough?"
    na "这样足够了吗？"

# game/episode016.rpy:281
translate simplified_chinese ep016_prison_6a9c1a52:

    # woman "Yes, we only intervene when necessary."
    woman "是的，我们只在必要时才干预。"

# game/episode016.rpy:282
translate simplified_chinese ep016_prison_df13be76:

    # woman "So far we have a mortality rate of zero."
    woman "到目前为止我们的死亡率是零。"

# game/episode016.rpy:283
translate simplified_chinese ep016_prison_42be5669:

    # c "Impressive system in that case."
    c "这样的话，这个系统令人印象深刻。"

# game/episode016.rpy:285
translate simplified_chinese ep016_prison_67c1ad44:

    # woman "We like to think so."
    woman "我们也是这么认为的。"

# game/episode016.rpy:286
translate simplified_chinese ep016_prison_8ebf4249:

    # woman "Are you ready?"
    woman "准备好了吗？"

# game/episode016.rpy:287
translate simplified_chinese ep016_prison_b63d6bf3:

    # c "I am."
    c "准备好了。"

# game/episode016.rpy:289
translate simplified_chinese ep016_prison_97a74530:

    # woman "Very well, stand aside."
    woman "很好，请让开。"

# game/episode016.rpy:291
translate simplified_chinese ep016_prison_f2835e57:

    # "The guard opened the dimly lit cell which seemed completely empty."
    "守卫打开了光线昏暗的牢房，里面似乎空无一物。"

# game/episode016.rpy:293
translate simplified_chinese ep016_prison_100bc55f:

    # woman "Step inside please."
    woman "请进。"

# game/episode016.rpy:294
translate simplified_chinese ep016_prison_cd883530:

    # woman "This is just an antechamber, once I close the outer door, the inner door will open."
    woman "这只是个前厅，等我关上外门后，内门就会打开。"

# game/episode016.rpy:296
translate simplified_chinese ep016_prison_cc68a8cf:

    # "I entered the cell and waited for the door to close."
    "我走进牢房，等待门关上。"

# game/episode016.rpy:298
translate simplified_chinese ep016_prison_cef3aa88:

    # "The cell door closed with a hiss and the inner door slid open to reveal the prisoner."
    "牢房门嘶嘶作响地关上，内门滑开，露出了囚犯。"

# game/episode016.rpy:299
translate simplified_chinese ep016_prison_d45eb29c:

    # "I wasn’t quite prepared for what I saw."
    "我完全没有准备好面对眼前所见。"

# game/episode016.rpy:300
translate simplified_chinese ep016_prison_cab5397a:

    # "A snakelike form stood in front of me, parts of it glowing in the scarce light of the prison cell."
    "一个蛇形的身影站在我面前，部分身体在牢房稀疏的光线下发出微光。"

# game/episode016.rpy:302
translate simplified_chinese ep016_prison_fec0d5b9:

    # "The alien looked vaguely human and had pronounced breasts and soft facial curves."
    "这个外星人隐约有人形，有着明显的乳房和柔和的面部曲线。"

# game/episode016.rpy:303
translate simplified_chinese ep016_prison_c8f1393f:

    # "I wasn’t sure if the Scolguin even had a concept of sex or gender."
    "我不确定斯科尔金人是否也有性别的概念。"

# game/episode016.rpy:304
translate simplified_chinese ep016_prison_801c367a:

    # "Glowing strands sprouted from the creature’s head giving the impression of a hairpiece."
    "发光的发丝从这生物头上冒出，给人一种假发的感觉。"

# game/episode016.rpy:306
translate simplified_chinese ep016_prison_51099d1c:

    # "The Scolguin rose and fixed its eyes upon me."
    "斯科尔金人站起身，将目光锁定在我身上。"

# game/episode016.rpy:308
translate simplified_chinese ep016_prison_0c397c14:

    # xa "A visitor."
    xa "一位访客。"

# game/episode016.rpy:309
translate simplified_chinese ep016_prison_26eefe0a:

    # c "Yes."
    c "是的。"

# game/episode016.rpy:310
translate simplified_chinese ep016_prison_4c1981ca:

    # c "Do you have a name?"
    c "你有名字吗？"

# game/episode016.rpy:312
translate simplified_chinese ep016_prison_df4f29e8:

    # xa "You may call me Xatrape."
    xa "你可以叫我萨特拉普。"

# game/episode016.rpy:314
translate simplified_chinese ep016_prison_e745f0d2:

    # c "You were part of the Scolguin incursion of Uailea."
    c "你曾参与斯科尔金人对瓦莱亚的入侵行动。"

# game/episode016.rpy:316
translate simplified_chinese ep016_prison_7ebf8653:

    # xa "Don’t you have a name?"
    xa "难道你没有名字吗？"

# game/episode016.rpy:317
translate simplified_chinese ep016_prison_24e9fdab:

    # c "Please answer the question."
    c "请回答问题。"

# game/episode016.rpy:319
translate simplified_chinese ep016_prison_568c8cfd:

    # xa "Why ask me something you already know."
    xa "为什么要问我你已经知道的事。"

# game/episode016.rpy:320
translate simplified_chinese ep016_prison_0781896e:

    # xa "I’d rather know your name first."
    xa "我宁愿先知道你的名字。"

# game/episode016.rpy:322
translate simplified_chinese ep016_prison_45b0c1e8:

    # xa "It breeds...{w} Trust..."
    xa "这能培养…{w}信任…"

# game/episode016.rpy:323
translate simplified_chinese ep016_prison_385547f6:

    # xa "The Rhenkoy have withheld me from meeting new people for so long."
    xa "伦科伊人阻止我结识新朋友已经太久太久了。"

# game/episode016.rpy:325
translate simplified_chinese ep016_prison_201eeb98:

    # xa "So very long..."
    xa "真的太久太久了…"

# game/episode016.rpy:326
translate simplified_chinese ep016_prison_be17ee9b:

    # c "Answer the question."
    c "回答问题。"

# game/episode016.rpy:328
translate simplified_chinese ep016_prison_c2dbf3cd:

    # xa "I used to like meeting new people."
    xa "我以前很喜欢结识新朋友。"

# game/episode016.rpy:329
translate simplified_chinese ep016_prison_eaa27b04:

    # xa "Tasting them for the first time."
    xa "第一次品尝他们的感觉。"

# game/episode016.rpy:330
translate simplified_chinese ep016_prison_f6353130:

    # c "Tasting?"
    c "品尝？"

# game/episode016.rpy:332
translate simplified_chinese ep016_prison_90f874bb:

    # xa "A figure of speech, I’m not sure if there’s a good translation in your language."
    xa "这是个比喻说法，我不确定你们的语言里有没有合适的翻译。"

# game/episode016.rpy:333
translate simplified_chinese ep016_prison_75a024c1:

    # xa "It’s not a literal tasting."
    xa "不是字面意义上的品尝。"

# game/episode016.rpy:335
translate simplified_chinese ep016_prison_da7e6846:

    # "I did my best shaking the image of the huge snake trying to nibble on a human appendage."
    "我尽力摆脱那条巨蛇试图啃咬人类肢体的画面。"

# game/episode016.rpy:336
translate simplified_chinese ep016_prison_e3046e99:

    # "The Scolguin soldier didn’t seem to be unwilling to answer me, but they were very strange indeed."
    "斯科尔金士兵似乎并不抗拒回答我，但它们确实非常古怪。"

# game/episode016.rpy:337
translate simplified_chinese ep016_prison_108a75fe:

    # "It could have been the language barrier preventing the nuances of the Scolguin speech to get through, but the Scolguin almost seemed to be in a state of delirium."
    "可能是语言障碍阻碍了斯科尔金言语中的微妙之处，但斯科尔金人几乎像是处于一种谵妄状态。"

# game/episode016.rpy:338
translate simplified_chinese ep016_prison_5b7c226e:

    # c "Are you in good health?"
    c "你身体状况良好吗？"

# game/episode016.rpy:340
translate simplified_chinese ep016_prison_d2d8defb:

    # xa "My physical form isn’t wanting, the Rhenkoy see to that."
    xa "我的肉体形态并无缺憾，伦科伊人对此有所照料。"

# game/episode016.rpy:341
translate simplified_chinese ep016_prison_e1065119:

    # xa "But I’m far from complete."
    xa "但我远未完整。"

# game/episode016.rpy:342
translate simplified_chinese ep016_prison_06c34876:

    # xa "Far from complete..."
    xa "远未完整…"

# game/episode016.rpy:343
translate simplified_chinese ep016_prison_05799ec4:

    # xa "I need more, I deserve more."
    xa "我需要更多，我理应获得更多。"

# game/episode016.rpy:344
translate simplified_chinese ep016_prison_0e2f2297:

    # c "And what do you deserve, actually?"
    c "那么你究竟应得什么？"

# game/episode016.rpy:346
translate simplified_chinese ep016_prison_6e67b209:

    # xa "The fruits of the mind, the nectar of the sensation!"
    xa "思想的果实，感受的甘露！"

# game/episode016.rpy:347
translate simplified_chinese ep016_prison_6224b680:

    # xa "Do you understand?"
    xa "你明白吗？"

# game/episode016.rpy:348
translate simplified_chinese ep016_prison_3275e9ef:

    # c "I think so."
    c "我想我明白了。"

# game/episode016.rpy:349
translate simplified_chinese ep016_prison_95f3f6c3:

    # xa "Oh yes, the more exquisite, the better."
    xa "哦，是的，越是精美越好。"

# game/episode016.rpy:351
translate simplified_chinese ep016_prison_0fb04a66:

    # xa "I’ve been without it for so long and the Rhenkoy will not oblige."
    xa "我已经很久没有品尝过了，而伦科伊人不会满足我。"

# game/episode016.rpy:352
translate simplified_chinese ep016_prison_e9dd6121:

    # c "Maybe I can arrange something."
    c "也许我可以安排一下。"

# game/episode016.rpy:354
translate simplified_chinese ep016_prison_32622f99:

    # xa "You can?"
    xa "你可以？"

# game/episode016.rpy:355
translate simplified_chinese ep016_prison_05b27c47:

    # c "What does the process entail, how will you “taste”?"
    c "这个过程需要什么，你会如何\"品尝\"？"

# game/episode016.rpy:357
translate simplified_chinese ep016_prison_b3c4d962:

    # xa "There’s a ritual we perform, a merging of minds."
    xa "我们会举行一个仪式，一次心灵的融合。"

# game/episode016.rpy:358
translate simplified_chinese ep016_prison_6ee83e51:

    # xa "You will open yourself to me and I will taste everything you’ve experienced."
    xa "你会向我敞开心扉，我将品尝你经历的一切。"

# game/episode016.rpy:359
translate simplified_chinese ep016_prison_45570a4d:

    # xa "Please, let me drink."
    xa "求求你，让我畅饮吧。"

# game/episode016.rpy:360
translate simplified_chinese ep016_prison_636554ac:

    # c "I think not."
    c "我不这么认为。"

# game/episode016.rpy:361
translate simplified_chinese ep016_prison_a19f51c1:

    # xa "You want something in return, of course."
    xa "你当然想要回报。"

# game/episode016.rpy:363
translate simplified_chinese ep016_prison_695cfc8e:

    # xa "A trade?"
    xa "做个交易？"

# game/episode016.rpy:364
translate simplified_chinese ep016_prison_3db3d4d6:

    # c "I’m not going to let you rape my mind just to get a fix."
    c "我不会为了过把瘾就让你强暴我的思想。"

# game/episode016.rpy:366
translate simplified_chinese ep016_prison_c86b787d:

    # xa "There can be boundaries..."
    xa "可以设定界限…"

# game/episode016.rpy:367
translate simplified_chinese ep016_prison_be38bc67:

    # c "Here’s the deal, I give you one experience, something which will make you last a long time."
    c "这样吧，我给你一次体验，足够你回味很久。"

# game/episode016.rpy:368
translate simplified_chinese ep016_prison_796fd3f1:

    # c "In return you give me a way to establish direct contact with the Scolguin mother fleet."
    c "作为回报，你要告诉我直接联系斯科尔金母舰舰队的方法。"

# game/episode016.rpy:370
translate simplified_chinese ep016_prison_a5ede09a:

    # xa "I can’t give up that kind of information."
    xa "我不能透露那种信息。"

# game/episode016.rpy:371
translate simplified_chinese ep016_prison_a91fe642:

    # c "That’s a shame, because in that case you’ll be living off the Rhenkoy hospitality for the rest of your miserable life."
    c "真遗憾，那样的话你后半辈子就只能靠伦科伊人的\"款待\"苟活了。"

# game/episode016.rpy:373
translate simplified_chinese ep016_prison_f8afcc78:

    # xa "But what if I don’t know of a way to establish contact?"
    xa "但如果我根本不知道联系方法呢？"

# game/episode016.rpy:374
translate simplified_chinese ep016_prison_f071dab0:

    # c "Don’t bother, your first response gave you away immediately."
    c "别费劲了，你第一反应就立刻暴露了自己。"

# game/episode016.rpy:375
translate simplified_chinese ep016_prison_e8b84cb9:

    # c "So, what will it be?"
    c "那么，你打算怎么做？"

# game/episode016.rpy:377
translate simplified_chinese ep016_prison_5aa4b41a:

    # "The Scolguin regarded me silently, her impassive gaze not giving away much."
    "斯科尔金人沉默地注视着我，她那冷漠的目光没有透露太多信息。"

# game/episode016.rpy:378
translate simplified_chinese ep016_prison_670e73aa:

    # "The length of her silence gave me the impression she was carefully weighing her options though."
    "不过她长时间的沉默让我感觉她正在仔细权衡自己的选择。"

# game/episode016.rpy:379
translate simplified_chinese ep016_prison_8c944b72:

    # c "Time to make a decision, otherwise I’ll have to see if one of your squad-mates is more eager to make a deal."
    c "该做决定了，否则我只好看看你小队里是否有人更愿意做这笔交易。"

# game/episode016.rpy:381
translate simplified_chinese ep016_prison_a447eb50:

    # xa "No!"
    xa "不！"

# game/episode016.rpy:383
translate simplified_chinese ep016_prison_7145fe21:

    # xa "The trade is...{w} Fair..."
    xa "这笔交易…{w}很公平…"

# game/episode016.rpy:387
translate simplified_chinese ep016_prison_139c6bba:

    # c "Good."
    c "很好。"

# game/episode016.rpy:388
translate simplified_chinese ep016_prison_29b93291:

    # c "So how do we do this?"
    c "那我们该怎么做？"

# game/episode016.rpy:390
translate simplified_chinese ep016_prison_2c3c89c0:

    # xa "We will have to attune ourselves to each other, in order for me to fully share your experiences."
    xa "我们必须先互相调谐，我才能完整分享你的体验。"

# game/episode016.rpy:391
translate simplified_chinese ep016_prison_5e5c0940:

    # c "Just this one experience."
    c "就这一次体验。"

# game/episode016.rpy:393
translate simplified_chinese ep016_prison_f2a38af8:

    # xa "Yes, I will not overstep the bounds we have agreed upon."
    xa "是的，我不会越界超出我们约定的范围。"

# game/episode016.rpy:394
translate simplified_chinese ep016_prison_7d6f95d6:

    # c "How do we attune?"
    c "我们该如何调谐？"

# game/episode016.rpy:395
translate simplified_chinese ep016_prison_6ac49735:

    # xa "Just listen intently."
    xa "只需专心聆听。"

# game/episode016.rpy:397
translate simplified_chinese ep016_prison_38c145df:

    # "As Xatrape was silent after that, listening seemed a little redundant."
    "由于萨特拉普之后一直保持沉默，聆听似乎有些多余。"

# game/episode016.rpy:398
translate simplified_chinese ep016_prison_07efd9b4:

    # "Just as I was about to make a snide comment, I could feel something probing the fringes of my thoughts."
    "正当我要发表刻薄评论时，我能感觉到有什么东西在探查我意识的边缘。"

# game/episode016.rpy:399
translate simplified_chinese ep016_prison_2965f3cb:

    # xa "You are resisting."
    xa "你在抗拒。"

# game/episode016.rpy:400
translate simplified_chinese ep016_prison_c03e8ad1:

    # "Before she told me, I didn’t know I was."
    "在她告诉我之前，我并不知道自己在抗拒。"

# game/episode016.rpy:401
translate simplified_chinese ep016_prison_f6b8ecec:

    # "And suddenly a different thought hit me, this felt exactly the same as when the Scolguin ship hit me with their laser beam."
    "突然另一个念头击中了我，这感觉完全就像斯科尔金飞船用激光束击中我时一样。"

# game/episode016.rpy:402
translate simplified_chinese ep016_prison_e4345a0c:

    # "I didn’t realize it at the time, probably because of all the near-death panic going on, but the ship probably probed me as Xatrape was doing now."
    "当时我没有意识到这一点，可能是因为濒死的恐慌，但那艘飞船很可能像萨特拉普现在这样探查过我。"

# game/episode016.rpy:403
translate simplified_chinese ep016_prison_1dda240f:

    # c "This is what you do to the sacrificial victims you request."
    c "这就是你们对待所要求的祭品的方式。"

# game/episode016.rpy:405
translate simplified_chinese ep016_prison_9e8c4d4f:

    # xa "This is how we Taste the Offerings, yes."
    xa "这就是我们\"品尝祭品\"的方式，没错。"

# game/episode016.rpy:406
translate simplified_chinese ep016_prison_ede37f9e:

    # xa "You are still resisting."
    xa "你仍在抵抗。"

# game/episode016.rpy:407
translate simplified_chinese ep016_prison_96e82aa0:

    # c "Sorry, attempted brain molestation generally has that effect on me..."
    c "抱歉，试图侵犯大脑通常对我有这种影响…"

# game/episode016.rpy:409
translate simplified_chinese ep016_prison_86a5fef5:

    # "Xatrape gave me a withering look and I made a new attempt to let her in."
    "萨特拉普给了我一个令人沮丧的眼神，我再次尝试让她进入。"

# game/episode016.rpy:410
translate simplified_chinese ep016_prison_46d94ca8:

    # "I could feel her questing out again and envisioned an opening in my thoughts."
    "我能感觉到她再次试探，并在脑海中构想出一个开口。"

# game/episode016.rpy:411
translate simplified_chinese ep016_prison_613c45e1:

    # "She immediately pushed through and I could suddenly feel her hunger, her desire to go in completely and dominate my mind."
    "她立即推了进来，我突然能感受到她的饥饿感，她想要完全进入并主宰我的思想。"

# game/episode016.rpy:412
translate simplified_chinese ep016_prison_955617f4:

    # "The Scolguin restrained herself and she went no further."
    "斯科尔金人克制住了自己，没有再进一步。"

# game/episode016.rpy:414
translate simplified_chinese ep016_prison_ed191c65:

    # xa "We are now one."
    xa "我们现在是一体了。"

# game/episode016.rpy:416
translate simplified_chinese ep016_prison_d8ea15f2:

    # "Having received the information that we needed, I entered the antechamber and knocked on the outer cell door again."
    "在获取了我们需要的信息后，我进入前厅再次敲响了外牢门。"

# game/episode016.rpy:418
translate simplified_chinese ep016_prison_716b4b92:

    # xa "Thank you for allowing me the experience."
    xa "感谢您让我体验这个经历。"

# game/episode016.rpy:419
translate simplified_chinese ep016_prison_78292c05:

    # xa "I will cherish this for a long time."
    xa "我会长久珍惜这份记忆。"

# game/episode016.rpy:421
translate simplified_chinese ep016_prison_66bdbf2b:

    # "Suppressing a slight shiver, I shook off the last remnants of her mental connection and stepped out into the light."
    "强忍着轻微的颤抖，我甩掉她精神连接的最后残余，步入光明之中。"

# game/episode016.rpy:434
translate simplified_chinese ep016_prison_3200e9a6:

    # "The others were looking at me expectantly."
    "其他人正期待地望着我。"

# game/episode016.rpy:435
translate simplified_chinese ep016_prison_4932768a:

    # c "I think we got what we came for."
    c "我想我们已经得到了此行的目标。"

# game/episode016.rpy:436
translate simplified_chinese ep016_prison_c2dff550:

    # c "Thank you for your cooperation, we will be returning to the transport and back to our ship."
    c "感谢您的配合，我们将返回运输船并回到我们的飞船上。"

# game/episode016.rpy:438
translate simplified_chinese ep016_prison_e958576d:

    # woman "Of course, we will escort you to the landing pad."
    woman "当然，我们会护送您到起降平台。"

# game/episode016.rpy:440
translate simplified_chinese ep016_prison_38a6c121:

    # "When the guards had dropped us off at the shuttle, we dawdled a little in front of the craft."
    "当守卫把我们送到穿梭艇时，我们在飞船前逗留了片刻。"

# game/episode016.rpy:442
translate simplified_chinese ep016_prison_09b3c7eb:

    # na "Did you learn anything?"
    na "你打听到什么消息了吗？"

# game/episode016.rpy:443
translate simplified_chinese ep016_prison_6495739b:

    # c "Yes, she showed me the way to gain access to the Scolguin fleet."
    c "是的，她向我展示了进入斯科尔金舰队的方法。"

# game/episode016.rpy:444
translate simplified_chinese ep016_prison_2c2fc864:

    # c "We are to travel to a place called the Supplicant’s Stone."
    c "我们要去一个叫\"祈愿石\"的地方。"

# game/episode016.rpy:445
translate simplified_chinese ep016_prison_ada2cdd2:

    # c "Traditionally, anyone who wants something from the Scolguin leaves their sacrifices there."
    c "按照传统，任何想从斯科尔金人那里得到东西的人都会在那里留下祭品。"

# game/episode016.rpy:446
translate simplified_chinese ep016_prison_8883d71e:

    # c "By sending out a signal on a certain radio frequency, we will be admitted among the Scolguin fleet without throwing people out of an airlock."
    c "通过在特定无线电频率上发送信号，我们就能被允许进入斯科尔金舰队，而不必把人从气闸丢出去。"

# game/episode016.rpy:448
translate simplified_chinese ep016_prison_4a1785ac:

    # na "She told you all this?"
    na "她把这一切都告诉你了？"

# game/episode016.rpy:449
translate simplified_chinese ep016_prison_f3f36594:

    # c "More or less, yes."
    c "差不多吧，是的。"

# game/episode016.rpy:451
translate simplified_chinese ep016_prison_04d9492f:

    # ki "Do you have any doubt as to whether she was telling you the truth?"
    ki "你对她是否说了实话有任何怀疑吗？"

# game/episode016.rpy:452
translate simplified_chinese ep016_prison_b0952a00:

    # c "No, I’m pretty certain her information is genuine."
    c "没有，我很确定她的信息是真实的。"

# game/episode016.rpy:453
translate simplified_chinese ep016_prison_a3bc4130:

    # na "Good, in that case we should go back to the Bastard immediately."
    na "很好，既然如此我们应该立即返回\"私生子\"号。"

# game/episode016.rpy:455
translate simplified_chinese ep016_prison_d23791b4:

    # "Nadya was already climbing into the shuttle, but Kit looked at me with an amused grin on his face."
    "娜迪亚已经爬进了穿梭艇，但基特脸上带着戏谑的笑容看着我。"

# game/episode016.rpy:457
translate simplified_chinese ep016_prison_15a80802:

    # ki "You totally fucked her, didn’t you?"
    ki "你绝对上了她，对吧？"

# game/episode016.rpy:458
translate simplified_chinese ep016_prison_c33a0dbe:

    # c "I applied various advanced interrogation techniques."
    c "我运用了多种先进审讯技巧。"

# game/episode016.rpy:459
translate simplified_chinese ep016_prison_094ac40c:

    # ki "Sure..."
    ki "当然…"

# game/episode016.rpy:461
translate simplified_chinese ep016_prison_770dccd7:

    # ki "I knew it, you were gone for so long!"
    ki "我就知道，你去了那么久！"

# game/episode016.rpy:462
translate simplified_chinese ep016_prison_44f644f0:

    # ki "So, what was she like?"
    ki "所以，她怎么样？"

# game/episode016.rpy:463
translate simplified_chinese ep016_prison_6d1bcec6:

    # c "Very different."
    c "非常特别。"

# game/episode016.rpy:464
translate simplified_chinese ep016_prison_426536ec:

    # ki "Big and ugly?"
    ki "又大又丑？"

# game/episode016.rpy:465
translate simplified_chinese ep016_prison_fe62ec65:

    # c "I’d call it a peculiar taste, but you’ve had weirder lays on Alf Cen."
    c "我称之为独特品味，但你在半人马座α星上还有过更古怪的艳遇。"

# game/episode016.rpy:466
translate simplified_chinese ep016_prison_b12ed952:

    # ki "Hey, I just like to celebrate the diversity of alien life in all its forms."
    ki "嘿，我只是喜欢以各种形式庆祝外星生命的多样性。"

# game/episode016.rpy:467
translate simplified_chinese ep016_prison_48b10a0d:

    # ki "Even if it looks like a slug and barfed its eggs all over me while I was fucking it."
    ki "就算它长得像鼻涕虫，还在我干它的时候把卵吐得我满身都是。"

# game/episode016.rpy:468
translate simplified_chinese ep016_prison_5a868864:

    # c "Damn, I’d forgotten all about your little slug adventure."
    c "该死，我都忘了你那小小的鼻涕虫冒险了。"

# game/episode016.rpy:470
translate simplified_chinese ep016_prison_ec8df9b9:

    # ki "I wish I could..."
    ki "我真希望能…"

# game/episode016.rpy:472
translate simplified_chinese ep016_prison_dae7141f:

    # ki "By the way, why do you trust her information, did she moan it convincingly into your ear?"
    ki "对了，你为什么会相信她的情报，难道是她在你耳边呻吟得特别逼真？"

# game/episode016.rpy:473
translate simplified_chinese ep016_prison_3d9e6aaa:

    # c "No, she showed me, like in my mind, as she was having an orgasm."
    c "不，她展现给我看的，就像直接在我脑海里，就在她高潮的时候。"

# game/episode016.rpy:474
translate simplified_chinese ep016_prison_29dd6823:

    # ki "Wow."
    ki "哇哦。"

# game/episode016.rpy:476
translate simplified_chinese ep016_prison_6c9adce3:

    # ki "Do you think those guards will let me in again for a quickie?"
    ki "你觉得那些守卫会再放我进去速战速决吗？"

# game/episode016.rpy:477
translate simplified_chinese ep016_prison_2fc84552:

    # c "I’m sure we have better things to do."
    c "我相信我们有更重要的事情要做。"

# game/episode016.rpy:478
translate simplified_chinese ep016_prison_06c048a8:

    # ki "Right..."
    ki "好吧…"

# game/episode016.rpy:480
translate simplified_chinese ep016_prison_e7243266:

    # ki "Well, let’s not keep Nadya waiting then."
    ki "那么，我们别让娜迪亚等太久了。"

# game/episode016.rpy:482
translate simplified_chinese ep016_prison_0d360386:

    # "We went up into the shuttle and traveled back to the Bastard."
    "我们登上穿梭艇，返回了\"私生子\"号。"

# game/episode016.rpy:484
translate simplified_chinese ep016_prison_cada8849:

    # "The prospect of having sex with a glowing snake woman didn’t appeal to me very much."
    "和一条发光的蛇女做爱的想法对我没什么吸引力。"

# game/episode016.rpy:485
translate simplified_chinese ep016_prison_db1ae6fd:

    # "I was very much hoping for Kit’s exotic tastes to appeal to his better judgment."
    "我非常希望基特那异域风情的口味能让他做出更明智的判断。"

# game/episode016.rpy:486
translate simplified_chinese ep016_prison_774495ee:

    # "He had some very weird lays in the Sovereignty brothels, back in the day."
    "当年在\"至高权域\"那边的妓院里，他可是尝过不少奇葩货色。"

# game/episode016.rpy:487
translate simplified_chinese ep016_prison_cd5f7e4a:

    # c "Allow me to step out for a moment and arrange for something."
    c "容我出去片刻安排些事情。"

# game/episode016.rpy:488
translate simplified_chinese ep016_prison_7627715e:

    # xa "Of course."
    xa "当然。"

# game/episode016.rpy:489
translate simplified_chinese ep016_prison_06bb02d6:

    # "I went back to the antechamber and knocked on the outer door."
    "我回到前厅敲了敲外门。"

# game/episode016.rpy:491
translate simplified_chinese ep016_prison_86354b0d:

    # "After a small pause I was let out of the cell."
    "稍作停顿后，我被放出了牢房。"

# game/episode016.rpy:493
translate simplified_chinese ep016_prison_fc646662:

    # woman "Have you concluded the interrogation?"
    woman "审讯结束了吗？"

# game/episode016.rpy:494
translate simplified_chinese ep016_prison_16cb626c:

    # c "Not yet, I wish to confer with one of my teammates."
    c "还没，我想和一位队友商议一下。"

# game/episode016.rpy:495
translate simplified_chinese ep016_prison_d4349a99:

    # woman "Of course."
    woman "当然。"

# game/episode016.rpy:497
translate simplified_chinese ep016_prison_52b60912:

    # "I caught Kit’s eye and walked with him out of earshot."
    "我与基特交换了个眼神，同他走到旁人听不见的地方。"

# game/episode016.rpy:499
translate simplified_chinese ep016_prison_0113c6df:

    # ki "What’s with the conspiracy vibes?"
    ki "这阴谋气氛是怎么回事？"

# game/episode016.rpy:500
translate simplified_chinese ep016_prison_caccf067:

    # ki "Need me to torture someone?"
    ki "需要我折磨谁吗？"

# game/episode016.rpy:501
translate simplified_chinese ep016_prison_ee0ef76b:

    # c "Nothing of the sort."
    c "不是那么回事。"

# game/episode016.rpy:502
translate simplified_chinese ep016_prison_c00a878e:

    # c "The prisoner wants a trade."
    c "囚犯想做笔交易。"

# game/episode016.rpy:504
translate simplified_chinese ep016_prison_617e404b:

    # ki "Okay..."
    ki "好吧…"

# game/episode016.rpy:505
translate simplified_chinese ep016_prison_7a158e85:

    # c "You know the Scolguin live off the experiences of others."
    c "你知道斯科尔金人以他人经历为食。"

# game/episode016.rpy:506
translate simplified_chinese ep016_prison_e531b6b6:

    # c "This one has been starved of their recreational drug for quite a while now, so I may have offered her an experience."
    c "这家伙已经很久没尝到他们的消遣药物了，所以我可能答应给她一次体验。"

# game/episode016.rpy:508
translate simplified_chinese ep016_prison_613799be:

    # ki "And she accepted?"
    ki "她接受了？"

# game/episode016.rpy:509
translate simplified_chinese ep016_prison_7961aac6:

    # c "She did."
    c "是的。"

# game/episode016.rpy:510
translate simplified_chinese ep016_prison_6fce5db4:

    # c "In exchange for the information, one of us will have to form a mental link and give her an experience."
    c "作为信息的交换，我们中必须有人建立精神连接，给她一次体验。"

# game/episode016.rpy:512
translate simplified_chinese ep016_prison_43b0bdb2:

    # ki "Right...{w} An experience."
    ki "好吧…{w} 一段体验。"

# game/episode016.rpy:513
translate simplified_chinese ep016_prison_885bcc48:

    # ki "I’m guessing you’re not thinking of passing a heartfelt rendition of that Macbeth monologue to her?"
    ki "我猜你没打算把那段《麦克白》独白的深情演绎传给她吧？"

# game/episode016.rpy:514
translate simplified_chinese ep016_prison_76033548:

    # c "No, I was thinking you’d fuck her."
    c "不，我原想着让你去操她。"

# game/episode016.rpy:515
translate simplified_chinese ep016_prison_8259ef80:

    # ki "Right."
    ki "行。"

# game/episode016.rpy:517
translate simplified_chinese ep016_prison_c3f505e2:

    # ki "She’s ugly, isn’t she?"
    ki "她长得丑，对吧？"

# game/episode016.rpy:518
translate simplified_chinese ep016_prison_14f4209b:

    # c "I’d say she’s different."
    c "我得说她…与众不同。"

# game/episode016.rpy:520
translate simplified_chinese ep016_prison_8259ef80_1:

    # ki "Right."
    ki "行。"

# game/episode016.rpy:521
translate simplified_chinese ep016_prison_f991cffe:

    # c "Big tits though."
    c "不过奶子挺大。"

# game/episode016.rpy:522
translate simplified_chinese ep016_prison_3777ba40:

    # ki "I’m to take one for the team, so to speak."
    ki "这么说，我得为团队牺牲一下了。"

# game/episode016.rpy:523
translate simplified_chinese ep016_prison_7f9fc27c:

    # c "You’ve had worse on Alf Cen."
    c "你在半人马座α星上玩过更差的。"

# game/episode016.rpy:525
translate simplified_chinese ep016_prison_e279d677:

    # ki "Fine, I’ll be your hero."
    ki "好吧，我来当你的英雄。"

# game/episode016.rpy:526
translate simplified_chinese ep016_prison_abc5c5d2:

    # c "That was a remarkably quick decision."
    c "这决定做得可真够快的。"

# game/episode016.rpy:528
translate simplified_chinese ep016_prison_5be29f96:

    # ki "Yeah right, I’ve been living a life of celibacy ever since that crazy orgy on Erigone."
    ki "得了吧，自从在厄里戈涅星上那次疯狂的狂欢之后，我就一直过着禁欲生活。"

# game/episode016.rpy:530
translate simplified_chinese ep016_prison_9935b0b3:

    # ki "Yeah right, do you know how long I’ve been without?"
    ki "得了吧，你知道我憋了多久吗？"

# game/episode016.rpy:531
translate simplified_chinese ep016_prison_08df169c:

    # c "I’m sure the snake lady will take good care of you."
    c "我敢肯定那位蛇女会好好照顾你的。"

# game/episode016.rpy:533
translate simplified_chinese ep016_prison_32f1b48c:

    # ki "Wait a minute...{w} Snake lady?"
    ki "等一下…{w} 蛇女？"

# game/episode016.rpy:534
translate simplified_chinese ep016_prison_d85bae7f:

    # c "Yes, she has quite a tail on her."
    c "没错，她可是有条相当长的尾巴。"

# game/episode016.rpy:536
translate simplified_chinese ep016_prison_c654753b:

    # ki "Color me intrigued."
    ki "这可勾起我的兴趣了。"

# game/episode016.rpy:537
translate simplified_chinese ep016_prison_1aee4c42:

    # c "Be very careful though."
    c "不过你得非常小心。"

# game/episode016.rpy:538
translate simplified_chinese ep016_prison_90aaa2ae:

    # c "She has agreed to do a very limited joining of minds, but I’m sure she’ll try to overpower you in some way."
    c "她同意进行一次非常有限的心灵连接，但我敢肯定她会设法控制你。"

# game/episode016.rpy:539
translate simplified_chinese ep016_prison_7012b3a2:

    # c "It’s okay if you don’t want to go through with it, we’ll find some other way to get a meeting with those Scolguin."
    c "如果你不想继续的话也没关系，我们会另想办法和那些斯科尔金人见面的。"

# game/episode016.rpy:541
translate simplified_chinese ep016_prison_7aa461b0:

    # ki "No, I’ll do it, the whole sense of danger makes it all the more fun."
    ki "不，我要去，这种危险感反而让事情更有趣。"

# game/episode016.rpy:543
translate simplified_chinese ep016_prison_5d2317d4:

    # "We walked back to the guards who were eyeing us curiously."
    "我们走回守卫那里，他们正好奇地打量着我们。"

# game/episode016.rpy:545
translate simplified_chinese ep016_prison_eb939f91:

    # c "Kit will go in to interrogate the prisoner."
    c "基特会进去审问囚犯。"

# game/episode016.rpy:546
translate simplified_chinese ep016_prison_ee05f3f1:

    # "Kit entered the cell and the doors closed."
    "基特进入牢房，门关上了。"

# game/episode016.rpy:548
translate simplified_chinese ep016_prison_ba05281b:

    # na "What were you discussing in private?"
    na "你们私下在讨论什么？"

# game/episode016.rpy:549
translate simplified_chinese ep016_prison_43dbed1a:

    # c "The prisoner has agreed to a deal."
    c "囚犯同意了一项交易。"

# game/episode016.rpy:550
translate simplified_chinese ep016_prison_9b336f3a:

    # c "She wants to perform a joining of minds."
    c "她想进行一次心灵融合。"

# game/episode016.rpy:551
translate simplified_chinese ep016_prison_e9575419:

    # na "And Kit has agreed to do this?"
    na "基特同意这么做了？"

# game/episode016.rpy:552
translate simplified_chinese ep016_prison_dbb51068:

    # c "He has, yes."
    c "是的，他同意了。"

# game/episode016.rpy:554
translate simplified_chinese ep016_prison_cb9d62db:

    # na "That sounds very dangerous."
    na "这听起来非常危险。"

# game/episode016.rpy:555
translate simplified_chinese ep016_prison_9a71b10d:

    # na "There are some other species who have similar abilities, it is very easy to lose yourself."
    na "还有其他一些物种拥有类似的能力，很容易迷失自我。"

# game/episode016.rpy:556
translate simplified_chinese ep016_prison_46775032:

    # c "Yes, but Kit has assured me he’ll be careful."
    c "是的，但基特向我保证他会小心的。"

# game/episode016.rpy:557
translate simplified_chinese ep016_prison_3556b9cf:

    # c "The power dynamic is different as well in this instance."
    c "在这种情况下，权力动态也有所不同。"

# game/episode016.rpy:559
translate simplified_chinese ep016_prison_4b60832d:

    # na "Still, she could take him hostage."
    na "尽管如此，她还是可能挟持他作为人质。"

# game/episode016.rpy:560
translate simplified_chinese ep016_prison_2c8cce2b:

    # c "I don’t think she is in a state of mind to do that."
    c "我认为她现在的精神状态不会那样做。"

# game/episode016.rpy:561
translate simplified_chinese ep016_prison_845f245e:

    # c "Besides, the entire facility would be on top of her in seconds."
    c "再说，整个设施的人都会在几秒钟内赶到。"

# game/episode016.rpy:562
translate simplified_chinese ep016_prison_59938274:

    # na "If you say so...{w} All we can do now is wait."
    na "如果你这么说的话…{w}我们现在能做的只有等待。"

# game/episode016.rpy:564
translate simplified_chinese ep016_prison_78f43c73:

    # "And wait we did."
    "我们确实在等待。"

# game/episode016.rpy:565
translate simplified_chinese ep016_prison_f42979b3:

    # "Kit took his sweet time with the prisoner."
    "基特和囚犯磨蹭了好一阵子。"

# game/episode016.rpy:566
translate simplified_chinese ep016_prison_c1500fac:

    # "Luckily, the cell was soundproofed, so nothing of what transpired inside reached our ears."
    "幸好牢房是隔音的，所以里面发生的任何动静都没传进我们耳朵。"

# game/episode016.rpy:567
translate simplified_chinese ep016_prison_49b49c77:

    # "The guards began to shift impatiently after a while."
    "过了一阵子，守卫们开始不耐烦地挪动身子。"

# game/episode016.rpy:569
translate simplified_chinese ep016_prison_eec8b1e9:

    # woman "Is this going to take much longer?"
    woman "这还要很久吗？"

# game/episode016.rpy:570
translate simplified_chinese ep016_prison_4b7c63d2:

    # c "Probably not."
    c "应该不会。"

# game/episode016.rpy:572
translate simplified_chinese ep016_prison_a75aa9c3:

    # "That guess turned out to be a bit of an underestimation."
    "这个猜测结果有点低估了实际情况。"

# game/episode016.rpy:573
translate simplified_chinese ep016_prison_37f496b6:

    # "Kit was seizing his opportunity with his snake lady to the fullest..."
    "基特正在充分利用他与蛇女的这次机会…"

# game/episode016.rpy:574
translate simplified_chinese ep016_prison_4d934f23:

    # "When the guard was about to speak up there was a knock on the door from the inside."
    "当守卫正要开口说话时，里面传来了敲门声。"

# game/episode016.rpy:576
translate simplified_chinese ep016_prison_48addc14:

    # "The guard unlocked the door and out stepped Kit, looking very smug indeed."
    "守卫打开门，基特走了出来，看起来确实非常得意。"

# game/episode016.rpy:578
translate simplified_chinese ep016_prison_564fb166:

    # na "Are you alright?"
    na "你还好吗？"

# game/episode016.rpy:579
translate simplified_chinese ep016_prison_4c5c6fc1:

    # ki "Yes, more than alright."
    ki "好，好得不能再好了。"

# game/episode016.rpy:580
translate simplified_chinese ep016_prison_3f1f3b66:

    # "In that moment, I wished Kit would have toned down the post-coital confidence a little."
    "那一刻，我真希望基特能把事后那种自信收敛一点。"

# game/episode016.rpy:581
translate simplified_chinese ep016_prison_aad731a1:

    # c "Did you get what we came here for?"
    c "我们要的东西拿到了吗？"

# game/episode016.rpy:583
translate simplified_chinese ep016_prison_f54413d2:

    # ki "I certainly did."
    ki "当然拿到了。"

# game/episode016.rpy:584
translate simplified_chinese ep016_prison_bda5d2ae:

    # c "Good, you can tell us on the way back to the Bastard."
    c "很好，回\"私生子\"号的路上你可以告诉我们。"

# game/episode016.rpy:585
translate simplified_chinese ep016_prison_a794cb91:

    # c "Thank you for your cooperation, we seem to be done here."
    c "感谢你们的配合，我们这边似乎已经结束了。"

# game/episode016.rpy:587
translate simplified_chinese ep016_prison_ce0d838f:

    # woman "Of course, we will escort you back to your transport."
    woman "当然，我们会护送你们返回运输船。"

# game/episode016.rpy:589
translate simplified_chinese ep016_prison_51494a62:

    # "When the guards left us at the launch pad, we looked at Kit expectantly."
    "当守卫在发射台与我们告别后，我们满怀期待地看向基特。"

# game/episode016.rpy:590
translate simplified_chinese ep016_prison_fb853be6:

    # c "So?"
    c "所以？"

# game/episode016.rpy:592
translate simplified_chinese ep016_prison_8cbf936a:

    # ki "Xatrape gave me coordinates for a beacon, something they call the Supplicant’s Stone."
    ki "萨特拉普给了我一个信标的坐标，他们称之为\"祈愿石\"。"

# game/episode016.rpy:593
translate simplified_chinese ep016_prison_ac253e74:

    # ki "It’s where people normally leave sacrificial victims for the Scolguin."
    ki "那里通常是人们给斯科尔金人献祭牺牲品的地方。"

# game/episode016.rpy:594
translate simplified_chinese ep016_prison_16449f50:

    # ki "But if we transmit a signal on a certain radio frequency, we will be admitted among the Scolguin fleet without a sacrifice."
    ki "但如果我们以特定无线电频率发送信号，就能在不献祭的情况下获准进入斯科尔金舰队。"

# game/episode016.rpy:608
translate simplified_chinese ep016_prison_8718bb64:

    # na "She told you all that?"
    na "她把这些都告诉你了？"

# game/episode016.rpy:609
translate simplified_chinese ep016_prison_30d40924:

    # ki "More or less, yes."
    ki "差不多吧，是的。"

# game/episode016.rpy:610
translate simplified_chinese ep016_prison_9c3d30a2:

    # c "Do you think it is legit?"
    c "你觉得这靠谱吗？"

# game/episode016.rpy:612
translate simplified_chinese ep016_prison_a167e988:

    # na "It corresponds with most of the things I’ve read about the Scolguin."
    na "这与我读过的关于斯科尔金的大部分资料都吻合。"

# game/episode016.rpy:613
translate simplified_chinese ep016_prison_be096a41:

    # na "Shall we return to the ship and inform the others?"
    na "我们要回飞船通知其他人吗？"

# game/episode016.rpy:614
translate simplified_chinese ep016_prison_fb0e0ef9:

    # c "Let’s do that."
    c "就这么办吧。"

# game/episode016.rpy:616
translate simplified_chinese ep016_prison_8d72cad2:

    # "Nadya went up into the transport first, but Kit lingered on the launchpad."
    "娜迪亚先登上了运输船，但基特仍在发射台上徘徊。"

# game/episode016.rpy:617
translate simplified_chinese ep016_prison_3fc15ae0:

    # c "Are you okay?"
    c "你还好吗？"

# game/episode016.rpy:619
translate simplified_chinese ep016_prison_7ab33f3e:

    # ki "I’m beyond okay."
    ki "我岂止是好。"

# game/episode016.rpy:620
translate simplified_chinese ep016_prison_d982d6fc:

    # ki "Man, that was some of the best sex I’ve had in ages."
    ki "伙计，这可是我多年来最爽的性爱之一。"

# game/episode016.rpy:622
translate simplified_chinese ep016_prison_3d4c3233:

    # ki "Including that drug-fueled orgy with the Amazons."
    ki "包括那次和亚马逊女战士的迷幻群交。"

# game/episode016.rpy:623
translate simplified_chinese ep016_prison_e4ebb5ea:

    # c "She didn’t push the boundaries when sharing your mind?"
    c "她在共享你意识时没有越界吗？"

# game/episode016.rpy:625
translate simplified_chinese ep016_prison_af88d72e:

    # ki "Oh, she tried, but I kept her out of it."
    ki "哦，她试过，但我把她挡在外面了。"

# game/episode016.rpy:626
translate simplified_chinese ep016_prison_15c21326:

    # ki "And then we fucked."
    ki "然后我们就做了。"

# game/episode016.rpy:627
translate simplified_chinese ep016_prison_d952ae4b:

    # ki "You know why I don’t doubt she told me the truth about those coordinates and the radio frequency?"
    ki "你知道我为什么毫不怀疑她告诉我的坐标和无线电频率是真实的吗？"

# game/episode016.rpy:629
translate simplified_chinese ep016_prison_39e8e92b:

    # ki "She never spoke about them, but showed them in my mind while she had a major orgasm."
    ki "她从未说出口，但在她高潮时直接在我脑海里展现了这些信息。"

# game/episode016.rpy:630
translate simplified_chinese ep016_prison_f488f75f:

    # c "Sounds like you had a fun time."
    c "听起来你玩得很开心。"

# game/episode016.rpy:631
translate simplified_chinese ep016_prison_ba1cb900:

    # ki "I sure did."
    ki "当然。"

# game/episode016.rpy:633
translate simplified_chinese ep016_prison_ce9c6d36:

    # ki "One more item to strike off my bucket list."
    ki "又完成了一项人生清单。"

# game/episode016.rpy:634
translate simplified_chinese ep016_prison_6646de20:

    # c "I wonder what’s on that list sometimes and then I realize I might not want to know."
    c "我有时会好奇那张清单上到底写了些什么，然后意识到我可能并不想知道。"

# game/episode016.rpy:635
translate simplified_chinese ep016_prison_6a49f34c:

    # ki "Haha, fuck you."
    ki "哈，去你的。"

# game/episode016.rpy:636
translate simplified_chinese ep016_prison_4ab01a29:

    # ki "Let’s not keep Nadya waiting."
    ki "我们别让娜迪亚等太久了。"

# game/episode016.rpy:638
translate simplified_chinese ep016_prison_0d360386_1:

    # "We went up into the shuttle and traveled back to the Bastard."
    "我们登上穿梭艇，返回了\"私生子\"号。"

# game/episode016.rpy:651
translate simplified_chinese ep016_prison_dfe424ad:

    # "Back on the ship we brought everyone up to speed."
    "回到船上后，我们向所有人同步了最新情况。"

# game/episode016.rpy:654
translate simplified_chinese ep016_prison_aecaf233:

    # "Most of the crew were fine with the plan to fly out to the Supplicant’s Stone, but my mother and sisters lingered after the briefing."
    "大多数船员对前往\"祈愿石\"的计划没有异议，但我的母亲和妹妹们在简报会后留了下来。"

# game/episode016.rpy:656
translate simplified_chinese ep016_prison_764da447:

    # "Most of the crew were fine with the plan to fly out to the Supplicant’s Stone, but Eva, Lilly, Aven and Nadya lingered after the briefing."
    "大多数船员对前往\"祈愿石\"的计划没有异议，但伊娃、莉莉、艾文和娜迪亚在简报会后留了下来。"

# game/episode016.rpy:658
translate simplified_chinese ep016_prison_ce8027c3:

    # e "So, are we sure we want to do this?"
    e "那么，我们确定要这么做吗？"

# game/episode016.rpy:659
translate simplified_chinese ep016_prison_26bfc3a0:

    # e "Are you sure you’re up for it, [p_name_short]?"
    e "你确定自己能胜任吗，[p_name_short]？"

# game/episode016.rpy:660
translate simplified_chinese ep016_prison_94878a68:

    # c "Why wouldn’t I be?"
    c "我为什么不行？"

# game/episode016.rpy:662
translate simplified_chinese ep016_prison_7b734aa9:

    # av "Well, you were the one who was used by the Scolguin before."
    av "嗯，你之前可是被斯科尔金人利用过呢。"

# game/episode016.rpy:663
translate simplified_chinese ep016_prison_93e39793:

    # c "I mostly blame my father for that, the Scolguin were just doing what they always do, apparently."
    c "这主要得怪我父亲，斯科尔金人显然只是在做他们一贯做的事。"

# game/episode016.rpy:665
translate simplified_chinese ep016_prison_72643481:

    # l "I’m sure that’s true, but if it all works, we’ll be heading straight into the Scolguin mother fleet."
    l "我相信这是事实，但如果一切顺利，我们将直接进入斯科尔金人的母舰队。"

# game/episode016.rpy:666
translate simplified_chinese ep016_prison_750a2e12:

    # l "Who knows what they’ll do to us?"
    l "谁知道他们会怎么对付我们？"

# game/episode016.rpy:667
translate simplified_chinese ep016_prison_86e6e254:

    # c "There is a risk, but we cannot wander aimlessly through the galaxy either."
    c "确实存在风险，但我们也不能毫无目的地在星系间游荡。"

# game/episode016.rpy:669
translate simplified_chinese ep016_prison_743b3df8:

    # na "We could pilot a shuttle with a skeleton crew towards the Supplicant’s Stone and leave the Bastard at a safer distance."
    na "我们可以驾驶一艘只有骨干船员的穿梭艇前往\"祈愿石\"，把\"私生子\"号留在更安全的距离外。"

# game/episode016.rpy:670
translate simplified_chinese ep016_prison_aeabf9ca:

    # c "There are two problems with that."
    c "这样做有两个问题。"

# game/episode016.rpy:671
translate simplified_chinese ep016_prison_a7fe0f19:

    # c "We don’t have a shuttle and any shuttle is likely going to be less well-armed than the Bastard is."
    c "我们没有穿梭艇，而且任何穿梭艇的火力配置都可能不如\"私生子\"号。"

# game/episode016.rpy:672
translate simplified_chinese ep016_prison_42f575b4:

    # l "It’s too dangerous."
    l "这太危险了。"

# game/episode016.rpy:674
translate simplified_chinese ep016_prison_bcfeb3ad:

    # e "We’ve done worse and this is the most tangible lead we have."
    e "我们经历过更糟的情况，而这是目前最明确的线索。"

# game/episode016.rpy:675
translate simplified_chinese ep016_prison_ccf7ed73:

    # c "If we are attacked, we could always Burst our Drive as a last resort."
    c "如果我们遭到攻击，我们总可以启动引擎超载作为最后手段。"

# game/episode016.rpy:677
translate simplified_chinese ep016_prison_1fbd6e7e:

    # l "That may have worked the last time, but there’s no telling it will now."
    l "上次可能奏效了，但这次未必能行。"

# game/episode016.rpy:678
translate simplified_chinese ep016_prison_d47029b4:

    # c "I’m not denying there’s a risk, but it’s one we have to take."
    c "我不否认存在风险，但这是我们必须要冒的险。"

# game/episode016.rpy:680
translate simplified_chinese ep016_prison_9318b9dd:

    # l "I just wish we didn’t have to do all this anymore."
    l "我只是希望我们不必再继续这一切了。"

# game/episode016.rpy:681
translate simplified_chinese ep016_prison_1037b4aa:

    # l "I wish we could just get on and live our lives."
    l "我希望我们能继续前行，过自己的生活。"

# game/episode016.rpy:683
translate simplified_chinese ep016_prison_8772e807:

    # e "That’s the reason we’re doing this, Lilly."
    e "这就是我们这么做的原因，莉莉。"

# game/episode016.rpy:684
translate simplified_chinese ep016_prison_2ff15d56:

    # e "We won’t know peace until Agust and the others stop their search for us."
    e "除非阿古斯特和其他人停止追捕我们，否则我们永无宁日。"

# game/episode016.rpy:685
translate simplified_chinese ep016_prison_f50c1b6a:

    # "Nadya, Aven and Lilly relented in the end."
    "最终娜迪亚、艾文和莉莉都让步了。"

# game/episode016.rpy:687
translate simplified_chinese ep016_prison_a1a75897:

    # "An hour later, Céline set course to the system where the Supplicant’s Stone was supposed to be."
    "一小时后，瑟琳设定了前往据说存在\"祈愿石\"的星系的航线。"

# game/episode016.rpy:697
translate simplified_chinese ep016_scolguin_fleet_9fef67b9:

    # "The system where the Scolguin rallying beacon could be found was relatively unassuming."
    "能够找到斯科尔金集结信标的星系相对不起眼。"

# game/episode016.rpy:698
translate simplified_chinese ep016_scolguin_fleet_cee98231:

    # "As the system wasn’t very stable, only short visits were possible."
    "由于这个星系不太稳定，只能进行短暂访问。"

# game/episode016.rpy:699
translate simplified_chinese ep016_scolguin_fleet_853c6ef1:

    # "Any form of long-term mining was out of the question and there were no habitable planets in the area."
    "任何形式的长期采矿都是不可能的，而且该区域没有宜居行星。"

# game/episode016.rpy:701
translate simplified_chinese ep016_scolguin_fleet_b555bb74:

    # "The only thing of interest was a medium-sized asteroid, dubbed the Supplicant’s Stone."
    "唯一值得关注的是一个中等大小的小行星，被称为\"祈愿石\"。"

# game/episode016.rpy:702
translate simplified_chinese ep016_scolguin_fleet_3e8daefe:

    # "We approached the Scolguin rallying beacon at a slow burn, scanners at maximum sensitivity."
    "我们以缓慢的速度接近斯科尔金集结信标，扫描器处于最大灵敏度。"

# game/episode016.rpy:704
translate simplified_chinese ep016_scolguin_fleet_5a5eaf83:

    # c "Ready to broadcast that signal?"
    c "准备好发送那个信号了吗？"

# game/episode016.rpy:705
translate simplified_chinese ep016_scolguin_fleet_0054f605:

    # ce "I am."
    ce "准备好了。"

# game/episode016.rpy:706
translate simplified_chinese ep016_scolguin_fleet_011079c4:

    # c "Do it."
    c "发送。"

# game/episode016.rpy:708
translate simplified_chinese ep016_scolguin_fleet_8bcbb2bb:

    # "The signal went out and we waited."
    "信号发出后我们开始等待。"

# game/episode016.rpy:709
translate simplified_chinese ep016_scolguin_fleet_b8652d40:

    # "It didn’t take long before our sensors picked up multiple vessels."
    "没过多久我们的传感器就探测到多艘舰船。"

# game/episode016.rpy:711
translate simplified_chinese ep016_scolguin_fleet_028376a0:

    # "Sirens started blaring as we were targeted by several ships surrounding the Bastard."
    "当我们被几艘包围\"私生子\"号的舰船锁定时，警报开始响起。"

# game/episode016.rpy:712
translate simplified_chinese ep016_scolguin_fleet_b5b5959e:

    # "The ships looked distinctly like the one that had scanned me, so I knew for certain the Scolguin had arrived."
    "那些飞船的外观与扫描我的那艘极为相似，我由此确信斯科尔金人已经抵达。"

# game/episode016.rpy:714
translate simplified_chinese ep016_scolguin_fleet_9e0946ba:

    # ce "They’re hailing us."
    ce "他们正在呼叫我们。"

# game/episode016.rpy:715
translate simplified_chinese ep016_scolguin_fleet_624bee8f:

    # c "Put them through."
    c "接通信号。"

# game/episode016.rpy:718
translate simplified_chinese ep016_scolguin_fleet_7729901e:

    # man "Unknown vessel, you are not authorized to pay tribute at the Supplicant’s Stone."
    man "未知飞船，你未被授权在\"祈愿石\"进行朝贡。"

# game/episode016.rpy:719
translate simplified_chinese ep016_scolguin_fleet_132c5766:

    # man "We will proceed to destroy your vessel."
    man "我们将立即摧毁你的飞船。"

# game/episode016.rpy:721
translate simplified_chinese ep016_scolguin_fleet_b437b351:

    # c "Fuck."
    c "该死。"

# game/episode016.rpy:722
translate simplified_chinese ep016_scolguin_fleet_471d1f1b:

    # c "Burst us out of here!"
    c "快带我们冲出去！"

# game/episode016.rpy:723
translate simplified_chinese ep016_scolguin_fleet_e2de9c63:

    # ce "On it, try to stall them."
    ce "正在执行，尽量拖延他们。"

# game/episode016.rpy:725
translate simplified_chinese ep016_scolguin_fleet_bcd3335f:

    # c "Scolguin fleet, this is the Captain of the Iron Bastard, we have arrived here with a proposal for your leader."
    c "斯科尔金舰队，这里是\"钢铁私生子\"号舰长，我们带来了一项给你们首领的提议。"

# game/episode016.rpy:726
translate simplified_chinese ep016_scolguin_fleet_ef3b291b:

    # "The Scolguin didn’t respond."
    "斯科尔金人没有回应。"

# game/episode016.rpy:727
translate simplified_chinese ep016_scolguin_fleet_94ad7e55:

    # c "Are their weapons hot?"
    c "他们的武器预热了吗？"

# game/episode016.rpy:729
translate simplified_chinese ep016_scolguin_fleet_7ea933b6:

    # ce "They’re still powering up, I think."
    ce "我觉得他们还在充能。"

# game/episode016.rpy:730
translate simplified_chinese ep016_scolguin_fleet_5c0a2c57:

    # ce "We’re still being targeted."
    ce "我们仍被锁定着。"

# game/episode016.rpy:731
translate simplified_chinese ep016_scolguin_fleet_9898b974:

    # c "How long before we can Burst?"
    c "还要多久才能进行跃迁？"

# game/episode016.rpy:732
translate simplified_chinese ep016_scolguin_fleet_b84174fc:

    # ce "One minute."
    ce "一分钟。"

# game/episode016.rpy:734
translate simplified_chinese ep016_scolguin_fleet_3a166f73:

    # c "This is the Captain of the Iron Bastard, Scolguin fleet, do you copy?"
    c "这里是\"钢铁私生子\"号舰长，斯科尔金舰队，收到请回复？"

# game/episode016.rpy:735
translate simplified_chinese ep016_scolguin_fleet_bec3b8d3:

    # "There were still thirty seconds on the clock and I was beginning to despair we’d just be annihilated at some lonely anonymous rock when the comms crackled."
    "倒计时还剩三十秒，当我开始绝望地以为我们会在某个寂寂无名的岩石旁被摧毁时，通讯器突然传来噼啪声。"

# game/episode016.rpy:737
translate simplified_chinese ep016_scolguin_fleet_8eef92b8:

    # man "Captain of the Iron Bastard, we have received your message."
    man "\"钢铁私生子\"号舰长，我们已收到你的信息。"

# game/episode016.rpy:738
translate simplified_chinese ep016_scolguin_fleet_9c1bb1f7:

    # "The Scolguin liaison was still talking when Céline indicated that we would be able to Burst at will."
    "斯科尔金联络员还在说话时，瑟琳示意我们已经可以随时进行跃迁。"

# game/episode016.rpy:739
translate simplified_chinese ep016_scolguin_fleet_ac753c19:

    # "I motioned her to hold off and focused my attention on the Scolguin."
    "我示意她暂缓行动，将注意力集中在斯科尔金人身上。"

# game/episode016.rpy:740
translate simplified_chinese ep016_scolguin_fleet_f3adfb8a:

    # man "We have just been ordered to halt the destruction of your vessel."
    man "我们刚刚接到命令，要求停止摧毁你们的飞船。"

# game/episode016.rpy:741
translate simplified_chinese ep016_scolguin_fleet_de15d3a1:

    # man "It seems that Her Majesty is interested in you and has granted an audience."
    man "看来女王陛下对您很感兴趣，并赐予了觐见的机会。"

# game/episode016.rpy:742
translate simplified_chinese ep016_scolguin_fleet_103c7a1e:

    # man "Please follow the path as indicated by the guiding beacons."
    man "请按照指引信标指示的路线行进。"

# game/episode016.rpy:744
translate simplified_chinese ep016_scolguin_fleet_d0e632cc:

    # ce "The Scolguin have a queen?"
    ce "斯科尔金人居然有女王？"

# game/episode016.rpy:745
translate simplified_chinese ep016_scolguin_fleet_5a04b24f:

    # c "Apparently so."
    c "显然如此。"

# game/episode016.rpy:746
translate simplified_chinese ep016_scolguin_fleet_a8786427:

    # ce "And she has an interest in you...{w} that can't be healthy."
    ce "而且她对您感兴趣…{w}这恐怕不是什么好事。"

# game/episode016.rpy:747
translate simplified_chinese ep016_scolguin_fleet_72cfe8d2:

    # c "You know I always like to have an optimistic outlook on things, but I agree."
    c "你知道我一向喜欢乐观看待事物，但我同意你的看法。"

# game/episode016.rpy:748
translate simplified_chinese ep016_scolguin_fleet_5232b905:

    # c "But we're here now, so let's make the best of it."
    c "不过既然已经来了，我们就尽力而为吧。"

# game/episode016.rpy:753
translate simplified_chinese ep016_scolguin_fleet_409410ea:

    # "Céline flew us along the guiding beacons towards one of the larger ships in the Scolguin fleet."
    "瑟琳驾驶我们沿着指引信标飞向斯科尔金舰队中一艘较大的飞船。"

# game/episode016.rpy:755
translate simplified_chinese ep016_scolguin_fleet_bb77eedf:

    # "Blinking lights marked the way inside the belly of the large ship."
    "闪烁的灯光标记着通往这艘大型飞船内部的路径。"

# game/episode016.rpy:757
translate simplified_chinese ep016_scolguin_fleet_10f98c25:

    # "We landed in its hangar bay where several other ships were housed."
    "我们降落在它的机库舱内，那里停放着另外几艘飞船。"

# game/episode016.rpy:759
translate simplified_chinese ep016_scolguin_fleet_a8357c99:

    # "A contingent of Scolguin warriors was already waiting for us when we opened our doors."
    "当我们打开舱门时，一队斯科尔金战士已经在等候我们了。"

# game/episode016.rpy:760
translate simplified_chinese ep016_scolguin_fleet_5b89c15f:

    # "Nadya, Aven and Kit had asked to accompany me to my audience with the Scolguin queen."
    "娜迪亚、艾文和基特请求陪同我一起去面见斯科尔金女王。"

# game/episode016.rpy:762
translate simplified_chinese ep016_scolguin_fleet_9cecffb3:

    # "Surrounded by warriors, we made our way through the ship."
    "在战士们的包围下，我们穿行于飞船内部。"

# game/episode016.rpy:764
translate simplified_chinese ep016_scolguin_fleet_62d64ff5:

    # "While I was merely wary of my surrounding, Nadya seemed to take it all in with the analytical eye of the scientist that she was."
    "虽然我只是对周围环境保持警惕，但娜迪亚似乎以她科学家的分析眼光观察着一切。"

# game/episode016.rpy:765
translate simplified_chinese ep016_scolguin_fleet_a227c007:

    # "The Scolguin didn't display much skill as interior decorators, unless drab colors and slimy webs were one of the trendy hallmarks of the current fashion."
    "斯科尔金人并没有展现出多少室内装饰的技巧，除非单调的色彩和黏糊糊的蛛网是当前流行的时尚标志。"

# game/episode016.rpy:766
translate simplified_chinese ep016_scolguin_fleet_e48681dc:

    # "The throne room appeared to be in the heart of the enormous ship."
    "王座大厅似乎位于这艘巨大飞船的核心区域。"

# game/episode016.rpy:768
translate simplified_chinese ep016_scolguin_fleet_97cdfd4d:

    # "A large throne-like object stood in the middle of a garden of glowing plants."
    "一个类似王座的大型物体矗立在一片发光植物的花园中央。"

# game/episode016.rpy:769
translate simplified_chinese ep016_scolguin_fleet_85f36f3c:

    # "The Scolguin queen was draped on the throne and looked at us through the gloom."
    "斯科尔金女王斜倚在王座上，透过昏暗的光线注视着我们。"

# game/episode016.rpy:772
translate simplified_chinese ep016_scolguin_fleet_23e7a0c3:

    # woman "Welcome, [p_name]."
    woman "欢迎，[p_name]。"

# game/episode016.rpy:773
translate simplified_chinese ep016_scolguin_fleet_2c689836:

    # "The fact that she already knew my name didn't really put me at ease."
    "她早已知道我的名字这一事实并没有让我感到安心。"

# game/episode016.rpy:774
translate simplified_chinese ep016_scolguin_fleet_74a9437e:

    # c "The honor is all mine, your highness."
    c "荣幸之至，陛下。"

# game/episode016.rpy:775
translate simplified_chinese ep016_scolguin_fleet_1a2f4ad8:

    # woman "You are such an interesting little human."
    woman "你这小人类可真有趣。"

# game/episode016.rpy:776
translate simplified_chinese ep016_scolguin_fleet_cfa671b1:

    # "I wasn't sure a response was expected, so instead I let the Scolguin Queen continue to play out that whole creepy alien shtick."
    "我不确定是否需要回应，于是干脆让斯科尔金女王继续她那套诡异的异族把戏。"

# game/episode016.rpy:777
translate simplified_chinese ep016_scolguin_fleet_01322afc:

    # woman "You see, I know all about you."
    woman "要知道，我对你的一切都了如指掌。"

# game/episode016.rpy:780
translate simplified_chinese ep016_scolguin_fleet_6fb8b482:

    # woman "The desertion, searching for your sister, the joy you felt when you found her."
    woman "叛逃舰队，寻找妹妹，找到她时的喜悦。"

# game/episode016.rpy:782
translate simplified_chinese ep016_scolguin_fleet_03dde59f:

    # woman "The desertion, searching for your friend, the joy you felt when you found her."
    woman "叛逃舰队，寻找朋友，找到她时的喜悦。"

# game/episode016.rpy:783
translate simplified_chinese ep016_scolguin_fleet_81888803:

    # woman "And the women you lusted over, oh the great many women!"
    woman "还有你垂涎过的女人们，哦，那可真是数不胜数！"

# game/episode016.rpy:784
translate simplified_chinese ep016_scolguin_fleet_4c932b2e:

    # c "Ah, you're referring to the memories that were stolen from me as I drifted helplessly through space?"
    c "啊，你是指我在太空中无助漂流时被窃取的记忆？"

# game/episode016.rpy:786
translate simplified_chinese ep016_scolguin_fleet_5e6cc9d1:

    # woman "None of the Offerings that were gifted to us to Taste have survived."
    woman "所有献给我们\"品尝\"的祭品都没能存活下来。"

# game/episode016.rpy:787
translate simplified_chinese ep016_scolguin_fleet_f653feff:

    # woman "That makes you unique."
    woman "这让你显得独一无二。"

# game/episode016.rpy:788
translate simplified_chinese ep016_scolguin_fleet_21a3e20d:

    # c "I feel very special."
    c "我深感荣幸。"

# game/episode016.rpy:789
translate simplified_chinese ep016_scolguin_fleet_f7e054a8:

    # "The Queen either missed the sarcasm dripping from my voice, or she chose to ignore it."
    "女王要么没听出我语气中浓重的讽刺意味，要么就是故意无视。"

# game/episode016.rpy:790
translate simplified_chinese ep016_scolguin_fleet_3d5dee3a:

    # woman "Come closer, please."
    woman "请再靠近些。"

# game/episode016.rpy:791
translate simplified_chinese ep016_scolguin_fleet_740a24a4:

    # "I approached the Scolguin Queen while the others waited further back."
    "我向斯科尔金女王走去，其他人则在后方等待。"

# game/episode016.rpy:794
translate simplified_chinese ep016_scolguin_fleet_5725e5df:

    # "The Queen’s voice dropped to a conspirational tone when she next spoke."
    "女王再次开口时，声音压低到密谋般的语调。"

# game/episode016.rpy:795
translate simplified_chinese ep016_scolguin_fleet_79c686ea:

    # woman "Tell me [p_name], does every one of your species desire their own family?"
    woman "告诉我[p_name]，你们种族是否都渴望得到自己的家人？"

# game/episode016.rpy:796
translate simplified_chinese ep016_scolguin_fleet_7a46c418:

    # c "I’m sure there are more than dare to agree."
    c "我确信敢承认的人远不止这些。"

# game/episode016.rpy:797
translate simplified_chinese ep016_scolguin_fleet_4b02177c:

    # "The Queen smiled, apparently satisfied by my answer."
    "女王露出微笑，显然对我的回答很满意。"

# game/episode016.rpy:798
translate simplified_chinese ep016_scolguin_fleet_3b249b52:

    # woman "Why have you come here, what do you desire of us?"
    woman "你们为何来此，对我们有何所求？"

# game/episode016.rpy:799
translate simplified_chinese ep016_scolguin_fleet_cf97bb3e:

    # c "The deal you’ve struck with my father, the one who tossed me out into space, I want to know what he knows."
    c "你与我父亲—那个把我扔进太空的人—达成的交易，我想知道他掌握了什么信息。"

# game/episode016.rpy:801
translate simplified_chinese ep016_scolguin_fleet_3e358d59:

    # woman "You desire the knowledge sought by your father?"
    woman "你渴望获得你父亲所追寻的知识？"

# game/episode016.rpy:802
translate simplified_chinese ep016_scolguin_fleet_e7dd5805:

    # c "I do, your highness."
    c "是的，陛下。"

# game/episode016.rpy:804
translate simplified_chinese ep016_scolguin_fleet_f9bdb237:

    # woman "The sacrificial contract between the Scolguin Empire and Supplicant is sacred and confidential."
    woman "斯科尔金帝国与祈求者之间的献祭契约是神圣且保密的。"

# game/episode016.rpy:805
translate simplified_chinese ep016_scolguin_fleet_9463b948:

    # c "I’m sure it is, but I believe we can come to an arrangement."
    c "我确信如此，但我相信我们可以达成某种安排。"

# game/episode016.rpy:806
translate simplified_chinese ep016_scolguin_fleet_df486e05:

    # woman "We can?"
    woman "我们可以？"

# game/episode016.rpy:808
translate simplified_chinese ep016_scolguin_fleet_f97af5d5:

    # woman "Such confidence."
    woman "好大的信心。"

# game/episode016.rpy:810
translate simplified_chinese ep016_scolguin_fleet_0dc64703:

    # woman "What do you offer?"
    woman "你能提供什么？"

# game/episode016.rpy:811
translate simplified_chinese ep016_scolguin_fleet_105a5b33:

    # "The Scolguin Queen didn’t shut me down immediately, which made me wonder just how sacred and confidential those contracts actually were."
    "斯科尔金女王没有立刻拒绝我，这让我不禁怀疑这些契约到底有多神圣和机密。"

# game/episode016.rpy:812
translate simplified_chinese ep016_scolguin_fleet_15115588:

    # "Nevertheless, I felt I needed to offer her something substantial."
    "尽管如此，我觉得必须给她提供些实质性的东西。"

# game/episode016.rpy:813
translate simplified_chinese ep016_scolguin_fleet_2015eb64:

    # c "Your Highness has already expressed her intrigue regarding my life."
    c "殿下已经对我的生平表示了兴趣。"

# game/episode016.rpy:814
translate simplified_chinese ep016_scolguin_fleet_f33a698a:

    # c "And whatever else you can say about my life so far, it has certainly been interesting."
    c "无论你如何评价我至今的人生，它确实充满精彩。"

# game/episode016.rpy:815
translate simplified_chinese ep016_scolguin_fleet_0e954944:

    # c "I’m fairly confident it will remain interesting for the foreseeable future."
    c "我相当确信在可预见的未来，这种精彩仍将持续。"

# game/episode016.rpy:816
translate simplified_chinese ep016_scolguin_fleet_dcccd0bf:

    # c "So I’m offering you the experiences of my life for the next ten years."
    c "因此我愿献上未来十年的人生经历。"

# game/episode016.rpy:818
translate simplified_chinese ep016_scolguin_fleet_11b72724:

    # c "We trade the information my father received and then I will leave, to return in ten years time to subject myself to whatever mind rape needed to extract the new memories I’ve made."
    c "我们交换我父亲获得的信息，然后我将离开，十年后回来承受任何必要的记忆提取—无论需要何种精神侵入来获取我新创造的记忆。"

# game/episode016.rpy:819
translate simplified_chinese ep016_scolguin_fleet_0987115f:

    # "I heard gasping behind my back and the Queen regarded me in silence."
    "我听见身后传来倒吸冷气的声音，女王沉默地注视着我。"

# game/episode016.rpy:820
translate simplified_chinese ep016_scolguin_fleet_4b658f36:

    # "When she spoke again, I could see the hungry glitter in her eyes."
    "当她再次开口时，我能看见她眼中闪烁的饥渴光芒。"

# game/episode016.rpy:821
translate simplified_chinese ep016_scolguin_fleet_17d9cb13:

    # woman "An enticing promise."
    woman "一个诱人的承诺。"

# game/episode016.rpy:823
translate simplified_chinese ep016_scolguin_fleet_a7e1e220:

    # woman "How will you keep it?"
    woman "你如何保证履行？"

# game/episode016.rpy:824
translate simplified_chinese ep016_scolguin_fleet_022e0a78:

    # c "I’m willing to offer it in writing, or by any other means you deem satisfactory."
    c "我愿意以书面形式承诺，或采用任何您认为满意的方式。"

# game/episode016.rpy:825
translate simplified_chinese ep016_scolguin_fleet_d6b7e9fa:

    # woman "But what if you die before the ten years are out?"
    woman "但如果你在十年期满前就死了呢？"

# game/episode016.rpy:826
translate simplified_chinese ep016_scolguin_fleet_dadeb206:

    # c "That is a risk you have to take, your highness."
    c "这是您必须承担的风险，陛下。"

# game/episode016.rpy:827
translate simplified_chinese ep016_scolguin_fleet_e05254fd:

    # c "I can only promise I will return in ten years, my untimely death is something I’d like to avoid as well, so we have a mutual interest in that regard."
    c "我只能承诺十年后一定回来，我也不希望自己英年早逝，所以在这方面我们利益一致。"

# game/episode016.rpy:829
translate simplified_chinese ep016_scolguin_fleet_b29cfea8:

    # woman "An alluring offer, which the Scolguin Empire accepts."
    woman "一个诱人的提议，斯科尔金帝国接受了。"

# game/episode016.rpy:830
translate simplified_chinese ep016_scolguin_fleet_e4344522:

    # woman "A contract for you to sign will be drafted shortly."
    woman "马上会起草一份需要你签署的契约。"

# game/episode016.rpy:831
translate simplified_chinese ep016_scolguin_fleet_ead546a8:

    # c "Excellent."
    c "太好了。"

# game/episode016.rpy:833
translate simplified_chinese ep016_scolguin_fleet_c7d5d277:

    # na "No!{w} Wait!"
    na "不！{w} 等等！"

# game/episode016.rpy:835
translate simplified_chinese ep016_scolguin_fleet_0fd70fb4:

    # "The obvious breach of protocol by my mother didn’t have any serious repercussions, other than startling the Queen."
    "我母亲这次明显的失礼行为除了让女王受惊外，并未造成严重后果。"

# game/episode016.rpy:837
translate simplified_chinese ep016_scolguin_fleet_ecc93874:

    # "The obvious breach of protocol by Nadya didn’t have any serious repercussions, other than startling the Queen."
    "娜迪亚这次明显的失礼行为除了让女王受惊外，并未造成严重后果。"

# game/episode016.rpy:838
translate simplified_chinese ep016_scolguin_fleet_e5756f7e:

    # na "Your majesty, allow me to speak on my behalf."
    na "陛下，请允许我为自己辩护。"

# game/episode016.rpy:839
translate simplified_chinese ep016_scolguin_fleet_075f9854:

    # woman "Approach."
    woman "上前。"

# game/episode016.rpy:841
translate simplified_chinese ep016_scolguin_fleet_128ba0fb:

    # "Nadya glanced at me nervously as she passed me and stood before the Queen."
    "娜迪亚经过我身边时紧张地看了我一眼，然后站在女王面前。"

# game/episode016.rpy:842
translate simplified_chinese ep016_scolguin_fleet_cf178ab5:

    # woman "Speak."
    woman "说吧。"

# game/episode016.rpy:843
translate simplified_chinese ep016_scolguin_fleet_2dd233e4:

    # na "Pick me instead, your highness."
    na "选我吧，陛下。"

# game/episode016.rpy:844
translate simplified_chinese ep016_scolguin_fleet_22cc3232:

    # na "I’ve lived a full life and my mind is as of yet untouched by the Scolguin Taste."
    na "我已经活够本了，而且我的思想尚未被斯科尔金品尝过。"

# game/episode016.rpy:846
translate simplified_chinese ep016_scolguin_fleet_54fc8102:

    # woman "A virgin mind."
    woman "处子般纯洁的心灵。"

# game/episode016.rpy:848
translate simplified_chinese ep016_scolguin_fleet_a3b1ccfa:

    # woman "You would agree to the same deal offered by your son?"
    woman "你愿意接受与你儿子相同的条件吗？"

# game/episode016.rpy:850
translate simplified_chinese ep016_scolguin_fleet_0c18dfd4:

    # woman "You would agree to the same deal offered by your friend?"
    woman "你愿意接受与你朋友相同的条件吗？"

# game/episode016.rpy:852
translate simplified_chinese ep016_scolguin_fleet_d60bb6b5:

    # na "I would."
    na "我愿意。"

# game/episode016.rpy:854
translate simplified_chinese ep016_scolguin_fleet_b23fc5c5:

    # woman "Your offer is acceptable."
    woman "你的提议可以接受。"

# game/episode016.rpy:855
translate simplified_chinese ep016_scolguin_fleet_d37eea3e:

    # woman "I’ll leave it to you both to determine who will have the honor to present themselves in ten years time."
    woman "我会让你们两人来决定，十年后谁将有幸前来觐见。"

# game/episode016.rpy:856
translate simplified_chinese ep016_scolguin_fleet_7e0cea96:

    # woman "But make it quick, as I tire of these deliberations."
    woman "但请速速决定，我已厌倦这些商议。"

# game/episode016.rpy:858
translate simplified_chinese ep016_scolguin_fleet_9708c943:

    # "We sequestered ourselves in a corner of the throne room for a short, but heated debate."
    "我们在王座厅的一角私下进行了短暂而激烈的争论。"

# game/episode016.rpy:860
translate simplified_chinese ep016_scolguin_fleet_47f6f858:

    # av "What were you both thinking, offering yourselves up like that?!"
    av "你们俩都在想什么，居然这样主动献身？！"

# game/episode016.rpy:861
translate simplified_chinese ep016_scolguin_fleet_739de70d:

    # av "This is beyond stupidity."
    av "这简直愚不可及。"

# game/episode016.rpy:862
translate simplified_chinese ep016_scolguin_fleet_dfcd8949:

    # c "It’s necessary, how else are we going to find out what Agust is up to?"
    c "这是必要的，不然我们怎么查明阿古斯特在搞什么鬼？"

# game/episode016.rpy:864
translate simplified_chinese ep016_scolguin_fleet_24a6595c:

    # na "Agreed, but it shouldn’t be you."
    na "同意，但那个人不该是你。"

# game/episode016.rpy:865
translate simplified_chinese ep016_scolguin_fleet_78c0d3b9:

    # na "You’ve suffered under the invasive Scolguin procedure already, I can’t allow you to do it a second time."
    na "你已经在斯科尔金的侵入式手术中受过苦了，我不能让你再经历第二次。"

# game/episode016.rpy:866
translate simplified_chinese ep016_scolguin_fleet_1453c6e4:

    # c "This time it’s voluntarily."
    c "这次是自愿的。"

# game/episode016.rpy:867
translate simplified_chinese ep016_scolguin_fleet_cbb9c62e:

    # na "You shouldn’t be the one doing this."
    na "不该由你来承担这件事。"

# game/episode016.rpy:869
translate simplified_chinese ep016_scolguin_fleet_ce3f884b:

    # av "And you should?"
    av "那你来吗？"

# game/episode016.rpy:871
translate simplified_chinese ep016_scolguin_fleet_ef5a2e98:

    # na "I’m the oldest member of the crew."
    na "我是船员里年纪最大的。"

# game/episode016.rpy:872
translate simplified_chinese ep016_scolguin_fleet_cffa7a51:

    # na "I’ve lived a full life and-"
    na "我已经活够本了，而且—"

# game/episode016.rpy:874
translate simplified_chinese ep016_scolguin_fleet_3db1e4f3:

    # av "Cut the crap, mother, you sound like you’re on your deathbed."
    av "别胡扯了，老妈，说得好像你快咽气似的。"

# game/episode016.rpy:876
translate simplified_chinese ep016_scolguin_fleet_9682f432:

    # av "Cut the crap, Nadya, you sound like you’re on your deathbed."
    av "别胡扯了，娜迪亚，说得好像你快咽气似的。"

# game/episode016.rpy:877
translate simplified_chinese ep016_scolguin_fleet_0adb2a79:

    # na "It's a simple fact, Aven."
    na "这是事实，艾文。"

# game/episode016.rpy:878
translate simplified_chinese ep016_scolguin_fleet_bfe70646:

    # na "You all have a long life ahead of you."
    na "你们都还有大好人生。"

# game/episode016.rpy:879
translate simplified_chinese ep016_scolguin_fleet_7d76d6d4:

    # na "Besides, it's not like the procedure will kill me."
    na "再说了，这手术又不会要我的命。"

# game/episode016.rpy:881
translate simplified_chinese ep016_scolguin_fleet_76edc4ed:

    # av "Don't you have anything to say?"
    av "你没什么要说的吗？"

# game/episode016.rpy:883
translate simplified_chinese ep016_scolguin_fleet_47c220a6:

    # ki "Who, me?"
    ki "谁，我吗？"

# game/episode016.rpy:885
translate simplified_chinese ep016_scolguin_fleet_613ae528:

    # av "No, the other silent guy in our group staring like he's just been lobotomized."
    av "不，是咱们组里另一个沉默的家伙，瞪着眼睛像刚被切除前额叶似的。"

# game/episode016.rpy:887
translate simplified_chinese ep016_scolguin_fleet_b4fd90e2:

    # ki "Right, well, if you put it that way, I think you're both crazy."
    ki "好吧，既然你这么说，我觉得你们俩都疯了。"

# game/episode016.rpy:888
translate simplified_chinese ep016_scolguin_fleet_116b21df:

    # ki "[p_name_short], like you told 'her majesty' over there, you've just been mindraped and now you're asking for another round?"
    ki "[p_name_short]，就像你跟那边的\"女王陛下\"说过的，你刚被精神强奸，现在又要再来一轮？"

# game/episode016.rpy:889
translate simplified_chinese ep016_scolguin_fleet_b21caacc:

    # ki "And you, Nadya, you're volunteering for something that's obviously so invasive."
    ki "还有你，娜迪亚，你居然自愿接受这种明显极具侵入性的手术。"

# game/episode016.rpy:890
translate simplified_chinese ep016_scolguin_fleet_b0ddfde8:

    # c "What's your alternative then?"
    c "那你有什么更好的办法？"

# game/episode016.rpy:892
translate simplified_chinese ep016_scolguin_fleet_d50c599c:

    # av "There must be something."
    av "肯定有其他选择的。"

# game/episode016.rpy:893
translate simplified_chinese ep016_scolguin_fleet_d9bb5492:

    # c "This is the most solid lead we have."
    c "这是我们手头最可靠的线索。"

# game/episode016.rpy:894
translate simplified_chinese ep016_scolguin_fleet_57fccfcc:

    # c "The alternative is to keep flailing around in the dark and wait for either Agust or the Confessor to catch up and pulverize us."
    c "否则我们就只能在黑暗中瞎摸索，等着阿古斯特或者\"忏悔者\"追上来把我们碾成粉末。"

# game/episode016.rpy:896
translate simplified_chinese ep016_scolguin_fleet_f2ad077b:

    # na "Exactly."
    na "没错。"

# game/episode016.rpy:901
translate simplified_chinese ep016_scolguin_fleet_0f4e5863:

    # "Shifting the responsibility towards Nadya seemed like the coward's way out, but her argument made sense."
    "把责任推给娜迪亚看起来像是懦夫的做法，但她的论点确实有道理。"

# game/episode016.rpy:902
translate simplified_chinese ep016_scolguin_fleet_c3d075b9:

    # "Ten years was a long time, long enough to maybe find a loophole to get out of this sordid deal."
    "十年时间很长，长到或许能找到摆脱这肮脏交易的漏洞。"

# game/episode016.rpy:903
translate simplified_chinese ep016_scolguin_fleet_bd3b9cdf:

    # c "Are you sure you want to do this?"
    c "你确定要这么做吗？"

# game/episode016.rpy:905
translate simplified_chinese ep016_scolguin_fleet_81963ec2:

    # na "I am."
    na "我确定。"

# game/episode016.rpy:906
translate simplified_chinese ep016_scolguin_fleet_10656a05:

    # c "In that case I'm going to allow amending the deal."
    c "既然如此，我允许修改协议。"

# game/episode016.rpy:907
translate simplified_chinese ep016_scolguin_fleet_f8599a4f:

    # c "We'll find a way to get out of it before the ten-year term is up though."
    c "但我们会在十年期满前找到脱身之法。"

# game/episode016.rpy:909
translate simplified_chinese ep016_scolguin_fleet_11756f6f:

    # "I could see the dismay in Aven’s eyes, but when my sister next spoke, she sounded resigned."
    "我能看见艾文眼中的沮丧，但当我妹妹再次开口时，她的语气透着认命。"

# game/episode016.rpy:911
translate simplified_chinese ep016_scolguin_fleet_a8adf9e7:

    # "I could see the dismay in Aven’s eyes, but when she next spoke, she sounded resigned."
    "我能看见艾文眼中的沮丧，但当她再次开口时，她的语气透着认命。"

# game/episode016.rpy:913
translate simplified_chinese ep016_scolguin_fleet_e7f0f13b:

    # av "We simply must."
    av "我们必须这么做。"

# game/episode016.rpy:915
translate simplified_chinese ep016_scolguin_fleet_db20d9f4:

    # na "Alright, let's do this."
    na "好吧，我们开始吧。"

# game/episode016.rpy:916
translate simplified_chinese ep016_scolguin_fleet_5d258918:

    # "We approached the Queen again."
    "我们再次走向女王。"

# game/episode016.rpy:918
translate simplified_chinese ep016_scolguin_fleet_8c8b89d3:

    # c "As I am the commanding officer and just brokered the deal, I'm going to make an executive decision."
    c "既然我是指挥官并且刚刚促成了这笔交易，我将做出行政决定。"

# game/episode016.rpy:919
translate simplified_chinese ep016_scolguin_fleet_3ac6d989:

    # c "The deal stands as it is, I'm going back in ten years."
    c "交易保持不变，我将在十年后回来。"

# game/episode016.rpy:920
translate simplified_chinese ep016_scolguin_fleet_51e02df5:

    # c "And I'm pretty sure we'll find a loophole somewhere to get out of this deal before the term is up."
    c "而且我很确定我们会在期限到期前找到漏洞来摆脱这笔交易。"

# game/episode016.rpy:921
translate simplified_chinese ep016_scolguin_fleet_1060a349:

    # "I could see the dismay in the eyes of both Nadya and Aven, Kit looked like he was about to argue."
    "我能看到娜迪亚和艾文眼中的沮丧，基特看起来想要争辩。"

# game/episode016.rpy:922
translate simplified_chinese ep016_scolguin_fleet_809df9c3:

    # "They kept silent though and allowed me to approach the Queen."
    "但他们保持沉默，允许我接近女王。"

# game/episode016.rpy:924
translate simplified_chinese ep016_scolguin_fleet_4fd61473:

    # woman "Have you reached a decision?"
    woman "你们做出决定了吗？"

# game/episode016.rpy:925
translate simplified_chinese ep016_scolguin_fleet_29cf02ab:

    # c "We have, your majesty."
    c "我们决定了，陛下。"

# game/episode016.rpy:927
translate simplified_chinese ep016_scolguin_fleet_b9559b80:

    # c "We'd like to amend the deal."
    c "我们希望修改交易条款。"

# game/episode016.rpy:928
translate simplified_chinese ep016_scolguin_fleet_50fd5c4d:

    # c "Nadya will return in ten years time to undergo the Tasting."
    c "娜迪亚将在十年后回来接受\"品尝\"仪式。"

# game/episode016.rpy:930
translate simplified_chinese ep016_scolguin_fleet_4ea1b34e:

    # c "The deal stands as it is."
    c "交易保持不变。"

# game/episode016.rpy:931
translate simplified_chinese ep016_scolguin_fleet_5b97e80b:

    # c "I will return in ten years time to undergo another Tasting."
    c "我会在十年后回来接受另一次\"品尝\"。"

# game/episode016.rpy:933
translate simplified_chinese ep016_scolguin_fleet_9823fc46:

    # woman "Good."
    woman "很好。"

# game/episode016.rpy:934
translate simplified_chinese ep016_scolguin_fleet_1e3bb4fe:

    # woman "We will order everything in writing and send the documents for you to sign to your vessel."
    woman "我们会将所有条款以书面形式整理好，并将文件送至您的飞船上供您签署。"

# game/episode016.rpy:936
translate simplified_chinese ep016_scolguin_fleet_ea68c4ec:

    # woman "Once signed, a package containing the information you desire will be forwarded."
    woman "签署完成后，包含您所需信息的资料包将会转发给您。"

# game/episode016.rpy:938
translate simplified_chinese ep016_scolguin_fleet_0f2b1330:

    # "With those words the audience was over and we were dismissed."
    "说完这些，觐见就结束了，我们被打发离开。"

# game/episode016.rpy:940
translate simplified_chinese ep016_scolguin_fleet_c26834f0:

    # "The Scolguin escorted us back to the ship, where we waited for the contract to arrive."
    "斯科尔金人护送我们返回飞船，我们在那里等待合同送达。"

# game/episode016.rpy:942
translate simplified_chinese ep016_scolguin_fleet_283ea2d5:

    # "After half an hour, a Scolguin clerk approached the Bastard and presented us with a tablet containing legal documents."
    "半小时后，一名斯科尔金办事员走近\"私生子\"号，向我们展示了一块载有法律文件的平板。"

# game/episode016.rpy:944
translate simplified_chinese ep016_scolguin_fleet_a7223ff2:

    # "Nadya and I read over the document several times and she ultimately signed at the indicated spots."
    "娜迪亚和我将文件反复阅读了几遍，她最终在指定位置签了字。"

# game/episode016.rpy:946
translate simplified_chinese ep016_scolguin_fleet_9eeade3b:

    # "I read over the document several times and ultimately signed at the indicated spots."
    "我将文件反复阅读了几遍，最终在指定位置签了字。"

# game/episode016.rpy:948
translate simplified_chinese ep016_scolguin_fleet_a8bc5d74:

    # "The clerk headed back into the bowels of the Scolguin ship, leaving us to wait on the promised data."
    "办事员返回斯科尔金飞船的内部，留下我们等待承诺的数据。"

# game/episode016.rpy:950
translate simplified_chinese ep016_scolguin_fleet_4f79394c:

    # "The Scolguin took their sweet time, but eventually a message arrived."
    "斯科尔金人磨蹭了好一阵子，但消息最终还是到了。"

# game/episode016.rpy:952
translate simplified_chinese ep016_scolguin_fleet_b7c7ed0b:

    # ce "The Scolguin are asking us to accept a data package."
    ce "斯科尔金人要求我们接收一个数据包。"

# game/episode016.rpy:953
translate simplified_chinese ep016_scolguin_fleet_656322b7:

    # c "Is it legit?"
    c "这靠谱吗？"

# game/episode016.rpy:954
translate simplified_chinese ep016_scolguin_fleet_fa40b707:

    # ce "Our initial scans show it’s just data."
    ce "初步扫描显示这只是普通数据。"

# game/episode016.rpy:955
translate simplified_chinese ep016_scolguin_fleet_5d10d844:

    # c "Accept the transfer and let Jade have a look at it first."
    c "接受传输，先让杰德检查一下。"

# game/episode016.rpy:956
translate simplified_chinese ep016_scolguin_fleet_c15bb9f6:

    # ce "Alright."
    ce "好吧。"

# game/episode016.rpy:958
translate simplified_chinese ep016_scolguin_fleet_bef5a625:

    # "I summoned Jade to the bridge and she got to work on one of the consoles."
    "我把杰德叫到舰桥，她立刻在控制台前忙活起来。"

# game/episode016.rpy:959
translate simplified_chinese ep016_scolguin_fleet_b11a50c1:

    # "Nadya joined us a while later, after hearing of the discovery."
    "娜迪亚听闻发现后，稍晚也来到了我们这里。"

# game/episode016.rpy:961
translate simplified_chinese ep016_scolguin_fleet_d56cffde:

    # j "Nothing seems to be out of the ordinary."
    j "看起来没什么异常。"

# game/episode016.rpy:962
translate simplified_chinese ep016_scolguin_fleet_257fecaa:

    # j "It’s navigational data, text and some images."
    j "是导航数据、文本和一些图片。"

# game/episode016.rpy:963
translate simplified_chinese ep016_scolguin_fleet_a2fb7961:

    # c "What does it say?"
    c "上面说了什么？"

# game/episode016.rpy:965
translate simplified_chinese ep016_scolguin_fleet_a4156d12:

    # j "The Scolguin provided your father with information on a certain ancient gateway."
    j "斯科尔金人曾向你父亲提供过一个关于某个远古传送门的信息。"

# game/episode016.rpy:966
translate simplified_chinese ep016_scolguin_fleet_b30405ee:

    # j "The package contains several descriptions of the gateway by various people, presumably experiences stolen from the many sacrifices offered to the Scolguin."
    j "这个数据包里包含了多个人对传送门的描述，很可能是从献给斯科尔金人的众多祭品那里窃取来的经历。"

# game/episode016.rpy:967
translate simplified_chinese ep016_scolguin_fleet_89aec3c1:

    # c "A gateway to where?"
    c "通往哪里的传送门？"

# game/episode016.rpy:969
translate simplified_chinese ep016_scolguin_fleet_3e1d2a62:

    # j "That isn’t specified, only the location of the gate."
    j "没有具体说明，只给出了传送门的位置。"

# game/episode016.rpy:970
translate simplified_chinese ep016_scolguin_fleet_d866ffab:

    # c "So it’s a space gate?"
    c "所以是个太空传送门？"

# game/episode016.rpy:971
translate simplified_chinese ep016_scolguin_fleet_5a8c8afb:

    # j "No, it’s a planet-bound structure somewhere in the Hawwa cluster."
    j "不，是位于哈瓦星团某处的行星固定建筑。"

# game/episode016.rpy:972
translate simplified_chinese ep016_scolguin_fleet_bd62df20:

    # c "That’s not Sovereignty-occupied space, is it?"
    c "那不是\"至高权域\"占领的空间，对吧？"

# game/episode016.rpy:974
translate simplified_chinese ep016_scolguin_fleet_8f34c340:

    # ce "No, the Hawwa cluster is independent."
    ce "不是，哈瓦星团是独立的。"

# game/episode016.rpy:975
translate simplified_chinese ep016_scolguin_fleet_65ee123f:

    # ce "It’s the home of the Taagmar and not even remotely close to Sovereignty space."
    ce "那里是塔格玛人的家园，离\"至高权域\"空间还很远。"

# game/episode016.rpy:976
translate simplified_chinese ep016_scolguin_fleet_b4d54398:

    # c "What’s that old bastard up to?"
    c "那个老混蛋在搞什么鬼？"

# game/episode016.rpy:978
translate simplified_chinese ep016_scolguin_fleet_538711e7:

    # na "No good, probably."
    na "多半没安好心。"

# game/episode016.rpy:979
translate simplified_chinese ep016_scolguin_fleet_a540aa60:

    # na "I can’t imagine the Taagmar welcoming the Sovereignty with open arms."
    na "我无法想象塔格玛人会张开双臂欢迎\"至高权域\"。"

# game/episode016.rpy:980
translate simplified_chinese ep016_scolguin_fleet_0f99c754:

    # c "You know of them?"
    c "你了解他们？"

# game/episode016.rpy:981
translate simplified_chinese ep016_scolguin_fleet_840120eb:

    # na "Yes, I’ve visited their homeworld once."
    na "是的，我曾去过他们的母星一次。"

# game/episode016.rpy:982
translate simplified_chinese ep016_scolguin_fleet_68f256fa:

    # na "Their technology isn’t that advanced and they’re mostly confined to their planet."
    na "他们的科技并不发达，大多局限于自己的星球。"

# game/episode016.rpy:983
translate simplified_chinese ep016_scolguin_fleet_3582703c:

    # na "It’s an old civilization though, so the existence of an old gateway doesn’t surprise me."
    na "不过那是个古老文明，所以存在古老传送门并不让我意外。"

# game/episode016.rpy:985
translate simplified_chinese ep016_scolguin_fleet_a177e106:

    # ce "Why would he seek out something like that?"
    ce "他为什么要寻找这种东西？"

# game/episode016.rpy:986
translate simplified_chinese ep016_scolguin_fleet_23917e82:

    # na "Like the gates in space, there are several planet-bound ones, part of a separate network."
    na "就像太空中的星门一样，地面上也有几个传送门，属于另一个网络系统。"

# game/episode016.rpy:987
translate simplified_chinese ep016_scolguin_fleet_346d7fcd:

    # na "Unlike the space gates, the terrestrial portals only provide access to one specific destination."
    na "与太空星门不同，地面传送门只能通往一个特定目的地。"

# game/episode016.rpy:988
translate simplified_chinese ep016_scolguin_fleet_b6ca9504:

    # c "So Agust has a keen interest in one specific gate that’s right in the middle of an alien civilization."
    c "所以阿古斯特对一座正好位于外星文明中心的特定星门有着浓厚兴趣。"

# game/episode016.rpy:989
translate simplified_chinese ep016_scolguin_fleet_546fa35f:

    # c "I wonder how much of the Hawwa cluster is still intact after the Sovereignty has stomped around in it..."
    c "我想知道在\"至高权域\"舰队踏足之后，哈瓦星团还有多少区域保持完好…"

# game/episode016.rpy:990
translate simplified_chinese ep016_scolguin_fleet_245369f7:

    # c "I guess there’s only one way to find out."
    c "我想只有一个办法能知道了。"

# game/episode016.rpy:992
translate simplified_chinese ep016_scolguin_fleet_38b0e80c:

    # ce "We’re going in, aren’t we?"
    ce "我们要进去，对吧？"

# game/episode016.rpy:993
translate simplified_chinese ep016_scolguin_fleet_fa9c380b:

    # c "Yes, that’s the plan."
    c "是的，计划就是这样。"

# game/episode016.rpy:994
translate simplified_chinese ep016_scolguin_fleet_f089f460:

    # c "But I want to know more about the situation in the Hawwa cluster first."
    c "但我想先了解哈瓦星团的详细情况。"

# game/episode016.rpy:995
translate simplified_chinese ep016_scolguin_fleet_562a9320:

    # c "I don’t want us to walk into a trap."
    c "我可不想让我们落入陷阱。"

# game/episode016.rpy:996
translate simplified_chinese ep016_scolguin_fleet_6959cdda:

    # c "Plot a course to a space station near the Hawwa cluster so we can put out some feelers."
    c "设定前往哈瓦星团附近某个空间站的航线，这样我们就能打探些消息。"

# game/episode016.rpy:997
translate simplified_chinese ep016_scolguin_fleet_e5a13291:

    # ce "Of course."
    ce "当然。"

# game/episode016.rpy:999
translate simplified_chinese ep016_scolguin_fleet_9e5cae44:

    # "Céline found us a space station that was close enough to the Hawwa cluster, but still far removed from any accidental run-ins with Sovereignty ships."
    "瑟琳为我们找到了一个足够靠近哈瓦星团的空间站，但又远离任何可能与\"至高权域\"飞船意外相遇的区域。"

# game/episode016.rpy:1007
translate simplified_chinese ep016_altum_approach_55eaecb5:

