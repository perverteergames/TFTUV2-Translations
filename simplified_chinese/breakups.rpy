# game/breakups.rpy:9
translate simplified_chinese breakup_lilly_7a9d1306:

    # l "Did you come to visit your favorite sister?"
    l "你是来看望你最爱的妹妹吗？"

# game/breakups.rpy:11
translate simplified_chinese breakup_lilly_1d601f41:

    # l "Did you come to visit your favorite girl?"
    l "你是来看望你最爱的姑娘吗？"

# game/breakups.rpy:12
translate simplified_chinese breakup_lilly_89048451:

    # c "Lilly, I-"
    c "莉莉，我—"

# game/breakups.rpy:13
translate simplified_chinese breakup_lilly_727fe754:

    # l "I was hoping for a kiss first."
    l "我本来期待先来个吻的。"

# game/breakups.rpy:15
translate simplified_chinese breakup_lilly_0138559e:

    # l "What’s the matter?"
    l "怎么了？"

# game/breakups.rpy:16
translate simplified_chinese breakup_lilly_09206561:

    # c "Us...{w} It’s us."
    c "我们…{w} 是我们之间的问题。"

# game/breakups.rpy:17
translate simplified_chinese breakup_lilly_93af30ce:

    # c "I don’t think this is working."
    c "我觉得这样行不通了。"

# game/breakups.rpy:18
translate simplified_chinese breakup_lilly_030d74ce:

    # l "What are you talking about?!"
    l "你在说什么啊？！"

# game/breakups.rpy:19
translate simplified_chinese breakup_lilly_0f13e93d:

    # l "Of course it is."
    l "当然行得通。"

# game/breakups.rpy:20
translate simplified_chinese breakup_lilly_8bef2e86:

    # c "We have to end things, Lilly."
    c "我们必须结束这段关系，莉莉。"

# game/breakups.rpy:22
translate simplified_chinese breakup_lilly_0c6284e1:

    # l "No, we don’t."
    l "不，我们不需要。"

# game/breakups.rpy:23
translate simplified_chinese breakup_lilly_e037c471:

    # l "Last time you told me how you loved me and now you’re saying we have to end things?"
    l "上次你还告诉我你有多爱我，现在却说我们要结束？"

# game/breakups.rpy:24
translate simplified_chinese breakup_lilly_6df9dc3f:

    # l "You’re not making any sense."
    l "你简直莫名其妙。"

# game/breakups.rpy:25
translate simplified_chinese breakup_lilly_80de82df:

    # c "I have to make a choice."
    c "我必须做出选择。"

# game/breakups.rpy:27
translate simplified_chinese breakup_lilly_52ef2e5b:

    # l "What choice?"
    l "什么选择？"

# game/breakups.rpy:28
translate simplified_chinese breakup_lilly_b380ec2a:

    # l "Is there someone else?{w} There’s someone else isn’t there?"
    l "是有别人了吗？{w}有别人了对吧？"

# game/breakups.rpy:29
translate simplified_chinese breakup_lilly_ad8d0c81:

    # l "Who is it?"
    l "是谁？"

# game/breakups.rpy:30
translate simplified_chinese breakup_lilly_049d1dc1:

    # c "It’s Céline."
    c "是瑟琳。"

# game/breakups.rpy:32
translate simplified_chinese breakup_lilly_6b419aaa:

    # l "Oh."
    l "哦。"

# game/breakups.rpy:33
translate simplified_chinese breakup_lilly_82822a0c:

    # l "..."
    l "..."

# game/breakups.rpy:35
translate simplified_chinese breakup_lilly_5e4a1d1a:

    # l "You miserable piece of shit!"
    l "你这可恶的混蛋！"

# game/breakups.rpy:36
translate simplified_chinese breakup_lilly_6cbc0c1b:

    # l "First you seduce me into letting my guard down, telling me to follow my feelings."
    l "先是引诱我放下防备，让我跟着感觉走。"

# game/breakups.rpy:37
translate simplified_chinese breakup_lilly_842e13b2:

    # l "I gave myself completely to you [p_name]!"
    l "我把整个人都交给了你[p_name]！"

# game/breakups.rpy:38
translate simplified_chinese breakup_lilly_28bd81ff:

    # l "And now you’re telling me you want to be with Céline."
    l "现在你却告诉我你想和瑟琳在一起。"

# game/breakups.rpy:39
translate simplified_chinese breakup_lilly_bc3babae:

    # c "Yes, I-"
    c "是的，我-"

# game/breakups.rpy:40
translate simplified_chinese breakup_lilly_a22a784b:

    # l "Well fuck you, you selfish fucking piece of trash."
    l "去你妈的，你这自私的混蛋。"

# game/breakups.rpy:41
translate simplified_chinese breakup_lilly_3c7597f2:

    # l "I hope you both choke."
    l "祝你们俩都不得好死。"

# game/breakups.rpy:42
translate simplified_chinese breakup_lilly_5681801e:

    # c "I-"
    c "我-"

# game/breakups.rpy:44
translate simplified_chinese breakup_lilly_e47b24d7:

    # l "GET.{w} THE.{w} FUCK.{w} OUT.{w} OF.{w} HERE!"
    l "给.{w}我.{w}滚.{w}出.{w}去.{w}！"

# game/breakups.rpy:46
translate simplified_chinese breakup_lilly_47e3b86d:

    # "When I closed the door to her quarters, I heard something crash against the wall, followed by Lilly wailing in rage."
    "当我关上她舱门时，听到有东西砸在墙上，紧接着传来莉莉愤怒的哭嚎。"

# game/breakups.rpy:55
translate simplified_chinese breakup_aven_443c7b5a:

    # av "Hey!"
    av "喂！"

# game/breakups.rpy:56
translate simplified_chinese breakup_aven_6190f4db:

    # c "Hey."
    c "嘿。"

# game/breakups.rpy:58
translate simplified_chinese breakup_aven_adfb5d9a:

    # av "Why do you look so serious?"
    av "你为什么表情这么严肃？"

# game/breakups.rpy:59
translate simplified_chinese breakup_aven_e7a195f0:

    # c "I think it’s better if we sit down."
    c "我觉得我们最好坐下来谈。"

# game/breakups.rpy:60
translate simplified_chinese breakup_aven_d2036769:

    # av "No, I’m fine right here."
    av "不，我站着就行。"

# game/breakups.rpy:61
translate simplified_chinese breakup_aven_501fb853:

    # av "Say what you have to say."
    av "有话直说吧。"

# game/breakups.rpy:62
translate simplified_chinese breakup_aven_ef51c996:

    # c "Aven, what we have."
    c "艾文，我们之间这样。"

# game/breakups.rpy:63
translate simplified_chinese breakup_aven_113d904d:

    # c "The relationship we have-"
    c "我们的关系—"

# game/breakups.rpy:64
translate simplified_chinese breakup_aven_7800539c:

    # c "It has to stop."
    c "必须到此为止。"

# game/breakups.rpy:66
translate simplified_chinese breakup_aven_f9b46ebc:

    # av "No.{w} No.{w} Why?"
    av "不。{w} 不。{w} 为什么？"

# game/breakups.rpy:67
translate simplified_chinese breakup_aven_4d298c6c:

    # av "I love you, you love me."
    av "我爱你，你也爱我。"

# game/breakups.rpy:68
translate simplified_chinese breakup_aven_2fd0f870:

    # av "Why?"
    av "为什么？"

# game/breakups.rpy:69
translate simplified_chinese breakup_aven_03ff6531:

    # "It was hard to look her in the eye at that point, but I’d made my choice."
    "那时我很难直视她的眼睛，但我已经做出了选择。"

# game/breakups.rpy:70
translate simplified_chinese breakup_aven_ace7db70:

    # c "I can’t continue on like this."
    c "我不能再这样继续下去了。"

# game/breakups.rpy:72
translate simplified_chinese breakup_aven_1d84d1f8:

    # av "But all the things you told me?"
    av "可你告诉我的那些话呢？"

# game/breakups.rpy:73
translate simplified_chinese breakup_aven_91102c8b:

    # av "Was that all bullshit?!"
    av "难道全都是骗人的吗？！"

# game/breakups.rpy:74
translate simplified_chinese breakup_aven_4e44c1d7:

    # c "No, it wasn’t, but-"
    c "不，不是那样的，但是—"

# game/breakups.rpy:76
translate simplified_chinese breakup_aven_ed5905fd:

    # av "But what?!"
    av "但是什么？！"

# game/breakups.rpy:77
translate simplified_chinese breakup_aven_8d1fb449:

    # av "You’re not making any sense."
    av "你根本说不通。"

# game/breakups.rpy:78
translate simplified_chinese breakup_aven_1759b413:

    # c "There’s someone else and I have to make a choice."
    c "还有另一个人，我必须做出选择。"

# game/breakups.rpy:80
translate simplified_chinese breakup_aven_0970c317:

    # av "I see."
    av "我明白了。"

# game/breakups.rpy:81
translate simplified_chinese breakup_aven_7165c5f6:

    # av "Leave."
    av "离开。"

# game/breakups.rpy:84
translate simplified_chinese breakup_aven_0ab499a4:

    # c "I’m sorry Aven."
    c "对不起，艾文。"

# game/breakups.rpy:86
translate simplified_chinese breakup_aven_0bd99041:

    # "In tears, she was silent and staring in disbelief as I exited her room."
    "她泪流满面，沉默不语，难以置信地瞪视着，而我则走出了她的房间。"

# game/breakups.rpy:89
translate simplified_chinese breakup_aven_7f019fed:

    # c "There are good reasons why-"
    c "这都是有充分理由的—"

# game/breakups.rpy:91
translate simplified_chinese breakup_aven_742945d4:

    # av "LEAVE!"
    av "滚出去！"

# game/breakups.rpy:93
translate simplified_chinese breakup_aven_0219247f:

    # "In tears, she all but pushed me outside of her room, slamming the door shut in my face."
    "她泪流满面，几乎是把我推出了她的房间，当着我的面砰地关上了门。"

# game/breakups.rpy:102
translate simplified_chinese breakup_ziv_b575be86:

    # zi "Ah, [p_name], I’ve just finished meditating."
    zi "啊，[p_name]，我刚冥想完。"

# game/breakups.rpy:103
translate simplified_chinese breakup_ziv_ca46f8ff:

    # zi "Why do you look so grim?"
    zi "你怎么看起来这么严肃？"

# game/breakups.rpy:104
translate simplified_chinese breakup_ziv_ed068c79:

    # c "May I set down?"
    c "我可以坐下吗？"

# game/breakups.rpy:105
translate simplified_chinese breakup_ziv_8a409928:

    # zi "Of course."
    zi "当然可以。"

# game/breakups.rpy:106
translate simplified_chinese breakup_ziv_e897fbb0:

    # c "Thank you."
    c "谢谢你。"

# game/breakups.rpy:107
translate simplified_chinese breakup_ziv_834c5a1d:

    # c "Ziv...{w} I think we’ve made a mistake."
    c "基芙…{w} 我觉得我们犯了个错误。"

# game/breakups.rpy:109
translate simplified_chinese breakup_ziv_308945d5:

    # zi "We have?"
    zi "是吗？"

# game/breakups.rpy:110
translate simplified_chinese breakup_ziv_1b7674fd:

    # c "I feel like we’ve rushed into things and I went along with it."
    c "我感觉我们太仓促了，而我只是随波逐流。"

# game/breakups.rpy:111
translate simplified_chinese breakup_ziv_5014ee52:

    # c "And I know this sounds capricious, but I’ve come to realize that my heart belongs to another."
    c "我知道这听起来反复无常，但我已经意识到我的心属于另一个人。"

# game/breakups.rpy:113
translate simplified_chinese breakup_ziv_0e11054b:

    # zi "It does sound capricious, yes."
    zi "确实听起来反复无常，没错。"

# game/breakups.rpy:114
translate simplified_chinese breakup_ziv_7dc108aa:

    # zi "When did you come to this ‘sudden’ realization?"
    zi "你是什么时候有了这个“突然”的领悟？"

# game/breakups.rpy:115
translate simplified_chinese breakup_ziv_cc92bafa:

    # zi "Don’t answer, I don’t really want to know."
    zi "不用回答，我并不真的想知道。"

# game/breakups.rpy:116
translate simplified_chinese breakup_ziv_79452f68:

    # zi "You disappoint me, [p_name], just like I feared you would."
    zi "你让我失望了，[p_name]，就像我担心的那样。"

# game/breakups.rpy:117
translate simplified_chinese breakup_ziv_d2614009:

    # zi "The promises in that grove sounded hollow from the start."
    zi "当初在那片小树林里的承诺，从一开始就显得空洞。"

# game/breakups.rpy:118
translate simplified_chinese breakup_ziv_6a6fed57:

    # zi "But of course you had to take advantage of me back on Erigone."
    zi "但当然了，你当初在厄里戈涅星上非得占我便宜。"

# game/breakups.rpy:119
translate simplified_chinese breakup_ziv_db678f09:

    # zi "Now that you sated your hunger, you’re looking for something else to prey upon."
    zi "现在你满足了欲望，就又开始寻找下一个猎物了。"

# game/breakups.rpy:123
translate simplified_chinese breakup_ziv_ddbfa532:

    # c "It’s nothing like that, I-"
    c "根本不是这样，我—"

# game/breakups.rpy:125
translate simplified_chinese breakup_ziv_385cbf34:

    # zi "Save your breath, [p_name], just go."
    zi "省省吧，[p_name]，请你离开。"

# game/breakups.rpy:126
translate simplified_chinese breakup_ziv_3c747d5f:

    # "I complied and left Ziv in her room."
    "我听从了，把基芙独自留在她的房间里。"

# game/breakups.rpy:128
translate simplified_chinese breakup_ziv_aa9d4825:

    # c "Well, if you’d like to think that, be my guest."
    c "好吧，如果你想这么认为，请便。"

# game/breakups.rpy:130
translate simplified_chinese breakup_ziv_a9bbe8f1:

    # zi "I’m sure your new conquest will be very happy, until you leave her for the next one."
    zi "我相信你的新欢会非常开心，直到你为了下一个而抛弃她。"

# game/breakups.rpy:132
translate simplified_chinese breakup_ziv_c2669875:

    # "I didn’t reply to her last comment and left Ziv in her room, seething."
    "我没有回应她最后那句话，把基芙留在她房间里独自气恼。"

# game/breakups.rpy:141
translate simplified_chinese breakup_raene_452f99ec:

    # ra "[p_name_short]! I really need to show you something."
    ra "[p_name_short]！我真的需要给你看样东西。"

# game/breakups.rpy:142
translate simplified_chinese breakup_raene_523780b1:

    # c "Please, Raene, would you sit down with me?"
    c "拜托了，蕾妮，你能和我一起坐下吗？"

# game/breakups.rpy:143
translate simplified_chinese breakup_raene_2299a9c3:

    # c "We need to talk."
    c "我们需要谈谈。"

# game/breakups.rpy:145
translate simplified_chinese breakup_raene_0be7e561:

    # ra "About what?"
    ra "谈什么？"

# game/breakups.rpy:147
translate simplified_chinese breakup_raene_e103a4ee:

    # ra "Why are you looking so grim?"
    ra "你为什么表情这么严肃？"

# game/breakups.rpy:149
translate simplified_chinese breakup_raene_f49a4e90:

    # ra "I thought we could-"
    ra "我以为我们可以-"

# game/breakups.rpy:150
translate simplified_chinese breakup_raene_75afd862:

    # c "Raene, this isn’t working for me, our relationship, I mean."
    c "蕾妮，这对我不起作用，我是说，我们的关系。"

# game/breakups.rpy:152
translate simplified_chinese breakup_raene_6d86855f:

    # ra "What...{w} How? What isn’t working?"
    ra "什么…{w}怎么会？哪里不起作用了？"

# game/breakups.rpy:153
translate simplified_chinese breakup_raene_49c52b21:

    # c "I don’t know how to say it any other way, but I can’t continue on."
    c "我不知道还能怎么说，但我无法继续下去了。"

# game/breakups.rpy:154
translate simplified_chinese breakup_raene_83874fc7:

    # ra "Why not, is there something wrong?"
    ra "为什么不行，是哪里出了问题吗？"

# game/breakups.rpy:155
translate simplified_chinese breakup_raene_a41d8dc6:

    # ra "Is it something I did?"
    ra "是我做错了什么吗？"

# game/breakups.rpy:156
translate simplified_chinese breakup_raene_bf557386:

    # c "No, not at all."
    c "不，完全不是。"

# game/breakups.rpy:157
translate simplified_chinese breakup_raene_50fc356b:

    # c "You’re a wonderful girl, Raene, and I wish you all the happiness you deserve."
    c "你是个很棒的女孩，蕾妮，我真心希望你能得到应得的一切幸福。"

# game/breakups.rpy:158
translate simplified_chinese breakup_raene_85b1f272:

    # c "It’s just that I can’t be the one who makes you happy."
    c "只是我无法成为那个能让你幸福的人。"

# game/breakups.rpy:160
translate simplified_chinese breakup_raene_ea9c2a95:

    # ra "But..."
    ra "但是…"

# game/breakups.rpy:164
translate simplified_chinese breakup_raene_3bfb3c0f:

    # c "There’s someone else, Raene, and I have to make a choice."
    c "还有另一个人，蕾妮，我必须做出选择。"

# game/breakups.rpy:166
translate simplified_chinese breakup_raene_67fb8317:

    # ra "Do you?"
    ra "是吗？"

# game/breakups.rpy:167
translate simplified_chinese breakup_raene_9539ab88:

    # ra "Why didn’t you choose me?"
    ra "你为什么不选择我？"

# game/breakups.rpy:169
translate simplified_chinese breakup_raene_dd37514e:

    # ra "There’s something wrong with me, isn’t there?"
    ra "是我哪里不够好，对吗？"

# game/breakups.rpy:170
translate simplified_chinese breakup_raene_017535ee:

    # c "No, absolutely not."
    c "不，绝对不是这样。"

# game/breakups.rpy:171
translate simplified_chinese breakup_raene_af3f78fb:

    # c "It’s just that I’m forced to make a choice and-"
    c "只是我被迫要做出选择，而且…"

# game/breakups.rpy:173
translate simplified_chinese breakup_raene_60b97793:

    # c "I’m sorry, Raene."
    c "对不起，蕾妮。"

# game/breakups.rpy:174
translate simplified_chinese breakup_raene_dd1b110b:

    # c "I really hope you find some-"
    c "我真心希望你能找到—"

# game/breakups.rpy:175
translate simplified_chinese breakup_raene_fb1f9f76:

    # ra "Please go away, [p_name]."
    ra "请你离开，[p_name]。"

# game/breakups.rpy:177
translate simplified_chinese breakup_raene_6d2e8b7e:

    # "Raene spoke her last words with such finality that I could only do as she asked."
    "蕾妮说出最后那句话时如此决绝，我只能照她要求的做。"

# game/breakups.rpy:178
translate simplified_chinese breakup_raene_335eac3a:

    # "She was sobbing uncontrollably by the time I closed the door behind me."
    "当我关上门时，她已泣不成声。"

# game/breakups.rpy:187
translate simplified_chinese breakup_thyia_877a09cd:

    # th "Oh, [p_name_short], could you hand me that spanner?"
    th "哦，[p_name_short]，能帮我把那个扳手递过来吗？"

# game/breakups.rpy:188
translate simplified_chinese breakup_thyia_e0323b8d:

    # c "Could you stop what you’re doing for a moment?"
    c "你能停下手头的事一会儿吗？"

# game/breakups.rpy:189
translate simplified_chinese breakup_thyia_c16eb3f1:

    # th "What, why?"
    th "什么，为什么？"

# game/breakups.rpy:191
translate simplified_chinese breakup_thyia_6fabf92e:

    # th "You look like you’ve swallowed something terrible."
    th "你看上去像是吞了什么恶心的东西。"

# game/breakups.rpy:192
translate simplified_chinese breakup_thyia_8b02937d:

    # th "Seriously, [p_name_short], what’s the matter?"
    th "说真的，[p_name_short]，怎么回事？"

# game/breakups.rpy:193
translate simplified_chinese breakup_thyia_71a03f3b:

    # c "It’s us."
    c "是因为我们。"

# game/breakups.rpy:195
translate simplified_chinese breakup_thyia_3d9b1832:

    # th "Us?"
    th "我们？"

# game/breakups.rpy:196
translate simplified_chinese breakup_thyia_f8795997:

    # th "I’m warning you, the next few words that come out of your mouth better be good."
    th "我警告你，接下来从你嘴里说出来的话最好是好消息。"

# game/breakups.rpy:197
translate simplified_chinese breakup_thyia_ddbebc15:

    # c "I want to break up with you."
    c "我想和你分手。"

# game/breakups.rpy:199
translate simplified_chinese breakup_thyia_3dea4a02:

    # th "Yeah...{w} How about no?"
    th "是吗…{w} 不行呢？"

# game/breakups.rpy:203
translate simplified_chinese breakup_thyia_0370cdcf:

    # c "There’s someone else in my life."
    c "我的生命里有了别人。"

# game/breakups.rpy:204
translate simplified_chinese breakup_thyia_cfa0282e:

    # c "I didn’t want to choose between you both, but the situation has forced my hand."
    c "我本不想在你们之间做选择，但形势所迫。"

# game/breakups.rpy:206
translate simplified_chinese breakup_thyia_67f7933a:

    # c "It simply isn’t working for me."
    c "这段感情对我来说就是行不通。"

# game/breakups.rpy:208
translate simplified_chinese breakup_thyia_e861757d:

    # th "Oh fuck off, [p_name]."
    th "哦滚开，[p_name]。"

# game/breakups.rpy:209
translate simplified_chinese breakup_thyia_f31897b1:

    # th "Just tell me the truth."
    th "就跟我说实话吧。"

# game/breakups.rpy:210
translate simplified_chinese breakup_thyia_fd0ee940:

    # th "Tell me that you’ve found someone else and you want to be with her."
    th "告诉我你找到了别人，你想和她在一起。"

# game/breakups.rpy:211
translate simplified_chinese breakup_thyia_50a1780a:

    # th "Don’t offend me with your bullshit."
    th "别用你那套废话来恶心我。"

# game/breakups.rpy:212
translate simplified_chinese breakup_thyia_49034cd7:

    # c "Okay, there’s someone else."
    c "好吧，确实有别人了。"

# game/breakups.rpy:214
translate simplified_chinese breakup_thyia_72ab3ab5:

    # "Thyia remained eerily calm while she spoke next."
    "塞娅接下来开口时，保持着令人毛骨悚然的平静。"

# game/breakups.rpy:215
translate simplified_chinese breakup_thyia_446fa45e:

    # th "I knew I was a fool to trust someone again."
    th "我就知道再次相信别人是个愚蠢的决定。"

# game/breakups.rpy:216
translate simplified_chinese breakup_thyia_0e4c7e20:

    # th "Thank you for making me see the error of my ways."
    th "谢谢你让我看清了自己的错误。"

# game/breakups.rpy:217
translate simplified_chinese breakup_thyia_2e68660c:

    # th "Now, before I do something I might regret, I’ll tell you how we interact with each other from now on."
    th "现在，在我做出可能会后悔的事情之前，我要告诉你我们今后该如何相处。"

# game/breakups.rpy:218
translate simplified_chinese breakup_thyia_6f867595:

    # th "I’ll keep the ship running and won’t get in your way, if you don’t get in mine."
    th "我会让飞船正常运转，不会妨碍你，只要你也别来妨碍我。"

# game/breakups.rpy:219
translate simplified_chinese breakup_thyia_87297ba9:

    # th "We’ll speak to each other when the need arises, but other than that I don’t want to hear a fucking thing from you."
    th "有必要的时候我们会交谈，除此之外我他妈一个字都不想听你说。"

# game/breakups.rpy:220
translate simplified_chinese breakup_thyia_4224ab6a:

    # th "We’re not doing the friend thing or even small talk."
    th "我们之间没有友情，连寒暄都不需要。"

# game/breakups.rpy:221
translate simplified_chinese breakup_thyia_73a1c791:

    # th "Just business."
    th "纯粹是工作关系。"

# game/breakups.rpy:222
translate simplified_chinese breakup_thyia_70e54566:

    # th "Agreed?"
    th "同意吗？"

# game/breakups.rpy:223
translate simplified_chinese breakup_thyia_88df38a7:

    # c "Agreed."
    c "同意。"

# game/breakups.rpy:224
translate simplified_chinese breakup_thyia_32373670:

    # th "Good.{w} Now fuck off."
    th "很好。{w}现在滚开。"

# game/breakups.rpy:226
translate simplified_chinese breakup_thyia_f99b0ab0:

    # "Thyia went back to her machinery as soon as I turned my back."
    "我刚转过身，塞娅就回到了她的机器旁。"

# game/breakups.rpy:227
translate simplified_chinese breakup_thyia_93deed4d:

    # "I thought she was crying, because of the way her shoulder shook."
    "我以为她在哭，因为她的肩膀在颤抖。"

# game/breakups.rpy:229
translate simplified_chinese breakup_thyia_c47926c3:

    # "Any thought of that was gone immediately when she turned around and glared at me."
    "但当她转过身来怒视我时，这个念头立刻消失了。"

# game/breakups.rpy:230
translate simplified_chinese breakup_thyia_7bc5532e:

    # "She stared at me in thinly-veiled disgust as I retreated from the engine room."
    "当我从引擎室退出来时，她用毫不掩饰的厌恶目光盯着我。"

# game/breakups.rpy:239
translate simplified_chinese breakup_vess_209805c1:

    # c "Hey Vess, do you have a minute?"
    c "嘿薇丝，你有空吗？"

# game/breakups.rpy:241
translate simplified_chinese breakup_vess_4f172546:

    # ve "How can you ask, for you always!"
    ve "这还用问吗，随时为你效劳！"

# game/breakups.rpy:242
translate simplified_chinese breakup_vess_8516f17c:

    # ve "If you have the time, maybe we could get a little more cozy?"
    ve "如果你有时间，也许我们可以更亲密一点？"

# game/breakups.rpy:243
translate simplified_chinese breakup_vess_1c844a0b:

    # c "Vess, please."
    c "薇丝，拜托了。"

# game/breakups.rpy:245
translate simplified_chinese breakup_vess_6ec3dbe0:

    # ve "What, did I say something wrong?"
    ve "怎么了，我说错什么了吗？"

# game/breakups.rpy:246
translate simplified_chinese breakup_vess_c4bdda27:

    # c "No, not really."
    c "不，不是这样的。"

# game/breakups.rpy:247
translate simplified_chinese breakup_vess_d9a542f2:

    # c "I hate to do this to you like this, but it can’t be helped."
    c "我不想这样对你，但实在是没办法。"

# game/breakups.rpy:249
translate simplified_chinese breakup_vess_233190fd:

    # ve "What can’t be helped, why are you looking so serious?"
    ve "什么没办法，你为什么看起来这么严肃？"

# game/breakups.rpy:250
translate simplified_chinese breakup_vess_8c2aeaa3:

    # c "Because I have to end our relationship, Vess."
    c "因为我必须结束我们的关系，薇丝。"

# game/breakups.rpy:252
translate simplified_chinese breakup_vess_314765c9:

    # ve "What?!"
    ve "什么？！"

# game/breakups.rpy:253
translate simplified_chinese breakup_vess_9d207ba4:

    # c "I have thought long and hard about it, but we can’t go on like this."
    c "我经过深思熟虑，但我们不能再这样继续下去了。"

# game/breakups.rpy:255
translate simplified_chinese breakup_vess_d0ebe124:

    # ve "But why?"
    ve "但是为什么？"

# game/breakups.rpy:256
translate simplified_chinese breakup_vess_a821530e:

    # ve "Is it because you don’t trust me?"
    ve "是因为你不信任我吗？"

# game/breakups.rpy:257
translate simplified_chinese breakup_vess_26c91f72:

    # ve "It is, isn’t it?"
    ve "就是这样，不是吗？"

# game/breakups.rpy:258
translate simplified_chinese breakup_vess_6fc0684c:

    # ve "I don’t know what else I can do to make amends."
    ve "我不知道还能做些什么来弥补。"

# game/breakups.rpy:259
translate simplified_chinese breakup_vess_17cef3c0:

    # ve "But you know I want to try."
    ve "但你知道我想尝试。"

# game/breakups.rpy:260
translate simplified_chinese breakup_vess_cff9bf98:

    # ve "Isn’t that enough, [p_name]?"
    ve "这还不够吗，[p_name]？"

# game/breakups.rpy:261
translate simplified_chinese breakup_vess_495fb72d:

    # c "It’s not about you, Vess."
    c "这与你无关，薇丝。"

# game/breakups.rpy:262
translate simplified_chinese breakup_vess_f6a64ef9:

    # c "It’s a decision I made, which I was forced to make."
    c "这是我被迫做出的决定。"

# game/breakups.rpy:264
translate simplified_chinese breakup_vess_7ea8d4e2:

    # ve "Forced?"
    ve "被迫？"

# game/breakups.rpy:265
translate simplified_chinese breakup_vess_5d2f9fb7:

    # c "I’m in love with someone else."
    c "我爱上了别人。"

# game/breakups.rpy:266
translate simplified_chinese breakup_vess_a6730577:

    # ve "Oh..."
    ve "哦…"

# game/breakups.rpy:267
translate simplified_chinese breakup_vess_4604da78:

    # ve "But you didn’t..."
    ve "但你并没有…"

# game/breakups.rpy:268
translate simplified_chinese breakup_vess_c5f100c5:

    # ve "But..."
    ve "但是……"

# game/breakups.rpy:269
translate simplified_chinese breakup_vess_91eebadd:

    # c "I should have told you about my feelings for her."
    c "我本该早点告诉你我对她的感情。"

# game/breakups.rpy:270
translate simplified_chinese breakup_vess_09990835:

    # c "But what’s done is done."
    c "但事情已经发生了。"

# game/breakups.rpy:272
translate simplified_chinese breakup_vess_0e168e7d:

    # ve "I...{w} I understand."
    ve "我……{w}我明白了。"

# game/breakups.rpy:273
translate simplified_chinese breakup_vess_37832318:

    # ve "Could you leave me alone now?"
    ve "现在能让我一个人待会儿吗？"

# game/breakups.rpy:274
translate simplified_chinese breakup_vess_54b63575:

    # ve "I need to be alone."
    ve "我需要独处。"

# game/breakups.rpy:275
translate simplified_chinese breakup_vess_4e8c7062:

    # c "Of course."
    c "当然。"

# game/breakups.rpy:277
translate simplified_chinese breakup_vess_d7638ec7:

    # "After I closed the door, I could hear Vess crying with abandon."
    "关上门后，我听见薇丝在放声痛哭。"

# game/breakups.rpy:278
translate simplified_chinese breakup_vess_91a13ecf:

    # "Resisting the urge to go back in and comfort her, I made my way back to my quarters."
    "我强忍着回去安慰她的冲动，转身走向自己的舱室。"

# game/breakups.rpy:286
translate simplified_chinese breakup_nadya_d7669a36:

    # c "I need to tell you something."
    c "有件事我必须告诉你。"

# game/breakups.rpy:287
translate simplified_chinese breakup_nadya_123344a8:

    # c "It might be better if you sit down."
    c "你最好坐下来听我说。"

# game/breakups.rpy:289
translate simplified_chinese breakup_nadya_09362606:

    # na "Okay..."
    na "好吧…"

# game/breakups.rpy:290
translate simplified_chinese breakup_nadya_3efe0ac3:

    # c "I realize this might sound callous, but our relationship, it has to end."
    c "我知道这话可能很无情，但我们的关系必须结束了。"

# game/breakups.rpy:291
translate simplified_chinese breakup_nadya_cdf6f71a:

    # na "You don’t mince words, do you?"
    na "你还真是直言不讳啊？"

# game/breakups.rpy:292
translate simplified_chinese breakup_nadya_eb51bd5d:

    # c "I just wanted to speak plainly."
    c "我只是想坦诚相告。"

# game/breakups.rpy:294
translate simplified_chinese breakup_nadya_154ec566:

    # na "How very mature of you."
    na "你可真是成熟啊。"

# game/breakups.rpy:295
translate simplified_chinese breakup_nadya_247086c5:

    # na "Did you get bored of me already?"
    na "你已经对我厌倦了吗？"

# game/breakups.rpy:296
translate simplified_chinese breakup_nadya_33bec90c:

    # na "Found something better?"
    na "找到更好的了？"

# game/breakups.rpy:298
translate simplified_chinese breakup_nadya_440730be:

    # c "No mom, it isn’t like that."
    c "不，妈妈，不是那样的。"

# game/breakups.rpy:300
translate simplified_chinese breakup_nadya_e2186711:

    # c "No, it isn’t like that."
    c "不，不是那样的。"

# game/breakups.rpy:302
translate simplified_chinese breakup_nadya_1e3913ba:

    # na "Well, it sure sounds like it to me."
    na "嗯，对我来说听起来就是这样。"

# game/breakups.rpy:305
translate simplified_chinese breakup_nadya_fdb95508:

    # na "You’ve tasted of the forbidden and now want something else."
    na "你已经尝过禁果，现在想要别的了。"

# game/breakups.rpy:307
translate simplified_chinese breakup_nadya_df277e26:

    # na "You’ve had your taste and now want something else."
    na "你已经尝过滋味，现在想要别的了。"

# game/breakups.rpy:309
translate simplified_chinese breakup_nadya_20629000:

    # na "It’s because of my age, isn’t it?"
    na "是因为我的年龄，对吧？"

# game/breakups.rpy:310
translate simplified_chinese breakup_nadya_193c4aa2:

    # c "No, it’s not that, honestly."
    c "不，真的不是那样。"

# game/breakups.rpy:312
translate simplified_chinese breakup_nadya_c48bf2d5:

    # na "You know what, I don’t care."
    na "你知道吗，我不在乎了。"

# game/breakups.rpy:313
translate simplified_chinese breakup_nadya_377a7f9b:

    # na "I never should have opened up to you like that, it was bound to be a disappointment."
    na "我本就不该对你敞开心扉，这注定会是个失望。"

# game/breakups.rpy:315
translate simplified_chinese breakup_nadya_447b54ad:

    # c "Mother..."
    c "母亲…"

# game/breakups.rpy:317
translate simplified_chinese breakup_nadya_cc1af782:

    # c "Nadya..."
    c "娜迪亚…"

# game/breakups.rpy:319
translate simplified_chinese breakup_nadya_3b853f3d:

    # na "I’m not blaming you even, I should have been more careful."
    na "我甚至不是在责怪你，我本该更小心些的。"

# game/breakups.rpy:320
translate simplified_chinese breakup_nadya_93310ed6:

    # na "I just wish you thought of your concerns earlier, it would have saved us both a lot of pain."
    na "我只希望你能早点考虑清楚，这样我们俩都能少受很多痛苦。"

# game/breakups.rpy:321
translate simplified_chinese breakup_nadya_ea2e9aef:

    # c "I know and I’m sorry."
    c "我知道，我很抱歉。"

# game/breakups.rpy:322
translate simplified_chinese breakup_nadya_27fd475c:

    # c "Please understand I didn’t come to this decision lightly."
    c "请理解我不是轻易做出这个决定的。"

# game/breakups.rpy:324
translate simplified_chinese breakup_nadya_138d70b7:

    # na "There’s someone else, isn’t there?"
    na "是因为有别人了，对吗？"

# game/breakups.rpy:325
translate simplified_chinese breakup_nadya_29b2589a:

    # c "Yes, there is."
    c "是的，是这样。"

# game/breakups.rpy:327
translate simplified_chinese breakup_nadya_4141727e:

    # na "I thought as much."
    na "我就知道是这样。"

# game/breakups.rpy:328
translate simplified_chinese breakup_nadya_aff1075a:

    # na "She asked you to break things off?"
    na "是她让你结束这段关系的吗？"

# game/breakups.rpy:329
translate simplified_chinese breakup_nadya_7961aac6:

    # c "She did."
    c "是的。"

# game/breakups.rpy:330
translate simplified_chinese breakup_nadya_d17db83d:

    # na "Well, I understand her position."
    na "好吧，我能理解她的立场。"

# game/breakups.rpy:331
translate simplified_chinese breakup_nadya_6a0fae82:

    # na "You’ve appeared to make your choice and you should live by it."
    na "看来你已经做出了选择，那就应该坚持到底。"

# game/breakups.rpy:332
translate simplified_chinese breakup_nadya_49a26f5f:

    # na "I want you to promise to maker her as happy as you possibly can and don’t let her down."
    na "我要你保证，尽你所能让她幸福，不要让她失望。"

# game/breakups.rpy:333
translate simplified_chinese breakup_nadya_94ccfb49:

    # c "I won’t, I promise."
    c "我保证，我不会的。"

# game/breakups.rpy:334
translate simplified_chinese breakup_nadya_ccb084fe:

    # na "Good."
    na "很好。"

# game/breakups.rpy:336
translate simplified_chinese breakup_nadya_19ee6d5b:

    # na "Could you leave me alone now, please?"
    na "能请你让我一个人待会儿吗？"

# game/breakups.rpy:338
translate simplified_chinese breakup_nadya_e3ee3918:

    # "I left my mother."
    "我离开了我的母亲。"

# game/breakups.rpy:340
translate simplified_chinese breakup_nadya_10e0f1df:

    # "I left Nadya."
    "我离开了娜迪亚。"

# game/breakups.rpy:342
translate simplified_chinese breakup_nadya_6052a82f:

    # "Despite her firm voice just earlier, I heard her break down after closing the door."
    "尽管她刚才语气坚定，但我听到她在关上门后崩溃了。"

# game/breakups.rpy:343
translate simplified_chinese breakup_nadya_b8504e1e:

    # "Her heartfelt sobs haunted me all the way back to my quarters."
    "她发自内心的啜泣声一直萦绕着我，直到我回到住处。"

# game/breakups.rpy:352
translate simplified_chinese breakup_celine_5610718f:

    # ce "Hey, [p_name_short]."
    ce "嘿，[p_name_short]。"

# game/breakups.rpy:353
translate simplified_chinese breakup_celine_6190f4db:

    # c "Hey."
    c "嘿。"

# game/breakups.rpy:354
translate simplified_chinese breakup_celine_baa13475:

    # ce "Why are you looking at me like that?"
    ce "你为什么那样看着我？"

# game/breakups.rpy:355
translate simplified_chinese breakup_celine_5c84cc48:

    # ce "Is something the matter?"
    ce "出什么事了吗？"

# game/breakups.rpy:356
translate simplified_chinese breakup_celine_efd090e2:

    # c "Céline, we need to talk, about you and me."
    c "瑟琳，我们需要谈谈，关于你和我。"

# game/breakups.rpy:358
translate simplified_chinese breakup_celine_3bdd7b97:

    # ce "Oh?"
    ce "哦？"

# game/breakups.rpy:359
translate simplified_chinese breakup_celine_57cae3c7:

    # c "It's not working for me anymore."
    c "这对我来说已经行不通了。"

# game/breakups.rpy:360
translate simplified_chinese breakup_celine_06c84469:

    # c "I've come to realize my feelings for you aren't as strong as they once were."
    c "我意识到我对你的感情不如从前那么强烈了。"

# game/breakups.rpy:361
translate simplified_chinese breakup_celine_67e47fe9:

    # ce "This can't be right."
    ce "这不可能是真的。"

# game/breakups.rpy:362
translate simplified_chinese breakup_celine_f131cf82:

    # ce "Are you feeling alright, did something happen back on your father's ship?"
    ce "你还好吗，在你父亲的船上发生了什么吗？"

# game/breakups.rpy:363
translate simplified_chinese breakup_celine_f5b35eee:

    # c "Nothing happened."
    c "什么都没发生。"

# game/breakups.rpy:364
translate simplified_chinese breakup_celine_5f0b7414:

    # c "My feelings towards you have just changed."
    c "只是我对你的感情已经改变了。"

# game/breakups.rpy:366
translate simplified_chinese breakup_celine_21957598:

    # ce "What about all those nights we spent together?!"
    ce "那我们共度的那些夜晚又算什么？！"

# game/breakups.rpy:367
translate simplified_chinese breakup_celine_480c773b:

    # ce "You're lying, I can see it in your eyes!"
    ce "你在撒谎，我从你眼里看得出来！"

# game/breakups.rpy:368
translate simplified_chinese breakup_celine_f33dc7b4:

    # ce "You're lying to me, to yourself."
    ce "你在欺骗我，也在欺骗你自己。"

# game/breakups.rpy:369
translate simplified_chinese breakup_celine_dad94cdb:

    # c "I have to end things, there's no other way."
    c "我必须结束这段关系，没有别的办法。"

# game/breakups.rpy:370
translate simplified_chinese breakup_celine_e0342ec2:

    # ce "What happened?"
    ce "到底发生了什么？"

# game/breakups.rpy:371
translate simplified_chinese breakup_celine_f2f16b6b:

    # c "I've found someone else, that's all I can say."
    c "我遇到了别人，我只能说这么多。"

# game/breakups.rpy:373
translate simplified_chinese breakup_celine_8fc38651:

    # ce "And she's making you do this?"
    ce "是她逼你这么做的？"

# game/breakups.rpy:374
translate simplified_chinese breakup_celine_6ec5eda3:

    # ce "What we had was true, [p_name_short], and you're throwing it all away."
    ce "我们之间的感情是真实的，[p_name_short]，而你却要全部抛弃。"

# game/breakups.rpy:375
translate simplified_chinese breakup_celine_58002698:

    # ce "Who's making you do this?"
    ce "是谁逼你这么做的？"

# game/breakups.rpy:376
translate simplified_chinese breakup_celine_08d4720b:

    # c "I can't tell."
    c "我不能说。"

# game/breakups.rpy:378
translate simplified_chinese breakup_celine_f90fa858:

    # ce "Coward!"
    ce "懦夫！"

# game/breakups.rpy:379
translate simplified_chinese breakup_celine_d3e290cc:

    # ce "I demand you tell me."
    ce "我命令你告诉我。"

# game/breakups.rpy:380
translate simplified_chinese breakup_celine_c318e691:

    # ce "I have a right to know!"
    ce "我有权知道！"

# game/breakups.rpy:381
translate simplified_chinese breakup_celine_b1961263:

    # c "No, you don't."
    c "不，你没有这个权利。"

# game/breakups.rpy:382
translate simplified_chinese breakup_celine_55079b6b:

    # c "I'm sorry, Céline."
    c "对不起，瑟琳。"

# game/breakups.rpy:383
translate simplified_chinese breakup_celine_e4326d46:

    # "Unable to comfort her in any way, I walked out of Céline's quarters."
    "我无法以任何方式安慰她，走出了瑟琳的房间。"

# game/breakups.rpy:385
translate simplified_chinese breakup_celine_6aeb82fb:

    # ce "She won't make you happy!"
    ce "她不会让你幸福的！"

# game/breakups.rpy:386
translate simplified_chinese breakup_celine_d19301fd:

    # ce "I'm the one for you, [p_name_short]."
    ce "我才是适合你的人，[p_name_short]。"

# game/breakups.rpy:387
translate simplified_chinese breakup_celine_054cf9c4:

    # ce "I'm the only one who can make you happy."
    ce "我才是唯一能让你幸福的人。"

# game/breakups.rpy:388
translate simplified_chinese breakup_celine_4efe6d8b:

    # ce "Come back, please!"
    ce "回来吧，求你了！"

# game/breakups.rpy:390
translate simplified_chinese breakup_celine_cac034fc:

    # "I hurried through the corridors of the ship, away from her increasingly desperate pleas."
    "我匆匆穿过飞船的走廊，逃离她愈发绝望的哀求。"

# game/breakups.rpy:399
translate simplified_chinese breakup_eva_1260debe:

    # "Eva was waiting for me with such a hopeful expression on her face that I nearly couldn’t go through with it."
    "伊娃正等着我，脸上带着如此期盼的表情，我几乎无法继续说下去。"

# game/breakups.rpy:400
translate simplified_chinese breakup_eva_b1f8097e:

    # e "Hey, what’s on your mind?"
    e "嘿，你在想什么？"

# game/breakups.rpy:401
translate simplified_chinese breakup_eva_0ce8d137:

    # c "I need to talk about us, Eva."
    c "我需要谈谈我们的事，伊娃。"

# game/breakups.rpy:403
translate simplified_chinese breakup_eva_3388a208:

    # e "Oh..."
    e "哦…"

# game/breakups.rpy:404
translate simplified_chinese breakup_eva_0f96d88c:

    # e "That doesn’t sound good."
    e "听起来不太妙。"

# game/breakups.rpy:405
translate simplified_chinese breakup_eva_0add9b0f:

    # c "I’m breaking up with you."
    c "我要和你分手。"

# game/breakups.rpy:407
translate simplified_chinese breakup_eva_394bcc56:

    # e "What?!"
    e "什么？！"

# game/breakups.rpy:408
translate simplified_chinese breakup_eva_d4993d94:

    # e "But..."
    e "但是…"

# game/breakups.rpy:409
translate simplified_chinese breakup_eva_1ea97b2d:

    # e "Why?"
    e "为什么？"

# game/breakups.rpy:410
translate simplified_chinese breakup_eva_72f0b015:

    # c "I’m being forced to make a choice and I’m choosing her."
    c "我被迫做出选择，而我选择了她。"

# game/breakups.rpy:412
translate simplified_chinese breakup_eva_d0bb04b8:

    # e "But we had something special together!"
    e "但我们之间明明有过特别的感情！"

# game/breakups.rpy:414
translate simplified_chinese breakup_eva_4dadb6ee:

    # e "You wanted children with me?!"
    e "你不是说过想和我生孩子吗？！"

# game/breakups.rpy:415
translate simplified_chinese breakup_eva_3c45660b:

    # e "How could you do such a thing like this?"
    e "你怎么能做出这种事？"

# game/breakups.rpy:416
translate simplified_chinese breakup_eva_391009d5:

    # c "I’m sorry, Eva."
    c "对不起，伊娃。"

# game/breakups.rpy:417
translate simplified_chinese breakup_eva_4e60d810:

    # e "There’s no chance you’ll reconsider?"
    e "你不可能再考虑一下了吗？"

# game/breakups.rpy:418
translate simplified_chinese breakup_eva_51fa8c9a:

    # c "No, this is final."
    c "不，这是最终决定。"

# game/breakups.rpy:420
translate simplified_chinese breakup_eva_81959a5c:

    # e "Go away then."
    e "那你走吧。"

# game/breakups.rpy:421
translate simplified_chinese breakup_eva_a8dd7e4b:

    # e "I don’t want you here."
    e "我不想看到你在这里。"

# game/breakups.rpy:422
translate simplified_chinese breakup_eva_35a18b0a:

    # e "Go!"
    e "走！"

# game/breakups.rpy:424
translate simplified_chinese breakup_eva_b04ca312:

    # "I retreated and closed the door behind me, leaving my sister to dissolve into tears."
    "我退后关上房门，留下我妹妹独自啜泣。"

# game/breakups.rpy:432
translate simplified_chinese breakup_jade_83b650fb:

    # j "Do you want to have some fun?"
    j "你想找点乐子吗？"

# game/breakups.rpy:433
translate simplified_chinese breakup_jade_7b91b1bf:

    # c "No Jade, I just wanted to talk."
    c "不，杰德，我只是想聊聊。"

# game/breakups.rpy:435
translate simplified_chinese breakup_jade_789e65fd:

    # j "Talk about what?"
    j "聊什么？"

# game/breakups.rpy:436
translate simplified_chinese breakup_jade_5474d622:

    # c "About us."
    c "关于我们。"

# game/breakups.rpy:438
translate simplified_chinese breakup_jade_32e7407c:

    # j "Okay..."
    j "好吧…"

# game/breakups.rpy:439
translate simplified_chinese breakup_jade_0bc4ced0:

    # c "Our relationship, I have to end it."
    c "我们的关系，我必须结束了。"

# game/breakups.rpy:441
translate simplified_chinese breakup_jade_2fdefc32:

    # j "Why?"
    j "为什么？"

# game/breakups.rpy:442
translate simplified_chinese breakup_jade_026a14f9:

    # c "I’m seeing someone else and it’s getting serious."
    c "我正在和别人交往，而且越来越认真。"

# game/breakups.rpy:443
translate simplified_chinese breakup_jade_c4412c0e:

    # c "Serious enough that there isn’t room for anything else."
    c "认真到容不下其他任何关系了。"

# game/breakups.rpy:444
translate simplified_chinese breakup_jade_7988685c:

    # j "That didn’t stop you before, what changed?"
    j "你以前可没因此停下，是什么变了？"

# game/breakups.rpy:445
translate simplified_chinese breakup_jade_851c3635:

    # c "Everything, Jade."
    c "全都变了，杰德。"

# game/breakups.rpy:446
translate simplified_chinese breakup_jade_5d938c19:

    # c "You deserve a chance with someone else."
    c "你值得和别人有个新开始。"

# game/breakups.rpy:448
translate simplified_chinese breakup_jade_7a69cd3d:

    # j "I don’t want to."
    j "我不想要。"

# game/breakups.rpy:449
translate simplified_chinese breakup_jade_c422d5aa:

    # j "I love you [p_name], I always have."
    j "我爱你[p_name]，一直都是。"

# game/breakups.rpy:450
translate simplified_chinese breakup_jade_fa5fd35a:

    # j "You said you love me too and now you’re about to throw that all away?"
    j "你说过你也爱我，现在就要把这些都抛弃吗？"

# game/breakups.rpy:451
translate simplified_chinese breakup_jade_2fa5b617:

    # c "I’m sorry Jade, but I have to."
    c "对不起杰德，但我必须这么做。"

# game/breakups.rpy:453
translate simplified_chinese breakup_jade_436804e3:

    # j "You have to?"
    j "必须？"

# game/breakups.rpy:454
translate simplified_chinese breakup_jade_6fe03362:

    # j "You’re saying you’re forced to do this?"
    j "你是说你是被迫这么做的？"

# game/breakups.rpy:455
translate simplified_chinese breakup_jade_84880f6c:

    # c "I don’t see any other way."
    c "我看不到其他选择。"

# game/breakups.rpy:457
translate simplified_chinese breakup_jade_a5cfca61:

    # j "Maybe you could have talked to me beforehand, instead of making a decision on your own."
    j "也许你本该事先跟我谈谈，而不是独自做决定。"

# game/breakups.rpy:459
translate simplified_chinese breakup_jade_f1e6962f:

    # j "Are you sure this is what you want?"
    j "你确定这是你想要的吗？"

# game/breakups.rpy:460
translate simplified_chinese breakup_jade_b63d6bf3:

    # c "I am."
    c "我确定。"

# game/breakups.rpy:462
translate simplified_chinese breakup_jade_f22d420a:

    # j "Well then, you seem to have made up your mind."
    j "好吧，看来你已经下定决心了。"

# game/breakups.rpy:463
translate simplified_chinese breakup_jade_a78c9216:

    # j "I hope she’s worth the betrayal."
    j "希望她值得你为此背叛。"

# game/breakups.rpy:464
translate simplified_chinese breakup_jade_73ea346e:

    # j "Bye [p_name]."
    j "再见，[p_name]。"

# game/breakups.rpy:466
translate simplified_chinese breakup_jade_26ac6d73:

    # "With those final words, she walked out of my quarters."
    "说完最后这句话，她走出了我的舱室。"

