# game/episode021.rpy:454
translate simplified_chinese episode021_aef41b5b:

    # ce "Our escort has powered up their weapons."
    ce "我们的护卫队已经启动了武器。"

# game/episode021.rpy:455
translate simplified_chinese episode021_658a8cb3:

    # c "That guy is not one for diplomacy..."
    c "那家伙可不是个讲究外交的人…"

# game/episode021.rpy:457
translate simplified_chinese episode021_999d7239:

    # "Skeda's pirates began firing on the ships that were harassing us."
    "斯凯达的海盗开始向骚扰我们的飞船开火。"

# game/episode021.rpy:458
translate simplified_chinese episode021_231e1ed4:

    # "Those small spacecraft seemed like an uneven match, pitted against the pirate's behemoth."
    "那些小型飞船与海盗的庞然大物相比，似乎实力悬殊。"

# game/episode021.rpy:460
translate simplified_chinese episode021_c9a0e45b:

    # c "Attacking them was a mistake, I don't believe for a second those small ships go up against larger ones alone."
    c "攻击他们是个错误，我绝不相信那些小船会单独对抗更大的舰船。"

# game/episode021.rpy:461
translate simplified_chinese episode021_5a323a73:

    # av "You might be right."
    av "你也许是对的。"

# game/episode021.rpy:462
translate simplified_chinese episode021_85652997:

    # av "Two large cruisers just Burst near us."
    av "两艘大型巡洋舰刚刚在我们附近跃出。"

# game/episode021.rpy:463
translate simplified_chinese episode021_be275f93:

    # c "Fuck, I guess the backup has arrived?"
    c "该死，我猜是援军到了？"

# game/episode021.rpy:464
translate simplified_chinese episode021_d894d92c:

    # av "Both cruisers are converging upon us."
    av "两艘巡洋舰都在向我们靠拢。"

# game/episode021.rpy:465
translate simplified_chinese episode021_f3d9b7f9:

    # c "Why did our escort have to turn this into a dick-measuring contest?"
    c "为什么我们的护卫非要搞成一场比大小的较量？"

# game/episode021.rpy:466
translate simplified_chinese episode021_3879830d:

    # av "Overconfidence?"
    av "过度自信？"

# game/episode021.rpy:468
translate simplified_chinese episode021_ed485f16:

    # "The two cruisers began to pound the cruiser accompanying us."
    "那两艘巡洋舰开始猛轰伴随我们的巡洋舰。"

# game/episode021.rpy:469
translate simplified_chinese episode021_8a8defe3:

    # "It didn't take long to realize that new arrivals severely outclassed Skeda's ship."
    "没过多久就意识到新来的飞船性能远超斯凯达的船。"

# game/episode021.rpy:471
translate simplified_chinese episode021_0e7f5156:

    # c "Céline, have we been targeted?"
    c "瑟琳，我们被锁定了吗？"

# game/episode021.rpy:472
translate simplified_chinese episode021_6d9c3581_1:

    # ce "Not yet."
    ce "还没有。"

# game/episode021.rpy:473
translate simplified_chinese episode021_266f0c70:

    # c "Take us out of here then, before they blow us up alongside our escort."
    c "那就在他们把我们和护航舰一起炸毁前离开这里。"

# game/episode021.rpy:475
translate simplified_chinese episode021_77e0afba:

    # "Céline accelerated, just as several cruise missiles were fired on Skeda's cruiser."
    "就在几枚巡航导弹射向斯凯达的巡洋舰时，瑟琳加速了。"

# game/episode021.rpy:476
translate simplified_chinese episode021_1f390d00:

    # "We were still ignored by the attackers, who concentrated fully on the cruiser, which was now starting to disintegrate."
    "攻击者仍然无视我们，全力专注于那艘开始解体的巡洋舰。"

# game/episode021.rpy:477
translate simplified_chinese episode021_fa555ea6:

    # "Several missiles got past the cruiser's defenses, ripping out parts of the cruiser's hull."
    "几枚导弹突破了巡洋舰的防御，撕碎了部分船体。"

# game/episode021.rpy:479
translate simplified_chinese episode021_40215e0f:

    # "The Bastard cleared the battlezone when several explosions blasted the cruiser and its crew to bits."
    "当几次爆炸将巡洋舰及其船员炸成碎片时，\"私生子\"号已脱离战区。"

# game/episode021.rpy:481
translate simplified_chinese episode021_5e77a2d4:

    # c "Are they pursuing?"
    c "他们在追击吗？"

# game/episode021.rpy:482
translate simplified_chinese episode021_dc9565c6:

    # ce "Negative."
    ce "没有。"

# game/episode021.rpy:483
translate simplified_chinese episode021_77387f7a:

    # c "In any case, let's not stick around."
    c "无论如何，我们别在这儿逗留了。"

# game/episode021.rpy:484
translate simplified_chinese episode021_fd5d4694:

    # c "Get us to Petrarch as quickly as possible."
    c "尽快带我们去彼特拉克。"

# game/episode021.rpy:485
translate simplified_chinese episode021_10c2b0ec:

    # c "Damn, what a fucking useless escort that was."
    c "该死的，这护卫舰真他妈没用。"

# game/episode021.rpy:487
translate simplified_chinese episode021_7ee3f1d5:

    # "Céline had us on an all-out burn towards the edges of the contested zone."
    "瑟琳让我们全速驶向交战区边缘。"

# game/episode021.rpy:488
translate simplified_chinese episode021_5910a13d:

    # "We were target-locked multiple times, but apparently deemed not much of a threat or too little a valuable mark."
    "我们多次被目标锁定，但显然被认为威胁不大或价值不高。"

# game/episode021.rpy:489
translate simplified_chinese episode021_1cbdca95:

    # "Gradually, the signs of destruction and the fleets of ships fighting in the distance faded."
    "渐渐地，破坏的痕迹和远处交战的舰队群逐渐消失。"

# game/episode021.rpy:491
translate simplified_chinese episode021_b14e9621:

    # ce "We've just about cleared the battlefield."
    ce "我们差不多已经脱离战场了。"

# game/episode021.rpy:492
translate simplified_chinese episode021_e0145965:

    # c "Good, not a moment too soon."
    c "很好，时机刚好。"

# game/episode021.rpy:493
translate simplified_chinese episode021_32122add:

    # c "Can you punch in a straight course toward Petrarch?"
    c "能设定直飞彼特拉克的航线吗？"

# game/episode021.rpy:494
translate simplified_chinese episode021_309051c0:

    # ce "Done."
    ce "搞定。"

# game/episode021.rpy:499
translate simplified_chinese episode021_e829c4a5:

    # man "This is Captain Valinq of the Marleybone Irregulars."
    man "我是马利伯恩游击队的瓦林克舰长。"

# game/episode021.rpy:500
translate simplified_chinese episode021_22c6ca89:

    # man "I strongly suggest breaking off your current flight pattern and allowing us to pass undeterred."
    man "强烈建议你们立即改变当前航线，容我等不受阻碍地通过。"

# game/episode021.rpy:501
translate simplified_chinese episode021_3d9b9dd3:

    # "There was quite a long silence where the smaller ships were probably conferring among themselves."
    "通讯频道沉默了很长时间，那些小型飞船很可能正在内部商议。"

# game/episode021.rpy:502
translate simplified_chinese episode021_c961b97a:

    # "Their deliberations didn't take very long though."
    "不过他们的讨论并没有持续太久。"

# game/episode021.rpy:503
translate simplified_chinese episode021_8a9b6ff1:

    # woman "Captain Valinq, you are hereby granted passage."
    woman "瓦林克舰长，特此批准你的通行请求。"

# game/episode021.rpy:505
translate simplified_chinese episode021_41617f04:

    # c "Well, all you have to do is be polite to them, I guess?"
    c "好吧，看来你只要对他们保持礼貌就行了？"

# game/episode021.rpy:506
translate simplified_chinese episode021_2c3b584d:

    # av "The name of the Irregulars also seems to carry a lot of weight."
    av "游击队的名号似乎也很有分量。"

# game/episode021.rpy:508
translate simplified_chinese episode021_4452731a:

    # "We weren’t bothered for the rest of our passing through the contested zone."
    "在后续穿越争议区域的过程中，我们再未受到干扰。"

# game/episode021.rpy:509
translate simplified_chinese episode021_1cbdca95_1:

    # "Gradually, the signs of destruction and the fleets of ships fighting in the distance faded."
    "渐渐地，毁灭的痕迹和在远方交战的舰队群都逐渐消失了。"

# game/episode021.rpy:511
translate simplified_chinese episode021_5e1b2cf2:

    # man "Iron Bastard, this is Captain Valinq speaking."
    man "\"钢铁私生子\"号，这里是瓦林克舰长。"

# game/episode021.rpy:512
translate simplified_chinese episode021_0b339393:

    # man "This is as far as we'll go."
    man "我们就护送到这里了。"

# game/episode021.rpy:513
translate simplified_chinese episode021_aee85058:

    # man "You should be able to reach your destination on your own from here."
    man "从这里开始你应该能自行抵达目的地。"

# game/episode021.rpy:514
translate simplified_chinese episode021_ffc21b44:

    # man "There’s a lone gateway, not far from here, which you should cross."
    man "不远处有座孤立的星门，你们需要穿越过去。"

# game/episode021.rpy:515
translate simplified_chinese episode021_4b0ae93a:

    # man "It’s the only way into the system and shouldn’t be guarded."
    man "这是进入该星系的唯一通道，应该无人看守。"

# game/episode021.rpy:516
translate simplified_chinese episode021_44893814:

    # man "As for getting back from Petrarch, I wish you the best of luck."
    man "至于从彼特拉克返程的事，祝你们好运。"

# game/episode021.rpy:517
translate simplified_chinese episode021_23461983:

    # c "Thank you, Captain Valinq, for protecting us and for your...{w} uh...{w} final words of support..."
    c "感谢您，瓦林克舰长，感谢您的护送以及…{w}呃…{w}最后的鼓励话语…"

# game/episode021.rpy:519
translate simplified_chinese episode021_0e374e2c:

    # "The Marleybone Irregulars broke away and we were left to pursue our course to Petrarch."
    "马利伯恩游击队调转航向离开，我们则继续前往彼特拉克的行程。"

# game/episode021.rpy:520
translate simplified_chinese episode021_283a8108:

    # "The war theater we'd navigated earlier was replaced by an eerie silence as soon as we crossed the threshold into Petrarch territory."
    "刚进入彼特拉克疆域，先前穿越的战区就被诡异的寂静所取代。"

# game/episode021.rpy:521
translate simplified_chinese episode021_8024c827:

    # "No signs of battle were visible, nor were there any ships in the vicinity."
    "视野中既无战斗痕迹，附近也看不到任何飞船。"

# game/episode021.rpy:523
translate simplified_chinese episode021_81e7f09e:

    # ce "There’s only one object on our scanners and it appears to be the gate they were talking about."
    ce "扫描仪上只有一个目标，看来就是他们提到的那座星门。"

# game/episode021.rpy:524
translate simplified_chinese episode021_3df9ad8d:

    # c "Set a course and keep an eye out for unwelcome guests."
    c "设定航线，注意观察是否有不速之客。"

# game/episode021.rpy:526
translate simplified_chinese episode021_ea81ce4f:

    # ce "We’re approaching the gateway."
    ce "我们正在接近传送门。"

# game/episode021.rpy:527
translate simplified_chinese episode021_88bf991f:

    # c "No enemies in sight?"
    c "没有发现敌人？"

# game/episode021.rpy:528
translate simplified_chinese episode021_5f9be55c:

    # av "The area around the gate appears to be deserted."
    av "传送门周围的区域似乎空无一人。"

# game/episode021.rpy:529
translate simplified_chinese episode021_f5eca7b8:

    # c "Céline, take us through in that case."
    c "瑟琳，既然如此，带我们通过。"

# game/episode021.rpy:534
translate simplified_chinese episode021_8e36a349:

    # "Our passage through the gateway was instant and the change in scenery a marked one."
    "我们瞬间穿越了传送门，周围的景象发生了显著变化。"

# game/episode021.rpy:535
translate simplified_chinese episode021_307f35d9:

    # av "Petrarch should come into view in a few minutes."
    av "彼特拉克应该会在几分钟内进入视野。"

# game/episode021.rpy:536
translate simplified_chinese episode021_cc806eba:

    # av "No other ships on our scanners."
    av "扫描仪上没有其他飞船。"

# game/episode021.rpy:537
translate simplified_chinese episode021_11e73def:

    # c "Acknowledged."
    c "收到。"

# game/episode021.rpy:539
translate simplified_chinese episode021_e1d8444a:

    # "When the triple stars and our destination planet finally appeared, some of the crew let out an audible gasp."
    "当三颗恒星和我们的目的地行星终于出现时，一些船员发出了明显的惊叹声。"

# game/episode021.rpy:540
translate simplified_chinese episode021_6e5de444:

    # "We were all well aware of the age of the star system, but Petrarch actually looked ancient."
    "我们都很清楚这个恒星系的古老程度，但彼特拉克星球看起来简直像来自远古。"

# game/episode021.rpy:541
translate simplified_chinese episode021_28043c8d:

    # "Maybe it had to do with the quality of the light emanating from the stars we knew were slowly dying, or a trick of the chemical makeup of the system."
    "也许是因为那些我们知道正在缓慢消亡的恒星发出的光线特质，或是这个星系化学构成造成的视觉错觉。"

# game/episode021.rpy:543
translate simplified_chinese episode021_1e33f9af:

    # ce "The final approach to Petrarch will take us a few hours."
    ce "最后接近彼特拉克的过程还需要几个小时。"

# game/episode021.rpy:544
translate simplified_chinese episode021_e561ebd5:

    # ce "I’ll message you all when we’re about to make the final approach."
    ce "当我们即将开始最终接近时，我会通知大家。"

# game/episode021.rpy:545
translate simplified_chinese episode021_14e7e0d5:

    # c "Yes, now is a good time to catch up on some sleep."
    c "没错，现在正是补觉的好时机。"

# game/episode021.rpy:546
translate simplified_chinese episode021_51eeaed2:

    # c "Unless you all want to admire the dreariness in front of us."
    c "除非你们都想欣赏眼前这片阴郁景象。"

# game/episode021.rpy:547
translate simplified_chinese episode021_991013f7:

    # av "No, I’m good, sleep sounds a lot better."
    av "不了，我很好，睡觉听起来诱人得多。"

# game/episode021.rpy:548
translate simplified_chinese episode021_356b5471:

    # "We left Céline to navigate the final stretch toward Petrarch."
    "我们留下瑟琳独自操控飞船完成前往彼特拉克的最后航程。"

# game/episode021.rpy:562
translate simplified_chinese episode021_9a40a0ee:

    # "The comms crackled and Céline’s voice resounded throughout the ship."
    "通讯器发出噼啪声，瑟琳的声音响彻整艘飞船。"

# game/episode021.rpy:563
translate simplified_chinese episode021_c154612c:

    # ce "Captain to the bridge, we’re nearing Petrarch."
    ce "舰长请到舰桥，我们正在接近彼特拉克。"

# game/episode021.rpy:564
translate simplified_chinese episode021_87fa5f8d:

    # "When I joined Céline, the planet was already in our sights."
    "当我来到瑟琳身边时，这颗行星已经映入我们的眼帘。"

# game/episode021.rpy:565
translate simplified_chinese episode021_71c39713:

    # "Just like we’d expected, Petrarch appeared to be a barren world."
    "正如我们所预料的那样，彼特拉克看起来是个荒芜的世界。"

# game/episode021.rpy:566
translate simplified_chinese episode021_ea4c85c5:

    # "The ship’s scanners had detected large mountain ranges and a few oceans."
    "飞船扫描仪探测到了巨大的山脉和几片海洋。"

# game/episode021.rpy:568
translate simplified_chinese episode021_7f328c28:

    # c "Any sign of life?"
    c "有任何生命迹象吗？"

# game/episode021.rpy:569
translate simplified_chinese episode021_bb1a555a:

    # av "Not on the surface."
    av "地表上没有。"

# game/episode021.rpy:570
translate simplified_chinese episode021_827bba41:

    # av "However, I’m just now picking up a few energy signatures."
    av "不过，我现在探测到了一些能量信号。"

# game/episode021.rpy:571
translate simplified_chinese episode021_11293f80:

    # c "What kind?"
    c "什么样的？"

# game/episode021.rpy:572
translate simplified_chinese episode021_a282efc7:

    # av "According to our scans, those appear to be power sources."
    av "根据我们的扫描结果，那些似乎是能源。"

# game/episode021.rpy:573
translate simplified_chinese episode021_5e09a256:

    # c "What, like power generators?"
    c "什么，像是发电机吗？"

# game/episode021.rpy:574
translate simplified_chinese episode021_49ffbb4e:

    # av "Yes, maybe."
    av "是的，有可能。"

# game/episode021.rpy:575
translate simplified_chinese episode021_5e6d6b36:

    # c "But still no sign of life?"
    c "但仍然没有生命迹象？"

# game/episode021.rpy:576
translate simplified_chinese episode021_f5f6e081:

    # av "Nothing."
    av "没有。"

# game/episode021.rpy:577
translate simplified_chinese episode021_7166519c:

    # c "Weird."
    c "奇怪。"

# game/episode021.rpy:578
translate simplified_chinese episode021_ce620ca7:

    # c "Let’s check one of those sources out."
    c "我们去查看其中一个能量源吧。"

# game/episode021.rpy:579
translate simplified_chinese episode021_2217bc63:

    # c "I want to know the second we are being targeted."
    c "一旦被锁定目标我要立刻知道。"

# game/episode021.rpy:580
translate simplified_chinese episode021_6885301d:

    # av "Acknowledged."
    av "收到。"

# game/episode021.rpy:581
translate simplified_chinese episode021_4a95702d:

    # ce "Approaching the nearest power source."
    ce "正在接近最近的能源点。"

# game/episode021.rpy:583
translate simplified_chinese episode021_f94449e6:

    # "The Bastard broke through the atmosphere and began its vector toward the energy signature."
    "\"私生子\"号冲破大气层，开始向能量信号源方向前进。"

# game/episode021.rpy:584
translate simplified_chinese episode021_e26452af:

    # "The mountain ranges indicated on our map now came into visual range."
    "地图上标示的山脉现在进入了可视范围。"

# game/episode021.rpy:585
translate simplified_chinese episode021_dcee64cb:

    # "Long pillars of some type of black rock, hexagonal in shape, pierced the sky."
    "某种黑色岩石形成的长柱，呈六边形结构，直插云霄。"

# game/episode021.rpy:586
translate simplified_chinese episode021_854c5fd2:

    # "Pools of oily water lapped against the base of those large rock columns."
    "油污的水池拍打着那些巨大石柱的基座。"

# game/episode021.rpy:588
translate simplified_chinese episode021_8c0cd925:

    # "As the Bastard came nearer to our target, lights could be made out in the distance."
    "随着\"私生子\"号靠近目标，远处开始显现出灯光。"

# game/episode021.rpy:589
translate simplified_chinese episode021_3fcacb33:

    # c "Is that some kind of building?"
    c "那是某种建筑吗？"

# game/episode021.rpy:590
translate simplified_chinese episode021_80e90b06:

    # av "Looks like it."
    av "看起来像。"

# game/episode021.rpy:591
translate simplified_chinese episode021_55636436:

    # av "And the lights are on."
    av "而且灯还亮着。"

# game/episode021.rpy:592
translate simplified_chinese episode021_4376155c:

    # c "I think we can definitively say that the power is still on over there."
    c "我想我们可以确定地说那边的电力系统仍在运行。"

# game/episode021.rpy:593
translate simplified_chinese episode021_48f2afbd:

    # c "Céline, can you set us down near one of those buildings?"
    c "瑟琳，你能把我们降落在那些建筑附近吗？"

# game/episode021.rpy:595
translate simplified_chinese episode021_1c54f831:

    # ce "Yes, there should be enough landing space."
    ce "可以，那里应该有足够的降落空间。"

# game/episode021.rpy:596
translate simplified_chinese episode021_2340a0aa:

    # c "Okay crew, we’re going out."
    c "好的船员们，我们要出去了。"

# game/episode021.rpy:597
translate simplified_chinese episode021_65417bee:

    # c "Aven, Eva, Jade and Thyia, suit up and meet me at the air lock."
    c "艾文、伊娃、杰德和塞娅，穿上装备到气闸门与我会合。"

# game/episode021.rpy:599
translate simplified_chinese episode021_91448cc6:

    # "As we landed, Céline had some more information about the planet’s environment."
    "在我们着陆时，瑟琳获得了更多关于这颗行星环境的信息。"

# game/episode021.rpy:600
translate simplified_chinese episode021_0a4d29c2:

    # "Temperatures, while not comfortable, were very much in range of human tolerances and the air was also breathable."
    "温度虽然不算舒适，但完全在人类可承受范围内，空气也可以呼吸。"

# game/episode021.rpy:601
translate simplified_chinese episode021_7bf84dee:

    # "My recon team first secured the immediate surroundings of the landing area."
    "我的侦察小组首先确保了着陆区周边的安全。"

# game/episode021.rpy:603
translate simplified_chinese episode021_a5d86ec5:

    # "The silence permeating everything was striking."
    "笼罩一切的寂静令人震惊。"

# game/episode021.rpy:604
translate simplified_chinese episode021_eae8cf1d:

    # th "I’ve never been in a place that appeared to be so dead."
    th "我从未到过看起来如此死寂的地方。"

# game/episode021.rpy:605
translate simplified_chinese episode021_82ebbb87:

    # c "It sure seems that way."
    c "看起来确实是这样。"

# game/episode021.rpy:606
translate simplified_chinese episode021_d1218a24:

    # c "Let’s hope the planet doesn’t throw us some nasty surprises."
    c "希望这颗行星不会给我们带来什么糟糕的意外。"

# game/episode021.rpy:608
translate simplified_chinese episode021_14fe8f7d:

    # "Stairs were hewn from the black rock, the hexagonal shapes everywhere."
    "楼梯是从黑色岩石中开凿出来的，随处可见六边形结构。"

# game/episode021.rpy:609
translate simplified_chinese episode021_c756ffd0:

    # "As we climbed the stairs, the building came fully into view."
    "当我们爬上楼梯时，建筑的全貌映入眼帘。"

# game/episode021.rpy:610
translate simplified_chinese episode021_fc7da065:

    # "A menacing structure of sharp angles, glossy black material, bathed in an angry red light."
    "一座由尖锐角度构成的威胁性建筑，采用光滑的黑色材料，沐浴在刺目的红光中。"

# game/episode021.rpy:612
translate simplified_chinese episode021_f8015877:

    # "The entrance to the building was clearly marked and we approached with our guns drawn."
    "建筑入口标识清晰，我们持枪谨慎靠近。"

# game/episode021.rpy:613
translate simplified_chinese episode021_f4b65d8b:

    # th "Considering the power is on, I guess we should just hit the switch?"
    th "既然电力系统仍在运行，我想我们直接按下开关就行？"

# game/episode021.rpy:615
translate simplified_chinese episode021_845d15e1:

    # "Thyia indicated a glowing button next to the door."
    "塞娅指向门旁一个发光的按钮。"

# game/episode021.rpy:616
translate simplified_chinese episode021_6910d647:

    # c "Be ready for anything."
    c "做好应对任何情况的准备。"

# game/episode021.rpy:617
translate simplified_chinese episode021_f79c0cb3:

    # c "Thyia, on three..."
    c "塞娅，数到三…"

# game/episode021.rpy:618
translate simplified_chinese episode021_a3194e25:

    # c "One...{w} Two...{w} Three..."
    c "一…{w} 二…{w} 三…"

# game/episode021.rpy:620
translate simplified_chinese episode021_38c7f554:

    # "Thyia hit the button and the doors groaned open, revealing a glowing corridor beyond."
    "塞娅按下按钮，大门发出嘎吱声响缓缓开启，展露出后方发光的走廊。"

# game/episode021.rpy:621
translate simplified_chinese episode021_67bad8c7:

    # "The opening of the door also punctured the unnatural quiet."
    "大门的开启也打破了这片反常的寂静。"

# game/episode021.rpy:622
translate simplified_chinese episode021_b1419714:

    # "Inside, the mechanical sound of an air filtration system could be heard, as well as electronic murmuring from deeper inside the compound."
    "内部传来空气过滤系统的机械运转声，还有来自建筑深处电子设备的低鸣。"

# game/episode021.rpy:623
translate simplified_chinese episode021_535ee7b0:

    # c "Let’s see if anyone is inside."
    c "让我们看看里面是否有人。"

# game/episode021.rpy:625
translate simplified_chinese episode021_2bd57899:

    # "We entered the building and cleared the first sections of the corridor until we reached several doors."
    "我们进入建筑，清空了走廊的最初几段，直到抵达几扇门前。"

# game/episode021.rpy:626
translate simplified_chinese episode021_df5ecfea:

    # "Both doors opened with the push of a button, giving access to empty rooms."
    "按下按钮后，两扇门都打开了，里面是空无一物的房间。"

# game/episode021.rpy:628
translate simplified_chinese episode021_55ad5d98:

    # "The lights came on as soon as we stepped inside to clear the room."
    "我们刚踏入房间准备清场时，灯光就自动亮起。"

# game/episode021.rpy:629
translate simplified_chinese episode021_bde5bb06:

    # th "This seems to be a conference room."
    th "这看起来是个会议室。"

# game/episode021.rpy:630
translate simplified_chinese episode021_ad602383:

    # "A large table encircled by several chairs stood in the middle of the room."
    "房间中央摆着一张被数把椅子环绕的大会议桌。"

# game/episode021.rpy:631
translate simplified_chinese episode021_482be926:

    # "No dust covered the surface of the table, nor the chairs, but for some reason the entire scene didn’t have a lived-in feeling."
    "桌面上没有积灰，椅子也很干净，但不知为何整个场景毫无生活气息。"

# game/episode021.rpy:633
translate simplified_chinese episode021_68817231:

    # av "I guess the cleaning systems are still operating?"
    av "我猜清洁系统还在运转？"

# game/episode021.rpy:635
translate simplified_chinese episode021_2003be3f:

    # th "Seems so."
    th "看来是的。"

# game/episode021.rpy:636
translate simplified_chinese episode021_9ec8e12e:

    # th "Yet I can’t shake the feeling that nobody has sat in those chairs for a long time."
    th "但我总觉得那些椅子已经很久没人坐过了。"

# game/episode021.rpy:637
translate simplified_chinese episode021_1442a011:

    # j "The base consoles are operational as well."
    j "基地控制台也处于可操作状态。"

# game/episode021.rpy:638
translate simplified_chinese episode021_2809e2cb:

    # c "Lets clear the entire building before getting into all that."
    c "在深入探究之前，先把整栋建筑彻底搜查一遍。"

# game/episode021.rpy:639
translate simplified_chinese episode021_3bef5c0d:

    # c "As soon as we’ve made sure there’s nobody around, the rest of the crew can come over as well."
    c "等我们确认周围没人后，其他船员也可以过来了。"

# game/episode021.rpy:641
translate simplified_chinese episode021_6508f8d2:

    # av "You’re thinking of setting up a base of operations here?"
    av "你打算把这里作为行动基地？"

# game/episode021.rpy:642
translate simplified_chinese episode021_1893ff44:

    # c "Maybe, this building seems as good a place as any."
    c "也许吧，这栋建筑看起来和其他地方一样适合。"

# game/episode021.rpy:643
translate simplified_chinese episode021_2223d49d:

    # av "Agreed, from what I’ve seen outside, this building can be defended as well, if need be."
    av "同意，从我在外面观察到的情况来看，必要时这栋建筑也能进行防御。"

# game/episode021.rpy:644
translate simplified_chinese episode021_00e945a5:

    # c "Not looking forward to enduring a siege here, but good to know we’ve got options."
    c "虽然不想在这里经历围困，但知道我们还有选择总是好的。"

# game/episode021.rpy:646
translate simplified_chinese episode021_38590133:

    # "Our recon squad worked methodically across the entire first floor of the building, before entering the elevator to the second level."
    "我们的侦察小队有条不紊地搜查了整栋建筑的一楼，然后才进入通往二楼的电梯。"

# game/episode021.rpy:647
translate simplified_chinese episode021_44ff47ef:

    # "The second level was devoid of any life as well."
    "二楼同样没有任何生命迹象。"

# game/episode021.rpy:649
translate simplified_chinese episode021_24311f8f:

    # "We did find more rooms, including several living quarters and some sort of control room filled with computer consoles."
    "我们确实找到了更多房间，包括几间生活舱和某种布满计算机控制台的操作室。"

# game/episode021.rpy:650
translate simplified_chinese episode021_4f4069ab:

    # "The latter filled Jade with an almost unstoppable curiosity."
    "后者激起了杰德几乎无法抑制的好奇心。"

# game/episode021.rpy:651
translate simplified_chinese episode021_79965870:

    # "All of the rooms were clean, even clinically so."
    "所有房间都一尘不染，甚至洁净得如同手术室。"

# game/episode021.rpy:652
translate simplified_chinese episode021_a4fde99a:

    # "No personal effects appeared to be present, nor any other detritus that would have indicated any humanoid habitation."
    "没有发现任何个人物品，也没有其他人形生物居住过的痕迹。"

# game/episode021.rpy:653
translate simplified_chinese episode021_271799a2:

    # "I was hoping Jade’s analysis of the building’s mainframe would provide some clues."
    "我原本指望杰德对建筑主机的分析能提供一些线索。"

# game/episode021.rpy:654
translate simplified_chinese episode021_a4d94d09:

    # "Otherwise we’d need to venture outside as soon as possible to map our surroundings."
    "否则我们就必须尽快外出探索，绘制周边环境地图。"

# game/episode021.rpy:656
translate simplified_chinese episode021_2ede1a92:

    # "There was no indication of there being anything below the second floor, so after checking the entirety of it we signalled the rest of the crew to come join us."
    "没有任何迹象表明二楼以下还有空间，所以在彻底检查完这一层后，我们示意其他船员前来会合。"

# game/episode021.rpy:657
translate simplified_chinese episode021_3628aa88:

    # "Everyone was assigned a personal room in the living area of the compound."
    "大家在生活区都被分配了个人房间。"

# game/episode021.rpy:658
translate simplified_chinese episode021_621766e5:

    # "Jade got to work on the computers in the control room we’d found earlier, while Thyia began to inspect the internal systems of the base."
    "杰德开始研究我们在控制室发现的电脑，而塞娅则开始检查基地的内部系统。"

# game/episode021.rpy:659
translate simplified_chinese episode021_4a5cecef:

    # "That left us with some time to kill and the opportunity to plan our eventual expedition on the planet’s surface."
    "这让我们有些空闲时间，可以规划最终的地表探险计划。"

# game/episode021.rpy:677
translate simplified_chinese ep021_petrarch_choices_de8b5394:

    # "When we got back from visiting that unnerving pyramid, Eva and I decided to call a family meeting."
    "从那个令人不安的金字塔返回后，伊娃和我决定召开一次家庭会议。"

# game/episode021.rpy:679
translate simplified_chinese ep021_petrarch_choices_484c7c6f:

    # "When we got back from visiting that unnerving pyramid, Eva and I decided to call a meeting."
    "从那个令人不安的金字塔返回后，伊娃和我决定召开一次会议。"

# game/episode021.rpy:740
translate simplified_chinese ep021_petrarch_choices_5ce754d2:

    # "In order to fulfill my promise to Vess, I wanted a more neutral place to handle the breakups."
    "为了履行对薇丝的承诺，我想要一个更中立的地方来处理分手事宜。"

# game/episode021.rpy:741
translate simplified_chinese ep021_petrarch_choices_9f90f058:

    # "I told them I would meet them in their quarters."
    "我告诉她们我会在她们的住处见面。"

# game/episode021.rpy:743
translate simplified_chinese ep021_petrarch_choices_ed7fd93d:

    # "In order to fulfill my promise to Vess, I wanted a more neutral place to handle our breakup."
    "为了履行对薇丝的承诺，我想要一个更中立的地方来处理我们的分手。"

# game/episode021.rpy:744
translate simplified_chinese ep021_petrarch_choices_195cdae2:

    # "I told her I would meet her in her quarters."
    "我告诉她我会在她的住处见面。"

# game/episode021.rpy:788
translate simplified_chinese ep021_temple_278adf93:

    # "After the necessary preparations, we set out to the location on the map."
    "完成必要准备后，我们出发前往地图上的地点。"

# game/episode021.rpy:789
translate simplified_chinese ep021_temple_fc4d16c0:

    # "The trek proved to be rather difficult, due to the uneven terrain and slippery surfaces."
    "由于地形崎岖和路面湿滑，这次跋涉相当艰难。"

# game/episode021.rpy:791
translate simplified_chinese ep021_temple_6b124bfb:

    # l "This is such a gloomy place."
    l "这地方真阴森。"

# game/episode021.rpy:792
translate simplified_chinese ep021_temple_61ed7c35:

    # c "You can say that again."
    c "说得太对了。"

# game/episode021.rpy:793
translate simplified_chinese ep021_temple_21bf7760:

    # l "Paclerara felt so alive, but this place is completely lifeless."
    l "帕克莱拉拉充满生机，但这地方却毫无生气。"

# game/episode021.rpy:794
translate simplified_chinese ep021_temple_4376b716:

    # l "It even sounds dead."
    l "连声音都死气沉沉的。"

# game/episode021.rpy:795
translate simplified_chinese ep021_temple_e3dfadfe:

    # c "I know what you mean, silence never sounded so oppressive."
    c "我明白你的意思，寂静从未显得如此压抑。"

# game/episode021.rpy:797
translate simplified_chinese ep021_temple_80e5157a:

    # "We continued to climb over the rough terrain, making steady progress towards our end goal."
    "我们继续在崎岖的地形上攀爬，稳步朝着最终目标前进。"

# game/episode021.rpy:798
translate simplified_chinese ep021_temple_f26dfa2c:

    # "When we dropped from a ledge onto a large flat expanse, Eva let out a gasp."
    "当我们从一处岩架跳落到一大片平坦区域时，伊娃倒吸了一口凉气。"

# game/episode021.rpy:800
translate simplified_chinese ep021_temple_c9d8b4db:

    # e "Is that what I think it is?"
    e "那是我认为的东西吗？"

# game/episode021.rpy:801
translate simplified_chinese ep021_temple_1a570af3:

    # av "Those piles you mean?"
    av "你指的是那些堆状物？"

# game/episode021.rpy:802
translate simplified_chinese ep021_temple_e0d3420d:

    # e "Are those bones?"
    e "那些是骨头吗？"

# game/episode021.rpy:804
translate simplified_chinese ep021_temple_514631a6:

    # "Eva was right, large piles of bones lay strewn across the terrain, the signs of possible previous habitation of the planet."
    "伊娃说得对，大堆的骨头散落在地面上，这可能是这个星球曾有生物居住的迹象。"

# game/episode021.rpy:805
translate simplified_chinese ep021_temple_cf6cc58c:

    # "There were so many bones scattered on the ground that we couldn’t help but step on them."
    "地上散落的骨头太多了，我们不得不踩在上面。"

# game/episode021.rpy:806
translate simplified_chinese ep021_temple_087873dc:

    # "The mealy crushing and breaking sounds filled us all with disgust, but there was no other way forward."
    "那些细碎的碾压和断裂声让我们都感到恶心，但前方别无他路。"

# game/episode021.rpy:807
translate simplified_chinese ep021_temple_59518fd9:

    # c "Humanoid skeletons, I think?"
    c "是人形骨架，我觉得？"

# game/episode021.rpy:809
translate simplified_chinese ep021_temple_8625d3a6:

    # na "Yes, it appears so."
    na "是的，看起来是这样。"

# game/episode021.rpy:810
translate simplified_chinese ep021_temple_90c3c479:

    # na "All ancient, as far as I can tell."
    na "据我判断，这些都很古老了。"

# game/episode021.rpy:811
translate simplified_chinese ep021_temple_055a55a3:

    # av "So this is some mass grave that somehow got excavated by some force?"
    av "所以这是个被某种力量挖掘出来的乱葬岗？"

# game/episode021.rpy:812
translate simplified_chinese ep021_temple_ddc19c4e:

    # na "No, I don’t think so."
    na "不，我不这么认为。"

# game/episode021.rpy:813
translate simplified_chinese ep021_temple_134a63c1:

    # c "This looks more like the remnants of a massacre."
    c "这看起来更像是大屠杀的遗迹。"

# game/episode021.rpy:815
translate simplified_chinese ep021_temple_1e6b7645:

    # l "So they murdered each other?"
    l "所以他们互相残杀？"

# game/episode021.rpy:816
translate simplified_chinese ep021_temple_9d17c198:

    # e "Or they’re all victims and got killed by something else."
    e "或者他们都是受害者，被别的东西杀死了。"

# game/episode021.rpy:817
translate simplified_chinese ep021_temple_bf5920ea:

    # c "Whatever happened, this planet grows more charming by the minute."
    c "无论发生了什么，这个星球真是越来越\"迷人\"了。"

# game/episode021.rpy:819
translate simplified_chinese ep021_temple_4cf77d26:

    # "We ventured on through the boneyard, until something glowing became visible on the horizon."
    "我们继续在骨堆中穿行，直到地平线上出现发光的东西。"

# game/episode021.rpy:820
translate simplified_chinese ep021_temple_4f163967:

    # e "Are those the same type of crystal as the Key?"
    e "那些是和钥匙同类型的水晶吗？"

# game/episode021.rpy:821
translate simplified_chinese ep021_temple_4f72a19b:

    # c "It sure looks the same."
    c "看起来确实一样。"

# game/episode021.rpy:823
translate simplified_chinese ep021_temple_86d5370a:

    # "The crystals were hovering above a large structure, a pyramid of sorts, built in the same unnerving style as the compound we were staying at."
    "水晶悬浮在一座巨型建筑上方，那是一座类似金字塔的结构，其建筑风格与我们暂居的建筑群同样令人不安。"

# game/episode021.rpy:824
translate simplified_chinese ep021_temple_8b150957:

    # "The grounds directly surrounding the pyramid were devoid of any skeletons, a peculiar contrast to the heaps of bones behind us."
    "金字塔周围的区域没有任何骨骸，与我们身后的累累白骨形成了奇特对比。"

# game/episode021.rpy:825
translate simplified_chinese ep021_temple_1b7c7e36:

    # "An entrance was clearly marked by lights and ornate archways, it didn’t at all look inviting."
    "入口处用灯光和装饰华丽的拱门明确标示，但看起来完全不像在欢迎访客。"

# game/episode021.rpy:827
translate simplified_chinese ep021_temple_2b6779bf:

    # e "Are we going inside?"
    e "我们要进去吗？"

# game/episode021.rpy:828
translate simplified_chinese ep021_temple_532dea66:

    # c "I’d rather not, but according to the maps this was an important place."
    c "我宁愿不进去，但根据地图显示，这是个重要地点。"

# game/episode021.rpy:830
translate simplified_chinese ep021_temple_6893b3c4:

    # "We approached the temple, guns drawn and waited before the entrance doors."
    "我们举着枪靠近神庙，在入口大门前等候。"

# game/episode021.rpy:832
translate simplified_chinese ep021_temple_9ef90280:

    # "Thyia slammed the button and the doors slowly groaned open."
    "塞娅猛拍按钮，大门缓缓发出嘎吱声开启。"

# game/episode021.rpy:833
translate simplified_chinese ep021_temple_25e83ece:

    # "The corridor behind looked familiar, obviously the same build as the ones in our building, but larger."
    "后面的走廊看起来很眼熟，显然与我们那栋建筑内的构造相同，只是规模更大。"

# game/episode021.rpy:834
translate simplified_chinese ep021_temple_e5c5b51a:

    # "Just as the compound we had set up as a base, this pyramid appeared to be devoid of any life."
    "正如我们设为基地的建筑群一样，这座金字塔似乎也毫无生命迹象。"

# game/episode021.rpy:836
translate simplified_chinese ep021_temple_feb7b786:

    # "Quickly we cleared the corridor and adjacent rooms, arriving at a narrow staircase leading further up into the pyramid."
    "我们迅速清理了走廊和相邻房间，来到一段狭窄的楼梯前，楼梯继续向上通往金字塔更深处。"

# game/episode021.rpy:837
translate simplified_chinese ep021_temple_358237aa:

    # "After ascending the staircase, we found ourselves in a large circular room."
    "登上楼梯后，我们发现自己置身于一个巨大的圆形房间。"

# game/episode021.rpy:839
translate simplified_chinese ep021_temple_360513a2:

    # "Spherical pods and all kinds of strange equipment surrounded something that looked both like a pedestal and a hospital bed."
    "球形舱和各种奇怪的设备环绕着一个既像基座又像病床的东西。"

# game/episode021.rpy:841
translate simplified_chinese ep021_temple_847b2d09:

    # l "It looks like an operating theater."
    l "这看起来像个手术室。"

# game/episode021.rpy:842
translate simplified_chinese ep021_temple_2a72decc:

    # av "I was about to say that it looks like an arena with an altar in the middle."
    av "我正想说这看起来像个竞技场，中间有个祭坛。"

# game/episode021.rpy:844
translate simplified_chinese ep021_temple_28f7259e:

    # e "Whatever it was, this place gives me the creeps."
    e "不管这是什么地方，都让我毛骨悚然。"

# game/episode021.rpy:845
translate simplified_chinese ep021_temple_86b47164:

    # c "It sure is unnerving."
    c "确实令人不安。"

# game/episode021.rpy:846
translate simplified_chinese ep021_temple_ac9c46f8:

    # c "Do those consoles still work, Jade?"
    c "那些控制台还能用吗，杰德？"

# game/episode021.rpy:848
translate simplified_chinese ep021_temple_d20fa044:

    # j "Looks like it."
    j "看起来可以。"

# game/episode021.rpy:849
translate simplified_chinese ep021_temple_8b09f11e:

    # j "Whatever is powering the devices in our compound is also keeping this building running."
    j "为我们基地设备供能的能源，同样也在维持着这座建筑的运转。"

# game/episode021.rpy:850
translate simplified_chinese ep021_temple_e3c79a98:

    # th "Might be good to check those computers for clues."
    th "或许该检查下那些电脑找找线索。"

# game/episode021.rpy:851
translate simplified_chinese ep021_temple_9030d8e4:

    # e "Do we really have to stay here?"
    e "我们真的必须待在这里吗？"

# game/episode021.rpy:852
translate simplified_chinese ep021_temple_214e7d9c:

    # c "No, it might be best if we come back later."
    c "不，也许我们改天再来会更好。"

# game/episode021.rpy:853
translate simplified_chinese ep021_temple_92a07f44:

    # c "We’ve wasted a lot of time getting here and there’s the journey back to consider as well."
    c "我们花了太多时间才到这里，还得考虑返程的路。"

# game/episode021.rpy:854
translate simplified_chinese ep021_temple_0efeec4a:

    # c "There’s enough space to land the Bastard in the vicinity of the pyramid, so we’ll ask Céline to pilot us here tomorrow."
    c "金字塔附近有足够空间让\"私生子\"号降落，所以我们明天会请瑟琳开飞船过来。"

# game/episode021.rpy:856
translate simplified_chinese ep021_temple_e140dec9:

    # "Everyone agreed and we began our journey back to the building where the others were waiting for us."
    "大家一致同意，我们开始返回其他人等候我们的建筑。"

# game/episode021.rpy:859
translate simplified_chinese ep021_temple_53883b61:

    # c "Are you okay, sis?"
    c "你还好吗，妹妹？"

# game/episode021.rpy:861
translate simplified_chinese ep021_temple_d79b52c0:

    # c "Are you okay, Eva?"
    c "你还好吗，伊娃？"

# game/episode021.rpy:862
translate simplified_chinese ep021_temple_7f3bf486:

    # e "Yes, though I’m glad we’re out of that pyramid."
    e "还好，不过很高兴我们离开了那座金字塔。"

# game/episode021.rpy:863
translate simplified_chinese ep021_temple_8315b9e9:

    # c "No more queasiness?"
    c "不再恶心了吗？"

# game/episode021.rpy:864
translate simplified_chinese ep021_temple_5d28a474:

    # e "Thankfully no."
    e "谢天谢地，没有了。"

# game/episode021.rpy:865
translate simplified_chinese ep021_temple_7e689c7c:

    # e "But bad things happened in that pyramid, [p_name_short], I just know it."
    e "但那个金字塔里发生过可怕的事，[p_name_short]，我就是知道。"

# game/episode021.rpy:866
translate simplified_chinese ep021_temple_610e04bf:

    # c "Well, like Lilly said, it looked like a surgery, but with a lot of room for an audience."
    c "嗯，就像莉莉说的，看起来像手术室，但有很多观众席的空间。"

# game/episode021.rpy:867
translate simplified_chinese ep021_temple_64c05970:

    # c "I can’t imagine why you’d need a large audience to perform medical procedures."
    c "我无法想象为什么做医疗手术需要大量观众。"

# game/episode021.rpy:869
translate simplified_chinese ep021_temple_ac6010f5:

    # na "That’s how they allowed students to learn about medical procedures in ancient times, I believe, hence the name “theater”."
    na "我相信在古代他们就是这样让学生学习医疗程序的，所以叫\"剧院\"。"

# game/episode021.rpy:870
translate simplified_chinese ep021_temple_789e9108:

    # c "But they didn’t perform those procedures for arena crowds, did they?"
    c "但他们不会在竞技场观众面前进行这些手术吧？"

# game/episode021.rpy:871
translate simplified_chinese ep021_temple_38615658:

    # na "I don’t think so."
    na "我觉得不会。"

# game/episode021.rpy:872
translate simplified_chinese ep021_temple_d22cfe96:

    # c "Maybe whatever they did in there had some religious meaning for whoever lived here once."
    c "也许他们在这里做的事对曾经住在这里的人有某种宗教意义。"

# game/episode021.rpy:874
translate simplified_chinese ep021_temple_a86dc4e7:

    # e "Why does that make me think of live sacrifices?"
    e "为什么这让我联想到活人献祭？"

# game/episode021.rpy:875
translate simplified_chinese ep021_temple_d2bd29cb:

    # e "Ugh, let’s just go back."
    e "呃，我们还是回去吧。"

# game/episode021.rpy:876
translate simplified_chinese ep021_temple_bc7835ed:

    # e "I can’t wait to leave this planet."
    e "我迫不及待想离开这个星球了。"

# game/episode021.rpy:877
translate simplified_chinese ep021_temple_4011bb05:

    # c "No argument there."
    c "这一点我完全同意。"

# game/episode021.rpy:884
translate simplified_chinese ep021_temple_return_a660f752:

    # "We returned to the temple the next day, Céline ferrying us over with the Bastard."
    "第二天我们返回了神庙，瑟琳用\"私生子\"号载我们过去。"

# game/episode021.rpy:885
translate simplified_chinese ep021_temple_return_cc303a9c:

    # "Eva opted to stay behind with several others, the place giving her the creeps."
    "伊娃选择和其他几个人留在后面，这地方让她毛骨悚然。"

# game/episode021.rpy:886
translate simplified_chinese ep021_temple_return_58ac4094:

    # "I wasn’t planning on staying at the site longer than we had to, but we needed to investigate."
    "我本不打算在这个遗址待得比必要时间更长，但我们确实需要调查。"

# game/episode021.rpy:888
translate simplified_chinese ep021_temple_return_c63139c9:

    # "Jade started working on the computers, while Thyia and Céline inspected the systems in the bowels of the temple."
    "杰德开始处理电脑系统，而塞娅和瑟琳则检查神庙深处的系统。"

# game/episode021.rpy:890
translate simplified_chinese ep021_temple_return_67bdede1:

    # ki "I can see why Eva didn’t want to go with us."
    ki "我现在明白为什么伊娃不想跟我们一起来了。"

# game/episode021.rpy:891
translate simplified_chinese ep021_temple_return_146d4388:

    # ki "Wish I had stayed behind as well."
    ki "真希望我也留在后面。"

# game/episode021.rpy:892
translate simplified_chinese ep021_temple_return_6c0a5800:

    # c "And here I thought you were going to provide some moral support."
    c "我还以为你会给我些精神支持呢。"

# game/episode021.rpy:893
translate simplified_chinese ep021_temple_return_91e5af28:

    # ki "Nope, hate this place and I want to be gone as soon as possible."
    ki "不，我讨厌这地方，想尽快离开。"

# game/episode021.rpy:894
translate simplified_chinese ep021_temple_return_5d48eb07:

    # c "Go help Thyia and Céline then, I’ll keep watch here."
    c "那你去帮塞娅和瑟琳吧，我在这儿守着。"

# game/episode021.rpy:895
translate simplified_chinese ep021_temple_return_dc60b772:

    # ki "Roger that."
    ki "收到。"

# game/episode021.rpy:897
translate simplified_chinese ep021_temple_return_9dbb7757:

    # "Jade spent hours working on the computer consoles, Nadya helping her out where she could."
    "杰德花了几个小时研究那些电脑控制台，娜迪亚在力所能及的地方帮着她。"

# game/episode021.rpy:899
translate simplified_chinese ep021_temple_return_392db8a9:

    # "Thyia and Céline eventually came back and reported nothing out of the ordinary."
    "塞娅和瑟琳最终回来报告说没发现什么异常情况。"

# game/episode021.rpy:900
translate simplified_chinese ep021_temple_return_11aa47df:

    # "The temple was powered by the same technology we found in the compound we occupied as a base."
    "这座神殿使用的能源技术，和我们占据作为基地的那个建筑群里发现的技术相同。"

# game/episode021.rpy:902
translate simplified_chinese ep021_temple_return_a13f1f59:

    # j "Uh, [p_name], I think I’ve got something."
    j "呃，[p_name]，我想我发现了些东西。"

# game/episode021.rpy:904
translate simplified_chinese ep021_temple_return_9beef571:

    # j "Uh, [p_name_short], I think I’ve got something."
    j "呃，[p_name_short]，我想我发现了些东西。"

# game/episode021.rpy:905
translate simplified_chinese ep021_temple_return_d6f20865:

    # c "Let’s hear it."
    c "说来听听。"

# game/episode021.rpy:907
translate simplified_chinese ep021_temple_return_6a34e504:

    # j "The console has some sort of simulation port we can interface with."
    j "控制台有个模拟端口，我们可以连接进去。"

# game/episode021.rpy:908
translate simplified_chinese ep021_temple_return_01cfd372:

    # j "And there’s simulation data available in the system."
    j "而且系统里还存有模拟数据。"

# game/episode021.rpy:909
translate simplified_chinese ep021_temple_return_ab56a972:

    # c "Do you know what it’s about?"
    c "你知道那是关于什么的吗？"

# game/episode021.rpy:910
translate simplified_chinese ep021_temple_return_bc96ef01:

    # j "No, the only way to find out is to enter the simulation."
    j "不知道，唯一的办法就是进入模拟程序。"

# game/episode021.rpy:911
translate simplified_chinese ep021_temple_return_6f4bcddf:

    # c "Yeah, not doing that."
    c "是啊，我才不干。"

# game/episode021.rpy:912
translate simplified_chinese ep021_temple_return_878a13cb:

    # c "I don’t want to get trapped in an alien sim."
    c "我可不想被困在外星模拟程序里。"

# game/episode021.rpy:914
translate simplified_chinese ep021_temple_return_4a20a54c:

    # th "The simulation hardware isn’t as advanced as ours."
    th "这个模拟硬件没有我们的先进。"

# game/episode021.rpy:915
translate simplified_chinese ep021_temple_return_1ab4c766:

    # th "It’s rather primitive, to be honest."
    th "说实话，这相当原始。"

# game/episode021.rpy:916
translate simplified_chinese ep021_temple_return_23e6149f:

    # th "No neural interface or other cortex stimulation."
    th "没有神经接口或其他皮层刺激装置。"

# game/episode021.rpy:918
translate simplified_chinese ep021_temple_return_5d39b4f5:

    # j "Yes, this is really old technology."
    j "是的，这确实是老掉牙的技术。"

# game/episode021.rpy:920
translate simplified_chinese ep021_temple_return_8cd2f190:

    # na "I believe it was called virtual reality at some point?"
    na "我记得以前好像叫虚拟现实？"

# game/episode021.rpy:922
translate simplified_chinese ep021_temple_return_0ddde392:

    # th "A really misleading term, but yeah."
    th "真是个容易误导人的术语，不过确实如此。"

# game/episode021.rpy:923
translate simplified_chinese ep021_temple_return_84a98a46:

    # th "People apparently wore glasses that projected computer generated imagery."
    th "人们显然戴着能投射计算机生成图像的眼镜。"

# game/episode021.rpy:924
translate simplified_chinese ep021_temple_return_9db6dcdb:

    # c "Quaint."
    c "真够古朴的。"

# game/episode021.rpy:925
translate simplified_chinese ep021_temple_return_df9fc0d2:

    # th "Cutting-edge at some point in history."
    th "在历史的某个时期这可是尖端科技。"

# game/episode021.rpy:926
translate simplified_chinese ep021_temple_return_1d09338b:

    # c "So were cave paintings."
    c "洞穴壁画也曾是尖端艺术。"

# game/episode021.rpy:927
translate simplified_chinese ep021_temple_return_b6310296:

    # c "Alright, if there’s no risk of getting trapped we should check it out."
    c "好吧，既然没有被困住的风险，我们应该进去看看。"

# game/episode021.rpy:929
translate simplified_chinese ep021_temple_return_f710591c:

    # j "I’ll prepare the system."
    j "我来准备系统。"

# game/episode021.rpy:930
translate simplified_chinese ep021_temple_return_7fc2306a:

    # c "How many of us can go in?"
    c "我们有多少人能进去？"

# game/episode021.rpy:931
translate simplified_chinese ep021_temple_return_381e63b4:

    # j "The interface allows three parallel connections."
    j "这个接口支持三个并行连接。"

# game/episode021.rpy:933
translate simplified_chinese ep021_temple_return_8388c0a8:

    # c "Right, Mom and Thyia should come with, I think."
    c "没错，我想妈妈和塞娅应该一起来。"

# game/episode021.rpy:935
translate simplified_chinese ep021_temple_return_ecda8c3a:

    # c "Right, Nadya and Thyia should come with, I think."
    c "没错，我想娜迪亚和塞娅应该一起来。"

# game/episode021.rpy:936
translate simplified_chinese ep021_temple_return_c19f2570:

    # c "Jade, you monitor the system and the rest can watch over us."
    c "杰德，你监控系统，其他人负责照看我们。"

# game/episode021.rpy:938
translate simplified_chinese ep021_temple_return_8051946a:

    # "Jade primed the system for us, while Thyia and Nadya prepared to enter the simulation."
    "杰德为我们启动了系统，同时塞娅和娜迪亚准备进入模拟程序。"

# game/episode021.rpy:939
translate simplified_chinese ep021_temple_return_2b000b48:

    # j "The sim is ready."
    j "模拟程序已准备就绪。"

# game/episode021.rpy:940
translate simplified_chinese ep021_temple_return_adccdb42:

    # j "Please use the headsets available."
    j "请使用提供的头戴设备。"

# game/episode021.rpy:942
translate simplified_chinese ep021_temple_return_ddbeb393:

    # "Nothing seemed to change when we put the sets on our heads."
    "当我们戴上头显时，似乎没有任何变化。"

# game/episode021.rpy:944
translate simplified_chinese ep021_temple_return_9884b7f7:

    # "But then visuals projected by our headsets began to cover our view, making the others fade away slowly."
    "但随后头显投射的视觉影像开始覆盖我们的视线，使其他人慢慢淡出视野。"

# game/episode021.rpy:946
translate simplified_chinese ep021_temple_return_06264f81:

    # "The chamber now appeared to be empty, until an alien stepped into view."
    "舱室现在显得空无一人，直到一个外星人步入视野。"

# game/episode021.rpy:947
translate simplified_chinese ep021_temple_return_720f1cac:

    # "When the alien spoke, it did so in an unfamiliar language."
    "当外星人开口说话时，使用的是一种陌生的语言。"

# game/episode021.rpy:948
translate simplified_chinese ep021_temple_return_e80f91e7:

    # "Strange guttural sounds emanated from the creature, which should have been unintelligible, but the three of us seemed to understand perfectly."
    "这个生物发出奇怪的喉音，本应无法理解，但我们三人似乎完全听懂了。"

# game/episode021.rpy:951
translate simplified_chinese ep021_temple_return_d5c949ba:

    # shk "Welcome, your arrival has been eagerly anticipated..."
    shk "欢迎，我们一直热切期盼着您的到来…"

# game/episode021.rpy:958
translate simplified_chinese ep021_jade_talk_6c0645d3:

    # "Jade had successfully breached the systems of the base and was now working with Céline to get some useful data."
    "杰德已成功侵入基地系统，现在正与瑟琳合作获取有用数据。"

# game/episode021.rpy:960
translate simplified_chinese ep021_jade_talk_ef1825af:

    # c "So locking yourself up inside this control room finally paid off?"
    c "所以把自己锁在这个控制室里终于有回报了？"

# game/episode021.rpy:961
translate simplified_chinese ep021_jade_talk_ac2ed105:

    # j "I think so."
    j "我想是的。"

# game/episode021.rpy:962
translate simplified_chinese ep021_jade_talk_1aa983d1:

    # j "The user interface of the system is not in any language I know."
    j "这个系统的用户界面使用的不是我所知的任何语言。"

# game/episode021.rpy:963
translate simplified_chinese ep021_jade_talk_061b4566:

    # j "But I managed to pull up some imagery, just by trying out different key combinations."
    j "但我通过尝试不同的按键组合，成功调出了一些图像。"

# game/episode021.rpy:964
translate simplified_chinese ep021_jade_talk_3e36dcaf:

    # j "Those images appear to be maps of this place."
    j "那些图像似乎是这个地方的地图。"

# game/episode021.rpy:965
translate simplified_chinese ep021_jade_talk_b38f535c:

    # j "According to Céline they line up with what little the Bastard’s sensors can pick up."
    j "据瑟琳说，这些地图与\"私生子\"号传感器能探测到的少量信息吻合。"

# game/episode021.rpy:966
translate simplified_chinese ep021_jade_talk_74fe7148:

    # c "Anything interesting on those maps?"
    c "那些地图上有什么有趣的东西吗？"

# game/episode021.rpy:968
translate simplified_chinese ep021_jade_talk_28c53a23:

    # j "There are lots of places on those maps, but without a legend in a language we can read it’s fairly impossible to determine anything."
    j "地图上有很多地点，但没有我们能读懂的文字说明，几乎不可能确定任何信息。"

# game/episode021.rpy:969
translate simplified_chinese ep021_jade_talk_569f9d48:

    # c "So we need to visit all those places?"
    c "所以我们需要去所有这些地方看看？"

# game/episode021.rpy:970
translate simplified_chinese ep021_jade_talk_d55c2753:

    # j "That’s what Céline and I feared at first."
    j "这正是瑟琳和我一开始所担心的。"

# game/episode021.rpy:972
translate simplified_chinese ep021_jade_talk_cd911189:

    # j "But there’s one place that appears on all those maps and is consistently marked differently than the other points of interest."
    j "但有个地方在所有地图上都有出现，并且始终与其他兴趣点有着不同的标记方式。"

# game/episode021.rpy:973
translate simplified_chinese ep021_jade_talk_f6a9b118:

    # c "The planet’s capital?"
    c "是这个星球的首都吗？"

# game/episode021.rpy:975
translate simplified_chinese ep021_jade_talk_92713d00:

    # j "Maybe."
    j "也许是。"

# game/episode021.rpy:976
translate simplified_chinese ep021_jade_talk_fb09acd6:

    # j "Though a lot of other places seem to be connected somehow."
    j "不过许多其他地方似乎也以某种方式相互连接。"

# game/episode021.rpy:977
translate simplified_chinese ep021_jade_talk_bb259c92:

    # c "Like a network?"
    c "像网络一样？"

# game/episode021.rpy:978
translate simplified_chinese ep021_jade_talk_131c2ccf:

    # j "Something like that."
    j "差不多是这样。"

# game/episode021.rpy:979
translate simplified_chinese ep021_jade_talk_9596e5d8:

    # c "Is that spot far from here?"
    c "那个地方离这里远吗？"

# game/episode021.rpy:981
translate simplified_chinese ep021_jade_talk_31f28fd0:

    # j "We seem to have landed quite near, so the place can probably be reached on foot."
    j "我们似乎降落得很近，步行应该就能到达那里。"

# game/episode021.rpy:982
translate simplified_chinese ep021_jade_talk_5bc2b85c:

    # c "Good, I think it’s time for an expedition."
    c "很好，我觉得是时候组织一次探险了。"

# game/episode021.rpy:983
translate simplified_chinese ep021_jade_talk_ada92a2a:

    # c "I’ll inform the others."
    c "我去通知其他人。"

# game/episode021.rpy:992
translate simplified_chinese ep021_nadya_talk_petrarch_5109fbff:

    # "I was surprised to find my mother lying in her sleepwear on the couch when I entered my quarters."
    "当我走进自己房间时，惊讶地发现母亲穿着睡衣躺在沙发上。"

# game/episode021.rpy:993
translate simplified_chinese ep021_nadya_talk_petrarch_83a242ed:

    # c "Mom?"
    c "妈妈？"

# game/episode021.rpy:995
translate simplified_chinese ep021_nadya_talk_petrarch_693386a5:

    # "I was surprised to find Nadya lying in her sleepwear on the couch when I entered my quarters."
    "当我走进自己房间时，惊讶地发现娜迪亚穿着睡衣躺在沙发上。"

# game/episode021.rpy:996
translate simplified_chinese ep021_nadya_talk_petrarch_011bb546:

    # c "Nadya?"
    c "娜迪亚？"

# game/episode021.rpy:998
translate simplified_chinese ep021_nadya_talk_petrarch_b55634e2:

    # na "Oh!"
    na "哦！"

# game/episode021.rpy:999
translate simplified_chinese ep021_nadya_talk_petrarch_b6639dbd:

    # na "Sorry, I must have fallen asleep."
    na "抱歉，我一定是睡着了。"

# game/episode021.rpy:1000
translate simplified_chinese ep021_nadya_talk_petrarch_74354afe:

    # c "Were you waiting on me?"
    c "你是在等我吗？"

# game/episode021.rpy:1002
translate simplified_chinese ep021_nadya_talk_petrarch_9e99c962:

    # na "Yes, I wanted to talk to you."
    na "是的，我想和你谈谈。"

# game/episode021.rpy:1003
translate simplified_chinese ep021_nadya_talk_petrarch_8500ba66:

    # na "But you were gone for a long time and I must have dozed off."
    na "但你去了很久，我一定是打瞌睡了。"

# game/episode021.rpy:1006
translate simplified_chinese ep021_nadya_talk_petrarch_c689fa2a:

    # na "I just wanted to congratulate you and Eva again."
    na "我只是想再次祝贺你和伊娃。"

# game/episode021.rpy:1007
translate simplified_chinese ep021_nadya_talk_petrarch_76a92099:

    # na "This is such a special moment for you both."
    na "对你们两人来说，这是个非常特别的时刻。"

# game/episode021.rpy:1009
translate simplified_chinese ep021_nadya_talk_petrarch_f7c2eef3:

    # na "And for me as a future grandmother as well."
    na "对我这个未来的祖母也是如此。"

# game/episode021.rpy:1010
translate simplified_chinese ep021_nadya_talk_petrarch_e897fbb0:

    # c "Thank you."
    c "谢谢。"

# game/episode021.rpy:1011
translate simplified_chinese ep021_nadya_talk_petrarch_5327cc36:

    # na "Please do not hesitate to rely on me for any help you need."
    na "如果需要任何帮助，请尽管依赖我。"

# game/episode021.rpy:1013
translate simplified_chinese ep021_nadya_talk_petrarch_d461082b:

    # na "And I’m sure your sisters will be happy to help as well."
    na "我相信你的姐妹们也会很乐意帮忙的。"

# game/episode021.rpy:1017
translate simplified_chinese ep021_nadya_talk_petrarch_1de8a9d9:

    # na "Even Lilly and Aven, once they come around to accepting the situation."
    na "即使是莉莉和艾文，等她们接受这个情况后也会的。"

# game/episode021.rpy:1018
translate simplified_chinese ep021_nadya_talk_petrarch_ab559597:

    # c "I certainly hope they will."
    c "我当然希望她们会。"

# game/episode021.rpy:1019
translate simplified_chinese ep021_nadya_talk_petrarch_2c63ba57:

    # na "It takes time."
    na "这需要时间。"

# game/episode021.rpy:1020
translate simplified_chinese ep021_nadya_talk_petrarch_07d09874:

    # na "Besides, there’s not much else they can do."
    na "再说，她们也做不了什么别的。"

# game/episode021.rpy:1022
translate simplified_chinese ep021_nadya_talk_petrarch_a777fe68:

    # na "Even Lilly, once she comes around to accepting the situation."
    na "就连莉莉，一旦她接受了这个情况。"

# game/episode021.rpy:1023
translate simplified_chinese ep021_nadya_talk_petrarch_35151593:

    # c "I certainly hope she will."
    c "我当然希望她会接受。"

# game/episode021.rpy:1024
translate simplified_chinese ep021_nadya_talk_petrarch_2c63ba57_1:

    # na "It takes time."
    na "这需要时间。"

# game/episode021.rpy:1025
translate simplified_chinese ep021_nadya_talk_petrarch_1f0fc5ad:

    # na "Besides, there’s not much else she can do."
    na "再说了，她也没什么别的办法。"

# game/episode021.rpy:1027
translate simplified_chinese ep021_nadya_talk_petrarch_a90908db:

    # na "Even Aven, once she comes around to accepting the situation."
    na "就连艾文，一旦她接受了这个情况。"

# game/episode021.rpy:1028
translate simplified_chinese ep021_nadya_talk_petrarch_35151593_1:

    # c "I certainly hope she will."
    c "我当然希望她会接受。"

# game/episode021.rpy:1029
translate simplified_chinese ep021_nadya_talk_petrarch_2c63ba57_2:

    # na "It takes time."
    na "这需要时间。"

# game/episode021.rpy:1030
translate simplified_chinese ep021_nadya_talk_petrarch_1f0fc5ad_1:

    # na "Besides, there’s not much else she can do."
    na "再说了，她也没什么别的办法。"

# game/episode021.rpy:1031
translate simplified_chinese ep021_nadya_talk_petrarch_d2e53bb9:

    # c "I just wish I can provide Eva with everything she needs."
    c "我只希望能为伊娃提供她所需的一切。"

# game/episode021.rpy:1032
translate simplified_chinese ep021_nadya_talk_petrarch_9e4ef2d0:

    # c "Considering the life we lead, it’s not going to be easy."
    c "考虑到我们过的这种生活，这不会容易。"

# game/episode021.rpy:1034
translate simplified_chinese ep021_nadya_talk_petrarch_1c849bf4:

    # na "I will admit that we’re in a peculiar position, but being young parents is never easy."
    na "我得承认我们的处境很特殊，但年轻父母从来都不容易。"

# game/episode021.rpy:1035
translate simplified_chinese ep021_nadya_talk_petrarch_2c2b31f3:

    # na "You’ll both find a way, I’m sure of it."
    na "你们俩会找到办法的，我对此深信不疑。"

# game/episode021.rpy:1036
translate simplified_chinese ep021_nadya_talk_petrarch_548818a8:

    # na "We’re so focused on pursuing this prophecy that all else seems to lose its importance."
    na "我们太专注于追寻这个预言，以至于其他一切似乎都失去了重要性。"

# game/episode021.rpy:1037
translate simplified_chinese ep021_nadya_talk_petrarch_dcbffe65:

    # na "But anything threatens Eva or your baby, we will do everything to make sure she’s safe."
    na "但任何威胁到伊娃或你孩子的事情，我们都会竭尽全力确保她的安全。"

# game/episode021.rpy:1038
translate simplified_chinese ep021_nadya_talk_petrarch_5f867242:

    # na "We’ll help you, every step of the way."
    na "我们会帮助你的，每一步都会。"

# game/episode021.rpy:1040
translate simplified_chinese ep021_nadya_talk_petrarch_46e261f9:

    # c "Thanks, Mom, that means a lot."
    c "谢谢妈妈，这对我意义重大。"

# game/episode021.rpy:1041
translate simplified_chinese ep021_nadya_talk_petrarch_05e5c179:

    # c "I hope we’ll make you a proud grandmother."
    c "希望我们能让你成为一位骄傲的外祖母。"

# game/episode021.rpy:1043
translate simplified_chinese ep021_nadya_talk_petrarch_8ab187bf:

    # na "I already am."
    na "我已经是了。"

# game/episode021.rpy:1045
translate simplified_chinese ep021_nadya_talk_petrarch_191fae03:

    # c "Thanks, Nadya, that means a lot."
    c "谢谢娜迪亚，这对我意义重大。"

# game/episode021.rpy:1047
translate simplified_chinese ep021_nadya_talk_petrarch_512fa890:

    # na "Now, I’m going back to my quarters and see if I can catch some sleep in my own bed."
    na "现在我要回我的舱室了，看看能不能在自己床上睡会儿。"

# game/episode021.rpy:1048
translate simplified_chinese ep021_nadya_talk_petrarch_e2414be7:

    # na "Sleeping on that couch has done a number on my neck."
    na "睡在那张沙发上让我的脖子受了不少罪。"

# game/episode021.rpy:1049
translate simplified_chinese ep021_nadya_talk_petrarch_7f0bc750:

    # c "I hope you get some rest."
    c "希望你能好好休息。"

# game/episode021.rpy:1051
translate simplified_chinese ep021_nadya_talk_petrarch_328be262:

    # c "Goodnight, Mom."
    c "晚安，妈妈。"

# game/episode021.rpy:1053
translate simplified_chinese ep021_nadya_talk_petrarch_fdd9b536:

    # c "Goodnight, Nadya."
    c "晚安，娜迪亚。"

# game/episode021.rpy:1054
translate simplified_chinese ep021_nadya_talk_petrarch_47415891:

    # na "Goodnight, sweetheart."
    na "晚安，亲爱的。"

# game/episode021.rpy:1056
translate simplified_chinese ep021_nadya_talk_petrarch_4589784a:

    # na "I wanted to have a word with you."
    na "我想和你说几句话。"

# game/episode021.rpy:1057
translate simplified_chinese ep021_nadya_talk_petrarch_5a5c28b7:

    # na "About the news you and Eva shared earlier."
    na "关于你和伊娃早些时候分享的消息。"

# game/episode021.rpy:1058
translate simplified_chinese ep021_nadya_talk_petrarch_7b7a5678:

    # c "Yes, of course."
    c "是的，当然。"

# game/episode021.rpy:1060
translate simplified_chinese ep021_nadya_talk_petrarch_872015af:

    # na "I’m sorry if I reacted harshly, but you must know that it was such a shock."
    na "如果我刚才反应过激，我很抱歉，但你必须知道这太令人震惊了。"

# game/episode021.rpy:1061
translate simplified_chinese ep021_nadya_talk_petrarch_24366554:

    # c "I understand."
    c "我理解。"

# game/episode021.rpy:1063
translate simplified_chinese ep021_nadya_talk_petrarch_38ae1404:

    # na "I know I’m not one to judge, considering what happened between Agust and me."
    na "我知道我没资格评判—毕竟我和阿古斯特之间发生过那些事。"

# game/episode021.rpy:1064
translate simplified_chinese ep021_nadya_talk_petrarch_cf622d4a:

    # na "But I do hope that you have both thought about the implications."
    na "但我真心希望你们俩都认真考虑过其中的利害关系。"

# game/episode021.rpy:1065
translate simplified_chinese ep021_nadya_talk_petrarch_8eecb102:

    # c "We have and decided it’s worth the sacrifice."
    c "我们考虑过了，并且认为值得为此付出代价。"

# game/episode021.rpy:1067
translate simplified_chinese ep021_nadya_talk_petrarch_ccb084fe:

    # na "Good."
    na "很好。"

# game/episode021.rpy:1068
translate simplified_chinese ep021_nadya_talk_petrarch_4a8d89e3:

    # na "And I’ll support to you in any way I can."
    na "我会尽我所能支持你们。"

# game/episode021.rpy:1070
translate simplified_chinese ep021_nadya_talk_petrarch_80babbf7:

    # na "I can’t speak for your sisters, though."
    na "不过我不能代表你的姐妹们表态。"

# game/episode021.rpy:1071
translate simplified_chinese ep021_nadya_talk_petrarch_da0d7922:

    # na "They might need more time to accept."
    na "她们可能需要更多时间来接受。"

# game/episode021.rpy:1073
translate simplified_chinese ep021_nadya_talk_petrarch_c40a80d2:

    # na "I can’t speak for your sister, though."
    na "不过我不能代表你妹妹表态。"

# game/episode021.rpy:1074
translate simplified_chinese ep021_nadya_talk_petrarch_6ef12a77:

    # na "She might need more time to accept."
    na "她可能需要更多时间来接受。"

# game/episode021.rpy:1075
translate simplified_chinese ep021_nadya_talk_petrarch_b6039869:

    # na "In any case, you’re exposing you both to a lot of danger."
    na "无论如何，你们都将面临巨大的危险。"

# game/episode021.rpy:1076
translate simplified_chinese ep021_nadya_talk_petrarch_cd44db39:

    # na "Incest isn’t accepted in most civilizations, human or otherwise."
    na "乱伦在大多数文明中都不被接受，无论是人类还是其他种族。"

# game/episode021.rpy:1077
translate simplified_chinese ep021_nadya_talk_petrarch_8a6bc7ba:

    # na "So you might face ridicule or even prosecution at the very worst."
    na "所以你们可能会面临嘲笑，最坏情况下甚至会被起诉。"

# game/episode021.rpy:1078
translate simplified_chinese ep021_nadya_talk_petrarch_fab27ad6:

    # c "We’re aware."
    c "我们很清楚。"

# game/episode021.rpy:1079
translate simplified_chinese ep021_nadya_talk_petrarch_63ef8d3b:

    # na "Good, I just wanted to make that clear."
    na "很好，我只是想确认这一点。"

# game/episode021.rpy:1080
translate simplified_chinese ep021_nadya_talk_petrarch_481bbb52:

    # na "Because it’s in addition to the danger we find ourselves in, being on the run from the Sovereignty and all."
    na "因为除了我们因逃避\"至高权域\"追捕而面临的危险之外，还有这个风险。"

# game/episode021.rpy:1082
translate simplified_chinese ep021_nadya_talk_petrarch_27f6eed2:

    # na "We all lead dangerous lives, with being on the run from the Sovereignty and all."
    na "我们所有人都过着危险的生活，既要逃避\"至高权域\"的追捕等等。"

# game/episode021.rpy:1083
translate simplified_chinese ep021_nadya_talk_petrarch_cdaacdd8:

    # na "Once Eva’s pregnancy develops, she might need extra care."
    na "一旦伊娃的孕期进展，她可能需要额外照顾。"

# game/episode021.rpy:1084
translate simplified_chinese ep021_nadya_talk_petrarch_ce3d91c6:

    # na "Or she might not be able to participate in any field missions."
    na "或者她可能无法参与任何外勤任务。"

# game/episode021.rpy:1086
translate simplified_chinese ep021_nadya_talk_petrarch_9dbb0dc1:

    # na "Thim might be able to assist when it comes to medical matters and I’m sure the crew will pitch in when it comes to additional support, when necessary."
    na "蒂姆在医疗事务上应该能提供帮助，而且我相信必要时船员们也会提供额外支持。"

# game/episode021.rpy:1088
translate simplified_chinese ep021_nadya_talk_petrarch_89a5fc66:

    # na "I’m sure the crew will pitch in when it comes to additional support, when necessary."
    na "我相信必要时船员们会提供额外支持。"

# game/episode021.rpy:1089
translate simplified_chinese ep021_nadya_talk_petrarch_07d91596:

    # na "We’re so focused on pursuing this prophecy, that all else seems to lose its importance."
    na "我们太专注于追寻这个预言，以至于其他一切似乎都失去了重要性。"

# game/episode021.rpy:1090
translate simplified_chinese ep021_nadya_talk_petrarch_dcbffe65_1:

    # na "But anything threatens Eva or your baby, we will do everything to make sure she’s safe."
    na "但任何威胁到伊娃或你孩子的事情，我们都会竭尽全力确保她的安全。"

# game/episode021.rpy:1092
translate simplified_chinese ep021_nadya_talk_petrarch_46e261f9_1:

    # c "Thanks, Mom, that means a lot."
    c "谢谢，妈妈，这对我意义重大。"

# game/episode021.rpy:1094
translate simplified_chinese ep021_nadya_talk_petrarch_ce04f979:

    # c "Thanks, that means a lot."
    c "谢谢，这对我意义重大。"

# game/episode021.rpy:1096
translate simplified_chinese ep021_nadya_talk_petrarch_512fa890_1:

    # na "Now, I’m going back to my quarters and see if I can catch some sleep in my own bed."
    na "现在，我要回我的房间，看看能不能在自己的床上睡一会儿。"

# game/episode021.rpy:1097
translate simplified_chinese ep021_nadya_talk_petrarch_e2414be7_1:

    # na "Sleeping on that couch has done a number on my neck."
    na "睡在那张沙发上让我的脖子很不舒服。"

# game/episode021.rpy:1098
translate simplified_chinese ep021_nadya_talk_petrarch_7f0bc750_1:

    # c "I hope you get some rest."
    c "希望你能好好休息。"

# game/episode021.rpy:1100
translate simplified_chinese ep021_nadya_talk_petrarch_328be262_1:

    # c "Goodnight, Mom."
    c "晚安，妈妈。"

# game/episode021.rpy:1101
translate simplified_chinese ep021_nadya_talk_petrarch_d0e4210d:

    # na "Goodnight, son."
    na "晚安，儿子。"

# game/episode021.rpy:1103
translate simplified_chinese ep021_nadya_talk_petrarch_fdd9b536_1:

    # c "Goodnight, Nadya."
    c "晚安，娜迪亚。"

# game/episode021.rpy:1104
translate simplified_chinese ep021_nadya_talk_petrarch_9f7c045d:

    # na "Goodnight."
    na "晚安。"

# game/episode021.rpy:1111
translate simplified_chinese ep021_lilly_talk_c0530c6f:

    # "Lilly was reading on her tablet in one of the conference rooms."
    "莉莉正在其中一间会议室里用平板电脑阅读。"

# game/episode021.rpy:1112
translate simplified_chinese ep021_lilly_talk_b2f58514:

    # c "I take it you’re not studying for your Academy exams?"
    c "我猜你不是在为学院的考试复习吧？"

# game/episode021.rpy:1114
translate simplified_chinese ep021_lilly_talk_95bc16f2:

    # l "Haha, no, I think we’re long past that, thankfully."
    l "哈哈，不是，谢天谢地，我们早就过了那个阶段了。"

# game/episode021.rpy:1116
translate simplified_chinese ep021_lilly_talk_f8b92cda:

    # l "I was just reading up on some news stories."
    l "我只是在看一些新闻报导。"

# game/episode021.rpy:1117
translate simplified_chinese ep021_lilly_talk_9db6dc9a:

    # c "Are you able to connect to the Web from here?"
    c "你能从这里连上网络吗？"

# game/episode021.rpy:1119
translate simplified_chinese ep021_lilly_talk_b1bfe993:

    # l "No, we’re too far out for that."
    l "不行，我们离得太远了。"

# game/episode021.rpy:1120
translate simplified_chinese ep021_lilly_talk_a758b994:

    # l "But I saved some stories back when we were still in range."
    l "不过之前在信号范围内的时候我保存了一些新闻。"

# game/episode021.rpy:1121
translate simplified_chinese ep021_lilly_talk_e2863533:

    # c "Didn’t know you were so on top of things."
    c "没想到你这么关注时事。"

# game/episode021.rpy:1122
translate simplified_chinese ep021_lilly_talk_f7503e3a:

    # l "I’m not, but I get curious about what’s happening back home from time to time."
    l "也没有，只是偶尔会好奇家乡发生了什么。"

# game/episode021.rpy:1123
translate simplified_chinese ep021_lilly_talk_0822a93a:

    # c "You’re checking on the news feeds on Tuolovi?"
    c "你在查看图洛维的新闻推送吗？"

# game/episode021.rpy:1125
translate simplified_chinese ep021_lilly_talk_ef96b952:

    # l "Sporadically, but nothing much is happening there."
    l "偶尔看看，但那边没什么大事发生。"

# game/episode021.rpy:1126
translate simplified_chinese ep021_lilly_talk_96650821:

    # l "At least not things involving our family."
    l "至少没有涉及我们家族的事情。"

# game/episode021.rpy:1127
translate simplified_chinese ep021_lilly_talk_dc1ddb76:

    # l "There’s a lot about the Sovereignty though."
    l "不过关于\"至高权域\"的内容倒是很多。"

# game/episode021.rpy:1128
translate simplified_chinese ep021_lilly_talk_06854f1d:

    # c "More so than normal?"
    c "比平时更多吗？"

# game/episode021.rpy:1130
translate simplified_chinese ep021_lilly_talk_061ac71b:

    # l "Yes, unfortunately."
    l "是的，很不幸。"

# game/episode021.rpy:1131
translate simplified_chinese ep021_lilly_talk_2174a494:

    # l "Apparently, other alien nations are following developments in the Sovereignty with suspicion."
    l "显然，其他外星国家正以怀疑的态度关注着\"至高权域\"的发展动态。"

# game/episode021.rpy:1132
translate simplified_chinese ep021_lilly_talk_15f7e731:

    # c "Nothing new there."
    c "这倒不是什么新鲜事。"

# game/episode021.rpy:1134
translate simplified_chinese ep021_lilly_talk_338cdb9d:

    # l "No, but this time there actually seems to be something afoot."
    l "没错，但这次似乎真的有些动静。"

# game/episode021.rpy:1135
translate simplified_chinese ep021_lilly_talk_d8765b2f:

    # l "Several sources are reporting massive troop redeployments and the Sovereignty shipyards have also geared up production."
    l "多个消息来源都报道了大规模部队重新部署，而且\"至高权域\"造船厂也已加大生产力度。"

# game/episode021.rpy:1136
translate simplified_chinese ep021_lilly_talk_bed6f507:

    # c "Getting ready to stir some shit, no doubt."
    c "毫无疑问，这是准备要搞事情了。"

# game/episode021.rpy:1137
translate simplified_chinese ep021_lilly_talk_cd87a2a4:

    # l "Yeah."
    l "是啊。"

# game/episode021.rpy:1138
translate simplified_chinese ep021_lilly_talk_98361226:

    # l "Apparently there hasn’t been a production increase like this in several decades."
    l "据说几十年来都没有过这样的产量激增。"

# game/episode021.rpy:1139
translate simplified_chinese ep021_lilly_talk_8cf0837e:

    # c "The Sovereignty is looking to expand their borders then, probably?"
    c "那\"至高权域\"是打算扩张疆域了吧，大概？"

# game/episode021.rpy:1141
translate simplified_chinese ep021_lilly_talk_294f22da:

    # l "Probably."
    l "很有可能。"

# game/episode021.rpy:1142
translate simplified_chinese ep021_lilly_talk_518b4314:

    # l "Government sources say it’s to combat domestic terrorism."
    l "政府消息源声称这是为了打击国内恐怖主义。"

# game/episode021.rpy:1143
translate simplified_chinese ep021_lilly_talk_ff4821af:

    # c "Ah yes, that old chestnut."
    c "啊对，又是这套老掉牙的说辞。"

# game/episode021.rpy:1144
translate simplified_chinese ep021_lilly_talk_06f3a5b7:

    # l "There might be some truth in it."
    l "也许其中也有几分真实。"

# game/episode021.rpy:1145
translate simplified_chinese ep021_lilly_talk_7e5cd87f:

    # l "Several reports about a group called the Auric Exemplar claiming responsibility for terrorist attacks throughout the Sovereignty."
    l "有多份报告提到一个名为\"金辉典范\"的组织宣称对遍布\"至高权域\"的恐怖袭击负责。"

# game/episode021.rpy:1146
translate simplified_chinese ep021_lilly_talk_d1659317:

    # c "Terrorist attacks?"
    c "恐怖袭击？"

# game/episode021.rpy:1148
translate simplified_chinese ep021_lilly_talk_6a502405:

    # l "Bombings, theft, you name it."
    l "爆炸案、盗窃案，应有尽有。"

# game/episode021.rpy:1149
translate simplified_chinese ep021_lilly_talk_af5abeae:

    # l "No civilian casualties so far though."
    l "不过到目前为止还没有平民伤亡。"

# game/episode021.rpy:1150
translate simplified_chinese ep021_lilly_talk_3c68b6c0:

    # c "I thought those Exemplar were a fairytale."
    c "我还以为那些\"典范\"只是个传说。"

# game/episode021.rpy:1151
translate simplified_chinese ep021_lilly_talk_f304a03e:

    # c "Or at the most, a group of stuffy university professors raving about violent dissent, without leaving the comfort of their homes."
    c "或者充其量是一群古板的大学教授，在舒适的家中高谈暴力反抗。"

# game/episode021.rpy:1153
translate simplified_chinese ep021_lilly_talk_b88897a0:

    # l "That was my view of them as well, but apparently that has all changed."
    l "我以前也是这么看他们的，但显然一切都变了。"

# game/episode021.rpy:1154
translate simplified_chinese ep021_lilly_talk_4f332b3e:

    # l "Or somebody took those theories about violent dissent and put them into practice."
    l "要么就是有人把那些暴力反抗的理论付诸实践了。"

# game/episode021.rpy:1155
translate simplified_chinese ep021_lilly_talk_a7da18b1:

    # c "Either way, I don’t think the Sovereignty is building a fleet to weed out terrorists."
    c "不管怎样，我觉得\"至高权域\"建造舰队不是为了清除恐怖分子。"

# game/episode021.rpy:1157
translate simplified_chinese ep021_lilly_talk_ef0e4a9c:

    # l "Me neither, it’s likely an excuse."
    l "我也这么认为，这很可能是个借口。"

# game/episode021.rpy:1158
translate simplified_chinese ep021_lilly_talk_e2bda4a3:

    # c "Regardless if it’s all true, if you learn anything else useful in those reports, let me know."
    c "不论真假，如果你在那些报告里发现其他有用信息，记得告诉我。"

# game/episode021.rpy:1160
translate simplified_chinese ep021_lilly_talk_6067bdda:

    # l "I will."
    l "我会的。"

# game/episode021.rpy:1167
translate simplified_chinese ep021_celine_talk_8e142f22:

    # "Céline had told me to come to the computer room at the top of the compound."
    "瑟琳曾告诉我到建筑顶层的电脑室找她。"

# game/episode021.rpy:1168
translate simplified_chinese ep021_celine_talk_701b1e5c:

    # "She was there working with Jade to get access to the computer records."
    "她正和杰德一起工作，试图获取电脑记录。"

# game/episode021.rpy:1169
translate simplified_chinese ep021_celine_talk_15b7144d:

    # "When I entered it turned out she was all alone."
    "当我进去时，发现她独自一人。"

# game/episode021.rpy:1170
translate simplified_chinese ep021_celine_talk_d2536737:

    # c "Hey, I thought Jade was with you?"
    c "嘿，我以为杰德和你在一起？"

# game/episode021.rpy:1172
translate simplified_chinese ep021_celine_talk_2e96ac19:

    # ce "Jade was working for five hours straight, so she’s having a lie down."
    ce "杰德连续工作了五个小时，所以去躺下休息了。"

# game/episode021.rpy:1173
translate simplified_chinese ep021_celine_talk_fb236d8d:

    # ce "And now I’m here all alone."
    ce "现在只剩我一个人在这里。"

# game/episode021.rpy:1174
translate simplified_chinese ep021_celine_talk_e401a02e:

    # c "Feeling lonely then, are you?"
    c "这么说，你觉得寂寞了？"

# game/episode021.rpy:1176
translate simplified_chinese ep021_celine_talk_acbe700f:

    # ce "Lonely and a little bored."
    ce "有点寂寞，还有点无聊。"

# game/episode021.rpy:1177
translate simplified_chinese ep021_celine_talk_cb75c10d:

    # c "The work going okay?"
    c "工作进展顺利吗？"

# game/episode021.rpy:1178
translate simplified_chinese ep021_celine_talk_b8198a1b:

    # ce "Yes, we’re making progress."
    ce "是的，我们正在取得进展。"

# game/episode021.rpy:1179
translate simplified_chinese ep021_celine_talk_9252bc91:

    # ce "But it’s Jade who’s doing all the heavy lifting."
    ce "但所有繁重的工作都是杰德在承担。"

# game/episode021.rpy:1180
translate simplified_chinese ep021_celine_talk_f7fdba40:

    # ce "I never realized she was so good with the digital stuff."
    ce "我从没意识到她对数字技术这么在行。"

# game/episode021.rpy:1181
translate simplified_chinese ep021_celine_talk_e6e240ac:

    # c "Yes, I was surprised as well when I learned of her hobby."
    c "是啊，我得知她这个爱好时也很惊讶。"

# game/episode021.rpy:1183
translate simplified_chinese ep021_celine_talk_f3ca6dab:

    # ce "Doesn’t seem like a hobby to me anymore."
    ce "在我看来这已经不止是爱好了。"

# game/episode021.rpy:1184
translate simplified_chinese ep021_celine_talk_f83e0233:

    # c "No, I agree."
    c "没错，我同意。"

# game/episode021.rpy:1185
translate simplified_chinese ep021_celine_talk_d08847b1:

    # c "Her skills are pretty essential."
    c "她的技能相当关键。"

# game/episode021.rpy:1186
translate simplified_chinese ep021_celine_talk_fed8d564:

    # c "As are yours of course."
    c "当然你的技能也是。"

# game/episode021.rpy:1187
translate simplified_chinese ep021_celine_talk_b07459c0:

    # c "I don’t know how far we’d gotten without you as a pilot."
    c "要是没有你当飞行员，真不知道我们能走多远。"

# game/episode021.rpy:1188
translate simplified_chinese ep021_celine_talk_42fbfba3:

    # ce "Thanks."
    ce "谢谢。"

# game/episode021.rpy:1191
translate simplified_chinese ep021_celine_talk_5cd939d0:

    # c "Crazy view out there."
    c "外面的景色真疯狂。"

# game/episode021.rpy:1192
translate simplified_chinese ep021_celine_talk_bdd9fc6e:

    # ce "You can say that again."
    ce "你这话说得太对了。"

# game/episode021.rpy:1194
translate simplified_chinese ep021_celine_talk_952c075b:

    # ce "But it still seems like a dead landscape to me."
    ce "但对我来说，这仍然像是片死寂的风景。"

# game/episode021.rpy:1195
translate simplified_chinese ep021_celine_talk_306153eb:

    # c "It probably is."
    c "很可能确实如此。"

# game/episode021.rpy:1196
translate simplified_chinese ep021_celine_talk_a0b58d2b:

    # c "I take it you’re not eager to stay here on Petrarch?"
    c "我猜你不太想留在彼特拉克吧？"

# game/episode021.rpy:1198
translate simplified_chinese ep021_celine_talk_274ec67a:

    # ce "No, not at all."
    ce "是的，完全不想。"

# game/episode021.rpy:1199
translate simplified_chinese ep021_celine_talk_c0d8a610:

    # c "I think that’s the general sentiment."
    c "我觉得这是普遍看法。"

# game/episode021.rpy:1200
translate simplified_chinese ep021_celine_talk_9a37bfa6:

    # c "Well, I’ll let you get back to work."
    c "好吧，我就不打扰你工作了。"

# game/episode021.rpy:1201
translate simplified_chinese ep021_celine_talk_47286829:

    # ce "Thanks, see you around, [p_name_short]."
    ce "谢谢，回头见，[p_name_short]。"

# game/episode021.rpy:1202
translate simplified_chinese ep021_celine_talk_b092993f:

    # c "You too."
    c "你也是。"

# game/episode021.rpy:1212
translate simplified_chinese ep021_eva_talk_6b3c1be0:

    # "Most of the crew was scattered throughout the complex, investigating the machinery that was seemingly left behind by whomever first built the compounds on Petrarch."
    "大部分船员都分散在整个建筑群里，调查那些似乎是彼特拉克上首批建造这些复合体的人留下的机械。"

# game/episode021.rpy:1214
translate simplified_chinese ep021_eva_talk_cb8cd549:

    # "I was enjoying a moment of rest, when Eva suddenly marched through the door."
    "我正在享受片刻的休息，伊娃突然冲进门来。"

# game/episode021.rpy:1215
translate simplified_chinese ep021_eva_talk_371821c2:

    # e "[p_name_short]!"
    e "[p_name_short]!"

# game/episode021.rpy:1216
translate simplified_chinese ep021_eva_talk_05eb8c9b:

    # e "It’s happened!!!"
    e "发生了！！！"

# game/episode021.rpy:1217
translate simplified_chinese ep021_eva_talk_499819e9:

    # c "What happened?"
    c "发生什么了？"

# game/episode021.rpy:1219
translate simplified_chinese ep021_eva_talk_bf410c69:

    # e "I did a test!"
    e "我做了个测试！"

# game/episode021.rpy:1220
translate simplified_chinese ep021_eva_talk_0af78c5d:

    # e "[p_name_short], I’m pregnant!"
    e "[p_name_short]，我怀孕了！"

# game/episode021.rpy:1224
translate simplified_chinese ep021_eva_talk_3dd5ee39:

    # c "What?!"
    c "什么？！"

# game/episode021.rpy:1225
translate simplified_chinese ep021_eva_talk_4067b648:

    # c "Eva, that’s such great news, and so soon as well."
    c "伊娃，这真是个天大的好消息，而且还这么快。"

# game/episode021.rpy:1226
translate simplified_chinese ep021_eva_talk_d7a5edba:

    # e "I’m so happy!"
    e "我太高兴了！"

# game/episode021.rpy:1229
translate simplified_chinese ep021_eva_talk_06c4a01e:

    # "I kissed my sister and together we lay down on the bed."
    "我亲吻了我的妹妹，我们一起躺在了床上。"

# game/episode021.rpy:1231
translate simplified_chinese ep021_eva_talk_14d4135a:

    # "I kissed Eva and together we lay down on the bed."
    "我亲吻了伊娃，我们一起躺在了床上。"

# game/episode021.rpy:1233
translate simplified_chinese ep021_eva_talk_b398fb49:

    # e "I didn’t get my period this month, so I started hoping right away."
    e "我这个月月经没来，所以我立刻就抱起了希望。"

# game/episode021.rpy:1234
translate simplified_chinese ep021_eva_talk_12554410:

    # e "Stupid, I know."
    e "我知道这很傻。"

# game/episode021.rpy:1235
translate simplified_chinese ep021_eva_talk_7a988ed3:

    # e "I kept debating whether to take a test, but our journey didn’t seem like the best time."
    e "我一直纠结要不要做测试，但我们的旅程似乎不是最佳时机。"

# game/episode021.rpy:1236
translate simplified_chinese ep021_eva_talk_375c9c28:

    # e "I can’t believe I’m pregnant already!"
    e "真不敢相信我已经怀孕了！"

# game/episode021.rpy:1237
translate simplified_chinese ep021_eva_talk_ac2bea30:

    # c "Me neither."
    c "我也是。"

# game/episode021.rpy:1238
translate simplified_chinese ep021_eva_talk_768d4681:

    # c "Do you know when it might have happened?"
    c "你知道可能是什么时候发生的吗？"

# game/episode021.rpy:1240
translate simplified_chinese ep021_eva_talk_e554e3e6:

    # e "It must have been the first time we’ve been intimate together, after we escaped that desert planet."
    e "肯定是我们逃离那个沙漠星球后，第一次亲密接触的时候。"

# game/episode021.rpy:1241
translate simplified_chinese ep021_eva_talk_e1b4d79d:

    # c "Damn, talk about lucky shots..."
    c "该死，这准头也太好了吧…"

# game/episode021.rpy:1243
translate simplified_chinese ep021_eva_talk_98b8f99f:

    # e "Haha, yes!"
    e "哈哈，是啊！"

# game/episode021.rpy:1244
translate simplified_chinese ep021_eva_talk_b86ad017:

    # e "Very lucky."
    e "非常幸运。"

# game/episode021.rpy:1246
translate simplified_chinese ep021_eva_talk_33969893:

    # e "I’m so happy, [p_name_short]!"
    e "我太高兴了，[p_name_short]！"

# game/episode021.rpy:1247
translate simplified_chinese ep021_eva_talk_c5531862:

    # c "Me too!"
    c "我也是！"

# game/episode021.rpy:1249
translate simplified_chinese ep021_eva_talk_a5e3e1aa:

    # e "Though it’s going to be a challenge, with everything happening."
    e "不过考虑到现在的情况，这会是个挑战。"

# game/episode021.rpy:1250
translate simplified_chinese ep021_eva_talk_f588fff4:

    # e "We’re still being hunted."
    e "我们还在被追捕中。"

# game/episode021.rpy:1251
translate simplified_chinese ep021_eva_talk_6e1ba734:

    # c "We’ll figure something out."
    c "我们总会想出办法的。"

# game/episode021.rpy:1253
translate simplified_chinese ep021_eva_talk_a73407a9:

    # e "But in a few months I’ll be fat, hormonal and useless."
    e "但再过几个月我就会变得臃肿、荷尔蒙失调，毫无用处。"

# game/episode021.rpy:1254
translate simplified_chinese ep021_eva_talk_221a31a0:

    # c "No you won’t."
    c "你不会的。"

# game/episode021.rpy:1255
translate simplified_chinese ep021_eva_talk_83444c11:

    # c "You’re going to be a beautiful mother, Eva."
    c "你会是个美丽的母亲，伊娃。"

# game/episode021.rpy:1257
translate simplified_chinese ep021_eva_talk_330cedd7:

    # e "I’ll take your word for it."
    e "我相信你的话。"

# game/episode021.rpy:1258
translate simplified_chinese ep021_eva_talk_6b9aa96c:

    # e "Do we tell the others?"
    e "我们要告诉其他人吗？"

# game/episode021.rpy:1259
translate simplified_chinese ep021_eva_talk_065bab59:

    # c "I think we need to."
    c "我认为我们需要告诉他们。"

# game/episode021.rpy:1261
translate simplified_chinese ep021_eva_talk_7ea13951:

    # c "Mom, Lilly and Aven at the very least."
    c "至少得告诉妈妈、莉莉和艾文。"

# game/episode021.rpy:1263
translate simplified_chinese ep021_eva_talk_92076b7c:

    # c "Nadya, Lilly and Aven at the very least."
    c "至少得告诉娜迪亚、莉莉和艾文。"

# game/episode021.rpy:1265
translate simplified_chinese ep021_eva_talk_05364ff8:

    # e "Agreed."
    e "同意。"

# game/episode021.rpy:1266
translate simplified_chinese ep021_eva_talk_4d32cbb6:

    # e "Thought that’s going to be a challenging conversation."
    e "虽然这会是个艰难的对话。"

# game/episode021.rpy:1267
translate simplified_chinese ep021_eva_talk_602300e8:

    # c "I’m sure it will be."
    c "我相信会的。"

# game/episode021.rpy:1268
translate simplified_chinese ep021_eva_talk_93dc7d36:

    # c "But I don’t think there’s anything else they can do but accept the facts."
    c "但我觉得除了接受事实，他们也无能为力。"

# game/episode021.rpy:1269
translate simplified_chinese ep021_eva_talk_91411d48:

    # e "I know, but it still is a conversation I’d rather not have."
    e "我知道，但我还是不想进行这场谈话。"

# game/episode021.rpy:1270
translate simplified_chinese ep021_eva_talk_a2e797ef:

    # e "I guess it won’t be so bad if we do it together."
    e "我想如果我们一起面对，应该不会太糟。"

# game/episode021.rpy:1272
translate simplified_chinese ep021_eva_talk_a4ab4ca6:

    # e "But can we just lay here for a while, just the two of us, and enjoy the moment?"
    e "但我们可以先躺在这里一会儿吗，就我们两个人，享受此刻？"

# game/episode021.rpy:1273
translate simplified_chinese ep021_eva_talk_4e8c7062:

    # c "Of course."
    c "当然。"

# game/episode021.rpy:1276
translate simplified_chinese ep021_eva_talk_a13b0822:

    # "We remained together on the bed, with me absentmindedly stroking my sister’s abdomen, where the life we’d created was slowly growing."
    "我们继续一起躺在床上，我无意识地抚摸着妹妹的腹部，那里孕育着我们创造的生命，正在缓慢生长。"

# game/episode021.rpy:1278
translate simplified_chinese ep021_eva_talk_dae19c7d:

    # "We remained together on the bed, with me absentmindedly stroking Eva’s abdomen, where the life we’d created was slowly growing."
    "我们继续一起躺在床上，我无意识地抚摸着伊娃的腹部，那里孕育着我们创造的生命，正在缓慢生长。"

# game/episode021.rpy:1288
translate simplified_chinese ep021_thyia_talk_684e070e:

    # "I found Thyia inspecting one of the generator rooms in the depths of the compound."
    "我发现塞娅正在检查建筑群深处的一间发电机房。"

# game/episode021.rpy:1289
translate simplified_chinese ep021_thyia_talk_2e216dfb:

    # c "Figured out how things tick around here?"
    c "弄清楚这里的情况了？"

# game/episode021.rpy:1291
translate simplified_chinese ep021_thyia_talk_d2d0ad61:

    # th "Mostly."
    th "大部分吧。"

# game/episode021.rpy:1292
translate simplified_chinese ep021_thyia_talk_476532ce:

    # th "These babies are geothermic generators, but I’ve never seen one so advanced."
    th "这些宝贝是地热发电机，但我从没见过这么先进的型号。"

# game/episode021.rpy:1293
translate simplified_chinese ep021_thyia_talk_1fb69400:

    # th "It’s also been running for a long time, without any maintenance."
    th "而且它们已经运行了很长时间，没有任何维护。"

# game/episode021.rpy:1294
translate simplified_chinese ep021_thyia_talk_b07cae03:

    # c "That we know of."
    c "据我们所知是这样。"

# game/episode021.rpy:1296
translate simplified_chinese ep021_thyia_talk_d86934d6:

    # th "Sure, but maintaining tech of this complexity is too much for most robots."
    th "没错，但要维护这么复杂的技术对大多数机器人来说都太难了。"

# game/episode021.rpy:1297
translate simplified_chinese ep021_thyia_talk_3046118d:

    # c "I’ll take your word for it."
    c "我相信你的话。"

# game/episode021.rpy:1298
translate simplified_chinese ep021_thyia_talk_3b80bb7a:

    # c "So you think the lights will remain on for quite a while?"
    c "所以你认为灯光还会亮很久？"

# game/episode021.rpy:1299
translate simplified_chinese ep021_thyia_talk_cd26588e:

    # th "Several centuries, I think."
    th "我觉得至少能维持几个世纪。"

# game/episode021.rpy:1300
translate simplified_chinese ep021_thyia_talk_bab540eb:

    # c "Let’s hope we don’t stay that long."
    c "希望我们不会待那么久。"

# game/episode021.rpy:1301
translate simplified_chinese ep021_thyia_talk_65d31f13:

    # th "Petrarch isn’t the most hospitable place, is it?"
    th "彼特拉克可不是什么好客的地方，对吧？"

# game/episode021.rpy:1302
translate simplified_chinese ep021_thyia_talk_d7ae8504:

    # c "Not at all."
    c "一点也不。"

# game/episode021.rpy:1303
translate simplified_chinese ep021_thyia_talk_0e738de4:

    # th "Did you need me for anything?"
    th "你找我有事吗？"

# game/episode021.rpy:1304
translate simplified_chinese ep021_thyia_talk_c4bdda27:

    # c "No, not really."
    c "不，没什么。"

# game/episode021.rpy:1306
translate simplified_chinese ep021_thyia_talk_a8787560:

    # c "I’ll leave you to it."
    c "那我就不打扰你了。"

# game/episode021.rpy:1321
translate simplified_chinese ep021_thyia_talk_de410a04:

    # c "Just came to bring you a drink and tell you to take a break."
    c "只是来给你送杯饮料，顺便叫你休息一下。"

# game/episode021.rpy:1322
translate simplified_chinese ep021_thyia_talk_c88cfdb5:

    # c "You’ve been holed up in here for an awfully long time."
    c "你把自己关在这儿已经好长一段时间了。"

# game/episode021.rpy:1323
translate simplified_chinese ep021_thyia_talk_ef69a27c:

    # th "I have?"
    th "是吗？"

# game/episode021.rpy:1324
translate simplified_chinese ep021_thyia_talk_fb801624:

    # th "I always forget the time."
    th "我总是会忘记时间。"

# game/episode021.rpy:1325
translate simplified_chinese ep021_thyia_talk_f387af99:

    # th "Let’s have that drink then."
    th "那我们来喝一杯吧。"

# game/episode021.rpy:1327
translate simplified_chinese ep021_thyia_talk_d1cc3f68:

    # "Thyia and I sat down next to the humming generator and shared a drink."
    "塞娅和我在那嗡嗡作响的发电机旁坐下，分享了一杯酒。"

# game/episode021.rpy:1328
translate simplified_chinese ep021_thyia_talk_c88d1fa1:

    # c "You didn’t bring your robot?"
    c "你没带你的机器人来？"

# game/episode021.rpy:1329
translate simplified_chinese ep021_thyia_talk_0097f2b0:

    # th "Nah, it’s still on the Bastard."
    th "没，它还留在\"私生子\"号上。"

# game/episode021.rpy:1330
translate simplified_chinese ep021_thyia_talk_6381f519:

    # th "I have the behavioral controls nailed down, but the terrain here is too rocky to navigate."
    th "我已经把行为控制程序搞定了，但这儿的地形太崎岖，它没法行动。"

# game/episode021.rpy:1331
translate simplified_chinese ep021_thyia_talk_99c8ee19:

    # th "Need to tweak it’s programming a little more before I let it out in the wild."
    th "在放它到野外之前，我还需要再调整一下它的程序。"

# game/episode021.rpy:1332
translate simplified_chinese ep021_thyia_talk_a954ac44:

    # c "As long as it doesn’t replace me in your bed."
    c "只要它不会取代我在你床上的位置就好。"

# game/episode021.rpy:1334
translate simplified_chinese ep021_thyia_talk_d7d18adc:

    # th "A cold bulky metal automaton?"
    th "一个冰冷笨重的金属机器人？"

# game/episode021.rpy:1335
translate simplified_chinese ep021_thyia_talk_8ffab7ec:

    # th "Very tempting..."
    th "很诱人…"

# game/episode021.rpy:1337
translate simplified_chinese ep021_thyia_talk_4134f6cd:

    # th "Anyone else warming your bed these days?"
    th "最近还有谁暖你的床吗？"

# game/episode021.rpy:1338
translate simplified_chinese ep021_thyia_talk_1e3c3a5f:

    # c "I thought you didn’t want to know."
    c "我以为你不想知道。"

# game/episode021.rpy:1339
translate simplified_chinese ep021_thyia_talk_1a9f2c0f:

    # th "Not particularly."
    th "倒也没有。"

# game/episode021.rpy:1341
translate simplified_chinese ep021_thyia_talk_6373646e:

    # th "As long as you don’t neglect me."
    th "只要你不冷落我就行。"

# game/episode021.rpy:1342
translate simplified_chinese ep021_thyia_talk_66f6dfbd:

    # th "I told you that already."
    th "我已经告诉过你了。"

# game/episode021.rpy:1343
translate simplified_chinese ep021_thyia_talk_8517591a:

    # c "And I haven’t, have I?"
    c "而我没有冷落你，对吧？"

# game/episode021.rpy:1345
translate simplified_chinese ep021_thyia_talk_1373d488:

    # th "No, you’ve been a real good boy."
    th "没错，你一直是个好男孩。"

# game/episode021.rpy:1346
translate simplified_chinese ep021_thyia_talk_5e928140:

    # c "I’m glad to hear that."
    c "很高兴听你这么说。"

# game/episode021.rpy:1351
translate simplified_chinese ep021_thyia_talk_fd258507:

    # c "Thyia, I know you don’t want to hear about any other women in my life."
    c "塞娅，我知道你不想听我生命中的其他女人。"

# game/episode021.rpy:1353
translate simplified_chinese ep021_thyia_talk_3e7a7371:

    # th "Obviously I’d like to know what else is going on in your life."
    th "显然我想知道你生活中还发生了什么。"

# game/episode021.rpy:1354
translate simplified_chinese ep021_thyia_talk_d2ce7b2b:

    # th "But I don’t need a gleeful blow-by-blow of any conquests."
    th "但我不需要听你那些得意洋洋的猎艳细节。"

# game/episode021.rpy:1355
translate simplified_chinese ep021_thyia_talk_f69ff470:

    # c "Fair enough, I gathered as much."
    c "说得对，我也差不多是这么想的。"

# game/episode021.rpy:1357
translate simplified_chinese ep021_thyia_talk_51e4bda4:

    # th "I just don’t want to be disappointed, that’s all."
    th "我只是不想失望，仅此而已。"

# game/episode021.rpy:1358
translate simplified_chinese ep021_thyia_talk_5c5debed:

    # c "I understand, I know you’ve been hurt in the past."
    c "我理解，我知道你过去受过伤害。"

# game/episode021.rpy:1359
translate simplified_chinese ep021_thyia_talk_d68ed6e6:

    # c "I love us being together and don’t want that to change."
    c "我喜欢我们在一起，不希望这种情况改变。"

# game/episode021.rpy:1361
translate simplified_chinese ep021_thyia_talk_b569d5b3:

    # th "Uh-oh...{w} I hear a “but” somewhere in that sentence."
    th "呃哦…{w}我听到这句话里藏着个\"但是\"。"

# game/episode021.rpy:1362
translate simplified_chinese ep021_thyia_talk_04bb1007:

    # c "Not really, I just want you to consider something."
    c "也不完全是，我只是想让你考虑一件事。"

# game/episode021.rpy:1364
translate simplified_chinese ep021_thyia_talk_ae3d5150:

    # c "I’m involved with another crew member."
    c "我和另一位船员有染。"

# game/episode021.rpy:1365
translate simplified_chinese ep021_thyia_talk_cfa6ca55:

    # c "[romances]."
    c "[romances]."

# game/episode021.rpy:1367
translate simplified_chinese ep021_thyia_talk_ba405969:

    # c "I’m involved with a couple of the crew."
    c "我和几名船员有染。"

# game/episode021.rpy:1368
translate simplified_chinese ep021_thyia_talk_cfa6ca55_1:

    # c "[romances]."
    c "[romances]."

# game/episode021.rpy:1370
translate simplified_chinese ep021_thyia_talk_f4816ac6:

    # th "None of my business."
    th "不关我事。"

# game/episode021.rpy:1374
translate simplified_chinese ep021_thyia_talk_28cb065e:

    # th "Wait, did you say [main_romances]?"
    th "等等，你刚说的是[main_romances]吗？"

# game/episode021.rpy:1375
translate simplified_chinese ep021_thyia_talk_e7ad40ce:

    # c "Yes, I did."
    c "是的，我说了。"

# game/episode021.rpy:1377
translate simplified_chinese ep021_thyia_talk_d9d911d1:

    # th "I’ve heard of a few places where that’s actually legal, but I never thought you’d go for it."
    th "我听说过几个地方这其实是合法的，但从没想过你会这么做。"

# game/episode021.rpy:1380
translate simplified_chinese ep021_thyia_talk_19472fce:

    # th "That said, [main_romances] is a hot piece of ass."
    th "话说回来，[main_romances]确实是个尤物。"

# game/episode021.rpy:1382
translate simplified_chinese ep021_thyia_talk_369d2cfb:

    # th "That said, they’re all too hot to handle."
    th "话说回来，她们都太火辣了难以驾驭。"

# game/episode021.rpy:1383
translate simplified_chinese ep021_thyia_talk_8cb38fc4:

    # th "And I didn’t know you were into that particular kink."
    th "而且我不知道你还有这种特殊癖好。"

# game/episode021.rpy:1385
translate simplified_chinese ep021_thyia_talk_a5a99484:

    # th "Still, like I said, none of my business."
    th "不过，就像我说的，不关我事。"

# game/episode021.rpy:1386
translate simplified_chinese ep021_thyia_talk_79d946a4:

    # c "I won’t bore you with grand statements about love and all that."
    c "我不会用那些关于爱情的陈词滥调来烦你。"

# game/episode021.rpy:1387
translate simplified_chinese ep021_thyia_talk_e2243176:

    # c "But I was hoping you would join us in bed at some point."
    c "但我希望你能找个时间和我们一起上床。"

# game/episode021.rpy:1389
translate simplified_chinese ep021_thyia_talk_7a36c268:

    # c "[harem] has agreed to sleep together, to see if we can live as a group."
    c "[harem]已经同意一起睡觉，看看我们能否作为一个群体生活。"

# game/episode021.rpy:1391
translate simplified_chinese ep021_thyia_talk_88a8e7e7:

    # c "[harem] have agreed to sleep together, to see if we can live as a group."
    c "[harem]已经同意一起睡觉，看看我们能否作为一个群体生活。"

# game/episode021.rpy:1393
translate simplified_chinese ep021_thyia_talk_412abeab:

    # th "It mostly sounds like you’re inviting me to a very large orgy."
    th "听起来你主要是在邀请我参加一个大型狂欢派对。"

# game/episode021.rpy:1395
translate simplified_chinese ep021_thyia_talk_d4ebf500:

    # th "It mostly sounds like you’re inviting me to an orgy."
    th "听起来你主要是在邀请我参加狂欢派对。"

# game/episode021.rpy:1397
translate simplified_chinese ep021_thyia_talk_68014ab8:

    # th "It mostly sounds like you’re inviting me to a foursome."
    th "听起来你主要是在邀请我参加四人行。"

# game/episode021.rpy:1399
translate simplified_chinese ep021_thyia_talk_ba82d965:

    # th "It mostly sounds like you’re inviting me to a threesome."
    th "听起来你主要是在邀请我参加三人行。"

# game/episode021.rpy:1400
translate simplified_chinese ep021_thyia_talk_bd50b344:

    # c "I won’t deny that sex will be involved."
    c "我不会否认这中间会涉及性行为。"

# game/episode021.rpy:1402
translate simplified_chinese ep021_thyia_talk_38cb580f:

    # th "What about the promises you’ve made me?"
    th "那你对我许下的承诺呢？"

# game/episode021.rpy:1403
translate simplified_chinese ep021_thyia_talk_cafc363e:

    # c "Nothing has changed, of course I will honor those."
    c "一切都没有改变，我当然会遵守那些承诺。"

# game/episode021.rpy:1405
translate simplified_chinese ep021_thyia_talk_741a8531:

    # th "Even starting a family?"
    th "甚至组建家庭？"

# game/episode021.rpy:1406
translate simplified_chinese ep021_thyia_talk_454e247b:

    # c "Yes, I don’t see how that isn’t compatible."
    c "是的，我不觉得这有什么冲突。"

# game/episode021.rpy:1407
translate simplified_chinese ep021_thyia_talk_0b0dc347:

    # c "It’s okay if you don’t want to be a part of this."
    c "如果你不想参与也没关系。"

# game/episode021.rpy:1408
translate simplified_chinese ep021_thyia_talk_6f4de93d:

    # c "In that case I won’t ask again."
    c "那样的话我不会再提了。"

# game/episode021.rpy:1410
translate simplified_chinese ep021_thyia_talk_a1f3b58b:

    # th "All I can say is that I’ll think about it."
    th "我只能说会考虑一下。"

# game/episode021.rpy:1411
translate simplified_chinese ep021_thyia_talk_e897fbb0:

    # c "Thank you."
    c "谢谢你。"

# game/episode021.rpy:1412
translate simplified_chinese ep021_thyia_talk_943b169c:

    # c "I won’t pressure you for an answer."
    c "我不会催促你回答。"

# game/episode021.rpy:1413
translate simplified_chinese ep021_thyia_talk_05761cd6:

    # c "Just let me know whenever you’re ready."
    c "等你准备好了随时告诉我。"

# game/episode021.rpy:1415
translate simplified_chinese ep021_thyia_talk_09f2a8d5:

    # th "I will."
    th "我会的。"

# game/episode021.rpy:1420
translate simplified_chinese ep021_thyia_talk_acd86e69:

    # "I could tell that Thyia was eager to set her mind on something else, so I veered away from the topic and we just bantered for another hour."
    "我能看出塞娅急切地想转移话题，于是我们便不再谈论此事，又闲聊了一个小时。"

# game/episode021.rpy:1421
translate simplified_chinese ep021_thyia_talk_b1884b53:

    # "Eventually, Thyia resumed her inspection of the generators and I left to pester someone else."
    "最终，塞娅继续检查发电机，我则离开去纠缠别人了。"

# game/episode021.rpy:1423
translate simplified_chinese ep021_thyia_talk_ae4ed1f2:

    # c "As long as you make a fembot to satisfy my degenerate urges."
    c "只要你造个女机器人来满足我堕落的欲望就行。"

# game/episode021.rpy:1425
translate simplified_chinese ep021_thyia_talk_37357518:

    # th "I most certainly will not."
    th "我绝对不会那么做的。"

# game/episode021.rpy:1426
translate simplified_chinese ep021_thyia_talk_70f6b73d:

    # th "Really, [p_name_short], I don’t want to know what you get up to, or with whom."
    th "说真的，[p_name_short]，我可不想知道你干了什么，或者跟谁一起。"

# game/episode021.rpy:1427
translate simplified_chinese ep021_thyia_talk_53c4fe50:

    # c "Just joking."
    c "开个玩笑。"

# game/episode021.rpy:1428
translate simplified_chinese ep021_thyia_talk_0dbdeaa8:

    # th "I know, me too."
    th "我知道，我也是。"

# game/episode021.rpy:1430
translate simplified_chinese ep021_thyia_talk_2bfd12f2:

    # th "But seriously though, if you’re hooking up with anyone else I don’t want to know."
    th "不过说正经的，如果你和别人勾搭上了，我可不想知道。"

# game/episode021.rpy:1431
translate simplified_chinese ep021_thyia_talk_6373646e_1:

    # th "As long as you don’t neglect me."
    th "只要你不冷落我就行。"

# game/episode021.rpy:1432
translate simplified_chinese ep021_thyia_talk_2915a3db:

    # c "I understand and I won’t neglect you."
    c "我明白，我不会冷落你的。"

# game/episode021.rpy:1434
translate simplified_chinese ep021_thyia_talk_87a0c0ac:

    # th "Good."
    th "很好。"

# game/episode021.rpy:1435
translate simplified_chinese ep021_thyia_talk_470d0792:

    # th "And I must say you’ve been a good boy in that regard."
    th "而且我必须说在这方面你一直是个好孩子。"

# game/episode021.rpy:1436
translate simplified_chinese ep021_thyia_talk_c9e2011e:

    # c "I aim to please."
    c "我的目标就是让你开心。"

# game/episode021.rpy:1437
translate simplified_chinese ep021_thyia_talk_34f02b7b:

    # th "You most certainly do."
    th "你确实做到了。"

# game/episode021.rpy:1439
translate simplified_chinese ep021_thyia_talk_cf451add:

    # "Thyia and I bantered for another hour, before she resumed her inspection of the generators and I left to pester someone else."
    "塞娅和我又互相打趣了一个小时，然后她继续检查发电机，我则离开去打扰别人了。"

# game/episode021.rpy:1459
translate simplified_chinese ep021_vess_talk_2840be21:

    # "At my request, Vess came by during the evening."
    "应我的要求，薇丝晚上过来了。"

# game/episode021.rpy:1461
translate simplified_chinese ep021_vess_talk_347e7ed5:

    # ve "Evening, [p_name_short]."
    ve "晚上好，[p_name_short]。"

# game/episode021.rpy:1462
translate simplified_chinese ep021_vess_talk_bb7b990a:

    # c "Evening."
    c "晚上好。"

# game/episode021.rpy:1463
translate simplified_chinese ep021_vess_talk_193319bb:

    # c "Have I mentioned before how gorgeous you look in that outfit?"
    c "我之前有没有说过你穿这身衣服有多迷人？"

# game/episode021.rpy:1464
translate simplified_chinese ep021_vess_talk_4187cda3:

    # ve "Thank you."
    ve "谢谢。"

# game/episode021.rpy:1465
translate simplified_chinese ep021_vess_talk_55d4bfa6:

    # ve "I almost changed back into my regular clothes, thinking this was to presumptuous, but I wanted to surprise you."
    ve "我差点换回平时的衣服，觉得这身太冒昧了，但我想要给你一个惊喜。"

# game/episode021.rpy:1466
translate simplified_chinese ep021_vess_talk_968143d6:

    # c "Consider me pleasantly surprised."
    c "这惊喜着实令我愉悦。"

# game/episode021.rpy:1467
translate simplified_chinese ep021_vess_talk_117a43c4:

    # c "If I had anything to say, I'd make flimsy nightdresses like these mandatory wear, day or night."
    c "要是我说了算，这种轻薄睡裙就该成为全天候的标配。"

# game/episode021.rpy:1468
translate simplified_chinese ep021_vess_talk_6cf69e5c:

    # ve "It does get rather cold outside though..."
    ve "不过外面确实挺冷的…"

# game/episode021.rpy:1469
translate simplified_chinese ep021_vess_talk_8cdb1faf:

    # c "You may have a point there."
    c "你说得在理。"

# game/episode021.rpy:1470
translate simplified_chinese ep021_vess_talk_d7abd0ff:

    # c "Would you like something to drink?"
    c "想喝点什么吗？"

# game/episode021.rpy:1472
translate simplified_chinese ep021_vess_talk_fde51723:

    # ve "No, I’m alright, thank you."
    ve "不用了，我很好，谢谢。"

# game/episode021.rpy:1473
translate simplified_chinese ep021_vess_talk_282e74f2:

    # c "How are you feeling, Vess?"
    c "薇丝，你感觉怎么样？"

# game/episode021.rpy:1474
translate simplified_chinese ep021_vess_talk_4bd79c4e:

    # ve "I’m good."
    ve "我挺好的。"

# game/episode021.rpy:1475
translate simplified_chinese ep021_vess_talk_921e1dbb:

    # ve "The crew seems to accept me more and more."
    ve "船员们似乎越来越接纳我了。"

# game/episode021.rpy:1476
translate simplified_chinese ep021_vess_talk_45513752:

    # c "Yes, I’ve noticed that too."
    c "是啊，我也注意到了。"

# game/episode021.rpy:1478
translate simplified_chinese ep021_vess_talk_1a3c7a72:

    # ve "Nobody was outright hostile, but they were certainly skeptical of my intentions, after you released me from the brig."
    ve "虽然没有人公开敌视我，但在你把我从禁闭室放出来后，他们确实对我的意图持怀疑态度。"

# game/episode021.rpy:1479
translate simplified_chinese ep021_vess_talk_d61589e0:

    # ve "Understandable of course, but still a hard thing to cope with."
    ve "当然可以理解，但这依然让人难以承受。"

# game/episode021.rpy:1481
translate simplified_chinese ep021_vess_talk_f064aea5:

    # ve "Thank you for believing in me."
    ve "谢谢你信任我。"

# game/episode021.rpy:1482
translate simplified_chinese ep021_vess_talk_acf4e928:

    # ve "I do believe that your faith in me pulled me through all that."
    ve "我确实相信你对我的信任支撑我度过了这一切。"

# game/episode021.rpy:1483
translate simplified_chinese ep021_vess_talk_f085868c:

    # ve "If it wasn’t for our relationship, I think I would have abandoned ship at one of the ports we visited in the past few weeks."
    ve "要不是因为我们的关系，我想我早就在过去几周停靠的某个港口弃船逃走了。"

# game/episode021.rpy:1484
translate simplified_chinese ep021_vess_talk_2dea9bb3:

    # c "I’m happy to hear you didn’t bail on us, or rather, bail on me."
    c "很高兴听到你没有抛弃我们，或者说，没有抛弃我。"

# game/episode021.rpy:1486
translate simplified_chinese ep021_vess_talk_6925b805:

    # ve "I would never!"
    ve "我绝对不会！"

# game/episode021.rpy:1488
translate simplified_chinese ep021_vess_talk_c2b8aefa:

    # ve "I want us to be together forever!"
    ve "我希望我们永远在一起！"

# game/episode021.rpy:1489
translate simplified_chinese ep021_vess_talk_237cc7f6:

    # ve "I love you, [p_name_short]."
    ve "我爱你，[p_name_short]。"

# game/episode021.rpy:1490
translate simplified_chinese ep021_vess_talk_785cd473:

    # c "I love you too, Vess."
    c "我也爱你，薇丝。"

# game/episode021.rpy:1491
translate simplified_chinese ep021_vess_talk_6ea27627:

    # c "And though it’s hard to keep that promise in our line of work, with all the people trying to kill us, but I want us to be together forever too."
    c "尽管在我们这一行很难信守这个承诺，总有人想要我们的命，但我也想永远和你在一起。"

# game/episode021.rpy:1493
translate simplified_chinese ep021_vess_talk_f8d884a5:

    # ve "Do you think the others should know?"
    ve "你觉得其他人应该知道吗？"

# game/episode021.rpy:1494
translate simplified_chinese ep021_vess_talk_d4c8dead:

    # c "Yes, in due time."
    c "是的，在适当的时候。"

# game/episode021.rpy:1495
translate simplified_chinese ep021_vess_talk_ab045122:

    # c "I do realize we’ve never discussed our relationship in any kind of detail."
    c "我确实意识到我们从未详细讨论过我们的关系。"

# game/episode021.rpy:1496
translate simplified_chinese ep021_vess_talk_c4c81f0b:

    # c "It all just sort of happened."
    c "这一切就是自然而然地发生了。"

# game/episode021.rpy:1498
translate simplified_chinese ep021_vess_talk_50048b96:

    # ve "It kind of did, didn’t it?"
    ve "确实是这样，不是吗？"

# game/episode021.rpy:1500
translate simplified_chinese ep021_vess_talk_fa8d9bad:

    # ve "But what would you like to discuss?"
    ve "但你想讨论些什么呢？"

# game/episode021.rpy:1501
translate simplified_chinese ep021_vess_talk_cde24e58:

    # ve "Boundaries?"
    ve "界限？"

# game/episode021.rpy:1502
translate simplified_chinese ep021_vess_talk_20b97949:

    # c "Not exactly."
    c "不完全是。"

# game/episode021.rpy:1504
translate simplified_chinese ep021_vess_talk_c61ed649:

    # c "I was just wondering what you had in mind for the future."
    c "我只是想知道你对未来有什么打算。"

# game/episode021.rpy:1506
translate simplified_chinese ep021_vess_talk_c3e65f42:

    # ve "I want to be with you as much as possible of course."
    ve "我当然想尽可能多地和你在一起。"

# game/episode021.rpy:1507
translate simplified_chinese ep021_vess_talk_c5657f4d:

    # ve "Maybe I could move into your quarters on the Bastard?"
    ve "也许我可以搬进你在\"私生子\"号的舱室？"

# game/episode021.rpy:1508
translate simplified_chinese ep021_vess_talk_b1131c96:

    # c "That sounds like an excellent idea."
    c "这听起来是个绝妙的主意。"

# game/episode021.rpy:1510
translate simplified_chinese ep021_vess_talk_1f6b3e09:

    # ve "It’s a little embarrassing, but I must admit that I’ve thought about this more than I care to admit."
    ve "有点尴尬，但我必须承认我考虑这个问题的次数比愿意承认的要多。"

# game/episode021.rpy:1511
translate simplified_chinese ep021_vess_talk_167c4bfd:

    # c "You have?"
    c "你有吗？"

# game/episode021.rpy:1512
translate simplified_chinese ep021_vess_talk_01f6f43f:

    # ve "Daydreams mostly."
    ve "大多是白日梦。"

# game/episode021.rpy:1513
translate simplified_chinese ep021_vess_talk_ba136f60:

    # ve "Just imagining a happy future for the two of us, playing home, being a family."
    ve "只是想象我们两个幸福的未来，组建家庭，成为一家人。"

# game/episode021.rpy:1517
translate simplified_chinese ep021_vess_talk_2567c90a:

    # c "Two isn’t much of a family."
    c "两个人算不上真正的家庭。"

# game/episode021.rpy:1519
translate simplified_chinese ep021_vess_talk_56fe0501:

    # ve "That’s true."
    ve "这倒是真的。"

# game/episode021.rpy:1520
translate simplified_chinese ep021_vess_talk_8da7acc2:

    # ve "But maybe we could do something about that."
    ve "但也许我们可以为此做点什么。"

# game/episode021.rpy:1521
translate simplified_chinese ep021_vess_talk_deb6c779:

    # c "Have children you mean?"
    c "你是说生孩子吗？"

# game/episode021.rpy:1523
translate simplified_chinese ep021_vess_talk_9129b782:

    # ve "...{w} Yes?"
    ve "…{w} 是的？"

# game/episode021.rpy:1524
translate simplified_chinese ep021_vess_talk_f0cc21c2:

    # ve "Unless you don’t want them."
    ve "除非你不想要孩子。"

# game/episode021.rpy:1525
translate simplified_chinese ep021_vess_talk_6b1cd2fe:

    # c "I’d love to have children with you."
    c "我很想和你生儿育女。"

# game/episode021.rpy:1527
translate simplified_chinese ep021_vess_talk_c6c9b631:

    # ve "You would?!"
    ve "真的吗？！"

# game/episode021.rpy:1529
translate simplified_chinese ep021_vess_talk_7bcf8311:

    # ve "I didn’t dare hope you’d want them too."
    ve "我都不敢奢望你也想要孩子。"

# game/episode021.rpy:1530
translate simplified_chinese ep021_vess_talk_ce4cc70a:

    # c "With you I would, you’d make a wonderful mother."
    c "和你在一起我愿意，你会是个好母亲的。"

# game/episode021.rpy:1532
translate simplified_chinese ep021_vess_talk_89b5ae1c:

    # ve "So, do you mean we should try for a baby?!"
    ve "所以，你的意思是我们要尝试要个孩子？！"

# game/episode021.rpy:1533
translate simplified_chinese ep021_vess_talk_481d7f7c:

    # c "Yes, I think we really should."
    c "是的，我觉得我们真的应该。"

# game/episode021.rpy:1535
translate simplified_chinese ep021_vess_talk_360b5f0b:

    # c "Being a family as in having kids?"
    c "组建家庭就是指要孩子吗？"

# game/episode021.rpy:1537
translate simplified_chinese ep021_vess_talk_55857d63:

    # ve "No, I didn’t mean that."
    ve "不，我不是这个意思。"

# game/episode021.rpy:1538
translate simplified_chinese ep021_vess_talk_9f7d863c:

    # c "But you want them?"
    c "但你是想要孩子的？"

# game/episode021.rpy:1540
translate simplified_chinese ep021_vess_talk_ac23aea8:

    # ve "I don’t know, I don’t think so?"
    ve "我不知道，我觉得不是这样？"

# game/episode021.rpy:1541
translate simplified_chinese ep021_vess_talk_00ab903e:

    # ve "Unless you’re dead set on it?"
    ve "除非你铁了心想要？"

# game/episode021.rpy:1542
translate simplified_chinese ep021_vess_talk_9c01c892:

    # c "No, I’m not."
    c "不，我不是。"

# game/episode021.rpy:1543
translate simplified_chinese ep021_vess_talk_d35c8354:

    # c "Two is enough, no need to complicate things."
    c "两个人就够了，没必要把事情复杂化。"

# game/episode021.rpy:1545
translate simplified_chinese ep021_vess_talk_6a58a721:

    # ve "My thoughts exactly."
    ve "我也是这么想的。"

# game/episode021.rpy:1547
translate simplified_chinese ep021_vess_talk_745d1051:

    # "Vess didn’t say anything further but rushed into my arms instead."
    "薇丝没有再说什么，而是冲进了我的怀抱。"

# game/episode021.rpy:1548
translate simplified_chinese ep021_vess_talk_b9ff6464:

    # "Kissing passionately, we wordlessly sealed the deal between us."
    "我们热烈地亲吻着，无声地达成了我们之间的约定。"

# game/episode021.rpy:1550
translate simplified_chinese ep021_vess_talk_fa505f08:

    # c "But monogamy is an issue."
    c "但一夫一妻制是个问题。"

# game/episode021.rpy:1552
translate simplified_chinese ep021_vess_talk_1bb5dd6c:

    # ve "Oh...{w} Not with me though, you’re the only one for me."
    ve "哦…{w} 不过不包括我，你是我唯一的那个人。"

# game/episode021.rpy:1553
translate simplified_chinese ep021_vess_talk_dc148060:

    # c "If I were to tell you I’m in a relationship with someone else, what would your reaction be?"
    c "如果我告诉你我正在和别人交往，你会作何反应？"

# game/episode021.rpy:1555
translate simplified_chinese ep021_vess_talk_7dd363b1:

    # ve "I guess I’d be jealous."
    ve "我猜我会吃醋。"

# game/episode021.rpy:1557
translate simplified_chinese ep021_vess_talk_d4ff9ec0:

    # ve "This isn’t some hypothetical scenario, is it?"
    ve "这并非假设情境，对吧？"

# game/episode021.rpy:1558
translate simplified_chinese ep021_vess_talk_5178fb73:

    # c "No, it isn’t."
    c "不，不是。"

# game/episode021.rpy:1559
translate simplified_chinese ep021_vess_talk_e4068ae4:

    # c "I’m in a relationship with [romances]."
    c "我正在和[romances]交往。"

# game/episode021.rpy:1561
translate simplified_chinese ep021_vess_talk_3ec027d4:

    # "I could tell Vess was distressed after hearing me say that."
    "我能感觉到薇丝听到这句话后很苦恼。"

# game/episode021.rpy:1562
translate simplified_chinese ep021_vess_talk_9f1f6585:

    # "She was silent for a good while, but didn’t storm out of the room in anger."
    "她沉默了很长时间，但没有愤怒地冲出房间。"

# game/episode021.rpy:1564
translate simplified_chinese ep021_vess_talk_16c573c6:

    # ve "That’s quite the bomb to drop, [p_name_short]."
    ve "这消息可真够劲爆的，[p_name_short]。"

# game/episode021.rpy:1565
translate simplified_chinese ep021_vess_talk_2a5387ad:

    # c "I know, and I’m sorry."
    c "我知道，我很抱歉。"

# game/episode021.rpy:1569
translate simplified_chinese ep021_vess_talk_bd9b7d7b:

    # ve "Are you seriously claiming you’re in a relationship with your own mother and sisters?"
    ve "你当真声称你和自己的母亲以及姐妹们有恋爱关系？"

# game/episode021.rpy:1571
translate simplified_chinese ep021_vess_talk_41d08a51:

    # ve "Are you seriously claiming you’re in a relationship with your own mother and some of your sisters?"
    ve "你当真声称你和自己的母亲以及部分姐妹有恋爱关系？"

# game/episode021.rpy:1573
translate simplified_chinese ep021_vess_talk_a8ab4cae:

    # ve "Are you seriously claiming you’re in a relationship with your own mother and one of your sisters?"
    ve "你当真声称你和自己的母亲以及其中一个姐妹有恋爱关系？"

# game/episode021.rpy:1575
translate simplified_chinese ep021_vess_talk_def266a1:

    # ve "Are you seriously claiming you’re in a relationship with your own sisters?"
    ve "你当真声称你和自己的姐妹们有恋爱关系？"

# game/episode021.rpy:1577
translate simplified_chinese ep021_vess_talk_01207df3:

    # ve "Are you seriously claiming you’re in a relationship with your own sister?"
    ve "你当真声称你和自己的姐妹有恋爱关系？"

# game/episode021.rpy:1579
translate simplified_chinese ep021_vess_talk_1458fcde:

    # ve "Are you seriously claiming you’re in a relationship with your own mother?"
    ve "你当真声称你和自己的母亲有恋爱关系？"

# game/episode021.rpy:1580
translate simplified_chinese ep021_vess_talk_b63d6bf3:

    # c "I am."
    c "是的。"

# game/episode021.rpy:1581
translate simplified_chinese ep021_vess_talk_6a3d9a4a:

    # ve "Isn’t that against the law?"
    ve "这难道不违法吗？"

# game/episode021.rpy:1582
translate simplified_chinese ep021_vess_talk_3de40415:

    # c "It probably is in a lot of places."
    c "在很多地方大概是违法的。"

# game/episode021.rpy:1583
translate simplified_chinese ep021_vess_talk_d6b43f7e:

    # c "Then again, the Bastard is our ship, so we set the rules."
    c "不过话说回来，\"私生子\"号是我们的飞船，所以规则由我们定。"

# game/episode021.rpy:1585
translate simplified_chinese ep021_vess_talk_ad1e1247:

    # c "I love [main_romances], in every sense of the word."
    c "我爱[main_romances]，从各种意义上来说都是。"

# game/episode021.rpy:1588
translate simplified_chinese ep021_vess_talk_8c3da50e:

    # ve "I always thought you had a special relationship with your mother and sisters, but I didn’t dare imagine it was romantic."
    ve "我一直觉得你和你母亲姐妹之间有种特殊关系，但我不敢想象竟是浪漫关系。"

# game/episode021.rpy:1590
translate simplified_chinese ep021_vess_talk_f2f079ea:

    # ve "I always thought you had a relationship with your mother and sisters, but I didn’t dare imagine it was romantic."
    ve "我一直觉得你和你母亲姐妹之间有关系，但我不敢想象竟是浪漫关系。"

# game/episode021.rpy:1592
translate simplified_chinese ep021_vess_talk_3d3ea4e8:

    # ve "I always thought you had a special relationship with your mother and sister, but I didn’t dare imagine it was romantic."
    ve "我一直觉得你和你母亲妹妹之间有种特殊关系，但我不敢想象竟是浪漫关系。"

# game/episode021.rpy:1594
translate simplified_chinese ep021_vess_talk_d9fd9f1b:

    # ve "I always thought you had a special relationship with your sisters, but I didn’t dare imagine it was romantic."
    ve "我一直觉得你和你姐妹们之间有种特殊关系，但我不敢想象竟是浪漫关系。"

# game/episode021.rpy:1596
translate simplified_chinese ep021_vess_talk_2bb88aae:

    # ve "I always thought you had a special relationship with your sister, but I didn’t dare imagine it was romantic."
    ve "我一直觉得你和你妹妹之间有种特殊关系，但我不敢想象竟是浪漫关系。"

# game/episode021.rpy:1598
translate simplified_chinese ep021_vess_talk_82652410:

    # ve "I always thought you had a special relationship with your mother, but I didn’t dare imagine it was romantic."
    ve "我一直觉得你和你母亲之间有种特殊关系，但我不敢想象竟是浪漫关系。"

# game/episode021.rpy:1599
translate simplified_chinese ep021_vess_talk_f57eacd4:

    # c "You’re not disgusted?"
    c "你不觉得恶心吗？"

# game/episode021.rpy:1601
translate simplified_chinese ep021_vess_talk_d8e2e425:

    # ve "I’ve seen some weird stuff on my travels with the Confessor."
    ve "我和\"忏悔者\"一起旅行时见过不少怪事。"

# game/episode021.rpy:1602
translate simplified_chinese ep021_vess_talk_cd48791b:

    # ve "So no, not disgusted, merely surprised, shocked even."
    ve "所以不，不恶心，只是惊讶，甚至震惊。"

# game/episode021.rpy:1603
translate simplified_chinese ep021_vess_talk_a4124125:

    # ve "It’s a lot to take in."
    ve "这信息量有点大。"

# game/episode021.rpy:1604
translate simplified_chinese ep021_vess_talk_bb511142:

    # c "I’m sure."
    c "我明白。"

# game/episode021.rpy:1605
translate simplified_chinese ep021_vess_talk_a5043336:

    # c "Again, sorry for dropping this all on you."
    c "再次抱歉把这些都强加给你。"

# game/episode021.rpy:1608
translate simplified_chinese ep021_vess_talk_1d240ba2:

    # ve "If I were to request you break off with [romances], would you do that for me? "
    ve "如果我要求你与[romances]断绝关系，你会为我这样做吗？ "

# game/episode021.rpy:1611
translate simplified_chinese ep021_vess_talk_5f6982ee:

    # c "I love you Vess, you’re very special to me, but I love [romances] just as much."
    c "我爱你薇丝，你对我很特别，但我也同样爱着[romances]。"

# game/episode021.rpy:1612
translate simplified_chinese ep021_vess_talk_03da0076:

    # c "So no, I can’t do that."
    c "所以不，我做不到。"

# game/episode021.rpy:1614
translate simplified_chinese ep021_vess_talk_a3172e75:

    # ve "I understand."
    ve "我理解。"

# game/episode021.rpy:1615
translate simplified_chinese ep021_vess_talk_98c16f11:

    # ve "Thank you for being so honest."
    ve "谢谢你如此坦诚。"

# game/episode021.rpy:1618
translate simplified_chinese ep021_vess_talk_c55d0d66:

    # ve "And I wouldn’t want to be the girl to force you to break the hearts of all those girls."
    ve "而且我也不想成为那个强迫你伤透所有女孩心的女孩。"

# game/episode021.rpy:1620
translate simplified_chinese ep021_vess_talk_b375390a:

    # ve "And I wouldn’t want to be the girl to force you to break [romances]’s heart."
    ve "而且我也不想成为那个强迫你伤透[romances]心的女孩。"

# game/episode021.rpy:1621
translate simplified_chinese ep021_vess_talk_6eef8169:

    # ve "But where does that leave us?"
    ve "但这样我们算是什么关系呢？"

# game/episode021.rpy:1623
translate simplified_chinese ep021_vess_talk_99f2f9d4:

    # ve "I don’t want to lose you, but the thought of you being with other girls tears me apart."
    ve "我不想失去你，但想到你和其他女孩在一起就让我心碎。"

# game/episode021.rpy:1625
translate simplified_chinese ep021_vess_talk_477e13a1:

    # ve "I don’t want to lose you, but the thought of you being with someone else tears me apart."
    ve "我不想失去你，但想到你和别人在一起就让我心碎。"

# game/episode021.rpy:1632
translate simplified_chinese ep021_vess_talk_df3962a3:

    # c "It doesn’t need to be that way."
    c "事情不一定非要那样发展。"

# game/episode021.rpy:1634
translate simplified_chinese ep021_vess_talk_6a6fbc6c:

    # ve "How do you mean?"
    ve "你是什么意思？"

# game/episode021.rpy:1637
translate simplified_chinese ep021_vess_talk_e84b70b4:

    # ve "I don’t want you to break up with them, if I wasn’t clear before."
    ve "如果我之前没说清楚的话，我并不希望你与她们分手。"

# game/episode021.rpy:1639
translate simplified_chinese ep021_vess_talk_4a924245:

    # ve "I don’t want you to break up with her, if I wasn’t clear before."
    ve "如果我之前没说清楚的话，我并不希望你与她分手。"

# game/episode021.rpy:1640
translate simplified_chinese ep021_vess_talk_c87467bb:

    # c "I know that and I won’t."
    c "我知道，我也不会那么做。"

# game/episode021.rpy:1641
translate simplified_chinese ep021_vess_talk_8942e5ec:

    # c "What I mean is that we could all be together."
    c "我的意思是我们可以全部在一起。"

# game/episode021.rpy:1642
translate simplified_chinese ep021_vess_talk_6c2ca5f9:

    # c "I would like to live a life with the women I love."
    c "我想和我爱的女人们共度一生。"

# game/episode021.rpy:1644
translate simplified_chinese ep021_vess_talk_52df3b0c:

    # ve "You mean, like sharing a bed with each other?"
    ve "你是说，就像我们彼此共享一张床？"

# game/episode021.rpy:1645
translate simplified_chinese ep021_vess_talk_5d0173d9:

    # c "Yes, among other things."
    c "是的，还有其他方面。"

# game/episode021.rpy:1646
translate simplified_chinese ep021_vess_talk_7b37684d:

    # c "We already live so closely together as a ship crew, what I’m proposing is to live together completely."
    c "作为船员我们已经生活得很亲密了，我提议的是完全生活在一起。"

# game/episode021.rpy:1647
translate simplified_chinese ep021_vess_talk_355c233a:

    # ve "That sounds...{w} Unconventional?"
    ve "这听起来…{w}不太寻常？"

# game/episode021.rpy:1648
translate simplified_chinese ep021_vess_talk_c9034f9e:

    # c "I’m sure it does, but it would make such a difference."
    c "我确信是这样，但这会带来很大的不同。"

# game/episode021.rpy:1649
translate simplified_chinese ep021_vess_talk_c6a041cb:

    # c "We would all know each other so intimately and I think that’s one of the highest expressions of love."
    c "我们都会如此亲密地了解彼此，我认为这是爱的最高表达方式之一。"

# game/episode021.rpy:1650
translate simplified_chinese ep021_vess_talk_57dbf644:

    # ve "That all sounds good in theory, but what about in practice?"
    ve "理论上听起来都不错，但实际操作呢？"

# game/episode021.rpy:1651
translate simplified_chinese ep021_vess_talk_2be51541:

    # ve "I assume we’re not only going to sleep in the same bed, that sex is involved?"
    ve "我猜我们不只是同床共枕，还包括性行为？"

# game/episode021.rpy:1652
translate simplified_chinese ep021_vess_talk_e58f4fea:

    # c "If you want to, yes."
    c "如果你愿意的话，是的。"

# game/episode021.rpy:1653
translate simplified_chinese ep021_vess_talk_0ca4ea8f:

    # c "But if you don’t, that’s okay too."
    c "但如果你不愿意，那也没关系。"

# game/episode021.rpy:1655
translate simplified_chinese ep021_vess_talk_450a2947:

    # "Vess still looked doubtful, but didn’t reject the notion out of hand."
    "薇丝看起来仍然心存疑虑，但没有直接否定这个提议。"

# game/episode021.rpy:1657
translate simplified_chinese ep021_vess_talk_524de742:

    # ve "Have you made the same offer to [romances]?"
    ve "你对[romances]也提出过同样的建议吗？"

# game/episode021.rpy:1659
translate simplified_chinese ep021_vess_talk_0830596a:

    # c "I have, yes."
    c "是的，我提过。"

# game/episode021.rpy:1662
translate simplified_chinese ep021_vess_talk_5a26fa39:

    # ve "And they’ve agreed?"
    ve "她们同意了？"

# game/episode021.rpy:1663
translate simplified_chinese ep021_vess_talk_28732214:

    # c "Yes, they have."
    c "是的，她们同意了。"

# game/episode021.rpy:1665
translate simplified_chinese ep021_vess_talk_a6569b0d:

    # ve "And she has agreed?"
    ve "她也同意了？"

# game/episode021.rpy:1666
translate simplified_chinese ep021_vess_talk_d3aad126:

    # c "Yes, she has."
    c "是的，她同意了。"

# game/episode021.rpy:1668
translate simplified_chinese ep021_vess_talk_545af5d6:

    # c "Yes, I have asked some of them."
    c "是的，我问过她们中的一些人。"

# game/episode021.rpy:1670
translate simplified_chinese ep021_vess_talk_5a26fa39_1:

    # ve "And they’ve agreed?"
    ve "她们同意了？"

# game/episode021.rpy:1671
translate simplified_chinese ep021_vess_talk_28732214_1:

    # c "Yes, they have."
    c "是的，她们同意了。"

# game/episode021.rpy:1673
translate simplified_chinese ep021_vess_talk_5cf7d93e:

    # c "I haven’t yet."
    c "我还没有。"

# game/episode021.rpy:1674
translate simplified_chinese ep021_vess_talk_e4e59a61:

    # ve "But you will?"
    ve "但你会问吗？"

# game/episode021.rpy:1675
translate simplified_chinese ep021_vess_talk_bfb64358:

    # c "Yes, I will."
    c "是的，我会。"

# game/episode021.rpy:1676
translate simplified_chinese ep021_vess_talk_57158b1c:

    # c "All I’m asking is to consider it as an experiment."
    c "我只希望你能把这当作一个实验来考虑。"

# game/episode021.rpy:1677
translate simplified_chinese ep021_vess_talk_a2051025:

    # c "If it doesn’t work out you can always back out and we’ll figure something else out."
    c "如果行不通，你随时可以退出，我们再想别的办法。"

# game/episode021.rpy:1679
translate simplified_chinese ep021_vess_talk_a1b3e7ae:

    # "I could tell Vess was still hesitant, but I didn’t want to force her decision."
    "我能感觉到薇丝仍在犹豫，但我不想强迫她做决定。"

# game/episode021.rpy:1680
translate simplified_chinese ep021_vess_talk_477b1b0d:

    # c "If you need some time to parse all this, I can leave you alone for a while."
    c "如果你需要时间消化这一切，我可以让你独处一会儿。"

# game/episode021.rpy:1682
translate simplified_chinese ep021_vess_talk_f2ec40be:

    # ve "We’re in your quarters, so it would feel a little awkward making you leave."
    ve "这是你的舱室，让你离开会显得有点尴尬。"

# game/episode021.rpy:1683
translate simplified_chinese ep021_vess_talk_a2e52a36:

    # ve "And I don’t need time, it’s just a hard decision."
    ve "我不需要时间考虑，只是这个决定很难做。"

# game/episode021.rpy:1685
translate simplified_chinese ep021_vess_talk_48253ae3:

    # ve "I had all these stupid plans for the future, for us I mean."
    ve "我曾为未来制定了那么多愚蠢的计划，我是说，为我们俩。"

# game/episode021.rpy:1686
translate simplified_chinese ep021_vess_talk_91e61e54:

    # c "What plans?"
    c "什么计划？"

# game/episode021.rpy:1688
translate simplified_chinese ep021_vess_talk_01f6f43f_1:

    # ve "Daydreams mostly."
    ve "多半是些白日梦。"

# game/episode021.rpy:1689
translate simplified_chinese ep021_vess_talk_ba136f60_1:

    # ve "Just imagining a happy future for the two of us, playing home, being a family."
    ve "就是想象我们俩的幸福未来，过家家，组建家庭。"

# game/episode021.rpy:1693
translate simplified_chinese ep021_vess_talk_2567c90a_1:

    # c "Two isn’t much of a family."
    c "两个人可算不上真正的家庭。"

# game/episode021.rpy:1695
translate simplified_chinese ep021_vess_talk_56fe0501_1:

    # ve "That’s true."
    ve "这倒是真的。"

# game/episode021.rpy:1696
translate simplified_chinese ep021_vess_talk_8da7acc2_1:

    # ve "But maybe we could do something about that."
    ve "但也许我们可以想办法改变这点。"

# game/episode021.rpy:1697
translate simplified_chinese ep021_vess_talk_deb6c779_1:

    # c "Have children you mean?"
    c "你是说生孩子？"

# game/episode021.rpy:1699
translate simplified_chinese ep021_vess_talk_9129b782_1:

    # ve "...{w} Yes?"
    ve "…{w} 是啊？"

# game/episode021.rpy:1700
translate simplified_chinese ep021_vess_talk_f0cc21c2_1:

    # ve "Unless you don’t want them."
    ve "除非你不想要孩子。"

# game/episode021.rpy:1701
translate simplified_chinese ep021_vess_talk_6b1cd2fe_1:

    # c "I’d love to have children with you."
    c "我很想和你生儿育女。"

# game/episode021.rpy:1703
translate simplified_chinese ep021_vess_talk_c6c9b631_1:

    # ve "You would?!"
    ve "真的吗？！"

# game/episode021.rpy:1704
translate simplified_chinese ep021_vess_talk_7bcf8311_1:

    # ve "I didn’t dare hope you’d want them too."
    ve "我都不敢奢望你也想要孩子。"

# game/episode021.rpy:1705
translate simplified_chinese ep021_vess_talk_ce4cc70a_1:

    # c "With you I would, you’d make a wonderful mother."
    c "如果是和你，我愿意，你会是个好母亲的。"

# game/episode021.rpy:1707
translate simplified_chinese ep021_vess_talk_89b5ae1c_1:

    # ve "So, do you mean we should try for a baby?!"
    ve "所以，你是说我们应该尝试要个孩子？！"

# game/episode021.rpy:1708
translate simplified_chinese ep021_vess_talk_481d7f7c_1:

    # c "Yes, I think we really should."
    c "是的，我觉得我们真的应该试试。"

# game/episode021.rpy:1710
translate simplified_chinese ep021_vess_talk_360b5f0b_1:

    # c "Being a family as in having kids?"
    c "组成家庭是指要孩子吗？"

# game/episode021.rpy:1711
translate simplified_chinese ep021_vess_talk_55857d63_1:

    # ve "No, I didn’t mean that."
    ve "不，我不是那个意思。"

# game/episode021.rpy:1712
translate simplified_chinese ep021_vess_talk_9f7d863c_1:

    # c "But you want them?"
    c "但你是想要孩子的吧？"

# game/episode021.rpy:1714
translate simplified_chinese ep021_vess_talk_ac23aea8_1:

    # ve "I don’t know, I don’t think so?"
    ve "我不知道，我觉得不是吧？"

# game/episode021.rpy:1715
translate simplified_chinese ep021_vess_talk_00ab903e_1:

    # ve "Unless you’re dead set on it?"
    ve "除非你非常坚持？"

# game/episode021.rpy:1716
translate simplified_chinese ep021_vess_talk_9c01c892_1:

    # c "No, I’m not."
    c "不，我没有。"

# game/episode021.rpy:1717
translate simplified_chinese ep021_vess_talk_d35c8354_1:

    # c "Two is enough, no need to complicate things."
    c "两个人就够了，没必要把事情复杂化。"

# game/episode021.rpy:1719
translate simplified_chinese ep021_vess_talk_6a58a721_1:

    # ve "My thoughts exactly."
    ve "我也是这么想的。"

# game/episode021.rpy:1722
translate simplified_chinese ep021_vess_talk_221efc26:

    # ve "But you think this could all work?"
    ve "但你觉得这一切能行得通吗？"

# game/episode021.rpy:1723
translate simplified_chinese ep021_vess_talk_1a53eabe:

    # ve "This group love thing you’re proposing?"
    ve "你提议的这种群体恋爱关系？"

# game/episode021.rpy:1725
translate simplified_chinese ep021_vess_talk_3085e7bf:

    # ve "And having a baby?"
    ve "还有生个孩子？"

# game/episode021.rpy:1726
translate simplified_chinese ep021_vess_talk_058dd7b5:

    # c "Yes, I think so."
    c "是的，我觉得可以。"

# game/episode021.rpy:1728
translate simplified_chinese ep021_vess_talk_be6b8894:

    # c "I just know you’ll make a wonderful mother."
    c "我只知道你一定会成为一位很棒的母亲。"

# game/episode021.rpy:1730
translate simplified_chinese ep021_vess_talk_53c8ef13:

    # c "I just know the others will love you just as much as I do."
    c "我只知道其他人会像我一样爱你。"

# game/episode021.rpy:1732
translate simplified_chinese ep021_vess_talk_745d1051_1:

    # "Vess didn’t say anything further but rushed into my arms instead."
    "薇丝没再说什么，而是扑进了我的怀抱。"

# game/episode021.rpy:1733
translate simplified_chinese ep021_vess_talk_b9ff6464_1:

    # "Kissing passionately, we wordlessly sealed the deal between us."
    "我们热烈亲吻着，无声地达成了彼此之间的约定。"

# game/episode021.rpy:1735
translate simplified_chinese ep021_vess_talk_8665c4dd:

    # c "I’m sorry it makes you feel that way."
    c "很抱歉让你有这种感觉。"

# game/episode021.rpy:1736
translate simplified_chinese ep021_vess_talk_fd6addc3:

    # c "All I can ask is for you to turn a blind eye."
    c "我只求你能睁一只眼闭一只眼。"

# game/episode021.rpy:1738
translate simplified_chinese ep021_vess_talk_b47deddf:

    # c "I won’t mention the others when I’m with you."
    c "和你在一起时，我不会提起其他人。"

# game/episode021.rpy:1739
translate simplified_chinese ep021_vess_talk_4bbcb2dd:

    # c "Nor would I ever steer you willingly into an uncomfortable situation, where you need to confront them."
    c "我也绝不会故意让你陷入需要面对她们的尴尬处境。"

# game/episode021.rpy:1741
translate simplified_chinese ep021_vess_talk_18cf772e:

    # c "I won’t mention her when I’m with you."
    c "和你在一起时，我不会提起她。"

# game/episode021.rpy:1742
translate simplified_chinese ep021_vess_talk_466c7e61:

    # c "Nor would I ever steer you willingly into an uncomfortable situation, where you need to confront her."
    c "我也绝不会故意让你陷入需要面对她的尴尬处境。"

# game/episode021.rpy:1743
translate simplified_chinese ep021_vess_talk_d9fcbaf0:

    # c "Do you think you could live with a situation like that?"
    c "你觉得你能接受这样的状况吗？"

# game/episode021.rpy:1745
translate simplified_chinese ep021_vess_talk_981fa394:

    # "Vess was silent again, pondering my question."
    "薇丝再次沉默，思考着我的问题。"

# game/episode021.rpy:1746
translate simplified_chinese ep021_vess_talk_4822d67c:

    # "I saw a range of emotions flitting across her face, before resolving into determination."
    "我看到她脸上掠过一系列情绪，最终定格为坚定的神色。"

# game/episode021.rpy:1748
translate simplified_chinese ep021_vess_talk_88ddaf19:

    # ve "Yes, I think I could."
    ve "是的，我想我可以接受。"

# game/episode021.rpy:1749
translate simplified_chinese ep021_vess_talk_e1b7c328:

    # ve "But you have to promise me that you’ll be upfront if your feelings for me or [romances] change."
    ve "但你必须向我保证，如果你对我的感情或[romances]发生变化，你会坦诚相告。"

# game/episode021.rpy:1750
translate simplified_chinese ep021_vess_talk_1196f02d:

    # ve "I don’t want to be blindsided if one of your relationships suddenly evolve into something more."
    ve "我不希望在你某段关系突然升级时措手不及。"

# game/episode021.rpy:1751
translate simplified_chinese ep021_vess_talk_0d781846:

    # c "Something more?"
    c "升级？"

# game/episode021.rpy:1754
translate simplified_chinese ep021_vess_talk_bdc2fd82:

    # ve "Yes...{w} If they become more important than me."
    ve "是的…{w}如果她们变得比我更重要。"

# game/episode021.rpy:1755
translate simplified_chinese ep021_vess_talk_0c928222:

    # ve "Or if one of them wants a child with you."
    ve "或者如果她们中有人想和你生孩子。"

# game/episode021.rpy:1757
translate simplified_chinese ep021_vess_talk_bd4a0a40:

    # ve "Yes...{w} If she becomes more important than me."
    ve "是的…{w}如果她变得比我更重要。"

# game/episode021.rpy:1758
translate simplified_chinese ep021_vess_talk_9f638c62:

    # ve "Or if she wants a child with you."
    ve "或者如果她想和你生孩子。"

# game/episode021.rpy:1760
translate simplified_chinese ep021_vess_talk_a44ccf78:

    # c "I promise."
    c "我保证。"

# game/episode021.rpy:1761
translate simplified_chinese ep021_vess_talk_cc0d3698:

    # c "Did you mention children for any particular reason?"
    c "你提到孩子是有什么特别原因吗？"

# game/episode021.rpy:1762
translate simplified_chinese ep021_vess_talk_2cc28916:

    # ve "It’s one of the most momentous things in a relationship, isn’t it?"
    ve "这是感情关系中最重要的事情之一，不是吗？"

# game/episode021.rpy:1767
translate simplified_chinese ep021_vess_talk_b78f5a6b:

    # c "Sure, but is it a momentous thing for you too?"
    c "当然，但这对你来说也是件重要的事吗？"

# game/episode021.rpy:1769
translate simplified_chinese ep021_vess_talk_88c404b1:

    # ve "I...{w} I must admit that I’ve thought about it, once or twice..."
    ve "我…{w}我必须承认我曾考虑过一两次…"

# game/episode021.rpy:1770
translate simplified_chinese ep021_vess_talk_73f776c1:

    # ve "Okay fine, I’ve thought about it a lot."
    ve "好吧老实说，我想过很多次。"

# game/episode021.rpy:1771
translate simplified_chinese ep021_vess_talk_3ddd7ac1:

    # ve "With you, I mean, having a baby with you."
    ve "我是说和你，和你生个孩子。"

# game/episode021.rpy:1772
translate simplified_chinese ep021_vess_talk_79d9bc07:

    # c "And the thought didn’t fill you with dread or panic, I take it?"
    c "这么说这个想法没有让你充满恐惧或惊慌，我猜？"

# game/episode021.rpy:1773
translate simplified_chinese ep021_vess_talk_324dde4d:

    # ve "No, not at all."
    ve "不，完全没有。"

# game/episode021.rpy:1775
translate simplified_chinese ep021_vess_talk_65b5bae4:

    # ve "But I didn’t dare presume you were of the same mind."
    ve "但我不敢假设你也抱有同样的想法。"

# game/episode021.rpy:1776
translate simplified_chinese ep021_vess_talk_ba8d3d59:

    # c "I am though."
    c "但我确实是这么想的。"

# game/episode021.rpy:1777
translate simplified_chinese ep021_vess_talk_8ec6b4de:

    # c "I would love to have children with you."
    c "我很想和你拥有孩子。"

# game/episode021.rpy:1778
translate simplified_chinese ep021_vess_talk_46ca5887:

    # c "You’d make a wonderful mother."
    c "你会是个好母亲的。"

# game/episode021.rpy:1780
translate simplified_chinese ep021_vess_talk_bf88ecef:

    # ve "So, do you mean we should try for a baby?"
    ve "所以，你的意思是我们该试着要个孩子？"

# game/episode021.rpy:1781
translate simplified_chinese ep021_vess_talk_481d7f7c_2:

    # c "Yes, I think we really should."
    c "是的，我觉得我们确实应该。"

# game/episode021.rpy:1783
translate simplified_chinese ep021_vess_talk_745d1051_2:

    # "Vess didn’t say anything further but rushed into my arms instead."
    "薇丝没再说什么，而是扑进了我的怀抱。"

# game/episode021.rpy:1784
translate simplified_chinese ep021_vess_talk_b9ff6464_2:

    # "Kissing passionately, we wordlessly sealed the deal between us."
    "我们热烈亲吻着，无声地达成了彼此间的约定。"

# game/episode021.rpy:1786
translate simplified_chinese ep021_vess_talk_058dd7b5_1:

    # c "Yes, I think so."
    c "是的，我也这么想。"

# game/episode021.rpy:1787
translate simplified_chinese ep021_vess_talk_2d8de1b2:

    # c "But I’m not really looking to start a family."
    c "但我其实没打算组建家庭。"

# game/episode021.rpy:1788
translate simplified_chinese ep021_vess_talk_029a3b8f:

    # ve "It’s a relief to hear you say that, because me neither."
    ve "听你这么说我就放心了，因为我也没有这个打算。"

# game/episode021.rpy:1789
translate simplified_chinese ep021_vess_talk_79ff5b90:

    # c "You and me is all that matters."
    c "有你和我在一起就足够了。"

# game/episode021.rpy:1791
translate simplified_chinese ep021_vess_talk_0c676f19:

    # ve "I couldn’t agree more."
    ve "我完全同意。"

# game/episode021.rpy:1793
translate simplified_chinese ep021_vess_talk_012ed13d:

    # "In response, we kissed passionately, wordlessly sealing the deal between us."
    "作为回应，我们热烈亲吻，无声地确认了我们之间的约定。"

# game/episode021.rpy:1796
translate simplified_chinese ep021_vess_talk_69370cf9:

    # c "If you want me to do that, I will."
    c "如果你想让我那样做，我会的。"

# game/episode021.rpy:1797
translate simplified_chinese ep021_vess_talk_65909bdb:

    # c "You’re special to me, Vess."
    c "薇丝，你对我来说很特别。"

# game/episode021.rpy:1799
translate simplified_chinese ep021_vess_talk_d19d2665:

    # ve "You really would?"
    ve "你真的愿意？"

# game/episode021.rpy:1800
translate simplified_chinese ep021_vess_talk_26eefe0a:

    # c "Yes."
    c "是的。"

# game/episode021.rpy:1801
translate simplified_chinese ep021_vess_talk_42ec1dbb:

    # c "If not doing so means losing you."
    c "如果不这样做意味着失去你的话。"

# game/episode021.rpy:1803
translate simplified_chinese ep021_vess_talk_67ba58f8:

    # ve "To be honest, I don’t want to share you."
    ve "说实话，我不想和任何人分享你。"

# game/episode021.rpy:1804
translate simplified_chinese ep021_vess_talk_6029e066:

    # ve "I don’t want any man but you and I was hoping I would be enough for you too."
    ve "除了你我谁都不想要，而且我希望我对你来说也足够。"

# game/episode021.rpy:1805
translate simplified_chinese ep021_vess_talk_cc810d43:

    # c "I’ll break up with [romances]."
    c "我会和[romances]分手的。"

# game/episode021.rpy:1807
translate simplified_chinese ep021_vess_talk_ccd6d4da:

    # ve "You’d do that, just for me?"
    ve "你愿意为我这么做？"

# game/episode021.rpy:1808
translate simplified_chinese ep021_vess_talk_33847e67:

    # c "Just for you."
    c "只为你。"

# game/episode021.rpy:1810
translate simplified_chinese ep021_vess_talk_41482365:

    # ve "I love you so much, [p_name_short]!"
    ve "我太爱你了，[p_name_short]！"

# game/episode021.rpy:1811
translate simplified_chinese ep021_vess_talk_0c0fc599:

    # ve "I know this is a big ask of you, but I can’t imagine sharing you with anyone."
    ve "我知道这对你要求很高，但我无法想象与任何人分享你。"

# game/episode021.rpy:1813
translate simplified_chinese ep021_vess_talk_7403a33c:

    # ve "You’ll probably think me crazy, but I had all these plans for the future, for us I mean."
    ve "你可能会觉得我疯了，但我对未来有所有这些计划，我是说我们俩的未来。"

# game/episode021.rpy:1814
translate simplified_chinese ep021_vess_talk_91e61e54_1:

    # c "What plans?"
    c "什么计划？"

# game/episode021.rpy:1815
translate simplified_chinese ep021_vess_talk_01f6f43f_2:

    # ve "Daydreams mostly."
    ve "大多是白日梦。"

# game/episode021.rpy:1816
translate simplified_chinese ep021_vess_talk_ba136f60_2:

    # ve "Just imagining a happy future for the two of us, playing home, being a family."
    ve "只是想象我们俩的幸福未来，组建家庭，成为一家人。"

# game/episode021.rpy:1820
translate simplified_chinese ep021_vess_talk_2567c90a_2:

    # c "Two isn’t much of a family."
    c "两个人算不上完整的家庭。"

# game/episode021.rpy:1821
translate simplified_chinese ep021_vess_talk_56fe0501_2:

    # ve "That’s true."
    ve "那倒是真的。"

# game/episode021.rpy:1822
translate simplified_chinese ep021_vess_talk_8da7acc2_2:

    # ve "But maybe we could do something about that."
    ve "但也许我们可以为此做些什么。"

# game/episode021.rpy:1823
translate simplified_chinese ep021_vess_talk_deb6c779_2:

    # c "Have children you mean?"
    c "你是说生孩子吗？"

# game/episode021.rpy:1825
translate simplified_chinese ep021_vess_talk_9129b782_2:

    # ve "...{w} Yes?"
    ve "…{w} 是的？"

# game/episode021.rpy:1826
translate simplified_chinese ep021_vess_talk_f0cc21c2_2:

    # ve "Unless you don’t want them."
    ve "除非你不想要孩子。"

# game/episode021.rpy:1827
translate simplified_chinese ep021_vess_talk_6b1cd2fe_2:

    # c "I’d love to have children with you."
    c "我很想和你一起生孩子。"

# game/episode021.rpy:1829
translate simplified_chinese ep021_vess_talk_c6c9b631_2:

    # ve "You would?!"
    ve "真的吗？！"

# game/episode021.rpy:1830
translate simplified_chinese ep021_vess_talk_7bcf8311_2:

    # ve "I didn’t dare hope you’d want them too."
    ve "我都不敢奢望你也想要孩子。"

# game/episode021.rpy:1831
translate simplified_chinese ep021_vess_talk_ce4cc70a_2:

    # c "With you I would, you’d make a wonderful mother."
    c "和你一起的话我愿意，你会是个好母亲的。"

# game/episode021.rpy:1833
translate simplified_chinese ep021_vess_talk_bf88ecef_1:

    # ve "So, do you mean we should try for a baby?"
    ve "所以，你是说我们应该尝试要个孩子？"

# game/episode021.rpy:1834
translate simplified_chinese ep021_vess_talk_481d7f7c_3:

    # c "Yes, I think we really should."
    c "是的，我觉得我们真的应该试试。"

# game/episode021.rpy:1836
translate simplified_chinese ep021_vess_talk_360b5f0b_2:

    # c "Being a family as in having kids?"
    c "组成家庭就是要生孩子吗？"

# game/episode021.rpy:1838
translate simplified_chinese ep021_vess_talk_55857d63_2:

    # ve "No, I didn’t mean that."
    ve "不，我不是那个意思。"

# game/episode021.rpy:1839
translate simplified_chinese ep021_vess_talk_9f7d863c_2:

    # c "But you want them?"
    c "但你想要孩子吗？"

# game/episode021.rpy:1841
translate simplified_chinese ep021_vess_talk_ac23aea8_2:

    # ve "I don’t know, I don’t think so?"
    ve "我不知道，我觉得不是这样？"

# game/episode021.rpy:1842
translate simplified_chinese ep021_vess_talk_00ab903e_2:

    # ve "Unless you’re dead set on it?"
    ve "除非你下定决心要孩子？"

# game/episode021.rpy:1843
translate simplified_chinese ep021_vess_talk_9c01c892_2:

    # c "No, I’m not."
    c "不，我没有。"

# game/episode021.rpy:1844
translate simplified_chinese ep021_vess_talk_d35c8354_2:

    # c "Two is enough, no need to complicate things."
    c "两个人就够了，没必要把事情复杂化。"

# game/episode021.rpy:1846
translate simplified_chinese ep021_vess_talk_6a58a721_2:

    # ve "My thoughts exactly."
    ve "我也是这么想的。"

# game/episode021.rpy:1848
translate simplified_chinese ep021_vess_talk_745d1051_3:

    # "Vess didn’t say anything further but rushed into my arms instead."
    "薇丝没再说什么，而是冲进了我的怀抱。"

# game/episode021.rpy:1849
translate simplified_chinese ep021_vess_talk_b9ff6464_3:

    # "Kissing passionately, we wordlessly sealed the deal between us."
    "我们热烈地亲吻着，无声地确认了我们之间的约定。"

# game/episode021.rpy:1858
translate simplified_chinese ep021_raene_talk_787b4719:

    # c "Hey you."
    c "嘿，你。"

# game/episode021.rpy:1859
translate simplified_chinese ep021_raene_talk_e631b5fd:

    # ra "Hey [p_name_short]."
    ra "嘿[p_name_short]。"

# game/episode021.rpy:1860
translate simplified_chinese ep021_raene_talk_bcae8f9b:

    # c "Settling in alright?"
    c "安顿得还好吗？"

# game/episode021.rpy:1862
translate simplified_chinese ep021_raene_talk_06f4983d:

    # ra "Sure."
    ra "当然。"

# game/episode021.rpy:1863
translate simplified_chinese ep021_raene_talk_e58f48a9:

    # c "We didn’t get a chance to really talk about what happened on Paclerara."
    c "我们还没机会好好谈谈在帕克莱拉拉发生的事。"

# game/episode021.rpy:1864
translate simplified_chinese ep021_raene_talk_4a63f8c7:

    # ra "Right, we were in a hurry after all."
    ra "是啊，毕竟我们当时很匆忙。"

# game/episode021.rpy:1865
translate simplified_chinese ep021_raene_talk_f282b1b8:

    # c "I meant what I said, Raene, you did a brave thing back there."
    c "我说的是真心话，蕾妮，你在那里做了件勇敢的事。"

# game/episode021.rpy:1867
translate simplified_chinese ep021_raene_talk_dca14ca9:

    # ra "Yes, you said so before."
    ra "是的，你之前说过了。"

# game/episode021.rpy:1869
translate simplified_chinese ep021_raene_talk_7822c787:

    # ra "I’m still not sure if I believe it."
    ra "我还是不确定我是否相信这一点。"

# game/episode021.rpy:1870
translate simplified_chinese ep021_raene_talk_b1ead9d5:

    # ra "On the one hand it felt really good to finally say those things to my dad..."
    ra "一方面，终于对我爸说出那些话感觉真的很好…"

# game/episode021.rpy:1872
translate simplified_chinese ep021_raene_talk_ac43a58f:

    # ra "But there’s still some part of me that thinks he’s right."
    ra "但仍有部分我觉得他是对的。"

# game/episode021.rpy:1873
translate simplified_chinese ep021_raene_talk_13b4033a:

    # ra "That I’m lost and have strayed..."
    ra "说我迷失了方向，误入歧途…"

# game/episode021.rpy:1874
translate simplified_chinese ep021_raene_talk_2c929c1b:

    # c "I guess that makes sense, considering how you grew up and how long your father and his church exerted their influence on you."
    c "考虑到你的成长经历，以及你父亲和他的教会对你施加影响这么久，这种想法倒也说得通。"

# game/episode021.rpy:1875
translate simplified_chinese ep021_raene_talk_d7dce117:

    # c "But do you really think he’s right?"
    c "但你真的认为他是对的吗？"

# game/episode021.rpy:1876
translate simplified_chinese ep021_raene_talk_015bcf19:

    # c "Does it feel good denying who you are?"
    c "否认真实的自己，会让你感觉舒服吗？"

# game/episode021.rpy:1878
translate simplified_chinese ep021_raene_talk_4dfb53ee:

    # ra "No it doesn’t."
    ra "不，并不舒服。"

# game/episode021.rpy:1879
translate simplified_chinese ep021_raene_talk_acef807d:

    # ra "And I know he’s wrong."
    ra "而且我知道他是错的。"

# game/episode021.rpy:1880
translate simplified_chinese ep021_raene_talk_53db4765:

    # ra "There’s just that tiny seed of doubt, still lingering."
    ra "只是还有一丝疑虑，始终挥之不去。"

# game/episode021.rpy:1882
translate simplified_chinese ep021_raene_talk_0f5eddb0:

    # ra "I guess it will take time for that to fade away."
    ra "我想这需要时间慢慢淡化。"

# game/episode021.rpy:1883
translate simplified_chinese ep021_raene_talk_aa491929:

    # c "Yes, you might be right."
    c "是的，或许你是对的。"

# game/episode021.rpy:1884
translate simplified_chinese ep021_raene_talk_c33453ba:

    # c "If you are ever in doubt or feel the need to talk, you know I’m there for you."
    c "如果你有任何疑虑或需要倾诉，你知道我永远都在。"

# game/episode021.rpy:1886
translate simplified_chinese ep021_raene_talk_c7944984:

    # ra "Yes, I know."
    ra "是的，我知道。"

# game/episode021.rpy:1887
translate simplified_chinese ep021_raene_talk_5732231b:

    # ra "Thank you, [p_name_short]."
    ra "谢谢你，[p_name_short]。"

# game/episode021.rpy:1888
translate simplified_chinese ep021_raene_talk_03d010cb:

    # ra "And thank you for rescuing me."
    ra "也谢谢你救了我。"

# game/episode021.rpy:1889
translate simplified_chinese ep021_raene_talk_3aaeac79:

    # c "We arrived at a good time, but I’m not entirely sure you wouldn’t have rescued yourself."
    c "我们来得正是时候，但我不完全确定你是否无法自救。"

# game/episode021.rpy:1891
translate simplified_chinese ep021_raene_talk_573bbc3f:

    # ra "I think those clerics were instructed to use heavy force if I wouldn’t go willingly."
    ra "我觉得那些牧师接到指示，如果我不愿意走就会动用重武力。"

# game/episode021.rpy:1892
translate simplified_chinese ep021_raene_talk_2d6e1143:

    # c "Yeah, I guess so."
    c "是啊，我想也是。"

# game/episode021.rpy:1893
translate simplified_chinese ep021_raene_talk_cf73ef61:

    # c "You wouldn’t have gone without a fight though, even though it was an uneven one."
    c "不过你肯定不会束手就擒，尽管力量悬殊。"

# game/episode021.rpy:1895
translate simplified_chinese ep021_raene_talk_21e79241:

    # ra "No, you’re right."
    ra "不，你说得对。"

# game/episode021.rpy:1896
translate simplified_chinese ep021_raene_talk_7adccfd2:

    # c "Do you think your father will give up the search for you now?"
    c "你觉得你父亲现在会放弃寻找你吗？"

# game/episode021.rpy:1898
translate simplified_chinese ep021_raene_talk_250bcb0d:

    # ra "Knowing him, I don’t think he will."
    ra "以我对他的了解，我认为他不会。"

# game/episode021.rpy:1899
translate simplified_chinese ep021_raene_talk_00807b0e:

    # ra "I don’t think it’s even about me anymore, or converting me back to whatever expectations he has of me."
    ra "我认为这甚至不再关乎我，或者让我回归他对我的任何期望。"

# game/episode021.rpy:1900
translate simplified_chinese ep021_raene_talk_ae6d9893:

    # ra "It’s more that he wants to be right, at all costs."
    ra "更多的是他不惜一切代价想要证明自己是对的。"

# game/episode021.rpy:1901
translate simplified_chinese ep021_raene_talk_e6d4976c:

    # c "I guess that’s what having too much power does to someone."
    c "我想这就是权力过剩对一个人的影响。"

# game/episode021.rpy:1902
translate simplified_chinese ep021_raene_talk_e277395d:

    # c "Believe me, I can relate."
    c "相信我，我深有体会。"

# game/episode021.rpy:1904
translate simplified_chinese ep021_raene_talk_34d13f96:

    # ra "Do you think your father still loves you, deep down?"
    ra "你觉得你父亲内心深处还爱你吗？"

# game/episode021.rpy:1906
translate simplified_chinese ep021_raene_talk_4aa575ac:

    # c "I’m not sure he ever loved us."
    c "我不确定他是否曾爱过我们。"

# game/episode021.rpy:1907
translate simplified_chinese ep021_raene_talk_7416f083:

    # c "Not my sisters and certainly not me."
    c "不爱我的姐妹们，当然也不爱我。"

# game/episode021.rpy:1909
translate simplified_chinese ep021_raene_talk_e0a34061:

    # c "I’m not sure he ever loved me."
    c "我不确定他是否曾爱过我。"

# game/episode021.rpy:1910
translate simplified_chinese ep021_raene_talk_a8d6597d:

    # c "Agust always has been too wrapped up in his own schemes."
    c "阿古斯特总是过于沉浸在自己的计划中。"

# game/episode021.rpy:1911
translate simplified_chinese ep021_raene_talk_c26c60d5:

    # c "I wonder what the endgame for him is."
    c "我想知道他的最终目标是什么。"

# game/episode021.rpy:1912
translate simplified_chinese ep021_raene_talk_34da2507:

    # c "I mean, he’s not a religious man, nor superstitious and yet he has apparently been guided by that Prophecy maybe before we were even been born."
    c "我的意思是，他既不信教也不迷信，但显然早在你我出生之前，他就已经被那个预言指引着。"

# game/episode021.rpy:1913
translate simplified_chinese ep021_raene_talk_1539c1db:

    # c "There must be something tangible for him, something that he wants so dearly."
    c "对他而言一定存在某种实实在在的东西，某种他极度渴望的东西。"

# game/episode021.rpy:1914
translate simplified_chinese ep021_raene_talk_a2713c5e:

    # c "Anyway, I guess he married the right person."
    c "不管怎样，我觉得他倒是娶对了人。"

# game/episode021.rpy:1915
translate simplified_chinese ep021_raene_talk_53e01bd4:

    # c "A narcissistic pop diva and a sociopathic businessman, clearly a match made in heaven."
    c "一个自恋的流行歌后和一个反社会的商人，简直是天作之合。"

# game/episode021.rpy:1917
translate simplified_chinese ep021_raene_talk_9b01c3f7:

    # c "I’m glad my real mother turned out to be such a sweetheart."
    c "我很庆幸我的亲生母亲原来是如此温柔可人。"

# game/episode021.rpy:1919
translate simplified_chinese ep021_raene_talk_73a6105f:

    # ra "And at least his son didn’t turn out so bad."
    ra "至少他的儿子也没有变得太糟糕。"

# game/episode021.rpy:1920
translate simplified_chinese ep021_raene_talk_be819ff1:

    # c "Hardly a ringing endorsement..."
    c "这算不上什么热烈的赞美…"

# game/episode021.rpy:1921
translate simplified_chinese ep021_raene_talk_df5da29a:

    # ra "Sorry, let me rephrase that."
    ra "抱歉，让我重新说。"

# game/episode021.rpy:1922
translate simplified_chinese ep021_raene_talk_47fee6f7:

    # ra "I can scarcely believe, Agust fathered this kind-hearted and brave man I’ve come to love."
    ra "我几乎无法相信，阿古斯特竟然生养出了我深爱的这位善良勇敢的男人。"

# game/episode021.rpy:1924
translate simplified_chinese ep021_raene_talk_03520ec1:

    # "I took Raene in my arms and kissed her."
    "我将蕾妮拥入怀中亲吻了她。"

# game/episode021.rpy:1925
translate simplified_chinese ep021_raene_talk_71bd196f:

    # c "That’s better!"
    c "这样好多了！"

# game/episode021.rpy:1927
translate simplified_chinese ep021_raene_talk_29c2bc9a:

    # ra "I forgot sexy in that list."
    ra "我忘了把性感列在清单里。"

# game/episode021.rpy:1928
translate simplified_chinese ep021_raene_talk_b24769f3:

    # ra "And being a great kisser."
    ra "还有接吻技巧一流。"

# game/episode021.rpy:1930
translate simplified_chinese ep021_raene_talk_4e46a33f:

    # "Our lips met again and this time Raene moaned while our tongues entwined."
    "我们的唇再次相触，这次当舌尖缠绕时，蕾妮发出了呻吟。"

# game/episode021.rpy:1935
translate simplified_chinese ep021_raene_talk_aeff982f:

    # ra "Sorry for gushing like this, but I feel so free every since I’ve been with you."
    ra "抱歉说得这么肉麻，但自从和你在一起后，我感觉如此自由。"

# game/episode021.rpy:1936
translate simplified_chinese ep021_raene_talk_40148078:

    # ra "Like I knew I was repressing most of my feelings at a surface-level, but now I realize just how bottled-up I was."
    ra "虽然我知道自己一直在表面压抑大部分情感，但现在才意识到原来我压抑得有多深。"

# game/episode021.rpy:1937
translate simplified_chinese ep021_raene_talk_2c916a3b:

    # c "I’m proud to hear you say that."
    c "听你这么说我很自豪。"

# game/episode021.rpy:1938
translate simplified_chinese ep021_raene_talk_c42edd7f:

    # c "But you did start this path on your own, Raene."
    c "但这条道路确实是你自己开启的，蕾妮。"

# game/episode021.rpy:1939
translate simplified_chinese ep021_raene_talk_4b9eec0d:

    # c "Back when you decided you had enough and contacted Ziv’s people."
    c "从你决定忍无可忍，联系基芙族人的那一刻起。"

# game/episode021.rpy:1940
translate simplified_chinese ep021_raene_talk_01b5ff0a:

    # c "That took guts, and you did all by yourself."
    c "那需要勇气，而这一切都是你独自完成的。"

# game/episode021.rpy:1942
translate simplified_chinese ep021_raene_talk_9fef6ff7:

    # ra "I guess so."
    ra "我想是吧。"

# game/episode021.rpy:1943
translate simplified_chinese ep021_raene_talk_a87ba8b4:

    # ra "Being done with all those inhibitions my father and his religion taught is liberating though."
    ra "不过，能摆脱我父亲和他的宗教灌输的所有束缚，确实让人感觉解脱。"

# game/episode021.rpy:1945
translate simplified_chinese ep021_raene_talk_7fb00cfd:

    # ra "I’m free to be who I want, do what I want."
    ra "我可以自由地做自己想成为的人，做自己想做的事。"

# game/episode021.rpy:1946
translate simplified_chinese ep021_raene_talk_0807eb9b:

    # ra "I can experiment if I want to, without the fear of being judged."
    ra "如果愿意，我可以尝试各种事情，不用担心被人评头论足。"

# game/episode021.rpy:1947
translate simplified_chinese ep021_raene_talk_64047522:

    # c "Do you have any specific experiments in mind?"
    c "你心里有什么具体的尝试计划吗？"

# game/episode021.rpy:1949
translate simplified_chinese ep021_raene_talk_382be9bf:

    # ra "Well, having lots more sex with you, obviously."
    ra "嗯，显然是要和你多亲热亲热。"

# game/episode021.rpy:1950
translate simplified_chinese ep021_raene_talk_c8010d3a:

    # c "I can get behind that."
    c "这个我完全支持。"

# game/episode021.rpy:1952
translate simplified_chinese ep021_raene_talk_3721cead:

    # ra "But I don’t know specifically, I’ll just take it as it comes."
    ra "但具体要做什么，我也不太确定，顺其自然吧。"

# game/episode021.rpy:1953
translate simplified_chinese ep021_raene_talk_d65cf5e0:

    # ra "I don’t want to dismiss anything beforehand."
    ra "我不想事先排除任何可能性。"

# game/episode021.rpy:1954
translate simplified_chinese ep021_raene_talk_d7335b50:

    # c "I think that’s a good way to live."
    c "我觉得这样生活挺好的。"

# game/episode021.rpy:1955
translate simplified_chinese ep021_raene_talk_0ddcc54d:

    # c "So if I were to propose we go swimming in a sea full of slingbladesharks?"
    c "那么如果我提议我们去满是链锯鲨的海里游泳呢？"

# game/episode021.rpy:1957
translate simplified_chinese ep021_raene_talk_d715e694:

    # ra "Haha, only if you went in the water first."
    ra "哈哈，除非你先下水。"

# game/episode021.rpy:1979
translate simplified_chinese ep021_raene_talk_b97cd852:

    # c "A threesome then."
    c "那来个三人行吧。"

# game/episode021.rpy:1981
translate simplified_chinese ep021_raene_talk_5ae25e80:

    # ra "Hmmm, well..."
    ra "嗯，这个嘛…"

# game/episode021.rpy:1983
translate simplified_chinese ep021_raene_talk_aaaf8492:

    # ra "That sounds rather interesting, to be honest."
    ra "说实话，听起来还挺有意思的。"

# game/episode021.rpy:1984
translate simplified_chinese ep021_raene_talk_b3d66b0c:

    # ra "So, you, me and who else?"
    ra "所以，你、我和谁一起？"

# game/episode021.rpy:1985
translate simplified_chinese ep021_raene_talk_353c1065:

    # c "Girl or boy?"
    c "女孩还是男孩？"

# game/episode021.rpy:1986
translate simplified_chinese ep021_raene_talk_3ac026c1:

    # ra "Girl, maybe?"
    ra "也许是个女孩？"

# game/episode021.rpy:1988
translate simplified_chinese ep021_raene_talk_d6a24bd4:

    # ra "We could play with her together."
    ra "我们可以一起和她玩。"

# game/episode021.rpy:1989
translate simplified_chinese ep021_raene_talk_859d2b1c:

    # "The thought made both our cocks twitch in anticipation."
    "这个想法让我们俩的阴茎都因期待而抽动。"

# game/episode021.rpy:1991
translate simplified_chinese ep021_raene_talk_4bb433d3:

    # ra "Or maybe...{w} I don’t know..."
    ra "又或者…{w} 我不知道…"

# game/episode021.rpy:1992
translate simplified_chinese ep021_raene_talk_3251245c:

    # c "Come on, tell me."
    c "快说嘛，告诉我。"

# game/episode021.rpy:1993
translate simplified_chinese ep021_raene_talk_0ab18e54:

    # c "I can feel your erection, you know."
    c "我能感觉到你硬了，你知道的。"

# game/episode021.rpy:1994
translate simplified_chinese ep021_raene_talk_15e9ddf9:

    # c "So you clearly just thought of something you really like."
    c "所以你刚才肯定想到了特别中意的事。"

# game/episode021.rpy:2000
translate simplified_chinese ep021_raene_talk_a569d285:

    # ra "I was just wondering how it would be together with someone from the crew."
    ra "我只是在想象和船员里某个人一起会是什么感觉。"

# game/episode021.rpy:2001
translate simplified_chinese ep021_raene_talk_63cf6104:

    # ra "Eva, Lilly, Aven or Nadya are out of the question of course."
    ra "伊娃、莉莉、艾文或娜迪亚当然不在考虑范围内。"

# game/episode021.rpy:2002
translate simplified_chinese ep021_raene_talk_fdf48eb8:

    # c "Are they?"
    c "真的吗？"

# game/episode021.rpy:2004
translate simplified_chinese ep021_raene_talk_e389e735:

    # ra "Yes, for a threesome with you of course."
    ra "对，如果是和你三人行的话当然不行。"

# game/episode021.rpy:2005
translate simplified_chinese ep021_raene_talk_bb2fc917:

    # c "Because they’re family?"
    c "因为她们算家人？"

# game/episode021.rpy:2006
translate simplified_chinese ep021_raene_talk_ef8cf861:

    # ra "Of course."
    ra "当然。"

# game/episode021.rpy:2007
translate simplified_chinese ep021_raene_talk_b9da787d:

    # c "Like you, I want to approach life with an open mind."
    c "就像你一样，我希望以开放的心态面对生活。"

# game/episode021.rpy:2010
translate simplified_chinese ep021_raene_talk_96e490b2:

    # c "My sisters are beautiful and I won’t deny that I’m sexually attracted to them."
    c "我的姐妹们都很美，我不会否认我对她们有性吸引力。"

# game/episode021.rpy:2012
translate simplified_chinese ep021_raene_talk_8a19ea24:

    # c "My mother and sisters are beautiful and I won’t deny that I’m sexually attracted to them."
    c "我的母亲和姐妹们都很美，我不会否认我对她们有性吸引力。"

# game/episode021.rpy:2014
translate simplified_chinese ep021_raene_talk_5534dd7d:

    # c "My mother and sister are beautiful and I won’t deny that I’m sexually attracted to them."
