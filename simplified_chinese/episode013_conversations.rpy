    # c "And do agree to become my servant, or will you remain in your cell?"
    c "那么你同意成为我的仆人，还是继续留在牢房里？"

# game/episode013_conversations.rpy:1126
translate simplified_chinese ep013_vess_talk_9f27e0a1:

    # ve "What will the others think of me being released out of the brig?"
    ve "其他人会怎么看待我被放出禁闭室？"

# game/episode013_conversations.rpy:1127
translate simplified_chinese ep013_vess_talk_36ca07cb:

    # c "I'll make sure they understand."
    c "我会确保他们明白的。"

# game/episode013_conversations.rpy:1129
translate simplified_chinese ep013_vess_talk_fae4c75b:

    # ve "In that case I agree to become your servant."
    ve "那样的话，我同意成为你的仆人。"

# game/episode013_conversations.rpy:1130
translate simplified_chinese ep013_vess_talk_9696ccb2:

    # c "Good girl."
    c "好姑娘。"

# game/episode013_conversations.rpy:1131
translate simplified_chinese ep013_vess_talk_c48498f2:

    # c "I'll make sure you'll be tagged so we can follow your movements should you decide to escape."
    c "我会确保给你装上追踪器，这样如果你决定逃跑，我们就能追踪你的行踪。"

# game/episode013_conversations.rpy:1132
translate simplified_chinese ep013_vess_talk_141f2d24:

    # c "After that I'll inform everyone of my decision to release you."
    c "之后，我会通知所有人我决定释放你。"

# game/episode013_conversations.rpy:1133
translate simplified_chinese ep013_vess_talk_4187cda3:

    # ve "Thank you."
    ve "谢谢你。"

# game/episode013_conversations.rpy:1134
translate simplified_chinese ep013_vess_talk_1403a5fc:

    # c "While I appreciate gratitude, I think actions speak louder than words."
    c "虽然我欣赏感激之情，但我认为行动胜于雄辩。"

# game/episode013_conversations.rpy:1136
translate simplified_chinese ep013_vess_talk_39d88b4e:

    # "While I spoke those last words, I unzipped my pants and pulled out my cock."
    "说最后这句话时，我拉开裤子拉链，掏出了我的阴茎。"

# game/episode013_conversations.rpy:1137
translate simplified_chinese ep013_vess_talk_1145b0ee:

    # c "Why don't you undress and get on your knees to show me just how grateful you are?"
    c "你何不脱掉衣服，跪下来，让我看看你有多感激？"

# game/episode013_conversations.rpy:1138
translate simplified_chinese ep013_vess_talk_3059843d:

    # "I lowered the barrier separating us and entered her cell."
    "我放下了隔开我们的栅栏，走进了她的牢房。"

# game/episode013_conversations.rpy:1141
translate simplified_chinese ep013_vess_talk_08ab9265:

    # c "In light of your recent actions, I will allow you to live here in the brig."
    c "鉴于你近期的行为，我允许你继续留在禁闭室生活。"

# game/episode013_conversations.rpy:1142
translate simplified_chinese ep013_vess_talk_49349651:

    # c "You will be fed and put to work if necessary."
    c "你会得到食物，必要时也会安排你工作。"

# game/episode013_conversations.rpy:1143
translate simplified_chinese ep013_vess_talk_f00594a7:

    # c "That's all I will allow you."
    c "这就是我所能允许的全部了。"

# game/episode013_conversations.rpy:1145
translate simplified_chinese ep013_vess_talk_a3172e75:

    # ve "I understand."
    ve "我明白。"

# game/episode013_conversations.rpy:1146
translate simplified_chinese ep013_vess_talk_b62c291a:

    # ve "Thank you, [p_name]."
    ve "谢谢你，[p_name]。"

# game/episode013_conversations.rpy:1148
translate simplified_chinese ep013_vess_talk_0731b314:

    # c "That was a brave thing you did, dangerous too."
    c "你做的这件事很勇敢，也很危险。"

# game/episode013_conversations.rpy:1150
translate simplified_chinese ep013_vess_talk_39d41770:

    # ve "I know."
    ve "我知道。"

# game/episode013_conversations.rpy:1151
translate simplified_chinese ep013_vess_talk_6a44d004:

    # c "Why did you do it?"
    c "你为什么要这么做？"

# game/episode013_conversations.rpy:1153
translate simplified_chinese ep013_vess_talk_6c6e95df:

    # ve "Because I was part of the reason why you ended up there."
    ve "因为你会落到那个境地，我也有部分责任。"

# game/episode013_conversations.rpy:1154
translate simplified_chinese ep013_vess_talk_af30b11b:

    # ve "And I couldn't bear to lose you."
    ve "而且我无法承受失去你。"

# game/episode013_conversations.rpy:1155
translate simplified_chinese ep013_vess_talk_4a879de2:

    # c "I can understand you feel guilty and-"
    c "我能理解你感到内疚，而且——"

# game/episode013_conversations.rpy:1156
translate simplified_chinese ep013_vess_talk_cd8355b2:

    # ve "It's not just guilt."
    ve "不只是内疚。"

# game/episode013_conversations.rpy:1158
translate simplified_chinese ep013_vess_talk_7e5716b2:

    # ve "The thought of losing you, it...{w} it breaks my heart."
    ve "一想到会失去你，这……{w}这让我心碎。"

# game/episode013_conversations.rpy:1159
translate simplified_chinese ep013_vess_talk_dc83ae0f:

    # ve "I love you [p_name]."
    ve "我爱你，[p_name]。"

# game/episode013_conversations.rpy:1160
translate simplified_chinese ep013_vess_talk_2ebfb460:

    # ve "I know my love is hopeless, considering my betrayal and your opinion of me, but I just love you with all my heart."
    ve "我知道我的爱毫无希望，考虑到我的背叛和你对我的看法，但我就是全心全意地爱着你。"

# game/episode013_conversations.rpy:1164
translate simplified_chinese ep013_vess_talk_785cd473:

    # c "I love you too, Vess."
    c "我也爱你，薇丝。"

# game/episode013_conversations.rpy:1165
translate simplified_chinese ep013_vess_talk_cb3bbe43:

    # c "I think you're a wonderful person."
    c "我觉得你是个很好的人。"

# game/episode013_conversations.rpy:1169
translate simplified_chinese ep013_vess_talk_0ce2b6c2:

    # c "So I'll ask the rest of the crew if they agree to release you."
    c "所以我会去问问其他船员是否同意释放你。"

# game/episode013_conversations.rpy:1170
translate simplified_chinese ep013_vess_talk_0a1355c7:

    # c "Our trust might not be completely repaired, but I believe you're a good person."
    c "我们的信任或许无法完全修复，但我相信你是个好人。"

# game/episode013_conversations.rpy:1172
translate simplified_chinese ep013_vess_talk_f469b23c:

    # ve "You would do that for me?"
    ve "你会为我这么做？"

# game/episode013_conversations.rpy:1173
translate simplified_chinese ep013_vess_talk_bfb64358:

    # c "Yes, I will."
    c "是的，我会的。"

# game/episode013_conversations.rpy:1174
translate simplified_chinese ep013_vess_talk_2ad22dbd:

    # c "I'm not saying I'll be able to trust you completely, because it will take time."
    c "我不是说我就能完全信任你，因为这需要时间。"

# game/episode013_conversations.rpy:1175
translate simplified_chinese ep013_vess_talk_9707ad52:

    # c "But I'm willing to give you a second chance."
    c "但我愿意给你第二次机会。"

# game/episode013_conversations.rpy:1177
translate simplified_chinese ep013_vess_talk_9bc908ee:

    # ve "Oh [p_name], you don't know how happy that makes me feel!"
    ve "哦，[p_name]，你不知道这让我感到多么幸福！"

# game/episode013_conversations.rpy:1178
translate simplified_chinese ep013_vess_talk_b762fc92:

    # ve "Am I...{w} Am I allowed to kiss you?"
    ve "我...{w}我可以吻你吗？"

# game/episode013_conversations.rpy:1179
translate simplified_chinese ep013_vess_talk_3059843d_1:

    # "I lowered the barrier separating us and entered her cell."
    "我降下隔开我们的屏障，走进了她的牢房。"

# game/episode013_conversations.rpy:1181
translate simplified_chinese ep013_vess_talk_0a7b536c:

    # "Vess took a hesitant step forward and smiled as I opened my arms for an embrace."
    "当我张开双臂准备拥抱时，薇丝犹豫地向前迈了一步，露出了微笑。"

# game/episode013_conversations.rpy:1182
translate simplified_chinese ep013_vess_talk_27c88cef:

    # "Our kiss was hesitant at first, but that feeling soon melted away."
    "起初我们的吻有些犹豫，但那种感觉很快就消融了。"

# game/episode013_conversations.rpy:1184
translate simplified_chinese ep013_vess_talk_67bbfd98:

    # ve "Thank you, [p_name_short], I won't disappoint you."
    ve "谢谢你，[p_name_short]，我不会让你失望的。"

# game/episode013_conversations.rpy:1186
translate simplified_chinese ep013_vess_talk_95064e35:

    # c "But your betrayal has damaged my trust in you so profoundly."
    c "但你的背叛已经深深地损害了我对你的信任。"

# game/episode013_conversations.rpy:1187
translate simplified_chinese ep013_vess_talk_c28e3fbd:

    # c "It might be repairable, I don't know."
    c "或许还能修复，我不确定。"

# game/episode013_conversations.rpy:1188
translate simplified_chinese ep013_vess_talk_3cce8114:

    # c "I'm sure you understand you need to remain in the brig for the foreseeable future."
    c "我想你明白，在可预见的未来里，你必须继续待在禁闭室。"

# game/episode013_conversations.rpy:1189
translate simplified_chinese ep013_vess_talk_faf5fdf8:

    # c "In time, the crew and I may accept you back, but it's going to be a long process."
    c "假以时日，我和船员们或许会重新接纳你，但这会是个漫长的过程。"

# game/episode013_conversations.rpy:1191
translate simplified_chinese ep013_vess_talk_89ab9cb4:

    # ve "I understand, thank you [p_name]."
    ve "我明白，谢谢你，[p_name]。"

# game/episode013_conversations.rpy:1192
translate simplified_chinese ep013_vess_talk_bf5d458e:

    # c "I'll make sure you get some things to make your stay here in the brig a little more comfortable."
    c "我会确保给你弄些东西来，让你在禁闭室的日子稍微好过一点。"

# game/episode013_conversations.rpy:1194
translate simplified_chinese ep013_vess_talk_b62c291a_1:

    # ve "Thank you, [p_name]."
    ve "谢谢你，[p_name]。"

# game/episode013_conversations.rpy:1196
translate simplified_chinese ep013_vess_talk_477d11a0:

    # ve "I know my situation is hopeless, but I want to be useful in any way possible."
    ve "我知道我的处境毫无希望，但我希望能以任何可能的方式派上用场。"

# game/episode013_conversations.rpy:1197
translate simplified_chinese ep013_vess_talk_1cbeffd7:

    # ve "If that means risking my life, I have no problem with that."
    ve "如果这意味着要冒生命危险，我也没有任何问题。"

# game/episode013_conversations.rpy:1198
translate simplified_chinese ep013_vess_talk_bcef7244:

    # c "Thank you for your honesty and your bravery."
    c "感谢你的坦诚和勇敢。"

# game/episode013_conversations.rpy:1199
translate simplified_chinese ep013_vess_talk_043e8561:

    # c "I'm sure you understand you need to remain in the brig for the foreseeable future, but actions like these do repair some of the trust that has been lost."
    c "我确信你明白，在可预见的未来里，你需要继续待在禁闭室，但这样的行为确实能修复一些已经失去的信任。"

# game/episode013_conversations.rpy:1200
translate simplified_chinese ep013_vess_talk_faf5fdf8_1:

    # c "In time, the crew and I may accept you back, but it's going to be a long process."
    c "假以时日，我和船员们或许会重新接纳你，但这将是个漫长的过程。"

# game/episode013_conversations.rpy:1202
translate simplified_chinese ep013_vess_talk_89ab9cb4_1:

    # ve "I understand, thank you [p_name]."
    ve "我明白，谢谢你[p_name]。"

# game/episode013_conversations.rpy:1203
translate simplified_chinese ep013_vess_talk_bf5d458e_1:

    # c "I'll make sure you get some things to make your stay here in the brig a little more comfortable."
    c "我会确保你得到一些东西，让你在禁闭室的日子稍微舒服些。"

# game/episode013_conversations.rpy:1204
translate simplified_chinese ep013_vess_talk_b62c291a_2:

    # ve "Thank you, [p_name]."
    ve "谢谢你，[p_name]。"

