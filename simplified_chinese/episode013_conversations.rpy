# game/episode013_conversations.rpy:111
translate simplified_chinese ep013_aven_talk_698241b0:

    # "Although avoiding each other on a small ship like the Bastard was quite hard, Aven seemed to have managed well so far in the past few hours."
    "尽管在像\"私生子\"号这样的小飞船上互相回避相当困难，但艾文似乎在过去几小时里处理得很好。"

# game/episode013_conversations.rpy:112
translate simplified_chinese ep013_aven_talk_762a3e41:

    # "I knew she was inside her quarters, so I decided to take my chances."
    "我知道她在自己房间里，所以我决定碰碰运气。"

# game/episode013_conversations.rpy:113
translate simplified_chinese ep013_aven_talk_d53e1cb3:

    # c "May I come in?"
    c "我能进来吗？"

# game/episode013_conversations.rpy:115
translate simplified_chinese ep013_aven_talk_82658b06:

    # "It took a while for Aven to respond and just when I feared she was about to ignore me, the door opened."
    "艾文过了一会才回应，就在我担心她要无视我的时候，门开了。"

# game/episode013_conversations.rpy:116
translate simplified_chinese ep013_aven_talk_01dfb707:

    # av "Hey."
    av "嘿。"

# game/episode013_conversations.rpy:119
translate simplified_chinese ep013_aven_talk_03d90d69:

    # "She accepted my embrace, but I could tell she was tense."
    "她接受了我的拥抱，但我能感觉到她很紧张。"

# game/episode013_conversations.rpy:121
translate simplified_chinese ep013_aven_talk_ba1423cc:

    # av "I'm so glad you're alright."
    av "我很高兴你没事。"

# game/episode013_conversations.rpy:123
translate simplified_chinese ep013_aven_talk_b8b0ba58:

    # "Before I was able to kiss her, Aven took a step back."
    "在我能亲吻她之前，艾文后退了一步。"

# game/episode013_conversations.rpy:124
translate simplified_chinese ep013_aven_talk_53bc788a:

    # c "Is everything okay, Aven?"
    c "一切都还好吗，艾文？"

# game/episode013_conversations.rpy:126
translate simplified_chinese ep013_aven_talk_c3d5af8b:

    # av "What do you think?!"
    av "你觉得呢？！"

# game/episode013_conversations.rpy:129
translate simplified_chinese ep013_aven_talk_bec24981:

    # av "I thought I'd lost you!"
    av "我以为我失去你了！"

# game/episode013_conversations.rpy:131
translate simplified_chinese ep013_aven_talk_89e0e9cd:

    # "Aven just stood there, utterly forlorn."
    "艾文只是站在那里，完全陷入了绝望。"

# game/episode013_conversations.rpy:133
translate simplified_chinese ep013_aven_talk_c3c34a33:

    # "I stepped forward and she allowed me to wrap my arms around her."
    "我向前迈了一步，她允许我张开双臂拥抱她。"

# game/episode013_conversations.rpy:134
translate simplified_chinese ep013_aven_talk_4baf0467:

    # av "I've missed you so much!"
    av "我好想你！"

# game/episode013_conversations.rpy:135
translate simplified_chinese ep013_aven_talk_c56f81c1:

    # av "Promise me you'll never leave me."
    av "答应我你永远不会离开我。"

# game/episode013_conversations.rpy:136
translate simplified_chinese ep013_aven_talk_a44ccf78:

    # c "I promise."
    c "我保证。"

# game/episode013_conversations.rpy:138
translate simplified_chinese ep013_aven_talk_a563210f:

    # "The kiss we shared had a profoundness I'd never felt so deeply before."
    "我们分享的这个吻带着我从未如此深切感受过的深刻。"

# game/episode013_conversations.rpy:139
translate simplified_chinese ep013_aven_talk_266b3a8b:

    # c "I love you, Aven."
    c "我爱你，艾文。"

# game/episode013_conversations.rpy:140
translate simplified_chinese ep013_aven_talk_ae8ce223:

    # av "I love you too, [p_name]."
    av "我也爱你，[p_name]。"

# game/episode013_conversations.rpy:143
translate simplified_chinese ep013_aven_talk_32eb4148:

    # av "We thought we'd lost you!"
    av "我们都以为失去你了！"

# game/episode013_conversations.rpy:145
translate simplified_chinese ep013_aven_talk_ba1423cc_1:

    # av "I'm so glad you're alright."
    av "我真高兴你没事。"

# game/episode013_conversations.rpy:146
translate simplified_chinese ep013_aven_talk_85cfa00b:

    # c "Me too, I'm not planning on playing bait for some hostile alien race again."
    c "我也是，我可不想再给某个敌对的外星种族当诱饵了。"

# game/episode013_conversations.rpy:147
translate simplified_chinese ep013_aven_talk_d97f6ab4:

    # av "I think that's a healthy resolution."
    av "我觉得这是个明智的决定。"

# game/episode013_conversations.rpy:149
translate simplified_chinese ep013_aven_talk_a0b2bd50:

    # av "I'm hoping Nadya will find out more about those Scolguin."
    av "我希望娜迪亚能查出更多关于那些斯科尔金人的信息。"

# game/episode013_conversations.rpy:150
translate simplified_chinese ep013_aven_talk_dacc6add:

    # c "Yes, I believe she's hit the books already."
    c "是的，我相信她已经埋头研究资料了。"

# game/episode013_conversations.rpy:152
translate simplified_chinese ep013_aven_talk_08aecf69:

    # av "My mom lied to me all these years!"
    av "这些年来我妈妈一直在骗我！"

# game/episode013_conversations.rpy:153
translate simplified_chinese ep013_aven_talk_e6da9dd6:

    # av "I suddenly have two younger sisters now?!"
    av "我突然间有了两个妹妹？！"

# game/episode013_conversations.rpy:155
translate simplified_chinese ep013_aven_talk_80135df9:

    # av "And my slightly older cousin is in fact my brother, whom I’ve fallen in love with."
    av "而我那个比我稍大的表兄其实是我哥哥，我还爱上了他。"

# game/episode013_conversations.rpy:157
translate simplified_chinese ep013_aven_talk_33a876e1:

    # av "So no, nothing is okay."
    av "所以不，一点都不好。"

# game/episode013_conversations.rpy:158
translate simplified_chinese ep013_aven_talk_0df55df0:

    # c "Sorry I wasn’t there for you."
    c "抱歉我没能在你身边。"

# game/episode013_conversations.rpy:159
translate simplified_chinese ep013_aven_talk_49f5a23c:

    # av "I don’t blame you, or anything."
    av "我没有责怪你，或者其他什么。"

# game/episode013_conversations.rpy:162
translate simplified_chinese ep013_aven_talk_43397105:

    # av "And my slightly older cousin is in fact my brother, estranged for many years."
    av "而且我那位稍年长的表兄实际上是我哥哥，多年来一直疏远。"

# game/episode013_conversations.rpy:163
translate simplified_chinese ep013_aven_talk_de6cdbf9:

    # c "It must have been hard for you to hear."
    c "这对你来说一定很难接受。"

# game/episode013_conversations.rpy:164
translate simplified_chinese ep013_aven_talk_f9d67b7d:

    # av "It was."
    av "确实如此。"

# game/episode013_conversations.rpy:165
translate simplified_chinese ep013_aven_talk_208fa4d4:

    # av "Hell, I’m not even sure I can blame mom."
    av "天啊，我甚至不确定该不该责怪妈妈。"

# game/episode013_conversations.rpy:166
translate simplified_chinese ep013_aven_talk_783f4713:

    # av "The shit she must have gone through..."
    av "她肯定经历了那么多苦难…"

# game/episode013_conversations.rpy:167
translate simplified_chinese ep013_aven_talk_89e0e9cd_1:

    # "Aven just stood there, utterly forlorn."
    "艾文只是站在那里，完全不知所措。"

# game/episode013_conversations.rpy:169
translate simplified_chinese ep013_aven_talk_244186db:

    # "I took a hesitant step towards her, but she inched back."
    "我犹豫地朝她走了一步，但她却微微后退。"

# game/episode013_conversations.rpy:170
translate simplified_chinese ep013_aven_talk_c74505e2:

    # c "What’s the matter?"
    c "怎么了？"

# game/episode013_conversations.rpy:172
translate simplified_chinese ep013_aven_talk_022e96ee:

    # av "I can’t...{w} You’re my brother."
    av "我不能…{w} 你是我哥哥。"

# game/episode013_conversations.rpy:173
translate simplified_chinese ep013_aven_talk_fb853be6:

    # c "So?"
    c "所以呢？"

# game/episode013_conversations.rpy:174
translate simplified_chinese ep013_aven_talk_9262c02f:

    # av "Everything has changed, don’t you get that?!"
    av "一切都变了，你难道不明白吗？！"

# game/episode013_conversations.rpy:175
translate simplified_chinese ep013_aven_talk_44733998:

    # c "I’m not denying that a lot has changed, but I still love you."
    c "我不否认很多事情都变了，但我依然爱你。"

# game/episode013_conversations.rpy:176
translate simplified_chinese ep013_aven_talk_c558ae36:

    # c "And I do recall you saying you loved me too, just minutes ago."
    c "而且我记得你几分钟前也说过爱我。"

# game/episode013_conversations.rpy:178
translate simplified_chinese ep013_aven_talk_345f6e48:

    # av "But [p_name_short], you’re my brother!"
    av "但是[p_name_short]，你是我哥哥！"

# game/episode013_conversations.rpy:179
translate simplified_chinese ep013_aven_talk_84b299b0:

    # c "Yes, and you’re my beautiful sister, I don’t see how that changes things, other than in the eyes of other people."
    c "没错，而你是我美丽的妹妹，我不觉得这有什么改变，除了在别人眼里。"

# game/episode013_conversations.rpy:180
translate simplified_chinese ep013_aven_talk_0c989adc:

    # c "We were cousins when we started our relationship and we decided not to care."
    c "我们开始这段关系时是表兄妹，当时我们决定不在乎。"

# game/episode013_conversations.rpy:181
translate simplified_chinese ep013_aven_talk_16a5e5bf:

    # c "Now we know we’re even closer and I decide not to care."
    c "现在我们知道关系更亲密了，而我决定不在乎。"

# game/episode013_conversations.rpy:182
translate simplified_chinese ep013_aven_talk_625e5ec8:

    # c "I only care about you."
    c "我只在乎你。"

# game/episode013_conversations.rpy:183
translate simplified_chinese ep013_aven_talk_81ecb9ce:

    # av "I..."
    av "我…"

# game/episode013_conversations.rpy:185
translate simplified_chinese ep013_aven_talk_846b3a8a:

    # "Aven started crying at that point and allowed me to wrap my arms around her."
    "艾文在那一刻开始哭泣，任由我伸出双臂环抱住她。"

# game/episode013_conversations.rpy:186
translate simplified_chinese ep013_aven_talk_05bdbd82:

    # av "I’m so confused."
    av "我好困惑。"

# game/episode013_conversations.rpy:188
translate simplified_chinese ep013_aven_talk_e53a03a1:

    # av "I thought I had one certainty in my life and that was you."
    av "我以为我生命中唯一确定的事就是你。"

# game/episode013_conversations.rpy:189
translate simplified_chinese ep013_aven_talk_8672d1f9:

    # av "But when mom told us everything, it was like if the ground was swept from beneath my feet."
    av "但当妈妈告诉我们一切时，就好像脚下的地面突然被抽走了。"

# game/episode013_conversations.rpy:190
translate simplified_chinese ep013_aven_talk_1f3ef93b:

    # av "It was as if all the comfort I’d found in our relationship had suddenly gone."
    av "就好像我在我们关系中找到的所有慰藉都突然消失了。"

# game/episode013_conversations.rpy:191
translate simplified_chinese ep013_aven_talk_c6818597:

    # av "You were away and I felt so alone."
    av "你不在身边，我感觉如此孤独。"

# game/episode013_conversations.rpy:192
translate simplified_chinese ep013_aven_talk_b0376e69:

    # av "And then Jade messaged us you were taken by the Sovereignty."
    av "然后杰德发来消息说你被\"至高权域\"抓走了。"

# game/episode013_conversations.rpy:194
translate simplified_chinese ep013_aven_talk_f6b8ad2e:

    # av "Promise me you’ll never leave me?"
    av "答应我你永远不会离开我？"

# game/episode013_conversations.rpy:195
translate simplified_chinese ep013_aven_talk_a44ccf78_1:

    # c "I promise."
    c "我保证。"

# game/episode013_conversations.rpy:196
translate simplified_chinese ep013_aven_talk_252989ed:

    # "Aven’s story had come with ragged sobs, but those words seemed to have a calming effect on her."
    "艾文讲述时伴随着断断续续的抽泣，但那些话语似乎对她产生了安抚作用。"

# game/episode013_conversations.rpy:197
translate simplified_chinese ep013_aven_talk_e51d85c1:

    # c "I love you Aven."
    c "我爱你，艾文。"

# game/episode013_conversations.rpy:199
translate simplified_chinese ep013_aven_talk_ae8ce223_1:

    # av "I love you too, [p_name]."
    av "我也爱你，[p_name]。"

# game/episode013_conversations.rpy:200
translate simplified_chinese ep013_aven_talk_b38ba6bf:

    # "She looked up at me and I saw the love in her eyes, the love that had never left."
    "她抬头看着我，我在她眼中看到了那份从未消逝的爱意。"

# game/episode013_conversations.rpy:202
translate simplified_chinese ep013_aven_talk_fd8733ef:

    # "The kiss we exchanged had the same profound familiarity as before, something Aven seemed to notice too."
    "我们交换的亲吻带着与往日相同的深切熟悉感，艾文似乎也察觉到了这一点。"

# game/episode013_conversations.rpy:203
translate simplified_chinese ep013_aven_talk_25b5510b:

    # av "That felt so right."
    av "这种感觉如此自然。"

# game/episode013_conversations.rpy:204
translate simplified_chinese ep013_aven_talk_bb78aab7:

    # c "I know."
    c "我知道。"

# game/episode013_conversations.rpy:207
translate simplified_chinese ep013_aven_talk_f901418b:

    # "I took a hesitant step towards her and she accepted my embrace."
    "我犹豫着向她迈出一步，她接受了我的拥抱。"

# game/episode013_conversations.rpy:208
translate simplified_chinese ep013_aven_talk_02e828ce:

    # c "Let’s make a fresh start together."
    c "让我们重新开始吧。"

# game/episode013_conversations.rpy:209
translate simplified_chinese ep013_aven_talk_93469dbc:

    # c "We were inseparable as cousins once, being brother and sister should only strengthen that bond."
    c "我们曾是形影不离的表亲，成为兄妹只会让这份羁绊更加牢固。"

# game/episode013_conversations.rpy:210
translate simplified_chinese ep013_aven_talk_41327d84:

    # av "I’d like that, [p_name_short], I’d like that very much."
    av "我很愿意，[p_name_short]，我非常愿意。"

# game/episode013_conversations.rpy:211
translate simplified_chinese ep013_aven_talk_c00f4100:

    # "We remained locked in that embrace for quite a while, relishing in our growing familiarity."
    "我们紧紧相拥了好一阵子，沉醉在逐渐恢复的亲密感中。"

# game/episode013_conversations.rpy:220
translate simplified_chinese ep013_lilly_talk_93db4a2f:

    # "Despite Eva's claim that Lilly had spent a lot of time beside my bed, I hadn't seen her since I'd awakened."
    "尽管伊娃声称莉莉曾长时间守在我床边，但我醒来后一直没见到她。"

# game/episode013_conversations.rpy:221
translate simplified_chinese ep013_lilly_talk_589e0258:

    # "When I knocked on her door, there was no answer."
    "当我敲她的门时，里面没有回应。"

# game/episode013_conversations.rpy:222
translate simplified_chinese ep013_lilly_talk_5d780078:

    # c "Lilly, can I come in?"
    c "莉莉，我能进来吗？"

# game/episode013_conversations.rpy:223
translate simplified_chinese ep013_lilly_talk_aa5f589f:

    # l "Go away!"
    l "走开！"

# game/episode013_conversations.rpy:224
translate simplified_chinese ep013_lilly_talk_7a3c0f40:

    # c "I just want to talk."
    c "我只是想谈谈。"

# game/episode013_conversations.rpy:225
translate simplified_chinese ep013_lilly_talk_4d0160f6:

    # "A little bewildered, I waited in front of the door."
    "我有些困惑地等在门前。"

# game/episode013_conversations.rpy:227
translate simplified_chinese ep013_lilly_talk_a4dfcbe9:

    # "Just when I thought Lilly wasn't going to answer anymore, the door cracked open."
    "就在我以为莉莉不会再回应时，门吱呀一声开了条缝。"

# game/episode013_conversations.rpy:230
translate simplified_chinese ep013_lilly_talk_dd296d8a:

    # l "What?!"
    l "干嘛？！"

# game/episode013_conversations.rpy:231
translate simplified_chinese ep013_lilly_talk_301aef01:

    # c "I thought you'd be happy to see me."
    c "我以为你见到我会高兴。"

# game/episode013_conversations.rpy:232
translate simplified_chinese ep013_lilly_talk_d66d3b77:

    # c "Eva said-"
    c "伊娃说—"

# game/episode013_conversations.rpy:234
translate simplified_chinese ep013_lilly_talk_d5bc8897:

    # l "I've come to realize that lying seems to be a family trait."
    l "我已经意识到撒谎似乎是你们家族的特质。"

# game/episode013_conversations.rpy:236
translate simplified_chinese ep013_lilly_talk_8a43ec73:

    # l "I've come to realize that lying seems to be something natural for you."
    l "我已经意识到撒谎对你来说似乎是家常便饭。"

# game/episode013_conversations.rpy:237
translate simplified_chinese ep013_lilly_talk_975a0f54:

    # l "So I'm glad you're okay, I just can't listen to your bullshit."
    l "所以我很高兴你没事，只是我实在听不进你的鬼话。"

# game/episode013_conversations.rpy:238
translate simplified_chinese ep013_lilly_talk_a6cfdf0f:

    # c "Bullshit?"
    c "鬼话？"

# game/episode013_conversations.rpy:239
translate simplified_chinese ep013_lilly_talk_5488f2a1:

    # l "Yes, bullshit."
    l "对，就是鬼话。"

# game/episode013_conversations.rpy:241
translate simplified_chinese ep013_lilly_talk_bad9ade2:

    # "She opened the door more fully and looked at me defiantly."
    "她把门开得更大了些，挑衅地看着我。"

# game/episode013_conversations.rpy:242
translate simplified_chinese ep013_lilly_talk_fa555b42:

    # l "I always knew you had a way with words, I just shouldn't have fallen for your sweet talk."
    l "我一直都知道你巧舌如簧，只是我不该被你的甜言蜜语迷惑。"

# game/episode013_conversations.rpy:244
translate simplified_chinese ep013_lilly_talk_c754661d:

    # l "How could you, [p_name_short], she's my best friend!"
    l "你怎么能这样，[p_name_short]，她可是我最好的朋友！"

# game/episode013_conversations.rpy:245
translate simplified_chinese ep013_lilly_talk_fd9a9835:

    # "Lilly turned around with tears in her eyes and walked back into her room."
    "莉莉转过身，眼里含着泪水走回了自己的房间。"

# game/episode013_conversations.rpy:247
translate simplified_chinese ep013_lilly_talk_5b245953:

    # "She'd left the door open, so I dared to go after her."
    "她没关门，所以我壮着胆子跟了进去。"

# game/episode013_conversations.rpy:248
translate simplified_chinese ep013_lilly_talk_afccd70b:

    # c "Please allow me to explain."
    c "请让我解释一下。"

# game/episode013_conversations.rpy:250
translate simplified_chinese ep013_lilly_talk_ba12594f:

    # l "What's there to explain?!"
    l "还有什么可解释的？！"

# game/episode013_conversations.rpy:251
translate simplified_chinese ep013_lilly_talk_cead3635:

    # l "While I gave up everything for you, you went behind my back and seduced Céline!"
    l "就在我为你放弃一切的时候，你却在背后勾引了瑟琳！"

# game/episode013_conversations.rpy:252
translate simplified_chinese ep013_lilly_talk_a824eb31:

    # l "She confessed everything when we were all worried sick about you."
    l "在我们都为你担心得要命的时候，她向我坦白了一切。"

# game/episode013_conversations.rpy:254
translate simplified_chinese ep013_lilly_talk_8abd8990:

    # l "Do you realize how that made me feel, my best friend confiding in me that she loves you?!"
    l "你明白那让我作何感受吗？我最好的朋友告诉我她爱你？！"

# game/episode013_conversations.rpy:256
translate simplified_chinese ep013_lilly_talk_b33e376f:

    # l "I was too confused to say anything to her after that."
    l "在那之后我太困惑了，什么也没对她说。"

# game/episode013_conversations.rpy:258
translate simplified_chinese ep013_lilly_talk_7a53483f:

    # l "Do you know how many sleepless nights I had to endure to overcome that feeling of wrongness and finally accept my love for you."
    l "你知道我熬过了多少个不眠之夜，才克服那种错乱感，最终接受了对你的爱。"

# game/episode013_conversations.rpy:259
translate simplified_chinese ep013_lilly_talk_6a227785:

    # l "And all the while you were sharing Céline's bed..."
    l "而这段时间里你一直和瑟琳同床共枕…"

# game/episode013_conversations.rpy:260
translate simplified_chinese ep013_lilly_talk_e73799ca:

    # c "I know I fucked up."
    c "我知道我搞砸了。"

# game/episode013_conversations.rpy:261
translate simplified_chinese ep013_lilly_talk_65aad098:

    # c "I'm sorry, Lilly."
    c "对不起，莉莉。"

# game/episode013_conversations.rpy:263
translate simplified_chinese ep013_lilly_talk_a38396a9:

    # l "That's it?{w} You're sorry?"
    l "就这样？{w}一句对不起就完了？"

# game/episode013_conversations.rpy:264
translate simplified_chinese ep013_lilly_talk_f5f4cdd6:

    # c "I can explain myself, if you want, but I'm not sure if that makes things better."
    c "如果你想听，我可以解释，但我不确定这能否让事情好转。"

# game/episode013_conversations.rpy:265
translate simplified_chinese ep013_lilly_talk_fde56063:

    # c "Céline and I were a thing, even back at the academy."
    c "瑟琳和我早就是一对，甚至在学院时期就是。"

# game/episode013_conversations.rpy:267
translate simplified_chinese ep013_lilly_talk_49dff4c1:

    # c "Before everything that has happened, I'd never dreamed I'd fall in love with my own sister."
    c "在这一切发生之前，我从未想过会爱上自己的妹妹。"

# game/episode013_conversations.rpy:269
translate simplified_chinese ep013_lilly_talk_48b316ed:

    # c "Before everything that has happened, I'd never dreamed I'd fall in love with you."
    c "在这一切发生之前，我从未想过会爱上你。"

# game/episode013_conversations.rpy:270
translate simplified_chinese ep013_lilly_talk_e28bad57:

    # c "The ConVitæ simulation we were all subjected to changed everything."
    c "我们所有人都经历过的康维泰模拟改变了一切。"

# game/episode013_conversations.rpy:271
translate simplified_chinese ep013_lilly_talk_d7a9d459:

    # c "By then, Céline and I were in a relationship already."
    c "那时，瑟琳和我已经在一起了。"

# game/episode013_conversations.rpy:272
translate simplified_chinese ep013_lilly_talk_c7dc03ce:

    # c "I was just as confused as you were, you have to believe that."
    c "我和你一样困惑，你一定要相信这一点。"

# game/episode013_conversations.rpy:274
translate simplified_chinese ep013_lilly_talk_e428e768:

    # c "Falling in love with your own sister, I mean, the taboo surrounding our love is reason alone to be confused."
    c "爱上自己的妹妹，我是说，围绕我们爱情的禁忌本身就足以让人困惑。"

# game/episode013_conversations.rpy:275
translate simplified_chinese ep013_lilly_talk_f35e62e1:

    # c "So I panicked and not telling you or Céline became easier than confronting the situation."
    c "所以我慌了，不告诉你或瑟琳比面对这个状况要容易得多。"

# game/episode013_conversations.rpy:277
translate simplified_chinese ep013_lilly_talk_6df3e4f4:

    # l "Céline isn't aware either?"
    l "瑟琳也不知道吗？"

# game/episode013_conversations.rpy:279
translate simplified_chinese ep013_lilly_talk_93506557:

    # c "She knows there are others, but that's all."
    c "她知道还有别人，但仅此而已。"

# game/episode013_conversations.rpy:281
translate simplified_chinese ep013_lilly_talk_bdd0bff8:

    # c "No, she isn't."
    c "不，她不知道。"

# game/episode013_conversations.rpy:283
translate simplified_chinese ep013_lilly_talk_ee5be636:

    # l "Do you...{w} love her?"
    l "你…{w}爱她吗？"

# game/episode013_conversations.rpy:287
translate simplified_chinese ep013_lilly_talk_8a29e1eb:

    # c "Yes, I do."
    c "是的，我爱她。"

# game/episode013_conversations.rpy:289
translate simplified_chinese ep013_lilly_talk_b1fe9428:

    # l "Thank you for your honesty.{w} Finally."
    l "谢谢你的诚实。{w}终于。"

# game/episode013_conversations.rpy:290
translate simplified_chinese ep013_lilly_talk_6e61fa05:

    # c "However, my love for you is something more special."
    c "但是，我对你的爱更加特别。"

# game/episode013_conversations.rpy:291
translate simplified_chinese ep013_lilly_talk_d82fb6c3:

    # c "You complete me, Lilly, like a sister and a lover."
    c "你让我完整，莉莉，既是姐妹又是爱人。"

# game/episode013_conversations.rpy:292
translate simplified_chinese ep013_lilly_talk_bc99d2a2:

    # c "That's something Céline, or any other girl like her will never be able to do. "
    c "这是瑟琳，或者其他像她那样的女孩永远无法做到的。 "

# game/episode013_conversations.rpy:294
translate simplified_chinese ep013_lilly_talk_bb7488c9:

    # "Lilly stared at me, her lip trembling."
    "莉莉凝视着我，嘴唇微微颤抖。"

# game/episode013_conversations.rpy:295
translate simplified_chinese ep013_lilly_talk_265e408a:

    # l "I really want to believe you."
    l "我真的很想相信你。"

# game/episode013_conversations.rpy:297
translate simplified_chinese ep013_lilly_talk_5f3042ba:

    # l "But are you saying I have to accept that you share a bed with Céline as well?"
    l "但你是说我必须接受你和瑟琳也同床共枕吗？"

# game/episode013_conversations.rpy:301
translate simplified_chinese ep013_lilly_talk_2ec66c7d:

    # c "No, because I'm going to break up with her."
    c "不，因为我打算和她分手。"

# game/episode013_conversations.rpy:302
translate simplified_chinese ep013_lilly_talk_186a948f:

    # c "You're the only one for me."
    c "你才是我唯一的选择。"

# game/episode013_conversations.rpy:304
translate simplified_chinese ep013_lilly_talk_4669c29c:

    # l "I haven't even said if I still want to be with you."
    l "我甚至还没说是否还想和你在一起。"

# game/episode013_conversations.rpy:305
translate simplified_chinese ep013_lilly_talk_d098608f:

    # c "I don't care, it's the right choice and only fair to the both of you."
    c "我不在乎，这是正确的选择，对你们俩都公平。"

# game/episode013_conversations.rpy:307
translate simplified_chinese ep013_lilly_talk_86b157a7:

    # "I could tell there was some relief in Lilly's eyes."
    "我能看出莉莉眼中闪过一丝释然。"

# game/episode013_conversations.rpy:308
translate simplified_chinese ep013_lilly_talk_36d5bdd4:

    # "Whether it would be enough I didn't know, but it was all I could do."
    "这能否足够挽回，我不得而知，但这是我所能做的一切。"

# game/episode013_conversations.rpy:309
translate simplified_chinese ep013_lilly_talk_5353ac80:

    # c "I'll leave you be for now, but I hope you can find it in your heart to forgive me."
    c "我现在先离开，但我希望你能发自内心地原谅我。"

# game/episode013_conversations.rpy:310
translate simplified_chinese ep013_lilly_talk_c9e6a8a8:

    # "I left Lilly in a state of confusion, hoping it would all turn out for the best."
    "我让莉莉带着困惑离开，希望最终一切都会好起来。"

# game/episode013_conversations.rpy:312
translate simplified_chinese ep013_lilly_talk_ff60203c:

    # c "I can't change who I am and I love you both."
    c "我无法改变自己的本性，我同时爱着你们两个人。"

# game/episode013_conversations.rpy:313
translate simplified_chinese ep013_lilly_talk_5380c9f8:

    # c "I know it's an enormous thing to ask you to accept that I will continue to love both of you, but I'll ask it nonetheless."
    c "我知道要求你接受我会继续爱你们两人是件很过分的事，但我还是要提出这个请求。"

# game/episode013_conversations.rpy:314
translate simplified_chinese ep013_lilly_talk_2b109f94:

    # c "Whatever answer you'll give me, I'll love and respect you forever."
    c "无论你给我什么答案，我都会永远爱你、尊重你。"

# game/episode013_conversations.rpy:315
translate simplified_chinese ep013_lilly_talk_fe3610a5:

    # "Doubt filled Lilly's eyes as she contemplated my request."
    "莉莉在思考我的请求时，眼中充满了疑虑。"

# game/episode013_conversations.rpy:317
translate simplified_chinese ep013_lilly_talk_5f414d17:

    # l "I...{w} I can't...{w} I don't..."
    l "我…{w} 我不能…{w} 我…"

# game/episode013_conversations.rpy:319
translate simplified_chinese ep013_lilly_talk_00758326:

    # l "Could you please leave me alone for a while?"
    l "能请你让我独自待一会儿吗？"

# game/episode013_conversations.rpy:320
translate simplified_chinese ep013_lilly_talk_4e8c7062:

    # c "Of course."
    c "当然。"

# game/episode013_conversations.rpy:321
translate simplified_chinese ep013_lilly_talk_2fc60e3f:

    # "I left Lilly in a state of utter confusion, hoping it would all turn out for the best."
    "我让莉莉陷入了彻底的困惑，希望最终一切都会好起来。"

# game/episode013_conversations.rpy:324
translate simplified_chinese ep013_lilly_talk_68f24faf:

    # c "I know it isn't fair how this got sprung onto you and I don't want to hurt you anymore than I already did."
    c "我知道这样突然告诉你是很不公平的，我也不想比现在更伤害你。"

# game/episode013_conversations.rpy:326
translate simplified_chinese ep013_lilly_talk_53772e88:

    # l "What are you trying to tell me, [p_name]?"
    l "你想告诉我什么，[p_name]？"

# game/episode013_conversations.rpy:327
translate simplified_chinese ep013_lilly_talk_08dea339:

    # c "What I'm saying is that Céline isn't the only woman I'm involved with."
    c "我是说瑟琳并不是我唯一交往的女人。"

# game/episode013_conversations.rpy:328
translate simplified_chinese ep013_lilly_talk_7bd22a1b:

    # c "Monogamy is something I have never believed in."
    c "一夫一妻制从来就不是我所信奉的。"

# game/episode013_conversations.rpy:329
translate simplified_chinese ep013_lilly_talk_dfdcbe18:

    # c "I love women, simple as that."
    c "我爱女人，就这么简单。"

# game/episode013_conversations.rpy:331
translate simplified_chinese ep013_lilly_talk_ea309f5a:

    # l "Stop, just stop!"
    l "别说了，别再说了！"

# game/episode013_conversations.rpy:332
translate simplified_chinese ep013_lilly_talk_d2efe326:

    # l "Leave me alone, [p_name]!"
    l "让我一个人静静，[p_name]！"

# game/episode013_conversations.rpy:333
translate simplified_chinese ep013_lilly_talk_568cc3cd:

    # "I left a visibly confused Lilly, wondering if telling her everything had actually broken our relationship beyond repair."
    "我留下明显困惑的莉莉，怀疑告诉她一切是否已经彻底毁掉了我们的关系。"

# game/episode013_conversations.rpy:336
translate simplified_chinese ep013_lilly_talk_b98a6224:

    # c "I thought I did, but I've come to realize that I don't."
    c "我以为我做到了，但我意识到其实并没有。"

# game/episode013_conversations.rpy:338
translate simplified_chinese ep013_lilly_talk_a8a8d3ed:

    # l "Why haven't you broken up with her then?"
    l "那你为什么不和她分手？"

# game/episode013_conversations.rpy:339
translate simplified_chinese ep013_lilly_talk_255ecca1:

    # c "I will."
    c "我会的。"

# game/episode013_conversations.rpy:340
translate simplified_chinese ep013_lilly_talk_90e2f638:

    # c "I hope you can find it in your heart to forgive me, Lilly, I really do."
    c "我希望你能发自内心地原谅我，莉莉，我真的希望。"

# game/episode013_conversations.rpy:341
translate simplified_chinese ep013_lilly_talk_2fc60e3f_1:

    # "I left Lilly in a state of utter confusion, hoping it would all turn out for the best."
    "我留下莉莉陷入彻底的困惑，希望最终会有好结果。"

# game/episode013_conversations.rpy:343
translate simplified_chinese ep013_lilly_talk_31a69a69:

    # l "Hey."
    l "嘿。"

# game/episode013_conversations.rpy:344
translate simplified_chinese ep013_lilly_talk_301aef01_1:

    # c "I thought you'd be happy to see me."
    c "我以为见到我你会高兴。"

# game/episode013_conversations.rpy:345
translate simplified_chinese ep013_lilly_talk_a1493bde:

    # "Lilly turned around and walked inside her quarters, leaving the door open."
    "莉莉转身走进她的舱室，门依然敞开着。"

# game/episode013_conversations.rpy:346
translate simplified_chinese ep013_lilly_talk_0a444492:

    # "I followed her in."
    "我跟了进去。"

# game/episode013_conversations.rpy:347
translate simplified_chinese ep013_lilly_talk_f87c9e50:

    # c "Lilly, what's the matter?"
    c "莉莉，怎么了？"

# game/episode013_conversations.rpy:349
translate simplified_chinese ep013_lilly_talk_7a05d1c2:

    # "Suddenly, she faced me and threw herself in my arms."
    "突然，她面向我，扑进我的怀里。"

# game/episode013_conversations.rpy:350
translate simplified_chinese ep013_lilly_talk_c91115cc:

    # l "Oh, [p_name_short], I thought I'd lost you!"
    l "哦，[p_name_short]，我以为我失去你了！"

# game/episode013_conversations.rpy:351
translate simplified_chinese ep013_lilly_talk_a4848853:

    # l "Things have been so awful around here."
    l "这里的状况一直很糟糕。"

# game/episode013_conversations.rpy:352
translate simplified_chinese ep013_lilly_talk_420be9b7:

    # l "You gone, Nadya revealing her story..."
    l "你走了，娜迪亚又讲出了她的故事……"

# game/episode013_conversations.rpy:354
translate simplified_chinese ep013_lilly_talk_a74432d3:

    # l "I just couldn't deal."
    l "我实在承受不住。"

# game/episode013_conversations.rpy:355
translate simplified_chinese ep013_lilly_talk_281fc046:

    # l "So I've just been avoiding everyone."
    l "所以我一直在躲着所有人。"

# game/episode013_conversations.rpy:356
translate simplified_chinese ep013_lilly_talk_7e9f3281:

    # c "Eva told me."
    c "伊娃告诉我了。"

# game/episode013_conversations.rpy:357
translate simplified_chinese ep013_lilly_talk_68654725:

    # c "She also told me you've stayed at my side."
    c "她还说你一直守在我身边。"

# game/episode013_conversations.rpy:358
translate simplified_chinese ep013_lilly_talk_84b8fe13:

    # l "Of course I did, I was so afraid I'd lost you."
    l "我当然会这么做，我多害怕失去你啊。"

# game/episode013_conversations.rpy:360
translate simplified_chinese ep013_lilly_talk_331a216d:

    # "In response, we exchanged a passionate kiss."
    "作为回应，我们交换了一个热烈的吻。"

# game/episode013_conversations.rpy:362
translate simplified_chinese ep013_lilly_talk_e0e48401:

    # l "What are we going to do now, [p_name_short]?"
    l "我们现在该怎么办，[p_name_short]？"

# game/episode013_conversations.rpy:363
translate simplified_chinese ep013_lilly_talk_bb00a52c:

    # c "What do you mean?"
    c "你指的是什么？"

# game/episode013_conversations.rpy:364
translate simplified_chinese ep013_lilly_talk_066a50a2:

    # c "Kissing seemed like a great idea."
    c "接吻似乎是个很棒的主意。"

# game/episode013_conversations.rpy:366
translate simplified_chinese ep013_lilly_talk_d879b47c:

    # l "Not that, you big lump."
    l "不是那个意思，你这个大木头。"

# game/episode013_conversations.rpy:367
translate simplified_chinese ep013_lilly_talk_c63d7046:

    # l "I mean about everything that Nadya told."
    l "我是说娜迪亚阿姨说的所有事。"

# game/episode013_conversations.rpy:368
translate simplified_chinese ep013_lilly_talk_1054b8c9:

    # c "I'm not sure there's anything to do?"
    c "我不确定有什么可做的？"

# game/episode013_conversations.rpy:370
translate simplified_chinese ep013_lilly_talk_6e156863:

    # l "You're not angry?"
    l "你不生气吗？"

# game/episode013_conversations.rpy:371
translate simplified_chinese ep013_lilly_talk_0743fd8c:

    # c "Yes, very."
    c "是的，很生气。"

# game/episode013_conversations.rpy:372
translate simplified_chinese ep013_lilly_talk_15b96add:

    # c "But I'm not angry at Nadya."
    c "但我不是生娜迪亚阿姨的气。"

# game/episode013_conversations.rpy:373
translate simplified_chinese ep013_lilly_talk_4b681ffd:

    # c "She must have gone through hell back then."
    c "她当时一定经历了地狱般的折磨。"

# game/episode013_conversations.rpy:374
translate simplified_chinese ep013_lilly_talk_26977e52:

    # c "Of course she could have told us earlier, but all things considered, I'm just glad that she did eventually."
    c "当然她本可以早点告诉我们，但考虑到所有情况，我很高兴她最终还是说了。"

# game/episode013_conversations.rpy:376
translate simplified_chinese ep013_lilly_talk_3c54f4dd:

    # l "Oh..."
    l "哦…"

# game/episode013_conversations.rpy:377
translate simplified_chinese ep013_lilly_talk_bad49f67:

    # l "I was so furious at first."
    l "我一开始非常愤怒。"

# game/episode013_conversations.rpy:378
translate simplified_chinese ep013_lilly_talk_9248f29b:

    # l "But once I thought things over I feel much the same way you do."
    l "但当我仔细想过之后，我的感受和你差不多。"

# game/episode013_conversations.rpy:380
translate simplified_chinese ep013_lilly_talk_0661a5f8:

    # l "Just confronting Aunt Nadya again...{w} no...{w} Mom..."
    l "只是再次面对娜迪亚阿姨…{w}不…{w}妈妈…"

# game/episode013_conversations.rpy:381
translate simplified_chinese ep013_lilly_talk_b693412a:

    # l "It's all so weird."
    l "这一切都太奇怪了。"

# game/episode013_conversations.rpy:382
translate simplified_chinese ep013_lilly_talk_a12465a4:

    # l "I mean, Dad and Nadya together..."
    l "我是说，爸爸和娜迪亚在一起…"

# game/episode013_conversations.rpy:383
translate simplified_chinese ep013_lilly_talk_d2a9f9e5:

    # c "Well, considering our relationship, we're not the ones to judge."
    c "考虑到我们的关系，我们没资格评判别人。"

# game/episode013_conversations.rpy:385
translate simplified_chinese ep013_lilly_talk_4863e00c:

    # l "I know..."
    l "我知道…"

# game/episode013_conversations.rpy:387
translate simplified_chinese ep013_lilly_talk_d4b37849:

    # l "Nadya surely thinks I hate her."
    l "娜迪亚肯定以为我恨她。"

# game/episode013_conversations.rpy:388
translate simplified_chinese ep013_lilly_talk_6dfd1676:

    # c "I'm sure she understands."
    c "我相信她能理解。"

# game/episode013_conversations.rpy:389
translate simplified_chinese ep013_lilly_talk_878b7af5:

    # c "The only thing she's ever wanted was for us to be together."
    c "她唯一想要的只是我们能够团聚。"

# game/episode013_conversations.rpy:390
translate simplified_chinese ep013_lilly_talk_1261fdf5:

    # c "So I was thinking of having a family dinner together."
    c "所以我在想我们可以一起吃顿家庭晚餐。"

# game/episode013_conversations.rpy:391
translate simplified_chinese ep013_lilly_talk_24ecef7f:

    # l "Dinner?"
    l "晚餐？"

# game/episode013_conversations.rpy:392
translate simplified_chinese ep013_lilly_talk_7ab91b14:

    # c "Yeah, with just the five of us."
    c "嗯，就我们五个人。"

# game/episode013_conversations.rpy:394
translate simplified_chinese ep013_lilly_talk_c6c955e3:

    # l "Okay..."
    l "好吧…"

# game/episode013_conversations.rpy:395
translate simplified_chinese ep013_lilly_talk_07128a69:

    # c "You don't sound convinced?"
    c "你听起来不太确定？"

# game/episode013_conversations.rpy:397
translate simplified_chinese ep013_lilly_talk_d563aaeb:

    # l "It's just...{w} what will she think of me?"
    l "只是…{w}她会怎么看我？"

# game/episode013_conversations.rpy:398
translate simplified_chinese ep013_lilly_talk_78353f5b:

    # c "She'll understand, I'm sure of it."
    c "她会理解的，我对此确信无疑。"

# game/episode013_conversations.rpy:400
translate simplified_chinese ep013_lilly_talk_0231d669:

    # l "Okay, if you say so."
    l "好吧，既然你都这么说了。"

# game/episode013_conversations.rpy:401
translate simplified_chinese ep013_lilly_talk_da1dca2b:

    # c "So I can count on you for dinner?"
    c "这么说我能指望你来吃晚饭了？"

# game/episode013_conversations.rpy:402
translate simplified_chinese ep013_lilly_talk_c32f588e:

    # l "Yes, I'll be there."
    l "是的，我会去的。"

# game/episode013_conversations.rpy:405
translate simplified_chinese ep013_lilly_talk_4b5a0763:

    # l "Hey!"
    l "嘿！"

# game/episode013_conversations.rpy:406
translate simplified_chinese ep013_lilly_talk_301aef01_2:

    # c "I thought you'd be happy to see me."
    c "我以为你见到我会很高兴。"

# game/episode013_conversations.rpy:408
translate simplified_chinese ep013_lilly_talk_a1b439cc:

    # l "I am!"
    l "我是很高兴！"

# game/episode013_conversations.rpy:410
translate simplified_chinese ep013_lilly_talk_26639176:

    # l "We all thought we’d lost you!"
    l "我们都以为失去你了！"

# game/episode013_conversations.rpy:411
translate simplified_chinese ep013_lilly_talk_05ea1d86:

    # l "It was such a relief when we found you with that locator."
    l "当我们通过定位器找到你时，真是松了一口气。"

# game/episode013_conversations.rpy:412
translate simplified_chinese ep013_lilly_talk_f2063490:

    # c "I’m very glad you went to those lengths to find me."
    c "我很感激你费尽心思来找我。"

# game/episode013_conversations.rpy:414
translate simplified_chinese ep013_lilly_talk_478ecc95:

    # l "Did your father really push you out an airlock?"
    l "你父亲真的把你推出气闸了吗？"

# game/episode013_conversations.rpy:415
translate simplified_chinese ep013_lilly_talk_b25f5846:

    # c "Something like that, yeah."
    c "差不多就是这样，没错。"

# game/episode013_conversations.rpy:417
translate simplified_chinese ep013_lilly_talk_dc0b7a97:

    # l "That’s so awful."
    l "那太可怕了。"

# game/episode013_conversations.rpy:418
translate simplified_chinese ep013_lilly_talk_b036f3fd:

    # c "Well, he needed a sacrifice and I was just lucky enough to be around."
    c "嗯，他需要一个祭品，而我正好在场罢了。"

# game/episode013_conversations.rpy:419
translate simplified_chinese ep013_lilly_talk_43182e1c:

    # l "You shouldn’t joke about those things."
    l "你不该拿这种事开玩笑。"

# game/episode013_conversations.rpy:420
translate simplified_chinese ep013_lilly_talk_ecc1126f:

    # c "I don’t know how else to deal with it."
    c "我不知道还能怎么面对这件事。"

# game/episode013_conversations.rpy:421
translate simplified_chinese ep013_lilly_talk_eb407b1b:

    # l "Yeah, I can imagine."
    l "是啊，我能想象。"

# game/episode013_conversations.rpy:422
translate simplified_chinese ep013_lilly_talk_fa65b030:

    # l "It's a very cold thing to do though."
    l "但这做法实在太冷酷了。"

# game/episode013_conversations.rpy:423
translate simplified_chinese ep013_lilly_talk_7a9a4e48:

    # c "It sure is, but I've come to expect this from my parents."
    c "确实如此，但我已经习惯父母这样对我了。"

# game/episode013_conversations.rpy:425
translate simplified_chinese ep013_lilly_talk_9f78720c:

    # l "Not outright murder, surely."
    l "总不至于真的杀人吧。"

# game/episode013_conversations.rpy:426
translate simplified_chinese ep013_lilly_talk_142aeaf5:

    # c "I admit that's a new thing, but not very surprising really."
    c "我承认这次是新花样，但其实并不怎么意外。"

# game/episode013_conversations.rpy:428
translate simplified_chinese ep013_lilly_talk_bd1a32e8:

    # l "Still, it makes me very sad."
    l "尽管如此，这让我非常难过。"

# game/episode013_conversations.rpy:430
translate simplified_chinese ep013_lilly_talk_05c28db0:

    # l "Very happy to see you’re safe and sound though."
    l "不过看到你平安无事，我真的很开心。"

# game/episode013_conversations.rpy:431
translate simplified_chinese ep013_lilly_talk_c6ce0e47:

    # c "Thanks Lilly."
    c "谢谢你，莉莉。"

# game/episode013_conversations.rpy:432
translate simplified_chinese ep013_lilly_talk_1173e89a:

    # l "The others will surely want to see you."
    l "其他人肯定也想见你。"

# game/episode013_conversations.rpy:433
translate simplified_chinese ep013_lilly_talk_09ac0171:

    # c "I’ve spoken to a few of them already."
    c "我已经和他们中的几位谈过了。"

# game/episode013_conversations.rpy:434
translate simplified_chinese ep013_lilly_talk_670b93fb:

    # l "Take care, [p_name_short]."
    l "保重，[p_name_short]。"

# game/episode013_conversations.rpy:443
translate simplified_chinese ep013_lilly_second_talk_a4296e19:

    # c "Still angry, sis?"
    c "还在生气吗，妹妹？"

# game/episode013_conversations.rpy:445
translate simplified_chinese ep013_lilly_second_talk_65ee0276:

    # c "Still angry, Lilly?"
    c "还在生气吗，莉莉？"

# game/episode013_conversations.rpy:447
translate simplified_chinese ep013_lilly_second_talk_f235f9a4:

    # l "Yes...{w} No."
    l "是…{w} 不是。"

# game/episode013_conversations.rpy:449
translate simplified_chinese ep013_lilly_second_talk_71887d92:

    # c "What the hell happened?"
    c "到底发生了什么？"

# game/episode013_conversations.rpy:451
translate simplified_chinese ep013_lilly_second_talk_a85fe5aa:

    # l "Must we talk about this?"
    l "我们必须谈这个吗？"

# game/episode013_conversations.rpy:452
translate simplified_chinese ep013_lilly_second_talk_be98474e:

    # c "Yes, we must."
    c "是的，必须谈。"

# game/episode013_conversations.rpy:453
translate simplified_chinese ep013_lilly_second_talk_b6bd30a5:

    # c "Why did you go off at Céline like that?"
    c "你为什么要那样对瑟琳发脾气？"

# game/episode013_conversations.rpy:455
translate simplified_chinese ep013_lilly_second_talk_aad1d645:

    # l "Well, isn't it obvious?"
    l "嗯，这不是很明显吗？"

# game/episode013_conversations.rpy:456
translate simplified_chinese ep013_lilly_second_talk_5a526a85:

    # c "I can guess, but I'd like to hear it from you."
    c "我能猜到，但我想听你亲口说。"

# game/episode013_conversations.rpy:458
translate simplified_chinese ep013_lilly_second_talk_11afec4d:

    # "Lilly sighed and lowered her head despondently."
    "莉莉叹了口气，沮丧地低下了头。"

# game/episode013_conversations.rpy:459
translate simplified_chinese ep013_lilly_second_talk_c50316d3:

    # l "It was jealousy, okay."
    l "是嫉妒，行了吧。"

# game/episode013_conversations.rpy:461
translate simplified_chinese ep013_lilly_second_talk_ebea651f:

    # l "Happy now?"
    l "现在满意了吗？"

# game/episode013_conversations.rpy:462
translate simplified_chinese ep013_lilly_second_talk_cafbc123:

    # c "You're jealous of Céline?"
    c "你嫉妒瑟琳？"

# game/episode013_conversations.rpy:464
translate simplified_chinese ep013_lilly_second_talk_b3033db7:

    # l "That's what I said, didn't I?"
    l "我不是说了吗？"

# game/episode013_conversations.rpy:466
translate simplified_chinese ep013_lilly_second_talk_aea652cc:

    # l "She was walking her stupid little walk, her arrogant head way up in the air and then she dropped our supplies."
    l "她走着她那愚蠢的小碎步，傲慢地昂着头，然后摔了我们的补给品。"

# game/episode013_conversations.rpy:467
translate simplified_chinese ep013_lilly_second_talk_8aed8e3c:

    # c "Lilly, she's one of your best friends."
    c "莉莉，她是你最好的朋友之一啊。"

# game/episode013_conversations.rpy:468
translate simplified_chinese ep013_lilly_second_talk_78fd3f93:

    # l "I don't care."
    l "我不在乎。"

# game/episode013_conversations.rpy:469
translate simplified_chinese ep013_lilly_second_talk_7a4d87a1:

    # l "She has her filthy little claws all over you."
    l "她那肮脏的小爪子都伸到你身上了。"

# game/episode013_conversations.rpy:471
translate simplified_chinese ep013_lilly_second_talk_f1bb613b:

    # c "Lilly, you know I’ve broken up with her."
    c "莉莉，你知道我和她已经分手了。"

# game/episode013_conversations.rpy:472
translate simplified_chinese ep013_lilly_second_talk_9b8c25a6:

    # l "So?!"
    l "那又怎样？！"

# game/episode013_conversations.rpy:473
translate simplified_chinese ep013_lilly_second_talk_ac9785bf:

    # c "She and I are done.{w} History."
    c "我和她已经结束了。{w} 都是过去式了。"

# game/episode013_conversations.rpy:475
translate simplified_chinese ep013_lilly_second_talk_0a62f9c1:

    # c "Lilly..."
    c "莉莉…"

# game/episode013_conversations.rpy:477
translate simplified_chinese ep013_lilly_second_talk_dd296d8a:

    # l "What?!"
    l "干嘛？！"

# game/episode013_conversations.rpy:478
translate simplified_chinese ep013_lilly_second_talk_c93b3419:

    # c "Don't you think-"
    c "你不觉得—"

# game/episode013_conversations.rpy:480
translate simplified_chinese ep013_lilly_second_talk_71161155:

    # l "Yes, I'm being childish, so what."
    l "对，我就是幼稚，怎样。"

# game/episode013_conversations.rpy:482
translate simplified_chinese ep013_lilly_second_talk_10c675ba:

    # l "I want you for myself and you've just told me I have to share you."
    l "我想要独占你，可你刚才告诉我必须和别人分享你。"

# game/episode013_conversations.rpy:483
translate simplified_chinese ep013_lilly_second_talk_e7db078a:

    # c "Don't let it all out on Céline, she didn't know about us."
    c "别把气都撒在瑟琳身上，她不知道我们的事。"

# game/episode013_conversations.rpy:484
translate simplified_chinese ep013_lilly_second_talk_8a01cfb5:

    # c "If you're going to be angry, be angry with me."
    c "如果你要生气，就冲我来。"

# game/episode013_conversations.rpy:486
translate simplified_chinese ep013_lilly_second_talk_1bd98c76:

    # l "That's just it, I can't."
    l "问题就在这儿，我做不到。"

# game/episode013_conversations.rpy:487
translate simplified_chinese ep013_lilly_second_talk_25639179:

    # l "I know you and her were a thing before we even looked at each other in a different way."
    l "我知道在我俩还没开始之前，你就和她有过一段。"

# game/episode013_conversations.rpy:489
translate simplified_chinese ep013_lilly_second_talk_6dbffd65:

    # l "And maybe I'm too greedy wanting you all for myself."
    l "也许是我太贪心，想独占你。"

# game/episode013_conversations.rpy:491
translate simplified_chinese ep013_lilly_second_talk_6488245c:

    # l "I mean, I know why we have to keep our relationship a secret, so you being with Céline is a perfect alibi."
    l "我的意思是，我明白为什么我们必须保密恋情，所以你和瑟琳在一起确实是个完美的幌子。"

# game/episode013_conversations.rpy:492
translate simplified_chinese ep013_lilly_second_talk_c37de1bc:

    # c "I'm not sure me and her are just an alibi..."
    c "我不确定我和她之间只是个幌子……"

# game/episode013_conversations.rpy:494
translate simplified_chinese ep013_lilly_second_talk_4756333a:

    # c "But you have me all for yourself."
    c "但你现在完全拥有我啊。"

# game/episode013_conversations.rpy:496
translate simplified_chinese ep013_lilly_second_talk_cd51390e:

    # l "You know what I mean!"
    l "你明白我的意思！"

# game/episode013_conversations.rpy:497
translate simplified_chinese ep013_lilly_second_talk_25861913:

    # c "Yeah, I kinda do."
    c "嗯，我大概明白。"

# game/episode013_conversations.rpy:498
translate simplified_chinese ep013_lilly_second_talk_1b16762a:

    # c "Still, I think I'm going to tell Céline about us."
    c "不过，我打算把我们的事告诉瑟琳。"

# game/episode013_conversations.rpy:500
translate simplified_chinese ep013_lilly_second_talk_caad1d29:

    # l "You what?!"
    l "你说什么？！"

# game/episode013_conversations.rpy:502
translate simplified_chinese ep013_lilly_second_talk_8e5d6379:

    # c "The worst she can do is jump ship in disgust, but I have a feeling she won't do that."
    c "她最多也就是厌恶地跳船离开，但我有种感觉她不会那样做。"

# game/episode013_conversations.rpy:503
translate simplified_chinese ep013_lilly_second_talk_7c9d870e:

    # c "I'm sure she'll keep it a secret."
    c "我相信她会保守秘密的。"

# game/episode013_conversations.rpy:505
translate simplified_chinese ep013_lilly_second_talk_ecc22fe7:

    # l "It's a risk though, [p_name_short]."
    l "不过这是个风险，[p_name_short]。"

# game/episode013_conversations.rpy:506
translate simplified_chinese ep013_lilly_second_talk_c2ed2c39:

    # c "I know, but it's a risk we'll have to take."
    c "我知道，但这是我们必须要冒的风险。"

# game/episode013_conversations.rpy:508
translate simplified_chinese ep013_lilly_second_talk_65d42ed7:

    # l "Well, I trust you to make the right decision."
    l "好吧，我相信你能做出正确的决定。"

# game/episode013_conversations.rpy:510
translate simplified_chinese ep013_lilly_second_talk_00ef16ce:

    # c "She deserves to know the truth."
    c "她有权知道真相。"

# game/episode013_conversations.rpy:511
translate simplified_chinese ep013_lilly_second_talk_abfed309:

    # c "I'll leave it up to her if she wants to end things."
    c "我会让她自己决定是否要结束这段关系。"

# game/episode013_conversations.rpy:512
translate simplified_chinese ep013_lilly_second_talk_daff067e:

    # c "One thing though, whatever happens, I'd like you guys to make up."
    c "不过有件事，无论发生什么，我希望你们能和好。"

# game/episode013_conversations.rpy:514
translate simplified_chinese ep013_lilly_second_talk_8f8f7cfa:

    # l "Apologize to her?"
    l "向她道歉？"

# game/episode013_conversations.rpy:515
translate simplified_chinese ep013_lilly_second_talk_1a16c951:

    # c "If possible, yes."
    c "如果可能的话，是的。"

# game/episode013_conversations.rpy:517
translate simplified_chinese ep013_lilly_second_talk_7e6c60a0:

    # l "Alright, fine."
    l "好吧，行。"

# game/episode013_conversations.rpy:520
translate simplified_chinese ep013_lilly_second_talk_0e3a4c1b:

    # l "[p_name_short]?"
    l "[p_name_short]?"

# game/episode013_conversations.rpy:521
translate simplified_chinese ep013_lilly_second_talk_24c7ada5:

    # c "Yes?"
    c "怎么了？"

# game/episode013_conversations.rpy:523
translate simplified_chinese ep013_lilly_second_talk_4a59b4d9:

    # l "Ever since our dinner with Nadya, I keep thinking about her and Dad."
    l "自从和娜迪亚阿姨共进晚餐后，我一直在想她和爸爸的事。"

# game/episode013_conversations.rpy:524
translate simplified_chinese ep013_lilly_second_talk_f8ac909c:

    # c "What about them?"
    c "他们怎么了？"

# game/episode013_conversations.rpy:526
translate simplified_chinese ep013_lilly_second_talk_c8d30c7c:

    # l "I still can't get over the fact that they, you know...{w} slept with each other."
    l "我还是无法接受他们，你知道的…{w}上过床这件事。"

# game/episode013_conversations.rpy:527
translate simplified_chinese ep013_lilly_second_talk_ac2bea30:

    # c "Me neither."
    c "我也是。"

# game/episode013_conversations.rpy:529
translate simplified_chinese ep013_lilly_second_talk_f1a62b98:

    # l "I looked up some old photos, Dad looked really a lot like you."
    l "我查了些旧照片，爸爸当时长得真的很像你。"

# game/episode013_conversations.rpy:530
translate simplified_chinese ep013_lilly_second_talk_f415bdf8:

    # c "Did he?"
    c "是吗？"

# game/episode013_conversations.rpy:531
translate simplified_chinese ep013_lilly_second_talk_591f047f:

    # c "Any family resemblance is a little hard to make out nowadays, because of all the chins he's sporting."
    c "现在要看出什么家族相似性有点困难，毕竟他现在下巴都堆了好几层。"

# game/episode013_conversations.rpy:532
translate simplified_chinese ep013_lilly_second_talk_1041b484:

    # l "He really looked quite dashing, but you can tell there's a mean streak in him."
    l "他当时确实挺英俊的，但你能看出他骨子里有种刻薄劲儿。"

# game/episode013_conversations.rpy:533
translate simplified_chinese ep013_lilly_second_talk_c4db7d02:

    # c "You can?"
    c "你能看出来？"

# game/episode013_conversations.rpy:535
translate simplified_chinese ep013_lilly_second_talk_1cb68afd:

    # l "It's something in his eyes, I don't know."
    l "是他眼神里的某种东西，我说不清楚。"

# game/episode013_conversations.rpy:536
translate simplified_chinese ep013_lilly_second_talk_302e095f:

    # l "All I know is that it's missing in your eyes."
    l "我只知道这种特质在你眼里并不存在。"

# game/episode013_conversations.rpy:537
translate simplified_chinese ep013_lilly_second_talk_20d97ad6:

    # c "I'm glad to hear I have all the good looks and none of the family villainy."
    c "很高兴听说我继承了所有英俊外表，却没有家族里的邪恶特质。"

# game/episode013_conversations.rpy:539
translate simplified_chinese ep013_lilly_second_talk_bb7991a6:

    # l "Exactly!"
    l "完全正确！"

# game/episode013_conversations.rpy:542
translate simplified_chinese ep013_lilly_second_talk_582b9fad:

    # "Lilly and I shared a kiss before I left her quarters, making me feel hopeful she would forgive my involvement with Céline."
    "离开莉莉的房间前，我们接吻了，这让我觉得她可能会原谅我与瑟琳之间的事。"

# game/episode013_conversations.rpy:550
translate simplified_chinese ep013_eva_talk_4f3a0c55:

    # e "I'm so glad you're looking healthy again!"
    e "真高兴看到你恢复健康了！"

# game/episode013_conversations.rpy:551
translate simplified_chinese ep013_eva_talk_9a35ec84:

    # e "They mistreated you badly on that ship, didn't they?"
    e "他们在船上虐待你了，是吗？"

# game/episode013_conversations.rpy:552
translate simplified_chinese ep013_eva_talk_61ed7c35:

    # c "You can say that again."
    c "你说得一点没错。"

# game/episode013_conversations.rpy:555
translate simplified_chinese ep013_eva_talk_57f77b2a:

    # e "I'm sure you think me naive, but I didn't think our father was capable of things like this."
    e "我知道你可能会觉得我天真，但我真的没想到我们的父亲会做出这种事。"

# game/episode013_conversations.rpy:557
translate simplified_chinese ep013_eva_talk_f0b4dc98:

    # e "I'm sure you think me naive, but I didn't think your father was capable of things like this."
    e "我敢说你肯定觉得我太天真，但我真没想到你父亲会做出这种事。"

# game/episode013_conversations.rpy:558
translate simplified_chinese ep013_eva_talk_9441bd34:

    # c "This was a new low for me too..."
    c "这对我来说也是个新低点…"

# game/episode013_conversations.rpy:559
translate simplified_chinese ep013_eva_talk_242753e6:

    # c "How have things been around here?"
    c "这边情况怎么样？"

# game/episode013_conversations.rpy:561
translate simplified_chinese ep013_eva_talk_bf8cb7f8:

    # e "You mean after Nadya dropped that bombshell on us?"
    e "你是指娜迪亚阿姨向我们抛出那个重磅消息之后？"

# game/episode013_conversations.rpy:562
translate simplified_chinese ep013_eva_talk_1b830b35:

    # c "Yeah, she told me right before I left."
    c "对，就在我离开前她告诉我的。"

# game/episode013_conversations.rpy:563
translate simplified_chinese ep013_eva_talk_511a0aef:

    # e "Crazy, right?"
    e "很疯狂对吧？"

# game/episode013_conversations.rpy:565
translate simplified_chinese ep013_eva_talk_0deb4b9c:

    # e "Or maybe not, actually."
    e "或者其实也不尽然。"

# game/episode013_conversations.rpy:566
translate simplified_chinese ep013_eva_talk_bddec5d8:

    # e "I've been thinking about it a lot."
    e "我一直在反复思考这件事。"

# game/episode013_conversations.rpy:567
translate simplified_chinese ep013_eva_talk_d31c4a1a:

    # e "It kind of all fits, doesn't it?"
    e "一切好像都说得通了，不是吗？"

# game/episode013_conversations.rpy:568
translate simplified_chinese ep013_eva_talk_d6141538:

    # e "Nadya being so close with us for all those years, until she went away without explanation."
    e "娜迪亚阿姨和我们亲近了这么多年，直到后来毫无解释地离开。"

# game/episode013_conversations.rpy:570
translate simplified_chinese ep013_eva_talk_2c2209a2:

    # e "Obviously, I've always felt close to you and Lilly."
    e "显然，我一直觉得和你还有莉莉很亲近。"

# game/episode013_conversations.rpy:572
translate simplified_chinese ep013_eva_talk_588fa91f:

    # e "Dad was...{w} well...{w} dad."
    e "爸爸他…{w} 唉…{w} 就是那样。"

# game/episode013_conversations.rpy:573
translate simplified_chinese ep013_eva_talk_ff94eefb:

    # e "But mom, I mean Yve, always felt so distant."
    e "但妈妈，我是说伊芙，总是感觉那么疏远。"

# game/episode013_conversations.rpy:574
translate simplified_chinese ep013_eva_talk_db4a6ce8:

    # e "With Nadya I felt I could tell her everything and she really listened."
    e "和娜迪亚在一起时，我觉得什么都能告诉她，她真的在听。"

# game/episode013_conversations.rpy:575
translate simplified_chinese ep013_eva_talk_fee47a6d:

    # c "Yes, I know exactly what you mean."
    c "是的，我完全明白你的意思。"

# game/episode013_conversations.rpy:577
translate simplified_chinese ep013_eva_talk_04c25a18:

    # e "To think she had to keep her secret for so long and then be forced to leave us."
    e "想想她不得不保守这个秘密这么久，最后还被迫离开我们。"

# game/episode013_conversations.rpy:578
translate simplified_chinese ep013_eva_talk_3d443854:

    # c "I just wish she’d taken us with her."
    c "我真希望她当时带上我们一起走。"

# game/episode013_conversations.rpy:579
translate simplified_chinese ep013_eva_talk_d0b05661:

    # e "Yeah, I wonder what turn our lives would have taken in that case."
    e "是啊，不知道那样的话我们的人生会走向何方。"

# game/episode013_conversations.rpy:580
translate simplified_chinese ep013_eva_talk_00a36097:

    # c "You could have pursued that science career you always wanted."
    c "你本可以追求你一直向往的科学事业。"

# game/episode013_conversations.rpy:582
translate simplified_chinese ep013_eva_talk_13c09228:

    # e "Oh yes, maybe Nadya and I would have worked together."
    e "哦对，也许我和娜迪亚还能一起工作呢。"

# game/episode013_conversations.rpy:583
translate simplified_chinese ep013_eva_talk_03f88cfa:

    # c "The mother and daughter team of star scientists."
    c "这对母女组成的明星科学家组合。"

# game/episode013_conversations.rpy:585
translate simplified_chinese ep013_eva_talk_584e9b9d:

    # e "That’s right!"
    e "没错！"

# game/episode013_conversations.rpy:586
translate simplified_chinese ep013_eva_talk_c6bf516f:

    # c "Do you know how Lilly is taking all of this?"
    c "你知道莉莉对这一切作何反应吗？"

# game/episode013_conversations.rpy:588
translate simplified_chinese ep013_eva_talk_779dd43d:

    # e "Well...{w} Not great."
    e "嗯…{w} 不太好。"

# game/episode013_conversations.rpy:590
translate simplified_chinese ep013_eva_talk_16d38471:

    # e "You know how she can be."
    e "你知道她那脾气。"

# game/episode013_conversations.rpy:592
translate simplified_chinese ep013_eva_talk_b1c375f0:

    # e "After Nadya finished talking she just walked out."
    e "娜迪亚说完后她就直接走出去了。"

# game/episode013_conversations.rpy:593
translate simplified_chinese ep013_eva_talk_06701954:

    # e "I mean she was obviously shocked and I’d expected one of her typical outbursts, but she just didn’t say a thing."
    e "我的意思是她明显很震惊，我本以为她会像往常那样爆发，但她却一言不发。"

# game/episode013_conversations.rpy:594
translate simplified_chinese ep013_eva_talk_8b4533ba:

    # c "Lilly isn’t the same girl she was back at the Academy."
    c "莉莉已经不是学院里那个女孩了。"

# game/episode013_conversations.rpy:596
translate simplified_chinese ep013_eva_talk_c348cbba:

    # e "I realize that, yeah."
    e "是啊，我意识到了。"

# game/episode013_conversations.rpy:597
translate simplified_chinese ep013_eva_talk_638efea7:

    # e "After we got you back she mostly spent her time by your bedside or in her own room."
    e "我们把你救回来后，她大部分时间要么守在你床边，要么待在自己房间里。"

# game/episode013_conversations.rpy:598
translate simplified_chinese ep013_eva_talk_a6f69d5b:

    # c "I’ll talk to her, see how she’s doing."
    c "我会去和她谈谈，看看她怎么样。"

# game/episode013_conversations.rpy:600
translate simplified_chinese ep013_eva_talk_bd434df5:

    # e "I think she’d like that."
    e "我觉得她会喜欢的。"

# game/episode013_conversations.rpy:601
translate simplified_chinese ep013_eva_talk_ae9dda49:

    # c "What about Aven?"
    c "那艾文呢？"

# game/episode013_conversations.rpy:603
translate simplified_chinese ep013_eva_talk_46664c30:

    # e "You know, it’s the strangest thing...{w} Back when we were young she always kept her cool, at least that’s how I remember her."
    e "你知道吗，最奇怪的是…{w} 我们小时候她总是能保持冷静，至少我是这么记得的。"

# game/episode013_conversations.rpy:604
translate simplified_chinese ep013_eva_talk_2f9ed2f1:

    # c "There’s still not much that seems to faze her."
    c "现在似乎也没什么能让她动容的。"

# game/episode013_conversations.rpy:605
translate simplified_chinese ep013_eva_talk_d84205cd:

    # e "She totally lost it when Nadya told us, [p_name_short]."
    e "但当娜迪亚告诉我们时，她完全失控了，[p_name_short]。"

# game/episode013_conversations.rpy:606
translate simplified_chinese ep013_eva_talk_a35e556c:

    # e "It was like she vented so much pent-up rage right back at Nadya."
    e "就好像她把积压已久的怒火全都发泄在了娜迪亚身上。"

# game/episode013_conversations.rpy:607
translate simplified_chinese ep013_eva_talk_fef053ca:

    # e "Then she made the exit I thought Lilly would make, you know, slamming doors and all that."
    e "然后她做出了我以为莉莉会做的事，你知道，摔门而出之类的。"

# game/episode013_conversations.rpy:608
translate simplified_chinese ep013_eva_talk_e6ec0417:

    # c "That doesn’t sound like her at all."
    c "这听起来一点都不像她。"

# game/episode013_conversations.rpy:610
translate simplified_chinese ep013_eva_talk_e8463810:

    # e "I know, but we were under a lot of stress, of course."
    e "我知道，但我们当时压力确实很大。"

# game/episode013_conversations.rpy:611
translate simplified_chinese ep013_eva_talk_656d8739:

    # "I wondered if that was all there was to it and there was only one way to find out."
    "我在想这是否就是全部原因，而查明真相只有一个方法。"

# game/episode013_conversations.rpy:612
translate simplified_chinese ep013_eva_talk_ed7d32cd:

    # c "I hope she’ll speak to me."
    c "我希望她会跟我说话。"

# game/episode013_conversations.rpy:614
translate simplified_chinese ep013_eva_talk_e51bfc95:

    # e "I think she will, she spent nearly as much time by your side as Lilly did."
    e "我觉得她会，她在你身边陪伴的时间几乎和莉莉一样多。"

# game/episode013_conversations.rpy:616
translate simplified_chinese ep013_eva_talk_f29fdc8a:

    # e "Tense is the right word, I think."
    e "我觉得\"紧张\"这个词用得很准确。"

# game/episode013_conversations.rpy:618
translate simplified_chinese ep013_eva_talk_1ff48e12:

    # e "Lilly and Aven spent almost all of their time by your side."
    e "莉莉和艾文几乎把所有时间都花在了你身边。"

# game/episode013_conversations.rpy:619
translate simplified_chinese ep013_eva_talk_f319c79d:

    # e "They've both become very withdrawn."
    e "她们俩都变得非常沉默寡言。"

# game/episode013_conversations.rpy:621
translate simplified_chinese ep013_eva_talk_17489086:

    # e "Lilly especially so."
    e "莉莉尤其如此。"

# game/episode013_conversations.rpy:623
translate simplified_chinese ep013_eva_talk_b6fbfa3a:

    # e "We were all under a lot of stress, of course."
    e "当然，我们当时都承受着很大压力。"

# game/episode013_conversations.rpy:624
translate simplified_chinese ep013_eva_talk_656d8739_1:

    # "I wondered if that was all there was to it and there was only one way to find out."
    "我在想这是否就是全部原因，而查明真相只有一个方法。"

# game/episode013_conversations.rpy:625
translate simplified_chinese ep013_eva_talk_7b7f5fba:

    # c "I hope they’ll speak to me."
    c "我希望她们会跟我说话。"

# game/episode013_conversations.rpy:627
translate simplified_chinese ep013_eva_talk_e8faeac7:

    # e "I think they will."
    e "我想她们会的。"

# game/episode013_conversations.rpy:630
translate simplified_chinese ep013_eva_talk_b4243383:

    # e "Lilly spent almost all of her time by your side."
    e "莉莉几乎把所有时间都守在你身边。"

# game/episode013_conversations.rpy:632
translate simplified_chinese ep013_eva_talk_fd4d4f67:

    # e "Aven spent almost all of her time by your side."
    e "艾文也几乎把所有时间都守在你身边。"

# game/episode013_conversations.rpy:633
translate simplified_chinese ep013_eva_talk_971e7e80:

    # e "She has become very withdrawn."
    e "她变得非常沉默寡言。"

# game/episode013_conversations.rpy:635
translate simplified_chinese ep013_eva_talk_b6fbfa3a_1:

    # e "We were all under a lot of stress, of course."
    e "当然，我们当时都承受着巨大压力。"

# game/episode013_conversations.rpy:636
translate simplified_chinese ep013_eva_talk_656d8739_2:

    # "I wondered if that was all there was to it and there was only one way to find out."
    "我怀疑事情是否仅止于此，而唯一的确认方法就是去探究。"

# game/episode013_conversations.rpy:637
translate simplified_chinese ep013_eva_talk_5cc5f668:

    # c "I hope she will speak to me."
    c "我希望她能和我谈谈。"

# game/episode013_conversations.rpy:639
translate simplified_chinese ep013_eva_talk_a1c4d207:

    # e "I think she will."
    e "我想她会的。"

# game/episode013_conversations.rpy:641
translate simplified_chinese ep013_eva_talk_f8950015:

    # e "We were all dreadfully worried about you."
    e "我们都为你担心得要命。"

# game/episode013_conversations.rpy:642
translate simplified_chinese ep013_eva_talk_a5d1f049:

    # c "I can't thank you all enough for what you've done for me."
    c "你们为我所做的一切，我感激不尽。"

# game/episode013_conversations.rpy:644
translate simplified_chinese ep013_eva_talk_6c737a07:

    # e "Are you kidding?"
    e "你在开玩笑吗？"

# game/episode013_conversations.rpy:646
translate simplified_chinese ep013_eva_talk_8c871a34:

    # e "We love you, [p_name_short], you know that."
    e "我们爱你，[p_name_short]，你知道的。"

# game/episode013_conversations.rpy:647
translate simplified_chinese ep013_eva_talk_115beb88:

    # c "Well, you took quite a risk coming back for me."
    c "嗯，你冒了很大风险回来救我。"

# game/episode013_conversations.rpy:649
translate simplified_chinese ep013_eva_talk_190e0789:

    # e "We did, but I don't think anyone aboard could have lived with themselves if we'd left you behind."
    e "确实如此，但如果我们把你抛下，船上没人能心安理得地活下去。"

# game/episode013_conversations.rpy:650
translate simplified_chinese ep013_eva_talk_a31c98a0:

    # e "Vess did a courageous thing too, volunteering to attempt to reel you in."
    e "薇丝也很勇敢，主动尝试把你拉回来。"

# game/episode013_conversations.rpy:651
translate simplified_chinese ep013_eva_talk_10ac911f:

    # c "Yeah, Jade told me."
    c "是啊，杰德告诉我了。"

# game/episode013_conversations.rpy:652
translate simplified_chinese ep013_eva_talk_e0d82712:

    # c "Didn’t expect Vess to risk her hide like that."
    c "没想到薇丝会那样不顾自身安危。"

# game/episode013_conversations.rpy:653
translate simplified_chinese ep013_eva_talk_41be66d6:

    # e "Yes, have you visited her yet?"
    e "是的，你去看过她了吗？"

# game/episode013_conversations.rpy:654
translate simplified_chinese ep013_eva_talk_f41ba07d:

    # c "Not yet."
    c "还没。"

# game/episode013_conversations.rpy:655
translate simplified_chinese ep013_eva_talk_da6d445a:

    # e "After we left the mansion on Kepler in a hurry, we didn't return Vess to her cell immediately."
    e "我们匆忙离开开普勒星上的豪宅后，没有立即把薇丝关回牢房。"

# game/episode013_conversations.rpy:656
translate simplified_chinese ep013_eva_talk_2af05397:

    # e "So she was present for the whole operation."
    e "所以她全程参与了这次行动。"

# game/episode013_conversations.rpy:657
translate simplified_chinese ep013_eva_talk_fa5a4862:

    # e "As soon as we realized you were drifting through space, we came up with a rescue plan."
    e "我们一发现你在太空中漂流，就立即制定了救援计划。"

# game/episode013_conversations.rpy:658
translate simplified_chinese ep013_eva_talk_d259a8c6:

    # e "Despite the evident dangers, Vess volunteered immediately."
    e "尽管危险显而易见，薇丝还是立刻自告奋勇。"

# game/episode013_conversations.rpy:659
translate simplified_chinese ep013_eva_talk_110f0cdc:

    # e "I think she still feels guilty."
    e "我觉得她仍然心怀愧疚。"

# game/episode013_conversations.rpy:661
translate simplified_chinese ep013_eva_talk_7017ad07:

    # c "I think so too."
    c "我也这么认为。"

# game/episode013_conversations.rpy:662
translate simplified_chinese ep013_eva_talk_90b81d7e:

    # e "I hope you can find it in your heart to thank her."
    e "希望你能发自内心地感谢她。"

# game/episode013_conversations.rpy:663
translate simplified_chinese ep013_eva_talk_78c101aa:

    # c "I will, don't worry."
    c "我会的，别担心。"

# game/episode013_conversations.rpy:665
translate simplified_chinese ep013_eva_talk_5131871e:

    # e "Good."
    e "很好。"

# game/episode013_conversations.rpy:667
translate simplified_chinese ep013_eva_talk_a713e69d:

    # c "And so she should."
    c "她也应该这样。"

# game/episode013_conversations.rpy:668
translate simplified_chinese ep013_eva_talk_850bafa8:

    # e "I know she betrayed us, but she seems willing to make amends."
    e "我知道她背叛过我们，但她似乎愿意弥补过错。"

# game/episode013_conversations.rpy:669
translate simplified_chinese ep013_eva_talk_4bfbba96:

    # c "Too late for that now."
    c "现在已经太迟了。"

# game/episode013_conversations.rpy:671
translate simplified_chinese ep013_eva_talk_42f4a46a:

    # e "I see..."
    e "我明白了…"

# game/episode013_conversations.rpy:673
translate simplified_chinese ep013_eva_talk_d393e637:

    # "Eva was silent for a while, looking out through the window at the stars gliding by."
    "伊娃沉默了片刻，望着窗外滑过的星辰。"

# game/episode013_conversations.rpy:675
translate simplified_chinese ep013_eva_talk_3b27c67b:

    # e "I hope Lilly and Aven can make peace with Nadya."
    e "我希望莉莉和艾文能与娜迪亚和解。"

# game/episode013_conversations.rpy:676
translate simplified_chinese ep013_eva_talk_564ec7c4:

    # e "I'd like us to be together, you know, as a family."
    e "我希望我们能在一起，你知道的，像个家庭一样。"

# game/episode013_conversations.rpy:677
translate simplified_chinese ep013_eva_talk_e0224be1:

    # c "Me too."
    c "我也是。"

# game/episode013_conversations.rpy:678
translate simplified_chinese ep013_eva_talk_4d5d0831:

    # c "I'll talk to the three of them, see if I can bring them closer together."
    c "我会和他们三个谈谈，看看能不能拉近他们的关系。"

# game/episode013_conversations.rpy:679
translate simplified_chinese ep013_eva_talk_d118013c:

    # c "I can count on you for a family dinner if I'm successful, right?"
    c "要是我成功了，能指望你来参加家庭聚餐吗？"

# game/episode013_conversations.rpy:681
translate simplified_chinese ep013_eva_talk_445e77f0:

    # e "Of course, that would be nice!"
    e "当然，那会很美好！"

# game/episode013_conversations.rpy:684
translate simplified_chinese ep013_eva_talk_6dc773ba:

    # e "I'd like everyone together, you know, like old friends."
    e "我希望大家都能聚在一起，就像老朋友那样。"

# game/episode013_conversations.rpy:685
translate simplified_chinese ep013_eva_talk_e0224be1_1:

    # c "Me too."
    c "我也是。"

# game/episode013_conversations.rpy:687
translate simplified_chinese ep013_eva_talk_50908191:

    # c "I'll talk to them, see if I can patch things up."
    c "我会和他们谈谈，看看能否弥合关系。"

# game/episode013_conversations.rpy:689
translate simplified_chinese ep013_eva_talk_688b9aac:

    # c "I'll talk to her, see if I can patch things up."
    c "我会和她谈谈，看看能否弥合关系。"

# game/episode013_conversations.rpy:690
translate simplified_chinese ep013_eva_talk_01196074:

    # c "I can count on you for a dinner if I'm successful, right?"
    c "如果成功的话，我能指望你共进晚餐吗？"

# game/episode013_conversations.rpy:692
translate simplified_chinese ep013_eva_talk_4a9888e9:

    # c "What would you say to a dinner with friends, just to catch up on everything?"
    c "你觉得和朋友们共进晚餐如何？正好可以聊聊近况。"

# game/episode013_conversations.rpy:694
translate simplified_chinese ep013_eva_talk_2455a6b6:

    # e "That would be nice!"
    e "那会很不错！"

# game/episode013_conversations.rpy:695
translate simplified_chinese ep013_eva_talk_138a7809:

    # e "Any excuse to forget all the craziness surrounding the prophecy."
    e "任何能让我们暂时忘记预言相关疯狂事端的借口都好。"

# game/episode013_conversations.rpy:696
translate simplified_chinese ep013_eva_talk_4447a28e:

    # c "My thoughts exactly."
    c "我完全同意。"

# game/episode013_conversations.rpy:697
translate simplified_chinese ep013_eva_talk_184c5048:

    # c "Though we need to continue digging at some point."
    c "不过我们迟早还得继续追查下去。"

# game/episode013_conversations.rpy:698
translate simplified_chinese ep013_eva_talk_9d44e506:

    # c "The most solid lead we have right now are the Scolguin Dad mentioned."
    c "目前最可靠的线索就是爸爸提到的斯科尔金人。"

# game/episode013_conversations.rpy:700
translate simplified_chinese ep013_eva_talk_058d0556:

    # e "Yes, I'm sure Nadya will find out more about them."
    e "是的，我相信娜迪亚会找到更多关于他们的线索。"

# game/episode013_conversations.rpy:701
translate simplified_chinese ep013_eva_talk_ea11ccb4:

    # c "Let's hope so."
    c "希望如此。"

# game/episode013_conversations.rpy:702
translate simplified_chinese ep013_eva_talk_d955e1af:

    # c "Anyway, I'm going to bother some other people."
    c "总之，我要去打扰其他人了。"

# game/episode013_conversations.rpy:704
translate simplified_chinese ep013_eva_talk_a5ca78d1:

    # e "Don't exert yourself, you've been through a lot."
    e "别太劳累，你已经经历了很多。"

# game/episode013_conversations.rpy:705
translate simplified_chinese ep013_eva_talk_20996018:

    # c "I won't, thanks Eva."
    c "不会的，谢谢伊娃。"

# game/episode013_conversations.rpy:713
translate simplified_chinese ep013_nadya_talk_62f6e65c:

    # c "Hey there, just checking in."
    c "嘿，就是来看看你。"

# game/episode013_conversations.rpy:714
translate simplified_chinese ep013_nadya_talk_53c39a3c:

    # na "Oh, you're already up and about?"
    na "哦，你已经能下床活动了？"

# game/episode013_conversations.rpy:715
translate simplified_chinese ep013_nadya_talk_6150e1fa:

    # c "Yes, lying in bed all day doesn't suit me."
    c "是啊，整天躺在床上不适合我。"

# game/episode013_conversations.rpy:716
translate simplified_chinese ep013_nadya_talk_d1e4e113:

    # c "You sure made use of all the bookcases in your room."
    c "你确实把你房间里的书架都用上了。"

# game/episode013_conversations.rpy:718
translate simplified_chinese ep013_nadya_talk_452bcfa8:

    # na "Yes, I'm quite happy with it, though I've already run out of shelf space."
    na "是啊，我很满意，虽然书架空间已经用完了。"

# game/episode013_conversations.rpy:719
translate simplified_chinese ep013_nadya_talk_d98d7433:

    # na "Caese gifted me several volumes from her own library."
    na "凯瑟从她自己的藏书中送了我几卷。"

# game/episode013_conversations.rpy:720
translate simplified_chinese ep013_nadya_talk_9caa56ec:

    # na "Some of it is Acarhyn history, an interesting but gruesome read."
    na "其中一些是阿卡海茵人的历史，读起来有趣但也很残酷。"

# game/episode013_conversations.rpy:721
translate simplified_chinese ep013_nadya_talk_0da57f1a:

    # c "I can imagine."
    c "我能想象。"

# game/episode013_conversations.rpy:722
translate simplified_chinese ep013_nadya_talk_188287e1:

    # c "Is that what you're reading right now?"
    c "这就是你现在在读的东西吗？"

# game/episode013_conversations.rpy:724
translate simplified_chinese ep013_nadya_talk_58960b70:

    # na "No, I've been cross-referencing some of the research regarding the Scolguin."
    na "不，我一直在交叉参考一些关于斯科尔金人的研究。"

# game/episode013_conversations.rpy:725
translate simplified_chinese ep013_nadya_talk_d3436f5b:

    # c "Anything interesting to share yet?"
    c "有什么有趣的发现可以分享吗？"

# game/episode013_conversations.rpy:726
translate simplified_chinese ep013_nadya_talk_48cce7ba:

    # na "Not yet, as soon as I know more I'll let you all know."
    na "还没有，一旦我知道更多，我会告诉大家的。"

# game/episode013_conversations.rpy:729
translate simplified_chinese ep013_nadya_talk_c8f797c9:

    # na "To be honest, I find it a little hard to concentrate."
    na "说实话，我有点难以集中注意力。"

# game/episode013_conversations.rpy:730
translate simplified_chinese ep013_nadya_talk_6efde394:

    # na "Ever since you went away, things haven't been the same."
    na "自从你离开后，一切都不一样了。"

# game/episode013_conversations.rpy:731
translate simplified_chinese ep013_nadya_talk_f72a446d:

    # na "I mean, I had to tell them, I know I had to."
    na "我的意思是，我必须告诉他们，我知道我必须这样做。"

# game/episode013_conversations.rpy:733
translate simplified_chinese ep013_nadya_talk_60cc1250:

    # na "But Lilly and Aven won't speak to me at all now."
    na "但是莉莉和艾文现在完全不跟我说话了。"

# game/episode013_conversations.rpy:735
translate simplified_chinese ep013_nadya_talk_eae5c5bc:

    # na "The only one who's been a dear has been Eva."
    na "只有伊娃一直对我很亲热。"

# game/episode013_conversations.rpy:737
translate simplified_chinese ep013_nadya_talk_5f06e3e0:

    # c "Yeah, she told me."
    c "是啊，她告诉我了。"

# game/episode013_conversations.rpy:738
translate simplified_chinese ep013_nadya_talk_22f6a66c:

    # c "Aven has a hard time wrapping her head around things."
    c "艾文总是很难想通事情。"

# game/episode013_conversations.rpy:740
translate simplified_chinese ep013_nadya_talk_0ea1d19b:

    # c "That sounds like Eva, alright."
    c "这确实像伊娃会说的话。"

# game/episode013_conversations.rpy:741
translate simplified_chinese ep013_nadya_talk_43cb3ad5:

    # c "I'm sure you and Aven will be on speaking terms again."
    c "我相信你和艾文很快就能重新说话的。"

# game/episode013_conversations.rpy:742
translate simplified_chinese ep013_nadya_talk_7339023b:

    # c "Lilly is headstrong, but I know she loves you, her silence also won't last forever."
    c "莉莉虽然固执，但我知道她爱你，她的沉默也不会永远持续。"

# game/episode013_conversations.rpy:744
translate simplified_chinese ep013_nadya_talk_f8a843b7:

    # na "If you say so."
    na "但愿如此吧。"

# game/episode013_conversations.rpy:745
translate simplified_chinese ep013_nadya_talk_f1299c4d:

    # na "Part of me fears that coming clean wasn’t the best of ideas."
    na "我有点担心坦白真相不是最好的主意。"

# game/episode013_conversations.rpy:747
translate simplified_chinese ep013_nadya_talk_2daa4496:

    # na "Like it has done too much damage, tainted the memories we all have."
    na "感觉这事造成了太多伤害，玷污了我们所有的回忆。"

# game/episode013_conversations.rpy:748
translate simplified_chinese ep013_nadya_talk_2758ff99:

    # na "I just want you to understand I love you all so much."
    na "我只是想让你明白我有多么爱你们所有人。"

# game/episode013_conversations.rpy:750
translate simplified_chinese ep013_nadya_talk_6f48e37b:

    # na "The memory of you being born, Aven a mere ten months later, being pregnant with Eva and Lilly, those images are so dear to me."
    na "你出生时的记忆，仅仅十个月后艾文也降生了，怀着伊娃和莉莉的那些画面，对我来说都无比珍贵。"

# game/episode013_conversations.rpy:752
translate simplified_chinese ep013_nadya_talk_ec07b040:

    # na "To have that all tarnished by recent events..."
    na "这一切都被最近发生的事情玷污了…"

# game/episode013_conversations.rpy:753
translate simplified_chinese ep013_nadya_talk_6eb9eebe:

    # c "Any damage you perceive isn’t irreparable, I’m sure of it."
    c "你所感受到的任何伤害都不是不可挽回的，我对此很确定。"

# game/episode013_conversations.rpy:754
translate simplified_chinese ep013_nadya_talk_c9c6b0e9:

    # c "Aven and Lilly still love you, they’re just very confused at the moment."
    c "艾文和莉莉仍然爱你，她们只是此刻非常困惑。"

# game/episode013_conversations.rpy:755
translate simplified_chinese ep013_nadya_talk_f83ddb4e:

    # c "Healing takes time and effort though and the one thing we shouldn’t do is become strangers to each other."
    c "然而愈合需要时间和努力，我们最不该做的就是变成彼此的陌生人。"

# game/episode013_conversations.rpy:756
translate simplified_chinese ep013_nadya_talk_5fd367fd:

    # c "So in that light I was thinking of throwing a dinner party, with just the five of us together."
    c "所以考虑到这一点，我在考虑举办一场晚宴，只有我们五个人一起。"

# game/episode013_conversations.rpy:758
translate simplified_chinese ep013_nadya_talk_e68bcf63:

    # na "Are you sure that's wise?"
    na "你确定这是个明智的主意吗？"

# game/episode013_conversations.rpy:759
translate simplified_chinese ep013_nadya_talk_644e9cf7:

    # c "Yes, whatever happened, we're still family."
    c "是的，无论发生了什么，我们仍然是一家人。"

# game/episode013_conversations.rpy:761
translate simplified_chinese ep013_nadya_talk_eb7634be:

    # na "Well, in any case, I'll be there."
    na "好吧，不管怎样，我会参加的。"

# game/episode013_conversations.rpy:762
translate simplified_chinese ep013_nadya_talk_4448d179:

    # c "Good!"
    c "太好了！"

# game/episode013_conversations.rpy:765
translate simplified_chinese ep013_nadya_talk_24bff13a:

    # c "I do feel there are some unresolved issues that aren't fit for the dinner table though."
    c "不过我的确觉得有些未解决的问题不适合在晚餐桌上讨论。"

# game/episode013_conversations.rpy:767
translate simplified_chinese ep013_nadya_talk_917b17c6:

    # na "Oh...{w} You mean..."
    na "哦…{w} 你是说…"

# game/episode013_conversations.rpy:768
translate simplified_chinese ep013_nadya_talk_8475d869:

    # c "Yes, the kiss."
    c "没错，那个吻。"

# game/episode013_conversations.rpy:769
translate simplified_chinese ep013_nadya_talk_eeec77c7:

    # c "And not for the first time."
    c "而且不是第一次了。"

# game/episode013_conversations.rpy:771
translate simplified_chinese ep013_nadya_talk_c1271bb2:

    # na "I was confused, that's all."
    na "我当时很困惑，仅此而已。"

# game/episode013_conversations.rpy:772
translate simplified_chinese ep013_nadya_talk_a67fa48a:

    # c "We've talked about this before, right after what happened in the cave on Erigone."
    c "我们之前就谈过这个，就在厄里戈涅星上那个洞穴里的事情发生后。"

# game/episode013_conversations.rpy:774
translate simplified_chinese ep013_nadya_talk_ab640288:

    # na "That was different, everything was different back then!"
    na "那次不一样，那时候一切都不同！"

# game/episode013_conversations.rpy:775
translate simplified_chinese ep013_nadya_talk_4b214a60:

    # c "I'm not so sure about that."
    c "我倒不那么确定。"

# game/episode013_conversations.rpy:776
translate simplified_chinese ep013_nadya_talk_e8d3859b:

    # c "I mean, I didn't know you weren't my aunt back then, but you certainly knew you were my mother."
    c "我的意思是，我当时不知道你不是我阿姨，但你肯定知道你是我的母亲。"

# game/episode013_conversations.rpy:778
translate simplified_chinese ep013_nadya_talk_9cf93891:

    # na "It was the spores..."
    na "是那些孢子…"

# game/episode013_conversations.rpy:779
translate simplified_chinese ep013_nadya_talk_63e6cc41:

    # c "If that's still the excuse you want to hide behind, I'm not stopping you."
    c "如果这仍然是你想用来逃避的借口，我不会阻止你。"

# game/episode013_conversations.rpy:780
translate simplified_chinese ep013_nadya_talk_706d6e73:

    # c "I just want you to know that my feelings for you haven't changed, your revelations notwithstanding."
    c "我只是想让你知道，我对你的感情从未改变，即便知道了你的真实身份也是如此。"

# game/episode013_conversations.rpy:781
translate simplified_chinese ep013_nadya_talk_d57fb92b:

    # c "I love you unconditionally and even more so now that I know you're my mother."
    c "我无条件地爱着你，尤其是在得知你是我母亲后，这份爱更加深厚。"

# game/episode013_conversations.rpy:782
translate simplified_chinese ep013_nadya_talk_b443c32e:

    # c "Please allow yourself some time to consider and I'll be waiting for your answer."
    c "请给自己一些时间考虑，我会等待你的答复。"

# game/episode013_conversations.rpy:784
translate simplified_chinese ep013_nadya_talk_abc4ae49:

    # na "[p_name]...{w} I....{w} Thank you, I will."
    na "[p_name]…{w} 我….{w} 谢谢，我会的。"

# game/episode013_conversations.rpy:786
translate simplified_chinese ep013_nadya_talk_380ce082:

    # c "One thing I want you to know beforehand is that I'm very happy you've told me the truth."
    c "有件事我想让你提前知道，我很高兴你告诉了我真相。"

# game/episode013_conversations.rpy:787
translate simplified_chinese ep013_nadya_talk_3150f0bb:

    # c "It has taken quite a lot of time, but I know and respect how difficult the decision was for you."
    c "虽然这花了相当长的时间，但我理解并尊重这个决定对你来说有多艰难。"

# game/episode013_conversations.rpy:788
translate simplified_chinese ep013_nadya_talk_5752ef6b:

    # c "So if you'll permit me, I would very much like to call you mother."
    c "所以如果你允许的话，我非常想称呼你为母亲。"

# game/episode013_conversations.rpy:790
translate simplified_chinese ep013_nadya_talk_b02f6586:

    # na "Of course, that would mean the world to me!"
    na "当然可以，这对我来说意义非凡！"

# game/episode013_conversations.rpy:792
translate simplified_chinese ep013_nadya_talk_c39ef11c:

    # "Nadya took me in a loving embrace, the burden of years of secrecy suddenly lifted."
    "娜迪亚将我拥入温暖的怀抱，多年隐瞒的重担骤然卸下。"

# game/episode013_conversations.rpy:798
translate simplified_chinese ep013_raene_talk_8e87aab4:

    # ra "You must have heard it a thousand times already, but I’m so glad you’re okay."
    ra "这句话你一定听过千百遍了，但我真的庆幸你平安无事。"

# game/episode013_conversations.rpy:799
translate simplified_chinese ep013_raene_talk_791eb68c:

    # c "Merely glad?"
    c "仅仅只是庆幸？"

# game/episode013_conversations.rpy:801
translate simplified_chinese ep013_raene_talk_bcdcf469:

    # "I pulled her towards me and kissed Raene."
    "我将她拉近，亲吻了蕾妮。"

# game/episode013_conversations.rpy:802
translate simplified_chinese ep013_raene_talk_482e386e:

    # "When we disentangled, her words were a breathless whisper."
    "当我们分开时，她的话语化作急促的轻语。"

# game/episode013_conversations.rpy:804
translate simplified_chinese ep013_raene_talk_86de2e99:

    # ra "I missed you so much."
    ra "我好想你。"

# game/episode013_conversations.rpy:806
translate simplified_chinese ep013_raene_talk_51d9764c:

    # "We kissed again and Raene held me tightly, as if she didn’t want to let go of me anymore."
    "我们再次亲吻，蕾妮紧紧抱着我，仿佛再也不愿放手。"

# game/episode013_conversations.rpy:809
translate simplified_chinese ep013_raene_talk_a88c61e8:

    # "The hunger behind our kisses surprised us both and Raene gasped as our tongues collided."
    "亲吻中涌动的渴望让我们彼此惊讶，当舌尖相触时蕾妮不禁轻喘。"

# game/episode013_conversations.rpy:811
translate simplified_chinese ep013_raene_talk_170df0b3:

    # "As we exchanged a passionate french kiss, I covered the curve of one of her small breasts with my hand."
    "当我们缠绵法式热吻时，我的手覆上了她小巧胸脯的曲线。"

# game/episode013_conversations.rpy:812
translate simplified_chinese ep013_raene_talk_02a41a45:

    # ra "Oh [p_name_short]!"
    ra "哦[p_name_short]！"

# game/episode013_conversations.rpy:814
translate simplified_chinese ep013_raene_talk_c30bc9d4:

    # "Hypnotized, I pressed my body closer against hers."
    "我像被催眠般将身体更紧地贴向她。"

# game/episode013_conversations.rpy:815
translate simplified_chinese ep013_raene_talk_5a04a09f:

    # "I was about to push her gently onto her bed, when I felt the swell of her growing erection against my thigh."
    "我正要将她轻柔地推倒在床，却感觉到她逐渐坚挺的隆起抵着我的大腿。"

# game/episode013_conversations.rpy:817
translate simplified_chinese ep013_raene_talk_d8316ca8:

    # "As soon as Raene also became aware of the sensation, her eyes darted open and she pulled away from me quickly."
    "当蕾妮也意识到这种感觉时，她猛地睁大眼睛，迅速从我身边退开。"

# game/episode013_conversations.rpy:819
translate simplified_chinese ep013_raene_talk_7ef3b148:

    # "Mumbling something apologetic, she tore away from me and ran out of her quarters."
    "她含糊地说了些道歉的话，挣脱我的怀抱冲出了她的舱室。"

# game/episode013_conversations.rpy:820
translate simplified_chinese ep013_raene_talk_8e306f26:

    # c "Raene?!"
    c "蕾妮？！"

# game/episode013_conversations.rpy:822
translate simplified_chinese ep013_raene_talk_d408546f:

    # "I waited in her room for a long while, but Raene didn’t return."
    "我在她房间里等了很久，但蕾妮没有回来。"

# game/episode013_conversations.rpy:823
translate simplified_chinese ep013_raene_talk_863286ae:

    # "Vowing to speak to her later, I left her quarters."
    "我发誓稍后再找她谈谈，便离开了她的舱室。"

# game/episode013_conversations.rpy:831
translate simplified_chinese ep013_raene_second_talk_787b4719:

    # c "Hey you."
    c "嘿，你。"

# game/episode013_conversations.rpy:832
translate simplified_chinese ep013_raene_second_talk_6d9915ab:

    # ra "Hey."
    ra "嘿。"

# game/episode013_conversations.rpy:833
translate simplified_chinese ep013_raene_second_talk_59e8f5b7:

    # c "Are you okay to talk?"
    c "现在方便说话吗？"

# game/episode013_conversations.rpy:835
translate simplified_chinese ep013_raene_second_talk_8fc48ebc:

    # ra "Yes, about earlier...{w} [p_name_short]...{w} I’m sorry..."
    ra "是的，关于之前的事…{w} [p_name_short]…{w} 我很抱歉…"

# game/episode013_conversations.rpy:836
translate simplified_chinese ep013_raene_second_talk_9cf34866:

    # c "No need to apologize, but I’d like to talk to you about it nevertheless."
    c "不用道歉，但我还是想和你谈谈这件事。"

# game/episode013_conversations.rpy:837
translate simplified_chinese ep013_raene_second_talk_2d2d3861:

    # ra "Okay."
    ra "好的。"

# game/episode013_conversations.rpy:839
translate simplified_chinese ep013_raene_second_talk_472ea363:

    # "I sat opposite of her on the bed and looked into her eyes, which wasn’t easy as her gaze shifted nervously."
    "我在床上与她面对面坐下，注视着她的眼睛，这并不容易，因为她的目光紧张地游移着。"

# game/episode013_conversations.rpy:840
translate simplified_chinese ep013_raene_second_talk_ad0f65c4:

    # c "Raene, I really like you."
    c "蕾妮，我真的很喜欢你。"

# game/episode013_conversations.rpy:841
translate simplified_chinese ep013_raene_second_talk_01726e6e:

    # c "And you like me, don’t you?"
    c "你也喜欢我，不是吗？"

# game/episode013_conversations.rpy:843
translate simplified_chinese ep013_raene_second_talk_be0230c1:

    # ra "Yes, I like you very much."
    ra "是的，我非常喜欢你。"

# game/episode013_conversations.rpy:844
translate simplified_chinese ep013_raene_second_talk_8580cc2d:

    # c "It’s clear we both want each other."
    c "很明显我们都想要彼此。"

# game/episode013_conversations.rpy:845
translate simplified_chinese ep013_raene_second_talk_97e7cc17:

    # c "But what happened earlier has made it clear you’re held back for some reason."
    c "但之前发生的事情表明，你因为某种原因在克制自己。"

# game/episode013_conversations.rpy:847
translate simplified_chinese ep013_raene_second_talk_395d0514:

    # ra "I...{w} That is...{w} Yes."
    ra "我…{w} 那个…{w} 是的。"

# game/episode013_conversations.rpy:849
translate simplified_chinese ep013_raene_second_talk_093d7eb5:

    # ra "For the longest time, people have expressed their discomfort with me, with who I want to be."
    ra "长久以来，人们都对我、对我想要成为的样子表现出不适。"

# game/episode013_conversations.rpy:850
translate simplified_chinese ep013_raene_second_talk_4f2a582e:

    # ra "And now, when you and I are getting serious and ready to take the next step, I became conscious of that discomfort again."
    ra "而现在，当你我关系变得认真，准备迈出下一步时，我又意识到那种不适感。"

# game/episode013_conversations.rpy:851
translate simplified_chinese ep013_raene_second_talk_7ea068c1:

    # ra "Like I’m not allowed to feel the things I feel, if you know what I mean."
    ra "就好像我不被允许感受自己的真实感受，如果你明白我的意思。"

# game/episode013_conversations.rpy:852
translate simplified_chinese ep013_raene_second_talk_3275e9ef:

    # c "I think so."
    c "我想我明白。"

# game/episode013_conversations.rpy:853
translate simplified_chinese ep013_raene_second_talk_4306aa6a:

    # c "The way your body reacts makes you too self-conscious?"
    c "你身体的反应让你太过自我意识了？"

# game/episode013_conversations.rpy:854
translate simplified_chinese ep013_raene_second_talk_3f1ad54f:

    # ra "That too."
    ra "也有这个原因。"

# game/episode013_conversations.rpy:856
translate simplified_chinese ep013_raene_second_talk_0027e6ec:

    # ra "When I was so close to you and things started...{w} happening...{w} I was suddenly afraid you’d be repulsed, or something."
    ra "当我如此靠近你，事情开始…{w}发生…{w}我突然害怕你会感到厌恶，或是别的什么。"

# game/episode013_conversations.rpy:857
translate simplified_chinese ep013_raene_second_talk_479dbcc5:

    # c "I can only say that I love the person you are, Raene."
    c "我只能说，我爱你这个人，蕾妮。"

# game/episode013_conversations.rpy:858
translate simplified_chinese ep013_raene_second_talk_dd83c95f:

    # c "I’m not sure how I can make you truly believe that, but I’m willing to try."
    c "我不确定怎样才能让你真正相信这一点，但我愿意尝试。"

# game/episode013_conversations.rpy:860
translate simplified_chinese ep013_raene_second_talk_d1a5955d:

    # ra "Me too."
    ra "我也是。"

# game/episode013_conversations.rpy:873
translate simplified_chinese ep013_celine_talk_15761528:

    # ce "It's so good to see you up and about."
    ce "看到你起来走动真是太好了。"

# game/episode013_conversations.rpy:874
translate simplified_chinese ep013_celine_talk_baa13475:

    # ce "Why are you looking at me like that?"
    ce "你为什么那样看着我？"

# game/episode013_conversations.rpy:875
translate simplified_chinese ep013_celine_talk_5c84cc48:

    # ce "Is something the matter?"
    ce "出什么事了吗？"

# game/episode013_conversations.rpy:876
translate simplified_chinese ep013_celine_talk_efd090e2:

    # c "Céline, we need to talk, about you and me."
    c "瑟琳，我们需要谈谈，关于你和我。"

# game/episode013_conversations.rpy:878
translate simplified_chinese ep013_celine_talk_3bdd7b97:

    # ce "Oh?"
    ce "哦？"

# game/episode013_conversations.rpy:879
translate simplified_chinese ep013_celine_talk_57cae3c7:

    # c "It's not working for me anymore."
    c "这对我来说已经行不通了。"

# game/episode013_conversations.rpy:880
translate simplified_chinese ep013_celine_talk_06c84469:

    # c "I've come to realize my feelings for you aren't as strong as they once were."
    c "我意识到我对你的感情不再像从前那样强烈了。"

# game/episode013_conversations.rpy:881
translate simplified_chinese ep013_celine_talk_67e47fe9:

    # ce "This can't be right."
    ce "这不可能。"

# game/episode013_conversations.rpy:882
translate simplified_chinese ep013_celine_talk_f131cf82:

    # ce "Are you feeling alright, did something happen back on your father's ship?"
    ce "你还好吗，是在你父亲的船上发生了什么吗？"

# game/episode013_conversations.rpy:883
translate simplified_chinese ep013_celine_talk_f5b35eee:

    # c "Nothing happened."
    c "什么都没发生。"

# game/episode013_conversations.rpy:884
translate simplified_chinese ep013_celine_talk_5f0b7414:

    # c "My feelings towards you have just changed."
    c "我对你的感情已经变了。"

# game/episode013_conversations.rpy:886
translate simplified_chinese ep013_celine_talk_21957598:

    # ce "What about all those nights we spent together?!"
    ce "那我们共度的那些夜晚又算什么？！"

# game/episode013_conversations.rpy:887
translate simplified_chinese ep013_celine_talk_480c773b:

    # ce "You're lying, I can see it in your eyes!"
    ce "你在说谎，我从你眼神里就能看出来！"

# game/episode013_conversations.rpy:888
translate simplified_chinese ep013_celine_talk_f33dc7b4:

    # ce "You're lying to me, to yourself."
    ce "你在欺骗我，也在欺骗你自己。"

# game/episode013_conversations.rpy:889
translate simplified_chinese ep013_celine_talk_dad94cdb:

    # c "I have to end things, there's no other way."
    c "我必须结束这段关系，没有别的选择。"

# game/episode013_conversations.rpy:890
translate simplified_chinese ep013_celine_talk_e0342ec2:

    # ce "What happened?"
    ce "到底发生了什么？"

# game/episode013_conversations.rpy:891
translate simplified_chinese ep013_celine_talk_f2f16b6b:

    # c "I've found someone else, that's all I can say."
    c "我遇到了别人，我只能说这么多。"

# game/episode013_conversations.rpy:893
translate simplified_chinese ep013_celine_talk_8fc38651:

    # ce "And she's making you do this?"
    ce "是她在逼你这么做吗？"

# game/episode013_conversations.rpy:894
translate simplified_chinese ep013_celine_talk_6ec5eda3:

    # ce "What we had was true, [p_name_short], and you're throwing it all away."
    ce "我们曾经的感情是真实的，[p_name_short]，而你现在要把它全部抛弃。"

# game/episode013_conversations.rpy:895
translate simplified_chinese ep013_celine_talk_58002698:

    # ce "Who's making you do this?"
    ce "是谁在逼你这么做？"

# game/episode013_conversations.rpy:896
translate simplified_chinese ep013_celine_talk_08d4720b:

    # c "I can't tell."
    c "我不能说。"

# game/episode013_conversations.rpy:898
translate simplified_chinese ep013_celine_talk_f90fa858:

    # ce "Coward!"
    ce "懦夫！"

# game/episode013_conversations.rpy:899
translate simplified_chinese ep013_celine_talk_d3e290cc:

    # ce "I demand you tell me."
    ce "我命令你告诉我。"

# game/episode013_conversations.rpy:900
translate simplified_chinese ep013_celine_talk_c318e691:

    # ce "I have a right to know!"
    ce "我有权知道！"

# game/episode013_conversations.rpy:901
translate simplified_chinese ep013_celine_talk_b1961263:

    # c "No, you don't."
    c "不，你没有。"

# game/episode013_conversations.rpy:902
translate simplified_chinese ep013_celine_talk_55079b6b:

    # c "I'm sorry, Céline."
    c "对不起，瑟琳。"

# game/episode013_conversations.rpy:903
translate simplified_chinese ep013_celine_talk_e4326d46:

    # "Unable to comfort her in any way, I walked out of Céline's quarters."
    "我无法以任何方式安慰她，走出了瑟琳的房间。"

# game/episode013_conversations.rpy:905
translate simplified_chinese ep013_celine_talk_6aeb82fb:

    # ce "She won't make you happy!"
    ce "她不会让你幸福的！"

# game/episode013_conversations.rpy:906
translate simplified_chinese ep013_celine_talk_d19301fd:

    # ce "I'm the one for you, [p_name_short]."
    ce "我才是适合你的人，[p_name_short]。"

# game/episode013_conversations.rpy:907
translate simplified_chinese ep013_celine_talk_054cf9c4:

    # ce "I'm the only one who can make you happy."
    ce "我才是唯一能让你幸福的人。"

# game/episode013_conversations.rpy:908
translate simplified_chinese ep013_celine_talk_4efe6d8b:

    # ce "Come back, please!"
    ce "求求你回来！"

# game/episode013_conversations.rpy:910
translate simplified_chinese ep013_celine_talk_cac034fc:

    # "I hurried through the corridors of the ship, away from her increasingly desperate pleas."
    "我匆忙穿过飞船的走廊，远离她愈发绝望的恳求。"

# game/episode013_conversations.rpy:914
translate simplified_chinese ep013_celine_talk_c0e2ed51:

    # c "Do you fancy a night cap in my quarters?"
    c "要不要来我房间喝杯睡前酒？"

# game/episode013_conversations.rpy:916
translate simplified_chinese ep013_celine_talk_9e6cce2a:

    # ce "I'd love to."
    ce "我很乐意。"

# game/episode013_conversations.rpy:918
translate simplified_chinese ep013_celine_talk_49924f8b:

    # ce "Also, I have a surprise for you."
    ce "另外，我还为你准备了惊喜。"

# game/episode013_conversations.rpy:919
translate simplified_chinese ep013_celine_talk_9f6ba1db:

    # c "Just know that I can't wait to unwrap you."
    c "要知道我已经等不及要拆开你了。"

# game/episode013_conversations.rpy:920
translate simplified_chinese ep013_celine_talk_d45c39c5:

    # ce "Lead the way then."
    ce "那就带路吧。"

# game/episode013_conversations.rpy:922
translate simplified_chinese ep013_celine_talk_adc1c75f:

    # "When we arrived at my quarters, all thoughts of having a drink were forgotten in an instant."
    "当我们抵达我的房间时，所有关于喝酒的念头瞬间被抛到脑后。"

# game/episode013_conversations.rpy:931
translate simplified_chinese ep013_celine_second_talk_a08e6bbf:

    # c "So, what happened on Douvis between you and Lilly?"
    c "那么，你和莉莉在杜维斯星上发生了什么？"

# game/episode013_conversations.rpy:933
translate simplified_chinese ep013_celine_second_talk_b461db25:

    # ce "We were carrying a crate of supplies back to the ship."
    ce "我们当时正搬着一箱补给品回飞船。"

# game/episode013_conversations.rpy:934
translate simplified_chinese ep013_celine_second_talk_215a2430:

    # ce "Lilly didn't seem to care about my pace and I couldn't keep up with her."
    ce "莉莉似乎毫不在意我的步调，我跟不上她的速度。"

# game/episode013_conversations.rpy:935
translate simplified_chinese ep013_celine_second_talk_2213ab70:

    # ce "So the crate slipped out of my hand and fell to the floor."
    ce "于是箱子从我手中滑落，掉在了地上。"

# game/episode013_conversations.rpy:936
translate simplified_chinese ep013_celine_second_talk_b41917a3:

    # ce "That's when she started yelling and insulting me."
    ce "她就是从那时开始对我大喊大叫，还辱骂我。"

# game/episode013_conversations.rpy:937
translate simplified_chinese ep013_celine_second_talk_18c39d82:

    # ce "I really don't know what got into her, she's never yelled at me like that."
    ce "我真不知道她到底怎么了，她以前从没那样吼过我。"

# game/episode013_conversations.rpy:938
translate simplified_chinese ep013_celine_second_talk_4387e8d3:

    # c "I told Lilly everything about you and me."
    c "我把关于你和我的一切都告诉莉莉了。"

# game/episode013_conversations.rpy:940
translate simplified_chinese ep013_celine_second_talk_3bdd7b97:

    # ce "Oh?"
    ce "哦？"

# game/episode013_conversations.rpy:941
translate simplified_chinese ep013_celine_second_talk_860fe87c:

    # ce "And because of that she's angry at me?"
    ce "就因为这个她生我的气？"

# game/episode013_conversations.rpy:942
translate simplified_chinese ep013_celine_second_talk_975f9871:

    # c "Jealousy."
    c "嫉妒。"

# game/episode013_conversations.rpy:944
translate simplified_chinese ep013_celine_second_talk_635727e5:

    # ce "Jealousy, but she's your sister?"
    ce "嫉妒？可她是你妹妹啊？"

# game/episode013_conversations.rpy:945
translate simplified_chinese ep013_celine_second_talk_0a09d539:

    # c "She is."
    c "是的。"

# game/episode013_conversations.rpy:947
translate simplified_chinese ep013_celine_second_talk_daa24cc8:

    # ce "Jealousy?"
    ce "嫉妒？"

# game/episode013_conversations.rpy:949
translate simplified_chinese ep013_celine_second_talk_12d2e699:

    # ce "So why is she jealous?"
    ce "那她为什么嫉妒？"

# game/episode013_conversations.rpy:950
translate simplified_chinese ep013_celine_second_talk_c9fc2a0b:

    # ce "Does she think we aren't a good match?"
    ce "她认为我们不般配吗？"

# game/episode013_conversations.rpy:951
translate simplified_chinese ep013_celine_second_talk_98b9b44f:

    # ce "I've never known her to be so possessive."
    ce "我从不知道她占有欲这么强。"

# game/episode013_conversations.rpy:952
translate simplified_chinese ep013_celine_second_talk_b7ecd7cf:

    # c "No, it's not that."
    c "不，不是那样。"

# game/episode013_conversations.rpy:954
translate simplified_chinese ep013_celine_second_talk_8e3fe1f5:

    # ce "What's the reason then?"
    ce "那是什么原因？"

# game/episode013_conversations.rpy:955
translate simplified_chinese ep013_celine_second_talk_82174601:

    # ce "..."
    ce "..."

# game/episode013_conversations.rpy:957
translate simplified_chinese ep013_celine_second_talk_cc189b99:

    # ce "Oh...{w} No, that can't be it."
    ce "哦…{w} 不，不可能是那样。"

# game/episode013_conversations.rpy:958
translate simplified_chinese ep013_celine_second_talk_b8b60340:

    # ce "Is Lilly in love with you?"
    ce "莉莉爱上你了？"

# game/episode013_conversations.rpy:960
translate simplified_chinese ep013_celine_second_talk_1bec0e5b:

    # ce "Some weird confused love, or something?"
    ce "某种奇怪的混乱的爱，还是什么？"

# game/episode013_conversations.rpy:961
translate simplified_chinese ep013_celine_second_talk_df360a05:

    # c "Yes, she is."
    c "是的，她确实爱我。"

# game/episode013_conversations.rpy:963
translate simplified_chinese ep013_celine_second_talk_39eb3a72:

    # ce "What?!"
    ce "什么？！"

# game/episode013_conversations.rpy:964
translate simplified_chinese ep013_celine_second_talk_995c3845:

    # ce "Are you telling me you're both in love with each other?"
    ce "你是说你们俩相爱了？"

# game/episode013_conversations.rpy:965
translate simplified_chinese ep013_celine_second_talk_b63d6bf3:

    # c "I am."
    c "是的。"

# game/episode013_conversations.rpy:967
translate simplified_chinese ep013_celine_second_talk_33a9d460:

    # ce "But [p_name]..."
    ce "但是[p_name]…"

# game/episode013_conversations.rpy:969
translate simplified_chinese ep013_celine_second_talk_6b55b98a:

    # ce "I don't need to point out that you're...{w} you're brother and sister."
    ce "我不需要提醒你…{w}你们是兄妹。"

# game/episode013_conversations.rpy:970
translate simplified_chinese ep013_celine_second_talk_2129d2cd:

    # ce "[p_name]?"
    ce "[p_name]?"

# game/episode013_conversations.rpy:971
translate simplified_chinese ep013_celine_second_talk_f4d72466:

    # c "Yes, we're brother and sister, but also lovers."
    c "是的，我们是兄妹，但也是恋人。"

# game/episode013_conversations.rpy:973
translate simplified_chinese ep013_celine_second_talk_12f04d2a:

    # ce "You've acted on those feelings?!"
    ce "你们已经付诸行动了？！"

# game/episode013_conversations.rpy:974
translate simplified_chinese ep013_celine_second_talk_8d740489:

    # c "We have."
    c "是的。"

# game/episode013_conversations.rpy:976
translate simplified_chinese ep013_celine_second_talk_b624faf9:

    # "Céline fell back into her seat, looking incredulously at me."
    "瑟琳跌坐回座位，难以置信地看着我。"

# game/episode013_conversations.rpy:977
translate simplified_chinese ep013_celine_second_talk_b1d36a78:

    # ce "I can't believe what I'm hearing."
    ce "我简直不敢相信听到的话。"

# game/episode013_conversations.rpy:978
translate simplified_chinese ep013_celine_second_talk_e2efc8e2:

    # ce "First you ask me to accept other women in our relationship and now you're telling me you're having an incestuous affair?!"
    ce "先是让我接受我们关系中的其他女人，现在又告诉我你在搞乱伦关系？！"

# game/episode013_conversations.rpy:980
translate simplified_chinese ep013_celine_second_talk_8c1461cd:

    # ce "I knew you were not like other men, but this is too much even for you."
    ce "我知道你和其他男人不一样，但这对你来说也太过分了。"

# game/episode013_conversations.rpy:981
translate simplified_chinese ep013_celine_second_talk_5af812f4:

    # c "I'd understand it if you don't want anything to do with me anymore."
    c "如果你不想再和我有任何关系，我能理解。"

# game/episode013_conversations.rpy:982
translate simplified_chinese ep013_celine_second_talk_afdf0e73:

    # c "All I ask is for your discretion."
    c "我只求你谨慎行事。"

# game/episode013_conversations.rpy:983
translate simplified_chinese ep013_celine_second_talk_d492d0f8:

    # c "Both Lilly and me accept our feelings wholeheartedly, there's no coercion of any kind."
    c "莉莉和我都全心全意接受我们的感情，没有任何形式的强迫。"

# game/episode013_conversations.rpy:984
translate simplified_chinese ep013_celine_second_talk_d8d968cc:

    # c "What we don't want is to have the taboo taint our relationship."
    c "我们不希望因为禁忌而玷污我们的关系。"

# game/episode013_conversations.rpy:986
translate simplified_chinese ep013_celine_second_talk_032d1bdc:

    # ce "Is it that easy for you?"
    ce "对你来说就这么简单吗？"

# game/episode013_conversations.rpy:987
translate simplified_chinese ep013_celine_second_talk_e97010ea:

    # ce "To accept cheating on your girlfriend and having a sexual relationship with your own sister?"
    ce "接受背叛女友还和自己亲妹妹发生性关系？"

# game/episode013_conversations.rpy:988
translate simplified_chinese ep013_celine_second_talk_cef08459:

    # c "I can assure you it's not easy, but it's the truth."
    c "我可以向你保证这并不容易，但这就是事实。"

# game/episode013_conversations.rpy:989
translate simplified_chinese ep013_celine_second_talk_2daada57:

    # c "Again, if you don't want anything to do with me or Lilly, just tell me."
    c "再说一次，如果你不想再和我或莉莉有任何关系，直接告诉我。"

# game/episode013_conversations.rpy:991
translate simplified_chinese ep013_celine_second_talk_63bf29b6:

    # ce "Your own sister, [p_name]... How could you?"
    ce "你自己的亲妹妹，[p_name]…你怎么能这样？"

# game/episode013_conversations.rpy:993
translate simplified_chinese ep013_celine_second_talk_bac99fde:

    # c "Right, if that's all you have to say, it might be better if I just leave you alone for a while."
    c "好吧，如果你只有这些话要说，也许我暂时让你一个人待着更好。"

# game/episode013_conversations.rpy:996
translate simplified_chinese ep013_celine_second_talk_bac99fde_1:

    # c "Right, if that's all you have to say, it might be better if I just leave you alone for a while."
    c "好吧，如果你只有这些话要说，也许我暂时让你一个人待着更好。"

# game/episode013_conversations.rpy:998
translate simplified_chinese ep013_celine_second_talk_71e7f2a3:

    # ce "No, [p_name_short], wait."
    ce "不，[p_name_short]，等等。"

# game/episode013_conversations.rpy:999
translate simplified_chinese ep013_celine_second_talk_993c30f1:

    # ce "You say you love her?"
    ce "你说你爱她？"

# game/episode013_conversations.rpy:1000
translate simplified_chinese ep013_celine_second_talk_3a04d409:

    # c "As much as I love you."
    c "就像我爱你一样深。"

# game/episode013_conversations.rpy:1002
translate simplified_chinese ep013_celine_second_talk_e2176918:

    # ce "Could you give me time to think on all this?"
    ce "你能给我点时间好好想想这一切吗？"

# game/episode013_conversations.rpy:1003
translate simplified_chinese ep013_celine_second_talk_044bfefb:

    # c "Of course, as long as you'd like."
    c "当然，你想考虑多久都可以。"

# game/episode013_conversations.rpy:1005
translate simplified_chinese ep013_celine_second_talk_dfd6bad2:

    # ce "Thank you, [p_name_short]."
    ce "谢谢你，[p_name_short]。"

# game/episode013_conversations.rpy:1006
translate simplified_chinese ep013_celine_second_talk_f6ca3bab:

    # ce "It's a lot to process and I still don't know exactly how I feel about all this."
    ce "这需要很多时间来消化，而且我仍然不确定自己对此到底是什么感受。"

# game/episode013_conversations.rpy:1007
translate simplified_chinese ep013_celine_second_talk_47514f2b:

    # ce "I will keep your secret in any case, for both Lilly's and your sake."
    ce "无论如何我都会保守你的秘密，为了莉莉也为了你。"

# game/episode013_conversations.rpy:1008
translate simplified_chinese ep013_celine_second_talk_e897fbb0:

    # c "Thank you."
    c "谢谢。"

# game/episode013_conversations.rpy:1011
translate simplified_chinese ep013_celine_second_talk_37ef48ed:

    # ce "Get out of my sight."
    ce "从我眼前消失。"

# game/episode013_conversations.rpy:1012
translate simplified_chinese ep013_celine_second_talk_f6847571:

    # ce "I will keep your secret, more for Lilly's sake than yours."
    ce "我会保守你的秘密，更多是为了莉莉而非你。"

# game/episode013_conversations.rpy:1013
translate simplified_chinese ep013_celine_second_talk_396dd9aa:

    # ce "Know this though, I'm utterly disgusted by the both of you."
    ce "但你要知道，我对你们两个都感到极其恶心。"

# game/episode013_conversations.rpy:1014
translate simplified_chinese ep013_celine_second_talk_3c24304b:

    # ce "Now leave."
    ce "现在离开。"

# game/episode013_conversations.rpy:1015
translate simplified_chinese ep013_celine_second_talk_b043ce3d:

    # "I could hear her crying as I left the bridge."
    "我离开舰桥时能听到她在哭泣。"

# game/episode013_conversations.rpy:1016
translate simplified_chinese ep013_celine_second_talk_8760f33c:

    # "The look on her face just before told volumes, Céline would never be back in my arms."
    "她方才脸上的表情说明了一切，瑟琳永远不会再回到我的怀抱。"

# game/episode013_conversations.rpy:1020
translate simplified_chinese ep013_celine_second_talk_a4ec4a8d:

    # c "I told you there were others."
    c "我告诉过你还有其他人。"

# game/episode013_conversations.rpy:1021
translate simplified_chinese ep013_celine_second_talk_6b5f218d:

    # ce "I knew you were honest with me before, I just hadn't realized what you meant exactly."
    ce "我知道你之前对我很诚实，只是我没完全明白你的意思。"

# game/episode013_conversations.rpy:1023
translate simplified_chinese ep013_celine_second_talk_d62666d3:

    # ce "You told me there were other women, I just didn't think it was one of my best friends."
    ce "你告诉过我还有其他女人，我只是没想到会是我最好的朋友之一。"

# game/episode013_conversations.rpy:1024
translate simplified_chinese ep013_celine_second_talk_bd2e5678:

    # c "I should have told you."
    c "我本应该告诉你的。"

# game/episode013_conversations.rpy:1025
translate simplified_chinese ep013_celine_second_talk_1876e912:

    # ce "No, I know you were trying not to hurt me by telling me all the details."
    ce "不，我知道你是为了避免伤害我才没有告诉我所有细节。"

# game/episode013_conversations.rpy:1026
translate simplified_chinese ep013_celine_second_talk_79d637af:

    # c "But does it change things between us?"
    c "但这会改变我们之间的关系吗？"

# game/episode013_conversations.rpy:1028
translate simplified_chinese ep013_celine_second_talk_91dfae06:

    # ce "I don't know."
    ce "我不知道。"

# game/episode013_conversations.rpy:1029
translate simplified_chinese ep013_celine_second_talk_91dd95e3:

    # ce "All I know is that I want to keep seeing you."
    ce "我只知道我还想继续和你见面。"

# game/episode013_conversations.rpy:1031
translate simplified_chinese ep013_celine_second_talk_cf3bf54d:

    # ce "I just need a little space, to figure out how to deal with all this."
    ce "我只是需要一点空间，来想清楚该如何处理这一切。"

# game/episode013_conversations.rpy:1032
translate simplified_chinese ep013_celine_second_talk_ac88ff90:

    # ce "Do you think Lilly is willing to talk to me?"
    ce "你觉得莉莉愿意和我谈谈吗？"

# game/episode013_conversations.rpy:1033
translate simplified_chinese ep013_celine_second_talk_4f7c2a96:

    # c "I think so, yes."
    c "我想是的，她愿意。"

# game/episode013_conversations.rpy:1034
translate simplified_chinese ep013_celine_second_talk_7956643a:

    # c "She was a little embarrassed by her behavior earlier."
    c "她对自己之前的行为感到有些尴尬。"

# game/episode013_conversations.rpy:1035
translate simplified_chinese ep013_celine_second_talk_f692a01c:

    # ce "In that case I'll talk to her."
    ce "既然如此，我会和她谈谈。"

# game/episode013_conversations.rpy:1036
translate simplified_chinese ep013_celine_second_talk_d480f87a:

    # c "I'm glad to hear that."
    c "很高兴听你这么说。"

# game/episode013_conversations.rpy:1038
translate simplified_chinese ep013_celine_second_talk_bd2e5678_1:

    # c "I should have told you."
    c "我本该告诉你的。"

# game/episode013_conversations.rpy:1040
translate simplified_chinese ep013_celine_second_talk_f1c5a5de:

    # ce "Damn right you should have."
    ce "你他妈当然该告诉我。"

# game/episode013_conversations.rpy:1041
translate simplified_chinese ep013_celine_second_talk_f754a548:

    # ce "What were you thinking, [p_name], fucking around behind my back?"
    ce "你到底在想什么，[p_name]，背着我乱搞？"

# game/episode013_conversations.rpy:1042
translate simplified_chinese ep013_celine_second_talk_92f49063:

    # ce "With my best friend no less!"
    ce "而且还是和我最好的朋友！"

# game/episode013_conversations.rpy:1043
translate simplified_chinese ep013_celine_second_talk_c76dcf18:

    # ce "Get out of my sight!"
    ce "从我眼前消失！"

# game/episode013_conversations.rpy:1044
translate simplified_chinese ep013_celine_second_talk_a9696d54:

    # c "Céline-"
    c "瑟琳—"

# game/episode013_conversations.rpy:1046
translate simplified_chinese ep013_celine_second_talk_2ab85dd8:

    # ce "Leave!"
    ce "滚开！"

# game/episode013_conversations.rpy:1048
translate simplified_chinese ep013_celine_second_talk_b043ce3d_1:

    # "I could hear her crying as I left the bridge."
    "我离开舰桥时能听见她的啜泣声。"

# game/episode013_conversations.rpy:1049
translate simplified_chinese ep013_celine_second_talk_8760f33c_1:

    # "The look on her face just before told volumes, Céline would never be back in my arms."
    "她刚才的表情说明了一切，瑟琳再也不会回到我的怀抱。"

# game/episode013_conversations.rpy:1059
translate simplified_chinese ep013_jade_talk_d3486d5c:

    # c "Did you have a good talk with that woman on the station?"
    c "你和空间站上那位女士谈得还好吗？"

# game/episode013_conversations.rpy:1060
translate simplified_chinese ep013_jade_talk_5e0d680f:

    # j "I did, I think she was very pleased that I had more questions."
    j "谈得很好，我觉得她很高兴我有更多问题。"

# game/episode013_conversations.rpy:1062
translate simplified_chinese ep013_jade_talk_3d46a554:

    # j "She told me my mother often received Twi’ll refugees from Luclite during her exile on Paclerara."
    j "她告诉我，我母亲在帕克莱拉拉流放期间经常收留来自卢克莱特的特维尔难民。"

# game/episode013_conversations.rpy:1063
translate simplified_chinese ep013_jade_talk_bafdbd1f:

    # c "They came to pay their respects to their queen?"
    c "他们是来向女王表达敬意的吗？"

# game/episode013_conversations.rpy:1065
translate simplified_chinese ep013_jade_talk_46ea80c1:

    # j "Probably, yes."
    j "很可能，是的。"

# game/episode013_conversations.rpy:1066
translate simplified_chinese ep013_jade_talk_77625e5c:

    # j "According to M’aene, my mother helped them get their lives back on track."
    j "据玛埃内说，我母亲帮助他们重新走上正轨。"

# game/episode013_conversations.rpy:1067
translate simplified_chinese ep013_jade_talk_c2f70673:

    # j "Part of the reason pilgrims still visit her shrine is because of the help she provided after her exile."
    j "朝圣者至今仍去她的神殿参拜，部分原因就是她在流放后提供的帮助。"

# game/episode013_conversations.rpy:1068
translate simplified_chinese ep013_jade_talk_ad5b5481:

    # c "That must have been a great thing to learn about her."
    c "能了解到她这些事一定很棒。"

# game/episode013_conversations.rpy:1070
translate simplified_chinese ep013_jade_talk_32319cf3:

    # j "Yes, very much so."
    j "是的，确实如此。"

# game/episode013_conversations.rpy:1071
translate simplified_chinese ep013_jade_talk_075a88a3:

    # c "Was your family much loved on Luclite?"
    c "你的家族在卢克莱特很受爱戴吗？"

# game/episode013_conversations.rpy:1073
translate simplified_chinese ep013_jade_talk_32a6b806:

    # j "Ours was a very minor kingdom in a remote part of Luclite, the populace wasn’t very large."
    j "我们只是卢克莱特偏远地区的一个小王国，人口并不多。"

# game/episode013_conversations.rpy:1074
translate simplified_chinese ep013_jade_talk_d277e821:

    # j "Still, I think my mother and father were loved for the good they did for the community."
    j "不过，我认为我的父母因为对社区的贡献而受到爱戴。"

# game/episode013_conversations.rpy:1075
translate simplified_chinese ep013_jade_talk_03410bda:

    # j "We lived in a palace with servants before the occupation though, so I’m sure there were a great many people who hated us."
    j "但在被占领前，我们住在有仆人的宫殿里，所以肯定有很多人憎恨我们。"

# game/episode013_conversations.rpy:1076
translate simplified_chinese ep013_jade_talk_a7dd8304:

    # c "Still, it’s good to know your mother continued to help people even when she didn’t have the benefits of a castle and treasure chest."
    c "尽管如此，知道你母亲即使失去了城堡和财宝仍继续帮助他人，这很好。"

# game/episode013_conversations.rpy:1078
translate simplified_chinese ep013_jade_talk_2246657b:

    # j "That’s right."
    j "没错。"

# game/episode013_conversations.rpy:1080
translate simplified_chinese ep013_jade_talk_042badd1:

    # j "I’d really want to visit that shrine on Paclerara, do you think we’ll be able to?"
    j "我真的很想去帕克莱拉拉的那座神社看看，你觉得我们能去吗？"

# game/episode013_conversations.rpy:1081
translate simplified_chinese ep013_jade_talk_41c85010:

    # c "Yes, I’ll make sure we visit that planet in the very near future."
    c "会的，我保证我们很快就会去那颗星球。"

# game/episode013_conversations.rpy:1083
translate simplified_chinese ep013_jade_talk_86825a47:

    # j "Thank you so much!"
    j "太感谢你了！"

# game/episode013_conversations.rpy:1091
translate simplified_chinese ep013_vess_talk_be6e619f:

    # ve "Hey [p_name]."
    ve "嘿，[p_name]。"

# game/episode013_conversations.rpy:1093
translate simplified_chinese ep013_vess_talk_e872a5fd:

    # c "Hey Vess."
    c "嘿，薇丝。"

# game/episode013_conversations.rpy:1094
translate simplified_chinese ep013_vess_talk_80ee71d4:

    # c "I heard you volunteered to rescue me."
    c "我听说你自愿来救我。"

# game/episode013_conversations.rpy:1096
translate simplified_chinese ep013_vess_talk_324bc75c:

    # ve "I did, yes."
    ve "是的，我确实这么做了。"

# game/episode013_conversations.rpy:1099
translate simplified_chinese mod_vess_servant_path_start_b79b3488:

    # c "Throwing your life on the line for me doesn't change how I feel about you, do you realize that?"
    c "为我冒生命危险并不能改变我对你的看法，你明白吗？"

# game/episode013_conversations.rpy:1101
translate simplified_chinese mod_vess_servant_path_start_2fd74067:

    # ve "I do."
    ve "我明白。"

# game/episode013_conversations.rpy:1102
translate simplified_chinese mod_vess_servant_path_start_f2718947:

    # c "You should have been spaced for your betrayal."
    c "就凭你的背叛行径，本该被抛进太空处决。"

# game/episode013_conversations.rpy:1107
translate simplified_chinese mod_vess_servant_path_start_bafa8287:

    # c "In light of your recent actions, I want to make you an offer."
    c "考虑到你近期的行动，我想给你一个提议。"

# game/episode013_conversations.rpy:1108
translate simplified_chinese mod_vess_servant_path_start_89993f42:

    # c "You can choose to stay here in the brig and you'll be fed and put to work if necessary."
    c "你可以选择继续待在禁闭室里，必要时会给你食物并安排工作。"

# game/episode013_conversations.rpy:1109
translate simplified_chinese mod_vess_servant_path_start_cdd0b3cd:

    # c "Or you could agree to become my servant."
    c "或者你可以同意成为我的仆人。"

# game/episode013_conversations.rpy:1111
translate simplified_chinese mod_vess_servant_path_start_c82d0968:

    # ve "Servant?"
    ve "仆人？"

# game/episode013_conversations.rpy:1112
translate simplified_chinese mod_vess_servant_path_start_7a165ed9:

    # c "As my servant you'll be allowed out of the brig under constant surveillance."
    c "作为我的仆人，你将在持续监视下离开禁闭室。"

# game/episode013_conversations.rpy:1113
translate simplified_chinese mod_vess_servant_path_start_e962ab98:

    # c "You will be part of the crew again, for all intents and purposes."
    c "在所有意义上，你将重新成为船员的一份子。"

# game/episode013_conversations.rpy:1114
translate simplified_chinese mod_vess_servant_path_start_67bffd4d:

    # c "In return, you'll attend to my every need and by that I mean every need."
    c "作为回报，你要满足我的所有需求，我说的是所有需求。"

# game/episode013_conversations.rpy:1115
translate simplified_chinese mod_vess_servant_path_start_3e733799:

    # c "Do you understand what I'm proposing?"
    c "你明白我在提议什么吗？"

# game/episode013_conversations.rpy:1117
translate simplified_chinese mod_vess_servant_path_start_edeaaba4:

    # ve "I-I think so."
    ve "我-我想是的。"

# game/episode013_conversations.rpy:1118
translate simplified_chinese mod_vess_servant_path_start_918acc81:

    # ve "Am I to have sex with you?"
    ve "我要和你发生关系吗？"

# game/episode013_conversations.rpy:1119
translate simplified_chinese mod_vess_servant_path_start_bc9e8d48:

    # c "Yes, whenever I want."
    c "是的，只要我想要。"

# game/episode013_conversations.rpy:1120
translate simplified_chinese mod_vess_servant_path_start_bec83061:

    # c "But if I want to share you with twenty friends, you'll service them each and every one."
    c "但如果我想和二十个朋友分享你，你就得挨个伺候他们每个人。"

# game/episode013_conversations.rpy:1121
translate simplified_chinese mod_vess_servant_path_start_b952f1c5:

    # c "You’ll do anything I say."
    c "你要做我说的任何事。"

# game/episode013_conversations.rpy:1122
translate simplified_chinese mod_vess_servant_path_start_12681ec3:

    # c "Do you understand?"
    c "明白了吗？"

# game/episode013_conversations.rpy:1124
translate simplified_chinese mod_vess_servant_path_start_2fd74067_1:

    # ve "I do."
    ve "我愿意。"

# game/episode013_conversations.rpy:1125
translate simplified_chinese mod_vess_servant_path_start_6ab673dc:

    # c "And do agree to become my servant, or will you remain in your cell?"
    c "那么你同意成为我的仆人，还是继续留在你的牢房里？"

# game/episode013_conversations.rpy:1127
translate simplified_chinese mod_vess_servant_path_start_9f27e0a1:

    # ve "What will the others think of me being released out of the brig?"
    ve "其他人会怎么看待我被从禁闭室释放出来？"

# game/episode013_conversations.rpy:1128
translate simplified_chinese mod_vess_servant_path_start_36ca07cb:

    # c "I'll make sure they understand."
    c "我会确保他们理解的。"

# game/episode013_conversations.rpy:1130
translate simplified_chinese mod_vess_servant_path_start_fae4c75b:

    # ve "In that case I agree to become your servant."
    ve "既然如此，我同意成为你的仆人。"

# game/episode013_conversations.rpy:1131
translate simplified_chinese mod_vess_servant_path_start_9696ccb2:

    # c "Good girl."
    c "好女孩。"

# game/episode013_conversations.rpy:1132
translate simplified_chinese mod_vess_servant_path_start_c48498f2:

    # c "I'll make sure you'll be tagged so we can follow your movements should you decide to escape."
    c "我会确保给你打上追踪标记，这样如果你决定逃跑，我们就能追踪你的行踪。"

# game/episode013_conversations.rpy:1133
translate simplified_chinese mod_vess_servant_path_start_141f2d24:

    # c "After that I'll inform everyone of my decision to release you."
    c "之后我会通知所有人我决定释放你。"

# game/episode013_conversations.rpy:1134
translate simplified_chinese mod_vess_servant_path_start_4187cda3:

    # ve "Thank you."
    ve "谢谢。"

# game/episode013_conversations.rpy:1135
translate simplified_chinese mod_vess_servant_path_start_1403a5fc:

    # c "While I appreciate gratitude, I think actions speak louder than words."
    c "虽然我欣赏感激之情，但我认为行动胜于雄辩。"

# game/episode013_conversations.rpy:1137
translate simplified_chinese mod_vess_servant_path_start_39d88b4e:

    # "While I spoke those last words, I unzipped my pants and pulled out my cock."
    "在我说完最后那句话的同时，我拉开裤子拉链，掏出了自己的肉棒。"

# game/episode013_conversations.rpy:1138
translate simplified_chinese mod_vess_servant_path_start_1145b0ee:

    # c "Why don't you undress and get on your knees to show me just how grateful you are?"
    c "不如你脱掉衣服跪下来，让我看看你有多感激？"

# game/episode013_conversations.rpy:1139
translate simplified_chinese mod_vess_servant_path_start_3059843d:

    # "I lowered the barrier separating us and entered her cell."
    "我降下了隔开我们的屏障，走进了她的牢房。"

# game/episode013_conversations.rpy:1142
translate simplified_chinese mod_vess_servant_path_start_08ab9265:

    # c "In light of your recent actions, I will allow you to live here in the brig."
    c "鉴于你近期的行为，我允许你继续住在这个禁闭室里。"

# game/episode013_conversations.rpy:1143
translate simplified_chinese mod_vess_servant_path_start_49349651:

    # c "You will be fed and put to work if necessary."
    c "你会得到食物，必要时也会安排工作。"

# game/episode013_conversations.rpy:1144
translate simplified_chinese mod_vess_servant_path_start_f00594a7:

    # c "That's all I will allow you."
    c "这就是我能给你的全部了。"

# game/episode013_conversations.rpy:1146
translate simplified_chinese mod_vess_servant_path_start_a3172e75:

    # ve "I understand."
    ve "我明白。"

# game/episode013_conversations.rpy:1147
translate simplified_chinese mod_vess_servant_path_start_b62c291a:

    # ve "Thank you, [p_name]."
    ve "谢谢你，[p_name]。"

# game/episode013_conversations.rpy:1150
translate simplified_chinese mod_vess_love_path_start_0731b314:

    # c "That was a brave thing you did, dangerous too."
    c "你刚才的举动很勇敢，但也很危险。"

# game/episode013_conversations.rpy:1152
translate simplified_chinese mod_vess_love_path_start_39d41770:

    # ve "I know."
    ve "我知道。"

# game/episode013_conversations.rpy:1153
translate simplified_chinese mod_vess_love_path_start_6a44d004:

    # c "Why did you do it?"
    c "你为什么要这么做？"

# game/episode013_conversations.rpy:1155
translate simplified_chinese mod_vess_love_path_start_6c6e95df:

    # ve "Because I was part of the reason why you ended up there."
    ve "因为我会沦落到那里，其中一部分原因在我。"

# game/episode013_conversations.rpy:1156
translate simplified_chinese mod_vess_love_path_start_af30b11b:

    # ve "And I couldn't bear to lose you."
    ve "我无法承受失去你的痛苦。"

# game/episode013_conversations.rpy:1157
translate simplified_chinese mod_vess_love_path_start_4a879de2:

    # c "I can understand you feel guilty and-"
    c "我能理解你感到内疚—"

# game/episode013_conversations.rpy:1158
translate simplified_chinese mod_vess_love_path_start_cd8355b2:

    # ve "It's not just guilt."
    ve "不仅仅是内疚。"

# game/episode013_conversations.rpy:1160
translate simplified_chinese mod_vess_love_path_start_7e5716b2:

    # ve "The thought of losing you, it...{w} it breaks my heart."
    ve "想到会失去你，这…{w}这让我心碎。"

# game/episode013_conversations.rpy:1161
translate simplified_chinese mod_vess_love_path_start_dc83ae0f:

    # ve "I love you [p_name]."
    ve "我爱你，[p_name]。"

# game/episode013_conversations.rpy:1162
translate simplified_chinese mod_vess_love_path_start_2ebfb460:

    # ve "I know my love is hopeless, considering my betrayal and your opinion of me, but I just love you with all my heart."
    ve "我知道我的爱毫无希望，考虑到我的背叛和您对我的看法，但我就是全心全意地爱着您。"

# game/episode013_conversations.rpy:1167
translate simplified_chinese mod_vess_love_path_start_785cd473:

    # c "I love you too, Vess."
    c "我也爱你，薇丝。"

# game/episode013_conversations.rpy:1168
translate simplified_chinese mod_vess_love_path_start_cb3bbe43:

    # c "I think you're a wonderful person."
    c "我觉得你是个很棒的人。"

# game/episode013_conversations.rpy:1172
translate simplified_chinese mod_vess_love_path_start_0ce2b6c2:

    # c "So I'll ask the rest of the crew if they agree to release you."
    c "所以我会问问其他船员是否同意释放你。"

# game/episode013_conversations.rpy:1173
translate simplified_chinese mod_vess_love_path_start_0a1355c7:

    # c "Our trust might not be completely repaired, but I believe you're a good person."
    c "我们的信任或许无法完全修复，但我相信你是个好人。"

# game/episode013_conversations.rpy:1175
translate simplified_chinese mod_vess_love_path_start_f469b23c:

    # ve "You would do that for me?"
    ve "你愿意为我这么做？"

# game/episode013_conversations.rpy:1176
translate simplified_chinese mod_vess_love_path_start_bfb64358:

    # c "Yes, I will."
    c "是的，我愿意。"

# game/episode013_conversations.rpy:1177
translate simplified_chinese mod_vess_love_path_start_2ad22dbd:

    # c "I'm not saying I'll be able to trust you completely, because it will take time."
    c "我不是说能完全信任你，因为这需要时间。"

# game/episode013_conversations.rpy:1178
translate simplified_chinese mod_vess_love_path_start_9707ad52:

    # c "But I'm willing to give you a second chance."
    c "但我愿意给你第二次机会。"

# game/episode013_conversations.rpy:1180
translate simplified_chinese mod_vess_love_path_start_9bc908ee:

    # ve "Oh [p_name], you don't know how happy that makes me feel!"
    ve "哦[p_name]，你不知道这让我有多开心！"

# game/episode013_conversations.rpy:1181
translate simplified_chinese mod_vess_love_path_start_b762fc92:

    # ve "Am I...{w} Am I allowed to kiss you?"
    ve "我…{w}我可以吻你吗？"

# game/episode013_conversations.rpy:1182
translate simplified_chinese mod_vess_love_path_start_3059843d:

    # "I lowered the barrier separating us and entered her cell."
    "我降下隔开我们的屏障，走进她的牢房。"

# game/episode013_conversations.rpy:1184
translate simplified_chinese mod_vess_love_path_start_0a7b536c:

    # "Vess took a hesitant step forward and smiled as I opened my arms for an embrace."
    "薇丝犹豫地向前一步，当我张开双臂准备拥抱时露出了微笑。"

# game/episode013_conversations.rpy:1185
translate simplified_chinese mod_vess_love_path_start_27c88cef:

    # "Our kiss was hesitant at first, but that feeling soon melted away."
    "我们的吻起初带着犹豫，但那种感觉很快就消融了。"

# game/episode013_conversations.rpy:1187
translate simplified_chinese mod_vess_love_path_start_67bbfd98:

    # ve "Thank you, [p_name_short], I won't disappoint you."
    ve "谢谢你，[p_name_short]，我不会让你失望的。"

# game/episode013_conversations.rpy:1189
translate simplified_chinese mod_vess_love_path_start_95064e35:

    # c "But your betrayal has damaged my trust in you so profoundly."
    c "但你的背叛已经深深地伤害了我对你的信任。"

# game/episode013_conversations.rpy:1190
translate simplified_chinese mod_vess_love_path_start_c28e3fbd:

    # c "It might be repairable, I don't know."
    c "也许还能修复，我不知道。"

# game/episode013_conversations.rpy:1191
translate simplified_chinese mod_vess_love_path_start_3cce8114:

    # c "I'm sure you understand you need to remain in the brig for the foreseeable future."
    c "我相信你明白，在可预见的未来你需要继续待在禁闭室里。"

# game/episode013_conversations.rpy:1192
translate simplified_chinese mod_vess_love_path_start_faf5fdf8:

    # c "In time, the crew and I may accept you back, but it's going to be a long process."
    c "总有一天，我和船员们可能会重新接纳你，但这将是个漫长的过程。"

# game/episode013_conversations.rpy:1194
translate simplified_chinese mod_vess_love_path_start_89ab9cb4:

    # ve "I understand, thank you [p_name]."
    ve "我明白，谢谢你[p_name]。"

# game/episode013_conversations.rpy:1195
translate simplified_chinese mod_vess_love_path_start_bf5d458e:

    # c "I'll make sure you get some things to make your stay here in the brig a little more comfortable."
    c "我会确保给你一些东西，让你在禁闭室的日子过得稍微舒适些。"

# game/episode013_conversations.rpy:1197
translate simplified_chinese mod_vess_love_path_start_b62c291a:

    # ve "Thank you, [p_name]."
    ve "谢谢你，[p_name]。"

# game/episode013_conversations.rpy:1199
translate simplified_chinese mod_vess_love_path_start_477d11a0:

    # ve "I know my situation is hopeless, but I want to be useful in any way possible."
    ve "我知道我的处境很绝望，但我希望能以任何可能的方式发挥作用。"

# game/episode013_conversations.rpy:1200
translate simplified_chinese mod_vess_love_path_start_1cbeffd7:

    # ve "If that means risking my life, I have no problem with that."
    ve "如果这意味着要冒生命危险，我对此毫无异议。"

# game/episode013_conversations.rpy:1201
translate simplified_chinese mod_vess_love_path_start_bcef7244:

    # c "Thank you for your honesty and your bravery."
    c "感谢你的坦诚与勇气。"

# game/episode013_conversations.rpy:1202
translate simplified_chinese mod_vess_love_path_start_043e8561:

    # c "I'm sure you understand you need to remain in the brig for the foreseeable future, but actions like these do repair some of the trust that has been lost."
    c "我相信你明白，在可预见的未来你需要继续待在禁闭室，但这样的行为确实能修复部分已失去的信任。"

# game/episode013_conversations.rpy:1203
translate simplified_chinese mod_vess_love_path_start_faf5fdf8_1:

    # c "In time, the crew and I may accept you back, but it's going to be a long process."
    c "假以时日，我和船员们或许会重新接纳你，但这将是个漫长的过程。"

# game/episode013_conversations.rpy:1205
translate simplified_chinese mod_vess_love_path_start_89ab9cb4_1:

    # ve "I understand, thank you [p_name]."
    ve "我明白，谢谢你[p_name]。"

# game/episode013_conversations.rpy:1206
translate simplified_chinese mod_vess_love_path_start_bf5d458e_1:

    # c "I'll make sure you get some things to make your stay here in the brig a little more comfortable."
    c "我会确保给你送来些东西，让你在禁闭室的日子过得稍微舒适些。"

# game/episode013_conversations.rpy:1207
translate simplified_chinese mod_vess_love_path_start_b62c291a_1:

    # ve "Thank you, [p_name]."
    ve "谢谢你，[p_name]。"

# game/episode013_conversations.rpy:1210
translate simplified_chinese mod_vess_love_path_start_24968cee:

    # mod "Would you like to see scenes from an alternative path here and onwards (Love/Servant paths)? You will see sex scenes from both paths and maybe some story ones. Your initial path will be the main one."
    mod "你想在此处及之后查看替代路线的场景吗(爱情/仆从路线)？你将看到两条路线的性爱场景，可能还有些剧情场景。你的初始路线仍将是主线。"

# game/episode013_conversations.rpy:1211
translate simplified_chinese mod_vess_love_path_start_1e4e1a93:

    # mod "Don't stay silent/leave her in the brig if you choose this."
    mod "若选择此项，请不要保持沉默/将她留在禁闭室。"

# game/episode013_conversations.rpy:1232
translate simplified_chinese ep013_thyia_talk_9223769b:

    # c "I didn't think you'd be this far along with your robot."
    c "没想到你的机器人已经进展到这个程度了。"

# game/episode013_conversations.rpy:1234
translate simplified_chinese ep013_thyia_talk_aa830963:

    # th "It's such a great way to pass the time."
    th "这真是打发时间的好方法。"

# game/episode013_conversations.rpy:1235
translate simplified_chinese ep013_thyia_talk_b818dd01:

    # th "I've built a few robots back when I was much younger and I'd forgotten how much fun it can be."
    th "我年轻时也组装过几个机器人，都忘了这玩意儿能这么有趣。"

# game/episode013_conversations.rpy:1236
translate simplified_chinese ep013_thyia_talk_58b7ea5c:

    # th "Programming the thing once it's done will be the hardest part, but maybe Jade can help me with that."
    th "完成后给它编程会是最困难的部分，不过也许杰德能帮我这个忙。"

# game/episode013_conversations.rpy:1237
translate simplified_chinese ep013_thyia_talk_20b1b51a:

    # c "As long as she doesn't get too clever and builds something that wants to kill us in our sleep."
    c "只要她别聪明过头，造出个想在我们睡觉时干掉我们的东西就行。"

# game/episode013_conversations.rpy:1239
translate simplified_chinese ep013_thyia_talk_526eb575:

    # th "You seem awfully terrified of sentient machines."
    th "你好像对有意识的机器特别恐惧。"

# game/episode013_conversations.rpy:1240
translate simplified_chinese ep013_thyia_talk_086b46eb:

    # c "I think I read too much old-timey science-fiction novels."
    c "我想我可能是看了太多老掉牙的科幻小说。"

# game/episode013_conversations.rpy:1242
translate simplified_chinese ep013_thyia_talk_fe603895:

    # th "Well, there's a reason why the human race stopped developing sentient AIs, so your fears might be justified."
    th "嗯，人类停止开发有意识的人工智能是有原因的，所以你的恐惧可能不无道理。"

# game/episode013_conversations.rpy:1243
translate simplified_chinese ep013_thyia_talk_59ba92d7:

    # th "Don't worry though, this heap of junk will just perform some basic routines."
    th "不过别担心，这堆废铁只会执行一些基本程序。"

# game/episode013_conversations.rpy:1244
translate simplified_chinese ep013_thyia_talk_b26e37a1:

    # c "Did anybody ever tell you you look extremely sexy covered in grease?"
    c "有没有人告诉过你，满身油污的样子特别性感？"

# game/episode013_conversations.rpy:1246
translate simplified_chinese ep013_thyia_talk_2a876aa3:

    # th "You have the weirdest fetishes, you know that?"
    th "你的癖好真是有够奇怪的，知道吗？"

# game/episode013_conversations.rpy:1247
translate simplified_chinese ep013_thyia_talk_401f7990:

    # c "I like my women dirty."
    c "我喜欢我的女人脏兮兮的。"

# game/episode013_conversations.rpy:1249
translate simplified_chinese ep013_thyia_talk_4f4e61fe:

    # th "Do you now?"
    th "是吗？"

# game/episode013_conversations.rpy:1260
translate simplified_chinese ep013_ziv_talk_3e656748:

    # "Surprise made way for elation as soon as Ziv saw me enter her quarters."
    "基芙一看到我进入她的房间，惊讶立刻转为欣喜。"

# game/episode013_conversations.rpy:1262
translate simplified_chinese ep013_ziv_talk_ecc82df4:

    # "Ziv rushed towards me with uncharacteristic haste and held me firmly."
    "基芙以不同寻常的急促冲向我，紧紧抱住了我。"

# game/episode013_conversations.rpy:1264
translate simplified_chinese ep013_ziv_talk_51547958:

    # zi "I heard you made a full recovery."
    zi "我听说你完全康复了。"

# game/episode013_conversations.rpy:1265
translate simplified_chinese ep013_ziv_talk_ba3e45f1:

    # c "More or less, though I’m not sure if being crushed is healthy for anyone."
    c "差不多吧，虽然我不确定被压扁对任何人来说是否健康。"

# game/episode013_conversations.rpy:1267
translate simplified_chinese ep013_ziv_talk_379f3b4c:

    # zi "Oh, sorry, I didn’t mean-"
    zi "噢，抱歉，我不是有意-"

# game/episode013_conversations.rpy:1269
translate simplified_chinese ep013_ziv_talk_1d51436e:

    # "I kissed Ziv to prevent her from making more apologies."
    "我亲吻了基芙，阻止她继续道歉。"

# game/episode013_conversations.rpy:1270
translate simplified_chinese ep013_ziv_talk_e186a39d:

    # "We sat down on the pillows covering most of Ziv’s quarters."
    "我们在铺满基芙大部分房间的枕头上坐下。"

# game/episode013_conversations.rpy:1272
translate simplified_chinese ep013_ziv_talk_1e77a1bc:

    # zi "I’ve visited you often."
    zi "我经常来看你。"

# game/episode013_conversations.rpy:1273
translate simplified_chinese ep013_ziv_talk_61deb00b:

    # c "So I’ve heard."
    c "我确实听说了。"

# game/episode013_conversations.rpy:1274
translate simplified_chinese ep013_ziv_talk_ca01cedb:

    # zi "I must admit I despaired, when it wasn’t clear you would make a full recovery."
    zi "我必须承认，当你不确定能否完全康复时，我曾感到绝望。"

# game/episode013_conversations.rpy:1275
translate simplified_chinese ep013_ziv_talk_a45e157e:

    # zi "We crashed through all those levels of Companionship so quickly and the thought of losing you..."
    zi "我们如此迅速地经历了所有那些伴侣关系的阶段，想到可能会失去你…"

# game/episode013_conversations.rpy:1276
translate simplified_chinese ep013_ziv_talk_705fc01e:

    # zi "Let’s just say I’m happy you’re out and about again."
    zi "我只能说，我很高兴你又能够自由活动了。"

# game/episode013_conversations.rpy:1278
translate simplified_chinese ep013_ziv_talk_6261d041:

    # zi "I’m happy you’re out and about again."
    zi "我很高兴你又能够自由活动了。"

# game/episode013_conversations.rpy:1280
translate simplified_chinese ep013_ziv_talk_23a9231f:

    # c "So am I."
    c "我也是。"

# game/episode013_conversations.rpy:1281
translate simplified_chinese ep013_ziv_talk_0bcc861f:

    # zi "I think you’re very lucky you’ve survived that encounter with the Scolguin."
    zi "我觉得你非常幸运，能从与斯科尔金人的遭遇中幸存下来。"

# game/episode013_conversations.rpy:1282
translate simplified_chinese ep013_ziv_talk_1dc87f8b:

    # c "You know them?"
    c "你认识他们？"

# game/episode013_conversations.rpy:1284
translate simplified_chinese ep013_ziv_talk_6cbaeb44:

    # zi "I’ve only heard of them."
    zi "我只是听说过他们。"

# game/episode013_conversations.rpy:1285
translate simplified_chinese ep013_ziv_talk_f5c8f725:

    # zi "My people have only dealt with them once in recent years."
    zi "我们族人在近几年里只与他们打过一次交道。"

# game/episode013_conversations.rpy:1286
translate simplified_chinese ep013_ziv_talk_78fcdfd9:

    # c "The Rhenkoy made a life sacrifice to meet with the Scolguin?"
    c "伦科伊人献祭了一条生命才见到斯科尔金人？"

# game/episode013_conversations.rpy:1288
translate simplified_chinese ep013_ziv_talk_32f650b0:

    # zi "No, not at all."
    zi "不，完全不是。"

# game/episode013_conversations.rpy:1289
translate simplified_chinese ep013_ziv_talk_65a99414:

    # zi "This was one of the rare instances where the Scolguin took an interest in another species."
    zi "这是斯科尔金人难得对其他物种产生兴趣的罕见情况之一。"

# game/episode013_conversations.rpy:1290
translate simplified_chinese ep013_ziv_talk_ab0c8f09:

    # c "I reckon that usually doesn’t end well?"
    c "我猜这通常不会有好结果？"

# game/episode013_conversations.rpy:1291
translate simplified_chinese ep013_ziv_talk_90508315:

    # zi "Indeed."
    zi "确实如此。"

# game/episode013_conversations.rpy:1293
translate simplified_chinese ep013_ziv_talk_27e2a23a:

    # zi "A group of the Vrarr asked for asylum on our homeworld, which we grant in some cases."
    zi "一群瓦尔族人请求在我们的母星避难，我们在某些情况下会批准这类请求。"

# game/episode013_conversations.rpy:1294
translate simplified_chinese ep013_ziv_talk_b381ec4e:

    # zi "The reason for the application was serious enough to grant the Vrarr refuge."
    zi "申请的理由足够严重，因此我们给予了瓦尔族人庇护。"

# game/episode013_conversations.rpy:1295
translate simplified_chinese ep013_ziv_talk_22f7dd0b:

    # zi "It turns out they were directly involved in an altercation between the Scolguin and the Vrarr."
    zi "结果发现他们直接卷入了斯科尔金人与瓦尔族人之间的冲突。"

# game/episode013_conversations.rpy:1297
translate simplified_chinese ep013_ziv_talk_c4fbdc0d:

    # zi "Some dispute about territory which turned very violent."
    zi "关于领土的某些争端变得非常暴力。"

# game/episode013_conversations.rpy:1298
translate simplified_chinese ep013_ziv_talk_b8e39eb3:

    # zi "The Scolguin learned we sheltered the Vrarr warriors and demanded them as prisoners of war."
    zi "斯科尔金人得知我们收容了瓦尔族战士，并要求将他们作为战俘移交。"

# game/episode013_conversations.rpy:1299
translate simplified_chinese ep013_ziv_talk_c6286632:

    # zi "According to them, the Vrarr initiated the aggression and were responsible for extensive damages."
    zi "据他们所说，是瓦尔族率先发动攻击并造成了巨大破坏。"

# game/episode013_conversations.rpy:1300
translate simplified_chinese ep013_ziv_talk_ef6fee26:

    # c "Were they turned over?"
    c "他们被交出去了吗？"

# game/episode013_conversations.rpy:1301
translate simplified_chinese ep013_ziv_talk_b9812c45:

    # zi "The Vrarr are known for their martial culture, but not so much because of their expansion drift, so the story of the Scolguin seemed unlikely from the onset."
    zi "瓦尔族以其尚武文化闻名，但扩张倾向并不显著，所以斯科尔金人的说法从一开始就显得不可信。"

# game/episode013_conversations.rpy:1302
translate simplified_chinese ep013_ziv_talk_d4495654:

    # zi "We Rhenkoy always conduct our own impartial investigation when it comes to these matters and that's what happened here as well."
    zi "我们伦科伊人在处理这类事务时总是会进行公正调查，这次也不例外。"

# game/episode013_conversations.rpy:1303
translate simplified_chinese ep013_ziv_talk_88be9d0e:

    # zi "Turns out the Scolguin were the aggressor in this case, so we denied their request for a prisoner transfer."
    zi "结果证明斯科尔金人才是此事的侵略者，因此我们拒绝了他们的战俘移交请求。"

# game/episode013_conversations.rpy:1315
translate simplified_chinese ep013_ziv_talk_957de8a3:

    # c "They weren't happy about that, I take it?"
    c "我猜他们对此很不高兴？"

# game/episode013_conversations.rpy:1317
translate simplified_chinese ep013_ziv_talk_09d6c55d:

    # zi "Not at all."
    zi "一点也不。"

# game/episode013_conversations.rpy:1319
translate simplified_chinese ep013_ziv_talk_548fc8f6:

    # zi "At first we didn't hear anything further, but then the location where the Vrarr refugees were held came under attack."
    zi "起初我们没有收到任何进一步消息，但后来收容瓦尔难民的据点遭到了袭击。"

# game/episode013_conversations.rpy:1320
translate simplified_chinese ep013_ziv_talk_b2ce5020:

    # zi "It didn't take long for the assailants to be identified as a Scolguin strike team."
    zi "袭击者很快就被确认为斯科尔金人的突击小队。"

# game/episode013_conversations.rpy:1321
translate simplified_chinese ep013_ziv_talk_dc843fa3:

    # c "Were they successful in their attack?"
    c "他们的袭击成功了吗？"

# game/episode013_conversations.rpy:1322
translate simplified_chinese ep013_ziv_talk_d694affb:

    # zi "No, our own forces managed to subdue them."
    zi "没有，我们自己的部队成功镇压了他们。"

# game/episode013_conversations.rpy:1323
translate simplified_chinese ep013_ziv_talk_5a0207e5:

    # zi "After a public trial, they each received long prison sentences."
    zi "经过公开审判后，他们每人都被判处长期监禁。"

# game/episode013_conversations.rpy:1324
translate simplified_chinese ep013_ziv_talk_828d99d6:

    # c "Have the Scolguin ever demanded them back?"
    c "斯科尔金人有没有要求引渡他们回去？"

# game/episode013_conversations.rpy:1326
translate simplified_chinese ep013_ziv_talk_c6f4fbb0:

    # zi "That's the thing, the Scolguin initially denied any involvement, claiming it to be a rebel attack."
    zi "问题就在这里，斯科尔金人最初否认参与，声称这是一次叛军袭击。"

# game/episode013_conversations.rpy:1327
translate simplified_chinese ep013_ziv_talk_791c6ab0:

    # c "How convincing."
    c "真够有说服力的。"

# game/episode013_conversations.rpy:1328
translate simplified_chinese ep013_ziv_talk_ecea44f0:

    # zi "Very...{w} But their initial denial and the public trial made it impossible to make any demands about their return."
    zi "非常…{w}但他们最初的否认和公开审判使得他们无法提出任何关于引渡的要求。"

# game/episode013_conversations.rpy:1329
translate simplified_chinese ep013_ziv_talk_b740b1d4:

    # c "So those Scolguin commandos might still be in Rhenkoy custody?"
    c "所以那些斯科尔金突击队员可能仍在伦科伊的关押中？"

# game/episode013_conversations.rpy:1331
translate simplified_chinese ep013_ziv_talk_9e91f065:

    # zi "Yes, unless the Scolguin have negotiated their release in secret."
    zi "是的，除非斯科尔金人通过秘密谈判让他们获释。"

# game/episode013_conversations.rpy:1332
translate simplified_chinese ep013_ziv_talk_b67915cb:

    # c "How likely is that?"
    c "这种可能性有多大？"

# game/episode013_conversations.rpy:1334
translate simplified_chinese ep013_ziv_talk_cd73cfcd:

    # zi "Quite unlikely."
    zi "相当不可能。"

# game/episode013_conversations.rpy:1335
translate simplified_chinese ep013_ziv_talk_d06d39b7:

    # zi "The Scolguin only demand, they never ask."
    zi "斯科尔金只会要求，从不请求。"

# game/episode013_conversations.rpy:1336
translate simplified_chinese ep013_ziv_talk_7c3de1d0:

    # c "Would any of those soldiers know a way to locate their main fleet?"
    c "那些士兵里会有人知道如何定位他们的主力舰队吗？"

# game/episode013_conversations.rpy:1338
translate simplified_chinese ep013_ziv_talk_87322771:

    # zi "I'm not sure."
    zi "我不确定。"

# game/episode013_conversations.rpy:1339
translate simplified_chinese ep013_ziv_talk_23634126:

    # zi "Their squad leader or any higher ranking officer might."
    zi "他们的分队长或更高级别的军官或许知道。"

# game/episode013_conversations.rpy:1340
translate simplified_chinese ep013_ziv_talk_c5aed8d5:

    # c "Interesting."
    c "有意思。"

# game/episode013_conversations.rpy:1341
translate simplified_chinese ep013_ziv_talk_e4a00f32:

    # c "Do you think we could speak to them?"
    c "你觉得我们能和他们谈谈吗？"

# game/episode013_conversations.rpy:1342
translate simplified_chinese ep013_ziv_talk_681ba2ef:

    # zi "We might, if I could secure the proper clearance."
    zi "如果我能获得适当许可的话，或许可以。"

# game/episode013_conversations.rpy:1344
translate simplified_chinese ep013_ziv_talk_64a7c6f5:

    # zi "We'd need to travel to my homeworld though."
    zi "不过我们需要前往我的母星。"

# game/episode013_conversations.rpy:1345
translate simplified_chinese ep013_ziv_talk_3bf90b60:

    # c "You'd be willing to do that?"
    c "你愿意这么做？"

# game/episode013_conversations.rpy:1347
translate simplified_chinese ep013_ziv_talk_8a409928:

    # zi "Of course."
    zi "当然。"

# game/episode013_conversations.rpy:1348
translate simplified_chinese ep013_ziv_talk_65c24db2:

    # c "I'll talk to the others and see what they think about it."
    c "我会和其他人谈谈，看看他们对此有什么看法。"

