translate simplified_chinese ep019_paclerara_aven_52e11f66:

    # c "In light of everything, I feel I need to tell you something."
    c "鉴于目前的情况，我觉得有必要告诉你一些事。"

# game/episode019.rpy:1095
translate simplified_chinese ep019_paclerara_aven_527471a0:

    # "My sister’s fearful look almost made me change the subject, but I carried on regardless."
    "我妹妹那惊恐的表情几乎让我改变话题，但我还是继续说了下去。"

# game/episode019.rpy:1097
translate simplified_chinese ep019_paclerara_aven_2c0df799:

    # "Aven’s fearful look almost made me change the subject, but I carried on regardless."
    "艾文那惊恐的表情几乎让我改变话题，但我还是继续说了下去。"

# game/episode019.rpy:1098
translate simplified_chinese ep019_paclerara_aven_b9daa86f:

    # c "I love you very much, Aven."
    c "我非常爱你，艾文。"

# game/episode019.rpy:1100
translate simplified_chinese ep019_paclerara_aven_e0696351:

    # c "I want to grow old with you, start a family."
    c "我想和你一起变老，组建家庭。"

# game/episode019.rpy:1102
translate simplified_chinese ep019_paclerara_aven_8d3ef370:

    # c "I want to grow old with you."
    c "我想和你一起变老。"

# game/episode019.rpy:1103
translate simplified_chinese ep019_paclerara_aven_9f98c340:

    # c "But you’re not the only woman I love."
    c "但你并不是我唯一爱着的女人。"

# game/episode019.rpy:1105
translate simplified_chinese ep019_paclerara_aven_dd546403:

    # "I expected Aven to splash her glass of wine into my face, or even attempt to throw me over the balcony, but she just looked at me seriously and nodded, inviting me to go on."
    "我本以为艾文会把她的那杯酒泼到我脸上，甚至试图把我扔下阳台，但她只是认真地看着我点了点头，示意我继续说下去。"

# game/episode019.rpy:1106
translate simplified_chinese ep019_paclerara_aven_bd274d73:

    # c "At first I didn’t realize how serious it all was."
    c "起初我并没有意识到这一切有多严重。"

# game/episode019.rpy:1108
translate simplified_chinese ep019_paclerara_aven_b6a6c50a:

    # c "Thinking that any spark there was between me and them would die out and nothing else would ever come of it."
    c "以为我和她们之间的任何火花都会熄灭，不会再有其他结果。"

# game/episode019.rpy:1110
translate simplified_chinese ep019_paclerara_aven_0ddd6bfd:

    # c "Thinking that any spark there was between me and her would die out and nothing else would ever come of it."
    c "以为我和她之间的任何火花都会熄灭，不会再有其他结果。"

# game/episode019.rpy:1111
translate simplified_chinese ep019_paclerara_aven_b0f026f5:

    # c "But that didn’t happen."
    c "但事实并非如此。"

# game/episode019.rpy:1116
translate simplified_chinese ep019_paclerara_aven_85f2dacf:

    # av "Just to be clear, you’re not talking about just one woman, are you?"
    av "说清楚点，你说的不止一个女人，对吧？"

# game/episode019.rpy:1117
translate simplified_chinese ep019_paclerara_aven_e69e42b8:

    # c "No."
    c "不是。"

# game/episode019.rpy:1118
translate simplified_chinese ep019_paclerara_aven_79ea6aac:

    # c "I’m talking about [romances]."
    c "我说的是[romances]。"

# game/episode019.rpy:1120
translate simplified_chinese ep019_paclerara_aven_0a7df326:

    # "Again Aven surprised me."
    "艾文再次让我惊讶。"

# game/episode019.rpy:1121
translate simplified_chinese ep019_paclerara_aven_a522e02c:

    # "Instead of jumping up and pulling me across the table, she sighed and looked out over the lake."
    "她没有跳起来把我拽过桌子，而是叹了口气，望向湖面。"

# game/episode019.rpy:1123
translate simplified_chinese ep019_paclerara_aven_04c955a8:

    # av "Just to be clear, you’re talking about [romances], aren’t you?"
    av "说清楚点，你指的是[romances]，对吧？"

# game/episode019.rpy:1124
translate simplified_chinese ep019_paclerara_aven_36391c9b:

    # c "Yes, I am."
    c "是的。"

# game/episode019.rpy:1125
translate simplified_chinese ep019_paclerara_aven_e3179906:

    # av "You’re in love with her?"
    av "你爱上她了？"

# game/episode019.rpy:1126
translate simplified_chinese ep019_paclerara_aven_36391c9b_1:

    # c "Yes, I am."
    c "是的。"

# game/episode019.rpy:1127
translate simplified_chinese ep019_paclerara_aven_84c32a44:

    # c "As much as I am in love with you."
    c "就像我爱你一样深。"

# game/episode019.rpy:1129
translate simplified_chinese ep019_paclerara_aven_e00503cf:

    # "Aven sighed and looked out over the lake."
    "艾文叹了口气，望向湖面。"

# game/episode019.rpy:1131
translate simplified_chinese ep019_paclerara_aven_575f8524:

    # av "I expected as much."
    av "我料到了。"

# game/episode019.rpy:1132
translate simplified_chinese ep019_paclerara_aven_20d31919:

    # c "You did?"
    c "是吗？"

# game/episode019.rpy:1134
translate simplified_chinese ep019_paclerara_aven_aa9c93d3:

    # av "I’m neither blind nor deaf, [p_name]."
    av "我既不瞎也不聋，[p_name]。"

# game/episode019.rpy:1137
translate simplified_chinese ep019_paclerara_aven_d25695a3:

    # av "It’s not easy for our mother to hide her feelings from me."
    av "对母亲来说，向我隐藏她的感情并不容易。"

# game/episode019.rpy:1139
translate simplified_chinese ep019_paclerara_aven_319940b8:

    # av "It’s not easy for Nadya to hide her feelings from me."
    av "对娜迪亚来说，向我隐藏她的感情并不容易。"

# game/episode019.rpy:1140
translate simplified_chinese ep019_paclerara_aven_5ea30d73:

    # av "People sometimes let things slip in conversation, but often even a wayward gaze is enough."
    av "人们有时会在谈话中无意流露，但通常连一个飘忽的眼神就足够了。"

# game/episode019.rpy:1143
translate simplified_chinese ep019_paclerara_aven_f23ecccb:

    # av "I’ve seen them look at you."
    av "我见过她们看你的眼神。"

# game/episode019.rpy:1145
translate simplified_chinese ep019_paclerara_aven_62ea3acc:

    # av "I’ve seen her look at you."
    av "我见过她看你的眼神。"

# game/episode019.rpy:1146
translate simplified_chinese ep019_paclerara_aven_8418c4d2:

    # av "And at first I denied it to myself, but then I realized something very simple."
    av "起初我对自己否认这一点，但后来我意识到一个很简单的事实。"

# game/episode019.rpy:1147
translate simplified_chinese ep019_paclerara_aven_98fc84c8:

    # av "You, [p_name_short], you made me fall head over heels in love with you."
    av "你，[p_name_short]，你让我彻底地爱上了你。"

# game/episode019.rpy:1148
translate simplified_chinese ep019_paclerara_aven_dbfed1af:

    # av "That feeling is so powerful, so of course it could happen to someone else too."
    av "那种感觉如此强烈，当然也会发生在其他人身上。"

# game/episode019.rpy:1150
translate simplified_chinese ep019_paclerara_aven_3ac67cbe:

    # av "I saw you together with Lilly, back at that facility where we lost our memories."
    av "我在那个让我们失去记忆的设施里，见过你和莉莉在一起。"

# game/episode019.rpy:1152
translate simplified_chinese ep019_paclerara_aven_80d4d046:

    # av "Afterwards, I thought you were just close because of the sibling bond you unconsciously felt."
    av "之后，我以为你们亲近只是因为潜意识里感受到的兄妹羁绊。"

# game/episode019.rpy:1154
translate simplified_chinese ep019_paclerara_aven_2dfe814b:

    # av "Afterwards, I thought you were just close because of the friendship you unconsciously felt."
    av "之后，我以为你们亲近只是因为潜意识里感受到的友谊。"

# game/episode019.rpy:1155
translate simplified_chinese ep019_paclerara_aven_8d516082:

    # av "But then I caught her looking at you multiple times afterwards, when we had our memories back."
    av "但后来，在我们恢复记忆后，我多次撞见她看你的眼神。"

# game/episode019.rpy:1157
translate simplified_chinese ep019_paclerara_aven_a2ada933:

    # av "And that look in her eye wasn’t something a sister would normally have when looking at her brother."
    av "她眼中的那种神情，通常不是妹妹看哥哥时会有的。"

# game/episode019.rpy:1159
translate simplified_chinese ep019_paclerara_aven_f86229e3:

    # av "And that look in her eye wasn’t something one would normally have when looking at a friend."
    av "她眼中的那种神情，通常不是看朋友时会有的。"

# game/episode019.rpy:1161
translate simplified_chinese ep019_paclerara_aven_53092d32:

    # av "I didn’t know you felt the same way about her, of course, so I dismissed it for a while."
    av "我当然不知道你对她也有同样的感觉，所以有一阵子我没把这事放在心上。"

# game/episode019.rpy:1164
translate simplified_chinese ep019_paclerara_aven_e0598278:

    # av "But then you and I became lovers and the notion of you caring for another sister that way struck me again."
    av "但后来你和我成了恋人，想到你以那种方式关心另一个妹妹的念头又击中了我。"

# game/episode019.rpy:1166
translate simplified_chinese ep019_paclerara_aven_8ef0ab5d:

    # av "But then you and I became lovers and the notion of you caring for her that way struck me again."
    av "但后来你和我成了恋人，想到你以那种方式关心她的念头又击中了我。"

# game/episode019.rpy:1167
translate simplified_chinese ep019_paclerara_aven_a8e2714e:

    # av "So I’ve had my suspicions for a long while."
    av "所以我早就有所怀疑了。"

# game/episode019.rpy:1168
translate simplified_chinese ep019_paclerara_aven_c3d27f45:

    # av "And now you’ve confirmed them."
    av "而现在你证实了这些怀疑。"

# game/episode019.rpy:1170
translate simplified_chinese ep019_paclerara_aven_4baac61c:

    # av "The only thing I don’t understand is why you didn’t come clean to me."
    av "唯一我不明白的是你为什么不向我坦白。"

# game/episode019.rpy:1172
translate simplified_chinese ep019_paclerara_aven_50fbfd95:

    # av "We’ve had many conversations about important stuff, about possibly having children even, why didn’t you tell me?"
    av "我们曾多次谈论重要的事情，甚至讨论过可能要孩子，你为什么没有告诉我？"

# game/episode019.rpy:1174
translate simplified_chinese ep019_paclerara_aven_7f492d20:

    # av "We’ve had many conversations about important stuff, why didn’t you tell me?"
    av "我们曾多次谈论重要的事情，你为什么没有告诉我？"

# game/episode019.rpy:1175
translate simplified_chinese ep019_paclerara_aven_ce7d6aff:

    # c "I realize now that I should have told you."
    c "现在我才意识到我本该告诉你的。"

# game/episode019.rpy:1176
translate simplified_chinese ep019_paclerara_aven_40fc8f86:

    # c "I was so afraid I’d destroy what we shared together, so I just kept postponing the moment to tell you."
    c "我太害怕会毁掉我们之间的一切，所以一直拖延着告诉你真相的时刻。"

# game/episode019.rpy:1178
translate simplified_chinese ep019_paclerara_aven_9166f3be:

    # c "Part of me thought that I compartmentalize all those relationships."
    c "我有一部分想法是觉得可以把这些关系都分隔开来。"

# game/episode019.rpy:1180
translate simplified_chinese ep019_paclerara_aven_b17e4ab1:

    # c "Part of me thought that I compartmentalize both relationships."
    c "我有一部分想法是觉得可以把两段关系都分隔开来。"

# game/episode019.rpy:1181
translate simplified_chinese ep019_paclerara_aven_a485fc69:

    # c "But that’s far from realistic, of course."
    c "但这显然太不现实了。"

# game/episode019.rpy:1183
translate simplified_chinese ep019_paclerara_aven_8ad139f3:

    # av "I’d say that’s rather obvious, yes."
    av "我得说这确实相当明显，是的。"

# game/episode019.rpy:1185
translate simplified_chinese ep019_paclerara_aven_f6ed1d78:

    # c "Some of the other girls now know about each other."
    c "现在有些女孩已经知道了彼此的存在。"

# game/episode019.rpy:1187
translate simplified_chinese ep019_paclerara_aven_d1078750:

    # c "And some have decided to enter into a new form of partnership."
    c "而且有些人已经决定建立一种新的伴侣关系。"

# game/episode019.rpy:1188
translate simplified_chinese ep019_paclerara_aven_75b2793f:

    # av "You should have just told me, [p_name_short]."
    av "你本应该告诉我的，[p_name_short]。"

# game/episode019.rpy:1189
translate simplified_chinese ep019_paclerara_aven_d12817b0:

    # av "I’m a big girl, I can handle things."
    av "我是个成熟的女人，我能处理好这些事。"

# game/episode019.rpy:1190
translate simplified_chinese ep019_paclerara_aven_4cdf97ab:

    # c "I know, I never thought you couldn’t."
    c "我知道，我从不认为你处理不了。"

# game/episode019.rpy:1191
translate simplified_chinese ep019_paclerara_aven_a08d207b:

    # c "I dreaded losing you."
    c "我只是害怕失去你。"

# game/episode019.rpy:1192
translate simplified_chinese ep019_paclerara_aven_4738d69d:

    # av "You needn’t have worried."
    av "你本不必担心。"

# game/episode019.rpy:1193
translate simplified_chinese ep019_paclerara_aven_ec121b35:

    # av "If we’d just talked about it, you might have learned I’m quite free-thinking when it comes to matters like these."
    av "如果我们当时就谈过这件事，你可能会发现我对这类事情相当开明。"

# game/episode019.rpy:1194
translate simplified_chinese ep019_paclerara_aven_fb33b7e3:

    # c "You mean you’ve had other lovers during the time we were together?"
    c "你是说在我们在一起期间，你还有其他情人？"

# game/episode019.rpy:1196
translate simplified_chinese ep019_paclerara_aven_b6df3f23:

    # "Aven looked at me with a curious expression on her face, while I felt the bottom of my stomach dropping away."
    "艾文脸上带着好奇的表情看着我，而我感觉自己的胃沉到了底。"

# game/episode019.rpy:1197
translate simplified_chinese ep019_paclerara_aven_a713f03a:

    # "The pang of all-consuming jealousy I felt at that moment wasn’t entirely fair considering the state of my love-life, but I felt it nonetheless."
    "考虑到我感情生活的现状，那一刻我感受到的吞噬一切的嫉妒并不完全公平，但我依然感受到了。"

# game/episode019.rpy:1199
translate simplified_chinese ep019_paclerara_aven_e0c00501:

    # av "Haha, you should see your face, [p_name]."
    av "哈哈，你真该看看自己的表情，[p_name]。"

# game/episode019.rpy:1201
translate simplified_chinese ep019_paclerara_aven_5a7e002e:

    # av "There’s no one else and there hasn’t been anyone else."
    av "没有别人，也从来没有过别人。"

# game/episode019.rpy:1203
translate simplified_chinese ep019_paclerara_aven_5e4ac000:

    # av "You’re enough for me."
    av "对我来说你已经足够了。"

# game/episode019.rpy:1204
translate simplified_chinese ep019_paclerara_aven_154c65fb:

    # c "So you do still want me?"
    c "所以你还想要我？"

# game/episode019.rpy:1206
translate simplified_chinese ep019_paclerara_aven_1f5500aa:

    # av "Are you kidding?"
    av "你在开玩笑吗？"

# game/episode019.rpy:1208
translate simplified_chinese ep019_paclerara_aven_57b2be2f:

    # av "Of course I do."
    av "我当然要。"

# game/episode019.rpy:1209
translate simplified_chinese ep019_paclerara_aven_889b2847:

    # av "I want everything we’ve ever discussed and more!"
    av "我想要我们讨论过的一切，甚至更多！"

# game/episode019.rpy:1210
translate simplified_chinese ep019_paclerara_aven_d216abbc:

    # c "I’m very glad to hear that."
    c "我很高兴听到你这么说。"

# game/episode019.rpy:1214
translate simplified_chinese ep019_paclerara_aven_b805ceb1:

    # av "[romances] is welcome to join us, of course."
    av "[romances] 当然欢迎加入我们。"

# game/episode019.rpy:1215
translate simplified_chinese ep019_paclerara_aven_61af85b3:

    # c "Are you serious about that?"
    c "你是认真的吗？"

# game/episode019.rpy:1217
translate simplified_chinese ep019_paclerara_aven_c8c8c154:

    # av "Well, I was half-joking."
    av "这个嘛，我有一半是在开玩笑。"

# game/episode019.rpy:1218
translate simplified_chinese ep019_paclerara_aven_732c3e6c:

    # av "But a threesome does sound exciting, to be honest."
    av "但说实话，三人行听起来确实很刺激。"

# game/episode019.rpy:1220
translate simplified_chinese ep019_paclerara_aven_25486306:

    # av "I know it’s the typical male sexual fantasy and all that, but I’m intrigued nonetheless."
    av "我知道这是典型的男性性幻想之类的，但我还是忍不住被吸引了。"

# game/episode019.rpy:1224
translate simplified_chinese ep019_paclerara_aven_84a98a3e:

    # av "You were talking about some of the girls deciding to enter a new form of partnership?"
    av "你之前提到有些女孩决定建立一种新的伴侣关系？"

# game/episode019.rpy:1225
translate simplified_chinese ep019_paclerara_aven_821f1333:

    # av "What does that mean exactly?"
    av "这具体是什么意思呢？"

# game/episode019.rpy:1226
translate simplified_chinese ep019_paclerara_aven_979c0d3c:

    # c "They have agreed to share a bed together with me."
    c "她们同意和我同床共枕。"

# game/episode019.rpy:1227
translate simplified_chinese ep019_paclerara_aven_f60571b5:

    # av "They have?"
    av "真的吗？"

# game/episode019.rpy:1229
translate simplified_chinese ep019_paclerara_aven_257fa852:

    # av "Interesting."
    av "有意思。"

# game/episode019.rpy:1230
translate simplified_chinese ep019_paclerara_aven_bae2dad3:

    # c "You’re welcome to join, of course."
    c "当然，欢迎你加入。"

# game/episode019.rpy:1232
translate simplified_chinese ep019_paclerara_aven_07801e70:

    # av "How magnanimous of you."
    av "你可真是宽宏大量。"

# game/episode019.rpy:1233
translate simplified_chinese ep019_paclerara_aven_da1a9641:

    # c "Always!"
    c "随时欢迎！"

# game/episode019.rpy:1235
translate simplified_chinese ep019_paclerara_aven_77180c40:

    # av "So you’re really asking me to participate in this typical male sexual fantasy of yours?"
    av "所以你是真的邀请我参与你这个典型的男性性幻想吗？"

# game/episode019.rpy:1236
translate simplified_chinese ep019_paclerara_aven_01a7ab5d:

    # c "Only if you want to."
    c "只要你愿意。"

# game/episode019.rpy:1237
translate simplified_chinese ep019_paclerara_aven_dfa1912c:

    # c "I don’t want you to do anything you’re uncomfortable with."
    c "我不想让你做任何让你不舒服的事。"

# game/episode019.rpy:1239
translate simplified_chinese ep019_paclerara_aven_0b552b2f:

    # av "Part of me probably doesn’t want to believe it, but I’m intrigued to be honest."
    av "说实话，虽然我内心可能不愿相信，但确实很好奇。"

# game/episode019.rpy:1241
translate simplified_chinese ep019_paclerara_aven_b8ae5b49:

    # c "I seem to remember discussing some very interesting acts that can only be performed on a large bed."
    c "我似乎记得讨论过一些只能在超大床上进行的非常有趣的活动。"

# game/episode019.rpy:1242
translate simplified_chinese ep019_paclerara_aven_448c2e18:

    # c "As it happens, such a large piece of furniture currently stands inside."
    c "巧的是，现在里面正好摆着这么一件大家具。"

# game/episode019.rpy:1245
translate simplified_chinese ep019_paclerara_aven_a5f70a41:

    # c "Consider yourself invited, but only when you’re ready."
    c "当你准备好了，随时欢迎加入。"

# game/episode019.rpy:1247
translate simplified_chinese ep019_paclerara_aven_dec104e7:

    # av "It might surprise you how soon I’ll be ready."
    av "你可能会惊讶于我准备得有多快。"

# game/episode019.rpy:1248
translate simplified_chinese ep019_paclerara_aven_c70507f6:

    # c "Now I’m intrigued."
    c "现在我很好奇。"

# game/episode019.rpy:1249
translate simplified_chinese ep019_paclerara_aven_9b798ef8:

    # c "We could do some precautionary but vigorous bed-testing right now..."
    c "我们现在就可以做些预防性但激烈的床铺测试…"

# game/episode019.rpy:1251
translate simplified_chinese ep019_paclerara_aven_9dd1c223:

    # av "Ugh, I’d love to, but I kinda promised Lilly to go on a walk with her."
    av "呃，我很想，但我答应过莉莉要和她一起散步。"

# game/episode019.rpy:1252
translate simplified_chinese ep019_paclerara_aven_7069a926:

    # c "You could feign a sudden illness?"
    c "你可以装个突然生病？"

# game/episode019.rpy:1254
translate simplified_chinese ep019_paclerara_aven_fbdcc037:

    # av "Tempting, but I already made her the promise before you invited me for dinner."
    av "很诱人，但在你邀请我共进晚餐之前，我就已经答应她了。"

# game/episode019.rpy:1255
translate simplified_chinese ep019_paclerara_aven_eab20dd4:

    # av "Besides, she needs someone to talk to, with Eva in the hospital and all."
    av "而且，伊娃住院了，她需要有人聊聊天。"

# game/episode019.rpy:1256
translate simplified_chinese ep019_paclerara_aven_7963cf59:

    # c "Understood."
    c "明白了。"

# game/episode019.rpy:1257
translate simplified_chinese ep019_paclerara_aven_2fb82098:

    # c "I’ll pencil you in for some vigorous bed-testing tomorrow night."
    c "我会把明晚的激烈床铺测试记在日程上。"

# game/episode019.rpy:1259
translate simplified_chinese ep019_paclerara_aven_bfeaf2b4:

    # "She embraced me and we exchanged a longing kiss."
    "她拥抱了我，我们交换了一个渴望的吻。"

# game/episode019.rpy:1260
translate simplified_chinese ep019_paclerara_aven_1aa6b2f7:

    # "I could feel her body through the thin fabric of her dress and trailed the curve of hips with my hands."
    "我能透过她连衣裙的薄薄布料感受到她的身体，手掌沿着臀部的曲线游走。"

# game/episode019.rpy:1261
translate simplified_chinese ep019_paclerara_aven_caa20d51:

    # "Aven shivered in response as our kiss deepened, her tongue meeting mine."
    "随着我们的吻加深，艾文微微颤抖，她的舌尖与我的交缠在一起。"

# game/episode019.rpy:1264
translate simplified_chinese ep019_paclerara_aven_c67735c9:

    # "My sister moaned as she put her hand on my butt and pulled me closer into the kiss."
    "我的妹妹将手放在我的臀部，把我拉得更近加深这个吻，同时发出一声轻吟。"

# game/episode019.rpy:1266
translate simplified_chinese ep019_paclerara_aven_63b804fb:

    # "My girlfriend moaned as she put her hand on my butt and pulled me closer into the kiss."
    "我的女友将手放在我的臀部，把我拉得更近加深这个吻，同时发出一声轻吟。"

# game/episode019.rpy:1267
translate simplified_chinese ep019_paclerara_aven_e5509019:

    # "When we ultimately disengaged, Aven let out a wistful sigh."
    "当我们最终分开时，艾文发出一声惆怅的叹息。"

# game/episode019.rpy:1269
translate simplified_chinese ep019_paclerara_aven_4e546e44:

    # av "I should really go now, before I lose myself."
    av "我真的该走了，趁我还没完全迷失自己。"

# game/episode019.rpy:1270
translate simplified_chinese ep019_paclerara_aven_d8c4ef1f:

    # c "See you tomorrow."
    c "明天见。"

# game/episode019.rpy:1271
translate simplified_chinese ep019_paclerara_aven_0e1545bb:

    # av "Love you, [p_name]."
    av "爱你，[p_name]。"

# game/episode019.rpy:1277
translate simplified_chinese ep019_paclerara_thyia_17c3d713:

    # "I hadn’t seen Thyia all day, so I went out to look for her."
    "我一整天都没见到塞娅，于是出去找她。"

# game/episode019.rpy:1279
translate simplified_chinese ep019_paclerara_thyia_8684dc1b:

    # "Eventually, I found her on the landing pad near the Bastard."
    "最后，我在\"私生子\"号附近的降落台上找到了她。"

# game/episode019.rpy:1280
translate simplified_chinese ep019_paclerara_thyia_cf962ed2:

    # "She was hunched over the bot she’d been building for some time."
    "她正弓着身子，对着那个已经捣鼓了好一阵子的机器人。"

# game/episode019.rpy:1282
translate simplified_chinese ep019_paclerara_thyia_67d9f26c:

    # th "No, straight ahead!"
    th "不对，直走！"

# game/episode019.rpy:1283
translate simplified_chinese ep019_paclerara_thyia_32e59d0d:

    # th "Dammit, straight ahead!"
    th "该死，往前直走！"

# game/episode019.rpy:1284
translate simplified_chinese ep019_paclerara_thyia_39a9a4fb:

    # th "That’s a right turn, you stupid piece of metal!"
    th "那是右转，你这块愚蠢的金属！"

# game/episode019.rpy:1285
translate simplified_chinese ep019_paclerara_thyia_6d31d7c5:

    # c "Is your bot having behavioral troubles?"
    c "你的机器人行为有问题吗？"

# game/episode019.rpy:1287
translate simplified_chinese ep019_paclerara_thyia_c879ddc8:

    # th "Either that, or it’s deaf..."
    th "要么是这样，要么就是它聋了…"

# game/episode019.rpy:1288
translate simplified_chinese ep019_paclerara_thyia_fe101a1c:

    # c "But, you finished it."
    c "但是，你完成了它。"

# game/episode019.rpy:1289
translate simplified_chinese ep019_paclerara_thyia_d9dd069e:

    # th "That I did."
    th "确实如此。"

# game/episode019.rpy:1290
translate simplified_chinese ep019_paclerara_thyia_c0cdf46c:

    # th "I completed everything last night."
    th "我昨晚完成了所有工作。"

# game/episode019.rpy:1291
translate simplified_chinese ep019_paclerara_thyia_767dc46b:

    # th "This is the first test drive, and I think the voice commands need a bit of work."
    th "这是首次试驾，我觉得语音指令还需要改进。"

# game/episode019.rpy:1292
translate simplified_chinese ep019_paclerara_thyia_b68f0cc6:

    # c "Yeah, but everything else seems to work."
    c "是啊，但其他功能似乎都正常。"

# game/episode019.rpy:1294
translate simplified_chinese ep019_paclerara_thyia_7f3e5a35:

    # th "Yes, it does."
    th "没错，确实如此。"

# game/episode019.rpy:1295
translate simplified_chinese ep019_paclerara_thyia_3784a5e1:

    # th "I’m quite happy with it."
    th "我对它相当满意。"

# game/episode019.rpy:1296
translate simplified_chinese ep019_paclerara_thyia_fe8c8040:

    # c "It’s a brilliant piece of engineering, Thyia."
    c "这真是件杰出的工程杰作，塞娅。"

# game/episode019.rpy:1297
translate simplified_chinese ep019_paclerara_thyia_2662dc1e:

    # c "Especially since you’ve done it all by yourself."
    c "尤其是你独自完成了全部工作。"

# game/episode019.rpy:1299
translate simplified_chinese ep019_paclerara_thyia_b34d6396:

    # th "It’s just a little robot."
    th "不过是个小机器人罢了。"

# game/episode019.rpy:1300
translate simplified_chinese ep019_paclerara_thyia_6b24c9cd:

    # c "Which you’ve built from scratch."
    c "但你可是从零开始建造的。"

# game/episode019.rpy:1301
translate simplified_chinese ep019_paclerara_thyia_7ca43d0e:

    # c "Nothing to be modest about."
    c "没什么可谦虚的。"

# game/episode019.rpy:1303
translate simplified_chinese ep019_paclerara_thyia_ada28bcb:

    # th "If you say so."
    th "既然你这么说。"

# game/episode019.rpy:1304
translate simplified_chinese ep019_paclerara_thyia_734b6bcd:

    # c "So, the next stage is mounting the thing with a load of guns, so it can act as our personal bodyguard?"
    c "那么，下一阶段就是给它装上大量武器，让它当我们的私人保镖？"

# game/episode019.rpy:1306
translate simplified_chinese ep019_paclerara_thyia_98953902:

    # th "You’ve just heard it has trouble obeying simple directional commands, so I’m not sure if arming it is a good idea at stage."
    th "你刚刚听说它连简单的方向指令都有问题，所以我不确定现阶段给它装备武器是不是个好主意。"

# game/episode019.rpy:1307
translate simplified_chinese ep019_paclerara_thyia_a5faf2da:

    # c "I see your point."
    c "我明白你的意思。"

# game/episode019.rpy:1309
translate simplified_chinese ep019_paclerara_thyia_5aa76b8e:

    # th "Seriously though, this bot is just intended to help me carry out repairs and stuff."
    th "不过说真的，这个机器人只是用来帮我维修之类的工作。"

# game/episode019.rpy:1310
translate simplified_chinese ep019_paclerara_thyia_f3815777:

    # c "Keep you company whenever you’re lonely."
    c "在你寂寞的时候陪陪你。"

# game/episode019.rpy:1312
translate simplified_chinese ep019_paclerara_thyia_a7e944aa:

    # th "Ha, yes, looking forward to the philosophical debates we’re undoubtedly going to have."
    th "哈，没错，真期待我们肯定会有的那些哲学辩论。"

# game/episode019.rpy:1313
translate simplified_chinese ep019_paclerara_thyia_5c99904c:

    # c "Just warn me when it starts to question the nature of its existence."
    c "等它开始质疑自身存在本质的时候记得提醒我。"

# game/episode019.rpy:1314
translate simplified_chinese ep019_paclerara_thyia_e6e3ed89:

    # th "You’ll be the first to know when it develops a conscience and the urge to eradicate all life in the known universe."
    th "等它发展出意识并想要消灭已知宇宙中所有生命时，你会是第一个知道的。"

# game/episode019.rpy:1315
translate simplified_chinese ep019_paclerara_thyia_e7693a20:

    # c "I feel safe already."
    c "我已经觉得很有安全感了。"

# game/episode019.rpy:1316
translate simplified_chinese ep019_paclerara_thyia_d9a167d7:

    # c "Nice out here, by the way."
    c "顺便说，这里风景不错。"

# game/episode019.rpy:1318
translate simplified_chinese ep019_paclerara_thyia_7cf488ee:

    # th "It sure is."
    th "确实不错。"

# game/episode019.rpy:1319
translate simplified_chinese ep019_paclerara_thyia_47756235:

    # th "You can see the lake from inside the Residence, but out here it almost seems like you’re surrounded by water."
    th "从宅邸内部也能看到湖景，但站在这里简直像是被水环绕着。"

# game/episode019.rpy:1321
translate simplified_chinese ep019_paclerara_thyia_98fd3e18:

    # "We both looked out over the lake for a while, the robot moving in aimless circles behind us."
    "我们一同凝望湖面片刻，那个机器人在我们身后漫无目的地转着圈。"

# game/episode019.rpy:1322
translate simplified_chinese ep019_paclerara_thyia_84eb6183:

    # th "Any change in Eva’s situation?"
    th "伊娃的情况有什么变化吗？"

# game/episode019.rpy:1323
translate simplified_chinese ep019_paclerara_thyia_f82c73c6:

    # c "No, I’m afraid not."
    c "不，恐怕没有。"

# game/episode019.rpy:1324
translate simplified_chinese ep019_paclerara_thyia_421d0d95:

    # c "The doctors remain hopeful, though I’m not sure if they just say it as reassurance."
    c "医生们仍然抱有希望，虽然我不确定他们这么说是否只是为了安慰人。"

# game/episode019.rpy:1325
translate simplified_chinese ep019_paclerara_thyia_bac2a518:

    # th "That wouldn’t be very professional of them."
    th "那样可不太专业。"

# game/episode019.rpy:1326
translate simplified_chinese ep019_paclerara_thyia_97ca0b98:

    # c "I guess not."
    c "我想也是。"

# game/episode019.rpy:1327
translate simplified_chinese ep019_paclerara_thyia_63d63561:

    # th "So let’s remain hopeful."
    th "所以让我们继续怀抱希望吧。"

# game/episode019.rpy:1329
translate simplified_chinese ep019_paclerara_thyia_b98f72a0:

    # "Thyia covered my hand with hers as we stood by the railing in silence, the water rippling below us."
    "当我们静立在栏杆旁时，塞娅将她的手覆在我的手上，脚下的湖水泛起涟漪。"

# game/episode019.rpy:1331
translate simplified_chinese ep019_paclerara_thyia_3470317f:

    # "After a while, the robot began to bump into us repeatedly and painfully."
    "过了一会儿，机器人开始反复而用力地撞向我们。"

# game/episode019.rpy:1333
translate simplified_chinese ep019_paclerara_thyia_18ecebf3:

    # th "Ow!{w} Reverse and stop at once!"
    th "嗷！{w} 立刻倒车停下！"

# game/episode019.rpy:1334
translate simplified_chinese ep019_paclerara_thyia_31313721:

    # "The robot moved away obediently and came to a halt a short distance away from us."
    "机器人顺从地退开，在我们不远处停了下来。"

# game/episode019.rpy:1336
translate simplified_chinese ep019_paclerara_thyia_6dfb7314:

    # th "Right, I’m going back to beating some sense into that thing."
    th "好吧，我这就回去好好教训那玩意儿。"

# game/episode019.rpy:1337
translate simplified_chinese ep019_paclerara_thyia_c00db45d:

    # c "Go easy, I’m sure it’s just a little clumsy."
    c "手下留情，我敢肯定它只是有点笨拙。"

# game/episode019.rpy:1338
translate simplified_chinese ep019_paclerara_thyia_1a360338:

    # th "Clumsy?{w} I can still feel the spot where it rammed into my shin."
    th "笨拙？{w} 我小腿被撞到的地方现在还疼呢。"

# game/episode019.rpy:1339
translate simplified_chinese ep019_paclerara_thyia_03d06199:

    # c "Be firm, but fair then."
    c "那就坚定点，但要公正。"

# game/episode019.rpy:1340
translate simplified_chinese ep019_paclerara_thyia_09f2a8d5:

    # th "I will."
    th "我会的。"

# game/episode019.rpy:1341
translate simplified_chinese ep019_paclerara_thyia_f7772536:

    # c "Good luck."
    c "祝你好运。"

# game/episode019.rpy:1343
translate simplified_chinese ep019_paclerara_thyia_b2570409:

    # "I kissed Thyia goodbye and left her to discipline the wayward robot."
    "我与塞娅吻别，留她去管教那个任性的机器人。"

# game/episode019.rpy:1348
translate simplified_chinese ep019_paclerara_kit_15a1b1d7:

    # "Kit stepped out of the elevator as I was going back to my room."
    "当我准备回房间时，基特从电梯里走了出来。"

# game/episode019.rpy:1349
translate simplified_chinese ep019_paclerara_kit_2c5b70c5:

    # "At first I thought Kit was talking to himself, but then I registered the peculiar looking alien next to him."
    "起初我以为基特在自言自语，但随后我注意到他身旁那个长相奇特的外星人。"

# game/episode019.rpy:1350
translate simplified_chinese ep019_paclerara_kit_b7a6bcc6:

    # "The creature’s murmuring speech was punctuated by color shift of its skin."
    "这生物的低语声伴随着其肤色的变幻。"

# game/episode019.rpy:1351
translate simplified_chinese ep019_paclerara_kit_73a37ee2:

    # "The effect was rather hypnotic and detracted from its somewhat troubling appearance."
    "这种效果相当催眠，让人忽略了它有些令人不安的外表。"

# game/episode019.rpy:1352
translate simplified_chinese ep019_paclerara_kit_e683232b:

    # "Kit didn’t seem to mind how his conversation partner looked at all, he appeared to be charmed even."
    "基特似乎完全不在意交谈对象的外貌，甚至显得很着迷。"

# game/episode019.rpy:1353
translate simplified_chinese ep019_paclerara_kit_c16e9d4e:

    # ki "You don’t say, I happen to love a good massage!"
    ki "真的吗？我恰好很喜欢优质的按摩！"

# game/episode019.rpy:1355
translate simplified_chinese ep019_paclerara_kit_046fe0cb:

    # ki "Oh hey, [p_name_short]."
    ki "哦嘿，[p_name_short]。"

# game/episode019.rpy:1356
translate simplified_chinese ep019_paclerara_kit_c3896a4f:

    # c "Hi, I thought you were still in the bar?"
    c "嗨，我以为你还在酒吧里？"

# game/episode019.rpy:1357
translate simplified_chinese ep019_paclerara_kit_9a906693:

    # ki "Just left."
    ki "刚离开。"

# game/episode019.rpy:1358
translate simplified_chinese ep019_paclerara_kit_489593aa:

    # ki "Oh, allow me to introduce you to Pllxytlxx."
    ki "哦，请允许我向你介绍普利克斯泰尔克斯。"

# game/episode019.rpy:1359
translate simplified_chinese ep019_paclerara_kit_026e6bae:

    # ki "Pllxytlxx, this is my friend [p_name]."
    ki "普利克斯泰尔克斯，这位是我的朋友[p_name]。"

# game/episode019.rpy:1360
translate simplified_chinese ep019_paclerara_kit_ec602286:

    # c "Nice to meet you."
    c "很高兴认识你。"

# game/episode019.rpy:1362
translate simplified_chinese ep019_paclerara_kit_c6016b96:

    # woman "Singleton one is bestowed an honor."
    woman "单一个体深感荣幸。"

# game/episode019.rpy:1363
translate simplified_chinese ep019_paclerara_kit_78ae6952:

    # "It took me a few seconds to work out that the alien was talking about itself being honored to meet me."
    "我花了几秒钟才反应过来，这个外星人是在说很荣幸见到我。"

# game/episode019.rpy:1364
translate simplified_chinese ep019_paclerara_kit_caad375a:

    # ki "I’ve met Pllxytlxx in the bar below, and we’ve been talking for hours."
    ki "我在楼下的酒吧认识了普利克斯泰尔克斯，我们已经聊了好几个小时。"

# game/episode019.rpy:1365
translate simplified_chinese ep019_paclerara_kit_babeb87c:

    # ki "We’ve just decided to continue our conversation in my room."
    ki "我们刚决定去我房间继续聊。"

# game/episode019.rpy:1366
translate simplified_chinese ep019_paclerara_kit_89aefe22:

    # c "I see."
    c "我明白了。"

# game/episode019.rpy:1367
translate simplified_chinese ep019_paclerara_kit_68983400:

    # "Pllxytlxx seemed to be impatient and hovered further up the hallway."
    "普利克斯泰尔克斯似乎有些不耐烦，沿着走廊往前飘远了。"

# game/episode019.rpy:1368
translate simplified_chinese ep019_paclerara_kit_03d7a783:

    # ki "You go on ahead, I’ll be with you in just a moment."
    ki "你先过去吧，我马上就来。"

# game/episode019.rpy:1370
translate simplified_chinese ep019_paclerara_kit_66798e1d:

    # woman "Singleton is thirsting for more words."
    woman "单一个体渴望更多的交谈。"

# game/episode019.rpy:1371
translate simplified_chinese ep019_paclerara_kit_130ddbb2:

    # "Kit opened the door to his room from his tablet and Pllxytlxx floated inside."
    "基特用平板打开了自己房间的门，普利克斯泰尔克斯飘了进去。"

# game/episode019.rpy:1372
translate simplified_chinese ep019_paclerara_kit_fcfff26d:

    # "Just before she crossed the threshold her skin turned a vibrant red."
    "就在她跨过门槛前，她的皮肤变成了鲜艳的红色。"

# game/episode019.rpy:1373
translate simplified_chinese ep019_paclerara_kit_6d1deaec:

    # woman "Singleton will be waiting."
    woman "单例会等待。"

# game/episode019.rpy:1374
translate simplified_chinese ep019_paclerara_kit_710b3775:

    # "Mesmerized and faintly weirded out for a moment, I turned back to Kit."
    "我一时着迷又隐约觉得奇怪，便转身看向基特。"

# game/episode019.rpy:1376
translate simplified_chinese ep019_paclerara_kit_909e3461:

    # ki "Damn, she turned red."
    ki "该死，她变红了。"

# game/episode019.rpy:1377
translate simplified_chinese ep019_paclerara_kit_cc869f33:

    # ki "That one is so ready for me."
    ki "那个已经为我准备好了。"

# game/episode019.rpy:1378
translate simplified_chinese ep019_paclerara_kit_5476996d:

    # c "Wait a minute, are you planning on having sex with her?"
    c "等一下，你打算和她做爱吗？"

# game/episode019.rpy:1380
translate simplified_chinese ep019_paclerara_kit_a3f4effb:

    # ki "I’m not sure the C’taet have a concept of gender."
    ki "我不确定克塔特人是否有性别的概念。"

# game/episode019.rpy:1381
translate simplified_chinese ep019_paclerara_kit_d4542ac6:

    # c "But you are planning to have sex?"
    c "但你确实打算做爱？"

# game/episode019.rpy:1383
translate simplified_chinese ep019_paclerara_kit_ab68543b:

    # ki "I will if Pllxytlxx will have me."
    ki "如果普利克斯泰尔克斯愿意的话，我会的。"

# game/episode019.rpy:1384
translate simplified_chinese ep019_paclerara_kit_704f7352:

    # ki "We really clicked back in the bar, [p_name_short]."
    ki "我们在酒吧里真的很投缘，[p_name_short]。"

# game/episode019.rpy:1385
translate simplified_chinese ep019_paclerara_kit_95b72675:

    # c "She doesn’t look like your usual type."
    c "她看起来不像你平时的菜。"

# game/episode019.rpy:1387
translate simplified_chinese ep019_paclerara_kit_4ca74833:

    # ki "I wasn’t aware I had a type."
    ki "我都不知道自己还有固定偏好。"

# game/episode019.rpy:1388
translate simplified_chinese ep019_paclerara_kit_21cd3765:

    # c "I do admit you had some outlandish lays back in the day, but Pllxytlxx looks rather fearsome."
    c "我承认你以前确实有过些古怪的艳遇，但普利克斯泰尔克斯看起来相当吓人。"

# game/episode019.rpy:1389
translate simplified_chinese ep019_paclerara_kit_378aa1e2:

    # ki "You think so?"
    ki "你这么觉得？"

# game/episode019.rpy:1390
translate simplified_chinese ep019_paclerara_kit_451cf69f:

    # c "Well, the serrated tentacles covering the beak, mouth or whatever for a start..."
    c "呃，先说那覆盖在喙或嘴巴上的锯齿状触手…"

# game/episode019.rpy:1392
translate simplified_chinese ep019_paclerara_kit_9330aca7:

    # ki "Those are tactile hairs and actually very soft."
    ki "那些是触觉毛发，其实非常柔软。"

# game/episode019.rpy:1393
translate simplified_chinese ep019_paclerara_kit_b42e6d07:

    # c "I should have known you already copped a feel."
    c "我早该知道你都已经摸过了。"

# game/episode019.rpy:1395
translate simplified_chinese ep019_paclerara_kit_f8de0ed7:

    # ki "Well, I know for a fact that C’taet are supposed to be incredible in the sack."
    ki "好吧，我确切知道克塔特人在床上应该非常厉害。"

# game/episode019.rpy:1396
translate simplified_chinese ep019_paclerara_kit_aec29b05:

    # ki "And since the Sovereignty outlawed any non-humanoid species to have fun with, I feel rather left out."
    ki "既然\"至高权域\"禁止与任何人形以外的物种寻欢作乐，我感觉相当吃亏。"

# game/episode019.rpy:1397
translate simplified_chinese ep019_paclerara_kit_b1c70369:

    # c "You seem to have done your homework and rather determined."
    c "你似乎做足了功课，而且相当坚决。"

# game/episode019.rpy:1398
translate simplified_chinese ep019_paclerara_kit_1542d56e:

    # c "But just be careful, Kit."
    c "但还是要小心点，基特。"

# game/episode019.rpy:1399
translate simplified_chinese ep019_paclerara_kit_43eb1f55:

    # c "You know what happened to the first human who stuck his penis in a Sircovican jelly colony."
    c "你知道第一个把阴茎伸进西尔科维坎水母群的人类遭遇了什么。"

# game/episode019.rpy:1401
translate simplified_chinese ep019_paclerara_kit_a44c488b:

    # ki "Pllxytlxx has already assured me that they’re not corrosive."
    ki "普利克斯泰尔克斯已经向我保证过它们没有腐蚀性。"

# game/episode019.rpy:1402
translate simplified_chinese ep019_paclerara_kit_862b8374:

    # ki "So I’ll be keeping all my appendages tonight."
    ki "所以今晚我会保留我所有的肢体。"

# game/episode019.rpy:1403
translate simplified_chinese ep019_paclerara_kit_607e3acc:

    # c "Ever the explorer..."
    c "永远是个探险家啊…"

# game/episode019.rpy:1404
translate simplified_chinese ep019_paclerara_kit_6bfa6635:

    # c "Well, go for it then."
    c "好吧，那就去吧。"

# game/episode019.rpy:1405
translate simplified_chinese ep019_paclerara_kit_e31a12a1:

    # "Kit all but sprinted toward the entrance of his room."
    "基特几乎是冲向了他房间的入口。"

# game/episode019.rpy:1407
translate simplified_chinese ep019_paclerara_kit_8e731c8b:

    # ki "I’ll tell you all about it tomorrow."
    ki "明天我会把一切都告诉你。"

# game/episode019.rpy:1408
translate simplified_chinese ep019_paclerara_kit_cffbbb2f:

    # c "I’m sure you will."
    c "我相信你会的。"

# game/episode019.rpy:1409
translate simplified_chinese ep019_paclerara_kit_37618bbe:

    # "Giddy with excitement, Kit disappeared from view and I went into the elevator, trying hard not to think about those fearsome yet reportedly very soft tactile hairs..."
    "基特兴奋得晕头转向，从视野中消失了，我走进电梯，努力不去想那些可怕但据说非常柔软的触觉毛发…"

# game/episode019.rpy:1429
translate simplified_chinese ep019_paclerara_eva_9161f17f:

    # "Perhaps a futile gesture, but I wanted to be close to Eva."
    "或许这是个徒劳的举动，但我就是想靠近伊娃。"

# game/episode019.rpy:1430
translate simplified_chinese ep019_paclerara_eva_32a503a4:

    # "The medical staff let me inside Eva’s room without much fuss."
    "医护人员没怎么阻拦就让我进了伊娃的房间。"

# game/episode019.rpy:1432
translate simplified_chinese ep019_paclerara_eva_70857b65:

    # "The sun was shining through the large windows, bathing Eva in a golden light."
    "阳光透过大窗户洒进来，将伊娃笼罩在金色的光芒中。"

# game/episode019.rpy:1434
translate simplified_chinese ep019_paclerara_eva_6bf886f3:

    # "My sister looked peaceful and serene."
    "我的妹妹看起来平静而安详。"

# game/episode019.rpy:1437
translate simplified_chinese ep019_paclerara_eva_c99fcf3f:

    # "My girlfriend looked peaceful and serene."
    "我的女友看起来平静而安详。"

# game/episode019.rpy:1439
translate simplified_chinese ep019_paclerara_eva_444468df:

    # "My friend looked peaceful and serene."
    "我的朋友看起来平静而安详。"

# game/episode019.rpy:1441
translate simplified_chinese ep019_paclerara_eva_838117a5:

    # "I grabbed a chair and sat next to her."
    "我搬了把椅子坐在她身旁。"

# game/episode019.rpy:1442
translate simplified_chinese ep019_paclerara_eva_bdfc9e24:

    # "Not sure what to do with myself, I began to talk to her."
    "不知该做些什么，我开始对她说话。"

# game/episode019.rpy:1443
translate simplified_chinese ep019_paclerara_eva_c99dcbaf:

    # "I knew she probably couldn’t hear me, but I did it anyway."
    "我知道她很可能听不见，但我还是这么做了。"

# game/episode019.rpy:1444
translate simplified_chinese ep019_paclerara_eva_726d5973:

    # c "Hey, Eva."
    c "嘿，伊娃。"

# game/episode019.rpy:1445
translate simplified_chinese ep019_paclerara_eva_4913c320:

    # c "We’ve reached Paclerara and you’re now in a hospital."
    c "我们已经到达帕克莱拉拉，你现在住进了医院。"

# game/episode019.rpy:1446
translate simplified_chinese ep019_paclerara_eva_0fe88c4f:

    # c "It’s a planet where a lot of Jade’s people live, and it’s quite beautiful."
    c "这是很多杰德族人居住的星球，景色非常美丽。"

# game/episode019.rpy:1447
translate simplified_chinese ep019_paclerara_eva_45425af1:

    # c "I wish you could be here to see it."
    c "真希望你能亲眼看看这里。"

# game/episode019.rpy:1448
translate simplified_chinese ep019_paclerara_eva_343bac5c:

    # "Having a one-sided conversation turned out to be hard work."
    "进行单方面对话原来是件很困难的事。"

# game/episode019.rpy:1451
translate simplified_chinese ep019_paclerara_eva_1bd3782e:

    # "I paused for a moment to look at my sister."
    "我停顿片刻，注视着我的妹妹。"

# game/episode019.rpy:1453
translate simplified_chinese ep019_paclerara_eva_52965686:

    # "I paused for a moment to look at Eva."
    "我停顿片刻，注视着伊娃。"

# game/episode019.rpy:1454
translate simplified_chinese ep019_paclerara_eva_19e7fade:

    # "My gaze traveled over the steady rise and fall of her chest, the soft features of her face, her full mouth and the long lashes of her closed eyes."
    "我的目光掠过她平稳起伏的胸膛，她柔和的面部轮廓，饱满的双唇和紧闭双眼上长长的睫毛。"

# game/episode019.rpy:1455
translate simplified_chinese ep019_paclerara_eva_84b80644:

    # "The sight of her filled me with such sadness."
    "看着她的模样让我充满了悲伤。"

# game/episode019.rpy:1457
translate simplified_chinese ep019_paclerara_eva_4c7698d0:

    # "I didn’t want to burst out in tears next to her, so I tried to continue making conversation."
    "我不想在她身边突然哭出来，于是试图继续交谈。"

# game/episode019.rpy:1458
translate simplified_chinese ep019_paclerara_eva_4ff16d48:

    # c "You are going to get through this."
    c "你一定能挺过去的。"

# game/episode019.rpy:1459
translate simplified_chinese ep019_paclerara_eva_fbfca51b:

    # c "The doctors here are very good, so you’ll have the best care available."
    c "这里的医生非常优秀，所以你将会得到最好的治疗。"

# game/episode019.rpy:1460
translate simplified_chinese ep019_paclerara_eva_0632a620:

    # c "You’ll wake up soon, I’m sure of it."
    c "你很快就会醒来的，我对此深信不疑。"

# game/episode019.rpy:1461
translate simplified_chinese ep019_paclerara_eva_6b55d716:

    # c "And we’ll all be there for you, I hope you know that."
    c "而且我们所有人都会陪在你身边，我希望你明白这一点。"

# game/episode019.rpy:1462
translate simplified_chinese ep019_paclerara_eva_e1b4a3c7:

    # c "I’m going to leave you for a while now, but I’ll be back tomorrow."
    c "我现在要离开你一会儿，但明天我会再来看你。"

# game/episode019.rpy:1464
translate simplified_chinese ep019_paclerara_eva_bfc3a848:

    # "I kissed her forehead lightly and walked out of the room with a heavy heart."
    "我轻轻吻了她的额头，心情沉重地走出了房间。"

# game/episode019.rpy:1469
translate simplified_chinese ep019_paclerara_eva_alt_5461ad73:

    # "I was standing on the balcony looking out over the lake when Lilly stormed in."
    "我正站在阳台上眺望着湖面，这时莉莉冲了进来。"

# game/episode019.rpy:1470
translate simplified_chinese ep019_paclerara_eva_alt_feb24f17:

    # l "[p_name_short]!"
    l "[p_name_short]!"

# game/episode019.rpy:1471
translate simplified_chinese ep019_paclerara_eva_alt_0c67ff30:

    # l "She’s awake!"
    l "她醒了！"

# game/episode019.rpy:1473
translate simplified_chinese ep019_paclerara_eva_alt_ca0bcd87:

    # "There was no doubt on who she meant, so I sprinted after Lilly as she turned and ran back through the door again."
    "毫无疑问她指的是谁，于是我跟着莉莉转身再次冲出门去。"

# game/episode019.rpy:1474
translate simplified_chinese ep019_paclerara_eva_alt_f7eaf038:

    # c "Have you talked to her?"
    c "你跟她说过话了吗？"

# game/episode019.rpy:1475
translate simplified_chinese ep019_paclerara_eva_alt_a4461a2f:

    # l "A few words."
    l "只说了几句。"

# game/episode019.rpy:1476
translate simplified_chinese ep019_paclerara_eva_alt_b6c58f18:

    # l "She still seems a little groggy, but otherwise fine."
    l "她看起来还有点昏昏沉沉，但除此之外状态不错。"

# game/episode019.rpy:1478
translate simplified_chinese ep019_paclerara_eva_alt_aff4c475:

    # "Rushing through the corridors of the Residence, we reached Eva’s room in the hospital area of the complex."
    "我们匆忙穿过官邸的走廊，抵达了建筑群医疗区内伊娃的房间。"

# game/episode019.rpy:1480
translate simplified_chinese ep019_paclerara_eva_alt_7cf5e427:

    # "The door was already open, and Eva was sitting on the edge of her bed."
    "房门已经敞开，伊娃正坐在床沿。"

# game/episode019.rpy:1482
translate simplified_chinese ep019_paclerara_eva_alt_bdac236b:

    # "She jumped up when she saw us."
    "看到我们时她猛地站起身。"

# game/episode019.rpy:1483
translate simplified_chinese ep019_paclerara_eva_alt_8f635990:

    # e "I know where to go!"
    e "我知道该去哪里了！"

# game/episode019.rpy:1484
translate simplified_chinese ep019_paclerara_eva_alt_9c0ac8a2:

    # e "I’ve found the Abyss of Birds!"
    e "我找到\"鸟之深渊\"了！"

# game/episode019.rpy:1485
translate simplified_chinese ep019_paclerara_eva_alt_4ace722f:

    # "The sudden effort was obviously too much for her, so Eva nearly toppled over."
    "这突如其来的举动显然让她耗费了太多力气，伊娃险些摔倒。"

# game/episode019.rpy:1487
translate simplified_chinese ep019_paclerara_eva_alt_7ec8dec6:

    # "At the last moment, she steadied herself against the bed and sat down again."
    "在最后关头，她扶着床稳住了身体，重新坐了下来。"

# game/episode019.rpy:1489
translate simplified_chinese ep019_paclerara_eva_alt_100cac30:

    # e "Sorry about that."
    e "抱歉。"

# game/episode019.rpy:1490
translate simplified_chinese ep019_paclerara_eva_alt_9a657059:

    # "I resisted the urge to hug her fiercely, as it would be a little difficult with her sitting again."
    "我强忍住紧紧拥抱她的冲动，毕竟她又坐下了，这样做会有些不便。"

# game/episode019.rpy:1491
translate simplified_chinese ep019_paclerara_eva_alt_d68c51ec:

    # "She also still looked very frail."
    "她看起来仍然非常虚弱。"

# game/episode019.rpy:1492
translate simplified_chinese ep019_paclerara_eva_alt_c3dc605f:

    # c "How are you feeling, Eva?"
    c "你感觉怎么样，伊娃？"

# game/episode019.rpy:1494
translate simplified_chinese ep019_paclerara_eva_alt_76a7ce2d:

    # e "Fine, I guess?"
    e "我觉得还好？"

# game/episode019.rpy:1496
translate simplified_chinese ep019_paclerara_eva_alt_21a959c0:

    # e "It feels like I slept for days, which is exactly what happened if I am to believe the doctors here."
    e "感觉像是睡了几天，如果我相信这里的医生的话，事实也确实如此。"

# game/episode019.rpy:1497
translate simplified_chinese ep019_paclerara_eva_alt_72a796fb:

    # c "Yes, you were out for a while."
    c "是的，你昏迷了一段时间。"

# game/episode019.rpy:1499
translate simplified_chinese ep019_paclerara_eva_alt_52123328:

    # l "What the hell happened, Eva?"
    l "到底发生了什么，伊娃？"

# game/episode019.rpy:1501
translate simplified_chinese ep019_paclerara_eva_alt_dc8aef67:

    # e "It’s all a little hazy."
    e "一切都有些模糊不清。"

# game/episode019.rpy:1502
translate simplified_chinese ep019_paclerara_eva_alt_b9de90b2:

    # e "Ever since we retrieved the artifact I’ve been feeling weird."
    e "自从我们找回那个神器后，我就一直感觉很奇怪。"

# game/episode019.rpy:1504
translate simplified_chinese ep019_paclerara_eva_alt_934c4edb:

    # e "Like I was drawn towards it."
    e "好像被它吸引了一样。"

# game/episode019.rpy:1505
translate simplified_chinese ep019_paclerara_eva_alt_be79fd6e:

    # e "It kept me up at night, as if it was calling to me."
    e "它让我夜不能寐，仿佛在呼唤着我。"

# game/episode019.rpy:1507
translate simplified_chinese ep019_paclerara_eva_alt_29ba355b:

    # e "Sounds weird, right?"
    e "听起来很奇怪，对吧？"

# game/episode019.rpy:1508
translate simplified_chinese ep019_paclerara_eva_alt_2c93a438:

    # c "No, it doesn’t, considering what’s happened."
    c "不，考虑到发生的事情，这并不奇怪。"

# game/episode019.rpy:1510
translate simplified_chinese ep019_paclerara_eva_alt_911ebbcd:

    # e "So when the Key was on the Bastard the call became too strong."
    e "所以当\"钥匙\"在\"私生子\"号上时，那种呼唤变得太强烈了。"

# game/episode019.rpy:1511
translate simplified_chinese ep019_paclerara_eva_alt_91c27622:

    # e "Probably because it was closer by, I don’t know?"
    e "可能是因为它离得更近了，我也不确定？"

# game/episode019.rpy:1512
translate simplified_chinese ep019_paclerara_eva_alt_57622136:

    # e "I got into the hold and touched the Key."
    e "我进入货舱，触摸了那个\"钥匙\"。"

# game/episode019.rpy:1514
translate simplified_chinese ep019_paclerara_eva_alt_f6dbc036:

    # "Eva closed her eyes for a moment, her body swinging a little, as if she felt woozy."
    "伊娃闭上眼睛片刻，身体微微摇晃，仿佛感到头晕。"

# game/episode019.rpy:1515
translate simplified_chinese ep019_paclerara_eva_alt_51a89eb6:

    # "It took some effort for the open her eyes again."
    "她费了些力气才重新睁开眼睛。"

# game/episode019.rpy:1516
translate simplified_chinese ep019_paclerara_eva_alt_8e1a6462:

    # c "What did you mean earlier, about knowing where to go?"
    c "你之前说知道该去哪里是什么意思？"

# game/episode019.rpy:1518
translate simplified_chinese ep019_paclerara_eva_alt_9fdb196b:

    # l "Something about birds?"
    l "和鸟类有关？"

# game/episode019.rpy:1520
translate simplified_chinese ep019_paclerara_eva_alt_ab24d578:

    # e "Yes!"
    e "没错！"

# game/episode019.rpy:1522
translate simplified_chinese ep019_paclerara_eva_alt_02b3067a:

    # e "So, as soon as I touched the Key, it was as if something exploded in my head."
    e "所以，当我触摸到钥匙的瞬间，仿佛有什么在我脑海中炸开。"

# game/episode019.rpy:1523
translate simplified_chinese ep019_paclerara_eva_alt_c58f2801:

    # e "Suddenly, there were all these visions."
    e "突然间，浮现出所有这些幻象。"

# game/episode019.rpy:1524
translate simplified_chinese ep019_paclerara_eva_alt_3f371cc7:

    # e "Like a series of pictures, rapidly flashing before my eyes."
    e "就像一连串的画面，飞快地在我眼前闪过。"

# game/episode019.rpy:1525
translate simplified_chinese ep019_paclerara_eva_alt_e06e933c:

    # e "They kept repeating."
    e "它们不断重复着。"

# game/episode019.rpy:1526
translate simplified_chinese ep019_paclerara_eva_alt_25934196:

    # e "I saw three stars glowing brightly, a planet in orbit washed in the light of a supernova."
    e "我看到了三颗闪耀的恒星，一颗行星在超新星光芒的照耀下运行在轨道上。"

# game/episode019.rpy:1527
translate simplified_chinese ep019_paclerara_eva_alt_61e489d2:

    # e "Then I walked across a volcanic plain, filled with skeletons, until I came upon a large crater."
    e "然后我走过一片遍布骸骨的火山平原，直到遇见一个巨大的陨石坑。"

# game/episode019.rpy:1528
translate simplified_chinese ep019_paclerara_eva_alt_bf54686c:

    # e "I descended into the crater, the sounds of birds all around me."
    e "我下到陨石坑里，四周环绕着鸟鸣声。"

# game/episode019.rpy:1529
translate simplified_chinese ep019_paclerara_eva_alt_12d1ece4:

    # c "That sounds very familiar."
    c "这听起来非常熟悉。"

# game/episode019.rpy:1531
translate simplified_chinese ep019_paclerara_eva_alt_d721c5fc:

    # e "Yes, it does, because it’s straight from the prophecy."
    e "是的，确实熟悉，因为这直接来自预言。"

# game/episode019.rpy:1532
translate simplified_chinese ep019_paclerara_eva_alt_93f71a01:

    # e "It starts with “in the dying light of triple suns” and later it talks about a “field of ancient hubris and conceit“."
    e "开头是\"在三重太阳的垂死之光中\"，后面又提到了\"古老傲慢与自负之地\"。"

# game/episode019.rpy:1533
translate simplified_chinese ep019_paclerara_eva_alt_c8e8ac5e:

    # e "The latter is clearly the site of a massacre, like I saw in those visions."
    e "后者明显是个屠杀现场，就像我在那些幻象中看到的。"

# game/episode019.rpy:1535
translate simplified_chinese ep019_paclerara_eva_alt_e1d23b5c:

    # l "But Eva, you’ve been studying that prophecy for a while now."
    l "但是伊娃，你研究那个预言已经有一段时间了。"

# game/episode019.rpy:1536
translate simplified_chinese ep019_paclerara_eva_alt_d8511dbf:

    # l "Do those dreams not just indicate that your subconscious is processing the things you’ve read?"
    l "那些梦境难道不就只是表明你的潜意识在消化你读过的东西吗？"

# game/episode019.rpy:1538
translate simplified_chinese ep019_paclerara_eva_alt_dc31a32a:

    # e "I considered that, but I’m sure it isn’t that."
    e "我考虑过这一点，但我确定不是那样。"

# game/episode019.rpy:1539
translate simplified_chinese ep019_paclerara_eva_alt_d388aec3:

    # e "Because of those visions I know where we need to go."
    e "正是因为那些幻象，我知道我们需要去哪里。"

# game/episode019.rpy:1540
translate simplified_chinese ep019_paclerara_eva_alt_45807339:

    # e "The third line of the prophecy always puzzled me, the one about the great bear roaring."
    e "预言的第三行一直让我困惑，就是关于大熊咆哮的那部分。"

# game/episode019.rpy:1541
translate simplified_chinese ep019_paclerara_eva_alt_349d910c:

    # e "I thought the planet mentioned in the prophecy was wrapped in noise, like a persistent aural storm or something."
    e "我原本以为预言中提到的行星被噪音包裹着，像是持续不断的听觉风暴之类的东西。"

# game/episode019.rpy:1543
translate simplified_chinese ep019_paclerara_eva_alt_5793209b:

    # e "But the visions showed me something else."
    e "但幻象向我展示了别的东西。"

# game/episode019.rpy:1544
translate simplified_chinese ep019_paclerara_eva_alt_c8179d81:

    # e "I really saw the dying light, it was from a star gone supernova, hence “the great bear roars”."
    e "我真的看到了垂死之光，那是来自一颗变成超新星的恒星，因此\"大熊咆哮\"。"

# game/episode019.rpy:1546
translate simplified_chinese ep019_paclerara_eva_alt_80352fe4:

    # l "You’ve lost me there."
    l "你把我搞糊涂了。"

# game/episode019.rpy:1548
translate simplified_chinese ep019_paclerara_eva_alt_780242f9:

    # e "Ursa Major, one of the oldest discovered constellations."
    e "大熊座，最早被发现的星座之一。"

# game/episode019.rpy:1549
translate simplified_chinese ep019_paclerara_eva_alt_6da1cf3b:

    # e "“Ursa” is a derivation of “ursus”, meaning “bear”."
    e "“Ursa”是“ursus”的派生词，意为“熊”。"

# game/episode019.rpy:1550
translate simplified_chinese ep019_paclerara_eva_alt_3739c14e:

    # c "So you’re saying the prophecy points to a triple star system somewhere in Ursa Major, likely ravaged by a supernova at some point."
    c "所以你是说预言指向大熊座某处的三合星系统，很可能曾遭受超新星爆发。"

# game/episode019.rpy:1551
translate simplified_chinese ep019_paclerara_eva_alt_1d0be274:

    # c "I guess that narrows it down somewhat, but still not a lot."
    c "我想这范围确实缩小了些，但仍然不算小。"

# game/episode019.rpy:1553
translate simplified_chinese ep019_paclerara_eva_alt_a10c6d44:

    # e "I’m aware that it’s still a lot of space to cover."
    e "我知道这仍意味着要搜索很大一片区域。"

# game/episode019.rpy:1554
translate simplified_chinese ep019_paclerara_eva_alt_8080d714:

    # e "But there aren’t a lot of triple-star systems in Ursa Major and we’re looking for a very old system."
    e "但大熊座里没有多少三合星系统，而且我们要找的是个非常古老的星系。"

# game/episode019.rpy:1555
translate simplified_chinese ep019_paclerara_eva_alt_501a456c:

    # e "And this might sound insane, but I’m fairly sure I’ll know when we’re in the right place."
    e "这听起来可能很疯狂，但我相当确定当我们到达正确位置时我会有所感应。"

# game/episode019.rpy:1557
translate simplified_chinese ep019_paclerara_eva_alt_103fd941:

    # l "You’re saying you’re like a human way sign now?"
    l "你是说你现在像个人形路标？"

# game/episode019.rpy:1559
translate simplified_chinese ep019_paclerara_eva_alt_2f0a1871:

    # e "I said it might sound insane."
    e "我说过这可能听起来很疯狂。"

# game/episode019.rpy:1560
translate simplified_chinese ep019_paclerara_eva_alt_ecd89094:

    # c "Insane though it might be, I don’t think we can ignore what’s happened to you."
    c "尽管可能疯狂，但我觉得我们不能忽视发生在你身上的事。"

# game/episode019.rpy:1561
translate simplified_chinese ep019_paclerara_eva_alt_4559275a:

    # c "The Key clearly had an effect on you, and it seemed drained after you touched it."
    c "那把钥匙显然对你产生了影响，而且在你触碰它之后似乎能量耗尽了。"

# game/episode019.rpy:1562
translate simplified_chinese ep019_paclerara_eva_alt_8995ab79:

    # c "You haven’t had any dreams about the prophecy before, did you?"
    c "你之前从未做过关于预言的梦，对吗？"

# game/episode019.rpy:1564
translate simplified_chinese ep019_paclerara_eva_alt_d9f67eec:

    # e "No, not at all."
    e "是的，完全没有。"

# game/episode019.rpy:1565
translate simplified_chinese ep019_paclerara_eva_alt_46f2e12b:

    # c "So we should take this seriously."
    c "所以我们应该认真对待这件事。"

# game/episode019.rpy:1566
translate simplified_chinese ep019_paclerara_eva_alt_7984460f:

    # c "Could you confer with Céline, make a list of possible triple-star systems we could visit?"
    c "你能和瑟琳商议一下，列出我们可能前往的三合星系统清单吗？"

# game/episode019.rpy:1567
translate simplified_chinese ep019_paclerara_eva_alt_32ad8933:

    # e "Yes, I’ll message Céline to visit me."
    e "好的，我会发消息让瑟琳来见我。"

# game/episode019.rpy:1568
translate simplified_chinese ep019_paclerara_eva_alt_70cc186d:

    # c "Good, but only if you’re feeling better."
    c "很好，但前提是你感觉好些了。"

# game/episode019.rpy:1570
translate simplified_chinese ep019_paclerara_eva_alt_4bf58ffb:

    # l "Yes, we don’t want you to exert yourself."
    l "没错，我们不希望你过度劳累。"

# game/episode019.rpy:1572
translate simplified_chinese ep019_paclerara_eva_alt_2fb96431:

    # e "I might need to lie down, feeling a bit queasy again."
    e "我可能需要躺下休息，又有点想吐的感觉。"

# game/episode019.rpy:1573
translate simplified_chinese ep019_paclerara_eva_alt_301125db:

    # c "Of course, we’ll leave you in peace for now."
    c "当然，我们暂时让你安静休息。"

# game/episode019.rpy:1575
translate simplified_chinese ep019_paclerara_eva_alt_f8f1efa6:

    # "Lilly and I walked out of the room as Eva got back onto the bed."
    "莉莉和我走出房间时，伊娃回到了床上。"

# game/episode019.rpy:1577
translate simplified_chinese ep019_paclerara_eva_alt_c11fb54e:

    # l "Do you think there’s anything to Eva’s dreams?"
    l "你觉得伊娃的梦境有什么特别含义吗？"

# game/episode019.rpy:1578
translate simplified_chinese ep019_paclerara_eva_alt_5d9a17d6:

    # c "It’s too much of a coincidence and the only lead we have right now."
    c "这巧合得太过分了，而且是我们现在唯一的线索。"

# game/episode019.rpy:1579
translate simplified_chinese ep019_paclerara_eva_alt_7597b0be:

    # l "True, I just hope this isn’t some wild goose chase."
    l "确实，我只希望这不是在瞎折腾。"

# game/episode019.rpy:1580
translate simplified_chinese ep019_paclerara_eva_alt_fffaad0e:

    # l "And I also wonder what we’ll find there..."
    l "而且我也好奇我们会在那里发现什么…"

# game/episode019.rpy:1586
translate simplified_chinese ep019_paclerara_thim_da953d68:

    # "Thim hurried towards me as I was crossing the square."
    "我穿过广场时，蒂姆匆忙朝我走来。"

# game/episode019.rpy:1587
translate simplified_chinese ep019_paclerara_thim_cfa67ef4:

    # c "Can I help you with something?"
    c "需要我帮忙吗？"

# game/episode019.rpy:1589
translate simplified_chinese ep019_paclerara_thim_ac29d869:

    # t "Yes, I want a word."
    t "是的，我想和你谈谈。"

# game/episode019.rpy:1590
translate simplified_chinese ep019_paclerara_thim_67fce720:

    # c "Shoot."
    c "说吧。"

# game/episode019.rpy:1591
translate simplified_chinese ep019_paclerara_thim_8305c8c8:

    # "I could tell Thim was rather nervous, he didn’t seem as hostile as he normally was."
    "我能看出蒂姆相当紧张，他看起来不像平时那么充满敌意。"

# game/episode019.rpy:1592
translate simplified_chinese ep019_paclerara_thim_7ab8ead9:

    # t "I want out."
    t "我想退出。"

# game/episode019.rpy:1593
translate simplified_chinese ep019_paclerara_thim_d4b292db:

    # t "You’ve dragged me along all this time and I’ve never complained, but I’m done."
    t "你一直拖着我到处跑，我从未抱怨过，但我受够了。"

# game/episode019.rpy:1594
translate simplified_chinese ep019_paclerara_thim_74b979a5:

    # c "You’re a security risk, Thim."
    c "你是个安全隐患，蒂姆。"

# game/episode019.rpy:1595
translate simplified_chinese ep019_paclerara_thim_22d5f3d2:

    # c "You have been since you decided to call the guards on us back on the Ypotryll."
    c "自从你在\"异龙\"号上决定向守卫举报我们时就是了。"

# game/episode019.rpy:1597
translate simplified_chinese ep019_paclerara_thim_52bd9b8f:

    # t "That was ages ago!"
    t "那都是很久以前的事了！"

# game/episode019.rpy:1598
translate simplified_chinese ep019_paclerara_thim_7afe6ef5:

    # c "Maybe, but who’s to say you won’t go running to the authorities as soon as we cut you loose?"
    c "也许吧，但谁又能保证我们放你走后你不会立刻跑去向当局告密？"

# game/episode019.rpy:1600
translate simplified_chinese ep019_paclerara_thim_c0d0c5b9:

    # t "I won’t, you have my word."
    t "我不会的，我向你保证。"

# game/episode019.rpy:1604
translate simplified_chinese ep019_paclerara_thim_ec66f4ac:

    # c "You want to stay here?"
    c "你想留在这里？"

# game/episode019.rpy:1606
translate simplified_chinese ep019_paclerara_thim_c546a618:

    # t "Maybe, I don’t know."
    t "也许吧，我不知道。"

# game/episode019.rpy:1607
translate simplified_chinese ep019_paclerara_thim_85b8a019:

    # t "I just want to do something with my life, instead of tagging along with the crew."
    t "我只是想为自己的人生做点什么，而不是跟着船员们到处跑。"

# game/episode019.rpy:1608
translate simplified_chinese ep019_paclerara_thim_7db1ffd7:

    # t "I’ve had enough of being the unwanted third wheel."
    t "我受够了当那个多余的电灯泡。"

# game/episode019.rpy:1609
translate simplified_chinese ep019_paclerara_thim_81f9c02e:

    # t "Maybe I can get a job somewhere, something low key."
    t "也许我能在某个地方找份工作，低调点的活。"

# game/episode019.rpy:1610
translate simplified_chinese ep019_paclerara_thim_d1ae3374:

    # c "If that’s what you want, I’ll have to ask the others if they’ll agree."
    c "如果这是你想要的，我得问问其他人是否同意。"

# game/episode019.rpy:1612
translate simplified_chinese ep019_paclerara_thim_98be6560:

    # t "You’ll ask them?"
    t "你会问他们？"

# game/episode019.rpy:1613
translate simplified_chinese ep019_paclerara_thim_255ecca1:

    # c "I will."
    c "我会的。"

# game/episode019.rpy:1614
translate simplified_chinese ep019_paclerara_thim_6c6cafac:

    # t "Thank you."
    t "谢谢。"

# game/episode019.rpy:1615
translate simplified_chinese ep019_paclerara_thim_0ab635df:

    # c "I’ll let you know what they decide."
    c "我会告诉你他们的决定。"

# game/episode019.rpy:1617
translate simplified_chinese ep019_paclerara_thim_6ca40639:

    # "Thim nodded in appreciation and went back inside the Residence."
    "蒂姆感激地点点头，回到了住所内。"

# game/episode019.rpy:1619
translate simplified_chinese ep019_paclerara_thim_29799655:

    # c "My answer is no."
    c "我的答案是不行。"

# game/episode019.rpy:1620
translate simplified_chinese ep019_paclerara_thim_430c07eb:

    # t "Come on, [p_name], I haven’t done anything to endanger the crew after you deserted."
    t "拜托，[p_name]，自从你们逃亡后，我从未做过任何危及船员的事。"

# game/episode019.rpy:1621
translate simplified_chinese ep019_paclerara_thim_76be9dcb:

    # c "That’s true, but you know too much about our future plans."
    c "这倒是真的，但你对我们将来的计划知道得太多了。"

# game/episode019.rpy:1622
translate simplified_chinese ep019_paclerara_thim_d8a98a5a:

    # c "I can’t let that knowledge fall into enemy hands, I hope you understand that."
    c "我不能让这些信息落入敌人手中，希望你能理解。"

# game/episode019.rpy:1624
translate simplified_chinese ep019_paclerara_thim_9ee46dae:

    # t "So you don’t trust me, is that it?"
    t "所以你就是不信任我，对吧？"

# game/episode019.rpy:1625
translate simplified_chinese ep019_paclerara_thim_116babd1:

    # t "Or aren’t you letting me go because you don’t like me?"
    t "还是说你不放我走是因为讨厌我？"

# game/episode019.rpy:1627
translate simplified_chinese ep019_paclerara_thim_9f58ceaf:

    # t "Fuck, that’s it, isn’t it?!"
    t "操，就是这样，对吧？！"

# game/episode019.rpy:1628
translate simplified_chinese ep019_paclerara_thim_3500a749:

    # c "No-"
    c "不—"

# game/episode019.rpy:1630
translate simplified_chinese ep019_paclerara_thim_87f3938b:

    # t "You’re such an immature little baby."
    t "你真是个幼稚的小屁孩。"

# game/episode019.rpy:1631
translate simplified_chinese ep019_paclerara_thim_5efbac63:

    # t "Still nursing that grudge you had about me back at the Academy."
    t "还在纠结学院时我对你做的那些事。"

# game/episode019.rpy:1632
translate simplified_chinese ep019_paclerara_thim_a486ff55:

    # t "You vindictive cunt, you don’t realize you’re destroying lives with that stupid fucking resentment of yours!"
    t "你这个睚眦必报的贱人，你根本没意识到你那该死的怨恨正在毁掉别人的生活！"

# game/episode019.rpy:1633
translate simplified_chinese ep019_paclerara_thim_d6d50c23:

    # "Thim was about to spew more invective at me, so I had to cut him off."
    "蒂姆还想继续辱骂我，我不得不打断他。"

# game/episode019.rpy:1634
translate simplified_chinese ep019_paclerara_thim_b10393fa:

    # c "Shut the fuck up, Thim."
    c "你他妈给我闭嘴，蒂姆。"

# game/episode019.rpy:1636
translate simplified_chinese ep019_paclerara_thim_fe5c76da:

    # c "It’s not about any grudge I might carry."
    c "这跟我可能怀有的任何怨恨无关。"

# game/episode019.rpy:1637
translate simplified_chinese ep019_paclerara_thim_318a492d:

    # c "What if you’re captured and they torture you?"
    c "要是你被抓了，他们拷问你怎么办？"

# game/episode019.rpy:1638
translate simplified_chinese ep019_paclerara_thim_b32b8b71:

    # c "I’m sure you’ll be able to withstand some prodding, but those Sovereignty torturers are inventive."
    c "我相信你能承受一些简单拷问，但那些\"至高权域\"的拷问官可是很有创意的。"

# game/episode019.rpy:1639
translate simplified_chinese ep019_paclerara_thim_ab989675:

    # c "It’s simply too risky to let you go."
    c "放你走实在太冒险了。"

# game/episode019.rpy:1640
translate simplified_chinese ep019_paclerara_thim_0d8f8c14:

    # c "And while it’s no secret I don’t like you, I don’t keep you confined to the ship because of that."
    c "虽然我不喜欢你这件事不是秘密，但我把你关在船上不是因为这个。"

# game/episode019.rpy:1641
translate simplified_chinese ep019_paclerara_thim_f8479fff:

    # t "But I could easily go into hiding."
    t "但我可以轻易躲藏起来啊。"

# game/episode019.rpy:1642
translate simplified_chinese ep019_paclerara_thim_38b87f6e:

    # c "And they’ll find you just as easily, especially when you’re on your own."
    c "他们同样能轻易找到你，特别是当你独自一人的时候。"

# game/episode019.rpy:1643
translate simplified_chinese ep019_paclerara_thim_7b48d6eb:

    # "Thim’s last protest already betrayed his flailing confidence."
    "蒂姆最后的抗议已经暴露了他动摇的信心。"

# game/episode019.rpy:1645
translate simplified_chinese ep019_paclerara_thim_8e5c18ec:

    # "For a second, it appeared as if he was about to launch in another angry rant, but instead he turned around and stomped back into the Residence, quivering with impotent fury."
    "有那么一瞬间，他似乎又要开始另一番愤怒的长篇大论，但他却转过身，跺着脚走回了居所，因无能为力的愤怒而颤抖着。"

# game/episode019.rpy:1647
translate simplified_chinese ep019_paclerara_thim_da953d68_1:

    # "Thim hurried towards me as I was crossing the square."
    "蒂姆在我穿过广场时匆忙向我走来。"

# game/episode019.rpy:1649
translate simplified_chinese ep019_paclerara_thim_d5993cce:

    # t "Wait up, please, [p_name]!"
    t "请等一下，[p_name]！"

# game/episode019.rpy:1650
translate simplified_chinese ep019_paclerara_thim_15cef1a8:

    # c "What do you need?"
    c "你需要什么？"

# game/episode019.rpy:1651
translate simplified_chinese ep019_paclerara_thim_8535d451:

    # t "Nothing in particular."
    t "没什么特别的事。"

# game/episode019.rpy:1653
translate simplified_chinese ep019_paclerara_thim_b22942d8:

    # t "I just wanted to know how your sister is doing."
    t "我只是想知道你妹妹怎么样了。"

# game/episode019.rpy:1655
translate simplified_chinese ep019_paclerara_thim_6bfa3cb7:

    # t "I just wanted to know how Eva is doing."
    t "我只是想知道伊娃怎么样了。"

# game/episode019.rpy:1656
translate simplified_chinese ep019_paclerara_thim_c9583bcf:

    # c "No news yet, I’m afraid."
    c "恐怕还没有消息。"

# game/episode019.rpy:1658
translate simplified_chinese ep019_paclerara_thim_ebf9066e:

    # t "Damn, I’d hoped the facilities here would be better equipped to shed some light on her situation."
    t "该死，我本希望这里的设施能更好地了解她的情况。"

# game/episode019.rpy:1659
translate simplified_chinese ep019_paclerara_thim_11bde5d7:

    # c "She’s in good hands, all we can do is hope for the best."
    c "她得到了很好的照顾，我们现在只能期望最好的结果。"

# game/episode019.rpy:1660
translate simplified_chinese ep019_paclerara_thim_d616e7af:

    # t "Yes, she is."
    t "是的，确实如此。"

# game/episode019.rpy:1662
translate simplified_chinese ep019_paclerara_thim_3abe910f:

    # t "Paclerara is a pretty great place, and the medical facilities are top notch."
    t "帕克莱拉拉是个相当不错的地方，医疗设施都是一流的。"

# game/episode019.rpy:1663
translate simplified_chinese ep019_paclerara_thim_8a59d47c:

    # c "I was sure you’d appreciate the shiny medical stuff."
    c "我就知道你会喜欢这些先进的医疗设备。"

# game/episode019.rpy:1664
translate simplified_chinese ep019_paclerara_thim_096b2cf7:

    # t "I do."
    t "确实喜欢。"

# game/episode019.rpy:1665
translate simplified_chinese ep019_paclerara_thim_e898ba8f:

    # t "They have quite some advanced treatments available here."
    t "这里提供相当多先进的治疗方案。"

# game/episode019.rpy:1666
translate simplified_chinese ep019_paclerara_thim_74f1f996:

    # t "I wish I could have gone to one of these places to train, instead of struggling through endless hours of target practice at the Academy."
    t "真希望当初能在这样的地方接受培训，而不是在学院里没完没了地苦练射击。"

# game/episode019.rpy:1667
translate simplified_chinese ep019_paclerara_thim_5fe0c30c:

    # c "I hear you."
    c "我明白你的意思。"

# game/episode019.rpy:1668
translate simplified_chinese ep019_paclerara_thim_c5bc0b5f:

    # c "But maybe you will, one day, when all this has blown over."
    c "但也许等这一切风波过去后，你还有机会。"

# game/episode019.rpy:1670
translate simplified_chinese ep019_paclerara_thim_2e0acbbe:

    # t "Will I?"
    t "我还有机会吗？"

# game/episode019.rpy:1672
translate simplified_chinese ep019_paclerara_thim_49d5dce4:

    # t "It seems we’re doomed to be on the run perpetually."
    t "看来我们注定要永远逃亡下去了。"

# game/episode019.rpy:1673
translate simplified_chinese ep019_paclerara_thim_0e306992:

    # c "It may seem that way, but I don’t plan on keeping on running away forever."
    c "表面看来是这样，但我并不打算永远逃下去。"

# game/episode019.rpy:1674
translate simplified_chinese ep019_paclerara_thim_b89a7179:

    # c "We’re going to take the fight to the Sovereignty one day, or carve out a peaceful life for us somewhere at the very least."
    c "总有一天我们要向\"至高权域\"发起反击，或者至少找个地方过上平静的生活。"

# game/episode019.rpy:1676
translate simplified_chinese ep019_paclerara_thim_0058179a:

    # t "I do like your boundless optimism."
    t "我确实喜欢你这种无穷无尽的乐观精神。"

# game/episode019.rpy:1677
translate simplified_chinese ep019_paclerara_thim_b814cd4e:

    # c "We can’t all be the Pessimistic Physician."
    c "我们不可能都成为悲观医师。"

# game/episode019.rpy:1679
translate simplified_chinese ep019_paclerara_thim_1d9ded31:

    # t "Haha, I’m not pessimistic."
    t "哈哈，我可不是悲观主义者。"

# game/episode019.rpy:1680
translate simplified_chinese ep019_paclerara_thim_5221b066:

    # t "Just a little afraid to dream."
    t "只是有点不敢做梦罢了。"

# game/episode019.rpy:1681
translate simplified_chinese ep019_paclerara_thim_64ba8aea:

    # c "Sounds like a pessimist to me."
    c "对我来说这听起来就像个悲观主义者。"

# game/episode019.rpy:1683
translate simplified_chinese ep019_paclerara_thim_b5fc7861:

    # t "You win."
    t "算你赢了。"

# game/episode019.rpy:1685
translate simplified_chinese ep019_paclerara_thim_0a5404e9:

    # t "Well, I’m going to continue my tour of the Residence."
    t "好吧，我要继续参观这栋宅邸了。"

# game/episode019.rpy:1686
translate simplified_chinese ep019_paclerara_thim_de429aa9:

    # c "Right, I won’t keep you from gawking at all those shiny defibrillators and heart monitors they have here."
    c "好的，我就不耽误你盯着那些闪亮的除颤器和心脏监护仪发呆啦。"

# game/episode019.rpy:1688
translate simplified_chinese ep019_paclerara_thim_f57c9292:

    # t "Exactly!"
    t "正是如此！"

# game/episode019.rpy:1689
translate simplified_chinese ep019_paclerara_thim_1cd07e36:

    # c "I’ll let you know if something changes with Eva."
    c "如果伊娃那边有什么变化，我会通知你的。"

# game/episode019.rpy:1690
translate simplified_chinese ep019_paclerara_thim_310f0991:

    # t "Thanks, appreciated."
    t "谢了，感激不尽。"

# game/episode019.rpy:1691
translate simplified_chinese ep019_paclerara_thim_539a802c:

    # t "See you around."
    t "回头见。"

# game/episode019.rpy:1698
translate simplified_chinese ep019_paclerara_celine_d1da1bad:

    # "Céline was messing with the entertainment module as I entered her guest quarters."
    "我走进瑟琳的客房时，她正在摆弄娱乐模块。"

# game/episode019.rpy:1699
translate simplified_chinese ep019_paclerara_celine_a0ab89b4:

    # c "Can’t find a show you like?"
    c "找不到喜欢的节目吗？"

# game/episode019.rpy:1701
translate simplified_chinese ep019_paclerara_celine_02924998:

    # ce "Something like that."
    ce "差不多吧。"

# game/episode019.rpy:1702
translate simplified_chinese ep019_paclerara_celine_2687e181:

    # ce "I’ve been trying to find a Sovereignty news channel, to catch up with any news from over there."
    ce "我一直在找\"至高权域\"那边的新闻频道，想了解些那边的消息。"

# game/episode019.rpy:1703
translate simplified_chinese ep019_paclerara_celine_8e087fed:

    # c "I don’t think Sovereignty news outlets are allowed in these parts."
    c "我觉得这片区域应该不允许接收\"至高权域\"新闻频道。"

# game/episode019.rpy:1704
translate simplified_chinese ep019_paclerara_celine_d7a02309:

    # ce "I’ve come to realize that as well."
    ce "我也慢慢意识到这一点了。"

# game/episode019.rpy:1707
translate simplified_chinese ep019_paclerara_celine_26eceaca:

    # ce "So instead I’ve been replaying the filthy things we did together with Lilly inside my head."
    ce "所以我现在只能在大脑里不断重放我们和莉莉一起做的那些下流事。"

# game/episode019.rpy:1708
translate simplified_chinese ep019_paclerara_celine_45623e87:

    # c "There should be porn channels on that module as well..."
    c "那个模块里应该也有色情频道…"

# game/episode019.rpy:1709
translate simplified_chinese ep019_paclerara_celine_a218231d:

    # ce "What we did was much better."
    ce "我们做的事可比那好多了。"

# game/episode019.rpy:1710
translate simplified_chinese ep019_paclerara_celine_d5028011:

    # c "I agree."
    c "我同意。"

# game/episode019.rpy:1713
translate simplified_chinese ep019_paclerara_celine_c7829024:

    # ce "I was wondering though, [p_name_short], about what Lilly said when you...{w} uh...{w} came inside her."
    ce "不过我在想，[p_name_short]，关于莉莉在你…{w}呃…{w}射进她里面时说的话。"

# game/episode019.rpy:1714
translate simplified_chinese ep019_paclerara_celine_c9c9586b:

    # c "What did she say, I was a little distracted at the time?"
    c "她说了什么？我当时有点分心。"

# game/episode019.rpy:1715
translate simplified_chinese ep019_paclerara_celine_e5e398ee:

    # ce "Lilly mentioned that she wanted you to put a baby inside her."
    ce "莉莉提到她想要你让她怀孕。"

# game/episode019.rpy:1716
translate simplified_chinese ep019_paclerara_celine_952761e8:

    # ce "Was that something she said in the heat of the moment?"
    ce "那是她一时冲动说的话吗？"

# game/episode019.rpy:1717
translate simplified_chinese ep019_paclerara_celine_285e6f9f:

    # c "Undoubtedly, but Lilly and I have discussed the possibility of having kids."
    c "毫无疑问，但莉莉和我讨论过要孩子的可能性。"

# game/episode019.rpy:1719
translate simplified_chinese ep019_paclerara_celine_70967e1a:

    # ce "I was wondering though, [p_name_short], about something that Lilly said to me."
    ce "不过我在想，[p_name_short]，关于莉莉对我说的一些话。"

# game/episode019.rpy:1720
translate simplified_chinese ep019_paclerara_celine_ef251b09:

    # c "What did she tell you?"
    c "她跟你说了什么？"

# game/episode019.rpy:1721
translate simplified_chinese ep019_paclerara_celine_5e561720:

    # ce "Lilly said that you discussed having kids before."
    ce "莉莉说你们之前讨论过要孩子的事。"

# game/episode019.rpy:1722
translate simplified_chinese ep019_paclerara_celine_d9cf1510:

    # ce "Was that a serious discussion?"
    ce "那是认真的讨论吗？"

# game/episode019.rpy:1723
translate simplified_chinese ep019_paclerara_celine_3d63edce:

    # c "It was, yes."
    c "是的，是认真的。"

# game/episode019.rpy:1724
translate simplified_chinese ep019_paclerara_celine_40f607f8:

    # ce "So you want to have children with Lilly?"
    ce "所以你想和莉莉生孩子？"

# game/episode019.rpy:1726
translate simplified_chinese ep019_paclerara_celine_9d9fb6df:

    # c "I do."
    c "我想。"

# game/episode019.rpy:1728
translate simplified_chinese ep019_paclerara_celine_34ec15bf:

    # ce "And what about me?"
    ce "那我呢？"

# game/episode019.rpy:1729
translate simplified_chinese ep019_paclerara_celine_ae407aea:

    # c "Do I want children with you?"
    c "你想和我生孩子吗？"

# game/episode019.rpy:1733
translate simplified_chinese ep019_paclerara_celine_f483715b:

    # c "I’d love to, if you want kids to."
    c "如果你想要孩子的话，我很乐意。"

# game/episode019.rpy:1735
translate simplified_chinese ep019_paclerara_celine_edbf84f7:

    # ce "I’ve certainly thought about it."
    ce "我当然考虑过这件事。"

# game/episode019.rpy:1736
translate simplified_chinese ep019_paclerara_celine_d5a7a655:

    # ce "Especially when we started out on Lanan and things were getting serious."
    ce "特别是当我们刚开始在拉南星上关系变得认真的时候。"

# game/episode019.rpy:1737
translate simplified_chinese ep019_paclerara_celine_11f2c44b:

    # ce "But ultimately, I didn’t discuss it with you."
    ce "但最终，我并没有和你讨论这件事。"

# game/episode019.rpy:1738
translate simplified_chinese ep019_paclerara_celine_936655e5:

    # ce "Too much danger surrounding us all of the time."
    ce "我们身边始终充斥着太多危险。"

# game/episode019.rpy:1739
translate simplified_chinese ep019_paclerara_celine_1659b3f5:

    # c "I know, I had the same reservations at first."
    c "我明白，起初我也有同样的顾虑。"

# game/episode019.rpy:1740
translate simplified_chinese ep019_paclerara_celine_3a34953f:

    # c "But if this is something we both want, we shouldn’t let fear get in the way of happy decisions like these."
    c "但如果我们都想要这个，就不该让恐惧阻挠这样幸福的决定。"

# game/episode019.rpy:1741
translate simplified_chinese ep019_paclerara_celine_f380d6c7:

    # c "So Céline, if you’re still willing, I’d love you to be the mother of my children."
    c "所以瑟琳，如果你仍然愿意，我希望你能成为我孩子的母亲。"

# game/episode019.rpy:1743
translate simplified_chinese ep019_paclerara_celine_92256d0b:

    # "Céline nodded vigorously and put her arms around me."
    "瑟琳用力点头，用双臂环抱住我。"

# game/episode019.rpy:1744
translate simplified_chinese ep019_paclerara_celine_cafea7c3:

    # "She kissed me hard, tears welling in her eyes."
    "她用力吻了我，眼中涌出泪水。"

# game/episode019.rpy:1746
translate simplified_chinese ep019_paclerara_celine_6963ae9e:

    # ce "You make me so happy, [p_name_short]!"
    ce "你让我太幸福了，[p_name_short]！"

# game/episode019.rpy:1748
translate simplified_chinese ep019_paclerara_celine_96eae791:

    # "We lay on the couch, cuddling and watching the sun go down."
    "我们躺在沙发上，相拥着看夕阳西下。"

# game/episode019.rpy:1750
translate simplified_chinese ep019_paclerara_celine_ca096f70:

    # c "I don’t want to disappoint you, Céline, but..."
    c "我不想让你失望，瑟琳，但是…"

# game/episode019.rpy:1752
translate simplified_chinese ep019_paclerara_celine_022b4718:

    # ce "I’m not disappointed!"
    ce "我一点都不失望！"

# game/episode019.rpy:1753
translate simplified_chinese ep019_paclerara_celine_0f372fb9:

    # ce "Far from it, actually."
    ce "实际上，远非如此。"

# game/episode019.rpy:1754
translate simplified_chinese ep019_paclerara_celine_a33893e0:

    # ce "I really don’t see myself as a mother."
    ce "我真的不觉得自己适合当母亲。"

# game/episode019.rpy:1755
translate simplified_chinese ep019_paclerara_celine_efae95e1:

    # ce "If Lilly wants to have a go, she can go right at it."
    ce "如果莉莉想试试的话，她完全可以去尝试。"

# game/episode019.rpy:1756
translate simplified_chinese ep019_paclerara_celine_a77b23c1:

    # c "I’m glad you feel that way."
    c "我很高兴你这么想。"

# game/episode019.rpy:1758
translate simplified_chinese ep019_paclerara_celine_77ca664f:

    # ce "You, and you alone make me so happy, [p_name_short]!"
    ce "是你，只有你让我如此快乐，[p_name_short]！"

# game/episode019.rpy:1759
translate simplified_chinese ep019_paclerara_celine_d37ca3f5:

    # ce "I don’t want anything else but you."
    ce "除了你，我别无所求。"

# game/episode019.rpy:1761
translate simplified_chinese ep019_paclerara_celine_96eae791_1:

    # "We lay on the couch, cuddling and watching the sun go down."
    "我们躺在沙发上，依偎着看夕阳西下。"

# game/episode019.rpy:1763
translate simplified_chinese ep019_paclerara_celine_045a46ef:

    # c "I don’t, no."
    c "不，我不想。"

# game/episode019.rpy:1764
translate simplified_chinese ep019_paclerara_celine_b87a6b36:

    # ce "I thought as much."
    ce "我也这么觉得。"

# game/episode019.rpy:1766
translate simplified_chinese ep019_paclerara_celine_4f73ec0c:

    # ce "Is it a categoric no for you?"
    ce "这对你来说是绝对不行吗？"

# game/episode019.rpy:1768
translate simplified_chinese ep019_paclerara_celine_1714e9ed:

    # ce "Or just because it’s your sister?"
    ce "还是仅仅因为是你妹妹？"

# game/episode019.rpy:1770
translate simplified_chinese ep019_paclerara_celine_a06f3c1e:

    # ce "Or just not with Lilly?"
    ce "或者只是不想和莉莉生？"

# game/episode019.rpy:1774
translate simplified_chinese ep019_paclerara_celine_2da5fc8b:

    # c "Yes, we both decided it wasn’t a good idea."
    c "是的，我们俩都认为这不是个好主意。"

# game/episode019.rpy:1775
translate simplified_chinese ep019_paclerara_celine_26f5229e:

    # c "But with you it might be another matter."
    c "但和你可能就是另一回事了。"

# game/episode019.rpy:1776
translate simplified_chinese ep019_paclerara_celine_3bdd7b97:

    # ce "Oh?"
    ce "哦？"

# game/episode019.rpy:1778
translate simplified_chinese ep019_paclerara_celine_680ca956:

    # ce "Well, I can’t say that I haven’t thought about it."
    ce "嗯，我不能说我没想过这件事。"

# game/episode019.rpy:1779
translate simplified_chinese ep019_paclerara_celine_d5a7a655_1:

    # ce "Especially when we started out on Lanan and things were getting serious."
    ce "特别是当我们在拉南星开始交往，关系变得认真的时候。"

# game/episode019.rpy:1780
translate simplified_chinese ep019_paclerara_celine_11f2c44b_1:

    # ce "But ultimately, I didn’t discuss it with you."
    ce "但最终，我没有和你讨论过这件事。"

# game/episode019.rpy:1781
translate simplified_chinese ep019_paclerara_celine_936655e5_1:

    # ce "Too much danger surrounding us all of the time."
    ce "我们周围总是有太多危险。"

# game/episode019.rpy:1782
translate simplified_chinese ep019_paclerara_celine_1659b3f5_1:

    # c "I know, I had the same reservations at first."
    c "我知道，我一开始也有同样的顾虑。"

# game/episode019.rpy:1783
translate simplified_chinese ep019_paclerara_celine_3a34953f_1:

    # c "But if this is something we both want, we shouldn’t let fear get in the way of happy decisions like these."
    c "但如果我们都想要孩子，就不该让恐惧阻碍这样幸福的决定。"

# game/episode019.rpy:1784
translate simplified_chinese ep019_paclerara_celine_f380d6c7_1:

    # c "So Céline, if you’re still willing, I’d love you to be the mother of my children."
    c "所以瑟琳，如果你仍然愿意，我希望你能成为我孩子的母亲。"

# game/episode019.rpy:1786
translate simplified_chinese ep019_paclerara_celine_92256d0b_1:

    # "Céline nodded vigorously and put her arms around me."
    "瑟琳用力点头，伸手环抱住我。"

# game/episode019.rpy:1787
translate simplified_chinese ep019_paclerara_celine_cafea7c3_1:

    # "She kissed me hard, tears welling in her eyes."
    "她用力吻着我，眼中涌出泪水。"

# game/episode019.rpy:1789
translate simplified_chinese ep019_paclerara_celine_6963ae9e_1:

    # ce "You make me so happy, [p_name_short]!"
    ce "你让我太幸福了，[p_name_short]！"

# game/episode019.rpy:1791
translate simplified_chinese ep019_paclerara_celine_96eae791_2:

    # "We lay on the couch, cuddling and watching the sun go down."
    "我们躺在沙发上，相拥着看夕阳西下。"

# game/episode019.rpy:1793
translate simplified_chinese ep019_paclerara_celine_ca096f70_1:

    # c "I don’t want to disappoint you, Céline, but..."
    c "我不想让你失望，瑟琳，但是…"

# game/episode019.rpy:1795
translate simplified_chinese ep019_paclerara_celine_022b4718_1:

    # ce "I’m not disappointed!"
    ce "我没有失望！"

# game/episode019.rpy:1796
translate simplified_chinese ep019_paclerara_celine_0f372fb9_1:

    # ce "Far from it, actually."
    ce "实际上，恰恰相反。"

# game/episode019.rpy:1798
translate simplified_chinese ep019_paclerara_celine_a33893e0_1:

    # ce "I really don’t see myself as a mother."
    ce "我真的不觉得自己能当个好母亲。"

# game/episode019.rpy:1799
translate simplified_chinese ep019_paclerara_celine_b9b45337:

    # c "I think you’d make a great mother, but it’s not for me."
    c "我觉得你会是个很棒的妈妈，但这不适合我。"

# game/episode019.rpy:1800
translate simplified_chinese ep019_paclerara_celine_b5cb7a75:

    # ce "Not for me either."
    ce "我也不适合。"

# game/episode019.rpy:1801
translate simplified_chinese ep019_paclerara_celine_9e50f6d4:

    # ce "I’m glad we’ve cleared this up."
    ce "很高兴我们把这件事说清楚了。"

# game/episode019.rpy:1803
translate simplified_chinese ep019_paclerara_celine_b1f27814:

    # ce "I only want you, and you alone, [p_name_short]."
    ce "我只要你，只要你一个人，[p_name_short]。"

# game/episode019.rpy:1804
translate simplified_chinese ep019_paclerara_celine_292a9e6a:

    # ce "You make me so happy!"
    ce "你让我如此幸福！"

# game/episode019.rpy:1805
translate simplified_chinese ep019_paclerara_celine_e0661c03:

    # c "You do too!"
    c "你也是！"

# game/episode019.rpy:1807
translate simplified_chinese ep019_paclerara_celine_96eae791_3:

    # "We lay on the couch, cuddling and watching the sun go down."
    "我们躺在沙发上，相拥着看日落。"

# game/episode019.rpy:1809
translate simplified_chinese ep019_paclerara_celine_1a5171dc:

    # ce "So instead, I’ve been watching some sappy drama."
    ce "所以我改看了一些煽情的电视剧。"

# game/episode019.rpy:1811
translate simplified_chinese ep019_paclerara_celine_db0d245a:

    # ce "Had to turn it off though."
    ce "不过后来还是关掉了。"

# game/episode019.rpy:1812
translate simplified_chinese ep019_paclerara_celine_b3921824:

    # c "Why did you?"
    c "为什么关掉？"

# game/episode019.rpy:1814
translate simplified_chinese ep019_paclerara_celine_1e52e411:

    # ce "It was about a mother who had to abandon her two children."
    ce "那部剧讲的是一个不得不抛弃两个孩子的母亲。"

# game/episode019.rpy:1815
translate simplified_chinese ep019_paclerara_celine_5c98f2b8:

    # c "Ah, that hit a little too close to home, I presume?"
    c "啊，我猜这剧情有点戳到痛处了？"

# game/episode019.rpy:1817
translate simplified_chinese ep019_paclerara_celine_fd361499:

    # ce "Yeah..."
    ce "嗯…"

# game/episode019.rpy:1819
translate simplified_chinese ep019_paclerara_celine_455ec5b5:

    # ce "I wonder where mom is now."
    ce "不知道妈妈现在在哪里。"

# game/episode019.rpy:1820
translate simplified_chinese ep019_paclerara_celine_a32740d7:

    # ce "Is she still a Commander, does she ever think about us?"
    ce "她还在当指挥官吗，她有没有想过我们？"

# game/episode019.rpy:1821
translate simplified_chinese ep019_paclerara_celine_dc72b582:

    # c "Your mother and I had our differences, or rather we only had differences..."
    c "你母亲和我有过分歧，或者说我们之间只有分歧…"

# game/episode019.rpy:1822
translate simplified_chinese ep019_paclerara_celine_68ece3d7:

    # c "And she was a hard-nosed officer and all that."
    c "而且她是个顽固的军官之类的。"

# game/episode019.rpy:1823
translate simplified_chinese ep019_paclerara_celine_603cbb02:

    # c "But I can’t believe her to be so cold-hearted as to never think about those terrible moments before we escaped the Ypotryll, or what might have happened after."
    c "但我不相信她会如此冷酷无情，从不回想我们逃出\"异龙\"号前的那些可怕时刻，或者之后可能发生的事。"

# game/episode019.rpy:1825
translate simplified_chinese ep019_paclerara_celine_6011b119:

    # ce "Me neither."
    ce "我也不信。"

# game/episode019.rpy:1826
translate simplified_chinese ep019_paclerara_celine_b8d76cdc:

    # ce "She was quite protective of us when we were little."
    ce "我们小时候她可是相当护着我们的。"

# game/episode019.rpy:1827
translate simplified_chinese ep019_paclerara_celine_30849063:

    # ce "And part of the reason mom was so hard on you was because she knew I was smitten with you."
    ce "而且妈妈对你那么严厉的部分原因，是她知道我对你着了迷。"

# game/episode019.rpy:1828
translate simplified_chinese ep019_paclerara_celine_bdad8d16:

    # c "Totally unfair of course."
    c "当然这完全不公平。"

# game/episode019.rpy:1830
translate simplified_chinese ep019_paclerara_celine_45b973dd:

    # ce "Of course!"
    ce "当然啦！"

# game/episode019.rpy:1831
translate simplified_chinese ep019_paclerara_celine_cd4fb6f4:

    # ce "I think she might even be a little proud of what you’ve accomplished."
    ce "我觉得她甚至可能对你取得的成就感到些许骄傲。"

# game/episode019.rpy:1832
translate simplified_chinese ep019_paclerara_celine_46625d4f:

    # c "That would be stretching things a little too far..."
    c "这么说就有点夸大其词了…"

# game/episode019.rpy:1833
translate simplified_chinese ep019_paclerara_celine_1744696e:

    # c "Unless deserting and being on the run for so long count as achievements."
    c "除非逃兵和长期逃亡也算成就的话。"

# game/episode019.rpy:1835
translate simplified_chinese ep019_paclerara_celine_db6049ec:

    # ce "Not that, but you’re a captain now, in every sense of the word."
    ce "不是指那个，而是你现在无论从哪方面说都是个舰长了。"

# game/episode019.rpy:1836
translate simplified_chinese ep019_paclerara_celine_246177f2:

    # ce "You might not think it, but you’re the one we’re all looking up to when an important decision needs to be made."
    ce "你可能不这么觉得，但每当需要做重要决定时，你都是我们仰仗的对象。"

# game/episode019.rpy:1837
translate simplified_chinese ep019_paclerara_celine_7997f01f:

    # c "Well, if you put it that way..."
    c "好吧，既然你这么说…"

# game/episode019.rpy:1838
translate simplified_chinese ep019_paclerara_celine_7ea777bb:

    # c "I still find it hard to believe your mother would have anything positive to say about me."
    c "我还是很难相信你母亲会对我有什么正面评价。"

# game/episode019.rpy:1840
translate simplified_chinese ep019_paclerara_celine_6eb0dae1:

    # ce "Yes, it may be a stretch."
    ce "是的，可能确实有点牵强。"

# game/episode019.rpy:1842
translate simplified_chinese ep019_paclerara_celine_5abdd53c:

    # ce "But having experienced hardship myself, I think I know how all the responsibility weighed on her."
    ce "但亲身经历过艰难困苦后，我想我能理解所有责任压在她身上的感受。"

# game/episode019.rpy:1843
translate simplified_chinese ep019_paclerara_celine_a2ae8437:

    # ce "Raising two kids on her own while being an officer in the Navy."
    ce "独自抚养两个孩子，同时还要在舰队担任军官。"

# game/episode019.rpy:1844
translate simplified_chinese ep019_paclerara_celine_221e6ee0:

    # c "Yeah, that must have been tough."
    c "是啊，那一定很艰难。"

# game/episode019.rpy:1846
translate simplified_chinese ep019_paclerara_celine_90a525ee:

    # ce "I sometimes wonder how I would manage myself."
    ce "我有时会想自己会怎么应对。"

# game/episode019.rpy:1847
translate simplified_chinese ep019_paclerara_celine_833fda5d:

    # c "Raising children?"
    c "抚养孩子吗？"

# game/episode019.rpy:1849
translate simplified_chinese ep019_paclerara_celine_7f8a0972:

    # ce "Yeah."
    ce "嗯。"

# game/episode019.rpy:1850
translate simplified_chinese ep019_paclerara_celine_40ae4c08:

    # c "Would you like to be a mother?"
    c "你想成为母亲吗？"

# game/episode019.rpy:1852
translate simplified_chinese ep019_paclerara_celine_36ed2180:

    # ce "I’m not sure."
    ce "我不确定。"

# game/episode019.rpy:1856
translate simplified_chinese ep019_paclerara_celine_42694bca:

    # c "I’ve always wanted a gaggle of kids."
    c "我一直想要一大群孩子。"

# game/episode019.rpy:1857
translate simplified_chinese ep019_paclerara_celine_c23ffb76:

    # ce "Really?"
    ce "真的吗？"

# game/episode019.rpy:1858
translate simplified_chinese ep019_paclerara_celine_79ea6e92:

    # c "Yes, preferably with you."
    c "是的，最好能和你一起。"

# game/episode019.rpy:1860
translate simplified_chinese ep019_paclerara_celine_4c28d7c8:

    # "Céline’s face lit up, as I clearly broke through the hesitation that held her back previously."
    "瑟琳的脸庞顿时容光焕发，显然我打破了她先前的犹豫不决。"

# game/episode019.rpy:1861
translate simplified_chinese ep019_paclerara_celine_4d2e5bd9:

    # ce "I didn’t want to presume you wanted to start a family."
    ce "我本不想贸然认定你想要组建家庭。"

# game/episode019.rpy:1862
translate simplified_chinese ep019_paclerara_celine_7dc1aa46:

    # ce "With us on the run and everything."
    ce "毕竟我们还在逃亡，诸事未定。"

# game/episode019.rpy:1863
translate simplified_chinese ep019_paclerara_celine_f47b3347:

    # c "I’ve had the same doubts, but risk aversion shouldn’t get in the way of making life-changing decisions."
    c "我也有过同样的疑虑，但规避风险不该成为做出人生重大决定的阻碍。"

# game/episode019.rpy:1864
translate simplified_chinese ep019_paclerara_celine_94ae8563:

    # c "So, Céline, will you be the mother of my children?"
    c "那么，瑟琳，你愿意成为我孩子的母亲吗？"

# game/episode019.rpy:1865
translate simplified_chinese ep019_paclerara_celine_f41d487e:

    # ce "So formal, but yes of course, I want nothing more!"
    ce "这么正式，不过当然愿意，这是我梦寐以求的！"

# game/episode019.rpy:1867
translate simplified_chinese ep019_paclerara_celine_cafea7c3_2:

    # "She kissed me hard, tears welling in her eyes."
    "她用力吻住我，眼中涌出泪水。"

# game/episode019.rpy:1869
translate simplified_chinese ep019_paclerara_celine_6963ae9e_2:

    # ce "You make me so happy, [p_name_short]!"
    ce "你让我太开心了，[p_name_short]！"

# game/episode019.rpy:1871
translate simplified_chinese ep019_paclerara_celine_96eae791_4:

    # "We lay on the couch, cuddling and watching the sun go down."
    "我们躺在沙发上，依偎着看日落。"

# game/episode019.rpy:1873
translate simplified_chinese ep019_paclerara_celine_ca096f70_2:

    # c "I don’t want to disappoint you, Céline, but..."
    c "我不想让你失望，瑟琳，但是…"

# game/episode019.rpy:1875
translate simplified_chinese ep019_paclerara_celine_022b4718_2:

    # ce "I’m not disappointed!"
    ce "我没有失望！"

# game/episode019.rpy:1876
translate simplified_chinese ep019_paclerara_celine_0f372fb9_2:

    # ce "Far from it, actually."
    ce "事实上，恰恰相反。"

# game/episode019.rpy:1878
translate simplified_chinese ep019_paclerara_celine_c75d519e:

    # ce "I thought for a split second that I would be disappointing you, because I really don’t see myself as a mother."
    ce "我刚才一瞬间以为会让你失望，因为我真的不觉得自己适合当母亲。"

# game/episode019.rpy:1879
translate simplified_chinese ep019_paclerara_celine_b9b45337_1:

    # c "I think you’d make a great mother, but it’s not for me."
    c "我觉得你会是个好母亲，但这不适合我。"

# game/episode019.rpy:1880
translate simplified_chinese ep019_paclerara_celine_b5cb7a75_1:

    # ce "Not for me either."
    ce "我也不适合。"

# game/episode019.rpy:1881
translate simplified_chinese ep019_paclerara_celine_9e50f6d4_1:

    # ce "I’m glad we’ve cleared this up."
    ce "很高兴我们把这件事说清楚了。"

# game/episode019.rpy:1883
translate simplified_chinese ep019_paclerara_celine_b1f27814_1:

    # ce "I only want you, and you alone, [p_name_short]."
    ce "我只要你，只要你一个，[p_name_short]。"

# game/episode019.rpy:1884
translate simplified_chinese ep019_paclerara_celine_292a9e6a_1:

    # ce "You make me so happy!"
    ce "你让我好开心！"

# game/episode019.rpy:1885
translate simplified_chinese ep019_paclerara_celine_e0661c03_1:

    # c "You do too!"
    c "你也是！"

# game/episode019.rpy:1887
translate simplified_chinese ep019_paclerara_celine_96eae791_5:

    # "We lay on the couch, cuddling and watching the sun go down."
    "我们躺在沙发上，依偎着看夕阳西下。"

# game/episode019.rpy:1894
translate simplified_chinese ep019_paclerara_jade_f6dd393b:

    # "I caught up with Jade just as she was about to head out of the residential complex."
    "就在杰德正要离开住宅区时，我追上了她。"

# game/episode019.rpy:1896
translate simplified_chinese ep019_paclerara_jade_1410883a:

    # j "Oh [p_name_short], I was just about to go for a walk."
    j "哦[p_name_short]，我正要去散步呢。"

# game/episode019.rpy:1897
translate simplified_chinese ep019_paclerara_jade_2c992148:

    # c "Mind if I join you?"
    c "介意我一起吗？"

# game/episode019.rpy:1898
translate simplified_chinese ep019_paclerara_jade_96c50de9:

    # j "Not at all."
    j "完全不介意。"

# game/episode019.rpy:1900
translate simplified_chinese ep019_paclerara_jade_bd47186c:

    # "We both headed for the outskirts of the forest."
    "我们俩都朝着森林边缘走去。"

# game/episode019.rpy:1901
translate simplified_chinese ep019_paclerara_jade_1060aa7e:

    # c "Do you have a particular destination?"
    c "你有特定的目的地吗？"

# game/episode019.rpy:1903
translate simplified_chinese ep019_paclerara_jade_9f3c64c0:

    # j "Yes actually, I've asked around for the location of my mother's burial place."
    j "是的，其实我四处打听了我母亲墓地的位置。"

# game/episode019.rpy:1904
translate simplified_chinese ep019_paclerara_jade_977e979c:

    # j "I was hoping to visit it."
    j "我希望能去那里看看。"

# game/episode019.rpy:1905
translate simplified_chinese ep019_paclerara_jade_a6e1d7be:

    # c "Oh, I didn't realize you wanted to visit her."
    c "哦，我不知道你想去看望她。"

# game/episode019.rpy:1906
translate simplified_chinese ep019_paclerara_jade_bca05ab1:

    # c "If you'd like to have moment of peace and quiet of your own?"
    c "如果你想一个人静静？"

# game/episode019.rpy:1908
translate simplified_chinese ep019_paclerara_jade_c632e22d:

    # j "No, I'd be happy for your company."
    j "不，有你的陪伴我很高兴。"

# game/episode019.rpy:1909
translate simplified_chinese ep019_paclerara_jade_11adf254:

    # c "Happy to hear that."
    c "很高兴听你这么说。"

# game/episode019.rpy:1911
translate simplified_chinese ep019_paclerara_jade_7e4201c2:

    # "We entered the forest, Jade leading the way."
    "我们进入森林，杰德在前面带路。"

# game/episode019.rpy:1912
translate simplified_chinese ep019_paclerara_jade_986ec06e:

    # c "I didn't think Paclerara would be this much of a paradise."
    c "没想到帕克莱拉拉会是这样的天堂。"

# game/episode019.rpy:1914
translate simplified_chinese ep019_paclerara_jade_3fa16d45:

    # j "Yes, it's beautiful, pristine even."
    j "是的，这里很美，甚至可以说是原始纯净。"

# game/episode019.rpy:1915
translate simplified_chinese ep019_paclerara_jade_d83e8990:

    # j "I'm glad my mother lived the last years of her life in a place like this."
    j "我很高兴我母亲生命的最后几年是在这样的地方度过的。"

# game/episode019.rpy:1917
translate simplified_chinese ep019_paclerara_jade_c899f90c:

    # j "Luclite was a smoking ruin once the Sovereignty was done with it."
    j "\"至高权域\"离开后，卢克莱特就成了一片冒烟的废墟。"

# game/episode019.rpy:1918
translate simplified_chinese ep019_paclerara_jade_f7d1b750:

    # c "Utterly destroying something is something the Sovereignty is very good at."
    c "彻底摧毁某样东西是\"至高权域\"非常擅长的事情。"

# game/episode019.rpy:1919
translate simplified_chinese ep019_paclerara_jade_027414eb:

    # c "I think it's even one of their tenets of war, to completely obliterate a civilization, in order to destroy the sense of identity of its subjugated civilians."
    c "我认为这甚至是他们的战争信条之一，完全抹除一个文明，以摧毁被征服平民的认同感。"

# game/episode019.rpy:1921
translate simplified_chinese ep019_paclerara_jade_70ff1f30:

    # j "That sounds very plausible."
    j "这听起来很有道理。"

# game/episode019.rpy:1922
translate simplified_chinese ep019_paclerara_jade_2039dabe:

    # c "Leave it to the Sovereignty to codify their acts of atrocity in an official rulebook."
    c "也只有\"至高权域\"会把他们的暴行编入官方规则手册。"

# game/episode019.rpy:1924
translate simplified_chinese ep019_paclerara_jade_55fb3a8a:

    # "Jade snickered as we headed deeper into the forest."
    "当我们深入森林时，杰德窃笑起来。"

# game/episode019.rpy:1926
translate simplified_chinese ep019_paclerara_jade_00901cf3:

    # j "I'd thought the gravesite would be nearer to the residential building."
    j "我以为墓地会更靠近住宅楼。"

# game/episode019.rpy:1927
translate simplified_chinese ep019_paclerara_jade_e6abf1e0:

    # c "It seems quite far away."
    c "看起来相当远。"

# game/episode019.rpy:1928
translate simplified_chinese ep019_paclerara_jade_aa14f918:

    # c "It's a place of pilgrimage too, right?"
    c "这也是个朝圣地，对吧？"

# game/episode019.rpy:1929
translate simplified_chinese ep019_paclerara_jade_4c0bf4e7:

    # j "Apparently, though it's only busy at certain times of the year."
    j "显然如此，不过只在一年中的特定时间才会热闹。"

# game/episode019.rpy:1930
translate simplified_chinese ep019_paclerara_jade_1f222c9e:

    # j "Mostly around the date she passed away."
    j "主要是在她去世的日子前后。"

# game/episode019.rpy:1931
translate simplified_chinese ep019_paclerara_jade_d5b74c43:

    # c "Yes, that makes sense."
    c "是的，这说得通。"

# game/episode019.rpy:1932
translate simplified_chinese ep019_paclerara_jade_684a47f8:

    # c "So there's likely nobody around at the moment?"
    c "所以现在应该没人在附近？"

# game/episode019.rpy:1933
translate simplified_chinese ep019_paclerara_jade_14317f00:

    # j "I don't think so, or we would have met others along the way I guess."
    j "我觉得没有，不然我们路上应该会遇到其他人。"

# game/episode019.rpy:1934
translate simplified_chinese ep019_paclerara_jade_d1b2071d:

    # j "We're nearly there, I think."
    j "我们快到了。"

# game/episode019.rpy:1936
translate simplified_chinese ep019_paclerara_jade_f02189b1:

    # "Jade's mood turned pensive and we didn't talk much as we approached the burial site."
    "随着我们接近墓地，杰德的情绪变得沉思起来，我们没怎么说话。"

# game/episode019.rpy:1938
translate simplified_chinese ep019_paclerara_jade_70f37bfc:

    # "After a while, a stone path leading to a small monument could be seen through the trees."
    "过了一会儿，透过树林可以看到一条石径通向一座小型纪念碑。"

# game/episode019.rpy:1939
translate simplified_chinese ep019_paclerara_jade_8b1e8294:

    # "The forest was very quiet, as if the local wildlife kept silent out of respect for the dead that were buried here."
    "森林非常安静，仿佛当地的野生动物出于对埋葬在此的逝者的尊重而保持缄默。"

# game/episode019.rpy:1940
translate simplified_chinese ep019_paclerara_jade_63678217:

    # j "This must be the place."
    j "就是这里了。"

# game/episode019.rpy:1942
translate simplified_chinese ep019_paclerara_jade_44c0de69:

    # "Jade and I approached the monument."
    "我和杰德走近纪念碑。"

# game/episode019.rpy:1943
translate simplified_chinese ep019_paclerara_jade_7c5bdb5b:

    # "The stones pulsed with a softly glowing light, almost like a heartbeat."
    "石块脉动着柔和的光芒，几乎如同心跳一般。"

# game/episode019.rpy:1945
translate simplified_chinese ep019_paclerara_jade_19d14dd6:

    # "We stood in silence in front of the shrine."
    "我们静静地站在神龛前。"

# game/episode019.rpy:1947
translate simplified_chinese ep019_paclerara_jade_8fa2eff5:

    # "I saw tears in Jade’s eyes and took her hand, giving it a tentative squeeze."
    "我看见杰德眼中含泪，便握住她的手，试探性地轻轻捏了一下。"

# game/episode019.rpy:1949
translate simplified_chinese ep019_paclerara_jade_8e6676b2:

    # "Jade leaned against me in response, her head resting against my chest."
    "杰德顺势靠在我身上，头枕着我的胸膛。"

# game/episode019.rpy:1950
translate simplified_chinese ep019_paclerara_jade_d353077b:

    # "It took her a good while before she was able to speak."
    "过了好一会儿，她才终于能开口说话。"

# game/episode019.rpy:1952
translate simplified_chinese ep019_paclerara_jade_bc9bfbd6:

    # j "It’s still a little surreal, being here."
    j "来到这里还是感觉有点不真实。"

# game/episode019.rpy:1953
translate simplified_chinese ep019_paclerara_jade_4b11ee82:

    # j "After we were taken away from Luclite, I never saw my parents again."
    j "自从我们从卢克莱特被带走后，我就再也没见过父母了。"

# game/episode019.rpy:1954
translate simplified_chinese ep019_paclerara_jade_99ed8f84:

    # j "To think she spent her last years here on Paclerara..."
    j "想到她最后几年是在帕克莱拉拉度过的…"

# game/episode019.rpy:1955
translate simplified_chinese ep019_paclerara_jade_e04323a9:

    # c "It must have been lonely for her."
    c "对她来说一定很孤独吧。"

# game/episode019.rpy:1957
translate simplified_chinese ep019_paclerara_jade_c9aecbac:

    # j "Yes, I reckon it must have been."
    j "是啊，想必确实如此。"

# game/episode019.rpy:1958
translate simplified_chinese ep019_paclerara_jade_cfa737ca:

    # j "Even being surrounded by other Twi’ll."
    j "即使周围有其他特维尔人相伴。"

# game/episode019.rpy:1959
translate simplified_chinese ep019_paclerara_jade_24dc6a4e:

    # c "Have you ever wondered if your parents ever tried to find you?"
    c "你有没有想过，你的父母是否曾试图寻找过你？"

# game/episode019.rpy:1961
translate simplified_chinese ep019_paclerara_jade_bc608158:

    # j "When I was younger, I always imagined that my family would come to rescue me."
    j "小时候，我总是幻想着我的家人会来救我。"

# game/episode019.rpy:1962
translate simplified_chinese ep019_paclerara_jade_3e8ab29f:

    # j "You know, Twi’ll troopers crashing dramatically through the skylights, eventually carried away while dangling from a rope attached to a fast-moving ship."
    j "你知道的，特维尔人战士戏剧性地冲破天窗，最终被挂在快速移动飞船的绳子上带走。"

# game/episode019.rpy:1964
translate simplified_chinese ep019_paclerara_jade_007b8fa6:

    # j "But that never happened, of course."
    j "当然，那从未发生过。"

# game/episode019.rpy:1965
translate simplified_chinese ep019_paclerara_jade_134739e6:

    # c "Still, I get why the action heroics are better than the reality."
    c "尽管如此，我理解为什么动作英雄的情节比现实更好。"

# game/episode019.rpy:1967
translate simplified_chinese ep019_paclerara_jade_a1221ee5:

    # j "Certainly."
    j "确实如此。"

# game/episode019.rpy:1968
translate simplified_chinese ep019_paclerara_jade_27525d3a:

    # j "When I got older, I realized just how efficient the Sovereignty is when it comes to processing and obscuring the origin of Twi’ll and other conquered species."
    j "长大后，我才意识到\"至高权域\"在处理和掩盖特维尔人及其他被征服物种来源方面有多高效。"

# game/episode019.rpy:1970
translate simplified_chinese ep019_paclerara_jade_f7d38cbd:

    # j "It’s virtually impossible for an outsider to get any information."
    j "外人几乎不可能获取任何信息。"

# game/episode019.rpy:1971
translate simplified_chinese ep019_paclerara_jade_c656ab39:

    # c "It’s almost impossible for regular citizens, let alone prisoners."
    c "普通公民都几乎不可能，更不用说囚犯了。"

# game/episode019.rpy:1972
translate simplified_chinese ep019_paclerara_jade_39db82b3:

    # j "Exactly."
    j "正是如此。"

# game/episode019.rpy:1973
translate simplified_chinese ep019_paclerara_jade_ba13c88d:

    # j "One of the reasons I became so good at messing with computers is because it allowed me to get into records that were otherwise sealed."
    j "我之所以如此擅长摆弄计算机，其中一个原因就是它能让我获取到那些本应被封存的记录。"

# game/episode019.rpy:1974
translate simplified_chinese ep019_paclerara_jade_451984e2:

    # c "I knew your interest in hacking went way beyond humoring my juvenile requests."
    c "我知道你对黑客技术的兴趣远不止是为了满足我那些幼稚的请求。"

# game/episode019.rpy:1976
translate simplified_chinese ep019_paclerara_jade_5ff6bd25:

    # j "Don’t get me wrong, hacking that school sign to tell everyone about the principal’s infidelities was a lot of fun, but not the main purpose in my life."
    j "别误会，黑进学校告示板把校长的风流韵事公之于众确实很有趣，但这不是我的人生目标。"

# game/episode019.rpy:1977
translate simplified_chinese ep019_paclerara_jade_98d50c59:

    # c "Damn, I’d already forgotten about Principal Bradley O’Zinger’s many dalliances..."
    c "该死，我早就忘了布拉德利·奥辛格校长的那些风流事了…"

# game/episode019.rpy:1979
translate simplified_chinese ep019_paclerara_jade_2dc36081:

    # j "He was an incorrigible lech and a veritable creep towards your sisters."
    j "他是个无可救药的老色鬼，对你妹妹们来说简直就是个不折不扣的变态。"

# game/episode019.rpy:1981
translate simplified_chinese ep019_paclerara_jade_3d90d833:

    # j "He was an incorrigible lech and a veritable creep towards Eva and Lilly."
    j "他是个无可救药的老色鬼，对伊娃和莉莉来说简直就是个不折不扣的变态。"

# game/episode019.rpy:1983
translate simplified_chinese ep019_paclerara_jade_e111d109:

    # "Jade smiled a little tensely and stared out into the forest."
    "杰德略显紧张地笑了笑，目光望向远处的森林。"

# game/episode019.rpy:1984
translate simplified_chinese ep019_paclerara_jade_68754dec:

    # j "I’m happy we could visit this place, [p_name_short], albeit under such unfortunate circumstances."
    j "我很高兴我们能来这个地方，[p_name_short]，尽管是在如此不幸的情况下。"

# game/episode019.rpy:1985
translate simplified_chinese ep019_paclerara_jade_9e8032df:

    # c "The circumstances are less than ideal, but I know Eva is going to pull through."
    c "情况虽然不太理想，但我知道伊娃一定能挺过去的。"

# game/episode019.rpy:1986
translate simplified_chinese ep019_paclerara_jade_434bfde7:

    # c "I’m glad we were able to visit too, because it’s so important to you."
    c "我也很高兴我们能来，因为这里对你来说太重要了。"

# game/episode019.rpy:1987
translate simplified_chinese ep019_paclerara_jade_a0a315d6:

    # j "I didn’t realize it was at first."
    j "我一开始并没有意识到这一点。"

# game/episode019.rpy:1989
translate simplified_chinese ep019_paclerara_jade_bcdb6882:

    # j "But it seems such a hopeful place, you know?"
    j "但这里看起来是个充满希望的地方，你知道吗？"

# game/episode019.rpy:1990
translate simplified_chinese ep019_paclerara_jade_d3155be8:

    # c "Because of all the Twi’ll living here together?"
    c "是因为所有特维尔人都住在这里吗？"

# game/episode019.rpy:1991
translate simplified_chinese ep019_paclerara_jade_1b44a408:

    # j "Yes, but also the school and the archives."
    j "是的，但还有学校和档案馆。"

# game/episode019.rpy:1992
translate simplified_chinese ep019_paclerara_jade_53377a81:

    # j "The researchers there are trying to recreate a history of our people, so that we will never forget who we were."
    j "那里的研究人员正试图重建我们民族的历史，这样我们就永远不会忘记自己是谁。"

# game/episode019.rpy:1993
translate simplified_chinese ep019_paclerara_jade_8099cf56:

    # c "True, Paclerara feels like an effort to rebuild Twi’ll civilization."
    c "确实，帕克莱拉拉感觉像在努力重建特维尔文明。"

# game/episode019.rpy:1994
translate simplified_chinese ep019_paclerara_jade_d66e70ca:

    # j "It truly does, in more ways than one."
    j "确实如此，在很多方面都是这样。"

# game/episode019.rpy:1995
translate simplified_chinese ep019_paclerara_jade_d04526ee:

    # j "Us Twi’ll have been scattered all across the universe, or confined to slavery inside the borders of the Sovereignty."
    j "我们特维尔人散落在宇宙各处，或被囚禁在\"至高权域\"边界内成为奴隶。"

# game/episode019.rpy:1996
translate simplified_chinese ep019_paclerara_jade_c965dd7f:

    # j "According to the doctors I spoke with at the clinic, the Twi’ll birth-rate has been dangerously low for years now."
    j "根据我在诊所交谈过的医生所说，特维尔人的出生率多年来一直处于危险的低水平。"

# game/episode019.rpy:1997
translate simplified_chinese ep019_paclerara_jade_64b54bc0:

    # c "Are you saying your species is dying out?"
    c "你是说你们的种族正在消亡吗？"

# game/episode019.rpy:1999
translate simplified_chinese ep019_paclerara_jade_a1d4ae8e:

    # j "Not exactly, apparently we’re not at the point of no return yet."
    j "不完全是，显然我们还没到无法挽回的地步。"

# game/episode019.rpy:2000
translate simplified_chinese ep019_paclerara_jade_3a113c92:

    # j "But there’s reason to worry."
    j "但确实有理由担忧。"

# game/episode019.rpy:2001
translate simplified_chinese ep019_paclerara_jade_b382bbc2:

    # j "Too many Twi’ll are sexually tangled up with other species..."
    j "太多特维尔人和其他物种发生了性关系……"

# game/episode019.rpy:2002
translate simplified_chinese ep019_paclerara_jade_17791864:

    # c "Guilty as charged."
    c "我有罪。"

# game/episode019.rpy:2004
translate simplified_chinese ep019_paclerara_jade_cddeccb0:

    # j "Yes, we are..."
    j "是啊，我们确实……"

# game/episode019.rpy:2008
translate simplified_chinese ep019_paclerara_jade_90c80113:

    # c "Say Jade, we’ve never spoken of it before."
    c "对了杰德，我们之前从没谈过这个。"

# game/episode019.rpy:2009
translate simplified_chinese ep019_paclerara_jade_fe3c06ec:

    # c "But do you want children?"
    c "但你想要孩子吗？"

# game/episode019.rpy:2011
translate simplified_chinese ep019_paclerara_jade_6799b041:

    # j "For a long time, it never seemed like an option."
    j "很长一段时间里，这似乎根本不可能。"

# game/episode019.rpy:2012
translate simplified_chinese ep019_paclerara_jade_7c78bfbd:

    # j "I mean, I was your Attendant and you’re human, genetically incompatible, so..."
    j "我是说，我曾是你的侍从，而你是人类，基因上不相容，所以……"

# game/episode019.rpy:2014
translate simplified_chinese ep019_paclerara_jade_df853a2c:

    # j "Which is, incidentally, such an injustice, because Twi’ll and humans go so well together, sexually."
    j "顺便说一句，这实在太不公平了，因为特维尔人和人类在性方面明明那么合得来。"

# game/episode019.rpy:2015
translate simplified_chinese ep019_paclerara_jade_c26b6736:

    # j "But I’d be lying if I haven’t dreamed about it."
    j "但如果我说自己从未梦想过，那是在撒谎。"

# game/episode019.rpy:2017
translate simplified_chinese ep019_paclerara_jade_bc02d403:

    # j "Especially lately, when I heard about the final resting place of my mother."
    j "尤其是最近，当我得知母亲最终安息之地的消息后。"

# game/episode019.rpy:2018
translate simplified_chinese ep019_paclerara_jade_041cfdcc:

    # j "It’s likely the N'ec L'ordann va T'olnec bloodline will end after I die."
    j "很可能在我死后，N'ec L'ordann va T'olnec的血脉就要断绝了。"

# game/episode019.rpy:2019
translate simplified_chinese ep019_paclerara_jade_7f4fa701:

    # c "So it’s a question of continuing a family legacy for you?"
    c "所以对你来说这是个延续家族传承的问题？"

# game/episode019.rpy:2021
translate simplified_chinese ep019_paclerara_jade_9d619fef:

    # j "No, that would make the issue far too loaded."
    j "不，那样会让这个问题变得太过沉重。"

# game/episode019.rpy:2022
translate simplified_chinese ep019_paclerara_jade_94a04593:

    # j "Mainly, I just want a couple of brats to dote upon!"
    j "主要是，我只想要几个可以宠爱的小家伙！"

# game/episode019.rpy:2023
translate simplified_chinese ep019_paclerara_jade_209ddf6e:

    # c "So, raising children with a Twi’ll husband?"
    c "那么，和特维尔人丈夫一起抚养孩子？"

# game/episode019.rpy:2025
translate simplified_chinese ep019_paclerara_jade_224497b4:

    # j "No!"
    j "不！"

# game/episode019.rpy:2026
translate simplified_chinese ep019_paclerara_jade_7d7745f0:

    # j "Starting a family with you of course!"
    j "当然是和你组建家庭！"

# game/episode019.rpy:2028
translate simplified_chinese ep019_paclerara_jade_2d20d347:

    # j "But listen to me raving about becoming a mother, what about you?"
    j "但听听我这些关于当母亲的痴话，你呢？"

# game/episode019.rpy:2029
translate simplified_chinese ep019_paclerara_jade_6b1cd2fe:

    # c "I’d love to have children with you."
    c "我很想和你生儿育女。"

# game/episode019.rpy:2030
translate simplified_chinese ep019_paclerara_jade_21437d62:

    # c "And you’d make a great mother, I’m sure."
    c "我相信你一定会是个好母亲。"

# game/episode019.rpy:2031
translate simplified_chinese ep019_paclerara_jade_cc6418bb:

    # c "But as you say, genetically incompatible."
    c "但就像你说的，我们基因不相容。"

# game/episode019.rpy:2033
translate simplified_chinese ep019_paclerara_jade_4f5b044c:

    # "Jade’s smile was as radiant as it was infectious."
    "杰德的微笑既灿烂又富有感染力。"

# game/episode019.rpy:2034
translate simplified_chinese ep019_paclerara_jade_034cf970:

    # j "Are you serious about this?"
    j "你是认真的吗？"

# game/episode019.rpy:2035
translate simplified_chinese ep019_paclerara_jade_20bb8e1c:

    # c "Of course I am, I wouldn’t play with your feelings like that."
    c "当然是认真的，我不会这样玩弄你的感情。"

# game/episode019.rpy:2036
translate simplified_chinese ep019_paclerara_jade_dfbc56b8:

    # j "Because there might be a way."
    j "因为也许有办法解决。"

# game/episode019.rpy:2038
translate simplified_chinese ep019_paclerara_jade_5c8b4771:

    # j "As I said, Twi’ll and humans are so compatible sexually."
    j "就像我说的，特维尔人和人类在性方面非常契合。"

# game/episode019.rpy:2039
translate simplified_chinese ep019_paclerara_jade_fb136693:

    # j "Apparently, that’s not just a feeling."
    j "显然，这不仅仅是感觉而已。"

# game/episode019.rpy:2040
translate simplified_chinese ep019_paclerara_jade_769521cb:

    # j "Scientists at the clinic here have created an experimental procedure to make Twi’ll and human reproductive systems work together."
    j "这家诊所的科学家们研发了一种实验性程序，能让特维尔人和人类的生殖系统协同工作。"

# game/episode019.rpy:2041
translate simplified_chinese ep019_paclerara_jade_9c23979e:

    # c "They have?"
    c "他们真有？"

# game/episode019.rpy:2043
translate simplified_chinese ep019_paclerara_jade_a906ab10:

    # j "Yes, it’s only for Twi’ll and human couples who arrive here together and consent to the procedure."
    j "是的，这项实验性程序只适用于一同前来并同意接受治疗的特维尔人与人类伴侣。"

# game/episode019.rpy:2044
translate simplified_chinese ep019_paclerara_jade_25107add:

    # j "It’s not a risky method, but it requires an intervention for both species."
    j "这并非风险很高的方法，但需要对两个物种都进行干预。"

# game/episode019.rpy:2045
translate simplified_chinese ep019_paclerara_jade_286f2d13:

    # j "Females need an operation, while males need an injection."
    j "女性需要进行手术，而男性则需要注射。"

# game/episode019.rpy:2046
translate simplified_chinese ep019_paclerara_jade_b22448e5:

    # c "And after that we could conceive together?"
    c "那之后我们就能共同孕育孩子了？"

# game/episode019.rpy:2048
translate simplified_chinese ep019_paclerara_jade_9f64a2bd:

    # j "Yes."
    j "是的。"

# game/episode019.rpy:2049
translate simplified_chinese ep019_paclerara_jade_c71e1650:

    # c "And would we need repeated treatments?"
    c "我们需要重复治疗吗？"

# game/episode019.rpy:2050
translate simplified_chinese ep019_paclerara_jade_7e8047d6:

    # j "No, that’s the genius of it!"
    j "不用，这正是它最精妙的地方！"

# game/episode019.rpy:2051
translate simplified_chinese ep019_paclerara_jade_7b4a1c6d:

    # j "It only takes one cycle of treatments."
    j "只需一个疗程即可。"

# game/episode019.rpy:2052
translate simplified_chinese ep019_paclerara_jade_6dcc08ce:

    # c "Is there any downside?"
    c "有什么副作用吗？"

# game/episode019.rpy:2053
translate simplified_chinese ep019_paclerara_jade_b9e7fd85:

    # c "Like, does it render you infertile when it comes to human on human coupling?"
    c "比如，这会不会让你在和人类交配时失去生育能力？"

# game/episode019.rpy:2055
translate simplified_chinese ep019_paclerara_jade_2e442f13:

    # "Jade’s face fell and she looked away from me."
    "杰德的脸色沉了下来，她避开了我的目光。"

# game/episode019.rpy:2056
translate simplified_chinese ep019_paclerara_jade_b02b4c90:

    # j "I was afraid you’d ask that."
    j "我就怕你会问这个。"

# game/episode019.rpy:2057
translate simplified_chinese ep019_paclerara_jade_a6e34739:

    # j "There’s a downside of course."
    j "当然有弊端。"

# game/episode019.rpy:2058
translate simplified_chinese ep019_paclerara_jade_3209111c:

    # j "The procedure strengthens the male’s sperm, that’s all."
    j "这个手术只是强化了男性的精子，仅此而已。"

# game/episode019.rpy:2059
translate simplified_chinese ep019_paclerara_jade_52fb1a50:

    # j "For the women, it’s different."
    j "但对女性来说就不同了。"

# game/episode019.rpy:2060
translate simplified_chinese ep019_paclerara_jade_fc2747cd:

    # j "When a human woman undergoes the procedure, she’ll only be able to conceive with Twi’ll males afterwards."
    j "当人类女性接受这个手术后，她以后只能和特维尔男性生育。"

# game/episode019.rpy:2061
translate simplified_chinese ep019_paclerara_jade_98e75037:

    # j "Likewise, if I were to get it done, I would only be able to have children with human males."
    j "同样地，如果我做了这个手术，我也只能和人类男性生育后代。"

# game/episode019.rpy:2063
translate simplified_chinese ep019_paclerara_jade_894d10d4:

    # j "But I’m willing to take that risk."
    j "但我愿意冒这个风险。"

# game/episode019.rpy:2064
translate simplified_chinese ep019_paclerara_jade_5271c253:

    # j "For us!"
    j "为了我们！"

# game/episode019.rpy:2065
translate simplified_chinese ep019_paclerara_jade_f2685489:

    # j "There’s nobody else I want children with but you!"
    j "除了你之外，我根本不想和别人生孩子！"

# game/episode019.rpy:2069
translate simplified_chinese ep019_paclerara_jade_e15d9154:

    # c "Are you absolutely sure?"
    c "你完全确定吗？"

# game/episode019.rpy:2070
translate simplified_chinese ep019_paclerara_jade_79f3908a:

    # c "I mean it’s your choice, obviously, but I don’t want you to feel pressured or anything."
    c "我的意思是这显然是你的选择，但我不希望你感到压力之类的。"

# game/episode019.rpy:2071
translate simplified_chinese ep019_paclerara_jade_2dad1f5e:

    # c "If you don’t want it to happen, it won’t."
    c "如果你不愿意，这件事就不会发生。"

# game/episode019.rpy:2072
translate simplified_chinese ep019_paclerara_jade_2b2d8e21:

    # c "Maybe they’ll finetune the process more over the next couple of years, so that it won’t have this side effect."
    c "也许再过几年他们会进一步完善这个程序，这样就不会有这种副作用了。"

# game/episode019.rpy:2074
translate simplified_chinese ep019_paclerara_jade_d63de2ad:

    # j "I don’t want to wait years."
    j "我不想等那么多年。"

# game/episode019.rpy:2075
translate simplified_chinese ep019_paclerara_jade_3ae38d9f:

    # j "I want your baby, [p_name_short]."
    j "我想要你的孩子，[p_name_short]。"

# game/episode019.rpy:2077
translate simplified_chinese ep019_paclerara_jade_379c0810:

    # j "Or babies, for that matter."
    j "或者说，想要你的孩子们。"

# game/episode019.rpy:2079
translate simplified_chinese ep019_paclerara_jade_5d149df5:

    # j "I’ve been in love with you for a very long time, even before we acknowledged our feelings."
    j "我已经爱你很久了，甚至在我们承认彼此感情之前就开始了。"

# game/episode019.rpy:2080
translate simplified_chinese ep019_paclerara_jade_bb2be233:

    # j "And I’ve wanted your children for almost as long."
    j "而且我想为你生孩子也差不多有那么久了。"

# game/episode019.rpy:2081
translate simplified_chinese ep019_paclerara_jade_74420e76:

    # c "I’m so mad about you, Jade, I’d love for us to start trying for a family."
    c "我为你疯狂，杰德，我多希望我们能开始组建家庭。"

# game/episode019.rpy:2083
translate simplified_chinese ep019_paclerara_jade_d413c173:

    # c "I’m not sure I can ask you do that for me, Jade."
    c "我不确定能否要求你为我这么做，杰德。"

# game/episode019.rpy:2084
translate simplified_chinese ep019_paclerara_jade_c6085d57:

    # c "I can’t be responsible for partially sterilizing you."
    c "我不能为你部分绝育这件事负责。"

# game/episode019.rpy:2086
translate simplified_chinese ep019_paclerara_jade_dae8b329:

    # j "You know it’s my own choice, right?"
    j "你知道这是我自己的选择，对吧？"

# game/episode019.rpy:2087
translate simplified_chinese ep019_paclerara_jade_bb78aab7:

    # c "I know."
    c "我知道。"

# game/episode019.rpy:2088
translate simplified_chinese ep019_paclerara_jade_1e34b001:

    # c "It’s your own body."
    c "这是你自己的身体。"

# game/episode019.rpy:2089
translate simplified_chinese ep019_paclerara_jade_341fc91b:

    # c "But it’s definitive, right, there’s no going back?"
    c "但这是永久性的，对吗，没有回头路可走？"

# game/episode019.rpy:2091
translate simplified_chinese ep019_paclerara_jade_94456c77:

    # j "No, there isn’t."
    j "是的，没有。"

# game/episode019.rpy:2092
translate simplified_chinese ep019_paclerara_jade_41048960:

    # c "I don’t really want to think about it, but what if something happens to me?"
    c "我真的不愿去想这件事，但如果我发生什么意外呢？"

# game/episode019.rpy:2093
translate simplified_chinese ep019_paclerara_jade_ad53d1a6:

    # c "What if I’m no longer there and you’ve met someone else and are ready to move on?"
    c "如果我不在了，而你遇到了别人准备开始新生活呢？"

# game/episode019.rpy:2095
translate simplified_chinese ep019_paclerara_jade_a9f629f3:

    # j "This isn’t some whim, [p_name]."
    j "这不是一时冲动，[p_name]。"

# game/episode019.rpy:2096
translate simplified_chinese ep019_paclerara_jade_5d149df5_1:

    # j "I’ve been in love with you for a very long time, even before we acknowledged our feelings."
    j "我爱上你已经很久了，甚至在我们承认彼此感情之前。"

# game/episode019.rpy:2097
translate simplified_chinese ep019_paclerara_jade_bb2be233_1:

    # j "And I’ve wanted your children for almost as long."
    j "而且我渴望拥有你的孩子也差不多同样久了。"

# game/episode019.rpy:2101
translate simplified_chinese ep019_paclerara_jade_a5a8c4e5:

    # c "Don’t misunderstand me, I really want us to have kids."
    c "别误会，我真的想要我们有自己的孩子。"

# game/episode019.rpy:2102
translate simplified_chinese ep019_paclerara_jade_1a04042e:

    # c "I just don’t want to overwhelm you with my enthusiasm and force you into making life-changing choices."
    c "我只是不想用我的热情压垮你，强迫你做出改变人生的选择。"

# game/episode019.rpy:2104
translate simplified_chinese ep019_paclerara_jade_9c7bf52b:

    # j "Well, I’m not getting those enthused vibes from you, to be honest."
    j "老实说，我并没有从你那里感受到那种热情。"

# game/episode019.rpy:2105
translate simplified_chinese ep019_paclerara_jade_926a80e6:

    # c "But I am, Jade!"
    c "但我很热情啊，杰德！"

# game/episode019.rpy:2106
translate simplified_chinese ep019_paclerara_jade_397abb57:

    # c "As I said, you’d be a great mother."
