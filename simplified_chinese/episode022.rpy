# game/episode022.rpy:1362
translate simplified_chinese ep022_temple_hostiles_fb7234a2:

    # ag "Eugenics sounds so crass, so mundane."
    ag "优生学听起来太粗俗，太平庸了。"

# game/episode022.rpy:1363
translate simplified_chinese ep022_temple_hostiles_d421c830:

    # ag "This is the discovery of a lifetime, a true singularity."
    ag "这可是千载难逢的发现，是真正的奇点突破。"

# game/episode022.rpy:1364
translate simplified_chinese ep022_temple_hostiles_99eef182:

    # c "No matter how you sugarcoat it, thousands of living beings died for this so-called singularity."
    c "无论你怎么粉饰，成千上万的生命都因这个所谓的奇点而牺牲。"

# game/episode022.rpy:1366
translate simplified_chinese ep022_temple_hostiles_a92b2fd0:

    # co "That has always been true of great technological leaps like these."
    co "这类重大技术飞跃向来都是如此。"

# game/episode022.rpy:1367
translate simplified_chinese ep022_temple_hostiles_6c74a20d:

    # c "Oh great, the purple walking corpse has decided to join the fawning circle-jerk."
    c "哦，太好了，这个紫色行走的僵尸决定加入这场阿谀奉承的集体狂欢了。"

# game/episode022.rpy:1369
translate simplified_chinese ep022_temple_hostiles_5fb9dd9d:

    # ag "Silence!"
    ag "安静！"

# game/episode022.rpy:1370
translate simplified_chinese ep022_temple_hostiles_73423ced:

    # ag "I’ll be so relieved when I finally kill you, but first I want you to be a witness to the ascension of humankind."
    ag "等我最终杀了你时，我会如释重负，但首先我要你见证人类的升华。"

# game/episode022.rpy:1371
translate simplified_chinese ep022_temple_hostiles_3b739ee8:

    # c "Easy now, I might get all teary-eyed if you continue with all those big words."
    c "别激动，你要是继续说这些大话，我可能会感动得热泪盈眶。"

# game/episode022.rpy:1373
translate simplified_chinese ep022_temple_hostiles_2ed8fc18:

    # "My father ignored my last comment and watched the Confessor work on the many computer consoles in the room."
    "我父亲无视了我最后的评论，注视着\"忏悔者\"在房间内的众多计算机控制台上操作。"

# game/episode022.rpy:1374
translate simplified_chinese ep022_temple_hostiles_f8919c31:

    # "We waited a good while before the Confessor stepped away from the consoles and addressed his handmaidens."
    "我们等待了好一阵子，\"忏悔者\"才从控制台前退开，对他的侍女们发话。"

# game/episode022.rpy:1375
translate simplified_chinese ep022_temple_hostiles_f375d2c6:

    # co "Bring me the blonde girl."
    co "把那个金发女孩带过来。"

# game/episode022.rpy:1377
translate simplified_chinese ep022_temple_hostiles_3b4b95c9:

    # "The handmaidens pulled Eva to her feet."
    "侍女们把伊娃拉了起来。"

# game/episode022.rpy:1378
translate simplified_chinese ep022_temple_hostiles_b7b17ab3:

    # c "What?!{w} No!"
    c "什么？！{w} 不！"

# game/episode022.rpy:1380
translate simplified_chinese ep022_temple_hostiles_b74a644a:

    # l "Keep your hands off her!"
    l "把你的手从她身上拿开！"

# game/episode022.rpy:1382
translate simplified_chinese ep022_temple_hostiles_fae2683f:

    # av "What are you going to do with her?"
    av "你要对她做什么？"

# game/episode022.rpy:1384
translate simplified_chinese ep022_temple_hostiles_d32a3276:

    # ag "I can’t believe you’re all still so ignorant."
    ag "我真不敢相信你们还是如此愚昧无知。"

# game/episode022.rpy:1385
translate simplified_chinese ep022_temple_hostiles_706f8aa4:

    # ag "You’ve read that prophecy, haven’t you?"
    ag "你读过那个预言，不是吗？"

# game/episode022.rpy:1386
translate simplified_chinese ep022_temple_hostiles_3b353c55:

    # ag "The first part details the location of this temple."
    ag "第一部分详细说明了这座神庙的位置。"

# game/episode022.rpy:1387
translate simplified_chinese ep022_temple_hostiles_425ea2ff:

    # ag "This is the place where a great civilization found its end, but it’s also a place of rebirth."
    ag "这里是伟大文明终结之地，却也是重生之所。"

# game/episode022.rpy:1389
translate simplified_chinese ep022_temple_hostiles_280d1663:

    # co "The prophecy alludes to Hippolyta, an ancient queen of female warriors, who will bring about a new age."
    co "预言提及希波吕忒—一位远古女战士女王，她将开启新时代。"

# game/episode022.rpy:1391
translate simplified_chinese ep022_temple_hostiles_929f3b01:

    # co "When we first found you, on Erigone, your sister was crowned the queen of that martial breed of females."
    co "当初在厄里戈涅星发现你们时，你的妹妹被加冕为那支尚武女性族群的君主。"

# game/episode022.rpy:1393
translate simplified_chinese ep022_temple_hostiles_7b5eff8f:

    # co "When we first found you, on Erigone, this girl here was crowned the queen of that martial breed of females."
    co "当初在厄里戈涅星发现你们时，这位姑娘被加冕为那支尚武女性族群的君主。"

# game/episode022.rpy:1394
translate simplified_chinese ep022_temple_hostiles_587d33e5:

    # co "Quite fitting, I should say."
    co "依我看，这再合适不过。"

# game/episode022.rpy:1396
translate simplified_chinese ep022_temple_hostiles_2289e6c4:

    # ag "Her genetic markup is unique."
    ag "她的基因标记独一无二。"

# game/episode022.rpy:1397
translate simplified_chinese ep022_temple_hostiles_99edf586:

    # ag "A one in several billion DNA sequence, capable of unlocking the secrets stored by the enlightened Shixses."
    ag "这是数十亿分之一的DNA序列，足以解开启蒙者希克塞斯封存的奥秘。"

# game/episode022.rpy:1398
translate simplified_chinese ep022_temple_hostiles_f542d5cf:

    # c "You’re going to subject Eva to the treatment the Shixses forced on their test subjects?"
    c "你们要让伊娃承受希克塞斯曾强加于实验对象的处置？"

# game/episode022.rpy:1399
translate simplified_chinese ep022_temple_hostiles_2f148585:

    # ag "It’s the only way to bring about the prophecied singularity."
    ag "这是实现预言中奇点的唯一途径。"

# game/episode022.rpy:1400
translate simplified_chinese ep022_temple_hostiles_59414b24:

    # c "But the procedure will kill her!"
    c "但这手术会害死她的！"

# game/episode022.rpy:1401
translate simplified_chinese ep022_temple_hostiles_6109d0f4:

    # ag "Yes, Eva will have to make a necessary sacrifice."
    ag "是的，伊娃必须做出必要的牺牲。"

# game/episode022.rpy:1403
translate simplified_chinese ep022_temple_hostiles_28b92372:

    # "Lilly and Aven were sobbing and had to be restrained by the guards."
    "莉莉和艾文啜泣着，被守卫们强行按住。"

# game/episode022.rpy:1404
translate simplified_chinese ep022_temple_hostiles_492af5bc:

    # "Eva stood awfully quiet in between the two handmaidens, seemingly resigned with her imminent fate."
    "伊娃静静地站在两位侍女中间，异常沉默，似乎已接受即将到来的命运。"

# game/episode022.rpy:1407
translate simplified_chinese ep022_temple_hostiles_5a45574a:

    # l "Please Dad, don’t do it."
    l "求你了爸爸，别这么做。"

# game/episode022.rpy:1408
translate simplified_chinese ep022_temple_hostiles_b7338163:

    # l "If you ever loved us..."
    l "如果你曾爱过我们…"

# game/episode022.rpy:1410
translate simplified_chinese ep022_temple_hostiles_7694bb9f:

    # ag "I’ve given you all I could."
    ag "我已给了你们我所能给的一切。"

# game/episode022.rpy:1411
translate simplified_chinese ep022_temple_hostiles_463c5d77:

    # ag "A roof over your head, an education, a life of luxury."
    ag "遮风挡雨的屋顶，良好的教育，奢华的生活。"

# game/episode022.rpy:1412
translate simplified_chinese ep022_temple_hostiles_1a80cc82:

    # ag "But now it’s time to collect."
    ag "但现在该收取回报了。"

# game/episode022.rpy:1414
translate simplified_chinese ep022_temple_hostiles_b2a34f0c:

    # l "Please, don’t do it."
    l "求求你，别这么做。"

# game/episode022.rpy:1415
translate simplified_chinese ep022_temple_hostiles_8ffd26ce:

    # l "She’s innocent."
    l "她是无辜的。"

# game/episode022.rpy:1417
translate simplified_chinese ep022_temple_hostiles_98e51d0f:

    # ag "Nobody is innocent."
    ag "没有谁是清白的。"

# game/episode022.rpy:1418
translate simplified_chinese ep022_temple_hostiles_e3a2b005:

    # ag "The technology locked in this temple will revolutionize human society."
    ag "这座神殿里封存的技术将彻底改变人类社会。"

# game/episode022.rpy:1419
translate simplified_chinese ep022_temple_hostiles_bb2d7228:

    # ag "And I aim to be at the forefront of that revolution."
    ag "而我立志要站在那场变革的最前沿。"

# game/episode022.rpy:1420
translate simplified_chinese ep022_temple_hostiles_0fb78874:

    # ag "The Sovereignty will reign supreme over all the lesser races."
    ag "至高权域\"将统治所有低等种族。"

# game/episode022.rpy:1422
translate simplified_chinese ep022_temple_hostiles_e43cf4bd:

    # ag "A true empire, lasting millions of years."
    ag "一个真正的帝国，延续数百万年。"

# game/episode022.rpy:1423
translate simplified_chinese ep022_temple_hostiles_e51450b5:

    # ag "I will experience that ascension of the human race, as the research of the Shixses extends my life exponentially and grants me untold powers."
    ag "我将见证人类的崛起，因为希克塞斯的研究将指数级延长我的寿命，并赋予我难以言喻的力量。"

# game/episode022.rpy:1426
translate simplified_chinese ep022_temple_hostiles_649afef0:

    # l "Eva is pregnant, goddamnit!"
    l "伊娃怀孕了，该死的！"

# game/episode022.rpy:1427
translate simplified_chinese ep022_temple_hostiles_956dd5b8:

    # l "You’ll kill her and her baby."
    l "你会害死她和她的孩子。"

# game/episode022.rpy:1428
translate simplified_chinese ep022_temple_hostiles_361dbbf1:

    # l "How can you be so cold?!"
    l "你怎么能如此冷酷？！"

# game/episode022.rpy:1430
translate simplified_chinese ep022_temple_hostiles_524876d5:

    # ag "That’s unfortunate news, but as I said, at some point we all have to make sacrifices."
    ag "这消息确实令人遗憾，但正如我所说，在某些时刻我们都必须做出牺牲。"

# game/episode022.rpy:1432
translate simplified_chinese ep022_temple_hostiles_dc23f71b:

    # l "Spare me your pontificating bullshit, you utter piece of shit!"
    l "收起你那套冠冕堂皇的狗屁说辞吧，你这个彻头彻尾的垃圾！"

# game/episode022.rpy:1433
translate simplified_chinese ep022_temple_hostiles_24025d99:

    # "Lilly’s tirade was cut short by a sudden movement by Eva."
    "莉莉的激烈言辞被伊娃突然的动作打断了。"

# game/episode022.rpy:1435
translate simplified_chinese ep022_temple_hostiles_c9098391:

    # "She tried to grab the pistol of one of the soldiers standing nearby."
    "她试图抢夺站在附近一名士兵的手枪。"

# game/episode022.rpy:1436
translate simplified_chinese ep022_temple_hostiles_f6b3db35:

    # "Unfortunately she couldn’t pull the weapon from its holster."
    "可惜她没能把武器从枪套里拔出来。"

# game/episode022.rpy:1438
translate simplified_chinese ep022_temple_hostiles_af84eb49:

    # ag "You’re not thinking of killing yourself prematurely, are you, Eva?"
    ag "你该不会想提前结束自己的生命吧，伊娃？"

# game/episode022.rpy:1439
translate simplified_chinese ep022_temple_hostiles_ebe851f3:

    # e "Nobody should have the knowledge of the Shixses."
    e "任何人都不该掌握希克塞斯的知识。"

# game/episode022.rpy:1440
translate simplified_chinese ep022_temple_hostiles_75f5c0a9:

    # e "Especially not a monster like you."
    e "尤其是像你这样的怪物。"

# game/episode022.rpy:1442
translate simplified_chinese ep022_temple_hostiles_df036d57:

    # "Eva struggled in the grasp of the handmaidens, irate with rage."
    "伊娃在侍女们的钳制下挣扎着，怒不可遏。"

# game/episode022.rpy:1444
translate simplified_chinese ep022_temple_hostiles_3e425046:

    # ag "You’ll submit to the procedure, or I’ll execute every last member of your crew, starting with your sisters and brother."
    ag "你要么接受这个程序，要么我就处决你船上的每一个成员，从你的姐妹们和兄弟开始。"

# game/episode022.rpy:1446
translate simplified_chinese ep022_temple_hostiles_52ccd7b7:

    # ag "You’ll submit to the procedure, or I’ll execute every last member of your crew, starting with these three here."
    ag "你要么接受这个程序，要么我就处决你船上的每一个成员，从这三位开始。"

# game/episode022.rpy:1447
translate simplified_chinese ep022_temple_hostiles_f52b00a2:

    # e "No!{w} Please don’t hurt them."
    e "不！{w} 求你别伤害他们。"

# game/episode022.rpy:1448
translate simplified_chinese ep022_temple_hostiles_b3f24fbd:

    # ag "Strap her down and start the procedure."
    ag "把她绑好，开始手术。"

# game/episode022.rpy:1449
translate simplified_chinese ep022_temple_hostiles_ae17c619:

    # ag "If she so much as twitches, shoot Lilly through the head and then move on to the brunette."
    ag "要是她敢动一下，就爆了莉莉的头，接着解决那个棕发姑娘。"

# game/episode022.rpy:1451
translate simplified_chinese ep022_temple_hostiles_e95aa352:

    # "We were all stunned into silence as the handmaidens tied down Eva on the table."
    "当侍女们把伊娃绑在手术台上时，我们都惊得哑口无言。"

# game/episode022.rpy:1452
translate simplified_chinese ep022_temple_hostiles_ac96c88c:

    # co "The time is finally here."
    co "这一刻终于来临了。"

# game/episode022.rpy:1453
translate simplified_chinese ep022_temple_hostiles_7f974838:

    # co "Years of searching in vain and now we are here on the precipice of a new age."
    co "徒劳搜寻多年，如今我们正站在新时代的悬崖边缘。"

# game/episode022.rpy:1454
translate simplified_chinese ep022_temple_hostiles_8f882ba2:

    # "I would have let out a derisive snort, but they all sounded so serious."
    "我差点嗤之以鼻，但他们的语气都如此严肃。"

# game/episode022.rpy:1455
translate simplified_chinese ep022_temple_hostiles_a5ba581d:

    # "In the Confessor’s case that wasn’t too surprising, I mean the guy dressed like a weird monk and had a penchant for theatrics."
    "至于\"忏悔者\"倒不令人意外，毕竟这家伙穿得像古怪僧侣，还偏爱戏剧化表演。"

# game/episode022.rpy:1456
translate simplified_chinese ep022_temple_hostiles_f8dc7827:

    # "The nickname also spoke volumes."
    "那个绰号也说明了很多问题。"

# game/episode022.rpy:1457
translate simplified_chinese ep022_temple_hostiles_512eb215:

    # "But my father believing all that grandiose drivel was a true surprise."
    "但令我真正惊讶的是，我父亲居然会相信这些浮夸的胡言乱语。"

# game/episode022.rpy:1458
translate simplified_chinese ep022_temple_hostiles_8a32f6c1:

    # "The only thing that interested him before was the size of his wallet and what amount of influence he could buy with it."
    "他唯一感兴趣的就是他钱包的厚度和能用它买到多少影响力。"

# game/episode022.rpy:1459
translate simplified_chinese ep022_temple_hostiles_c5e9d4b4:

    # "The promise of power must have really taken root in him and that scared me more than the cadaverous grandpa in his purple robes."
    "对权力的承诺一定已经在他心里深深扎根，这比那个穿着紫袍、形如枯槁的老头更让我感到害怕。"

# game/episode022.rpy:1461
translate simplified_chinese ep022_temple_hostiles_847e992c:

    # co "Let us begin."
    co "让我们开始吧。"

# game/episode022.rpy:1462
translate simplified_chinese ep022_temple_hostiles_4ff6ec12:

    # co "Once the extraction process has been completed and the genetic databanks have been unlocked, the table will be ready for the first host."
    co "一旦提取过程完成且基因数据库解锁，这张桌子就能准备好迎接第一位宿主。"

# game/episode022.rpy:1463
translate simplified_chinese ep022_temple_hostiles_29ebaa9b:

    # co "As agreed, I will undergo treatment first."
    co "按照约定，我将第一个接受治疗。"

# game/episode022.rpy:1464
translate simplified_chinese ep022_temple_hostiles_8825f5e6:

    # co "You, Agust, will be the second, and so forth."
    co "你，阿古斯特，将是第二个，依此类推。"

# game/episode022.rpy:1466
translate simplified_chinese ep022_temple_hostiles_1ddd3ec3:

    # "The Confessor entered the startup sequence and energy beams crackled all over Eva’s body."
    "忏悔者启动了程序，能量光束在伊娃全身噼啪作响。"

# game/episode022.rpy:1468
translate simplified_chinese ep022_temple_hostiles_e6550264:

    # "Eva screamed in pain and my other sister’s wailed in response."
    "伊娃痛苦地尖叫，我的其他姐妹们也哀嚎回应。"

# game/episode022.rpy:1470
translate simplified_chinese ep022_temple_hostiles_2828efd8:

    # "Eva screamed in pain and the other girl’s wailed in response."
    "伊娃痛苦地尖叫，那个女孩也哀嚎回应。"

# game/episode022.rpy:1471
translate simplified_chinese ep022_temple_hostiles_104e062f:

    # "A red hot anger began to build inside me, unable to get out as the muzzle of a rifle was still pressed against the back of my head."
    "一股灼热的愤怒开始在我心中积聚，却无法发泄，因为步枪的枪口仍然抵在我的后脑勺上。"

# game/episode022.rpy:1472
translate simplified_chinese ep022_temple_hostiles_fda0df07:

    # "The fucking nerve of these people."
    "这帮人他妈的真是胆大包天。"

# game/episode022.rpy:1474
translate simplified_chinese ep022_temple_hostiles_50634772:

    # "My cut-throat father, sacrificing one of his daughters like it was nothing."
    "我那冷酷无情的父亲，牺牲自己的一个女儿就像没事人一样。"

# game/episode022.rpy:1476
translate simplified_chinese ep022_temple_hostiles_cee4d52f:

    # "My cut-throat father, sacrificing one of my friends like it was nothing."
    "我那冷酷无情的父亲，牺牲我的一个朋友就像没事人一样。"

# game/episode022.rpy:1477
translate simplified_chinese ep022_temple_hostiles_9ddf3351:

    # "And I had a feeling the killing wouldn’t stop there."
    "而且我有预感杀戮不会就此停止。"

# game/episode022.rpy:1479
translate simplified_chinese ep022_temple_hostiles_01703a3b:

    # "I forced back my tears as Eva suffered in front of me."
    "当伊娃在我面前受苦时，我强忍住了泪水。"

# game/episode022.rpy:1480
translate simplified_chinese ep022_temple_hostiles_900fbb3a:

    # "She thrashed and screamed, but the procedure ran it’s unrelenting course."
    "她挣扎着尖叫，但程序依然无情地进行着。"

# game/episode022.rpy:1482
translate simplified_chinese ep022_temple_hostiles_7f91241d:

    # "I could see my sister weakening in front of my eyes."
    "我能亲眼看到我的妹妹在我面前逐渐虚弱。"

# game/episode022.rpy:1484
translate simplified_chinese ep022_temple_hostiles_0fe4161e:

    # "I could see Eva weakening in front of my eyes."
    "我能亲眼看到伊娃在我面前逐渐虚弱。"

# game/episode022.rpy:1485
translate simplified_chinese ep022_temple_hostiles_d382e3c7:

    # "Her cries came out strangled and at some point only spams ran through her body, rigid with pain."
    "她的哭喊声变得断断续续，到某个时刻只剩下痛苦的痉挛在她僵直的身体中穿行。"

# game/episode022.rpy:1487
translate simplified_chinese ep022_temple_hostiles_1002ba02:

    # "As the procedure ended, I could see she wasn’t breathing anymore."
    "当程序结束时，我能看到她已经不再呼吸。"

# game/episode022.rpy:1488
translate simplified_chinese ep022_temple_hostiles_0802a766:

    # av "Is she-"
    av "她是不是—"

# game/episode022.rpy:1489
translate simplified_chinese ep022_temple_hostiles_da5ade18:

    # l "No!"
    l "不！"

# game/episode022.rpy:1490
translate simplified_chinese ep022_temple_hostiles_8571b937:

    # co "The process has been completed."
    co "程序已经完成。"

# game/episode022.rpy:1493
translate simplified_chinese ep022_temple_hostiles_45d4a4a8:

    # "The handmaidens lifted my sister from the table and laid her on the ground."
    "侍女们将我妹妹从桌上抬起，平放在地上。"

# game/episode022.rpy:1494
translate simplified_chinese ep022_temple_hostiles_20ff391d:

    # "My sisters were crying and tried to scramble to Eva’s lifeless body, the soldiers keeping them back with force."
    "我的姐妹们哭泣着想要扑向伊娃失去生机的身体，士兵们用力拦住了她们。"

# game/episode022.rpy:1496
translate simplified_chinese ep022_temple_hostiles_f3bd3252:

    # "The handmaidens lifted Eva from the table and laid her on the ground."
    "侍女们将伊娃从桌上抬起，平放在地上。"

# game/episode022.rpy:1497
translate simplified_chinese ep022_temple_hostiles_25a3bbd1:

    # "Aven and Lilly were crying and tried to scramble to Eva’s lifeless body, the soldiers keeping them back with force."
    "艾文和莉莉哭泣着想要扑向伊娃失去生机的身体，士兵们用力拦住了她们。"

# game/episode022.rpy:1498
translate simplified_chinese ep022_temple_hostiles_b4136e00:

    # co "The table is now ready for the first host."
    co "桌子现在已为首位宿主准备就绪。"

# game/episode022.rpy:1499
translate simplified_chinese ep022_temple_hostiles_b8ffa75e:

    # ag "Excellent."
    ag "很好。"

# game/episode022.rpy:1501
translate simplified_chinese ep022_temple_hostiles_698d77c1:

    # "BLAM!"
    "砰！"

# game/episode022.rpy:1502
translate simplified_chinese ep022_temple_hostiles_5dcfcd65:

    # "My father suddenly pulled a gun and shot the Confessor through the head."
    "我父亲突然拔枪射穿了\"忏悔者\"的脑袋。"

# game/episode022.rpy:1504
translate simplified_chinese ep022_temple_hostiles_622b0baf:

    # "On cue, the soldiers riddled the handmaidens with rays of energy."
    "按预定信号，士兵们用能量射线将侍女们打成筛子。"

# game/episode022.rpy:1505
translate simplified_chinese ep022_temple_hostiles_675331a4:

    # "The Confessor sank to the ground wearing a very surprised expression."
    "\"忏悔者\"带着极其惊讶的表情瘫倒在地。"

# game/episode022.rpy:1506
translate simplified_chinese ep022_temple_hostiles_fb61792b:

    # "Erylin was screaming in rage."
    "艾瑞琳愤怒地尖叫着。"

# game/episode022.rpy:1508
translate simplified_chinese ep022_temple_hostiles_c6d43f4f:

    # ag "This power isn’t something to be shared."
    ag "这种力量不该被分享。"

# game/episode022.rpy:1509
translate simplified_chinese ep022_temple_hostiles_5e4c7c7c:

    # ag "Something you never understood."
    ag "这是你永远无法理解的道理。"

# game/episode022.rpy:1510
translate simplified_chinese ep022_temple_hostiles_d986bb05:

    # ag "Men, take care of the priestess."
    ag "士兵们，处理掉那个女祭司。"

# game/episode022.rpy:1512
translate simplified_chinese ep022_temple_hostiles_f7151b46:

    # "With those words, my father climbed on top of the table and the transfusion process started up."
    "说完这些话，我父亲爬上平台，输血程序随即启动。"

# game/episode022.rpy:1513
translate simplified_chinese ep022_temple_hostiles_fda1c051:

    # "The soldiers were looking for Erylin, who’d seemingly disappeared from the room."
    "士兵们正在寻找似乎已从房间消失的艾瑞琳。"

# game/episode022.rpy:1515
translate simplified_chinese ep022_temple_hostiles_1b7c9d16:

    # "Taking advantage of their momentary distraction, I sprang up and lunged toward the table."
    "趁他们一时分心，我猛地起身扑向平台。"

# game/episode022.rpy:1516
translate simplified_chinese ep022_temple_hostiles_6e1a655c:

    # "My father grunted as I landed on top of his body."
    "当我落在我父亲的身体上时，他咕哝了一声。"

# game/episode022.rpy:1518
translate simplified_chinese ep022_temple_hostiles_43e0671b:

    # "I didn’t give him time to respond, clasped my hands around his neck and started strangling him."
    "我没给他反应的时间，双手扼住他的脖子开始勒他。"

# game/episode022.rpy:1519
translate simplified_chinese ep022_temple_hostiles_54a2583e:

    # l "[p_name], no!"
    l "[p_name]，不要！"

# game/episode022.rpy:1521
translate simplified_chinese ep022_temple_hostiles_6166adaa:

    # "Agust tried in vain to pull my hands from his throat, as the energy waves started appearing around us again."
    "当能量波再次在我们周围出现时，阿古斯特徒劳地试图把我的手从他喉咙上拉开。"

# game/episode022.rpy:1522
translate simplified_chinese ep022_temple_hostiles_42a6ae9e:

    # "A searing pain spread throughout my body as the energy penetrated."
    "随着能量穿透，一阵灼热的疼痛传遍了我的全身。"

# game/episode022.rpy:1523
translate simplified_chinese ep022_temple_hostiles_a62a9628:

    # "My hold on Agust’s throat slackened in time with his grip on my arms weakening."
    "我对阿古斯特喉咙的扼制随着他对我手臂的抓握减弱而松懈了。"

# game/episode022.rpy:1525
translate simplified_chinese ep022_temple_hostiles_c0333c49:

    # "The transfusion process was now well underway, the pain debilitating."
    "输血过程现在进行得很顺利，疼痛令人虚弱。"

# game/episode022.rpy:1526
translate simplified_chinese ep022_temple_hostiles_bca0522b:

    # "Black spots began to appear in my vision and I could hear my father gnash his teeth."
    "我的视野开始出现黑点，我能听到我父亲咬牙切齿的声音。"

# game/episode022.rpy:1528
translate simplified_chinese ep022_temple_hostiles_3d9018dc:

    # c "I...{w} Will...{w} Fucking...{w} End...{w} You."
    c "我…{w}要…{w}他妈的…{w}终结…{w}你。"

# game/episode022.rpy:1533
translate simplified_chinese ep022_temple_hostiles_926414b4:

    # "I blacked out at that point, so I didn’t know if my father had heard me, or made any reply."
    "那时我昏了过去，所以我不知道我父亲是否听到了我的话，或者作出了任何回应。"

# game/episode022.rpy:1536
translate simplified_chinese ep022_temple_hostiles_501fe037:

    # woman "[p_name_short]?"
    woman "[p_name_short]?"

# game/episode022.rpy:1537
translate simplified_chinese ep022_temple_hostiles_b41af449:

    # woman "[p_name]?!"
    woman "[p_name]?!"

# game/episode022.rpy:1538
translate simplified_chinese ep022_temple_hostiles_3b20ee8c:

    # woman2 "Is he breathing?"
    woman2 "他还有呼吸吗？"

# game/episode022.rpy:1539
translate simplified_chinese ep022_temple_hostiles_14dfc675:

    # woman "He is."
    woman "还有。"

# game/episode022.rpy:1540
translate simplified_chinese ep022_temple_hostiles_e8b140ab:

    # woman2 "[p_name], wake up!"
    woman2 "[p_name]，醒醒！"

# game/episode022.rpy:1541
translate simplified_chinese ep022_temple_hostiles_54a0539e:

    # "The world returned to me."
    "世界重新回到我眼前。"

# game/episode022.rpy:1542
translate simplified_chinese ep022_temple_hostiles_37538eb2:

    # "I felt a hand on my forehead, another one gently rocking my body."
    "我感觉到一只手搭在我额头上，另一只手轻轻摇晃着我的身体。"

# game/episode022.rpy:1544
translate simplified_chinese ep022_temple_hostiles_648453c4:

    # "I opened my eyes."
    "我睁开了眼睛。"

# game/episode022.rpy:1545
translate simplified_chinese ep022_temple_hostiles_ef3eb5dc:

    # "A buzzing sensation clouded all my senses and I couldn’t see straight."
    "一阵嗡鸣感笼罩了我所有感官，视线也变得模糊不清。"

# game/episode022.rpy:1548
translate simplified_chinese ep022_temple_hostiles_ca265fd2:

    # "The temple was deserted, except for my sisters and the corpses of the Confessor and his handmaidens."
    "神殿里空无一人，除了我的姐妹们以及\"忏悔者\"和他侍女们的尸体。"

# game/episode022.rpy:1550
translate simplified_chinese ep022_temple_hostiles_3d2d3792:

    # "The temple was deserted, except for Lilly, Aven, Eva and the corpses of the Confessor and his handmaidens."
    "神殿里空无一人，除了莉莉、艾文、伊娃以及\"忏悔者\"和他侍女们的尸体。"

# game/episode022.rpy:1552
translate simplified_chinese ep022_temple_hostiles_f4ff6d8f:

    # c "Wha-"
    c "什-"

# game/episode022.rpy:1554
translate simplified_chinese ep022_temple_hostiles_41457dbf:

    # l "The soldiers have gone, for now."
    l "士兵们暂时离开了。"

# game/episode022.rpy:1556
translate simplified_chinese ep022_temple_hostiles_1090b718:

    # l "Dad had a heart attack after the process ended, they rushed him back to their ship for treatment."
    l "过程结束后爸爸心脏病发作，他们急忙把他送回飞船治疗。"

# game/episode022.rpy:1558
translate simplified_chinese ep022_temple_hostiles_18fd4bf2:

    # l "Your dad had a heart attack after the process ended, they rushed him back to their ship for treatment."
    l "你爸爸在过程结束后心脏病发作，他们急忙把他送回飞船治疗。"

# game/episode022.rpy:1559
translate simplified_chinese ep022_temple_hostiles_123fd8b1:

    # l "There’s still a squad of soldiers outside, we’re being held prisoner until they return."
    l "外面还有一队士兵，在他们回来之前我们都被囚禁着。"

# game/episode022.rpy:1560
translate simplified_chinese ep022_temple_hostiles_a28f50ae:

    # c "They’re going to try the procedure again?"
    c "他们打算再试一次那个程序？"

# game/episode022.rpy:1562
translate simplified_chinese ep022_temple_hostiles_2648e1fe:

    # av "No, I don’t think that’s possible."
    av "不，我觉得那不可能。"

# game/episode022.rpy:1563
translate simplified_chinese ep022_temple_hostiles_2e4778eb:

    # av "Not right away, at least."
    av "至少不可能马上进行。"

# game/episode022.rpy:1564
translate simplified_chinese ep022_temple_hostiles_4e289eca:

    # av "The computer consoles all blew out after the energy levels hit their peak."
    av "能量水平达到峰值后，所有计算机控制台都烧毁了。"

# game/episode022.rpy:1565
translate simplified_chinese ep022_temple_hostiles_a5683178:

    # "I nodded and tried to sit up."
    "我点点头，试图坐起来。"

# game/episode022.rpy:1566
translate simplified_chinese ep022_temple_hostiles_eda8aea0:

    # "The room started spinning and a splitting headache sheared through my brain."
    "房间开始旋转，一阵剧烈的头痛撕裂了我的大脑。"

# game/episode022.rpy:1568
translate simplified_chinese ep022_temple_hostiles_347c9752:

    # "I fell from the table and vomited black bile."
    "我从桌上摔下，吐出了黑色的胆汁。"

# game/episode022.rpy:1569
translate simplified_chinese ep022_temple_hostiles_b47406c1:

    # "That’s when I saw Eva lying on the ground and it all came rushing back to me."
    "就在那时，我看到伊娃躺在地上，所有记忆瞬间涌回脑海。"

# game/episode022.rpy:1570
translate simplified_chinese ep022_temple_hostiles_b20ab119:

    # c "Eva!"
    c "伊娃！"

# game/episode022.rpy:1571
translate simplified_chinese ep022_temple_hostiles_9049879f:

    # "The buzzing in my head intensified and my vision suddenly became excruciatingly clear."
    "我脑中的嗡鸣声加剧，视线突然变得异常清晰。"

# game/episode022.rpy:1572
translate simplified_chinese ep022_temple_hostiles_879ccd84:

    # "It was as if my senses were heightened to an extraordinary degree."
    "仿佛我的感官被提升到了非凡的程度。"

# game/episode022.rpy:1576
translate simplified_chinese ep022_temple_hostiles_0b8e217a:

    # "But everything was washed out by the dreadful reality that my sister and our baby were no longer in this world."
    "但这一切都被可怕的现实所淹没—我的妹妹和我们的孩子已不在人世。"

# game/episode022.rpy:1578
translate simplified_chinese ep022_temple_hostiles_8cd8ac75:

    # "But everything was washed out by the dreadful reality that my girlfriend and our baby were no longer in this world."
    "但这一切都被可怕的现实所淹没—我的女友和我们的孩子已不在人世。"

# game/episode022.rpy:1581
translate simplified_chinese ep022_temple_hostiles_fe522a1a:

    # "But everything was washed out by the dreadful reality that my sister was no longer in this world."
    "但这一切都被可怕的现实所淹没—我的妹妹已不在人世。"

# game/episode022.rpy:1583
translate simplified_chinese ep022_temple_hostiles_f7e8b660:

    # "But everything was washed out by the dreadful reality that my girlfriend was no longer in this world."
    "但这一切都被可怕的现实所淹没—我的女友已不在人世。"

# game/episode022.rpy:1585
translate simplified_chinese ep022_temple_hostiles_6c444ffc:

    # "I held Eva’s lifeless body in my arms and cried."
    "我抱着伊娃毫无生气的身体痛哭。"

# game/episode022.rpy:1592
translate simplified_chinese ep022_petrarch_assault_e57293fa:

    # "Céline flew us back to the compound, landing near the building, but far away enough for them to be able to spot us."
    "瑟琳驾驶飞船带我们返回园区，降落在建筑附近，但保持着足够远的距离以免被他们发现。"

# game/episode022.rpy:1593
translate simplified_chinese ep022_petrarch_assault_359e70b1:

    # "Céline, Aven and I left the Bastard on foot and approached the compound."
    "瑟琳、艾文和我离开\"私生子\"号徒步前进，向园区靠近。"

# game/episode022.rpy:1595
translate simplified_chinese ep022_petrarch_assault_e0ca9663:

    # "Using binoculars we tried to determine how to enter the compound."
    "我们用望远镜试图确定进入园区的方法。"

# game/episode022.rpy:1596
translate simplified_chinese ep022_petrarch_assault_20949c14:

    # av "The entrance doesn’t seem to be crowding with soldiers."
    av "入口处似乎没有聚集太多士兵。"

# game/episode022.rpy:1597
translate simplified_chinese ep022_petrarch_assault_e0cc52fa:

    # ce "I count four of them."
    ce "我数到有四个人。"

# game/episode022.rpy:1598
translate simplified_chinese ep022_petrarch_assault_f9ee50a4:

    # c "The rest must be inside."
    c "其余的人肯定在里面。"

# game/episode022.rpy:1599
translate simplified_chinese ep022_petrarch_assault_834ea373:

    # av "We’re not going to take them all four at once, are we?"
    av "我们不会同时对付他们四个吧？"

# game/episode022.rpy:1600
translate simplified_chinese ep022_petrarch_assault_a8ab0046:

    # c "No, we should try and separate them."
    c "不，我们应该尝试将他们分开。"

# game/episode022.rpy:1601
translate simplified_chinese ep022_petrarch_assault_c8a0b9f2:

    # "We continued watching the soldiers make their patrol around the compound."
    "我们继续观察士兵们在园区周围巡逻。"

# game/episode022.rpy:1603
translate simplified_chinese ep022_petrarch_assault_ad720b98:

    # "Once we’d memorized their pattern, we started to approach the compound from the side."
    "一旦我们记住了他们的巡逻规律，我们就开始从侧面接近园区。"

# game/episode022.rpy:1604
translate simplified_chinese ep022_petrarch_assault_e72e9abb:

    # "We were just able to hide ourselves when a patrol of two soldiers rounded the corner."
    "我们刚躲藏好，一队两名士兵组成的巡逻队就拐过了转角。"

# game/episode022.rpy:1606
translate simplified_chinese ep022_petrarch_assault_fa046ee0:

    # "Hidden behind a pillar, I took a handful of gravel and threw it inside the pool of water nearby."
    "藏身在一根柱子后面，我抓起一把碎石扔进了附近的水池里。"

# game/episode022.rpy:1607
translate simplified_chinese ep022_petrarch_assault_f565010d:

    # "Just like I’d hoped, one of the soldiers made their way to the pool."
    "正如我所期望的那样，其中一个士兵朝着水池走去。"

# game/episode022.rpy:1609
translate simplified_chinese ep022_petrarch_assault_06964aee:

    # "Céline and Aven circled back to the other soldier, while I drew my knife."
    "瑟琳和艾文绕到另一个士兵身后，而我则拔出了匕首。"

# game/episode022.rpy:1611
translate simplified_chinese ep022_petrarch_assault_dedabe86:

    # "The soldier who’d remained behind was staring out over the landscape and didn’t notice Céline and Aven until they covered his mouth and stabbed him in the neck."
    "留在原地的那个士兵正眺望着风景，直到瑟琳和艾文捂住他的嘴，将匕首刺入他的脖子时才注意到他们。"

# game/episode022.rpy:1612
translate simplified_chinese ep022_petrarch_assault_b5d38404:

    # "He went down quietly, which was my cue to get into action."
    "他悄无声息地倒下了，这是我该行动的信号。"

# game/episode022.rpy:1614
translate simplified_chinese ep022_petrarch_assault_1b375db3:

    # "The other soldier was standing at the edge of the water and was about to turn around when I sprang up behind him."
    "另一个士兵站在水边，正要转身时，我从他身后猛然跃起。"

# game/episode022.rpy:1615
translate simplified_chinese ep022_petrarch_assault_4c284d97:

    # "I clamped my hand around his mouth and drew my knife across the soft fabric between his breastplate and helmet covering his throat."
    "我用手紧紧捂住他的嘴，用匕首划过他胸甲与头盔之间覆盖喉咙的柔软织物。"

# game/episode022.rpy:1616
translate simplified_chinese ep022_petrarch_assault_910d50e9:

    # "Blood pooled in the water as the soldier bled out."
    "随着士兵流血不止，鲜血在水池中汇聚成一片。"

# game/episode022.rpy:1618
translate simplified_chinese ep022_petrarch_assault_a0ec692a:

    # "I made my way back to Céline and Aven to take care of the remaining two soldiers."
    "我回到瑟琳和艾文身边，准备处理剩下的两名士兵。"

# game/episode022.rpy:1619
translate simplified_chinese ep022_petrarch_assault_0fc1ee65:

    # c "We have to move quickly, otherwise those two remaining goons are going to find their friends."
    c "我们必须迅速行动，否则剩下那两个打手会发现他们的同伙。"

# game/episode022.rpy:1621
translate simplified_chinese ep022_petrarch_assault_fb08e811:

    # "The other two soldiers were standing in front of the compound’s entrance."
    "另外两名士兵正站在建筑群入口处。"

# game/episode022.rpy:1622
translate simplified_chinese ep022_petrarch_assault_265c328e:

    # c "I’m going to distract them, go around their position and be ready to finish them off."
    c "我去引开他们，你们绕到他们侧翼，准备好解决他们。"

# game/episode022.rpy:1623
translate simplified_chinese ep022_petrarch_assault_c8dd0cbc:

    # "Céline nor Aven protested and began to sneak from our vantage point to the entrance of the compound."
    "瑟琳和艾文都没有反对，开始从我们的制高点潜行至建筑群入口。"

# game/episode022.rpy:1625
translate simplified_chinese ep022_petrarch_assault_eb14a2a3:

    # "I brandished my knife and made some noise to draw attention to myself."
    "我挥舞着匕首并制造声响来吸引注意力。"

# game/episode022.rpy:1626
translate simplified_chinese ep022_petrarch_assault_728dc737:

    # "As they turned to face my position, Aven and Céline circled round and ran up to them from behind."
    "当他们转身面对我的位置时，艾文和瑟琳从后方包抄并冲向两人。"

# game/episode022.rpy:1627
translate simplified_chinese ep022_petrarch_assault_96787061:

    # "When I saw they were in position I revealed myself just enough to get the guard’s attention."
    "看到她们就位后，我刚好暴露到足以引起守卫注意的程度。"

# game/episode022.rpy:1629
translate simplified_chinese ep022_petrarch_assault_e9cb5bc8:

    # "Before any of them could investigate the disturbance or even level their gun at me, they were stabbed by the two women."
    "还没等他们调查骚动来源甚至举枪瞄准我，这两名女子就已经捅中了他们。"

# game/episode022.rpy:1630
translate simplified_chinese ep022_petrarch_assault_068d295e:

    # "We left them to bleed out near the entrance and opened the door to the compound."
    "我们任由他们在入口附近流血致死，随后打开了建筑群的大门。"

# game/episode022.rpy:1632
translate simplified_chinese ep022_petrarch_assault_f4c63930:

    # "The corridor was deserted, so we headed inside to find out where our friends were."
    "走廊空无一人，于是我们深入内部寻找同伴的下落。"

# game/episode022.rpy:1633
translate simplified_chinese ep022_petrarch_assault_1903dc34:

    # "It didn’t take long for us to find them, as we heard familiar voices coming out the meeting room we’d used ourselves."
    "没过多久我们就找到了他们，因为我们听到了从我们曾使用过的会议室里传来的熟悉声音。"

# game/episode022.rpy:1634
translate simplified_chinese ep022_petrarch_assault_a79d0e9b:

    # "The entrance wasn’t guarded, so I sneaked toward it in order to see if everyone was accounted for."
    "入口处无人看守，于是我悄悄靠近，想确认所有人是否都在场。"

# game/episode022.rpy:1636
translate simplified_chinese ep022_petrarch_assault_fa5eb361:

    # "The entire crew was seated at the table, surrounded by guards, the Confessor and my father."
    "全体船员都围坐在桌旁，被守卫们、\"忏悔者\"以及我的父亲团团围住。"

# game/episode022.rpy:1637
translate simplified_chinese ep022_petrarch_assault_20988bb5:

    # "Eva and Lilly were spitting venom at them."
    "伊娃和莉莉正对他们恶语相向。"

# game/episode022.rpy:1638
translate simplified_chinese ep022_petrarch_assault_9976fe7f:

    # e "If you have one decent bone in your body, you’ll let us go."
    e "如果你还有一丝良知，就该放我们走。"

# game/episode022.rpy:1639
translate simplified_chinese ep022_petrarch_assault_0b9cc504:

    # l "He doesn’t, Eva."
    l "他没有良知的，伊娃。"

# game/episode022.rpy:1640
translate simplified_chinese ep022_petrarch_assault_a2b5986d:

    # l "He’s a psychopath, you must know that by now."
    l "他是个精神病患者，你现在总该明白了吧。"

# game/episode022.rpy:1642
translate simplified_chinese ep022_petrarch_assault_c3ff2905:

    # ag "Are these remarks supposed to hurt me, my daughters?"
    ag "这些话是想要伤害我吗，我的女儿们？"

# game/episode022.rpy:1643
translate simplified_chinese ep022_petrarch_assault_7f03c486:

    # l "Go fuck yourself, I’m no daughter of yours."
    l "去你妈的，我才不是你女儿。"

# game/episode022.rpy:1645
translate simplified_chinese ep022_petrarch_assault_97462fd9:

    # ag "Are these remarks supposed to hurt me, girls?"
    ag "这些话是想要伤害我吗，姑娘们？"

# game/episode022.rpy:1646
translate simplified_chinese ep022_petrarch_assault_49671c90:

    # l "Go fuck yourself."
    l "去你妈的。"

# game/episode022.rpy:1647
translate simplified_chinese ep022_petrarch_assault_826f704f:

    # ag "You always had a foul mouth, didn’t you Lilly?"
    ag "你嘴巴一直这么不干净，是吧莉莉？"

# game/episode022.rpy:1649
translate simplified_chinese ep022_petrarch_assault_17002d1e:

    # ag "I always thought you should have been more involved in their upbringing, Nadya, would you just listen to those unruly children."
    ag "我一直觉得你本该多参与管教她们的，娜迪亚，你就听听这些不听话的孩子在说什么。"

# game/episode022.rpy:1650
translate simplified_chinese ep022_petrarch_assault_a8a07555:

    # na "Fuck you, Agust."
    na "去你的，阿古斯特。"

# game/episode022.rpy:1652
translate simplified_chinese ep022_petrarch_assault_2c3716f3:

    # "I got back to Céline and Aven to relay what I’d just seen."
    "我回到瑟琳和艾文那里，转述我刚才看到的情况。"

# game/episode022.rpy:1653
translate simplified_chinese ep022_petrarch_assault_e516cbca:

    # c "Everyone is there."
    c "所有人都在那里。"

# game/episode022.rpy:1654
translate simplified_chinese ep022_petrarch_assault_7d9f6886:

    # c "Not a lot of soldiers though, so they must be elsewhere."
    c "不过士兵不多，所以他们肯定在别处。"

# game/episode022.rpy:1655
translate simplified_chinese ep022_petrarch_assault_1eac0185:

    # c "Can you disable the lift to the lower level, Céline?"
    c "你能让去往底层的电梯停运吗，瑟琳？"

# game/episode022.rpy:1656
translate simplified_chinese ep022_petrarch_assault_4fea926d:

    # ce "I think so."
    ce "我觉得可以。"

# game/episode022.rpy:1658
translate simplified_chinese ep022_petrarch_assault_d6fc1bed:

    # "We waited for her to sabotage the lift and drew our pistols when she came back."
    "我们等着她破坏电梯，等她回来时我们都拔出了手枪。"

# game/episode022.rpy:1660
translate simplified_chinese ep022_petrarch_assault_309051c0:

    # ce "Done."
    ce "完成了。"

# game/episode022.rpy:1661
translate simplified_chinese ep022_petrarch_assault_92c83e0f:

    # c "Let’s go make some noise."
    c "我们去制造点动静。"

# game/episode022.rpy:1663
translate simplified_chinese ep022_petrarch_assault_986e727d:

    # "With drawn weapons we approached the entrance of the meeting room."
    "我们举着武器走向会议室入口。"

# game/episode022.rpy:1664
translate simplified_chinese ep022_petrarch_assault_aa2778e9:

    # c "Drop your weapons!"
    c "放下武器！"

# game/episode022.rpy:1665
translate simplified_chinese ep022_petrarch_assault_717c11b5:

    # "Everyone turned toward us."
    "所有人都转向我们。"

# game/episode022.rpy:1666
translate simplified_chinese ep022_petrarch_assault_03fcaedf:

    # c "I said, drop your weapons!"
    c "我说了，放下武器！"

# game/episode022.rpy:1668
translate simplified_chinese ep022_petrarch_assault_e84642bb:

    # "Neither of the soldiers complied, so I fired on one of them."
    "两名士兵都没有服从命令，于是我朝其中一人开了枪。"

# game/episode022.rpy:1669
translate simplified_chinese ep022_petrarch_assault_dd613c07:

    # c "Drop them."
    c "放下吧。"

# game/episode022.rpy:1674
translate simplified_chinese ep022_petrarch_assault_01999ae8:

    # "The other soldier dropped his gun as his comrade crumpled to the floor."
    "另一名士兵看着同伴瘫倒在地，随即扔下了枪。"

# game/episode022.rpy:1675
translate simplified_chinese ep022_petrarch_assault_1d34bb0d:

    # "My father was smiling at me, the Confessor just stared dispassionately."
    "我父亲正对我微笑，而那位\"忏悔者\"只是冷漠地注视着。"

# game/episode022.rpy:1677
translate simplified_chinese ep022_petrarch_assault_bb8a401b:

    # ag "I knew you’d come."
    ag "我就知道你会来。"

# game/episode022.rpy:1678
translate simplified_chinese ep022_petrarch_assault_fa5c0f15:

    # ag "You and I have some unfinished business."
    ag "你我之间还有些未了之事。"

# game/episode022.rpy:1679
translate simplified_chinese ep022_petrarch_assault_2ee896ce:

    # ag "You see, I really wanted you to die, but instead you somehow survived being thrown into a vacuum."
    ag "你看，我原本真心希望你去死，可你被扔进真空居然还能活下来。"

# game/episode022.rpy:1680
translate simplified_chinese ep022_petrarch_assault_82cb511f:

    # ag "So I really want to do it right this time."
    ag "所以这次我非得亲手了结不可。"

# game/episode022.rpy:1681
translate simplified_chinese ep022_petrarch_assault_4ef26255:

    # c "Sorry to disappoint."
    c "抱歉让你失望了。"

# game/episode022.rpy:1682
translate simplified_chinese ep022_petrarch_assault_6d8c2e7b:

    # c "Also, we seem to be holding you at gunpoint, so I don’t think that plan to kill me is going to get much headway."
    c "而且，现在是我们用枪指着你，你那套杀我的计划怕是行不通了。"

# game/episode022.rpy:1683
translate simplified_chinese ep022_petrarch_assault_d8e29e17:

    # ag "Ah, but you’re gravely mistaken on that count."
    ag "啊，但这点你可大错特错了。"

# game/episode022.rpy:1685
translate simplified_chinese ep022_petrarch_assault_761985b6:

    # bl "Drop your weapons."
    bl "放下武器。"

# game/episode022.rpy:1686
translate simplified_chinese ep022_petrarch_assault_a1f3a0f6:

    # er "Don’t even think about it girl, drop that gun."
    er "别打歪主意了丫头，把枪扔掉。"

# game/episode022.rpy:1687
translate simplified_chinese ep022_petrarch_assault_5f28eb67:

    # "The Bloodhound and Erylin had entered the compound."
    "猎犬\"和艾瑞琳已经进入了建筑群。"

# game/episode022.rpy:1689
translate simplified_chinese ep022_petrarch_assault_92949007:

    # "With them was a the full contingent of soldiers Thim had mentioned."
    "和他们一起的是蒂姆提到的那支完整士兵分队。"

# game/episode022.rpy:1691
translate simplified_chinese ep022_petrarch_assault_5f1a414a:

    # "With them was a the full contingent of soldiers Raene had mentioned."
    "和他们一起的是蕾妮提到的那支完整士兵分队。"

# game/episode022.rpy:1692
translate simplified_chinese ep022_petrarch_assault_f3633e47:

    # "We had no choice but drop our weapons."
    "我们别无选择，只能放下武器。"

# game/episode022.rpy:1694
translate simplified_chinese ep022_petrarch_assault_0f160f88:

    # ag "Kvi has been lying in wait for you."
    ag "克薇一直在埋伏等你。"

# game/episode022.rpy:1695
translate simplified_chinese ep022_petrarch_assault_4444059a:

    # ag "You didn’t think you could breach our defences so easily, did you?"
    ag "你不会以为能这么轻易突破我们的防线吧？"

# game/episode022.rpy:1696
translate simplified_chinese ep022_petrarch_assault_432f830a:

    # c "You truly don’t care about human lives, do you?"
    c "你是真的不在乎人命，对吧？"

# game/episode022.rpy:1698
translate simplified_chinese ep022_petrarch_assault_64cde9c6:

    # co "Necessary sacrifices."
    co "必要的牺牲。"

# game/episode022.rpy:1700
translate simplified_chinese ep022_petrarch_assault_3dcd4406:

    # ag "I didn’t kill those soldiers outside, boy, you did."
    ag "外面那些士兵不是我杀的，小子，是你杀的。"

# game/episode022.rpy:1701
translate simplified_chinese ep022_petrarch_assault_286d27c0:

    # ag "Now, I think we’re all going on a little trip."
    ag "现在，我想我们都要去个小旅行了。"

# game/episode022.rpy:1702
translate simplified_chinese ep022_petrarch_assault_9e3147e6:

    # ag "Reunite with the rest of your crew."
    ag "去和你的船员们团聚吧。"

# game/episode022.rpy:1704
translate simplified_chinese ep022_petrarch_assault_2fdfc836:

    # l "You’ll have to find out where they are first."
    l "你得先搞清楚他们在哪儿。"

# game/episode022.rpy:1705
translate simplified_chinese ep022_petrarch_assault_7507c361:

    # ce "And we’re not talking."
    ce "而我们不会开口的。"

# game/episode022.rpy:1707
translate simplified_chinese ep022_petrarch_assault_1f6ef3cc:

    # ag "You don’t have to run that pretty little mouth at all."
    ag "你那张漂亮小嘴根本不需要说话。"

# game/episode022.rpy:1708
translate simplified_chinese ep022_petrarch_assault_64f7f84b:

    # ag "Kvi, has the tech team extracted the necessary navigational data from the rust bucket of theirs?"
    ag "克薇，技术团队从他们那堆破铜烂铁里提取出必要的导航数据了吗？"

# game/episode022.rpy:1710
translate simplified_chinese ep022_petrarch_assault_47b2fc49:

    # bl "They have."
    bl "已经提取了。"

# game/episode022.rpy:1711
translate simplified_chinese ep022_petrarch_assault_b8ffa75e:

    # ag "Excellent."
    ag "很好。"

# game/episode022.rpy:1712
translate simplified_chinese ep022_petrarch_assault_c144b826:

    # ag "Let’s go find that temple."
    ag "我们去找那座神庙。"

# game/episode022.rpy:1714
translate simplified_chinese ep022_petrarch_assault_7833b8a7:

    # "We were marched at gunpoint the the exit of the compound."
    "我们在枪口胁迫下被押往基地出口。"

# game/episode022.rpy:1715
translate simplified_chinese ep022_petrarch_assault_31c4294d:

    # "I fell in step next to Eva."
    "我走到伊娃身边与她并肩而行。"

# game/episode022.rpy:1717
translate simplified_chinese ep022_petrarch_assault_3fc15ae0:

    # c "Are you okay?"
    c "你还好吗？"

# game/episode022.rpy:1718
translate simplified_chinese ep022_petrarch_assault_071b1a8e:

    # e "I am."
    e "我没事。"

# game/episode022.rpy:1720
translate simplified_chinese ep022_petrarch_assault_d353b48b:

    # e "They roughed Thim up for hiding somewhere in the base, but he’ll live."
    e "他们因为蒂姆藏在基地某处而把他揍了一顿，不过他能活下来。"

# game/episode022.rpy:1722
translate simplified_chinese ep022_petrarch_assault_ecb826d0:

    # e "They roughed Raene up for hiding somewhere in the base, but she’ll live."
    e "他们因为蕾妮藏在基地某处而把她揍了一顿，不过她能活下来。"

# game/episode022.rpy:1723
translate simplified_chinese ep022_petrarch_assault_5595e65c:

    # e "Are Thyia and Jade nearly ready?"
    e "塞娅和杰德快准备好了吗？"

# game/episode022.rpy:1724
translate simplified_chinese ep022_petrarch_assault_21ec9701:

    # c "I hope so."
    c "希望如此。"

# game/episode022.rpy:1726
translate simplified_chinese ep022_petrarch_assault_d4a89f94:

    # "We were all pushed inside the transport which took of nearly immediately after the entry hatch closed."
    "我们全被推进运输船，入口舱门一关就立即起飞了。"

# game/episode022.rpy:1727
translate simplified_chinese ep022_petrarch_assault_1d9e2e31:

    # "The atmosphere inside the cargo hold was muted."
    "货舱里的气氛很压抑。"

# game/episode022.rpy:1728
translate simplified_chinese ep022_petrarch_assault_051fb2c2:

    # "Soldiers kept a close eye on us and didn’t tolerate any conversation."
    "士兵们紧盯着我们，不容许任何交谈。"

# game/episode022.rpy:1730
translate simplified_chinese ep022_petrarch_assault_ebd529d2:

    # "When we touched down, a squadron of soldiers rushed out of the cargo hold and entered the temple."
    "当我们降落时，一队士兵冲出货舱进入了神庙。"

# game/episode022.rpy:1731
translate simplified_chinese ep022_petrarch_assault_8dd8d17e:

    # "Agust, the Confessor, Erylin and the Bloodhound were standing in front of the temple."
    "阿古斯特、\"忏悔者\"、艾瑞琳和\"猎犬\"正站在神庙前。"

# game/episode022.rpy:1732
translate simplified_chinese ep022_petrarch_assault_5c5fe153:

    # "My father and the Confessor were obviously elated standing in the shadow of the building."
    "我父亲和\"忏悔者\"显然因站在这座建筑的阴影下而欣喜若狂。"

# game/episode022.rpy:1733
translate simplified_chinese ep022_petrarch_assault_9182c117:

    # "I didn’t share their enthusiasm."
    "我并没有他们那样的热情。"

# game/episode022.rpy:1734
translate simplified_chinese ep022_petrarch_assault_124b2362:

    # "The remaining soldiers pushed us out of the transport and dropped us in the vicinity of the temple entrance."
    "剩余的士兵将我们推出运输船，丢在寺庙入口附近。"

# game/episode022.rpy:1736
translate simplified_chinese ep022_petrarch_assault_cb87aca5:

    # "The doors opened and my heart sank."
    "大门打开时，我的心沉了下去。"

# game/episode022.rpy:1737
translate simplified_chinese ep022_petrarch_assault_65cf050c:

    # "The squadron that was sent in to secure the building dragged both Thyia and Jade outside."
    "被派去占领建筑的士兵小队将塞娅和杰德都拖到了外面。"

# game/episode022.rpy:1738
translate simplified_chinese ep022_petrarch_assault_c6effd26:

    # "One of the soldiers approached Agust and the Confessor and explained something to them."
    "其中一名士兵走近阿古斯特和\"忏悔者\"，向他们解释着什么。"

# game/episode022.rpy:1739
translate simplified_chinese ep022_petrarch_assault_54f072bb:

    # "I wished I could wipe that smug smile of my father’s face with a sledgehammer as he turned toward us."
    "当父亲转向我们时，我真希望能用大锤把他脸上那得意的笑容砸烂。"

# game/episode022.rpy:1744
translate simplified_chinese ep022_petrarch_standoff_4c99815f:

    # "We continued working on the explosives, fear for the fate of our crew dictating our every move."
    "我们继续处理炸药，对船员命运的恐惧支配着我们的一举一动。"

# game/episode022.rpy:1745
translate simplified_chinese ep022_petrarch_standoff_1ccedfa0:

    # "No further communications were received by our devices, so we had to hope for the best."
    "我们的设备没有收到任何进一步的通讯，所以我们只能往好处想。"

# game/episode022.rpy:1746
translate simplified_chinese ep022_petrarch_standoff_8c2e15d7:

    # "Together with Kit, Aven and Thyia, I was working on the last remaining bombs inside the operating theater, with Jade covering the entrance corridor."
    "我和基特、艾文以及塞娅一起，在手术室里处理最后剩下的炸弹，而杰德则负责看守入口走廊。"

# game/episode022.rpy:1747
translate simplified_chinese ep022_petrarch_standoff_72b23056:

    # "I was about to connect two wires when an unfamiliar voice barked an order."
    "我刚要连接两根电线时，一个陌生的声音厉声下达了命令。"

# game/episode022.rpy:1750
translate simplified_chinese ep022_petrarch_standoff_bdf72a2f:

    # man "Step away from the device now."
    man "立刻远离那个装置。"

# game/episode022.rpy:1751
translate simplified_chinese ep022_petrarch_standoff_90c2c337:

    # "I turned around and saw several soldiers coming up the stairs."
    "我转过身，看见几名士兵正走上楼梯。"

# game/episode022.rpy:1752
translate simplified_chinese ep022_petrarch_standoff_b3b3b88b:

    # "Two of them were holding Jade at gunpoint."
    "其中两人用枪指着杰德。"

# game/episode022.rpy:1753
translate simplified_chinese ep022_petrarch_standoff_8df7d24a:

    # man "Step away."
    man "退开。"

# game/episode022.rpy:1754
translate simplified_chinese ep022_petrarch_standoff_619ee073:

    # "We all complied."
    "我们都照做了。"

# game/episode022.rpy:1759
translate simplified_chinese ep022_petrarch_standoff_ac1ea219:

    # "The soldiers marched us out of the temple where more of them were waiting."
    "士兵押着我们走出神庙，外面有更多士兵在等候。"

# game/episode022.rpy:1760
translate simplified_chinese ep022_petrarch_standoff_ac311498:

    # "The rest of the crew was kneeling on the ground, surrounded by soldiers."
    "其他船员都跪在地上，被士兵们团团围住。"

# game/episode022.rpy:1761
translate simplified_chinese ep022_petrarch_standoff_b6b634d4:

    # "Agust and the Confessor were standing a few feet away from them, joined by Erylin and the Bloodhound Kvi."
    "阿古斯特和\"忏悔者\"站在离他们几英尺远的地方，艾瑞琳和\"猎犬\"克薇也在一旁。"

# game/episode022.rpy:1763
translate simplified_chinese ep022_petrarch_standoff_dc507e0a:

    # "My father approached as I was forced to my knees."
    "当我被迫跪下时，我的父亲走了过来。"

# game/episode022.rpy:1764
translate simplified_chinese ep022_petrarch_standoff_746cd94e:

    # ag "There you are."
    ag "你在这儿啊。"

# game/episode022.rpy:1765
translate simplified_chinese ep022_petrarch_standoff_fa5c0f15:

    # ag "You and I have some unfinished business."
    ag "我们之间还有些未了之事。"

# game/episode022.rpy:1766
translate simplified_chinese ep022_petrarch_standoff_2ee896ce:

    # ag "You see, I really wanted you to die, but instead you somehow survived being thrown into a vacuum."
    ag "你看，我本来是真想让你死的，可你被扔进真空里居然还能活下来。"

# game/episode022.rpy:1767
translate simplified_chinese ep022_petrarch_standoff_82cb511f:

    # ag "So I really want to do it right this time."
    ag "所以这次我一定要把事情办妥。"

# game/episode022.rpy:1768
translate simplified_chinese ep022_petrarch_standoff_4ef26255:

    # c "Sorry to disappoint."
    c "恐怕要让你失望了。"

# game/episode022.rpy:1770
translate simplified_chinese ep022_petrarch_standoff_362c7b4d:

    # ag "Thank you for leading us to Petrarch."
    ag "多谢你带我们找到彼特拉克。"

# game/episode022.rpy:1771
translate simplified_chinese ep022_petrarch_standoff_4ee91f08:

    # ag "We probably would have found it without your help, but you’ve made it so much easier for us."
    ag "没有你的帮助我们大概也能找到，但你确实让事情简单多了。"

# game/episode022.rpy:1773
translate simplified_chinese ep022_petrarch_standoff_c61f9e0e:

    # ag "And you brought your sister, no less."
    ag "居然还把你妹妹也带来了。"

# game/episode022.rpy:1775
translate simplified_chinese ep022_petrarch_standoff_5a847467:

    # ag "And you brought Eva, no less."
    ag "居然还把伊娃也带来了。"

