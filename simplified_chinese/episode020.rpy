# game/episode020.rpy:70
translate simplified_chinese episode020_b7e3e83f:

    # centered "{=chapter_heading}EPISODE 20{/=chapter_heading}"
    centered "{=chapter_heading}第20集{/=chapter_heading}"

# game/episode020.rpy:73
translate simplified_chinese episode020_fbc9ddd2:

    # "Over the past few days, Eva consulted with Céline and Nadya for hours on end."
    "在过去几天里，伊娃与瑟琳和娜迪亚进行了长时间的讨论。"

# game/episode020.rpy:75
translate simplified_chinese episode020_8d26ad6e:

    # "The medical staff wasn’t particularly happy with my sister exerting herself so soon after waking up, but they relented when they saw her thrive and getting healthier."
    "医护人员对我妹妹刚醒来就如此操劳并不特别满意，但看到她的状态越来越好、越来越健康，他们还是让步了。"

# game/episode020.rpy:76
translate simplified_chinese episode020_0dc94672:

    # "I’d talked to Eva a couple of times since she woke up, and while the initial mania had worn off, my sister was still determined to get to the bottom of her vision."
    "自伊娃醒来后，我和她谈过几次，虽然最初的狂热已经消退，但我妹妹仍然决心要弄清她看到的幻象的真相。"

# game/episode020.rpy:78
translate simplified_chinese episode020_b0c18d29:

    # "The medical staff wasn’t particularly happy with Eva exerting herself so soon after waking up, but they relented when they saw her thrive and getting healthier."
    "医护人员对伊娃刚醒来就如此操劳并不特别满意，但看到她的状态越来越好、越来越健康，他们还是让步了。"

# game/episode020.rpy:79
translate simplified_chinese episode020_a3070ef0:

    # "I’d talked to Eva a couple of times since she woke up, and while the initial mania had worn off, she was still determined to get to the bottom of her vision."
    "自伊娃醒来后，我和她谈过几次，虽然最初的狂热已经消退，但她仍然决心要弄清她看到的幻象的真相。"

# game/episode020.rpy:80
translate simplified_chinese episode020_233793d2:

    # "Once the doctors were satisfied Eva wasn’t going to lapse into a coma again, she was released from the medical wing and given her own room."
    "医生们确认伊娃不会再次陷入昏迷后，就让她离开了医疗区，并给了她自己的房间。"

# game/episode020.rpy:81
translate simplified_chinese episode020_7c0e4ba2:

    # "She’d asked me to come by her room, where she would explain her findings together with Céline and Nadya."
    "她邀请我去她的房间，在那里她将与瑟琳和娜迪亚一起解释她们的发现。"

# game/episode020.rpy:83
translate simplified_chinese episode020_f093dd67:

    # "They were already waiting for me as I entered."
    "我进去时，她们已经在等我了。"

# game/episode020.rpy:84
translate simplified_chinese episode020_b55f93db:

    # c "I hope I didn’t keep you waiting."
    c "希望我没有让你们久等。"

# game/episode020.rpy:86
translate simplified_chinese episode020_9e12d5e8:

    # e "Not at all."
    e "一点也不。"

# game/episode020.rpy:88
translate simplified_chinese episode020_4272adbd:

    # e "Mom was early because she still can’t believe I’m doing well."
    e "妈妈来得早是因为她还是不敢相信我恢复得这么好。"

# game/episode020.rpy:90
translate simplified_chinese episode020_dfa3d289:

    # e "Nadya was early because she still can’t believe I’m doing well."
    e "娜迪亚来得早是因为她还是不敢相信我恢复得这么好。"

# game/episode020.rpy:92
translate simplified_chinese episode020_480e8640:

    # na "I just don’t want you to exert yourself."
    na "我只是不想你太劳累。"

# game/episode020.rpy:93
translate simplified_chinese episode020_b974d0c8:

    # na "The prophecy has been a mystery for quite some time, so there’s no need to stay up late and pour over astronavigation charts."
    na "这个预言已经是个谜团很久了，没必要熬夜钻研星航图。"

# game/episode020.rpy:94
translate simplified_chinese episode020_b4826250:

    # e "Agust and the Sovereignty were quite far along figuring out everything, just before we stole the Key from under their noses."
    e "在我们从他们眼皮底下偷走钥匙之前，阿古斯特和\"至高权域\"已经快要解开所有谜题了。"

# game/episode020.rpy:95
translate simplified_chinese episode020_89fcc289:

    # e "So I disagree on the no rush."
    e "所以我不同意不用着急的说法。"

# game/episode020.rpy:96
translate simplified_chinese episode020_9139db3a:

    # na "Fair point."
    na "说得对。"

# game/episode020.rpy:97
translate simplified_chinese episode020_55a9393e:

    # na "But we did steal the Key, so that’s quite a setback."
    na "但我们的确偷走了钥匙，这对他们是个不小的打击。"

# game/episode020.rpy:98
translate simplified_chinese episode020_d2b7e233:

    # e "True, but there’s no need to get complacent."
    e "没错，但我们也不能掉以轻心。"

# game/episode020.rpy:99
translate simplified_chinese episode020_88df38a7:

    # c "Agreed."
    c "同意。"

# game/episode020.rpy:100
translate simplified_chinese episode020_6a925ba1:

    # c "So what have you all learned?"
    c "那你们都发现了什么？"

# game/episode020.rpy:101
translate simplified_chinese episode020_233cae3a:

    # e "I think we’ve found the system we need to travel to."
    e "我想我们已经找到了需要前往的星系。"

# game/episode020.rpy:103
translate simplified_chinese episode020_0f8fcd38:

    # ce "Based on Eva’s information, we were able to narrow the list of locations down to a manageable size."
    ce "根据伊娃提供的信息，我们成功将地点清单缩小到了可控范围。"

# game/episode020.rpy:104
translate simplified_chinese episode020_b98772be:

    # c "There are multiple destinations?"
    c "有多个目的地？"

# game/episode020.rpy:105
translate simplified_chinese episode020_b7bef792:

    # ce "Only likely destinations, with the candidates sharing the most similarities with Eva’s vision and the prophecy at the top."
    ce "只是可能的目的地，将最符合伊娃所见幻象和预言的候选目标排在前面。"

# game/episode020.rpy:107
translate simplified_chinese episode020_3a0c9850:

    # e "I’m convinced the system at the top is the one we’re looking for."
    e "我确信排在首位的星系就是我们要找的。"

# game/episode020.rpy:108
translate simplified_chinese episode020_9b2e6f13:

    # e "The other candidates either lack some of the characteristics, or are in already heavily populated areas."
    e "其他候选目标要么缺少某些特征，要么位于人口稠密区域。"

# game/episode020.rpy:109
translate simplified_chinese episode020_a03b4152:

    # c "So you’ve ruled out all of the inhabited planets?"
    c "所以你们排除了所有有人居住的行星？"

# game/episode020.rpy:111
translate simplified_chinese episode020_71de474d:

    # e "We did, the planet I saw in my vision was devoid of life."
    e "是的，我在幻象中看到的那颗行星毫无生命迹象。"

# game/episode020.rpy:113
translate simplified_chinese episode020_d6d1b99b:

    # ce "The most promising system is called Petrarch, it’s situated in Držić, an ancient high-redshift galaxy in Ursa Major."
    ce "最有希望的系统叫做彼特拉克，它位于德日奇，那是一个位于大熊座的古老高红移星系。"

# game/episode020.rpy:114
translate simplified_chinese episode020_58eff1e7:

    # c "Ancient?"
    c "古老？"

# game/episode020.rpy:116
translate simplified_chinese episode020_74d294b1:

    # na "Yes, billions of years old, formed when the universe was still very young."
    na "是的，有数十亿年历史，在宇宙还很年轻时形成。"

# game/episode020.rpy:118
translate simplified_chinese episode020_c1228a22:

    # e "It fits all the criteria."
    e "它符合所有标准。"

# game/episode020.rpy:119
translate simplified_chinese episode020_f70f4742:

    # e "Petrarch contains several planets, mostly gas giants and one terrestrial."
    e "彼特拉克包含几颗行星，大部分是气态巨行星，只有一颗类地行星。"

# game/episode020.rpy:120
translate simplified_chinese episode020_fd046101:

    # e "Those planets all orbit three stars."
    e "这些行星都围绕三颗恒星运行。"

# game/episode020.rpy:121
translate simplified_chinese episode020_c85ce1b8:

    # c "With you so far."
    c "目前还能跟上。"

# game/episode020.rpy:122
translate simplified_chinese episode020_0cae4ed9:

    # c "And Petrarch experienced the after effects of a star going nova?"
    c "那么彼特拉克经历过超新星爆发的余波吗？"

# game/episode020.rpy:123
translate simplified_chinese episode020_dc5b4b47:

    # e "No, we considered that."
    e "不，我们考虑过这个可能性。"

# game/episode020.rpy:124
translate simplified_chinese episode020_eb012489:

    # e "But ‘the dying light’ could also stand for something else."
    e "但\"垂死之光\"也可能代表其他含义。"

# game/episode020.rpy:126
translate simplified_chinese episode020_433e3d08:

    # ce "A dying star, for example."
    ce "比如说，一颗濒死的恒星。"

# game/episode020.rpy:128
translate simplified_chinese episode020_8e433c85:

    # e "The curious thing about the three stars of Petrarch is that they’re all dying."
    e "彼特拉克的三颗恒星有一个奇特之处，就是它们都在衰亡。"

# game/episode020.rpy:129
translate simplified_chinese episode020_8c76b7c8:

    # c "The stars are collapsing at the same time?"
    c "这些恒星正在同时坍缩？"

# game/episode020.rpy:131
translate simplified_chinese episode020_6e8fd083:

    # ce "Yes, they appear to be."
    ce "是的，看起来是这样。"

# game/episode020.rpy:132
translate simplified_chinese episode020_d3449d60:

    # c "That’s rare, isn’t it?"
    c "这很罕见，不是吗？"

# game/episode020.rpy:134
translate simplified_chinese episode020_3e9f9002:

    # ce "Rare, but not unheard of."
    ce "罕见，但并非闻所未闻。"

# game/episode020.rpy:136
translate simplified_chinese episode020_8731a38a:

    # e "It all fits, [p_name_short]."
    e "这一切都对得上，[p_name_short]。"

# game/episode020.rpy:137
translate simplified_chinese episode020_8b00435a:

    # e "I think this is the place we need to go to."
    e "我认为这就是我们需要去的地方。"

# game/episode020.rpy:138
translate simplified_chinese episode020_ee2bf491:

    # c "It’s worth a shot."
    c "值得一试。"

# game/episode020.rpy:139
translate simplified_chinese episode020_19337a7f:

    # c "Let’s do it then, as soon as you’re fit enough to leave."
    c "那我们就行动吧，等你身体恢复得可以出发时。"

# game/episode020.rpy:141
translate simplified_chinese episode020_d7a7e324:

    # na "There’s a but."
    na "但是有个问题。"

# game/episode020.rpy:142
translate simplified_chinese episode020_c7a1defc:

    # c "There always is."
    c "总是会有问题。"

# game/episode020.rpy:144
translate simplified_chinese episode020_3b37783a:

    # na "According to Thyia, the systems neighboring Petrarch are a notorious mess."
    na "据塞娅所说，彼特拉克周边的星系臭名昭著地混乱。"

# game/episode020.rpy:145
translate simplified_chinese episode020_363a544c:

    # na "Several of Petrarch’s neighbors are at war with each other and because of the chaos there’s rampant piracy."
    na "彼特拉克的几个邻国正在互相交战，由于这种混乱局面，海盗活动十分猖獗。"

# game/episode020.rpy:147
translate simplified_chinese episode020_885b6596:

    # na "The few remaining trade ships that were willing to deal with the warlords and the pirates halted operations years ago."
    na "少数还愿意与军阀和海盗打交道的贸易船早在几年前就停止了运营。"

# game/episode020.rpy:148
translate simplified_chinese episode020_dab698e2:

    # c "How come?"
    c "怎么回事？"

# game/episode020.rpy:150
translate simplified_chinese episode020_6ec0b88f:

    # ce "Probably because several ships were sent back to their owners flying on autopilot and every single member of the crew dismembered."
    ce "可能是因为有几艘船被自动导航送回给船主，而船上的每个船员都被肢解了。"

# game/episode020.rpy:151
translate simplified_chinese episode020_128a100d:

    # ce "Most shipping companies might care little for the personal welfare of their employees, but before long they had trouble even finding crew members willing to make the journey."
    ce "大多数航运公司可能不太关心员工的个人福利，但没过多久他们就很难找到愿意执行这段航程的船员了。"

# game/episode020.rpy:152
translate simplified_chinese episode020_87563436:

    # c "I guess they started to care after that."
    c "我猜在那之后他们开始在意了。"

# game/episode020.rpy:154
translate simplified_chinese episode020_c43a6cba:

    # ce "They sure did."
    ce "他们确实在意了。"

# game/episode020.rpy:155
translate simplified_chinese episode020_29cfb54b:

    # c "You’ve spoken to Thyia about all this, Nadya?"
    c "你把这些都跟塞娅说过了吗，娜迪亚？"

# game/episode020.rpy:157
translate simplified_chinese episode020_57e6ff21:

    # na "I did, yes."
    na "是的，我说了。"

# game/episode020.rpy:158
translate simplified_chinese episode020_170f2a33:

    # c "So she’s familiar with the situation there?"
    c "所以她熟悉那边的情况？"

# game/episode020.rpy:160
translate simplified_chinese episode020_2c274c5b:

    # na "Not exactly, but she knows of the situation."
    na "不完全是，但她知道那个情况。"

# game/episode020.rpy:161
translate simplified_chinese episode020_6b6d0156:

    # na "You should speak to her and see if she has any more details."
    na "你应该跟她谈谈，看看她有没有更多细节。"

# game/episode020.rpy:162
translate simplified_chinese episode020_255ecca1:

    # c "I will."
    c "我会的。"

# game/episode020.rpy:164
translate simplified_chinese episode020_87c7c811:

    # e "But we’re going, right?"
    e "但我们还是要去的，对吧？"

# game/episode020.rpy:165
translate simplified_chinese episode020_132c0d7c:

    # c "Yes, we are, even if we have to hire a personal army to get us through that place."
    c "是的，我们要去，即使我们得雇一支私人军队才能通过那个地方。"

# game/episode020.rpy:166
translate simplified_chinese episode020_810bfab1:

    # c "But we need some more intel first."
    c "但我们首先需要更多情报。"

# game/episode020.rpy:167
translate simplified_chinese episode020_068119dd:

    # c "I’ll speak to Thyia and maybe Jade can rummage the net to see if there’s anything on Petrarch and the adjoining systems?"
    c "我会跟塞娅谈谈，也许杰德可以在网上搜搜看有没有关于彼特拉克和邻近星系的任何信息？"

# game/episode020.rpy:169
translate simplified_chinese episode020_0a6c3489:

    # ce "Good idea, I’ll ask her."
    ce "好主意，我去问问她。"

# game/episode020.rpy:189
translate simplified_chinese episode020_20594b6f:

    # mod "Would you like to see Jade's submissive scenes along with romance ones? Mainly for exclusive scenes, main dialogue will stay the same."
    mod "你想看杰德的顺从场景和浪漫场景吗？主要是专属场景，主要对话会保持不变。"

# game/episode020.rpy:273
translate simplified_chinese ep020_paclerara_departure_cd291b8b:

    # "Over the course of several days, our strategy for getting into Petrarch territory had become much clearer."
    "经过几天的筹划，我们进入彼特拉克领地的策略变得清晰多了。"

# game/episode020.rpy:274
translate simplified_chinese ep020_paclerara_departure_e071480d:

    # "Everyone was in agreement that we should take up the bounty Jade had found and try to bargain our way through the contested space surrounding Petrarch."
    "所有人都同意我们应该接下杰德找到的悬赏任务，尝试通过谈判穿越彼特拉克周边的争议空域。"

# game/episode020.rpy:275
translate simplified_chinese ep020_paclerara_departure_12109f2f:

    # "Thyia was in charge of reaching out to the pirate band that had posted the bounty."
    "塞娅负责联系发布悬赏的海盗团伙。"

# game/episode020.rpy:276
translate simplified_chinese ep020_paclerara_departure_5b70afef:

    # "Late during the day, Thyia messaged to tell me she’d made some progress."
    "当天傍晚，塞娅发来消息说她已经取得了一些进展。"

# game/episode020.rpy:278
translate simplified_chinese ep020_paclerara_departure_b8393557:

    # "I went to see her together with Eva on the landing pad where the Bastard was parked."
    "我和伊娃一起来到停放\"私生子\"号的起降坪找她。"

# game/episode020.rpy:279
translate simplified_chinese ep020_paclerara_departure_4c39030f:

    # c "Have they agreed to meet us?"
    c "他们同意和我们见面了吗？"

# game/episode020.rpy:281
translate simplified_chinese ep020_paclerara_departure_ff50648b:

    # th "They have."
    th "同意了。"

# game/episode020.rpy:282
translate simplified_chinese ep020_paclerara_departure_64b4acda:

    # th "We are to meet the pirate queen Xile and her fleet at the coordinates they’ve sent us."
    th "我们要在他们发送的坐标处与海盗女王希勒及其舰队会面。"

# game/episode020.rpy:284
translate simplified_chinese ep020_paclerara_departure_7424152d:

    # e "Are we to discuss terms with them?"
    e "我们要和他们谈判条件吗？"

# game/episode020.rpy:286
translate simplified_chinese ep020_paclerara_departure_fd3c3bb3:

    # th "I reckon so."
    th "我想是的。"

# game/episode020.rpy:287
translate simplified_chinese ep020_paclerara_departure_d26c58dd:

    # c "Do you know anything about this Xile?"
    c "你对这个希勒了解多少？"

# game/episode020.rpy:288
translate simplified_chinese ep020_paclerara_departure_fe4086d1:

    # th "Not much."
    th "不太多。"

# game/episode020.rpy:289
translate simplified_chinese ep020_paclerara_departure_f1f5a9ed:

    # th "She’s been queen for quite a long time and seems fair and evenhanded, as far as pirates go."
    th "她当女王已经很久了，就海盗而言，她似乎还算公正公平。"

# game/episode020.rpy:290
translate simplified_chinese ep020_paclerara_departure_5fdec604:

    # c "So, less of a psycho compared to most of them."
    c "所以，比起大多数海盗，她没那么神经质。"

# game/episode020.rpy:291
translate simplified_chinese ep020_paclerara_departure_6e8fc06a:

    # c "That’s got to count for something."
    c "这总归是件好事。"

# game/episode020.rpy:293
translate simplified_chinese ep020_paclerara_departure_88f19a75:

    # th "Quite right."
    th "说得对。"

# game/episode020.rpy:295
translate simplified_chinese ep020_paclerara_departure_2b608244:

    # e "We’ll be leaving shortly then?"
    e "那我们很快就要出发了？"

# game/episode020.rpy:296
translate simplified_chinese ep020_paclerara_departure_cc5c7e87:

    # c "Yes, let’s round up the others and tell them we’ll leave paradise."
    c "是的，我们去召集其他人，告诉他们要离开这个天堂了。"

# game/episode020.rpy:315
translate simplified_chinese ep020_paclerara_departure_9b6bf3aa:

    # "I returned to my bedroom to tell Raene we were leaving."
    "我回到卧室告诉蕾妮我们要离开了。"

# game/episode020.rpy:316
translate simplified_chinese ep020_paclerara_departure_b0154d87:

    # "Entering the room I immediately felt something was amiss."
    "一进房间我就感觉有些不对劲。"

# game/episode020.rpy:317
translate simplified_chinese ep020_paclerara_departure_d9ea7f40:

    # c "Raene?"
    c "蕾妮？"

# game/episode020.rpy:319
translate simplified_chinese ep020_paclerara_departure_5e3eb0be:

    # "The balcony and bathroom were empty."
    "阳台和浴室都空无一人。"

# game/episode020.rpy:320
translate simplified_chinese ep020_paclerara_departure_194f8173:

    # "There were no signs of struggle, but Raene’s absence triggered an instant panic."
    "没有任何打斗的痕迹，但蕾妮的失踪立刻让我惊慌起来。"

# game/episode020.rpy:322
translate simplified_chinese ep020_paclerara_departure_b36994dc:

    # "I messaged every crew member to ask them if they had been in contact with Raene."
    "我给所有船员发了信息，询问他们是否与蕾妮有过联系。"

# game/episode020.rpy:323
translate simplified_chinese ep020_paclerara_departure_f258c9fe:

    # "Nobody had heard anything from her in the past few hours."
    "过去几小时里没人听到过她的任何消息。"

# game/episode020.rpy:324
translate simplified_chinese ep020_paclerara_departure_982a67fc:

    # "I asked Jade to come to my room."
    "我让杰德来我房间一趟。"

# game/episode020.rpy:326
translate simplified_chinese ep020_paclerara_departure_ece09f3d:

    # "While she was on her way, I donned my armor and checked my weapon."
    "在她过来的路上，我穿上护甲并检查了武器。"

# game/episode020.rpy:328
translate simplified_chinese ep020_paclerara_departure_82ab2dcc:

    # j "Did something bad happen to Raene?"
    j "蕾妮是不是遭遇了什么不测？"

# game/episode020.rpy:329
translate simplified_chinese ep020_paclerara_departure_aa6ff30f:

    # c "I’m not sure, but she wouldn’t leave this room willingly."
    c "我不确定，但她不会自愿离开这个房间。"

# game/episode020.rpy:330
translate simplified_chinese ep020_paclerara_departure_19c0334d:

    # c "There are clerics from her father’s church here and they might know she’s here."
    c "她父亲教会的牧师们就在这儿，他们可能知道她在这里。"

# game/episode020.rpy:332
translate simplified_chinese ep020_paclerara_departure_fc96c41b:

    # j "Would she open the door for them?"
    j "她会给他们开门吗？"

# game/episode020.rpy:333
translate simplified_chinese ep020_paclerara_departure_16932397:

    # c "Absolutely not."
    c "绝对不会。"

# game/episode020.rpy:334
translate simplified_chinese ep020_paclerara_departure_a0979f88:

    # c "But they might have tricked her."
    c "但他们可能骗了她。"

# game/episode020.rpy:335
translate simplified_chinese ep020_paclerara_departure_efbd6a7e:

    # c "Can you find out where those clerics are staying in the Residence?"
    c "你能查出来那些牧师在官邸的住处吗？"

# game/episode020.rpy:337
translate simplified_chinese ep020_paclerara_departure_2ea23ada:

    # j "Of course, I’ll get right on it."
    j "当然，我马上就去查。"

# game/episode020.rpy:339
translate simplified_chinese ep020_paclerara_departure_e2d5ce36:

    # "Jade hooked her tablet into the Residence network and started typing furiously."
    "杰德将她的平板电脑接入官邸网络，开始疯狂打字。"

# game/episode020.rpy:340
translate simplified_chinese ep020_paclerara_departure_4ad5e2c8:

    # "I paced the room, trying not to let my worries get the upper hand."
    "我在房间里踱步，努力不让担忧占据上风。"

# game/episode020.rpy:341
translate simplified_chinese ep020_paclerara_departure_907db104:

    # "After an agonizing half hour Jade looked up at me in triumph."
    "经过煎熬的半小时后，杰德得意地抬头看向我。"

# game/episode020.rpy:343
translate simplified_chinese ep020_paclerara_departure_b0925680:

    # j "Got it!"
    j "知道了！"

# game/episode020.rpy:344
translate simplified_chinese ep020_paclerara_departure_26801211:

    # j "They’re staying on the fifth floor of the Residence, room 5038."
    j "他们住在官邸五层，5038房间。"

# game/episode020.rpy:346
translate simplified_chinese ep020_paclerara_departure_8df3d61a:

    # j "I’ve also found an incident report from that same floor."
    j "我还找到了同一层的突发事件报告。"

# game/episode020.rpy:347
translate simplified_chinese ep020_paclerara_departure_e7bbbaaa:

    # j "The management of the Residence was alerted by one of the guests about a disturbance earlier today."
    j "官邸管理处今天早些时候接到某位住客的警报说发生骚乱。"

# game/episode020.rpy:348
translate simplified_chinese ep020_paclerara_departure_221ff76d:

    # j "Someone complaining about shouting in the hallway."
    j "有人投诉走廊里有叫喊声。"

# game/episode020.rpy:349
translate simplified_chinese ep020_paclerara_departure_838256c8:

    # j "When they went to check it out the shouting had stopped."
    j "等他们去查看时，喊叫声已经停止了。"

# game/episode020.rpy:350
translate simplified_chinese ep020_paclerara_departure_1ec4b2e4:

    # c "Those fuckers!"
    c "那些混蛋！"

# game/episode020.rpy:351
translate simplified_chinese ep020_paclerara_departure_0b8b92a5:

    # c "I’m going to have a conversation with them..."
    c "我要去跟他们谈谈…"

# game/episode020.rpy:352
translate simplified_chinese ep020_paclerara_departure_147fa014:

    # c "Alert the others and tell them we might need to leave in a hurry."
    c "通知其他人，告诉他们我们可能需要紧急撤离。"

# game/episode020.rpy:354
translate simplified_chinese ep020_paclerara_departure_6214d03c:

    # j "Do you need backup?"
    j "需要支援吗？"

# game/episode020.rpy:355
translate simplified_chinese ep020_paclerara_departure_e66c9b2c:

    # c "Yes, send Aven and Kit to the fifth floor, armed and suited up."
    c "是的，派艾文和基特去五楼，全副武装穿戴好装备。"

# game/episode020.rpy:356
translate simplified_chinese ep020_paclerara_departure_936de881:

    # c "Could you open the door for me remotely as soon as I’m on the fifth floor?"
    c "等我到五楼后，你能远程帮我开门吗？"

# game/episode020.rpy:358
translate simplified_chinese ep020_paclerara_departure_e8462428:

    # j "Got it."
    j "明白。"

# game/episode020.rpy:360
translate simplified_chinese ep020_paclerara_departure_a59c5cb2:

    # j "Good luck, [p_name]."
    j "祝你好运，[p_name]。"

# game/episode020.rpy:362
translate simplified_chinese ep020_paclerara_departure_8a5c331b:

    # j "Good luck, [p_name_short]."
    j "祝你好运，[p_name_short]。"

# game/episode020.rpy:363
translate simplified_chinese ep020_paclerara_departure_7d7a13b3:

    # "Leaving Jade behind, I sped through the corridors of the Residence to one of the elevators."
    "把杰德留在身后，我快速穿过住宅区的走廊来到其中一部电梯前。"

# game/episode020.rpy:365
translate simplified_chinese ep020_paclerara_departure_f106f196:

    # "The elevator took me up to the fifth floor, revealing a similar hallway."
    "电梯载着我升到五楼，露出了相似的走廊。"

# game/episode020.rpy:366
translate simplified_chinese ep020_paclerara_departure_b8800ba2:

    # "Room 5038 was near the end of the corridor."
    "5038号房就在走廊尽头附近。"

# game/episode020.rpy:368
translate simplified_chinese ep020_paclerara_departure_93c03ce3:

    # "I messaged Jade that I was in position and ready for her to open the door."
    "我发信息给杰德告诉她我已就位，准备让她开门。"

# game/episode020.rpy:369
translate simplified_chinese ep020_paclerara_departure_9a551b96:

    # "After a minute the door slid open, I pulled my gun and prepared to step inside."
    "一分钟后门滑开了，我拔出枪准备走进去。"

# game/episode020.rpy:371
translate simplified_chinese ep020_paclerara_departure_e1db797e:

    # man "Who’s there?"
    man "谁在那里？"

# game/episode020.rpy:373
translate simplified_chinese ep020_paclerara_departure_0e37e0b2:

    # "One of the clerics came to check on the door and suddenly stared into the barrel of my gun."
    "其中一名教士过来检查门，突然就瞪着我黑洞洞的枪口。"

# game/episode020.rpy:374
translate simplified_chinese ep020_paclerara_departure_6eff4eb3:

    # c "Hands up where I can see them."
    c "把手举到我看见的地方。"

# game/episode020.rpy:375
translate simplified_chinese ep020_paclerara_departure_48c678cf:

    # c "Slowly turn around and take me to the others."
    c "慢慢转过身，带我去见其他人。"

# game/episode020.rpy:377
translate simplified_chinese ep020_paclerara_departure_229a2e07:

    # "The cleric complied and led me to the living area."
    "教士依言照做，领着我来到起居区。"

# game/episode020.rpy:378
translate simplified_chinese ep020_paclerara_departure_82a5c493:

    # "I couldn’t suppress a sigh of relief when I saw Raene sitting on the couch unharmed."
    "当我看到蕾妮安然无恙地坐在沙发上时，不禁松了口气。"

# game/episode020.rpy:379
translate simplified_chinese ep020_paclerara_departure_4f792e40:

    # "She was surrounded by the other two clerics and looking at the video screen on the opposite wall."
    "她被另外两名教士围着，正望着对面墙上的显示屏。"

# game/episode020.rpy:381
translate simplified_chinese ep020_paclerara_departure_8b24ee79:

    # "A familiar face was apparently having a one-sided chat with Raene."
    "一个熟悉的面孔显然正在对蕾妮进行单向对话。"

# game/episode020.rpy:382
translate simplified_chinese ep020_paclerara_departure_64bfc918:

    # sa "You are to return with Father Morray."
    sa "你要和莫雷神父一起回来。"

# game/episode020.rpy:383
translate simplified_chinese ep020_paclerara_departure_74cc63f0:

    # sa "As soon as you’re home, we’ll be able to reverse the dreadful things you’ve done to yourself."
    sa "等你一回家，我们就能逆转你对自己做的这些可怕事情。"

# game/episode020.rpy:384
translate simplified_chinese ep020_paclerara_departure_c4e61ee4:

    # sa "And begin your re-education, of course."
    sa "当然，还要开始你的再教育。"

# game/episode020.rpy:385
translate simplified_chinese ep020_paclerara_departure_51321de4:

    # sa "I can’t belief my very own son has strayed so far from the righteous path."
    sa "我不敢相信我的亲生儿子竟然偏离正道如此之远。"

# game/episode020.rpy:387
translate simplified_chinese ep020_paclerara_departure_0d365eea:

    # ra "I’m not your son and I haven’t strayed."
    ra "我不是你的儿子，我也没有偏离正道。"

# game/episode020.rpy:388
translate simplified_chinese ep020_paclerara_departure_e46011f2:

    # ra "I’m finally the person who I want to be."
    ra "我终于成为了我想成为的人。"

# game/episode020.rpy:390
translate simplified_chinese ep020_paclerara_departure_1d27e859:

    # sa "Don’t talk nonsense, Arion."
    sa "别胡说八道，阿里昂。"

# game/episode020.rpy:392
translate simplified_chinese ep020_paclerara_departure_6cdc2a40:

    # ra "That’s not my name!"
    ra "那不是我的名字！"

# game/episode020.rpy:394
translate simplified_chinese ep020_paclerara_departure_6c14cee4:

    # sa "It is, boy, do not delude yourself."
    sa "就是的，小子，别自欺欺人了。"

# game/episode020.rpy:395
translate simplified_chinese ep020_paclerara_departure_15da3c30:

    # sa "Don’t tell me you’re still calling yourself that name you’ve invented for yourself."
    sa "别告诉我你还在用自己编造的那个名字。"

# game/episode020.rpy:396
translate simplified_chinese ep020_paclerara_departure_d69ec423:

    # sa "The one that so clearly defiles the given name of my dearly departed wife Raenata."
    sa "那个明显亵渎了我已故爱妻蕾娜塔所赐名字的称呼。"

# game/episode020.rpy:398
translate simplified_chinese ep020_paclerara_departure_a01360ce:

    # ra "Mother supported me, she would have been proud of me!"
    ra "母亲支持过我，她会为我感到骄傲的！"

# game/episode020.rpy:400
translate simplified_chinese ep020_paclerara_departure_777f6567:

    # sa "That’s quite enough, Arion."
    sa "够了，阿里昂。"

# game/episode020.rpy:401
translate simplified_chinese ep020_paclerara_departure_dc409cc7:

    # sa "God granted us a son and the things you’ve done to yourself are an affront to His Good Works as well as the love we’ve given you over the years."
    sa "上帝赐予我们一个儿子，而你对自己所做的这些事，不仅亵渎了祂的杰作，也辜负了我们多年来给予你的爱。"

# game/episode020.rpy:403
translate simplified_chinese ep020_paclerara_departure_bb780236:

    # ra "I don’t-"
    ra "我不—"

# game/episode020.rpy:405
translate simplified_chinese ep020_paclerara_departure_dda8f63d:

    # sa "Silence, Arion!"
    sa "住口，阿里昂！"

# game/episode020.rpy:406
translate simplified_chinese ep020_paclerara_departure_31c97456:

    # sa "You will obey your father!"
    sa "你必须服从你的父亲！"

# game/episode020.rpy:408
translate simplified_chinese ep020_paclerara_departure_6d5b6272:

    # c "If you speak that name again I’ll be forced to shoot one of your altar boys in the head, Sacleus."
    c "如果你再敢说出那个名字，我就不得不朝你那位祭坛侍童的脑袋开枪了，萨克莱斯。"

# game/episode020.rpy:409
translate simplified_chinese ep020_paclerara_departure_d667636e:

    # "Everyone had their eyes glued to the video screen before, so they only noticed me standing in the room as I spoke."
    "之前所有人的目光都紧盯着视频屏幕，所以直到我开口说话，他们才注意到我站在房间里。"

# game/episode020.rpy:411
translate simplified_chinese ep020_paclerara_departure_96d563f1:

    # ra "[p_name_short]!"
    ra "[p_name_short]!"

# game/episode020.rpy:412
translate simplified_chinese ep020_paclerara_departure_7c294a9f:

    # sa "What’s the meaning of this?"
    sa "这是什么意思？"

# game/episode020.rpy:413
translate simplified_chinese ep020_paclerara_departure_ebea6ff7:

    # sa "Is this the heretic who led you astray?"
    sa "这就是那个让你误入歧途的异教徒吗？"

# game/episode020.rpy:414
translate simplified_chinese ep020_paclerara_departure_98c7c822:

    # sa "Seize him!"
    sa "抓住他！"

# game/episode020.rpy:415
translate simplified_chinese ep020_paclerara_departure_9f2ae320:

    # c "I wouldn’t do that, if I were you."
    c "如果我是你，就不会那么做。"

# game/episode020.rpy:416
translate simplified_chinese ep020_paclerara_departure_60353569:

    # "Both clerics were aware of the gun trained on the back of their colleague’s head and hesitated."
    "两位牧师都意识到有枪正对准他们同僚的后脑勺，不禁犹豫起来。"

# game/episode020.rpy:417
translate simplified_chinese ep020_paclerara_departure_a22550b0:

    # c "You’ve taken Raene against her will with the intent to ship her off this planet."
    c "你们违背蕾妮的意愿将她带走，企图将她运离这个星球。"

# game/episode020.rpy:418
translate simplified_chinese ep020_paclerara_departure_2a030f06:

    # c "I’m sure the Residence officials will be very interested to learn about what happened here."
    c "我相信行政官员们会对此地发生的事情很感兴趣。"

# game/episode020.rpy:420
translate simplified_chinese ep020_paclerara_departure_654e9348:

    # sa "It’s my blood you’re talking about, I have every right to-"
    sa "你们谈论的是我的血脉，我完全有权利—"

# game/episode020.rpy:421
translate simplified_chinese ep020_paclerara_departure_47977152:

    # c "Judging from the way you were just talking to her, I’d say you have very little respect for Raene."
    c "从你刚才对她说话的方式来看，我觉得你根本不尊重蕾妮。"

# game/episode020.rpy:422
translate simplified_chinese ep020_paclerara_departure_f021c479:

    # c "And I’m very sure she doesn’t want to be reunited with you."
    c "而且我非常确定她不想与你团聚。"

# game/episode020.rpy:423
translate simplified_chinese ep020_paclerara_departure_b1ff5e70:

    # c "Am I correct, Raene?"
    c "我说得对吗，蕾妮？"

# game/episode020.rpy:425
translate simplified_chinese ep020_paclerara_departure_2dc56006:

    # ra "No, I don’t want to go back to my father."
    ra "不，我不想回到父亲身边。"

# game/episode020.rpy:427
translate simplified_chinese ep020_paclerara_departure_ff4787dc:

    # sa "You’ve corrupted him!"
    sa "你把他给带坏了！"

# game/episode020.rpy:428
translate simplified_chinese ep020_paclerara_departure_2015fd33:

    # sa "Tempted him with your wicked sinful ways!"
    sa "用你邪恶堕落的方式诱惑了他！"

# game/episode020.rpy:429
translate simplified_chinese ep020_paclerara_departure_b3f912b1:

    # c "I’m sure you believe that."
    c "我相信你是这么认为的。"

# game/episode020.rpy:430
translate simplified_chinese ep020_paclerara_departure_ef1adb1a:

    # c "I call it loving someone."
    c "我称之为爱一个人。"

# game/episode020.rpy:431
translate simplified_chinese ep020_paclerara_departure_0f0ad03b:

    # c "Here’s what’s going to happen though."
    c "不过接下来会这样发展。"

# game/episode020.rpy:432
translate simplified_chinese ep020_paclerara_departure_d9fc4d91:

    # c "I’m going to walk out with Raene unharmed and you will not pursue us."
    c "我会带着安然无恙的蕾妮离开，你们不得追击。"

# game/episode020.rpy:433
translate simplified_chinese ep020_paclerara_departure_241b344c:

    # c "If you do, I’ll make sure to kill you three and make a convincing case of it being self-defence."
    c "如果你们敢追，我保证会杀了你们三个，并完美伪装成正当防卫。"

# game/episode020.rpy:435
translate simplified_chinese ep020_paclerara_departure_16c45d30:

    # av "Are you okay in there?"
    av "你还好吗？"

# game/episode020.rpy:436
translate simplified_chinese ep020_paclerara_departure_40e80566:

    # c "Backup has also just arrived."
    c "支援也刚好到了。"

# game/episode020.rpy:437
translate simplified_chinese ep020_paclerara_departure_ebe16fee:

    # c "I think it’s time to go, Raene."
    c "我想是时候离开了，蕾妮。"

# game/episode020.rpy:439
translate simplified_chinese ep020_paclerara_departure_0b760eba:

    # "Raene got up and neither of the two clerics prevented her from walking toward me."
    "蕾妮站起身，两名祭司都没有阻止她走向我。"

# game/episode020.rpy:440
translate simplified_chinese ep020_paclerara_departure_0927ad9d:

    # sa "Get back here at once!"
    sa "马上给我回来！"

# game/episode020.rpy:441
translate simplified_chinese ep020_paclerara_departure_c29b2ad9:

    # sa "You belong with me!"
    sa "你属于我！"

# game/episode020.rpy:443
translate simplified_chinese ep020_paclerara_departure_675feea1:

    # ra "No, I do not."
    ra "不，我不属于。"

# game/episode020.rpy:444
translate simplified_chinese ep020_paclerara_departure_2dcd7e61:

    # ra "You’ve never respected the person I am and judging from the way you’ve treated me just now, you never will."
    ra "你从未尊重过真实的我，从你刚才对待我的方式来看，你永远也不会尊重我。"

# game/episode020.rpy:445
translate simplified_chinese ep020_paclerara_departure_9e2e746f:

    # ra "I don’t want to see you ever again, father."
    ra "我再也不想见到你了，父亲。"

# game/episode020.rpy:446
translate simplified_chinese ep020_paclerara_departure_439802a1:

    # ra "Goodbye."
    ra "再见。"

# game/episode020.rpy:448
translate simplified_chinese ep020_paclerara_departure_5481f9d2:

    # "Protected by Aven, Kit and me, Raene walked out of the room, her head held high."
    "在艾文、基特和我的保护下，蕾妮昂首挺胸地走出了房间。"

# game/episode020.rpy:449
translate simplified_chinese ep020_paclerara_departure_bfb2520b:

    # "Sacleus could still be heard raging inside the room."
    "仍能听到萨克莱斯在房间里大发雷霆。"

# game/episode020.rpy:451
translate simplified_chinese ep020_paclerara_departure_594bc868:

    # c "That was very brave of you."
    c "你非常勇敢。"

# game/episode020.rpy:452
translate simplified_chinese ep020_paclerara_departure_a8ebf496:

    # ra "I was scared to death."
    ra "我吓得要死。"

# game/episode020.rpy:454
translate simplified_chinese ep020_paclerara_departure_3e72eda9:

    # ra "Still, I felt it had to be said."
    ra "尽管如此，我觉得这些话必须说出来。"

# game/episode020.rpy:455
translate simplified_chinese ep020_paclerara_departure_85021674:

    # c "It sure did."
    c "确实如此。"

# game/episode020.rpy:457
translate simplified_chinese ep020_paclerara_departure_6ca20477:

    # ra "It won’t change my father’s opinion though."
    ra "但这并不会改变我父亲的看法。"

# game/episode020.rpy:458
translate simplified_chinese ep020_paclerara_departure_49d06e6c:

    # c "It probably won’t, but that wasn’t the point."
    c "大概不会，但重点不在这里。"

# game/episode020.rpy:460
translate simplified_chinese ep020_paclerara_departure_67df49a2:

    # ra "No, I think you’re right."
    ra "不，我觉得你说得对。"

# game/episode020.rpy:462
translate simplified_chinese ep020_paclerara_departure_93bb2d8c:

    # av "The Bastard is waiting for us on the landing pad."
    av "\"私生子\"号正在着陆坪等着我们。"

# game/episode020.rpy:463
translate simplified_chinese ep020_paclerara_departure_45930ac3:

    # c "Do you need anything from your room, Raene?"
    c "雷恩，你需要从房间里拿什么东西吗？"

