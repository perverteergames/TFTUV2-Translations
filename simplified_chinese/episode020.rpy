    # c "Bye Céline."
    c "再见瑟琳。"

# game/episode020.rpy:947
translate simplified_chinese ep020_paclerara_celine_b2c8e445:

    # ce "Bye [p_name_short]."
    ce "再见[p_name_short]。"

# game/episode020.rpy:954
