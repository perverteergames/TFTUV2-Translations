    # c "Almost?"
    c "几乎？"

# game/episode020.rpy:959
translate simplified_chinese ep020_paclerara_thyia_87cfb681:

    # th "There’s always room for improvement."
    th "总有改进的空间。"

# game/episode020.rpy:960
