# game/episode014_conversations.rpy:438
translate simplified_chinese ep014_aven_foreplay_70ca9880:

    # "When I couldn’t hear the three girls talking in the hallway anymore, I quietly left my girlfriend’s quarters and headed back to my own."
    "当我再也听不到走廊里三个女孩的谈话声时，我悄悄离开女友的房间，回到了自己的住处。"

# game/episode014_conversations.rpy:446
translate simplified_chinese ep014_vess_talk_7056f99c:

    # "After bringing the crew up to speed on my decision regarding Vess, I headed back to the brig."
    "在向船员们通报了我关于薇丝的决定后，我回到了禁闭室。"

# game/episode014_conversations.rpy:449
translate simplified_chinese ep014_vess_talk_d4fad8f7:

    # ve "Back already, master?"
    ve "这么快就回来了，主人？"

# game/episode014_conversations.rpy:450
translate simplified_chinese ep014_vess_talk_60f9a633:

    # c "Yes, the others have been brought up to speed."
    c "是的，其他人已经了解情况了。"

# game/episode014_conversations.rpy:451
translate simplified_chinese ep014_vess_talk_b7992689:

    # c "Not everyone agreed, but they consented after I assured them you’ll be watched at all times."
    c "不是所有人都同意，但我向他们保证你会被全天候监视后，他们都同意了。"

# game/episode014_conversations.rpy:452
translate simplified_chinese ep014_vess_talk_388e157f:

    # c "Your place is in my quarters from now on, and you’ll make yourself available when I call on you."
    c "从现在起你的位置就在我的房间里，我召唤你的时候你要随时待命。"

# game/episode014_conversations.rpy:454
translate simplified_chinese ep014_vess_talk_5e2b29b5:

    # ve "Yes, master."
    ve "是，主人。"

# game/episode014_conversations.rpy:456
translate simplified_chinese ep014_vess_talk_e43ceeef:

    # c "Jade will continue to serve me, your new role will not change any of that."
    c "杰德将继续为我服务，你的新角色不会改变这一点。"

# game/episode014_conversations.rpy:457
translate simplified_chinese ep014_vess_talk_3ed5ba9a:

    # c "However, she’ll be your superior, so make sure you obey her every wish and remember to stay on her good side."
    c "不过，她会成为你的上级，所以务必遵从她的每个意愿，记住要维持她的好感。"

# game/episode014_conversations.rpy:459
translate simplified_chinese ep014_vess_talk_8325b3b7:

    # ve "I will, master."
    ve "我会的，主人。"

# game/episode014_conversations.rpy:461
translate simplified_chinese ep014_vess_talk_ef1d2ca5:

    # c "I will on occasion receive other women in my quarters."
    c "我偶尔会在自己舱室接待其他女性。"

# game/episode014_conversations.rpy:462
translate simplified_chinese ep014_vess_talk_e2fa3dde:

    # c "If that is the case, you’ll be notified in advance, in order to vacate my quarters, unless otherwise instructed."
    c "若是这种情况，除非另有指示，否则会提前通知你离开我的舱室。"

# game/episode014_conversations.rpy:463
translate simplified_chinese ep014_vess_talk_599dd3b2:

    # c "Do you understand all that, Vess?"
    c "薇丝，这些你都明白吗？"

# game/episode014_conversations.rpy:465
translate simplified_chinese ep014_vess_talk_6433941b:

    # ve "I...{w} I think I do, master."
    ve "我…{w}我想我明白了，主人。"

# game/episode014_conversations.rpy:467
translate simplified_chinese ep014_vess_talk_77804810:

    # "I lowered the containment field and Vess stepped out of her cell."
    "我解除了力场护盾，薇丝踏出了她的牢房。"

# game/episode014_conversations.rpy:468
translate simplified_chinese ep014_vess_talk_82f4f330:

    # c "Good, off you go then."
    c "很好，那你去吧。"

# game/episode014_conversations.rpy:471
translate simplified_chinese ep014_vess_talk_7056f99c_1:

    # "After bringing the crew up to speed on my decision regarding Vess, I headed back to the brig."
    "向船员们通报了我对薇丝的决定后，我回到了禁闭室。"

# game/episode014_conversations.rpy:476
translate simplified_chinese ep014_vess_talk_7056f99c_2:

    # "After bringing the crew up to speed on my decision regarding Vess, I headed back to the brig."
    "向船员们通报了我对薇丝的决定后，我回到了禁闭室。"

# game/episode014_conversations.rpy:478
translate simplified_chinese ep014_vess_talk_603db486:

    # ve "Back already, [p_name]?"
    ve "这么快就回来了，[p_name]？"

# game/episode014_conversations.rpy:479
translate simplified_chinese ep014_vess_talk_f81a899d:

    # c "Yes, the others have agreed on your release."
    c "是的，其他人都同意释放你了。"

# game/episode014_conversations.rpy:481
translate simplified_chinese ep014_vess_talk_d7e6fa1e:

    # ve "How...{w} Uh...{w} How did everybody take it?"
    ve "大家…{w}呃…{w}大家是怎么接受的？"

# game/episode014_conversations.rpy:482
translate simplified_chinese ep014_vess_talk_780cc792:

    # c "Well, I’m not going to lie, not everyone is thrilled with you being released."
    c "嗯，说实话，不是所有人都对释放你感到兴奋。"

# game/episode014_conversations.rpy:483
translate simplified_chinese ep014_vess_talk_2af9eaeb:

    # c "So I’d say you have a long way to go."
    c "所以我想说，你还有很长的路要走。"

# game/episode014_conversations.rpy:485
translate simplified_chinese ep014_vess_talk_ca5a0346:

    # ve "I’ll work hard to earn back the trust and respect I lost."
    ve "我会努力赢回我失去的信任和尊重。"

# game/episode014_conversations.rpy:486
translate simplified_chinese ep014_vess_talk_ace78906:

    # c "That sounds good, but it might take a long time for some people."
    c "听起来不错，但对某些人来说可能需要很长时间。"

# game/episode014_conversations.rpy:488
translate simplified_chinese ep014_vess_talk_8ecb5b7a:

    # ve "I know...{w} I know..."
    ve "我知道…{w}我知道…"

# game/episode014_conversations.rpy:489
translate simplified_chinese ep014_vess_talk_70b79338:

    # c "Now, shall I do something about the whole confinement situation?"
    c "那么，需要我处理一下这个监禁的情况吗？"

# game/episode014_conversations.rpy:491
translate simplified_chinese ep014_vess_talk_bb108aa4:

    # ve "That would be nice, yes."
    ve "是的，那就太好了。"

# game/episode014_conversations.rpy:493
translate simplified_chinese ep014_vess_talk_77804810_1:

    # "I lowered the containment field and Vess stepped out of her cell."
    "我降低了约束场，薇丝从她的牢房里走了出来。"

# game/episode014_conversations.rpy:495
translate simplified_chinese ep014_vess_talk_a3692842:

    # "For a moment, our eyes met and we both hesitated."
    "有那么一瞬间，我们的目光相遇，两人都有些迟疑。"

# game/episode014_conversations.rpy:497
translate simplified_chinese ep014_vess_talk_b68349b2:

    # "Vess smiled, and I took her into my arms."
    "薇丝微微一笑，我将她拥入怀中。"

# game/episode014_conversations.rpy:498
translate simplified_chinese ep014_vess_talk_7952e7d2:

    # ve "Thank you for trusting me, [p_name_short]."
    ve "谢谢你信任我，[p_name_short]。"

# game/episode014_conversations.rpy:499
translate simplified_chinese ep014_vess_talk_e239fd63:

    # c "Do you want to get out of here?"
    c "想离开这里吗？"

# game/episode014_conversations.rpy:501
translate simplified_chinese ep014_vess_talk_211ca8e8:

    # ve "I’d want nothing more!"
    ve "我求之不得！"

# game/episode014_conversations.rpy:502
translate simplified_chinese ep014_vess_talk_59aba1bd:

    # c "Your stuff has been brought to your quarters, so make yourself at home there."
    c "你的物品已经送到你的舱室了，就当是自己家一样住下吧。"

# game/episode014_conversations.rpy:503
translate simplified_chinese ep014_vess_talk_4187cda3:

    # ve "Thank you."
    ve "谢谢。"

# game/episode014_conversations.rpy:504
translate simplified_chinese ep014_vess_talk_4f5fa482:

    # ve "I might lie down for a while to be honest, sleeping on the brig’s floor wasn’t the best experience I’ve ever had."
    ve "说实话我可能需要躺一会儿，在禁闭室地板上睡觉可不是什么愉快的经历。"

# game/episode014_conversations.rpy:505
translate simplified_chinese ep014_vess_talk_a3e29350:

    # c "Rest a little in that case and come find me when you feel better."
    c "既然如此就休息一下吧，感觉好些了再来找我。"

# game/episode014_conversations.rpy:514
translate simplified_chinese ep014_jade_talk_eed95d78:

    # "When I arrived at my quarters, I found Jade waiting inside."
    "当我到达自己的舱室时，发现杰德正在里面等着。"

# game/episode014_conversations.rpy:516
translate simplified_chinese ep014_jade_talk_002544d4:

    # mod "If you don't like the result, stick around for a cheat option."
    mod "如果你不喜欢这个结果，可以等待作弊选项。"

# game/episode014_conversations.rpy:517
translate simplified_chinese ep014_jade_talk_675526a4:

    # c "Is something the matter, Jade?"
    c "有什么事吗，杰德？"

# game/episode014_conversations.rpy:519
translate simplified_chinese ep014_jade_talk_d15a7023:

    # j "Yes, you could say that."
    j "是的，可以这么说。"

# game/episode014_conversations.rpy:520
translate simplified_chinese ep014_jade_talk_e2d938de:

    # j "Vess was just here, telling me that she’s to live here in your quarters."
    j "薇丝刚才来过，告诉我她要住在你的舱室里。"

# game/episode014_conversations.rpy:521
translate simplified_chinese ep014_jade_talk_1b08c389:

    # j "It didn’t sound like she had much choice in the matter."
    j "听起来她在这件事上没什么选择余地。"

# game/episode014_conversations.rpy:522
translate simplified_chinese ep014_jade_talk_b4a9fe54:

    # c "Vess will be under my close supervision."
    c "薇丝将受到我的密切监视。"

# game/episode014_conversations.rpy:524
translate simplified_chinese ep014_jade_talk_8d8ea063:

    # j "Just like I was?"
    j "就像我以前那样？"

# game/episode014_conversations.rpy:525
translate simplified_chinese ep014_jade_talk_897a54d3:

    # j "I don’t understand how you could do such a thing, [p_name]?"
    j "我不明白你怎么能做这种事，[p_name]？"

# game/episode014_conversations.rpy:527
translate simplified_chinese ep014_jade_talk_4b5d8119:

    # j "Vess did some very bad things, but that doesn’t give you the right to make her some kind of attendant."
    j "薇丝确实做了一些很糟糕的事，但这不代表你有权把她变成某种侍从。"

# game/episode014_conversations.rpy:529
translate simplified_chinese ep014_jade_talk_52b75a05:

    # j "Are you doing it to punish her?"
    j "你这么做是为了惩罚她吗？"

# game/episode014_conversations.rpy:530
translate simplified_chinese ep014_jade_talk_746ca4ad:

    # c "Vess betrayed everyone of us, it’s a mercy we didn’t throw her out of an airlock at the first opportunity."
    c "薇丝背叛了我们每一个人，没在第一时间把她扔出气闸门已经是仁慈了。"

# game/episode014_conversations.rpy:531
translate simplified_chinese ep014_jade_talk_d7b2ed04:

    # c "Instead she lives, but she’ll do penance."
    c "她现在还活着，但必须赎罪。"

# game/episode014_conversations.rpy:533
translate simplified_chinese ep014_jade_talk_e911f012:

    # j "She’ll do penance as a slave?"
    j "她要作为奴隶来赎罪？"

# game/episode014_conversations.rpy:534
translate simplified_chinese ep014_jade_talk_26eefe0a:

    # c "Yes."
    c "是的。"

# game/episode014_conversations.rpy:536
translate simplified_chinese ep014_jade_talk_068cb19b:

    # j "Sorry, but I have no words."
    j "抱歉，我无话可说。"

# game/episode014_conversations.rpy:537
translate simplified_chinese ep014_jade_talk_82a49b5a:

    # j "I thought you understood me, but I don’t think you really do."
    j "我以为你理解我，但我觉得你并不真正理解。"

# game/episode014_conversations.rpy:538
translate simplified_chinese ep014_jade_talk_f6de0a07:

    # c "Of course I do."
    c "我当然理解。"

# game/episode014_conversations.rpy:540
translate simplified_chinese ep014_jade_talk_4b15bc91:

    # j "No you really don’t."
    j "不，你根本不理解。"

# game/episode014_conversations.rpy:542
translate simplified_chinese ep014_jade_talk_8b321d3d:

    # j "Making someone a sex slave as punishment, do you know how crazy that sounds?!"
    j "把某人变成性奴作为惩罚，你知道这听起来有多疯狂吗？！"

# game/episode014_conversations.rpy:544
translate simplified_chinese ep014_jade_talk_987ae6ea:

    # j "I thought you were a better man than this, [p_name]."
    j "我原以为你比这要好得多，[p_name]。"

# game/episode014_conversations.rpy:546
translate simplified_chinese ep014_jade_talk_1fd8f1f0:

    # j "But I won’t have anything to do with this."
    j "但我不会与这种事有任何瓜葛。"

# game/episode014_conversations.rpy:547
translate simplified_chinese ep014_jade_talk_7010762f:

    # j "And I sure as hell can’t be in a relationship with someone who thinks like this."
    j "而且我绝对无法与有这种想法的人保持关系。"

# game/episode014_conversations.rpy:548
translate simplified_chinese ep014_jade_talk_dd08a075:

    # c "Jade..."
    c "杰德…"

# game/episode014_conversations.rpy:550
translate simplified_chinese ep014_jade_talk_6bb46e5b:

    # j "It’s over, [p_name]."
    j "结束了，[p_name]。"

# game/episode014_conversations.rpy:554
translate simplified_chinese ep014_jade_talk_fa17132b:

    # "Lost for words, I let her walk out of my quarters."
    "我无言以对，任由她走出了我的舱室。"

# game/episode014_conversations.rpy:555
translate simplified_chinese ep014_jade_talk_db6b85fc:

    # "Pouring myself a drink, I stared into the distance."
    "给自己倒了杯酒，我凝视着远方。"

# game/episode014_conversations.rpy:558
translate simplified_chinese ep014_jade_talk_5b0fb8fd:

    # c "I’ve made my choice and I’m not walking back on it."
    c "我已经做出了选择，不会回头。"

# game/episode014_conversations.rpy:560
translate simplified_chinese ep014_jade_talk_2ff372f1:

    # j "I figured as much."
    j "我早就料到了。"

# game/episode014_conversations.rpy:561
translate simplified_chinese ep014_jade_talk_750000af:

    # j "You don’t know half how disappointed I am."
    j "你根本不知道我有多失望。"

# game/episode014_conversations.rpy:562
translate simplified_chinese ep014_jade_talk_5a3d94c2:

    # c "Let me make one thing clear though, you’re not to tell anyone."
    c "不过有一点我要说清楚，你不许告诉任何人。"

# game/episode014_conversations.rpy:564
translate simplified_chinese ep014_jade_talk_0908311c:

    # j "I’m not, am I?!"
    j "我不是，对吧？！"

# game/episode014_conversations.rpy:565
translate simplified_chinese ep014_jade_talk_105d4163:

    # c "Yes, I don’t want you to tell the others about the arrangement, nor do I want you fomenting any unrest among the crew about it."
    c "是的，我不希望你向其他人透露这个安排，也不希望你因此在船员中煽动任何不满。"

# game/episode014_conversations.rpy:566
translate simplified_chinese ep014_jade_talk_d5ec1026:

    # c "You’re still legally my attendant, bound by a contract and everything that entails."
    c "从法律上讲，你仍然是我的随从，受合同及其所有条款约束。"

# game/episode014_conversations.rpy:568
translate simplified_chinese ep014_jade_talk_4692e182:

    # j "Wow...{w} Just wow."
    j "哇…{w} 真是够了。"

# game/episode014_conversations.rpy:569
translate simplified_chinese ep014_jade_talk_f8d7813d:

    # j "Threatening me with your fucking contract."
    j "居然用你那该死的合同来威胁我。"

# game/episode014_conversations.rpy:570
translate simplified_chinese ep014_jade_talk_ec4d77f3:

    # j "别担心，“主人”，我会让你安安静静地当你那卑鄙的人类的."
    j "别担心，\"主人\",我就让你继续做你这种卑鄙小人吧。"

# game/episode014_conversations.rpy:572
translate simplified_chinese ep014_jade_talk_143df28d:

    # "Furious, Jade walked out of my quarters."
    "杰德怒气冲冲地走出了我的舱室。"

# game/episode014_conversations.rpy:573
translate simplified_chinese ep014_jade_talk_02a1afa9:

    # "I probably didn’t handle that very well, but at least Jade and I knew where we stood."
    "我可能处理得不太好，但至少我和杰德都明白了彼此的立场。"

# game/episode014_conversations.rpy:574
translate simplified_chinese ep014_jade_talk_08a68b15:

    # mod "Would you like to keep the relationship with Jade instead?"
    mod "你愿意继续保持与杰德的关系吗？"

# game/episode014_conversations.rpy:583
translate simplified_chinese ep014_jade_talk_30e0091b:

    # c "I didn’t call for you, Jade?"
    c "我没有叫你，杰德？"

# game/episode014_conversations.rpy:585
translate simplified_chinese ep014_jade_talk_5b1400d3:

    # j "No, you didn’t master."
    j "是的，您没有叫我，主人。"

# game/episode014_conversations.rpy:586
translate simplified_chinese ep014_jade_talk_b5b8d3f3:

    # c "So, what do you want?"
    c "那么，你想要什么？"

# game/episode014_conversations.rpy:587
translate simplified_chinese ep014_jade_talk_b6e6080d:

    # j "It’s about Vess, master."
    j "是关于薇丝的事，主人。"

# game/episode014_conversations.rpy:588
translate simplified_chinese ep014_jade_talk_914a50fc:

    # c "What about her?"
    c "她怎么了？"

# game/episode014_conversations.rpy:590
translate simplified_chinese ep014_jade_talk_d9c7dc86:

    # j "She was just here and she told me she’s to remain in your quarters for the time being?"
    j "她刚才在这里，告诉我她要暂时留在您的舱室里？"

# game/episode014_conversations.rpy:591
translate simplified_chinese ep014_jade_talk_e2051d0f:

    # c "That’s correct."
    c "没错。"

# game/episode014_conversations.rpy:592
translate simplified_chinese ep014_jade_talk_09c2a13e:

    # j "What is her status exactly, if you don’t mind me asking, master."
    j "如果您不介意我问的话，她的确切身份是什么，主人。"

# game/episode014_conversations.rpy:593
translate simplified_chinese ep014_jade_talk_a37033f1:

    # c "Her duties are much the same as yours."
    c "她的职责和你的基本相同。"

# game/episode014_conversations.rpy:594
translate simplified_chinese ep014_jade_talk_219eca6a:

    # c "You’ll perform them together, if required, but I’ve made clear to her that she should defer to you if I’m not around."
    c "如有需要，你们将一起执行这些职责，但我已明确告诉她，如果我不在，她应该听从你的指示。"

# game/episode014_conversations.rpy:596
translate simplified_chinese ep014_jade_talk_b71da6be:

    # j "That’s what I thought, master."
    j "我也是这么想的，主人。"

# game/episode014_conversations.rpy:597
translate simplified_chinese ep014_jade_talk_d0064914:

    # j "Thank you for clarifying things."
    j "感谢您的说明。"

# game/episode014_conversations.rpy:599
translate simplified_chinese ep014_jade_talk_1b7b5dbf:

    # j "Do you need anything at the moment, master."
    j "您现在需要什么吗，主人。"

# game/episode014_conversations.rpy:600
translate simplified_chinese ep014_jade_talk_571fd10a:

    # c "No, that will be all, Jade."
    c "不用了，就这些，杰德。"

# game/episode014_conversations.rpy:608
translate simplified_chinese ep014_celine_talk_f07bdaae:

    # "As I walked past Céline's quarters I heard someone yelling, followed by a metallic thud and more yelling."
    "当我经过瑟琳的房间时，听到有人在喊叫，接着是金属撞击声和更多的喊叫。"

# game/episode014_conversations.rpy:609
translate simplified_chinese ep014_celine_talk_75fe41ff:

    # "Someone was very clearly having an argument."
    "很明显有人在争吵。"

# game/episode014_conversations.rpy:610
translate simplified_chinese ep014_celine_talk_8779e4c5:

    # "I was about to enter Céline's room when the door flung open."
    "我正要进入瑟琳的房间时，门猛地打开了。"

# game/episode014_conversations.rpy:612
translate simplified_chinese ep014_celine_talk_c9000e0f:

