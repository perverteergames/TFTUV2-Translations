# game/episode015_conversations.rpy:85
translate simplified_chinese ep015_nadya_talk_b25f55c5:

    # "Not long after the Bastard took off, I got a message from Nadya, asking me to come to her quarters."
    "在\"私生子\"号起飞后不久，我收到了娜迪亚发来的消息，要我去她的舱室。"

# game/episode015_conversations.rpy:87
translate simplified_chinese ep015_nadya_talk_e17a6bb5:

    # na "The mission was a success, I believe?"
    na "任务应该算是成功了吧？"

# game/episode015_conversations.rpy:88
translate simplified_chinese ep015_nadya_talk_e029ab97:

    # c "It was."
    c "是的。"

# game/episode015_conversations.rpy:90
translate simplified_chinese ep015_nadya_talk_ad94ed51:

    # na "Weird that a learned woman like Rhedia turned to violence."
    na "像瑞迪亚这样有学识的女性竟会诉诸暴力，真是奇怪。"

# game/episode015_conversations.rpy:91
translate simplified_chinese ep015_nadya_talk_10a6abf7:

    # c "People can surprise you in many disappointing ways."
    c "人总是能以各种令人失望的方式让你大吃一惊。"

# game/episode015_conversations.rpy:92
translate simplified_chinese ep015_nadya_talk_7ede79d3:

    # na "Quite."
    na "确实。"

# game/episode015_conversations.rpy:94
translate simplified_chinese ep015_nadya_talk_411a5733:

    # na "Rhedia seems like a learned woman, I'm glad you were able to come to an arrangement with her."
    na "瑞迪亚看起来是个有学识的女性，我很高兴你们能达成协议。"

# game/episode015_conversations.rpy:95
translate simplified_chinese ep015_nadya_talk_96cb3bb5:

    # c "You feel a connection with her?"
    c "你感觉和她有共鸣？"

# game/episode015_conversations.rpy:96
translate simplified_chinese ep015_nadya_talk_1fda8d15:

    # na "I wouldn't go that far, I haven't even spoken to her."
    na "还不至于这么说，我甚至没跟她交谈过。"

# game/episode015_conversations.rpy:97
translate simplified_chinese ep015_nadya_talk_f45aaefd:

    # na "But she's a scholar, not a politician, and I think that counts for something."
    na "但她是学者而非政客，我认为这很重要。"

# game/episode015_conversations.rpy:98
translate simplified_chinese ep015_nadya_talk_cfc696fa:

    # na "But I didn't ask you to come and discuss my assessment of our new guest."
    na "但我叫你来不是要讨论我对新客人的评价。"

# game/episode015_conversations.rpy:99
translate simplified_chinese ep015_nadya_talk_52d765db:

    # c "Have you found something on the Scolguin, then?"
    c "那么你在斯科尔金人那里发现了什么吗？"

# game/episode015_conversations.rpy:101
translate simplified_chinese ep015_nadya_talk_52e069c6:

    # na "Yes, I finally did."
    na "是的，终于有所发现。"

# game/episode015_conversations.rpy:103
translate simplified_chinese ep015_nadya_talk_4613b9c4:

    # na "They're an elusive species, very secretive."
    na "他们是个行踪诡秘的种族，非常隐蔽。"

# game/episode015_conversations.rpy:104
translate simplified_chinese ep015_nadya_talk_da8d3a33:

    # na "No outsider has lived long enough among them to document their society."
    na "至今没有外来者能在他们社会中生活足够长的时间来记录其社会形态。"

# game/episode015_conversations.rpy:105
translate simplified_chinese ep015_nadya_talk_bd7a55a6:

    # na "Any emissaries that were sent out to the Scolguin, in the early days after we first encountered them, were never heard from again."
    na "早年我们初次接触后派往斯科尔金人的所有使节，全都杳无音信。"

# game/episode015_conversations.rpy:106
translate simplified_chinese ep015_nadya_talk_df419039:

    # c "They lived long and happy isolated lives among the Scolguin?"
    c "他们是在斯科尔金人中过着长寿而幸福的与世隔绝的生活吗？"

# game/episode015_conversations.rpy:108
translate simplified_chinese ep015_nadya_talk_bbe2fa04:

    # na "Haha, no, the common explanation is that they were killed immediately."
    na "哈哈不，普遍的解释是他们立即就被处决了。"

# game/episode015_conversations.rpy:109
translate simplified_chinese ep015_nadya_talk_a4bd5138:

    # c "So, the Scolguin don't mess around."
    c "所以说，斯科尔金人可不是好惹的。"

# game/episode015_conversations.rpy:111
translate simplified_chinese ep015_nadya_talk_82fc2eb4:

    # na "They sure don't."
    na "确实如此。"

# game/episode015_conversations.rpy:112
translate simplified_chinese ep015_nadya_talk_acb1b77f:

    # na "There has been some physiological analysis on deceased Scolguin specimen after major conflicts."
    na "在重大冲突后，曾对已故的斯科尔金标本进行过一些生理分析。"

# game/episode015_conversations.rpy:113
translate simplified_chinese ep015_nadya_talk_ba5b01af:

    # na "But as the research material proved to be rather scarce, in-depth studies on the Scolguin are very rare indeed."
    na "但由于研究材料相当稀缺，关于斯科尔金的深入研究确实非常罕见。"

# game/episode015_conversations.rpy:114
translate simplified_chinese ep015_nadya_talk_5125d323:

    # c "But you found the one definitive treatise on that lovely species?"
    c "但你找到了关于那个可爱物种的权威论文？"

# game/episode015_conversations.rpy:115
translate simplified_chinese ep015_nadya_talk_51619dbb:

    # na "No, not really, but I did find an interesting article on the sacrifice they invariably demand when another species wants to communicate with them."
    na "不，没有，不过我确实找到了一篇有趣的文章，内容是关于当其他物种想与他们交流时，他们总会要求的祭品。"

# game/episode015_conversations.rpy:116
translate simplified_chinese ep015_nadya_talk_e5219836:

    # c "That seems like a solid lead."
    c "这似乎是个可靠的线索。"

# game/episode015_conversations.rpy:118
translate simplified_chinese ep015_nadya_talk_2ac39a4d:

    # na "According to the author of the paper, the Scolguin are a race of collectors."
    na "根据论文作者的说法，斯科尔金是一个收藏家种族。"

# game/episode015_conversations.rpy:119
translate simplified_chinese ep015_nadya_talk_6a925586:

    # c "What do they collect?"
    c "他们收藏什么？"

# game/episode015_conversations.rpy:120
translate simplified_chinese ep015_nadya_talk_69f16e58:

    # na "Experiences."
    na "体验。"

# game/episode015_conversations.rpy:121
translate simplified_chinese ep015_nadya_talk_96195acf:

    # c "Experiences?"
    c "体验？"

# game/episode015_conversations.rpy:123
translate simplified_chinese ep015_nadya_talk_345299f8:

    # na "Yes, they seem primarily interested in gathering emotions, thoughts and memories of other species."
    na "是的，他们似乎主要对收集其他物种的情感、思想和记忆感兴趣。"

# game/episode015_conversations.rpy:124
translate simplified_chinese ep015_nadya_talk_ad643443:

    # na "That's probably the purpose of the scan they performed on you."
    na "那大概就是他们对你进行扫描的目的。"

# game/episode015_conversations.rpy:125
translate simplified_chinese ep015_nadya_talk_97d99442:

    # na "Most of the treatise is pure speculation and takes some very liberal leaps regarding technological advances of the Scolguin."
    na "这篇论文大部分纯属推测，而且对斯科尔金人的科技进步做了相当自由的跳跃性假设。"

# game/episode015_conversations.rpy:126
translate simplified_chinese ep015_nadya_talk_e00832b4:

    # c "You're saying the Scolguin scanned my brain in order to collect my memories, thoughts and emotions?"
    c "你是说斯科尔金人扫描我的大脑是为了收集我的记忆、想法和情感？"

# game/episode015_conversations.rpy:128
translate simplified_chinese ep015_nadya_talk_1a2af7c2:

    # na "Something like that, yes."
    na "差不多就是这样，没错。"

# game/episode015_conversations.rpy:129
translate simplified_chinese ep015_nadya_talk_fa5a959c:

    # na "Again, this is pure speculation, but they could be using those collected experiences to fuel some type of simulation."
    na "再次强调，这只是纯粹的推测，但他们可能正在利用这些收集到的体验来驱动某种模拟程序。"

# game/episode015_conversations.rpy:130
translate simplified_chinese ep015_nadya_talk_b08defe8:

    # c "So, somewhere on their homeworld, some Scolguin is reliving the betrayal by my father and my subsequent mortal terror of being spaced?"
    c "所以，在他们母星的某个地方，某个斯科尔金人正在重温我父亲的背叛以及我随后被抛入太空的致命恐惧？"

# game/episode015_conversations.rpy:131
translate simplified_chinese ep015_nadya_talk_37984c14:

    # na "That could be."
    na "有可能。"

# game/episode015_conversations.rpy:132
translate simplified_chinese ep015_nadya_talk_9d831ee7:

    # c "Well, I hope they have a grand time basking in my most recent traumas..."
    c "好吧，我希望他们能从我最新的创伤经历中获得极大享受…"

# game/episode015_conversations.rpy:134
translate simplified_chinese ep015_nadya_talk_d8882212:

    # na "The theory has some holes, but it would explain the demand for a sacrifice, the scanning and subsequent abandonment of the victim."
    na "这个理论存在一些漏洞，但它能解释为何需要献祭、进行扫描以及随后抛弃受害者的行为。"

# game/episode015_conversations.rpy:135
translate simplified_chinese ep015_nadya_talk_ff58b765:

    # c "No use for a person floating in space after they've blasted you with their mind-reading laser..."
    c "在他们用读心激光扫描你之后，一个漂浮在太空中的人就没什么用了…"

# game/episode015_conversations.rpy:136
translate simplified_chinese ep015_nadya_talk_d9ce1b85:

    # c "Well, thanks for sharing this information with me."
    c "好吧，感谢你与我分享这些信息。"

# game/episode015_conversations.rpy:137
translate simplified_chinese ep015_nadya_talk_a05f303e:

    # c "I'm not sure yet how this might help us, other than to reaffirm the Scolguin are a bunch of gigantic dicks."
    c "除了再次确认斯科尔金人是一群超级混蛋之外，我还不确定这能怎么帮到我们。"

# game/episode015_conversations.rpy:139
translate simplified_chinese ep015_nadya_talk_a07d3ee3:

    # na "I'll keep looking if I can find anything else on them, but I highly doubt it."
    na "我会继续看看能否找到关于他们的其他资料，但我对此非常怀疑。"

# game/episode015_conversations.rpy:140
translate simplified_chinese ep015_nadya_talk_e35992f5:

    # c "Gotcha."
    c "明白了。"

# game/episode015_conversations.rpy:142
translate simplified_chinese ep015_nadya_talk_5a8560a3:

    # c "Thanks, mom."
    c "谢谢，妈。"

# game/episode015_conversations.rpy:144
translate simplified_chinese ep015_nadya_talk_3cf88960:

    # c "Thanks, Nadya."
    c "谢谢，娜迪亚。"

# game/episode015_conversations.rpy:160
translate simplified_chinese ep015_nadya_talk_936858c6:

    # "Leaving my mother's quarters would be the easy way out, but I had made a promise to [girl]."
    "离开我母亲的房间是轻松的选择，但我已经向[girl]许下了承诺。"

# game/episode015_conversations.rpy:162
translate simplified_chinese ep015_nadya_talk_4c2cc7f4:

    # "Leaving Nadya's quarters would be the easy way out, but I had made a promise to [girl]."
    "离开娜迪亚的房间是轻松的选择，但我已经向[girl]许下了承诺。"

# game/episode015_conversations.rpy:167
translate simplified_chinese ep015_nadya_talk_e7a48e5e:

    # "I was about to leave my mother's quarters when she cleared her throat."
    "我正要离开母亲的房间时，她清了清嗓子。"

# game/episode015_conversations.rpy:169
translate simplified_chinese ep015_nadya_talk_94681bc1:

    # "I was about to leave my Nadya's quarters when she cleared her throat."
    "我正要离开娜迪亚的房间时，她清了清嗓子。"

# game/episode015_conversations.rpy:172
translate simplified_chinese ep015_nadya_talk_4b993c8e:

    # na "Are you just going without giving your mother a kiss?"
    na "你就这么走了，不给你妈妈一个吻吗？"

# game/episode015_conversations.rpy:174
translate simplified_chinese ep015_nadya_talk_3154ca49:

    # na "Are you just going without giving me a kiss?"
    na "你就这么走了，不给我一个吻吗？"

# game/episode015_conversations.rpy:175
translate simplified_chinese ep015_nadya_talk_cec1168c:

    # c "Ah, I didn't know if it would be proper."
    c "啊，我不知道这样是否合适。"

# game/episode015_conversations.rpy:176
translate simplified_chinese ep015_nadya_talk_a2a535ad:

    # na "Proper, I-"
    na "合适，我-"

# game/episode015_conversations.rpy:178
translate simplified_chinese ep015_nadya_talk_82818f45:

    # "Before she could finish her sentence, I had her in my arms and kissed her on the mouth."
    "在她说完话之前，我已经把她搂在怀里，吻上了她的唇。"

# game/episode015_conversations.rpy:179
translate simplified_chinese ep015_nadya_talk_5e9cddbc:

    # "Soon, our tongues were performing a passionate dance."
    "很快，我们的舌头就开始了热情的舞蹈。"

# game/episode015_conversations.rpy:181
translate simplified_chinese ep015_nadya_talk_51514e51:

    # "After our long kiss had ended, Nadya remained in my arms, both relishing the closeness of our bodies against each other."
    "漫长的吻结束后，娜迪亚仍在我怀中，我们都享受着彼此身体紧贴的感觉。"

# game/episode015_conversations.rpy:182
translate simplified_chinese ep015_nadya_talk_c538f776:

    # "A noise out in the hallway brought us back the present and after another long kiss, I was out in the hallway again."
    "走廊传来的声响将我们拉回现实，在又一次长吻之后，我又回到了走廊上。"

# game/episode015_conversations.rpy:191
translate simplified_chinese ep015_eva_talk_19a4c0f3:

    # e "So the mission was a success?"
    e "那么任务成功了？"

# game/episode015_conversations.rpy:192
translate simplified_chinese ep015_eva_talk_3df26797:

    # c "Yes, it was."
    c "是的，成功了。"

# game/episode015_conversations.rpy:195
translate simplified_chinese ep015_eva_talk_3247b9ed:

    # c "Slight change of plans though, we’re not going to hand Rhedia over to the Council."
    c "不过计划略有变动，我们不打算把瑞迪亚交给议会。"

# game/episode015_conversations.rpy:196
translate simplified_chinese ep015_eva_talk_dee2aaa1:

    # e "Aven told me something about it, why is that?"
    e "艾文跟我提过这事，为什么呢？"

# game/episode015_conversations.rpy:197
translate simplified_chinese ep015_eva_talk_f708fcfb:

    # c "Arlya has been using us for her personal gain, and according to Rhedia, she is thoroughly corrupt."
    c "阿尔雅一直在利用我们谋取私利，而且根据瑞迪亚的说法，她完全腐败了。"

# game/episode015_conversations.rpy:199
translate simplified_chinese ep015_eva_talk_a4ba24a6:

    # e "I guess Rhedia makes a convincing argument?"
    e "我猜瑞迪亚的说法很有说服力？"

# game/episode015_conversations.rpy:200
translate simplified_chinese ep015_eva_talk_6e2b3616:

    # c "She does."
    c "确实如此。"

# game/episode015_conversations.rpy:202
translate simplified_chinese ep015_eva_talk_35f6ea7d:

    # c "I know it means a delay for our mission, but I can’t stand by and see Ziv’s planet plunged into political chaos."
    c "我知道这意味着我们任务要延迟，但我不能袖手旁观，看着基芙的星球陷入政治混乱。"

# game/episode015_conversations.rpy:204
translate simplified_chinese ep015_eva_talk_d75c82f2:

    # c "I know it means a delay for our mission, but I can’t stand by and see this planet plunged into political chaos."
    c "我知道这意味着我们任务要延迟，但我不能袖手旁观，看着这个星球陷入政治混乱。"

# game/episode015_conversations.rpy:206
translate simplified_chinese ep015_eva_talk_6c3dd22d:

    # e "I’m sure there’ll be chaos anyhow."
    e "我敢说无论如何都会出现混乱。"

# game/episode015_conversations.rpy:207
translate simplified_chinese ep015_eva_talk_4be1a86d:

    # c "That’s true, but at least we didn’t actively try to help spread the corruption."
    c "没错，但至少我们没有主动助长腐败蔓延。"

# game/episode015_conversations.rpy:209
translate simplified_chinese ep015_eva_talk_c167c86a:

    # c "We’ll deliver Rhedia to the Council as soon as possible."
    c "我们会尽快把瑞迪亚送到议会。"

# game/episode015_conversations.rpy:210
translate simplified_chinese ep015_eva_talk_4af9905e:

    # e "That sounds good."
    e "听起来不错。"

# game/episode015_conversations.rpy:211
translate simplified_chinese ep015_eva_talk_f4561742:

    # c "We have to focus on our own mission, getting involved in local politics is never a good idea."
    c "我们必须专注于自己的任务，卷入当地政治从来都不是个好主意。"

# game/episode015_conversations.rpy:212
translate simplified_chinese ep015_eva_talk_05364ff8:

    # e "Agreed."
    e "同意。"

# game/episode015_conversations.rpy:214
translate simplified_chinese ep015_eva_talk_efba2a2e:

    # e "[p_name_short]...{w} Uh...{w} Could I speak to you for a minute?"
    e "[p_name_short]…{w} 呃…{w} 我能跟你谈一下吗？"

# game/episode015_conversations.rpy:215
translate simplified_chinese ep015_eva_talk_f849d2be:

    # e "Somewhere private, I mean."
    e "我是说，找个私密的地方。"

# game/episode015_conversations.rpy:216
translate simplified_chinese ep015_eva_talk_4e8c7062:

    # c "Of course."
    c "当然可以。"

# game/episode015_conversations.rpy:219
translate simplified_chinese ep015_eva_talk_26f7448e:

    # "I followed my sister to her quarters, wondering what she had to tell me."
    "我跟着妹妹去了她的房间，心里想着她要告诉我什么。"

# game/episode015_conversations.rpy:221
translate simplified_chinese ep015_eva_talk_496b2f2d:

    # "I followed Eva to her quarters, wondering what she had to tell me."
    "我跟着伊娃去了她的房间，心里想着她要告诉我什么。"

# game/episode015_conversations.rpy:223
translate simplified_chinese ep015_eva_talk_cbcb7fa2:

    # e "It might be better if you sit down."
    e "你最好坐下来。"

# game/episode015_conversations.rpy:225
translate simplified_chinese ep015_eva_talk_041b7864:

    # "As soon as I sat on Eva’s bed, she started pacing in front of me."
    "我刚在伊娃的床上坐下，她就开始在我面前踱步。"

# game/episode015_conversations.rpy:226
translate simplified_chinese ep015_eva_talk_eb060451:

    # "I looked at her a little bewildered."
    "我有点困惑地看着她。"

# game/episode015_conversations.rpy:228
translate simplified_chinese ep015_eva_talk_1c83a413:

    # e "Don’t stare at me like that!"
    e "别那样盯着我看！"

# game/episode015_conversations.rpy:229
translate simplified_chinese ep015_eva_talk_4b489c83:

    # c "Okay..."
    c "好吧…"

# game/episode015_conversations.rpy:230
translate simplified_chinese ep015_eva_talk_b3373319:

    # e "Sorry, [p_name_short]."
    e "抱歉，[p_name_short]。"

# game/episode015_conversations.rpy:232
translate simplified_chinese ep015_eva_talk_3f6e9136:

    # "With a big sigh, Eva sat down next to me."
    "随着一声沉重的叹息，伊娃在我身边坐了下来。"

# game/episode015_conversations.rpy:233
translate simplified_chinese ep015_eva_talk_28ca1cfa:

    # e "I’ve been meaning to talk to you for some time."
    e "我早就想找你谈谈了。"

# game/episode015_conversations.rpy:234
translate simplified_chinese ep015_eva_talk_1c944af0:

    # e "At first I just tried to ignore it, but I just can’t."
    e "起初我只是试着忽略它，但我实在做不到。"

# game/episode015_conversations.rpy:235
translate simplified_chinese ep015_eva_talk_db3b5bff:

    # c "Eva, what are you talking about?"
    c "伊娃，你在说什么？"

# game/episode015_conversations.rpy:236
translate simplified_chinese ep015_eva_talk_d787937a:

    # e "About the simulation!"
    e "关于模拟训练！"

# game/episode015_conversations.rpy:237
translate simplified_chinese ep015_eva_talk_4d32294a:

    # c "Killing the dragon, you mean?"
    c "你是说杀死那条龙的事？"

# game/episode015_conversations.rpy:239
translate simplified_chinese ep015_eva_talk_dd31a79d:

    # e "No!{w} I mean yes."
    e "不！{w} 我是说没错。"

# game/episode015_conversations.rpy:240
translate simplified_chinese ep015_eva_talk_b74fe260:

    # e "Well, what happened afterwards, I mean."
    e "嗯，我是说之后发生的事。"

# game/episode015_conversations.rpy:241
